    <figura titulus="valsa_bassus" textus="v100 B:2. | v100 Q:2."/>
    <figura titulus="valsa_superior"
        textus="r:4 v60 [1 2 3] [1 2 3] | r:4 v60 [1 2 3] [1 2 3]"/>
    <acorda mensura="1"
