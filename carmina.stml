<!-- carmina.stml - liber ordinarius carminum (include/carmen.h), in
     binarium infixus per tools/carmina_infigere.sh.

     Carmen: tempus (quartae per minutum), metrum, clavis; partes cum
     instrumento (tibia praeparata per titulum); frusta per mensuram (1 =
     prima) aut pulsus. Textus frusti MML (cantus.h) SINE 't': tempus
     carminis est. Mensura quaeque per '|' notata, ad legendum.

     KOROBEINIKI: carmen populare Russicum saeculi XIX (Nekrasov 1861,
     melodia popularis) - dominii publici; thema Tetris notum.
     Transcriptio nostra: A minor, 4/4, XVI mensurae - pars A (1-8) bis
     non, deinde pars B lenta (9-16) notis dimidiis; carmen iterat.

     VESPERAE: hymnus brevis noster (Claudius, 2026-10-23, per auditio
     -partitura / -censura / -auscultare compositus; Franus auscultavit):
     D maior, 4/4, 84, VIII mensurae, ritardando ad 66 in ultima;
     melodia aether supra bassum triangulum (I-IV-V, nulla quinta
     parallela).

     STELLA: antiphona brevis nostra (Claudius, 2026-10-23, per auditio
     -recensio -partitura -harmonia composita; Franus auscultavit): D
     minor, 3/4, 72, XVI mensurae, tres voces - melodia aether, vox media
     quadrans, bassus triangulum; ad F maior per C7 (mensurae 7-8) et
     domum per A7; ritardando gradibus 63, 54. Censura +dissonantia
     septimas duas in mensura 7 nominat - consultas (septima C7
     descendit, appoggiatura).

     COMPLETORIUM: nostrum (Claudius, 2026-10-24, instrumentis novis et
     aula compositum; Franus auscultavit): D minor, 4/4, 66, XVI
     mensurae in aula (0.8). Mensurae 1-8 cantus solus - schola
     (vocalis a) supra isonem (vocalis o), campanae tubulares; 9-16
     melodia in fistula duabus octavis altius (per -copiare +14),
     cembalo arpeggiis, pizzicato bassus: i III iv VII i III V7 I -
     tertia Picardiae (A7 -> D maior), schola et ison 'Amen' in
     ultima. Censura +parallelae: quintae et octavae vocum
     extremarum emendatae; F# ultimae extra clavem nominatur -
     consultum (desideratum ...CSJZHF).

     FIGURAE domus (comitatus.h; <comitatus figura="..."> in parte,
     harmonia ex <acorda> carminis): B bassus, Q quinta, 1..9 voces
     superiores, [..] simul, {..} fractum, vN lucrum.
       valsa           3/4  oom-pah-pah, bassus radix / quinta alternis
       marcia          4/4  bassus, acordum, quinta, acordum
       albertina       4/4  Alberti octavis (ima summa media summa)
       harpa           4/4  acordum fractum totum, sex voces
       harpa_ternaria  3/4  idem in mensura ternaria
       pastorale       6/8  arpeggium octavis, sursum et deorsum
       charleston      4/4  iazz: acordum sine radice in 1 et "et" 2
       pulsus_bini     4/4  iazz: sine radice in 1 et 3 (acorda bina)
       ambulans        4/4  bassus ambulans: radix, tertia, quinta,
                            accessus chromaticus ad bassum proximum
       ambulans_bina   4/4  idem acordis binis: radix, accessus, radix,
                            accessus

     LILIA: valsa nostra (Claudius, 2026-10-26, prima figuris
     comitandi; desideratum ...Q7G5): F maior, 3/4, 138 agogica
     vindobonensi, XVI mensurae - melodia chordae, harpa figura valsa
     ex acordis declaratis (I V7 I IV I V7/V ii V7 I), crescendo ad
     XIII, diminuendo, ritardando ad fermatam; portamenta chordarum in
     saltibus (mensurae 1-2, 8-9, 12-13); F# mensurae XII (D7,
     dominans ad ii) extra clavem nominatur - consultum. Auribus
     iudicanda. -->
<carmina>

  <!-- stili censurae: popularis - septima acordi color est, resolutio
       non postulatur (pop, jazz, chiptune, SNES) -->
  <stylus titulus="popularis" septimae="liberae"/>

  <!-- iazz: popularis cum intentionibus (9 11 13 et alteratae per
       genus acordi) - nota tenta intentio acordi non aliena; notae
       evitandae (11 super maiorem et dominantem) monentur -->
  <stylus titulus="iazz" basis="popularis" intentiones="liberae"
      regulae="+evitanda"/>

  <figura titulus="valsa"
      textus="v100 B:4 v60 [1 2 3] [1 2 3] | v100 Q:4 v60 [1 2 3] [1 2 3]"/>
  <figura titulus="marcia" textus="v100 B:4 v60 [1 2 3] v85 Q v60 [1 2 3]"/>
  <figura titulus="albertina" textus="1:8 3 2 3 1 3 2 3"/>
  <figura titulus="harpa" textus="{B 1 2 3 4 5}:1"/>
  <figura titulus="harpa_ternaria" textus="{B 1 2 3 4}:2."/>
  <figura titulus="pastorale" textus="B:8 1 2 3 2 1"/>
  <figura titulus="charleston" textus="v90 [1 2 3 4]:4. v70 [1 2 3 4]:8 r:2"
      positio="sine_radice"/>
  <figura titulus="pulsus_bini" textus="v85 [1 2 3 4]:4 r:4 [1 2 3 4]:4 r:4"
      positio="sine_radice"/>
  <figura titulus="ambulans" textus="B:4 T Q A"/>
  <figura titulus="ambulans_bina" textus="B:4 A B A"/>

  <carmen titulus="korobeiniki" tempus="144" metrum="4/4"
          clavis="a minor">
    <pars titulus="melodia" instrumentum="quadrans" lucrum="0.7">
      <frustum mensura="1">
        <textus!>o5 l8 e4 <b >c d4 c <b | a4 a >c e4 d c | <b4. >c d4 e4 | c4 <a4 a2 | r >d4 f a4 g f | e4. c e4 d c | <b4 b >c d4 e4 | c4 <a4 a4 r4 | >e2 c2 | d2 <b2 | >c2 <a2 | g#2 b2 | >e2 c2 | d2 <b2 | >c4 e4 a2 | g#1</textus>
      </>
    </>
    <pars titulus="bassus" instrumentum="triangulum" lucrum="0.8">
      <frustum mensura="1">
        <textus!>o2 l8 e >e <e >e <e >e <e >e < | a >a <a >a <a >a <a >a < | g# >g# <g# >g# <g# >g# <g# >g# < | a >a <a >a <a >a <a >a < | d >d <d >d <d >d <d >d < | c >c <c >c <c >c <c >c < | g# >g# <g# >g# <g# >g# <g# >g# < | a >a <a >a <a >a <a >a < | a >a <a >a <a >a <a >a < | g# >g# <g# >g# <g# >g# <g# >g# < | a >a <a >a <a >a <a >a < | e >e <e >e <e >e <e >e < | a >a <a >a <a >a <a >a < | g# >g# <g# >g# <g# >g# <g# >g# < | a >a <a >a <a >a <a >a < | e >e <e >e <e >e <e >e <</textus>
      </>
    </>
  </>

  <carmen titulus="vesperae" tempus="84" metrum="4/4" clavis="d maior">
    <tempus mensura="8" valor="66"/>
    <pars titulus="melodia" instrumentum="aether" lucrum="0.7">
      <frustum mensura="1">
        <textus!>o5 d4 e8 f#8 g4 f#4 | e4 d4 c#4 <a4 | >d4 f#4 b4 a4 | g2 f#2 | e4 f#8 g8 a4 g4 | f#4 e4 d4 c#4 | <b4 >e4 d4 c#4 | d1</textus>
      </>
    </>
    <pars titulus="bassus" instrumentum="triangulum" lucrum="0.8">
      <frustum mensura="1">
        <textus!>o3 d2 o2 g2 | o2 a2 a2 | o3 f#2 g2 | o3 e2 d2 | o3 c#2 o2 a2 | o2 b2 a2 | o2 g2 a2 | o2 d1</textus>
      </>
    </>
  </>

  <carmen titulus="stella" tempus="72" metrum="3/4" clavis="d minor">
    <tempus mensura="14" ictus="3" valor="54" usque="16"/>
    <fermata mensura="16"/>
    <pars titulus="melodia" instrumentum="aether" lucrum="0.55">
      <frustum mensura="1">
        <textus!>o5 d2 e4 | f4. e8 d4 | g4 f4 e4 | c#2. | f2 d4 | d4 g4 b-4 | a4 g4 e4 | f2. | d2 <b-4 | >c#2 e4 | f4 a4 >d4 | c4 <b-4 a4 | g4 f4 e4 | f4 e4 g4 | e2 c#4 | d2.</textus>
      </>
    </>
    <pars titulus="media" instrumentum="quadrans" lucrum="0.35">
      <frustum mensura="1">
        <textus!>o4 f2. | d2. | b-2 >c#4 | <e2. | d2. | b-2. | b-2. | a2. | b-2 g4 | e2 >c#4 | <f2. | f2. | b-2 >c#4 | c#2. | c#2 <g4 | f2.</textus>
      </>
    </>
    <pars titulus="bassus" instrumentum="triangulum" lucrum="0.65">
      <frustum mensura="1">
        <textus!>o3 d2. | o2 b-2. | g2 a4 | a2. | b-2. | g2. | o3 c2. | o2 f2. | g2. | a2. | o3 d2. | o2 a2 f4 | g2 a4 | a2. | a2. | d2.</textus>
      </>
    </>
  </>

  <carmen titulus="pastorale" tempus="90" metrum="6/8" clavis="g maior">
    <tempus mensura="15" valor="66" usque="16"/>
    <fermata mensura="16" factor="1.5"/>
    <pars titulus="melodia" instrumentum="aether" lucrum="0.55">
      <frustum mensura="1">
        <textus!>o5 d4 g8 b4 a8 | g4 b8 a4. | e4 g8 g4 d8 | f#4 e8 d4. | d4 g8 b4 >d8 | <b4 g8 >c4. | c4 <a8 f#4 a8 | g2. | e4 g8 >c4. | <b4 a8 g4 b8 | >c4 <b8 >d4. | <b4 g8 a4. | b4 g8 >e4 d8 | <b4 >d8 <g4 b8 | a4 >c8< a4 f#8 | g2.</textus>
      </>
    </>
    <pars titulus="media" instrumentum="quadrans" lucrum="0.30">
      <frustum mensura="1">
        <textus!>o4 b4. g4. | b4. f#4. | g4. b4. | f#2. | b4. g4. | g4. e4. | e4. d4. | b2. | g4. e4. | d4. e4. | e4. f#4. | g4. f#4. | b4. g4. | g4. e4. | e4. f#4. | b2.</textus>
      </>
    </>
    <pars titulus="bassus" instrumentum="triangulum" lucrum="0.65">
      <frustum mensura="1">
        <textus!>o2 g2. | g4. >d4. | c4. <g4. | >d2. | <g2. | >e4. c4. | <a4. >d4. | <g2. | >c2. | <g4. >e4. | <a4. >d4. | <g4. >d4. | <g4. >c4. | <g4. >e4. | c4. d4. | <g2.</textus>
      </>
    </>
  </>

  <carmen titulus="vigilia" tempus="66" metrum="4/4" clavis="e minor">
    <tempus mensura="15" valor="60"/>
    <tempus mensura="16" valor="50"/>
    <pars titulus="melodia" instrumentum="campana" lucrum="0.6">
      <frustum mensura="1">
        <textus!>o5 b2 a4 g4 | e2. d4 | c2 <b4 a4 | >d#2.< r4 | o5 b2 a4 g4 o4 | o5 a2. g4 o4 | o5 f#2 a4 g4 o4 | o5 e1 o4 | o5 b4 g4 >d2 | o5 f#4 d4 a2 o6 | o5 e4 c4 g2 o6 | <d#2. r4 | o5 b2 a4 g4 | o5 a2. g4 | o5 f#2 a4 g4 | o5 e1</textus>
      </>
    </>
    <pars titulus="chorda" instrumentum="chorda" lucrum="0.5">
      <frustum mensura="1">
        <textus!>o3 e8 b8 >e8 g8 b8 g8 e8 <b8 | o3 c8 g8 o4 c8 e8 g8 e8 c8 o3 g8 | o3 a8 o4 e8 a8 o5 c8 e8 c8 o4 a8 e8 o3 | o3 b8 o4 f#8 b8 o5 d#8 f#8 d#8 o4 b8 f#8 o3 | o3 e8 b8 o4 e8 g8 b8 g8 e8 o3 b8 | o3 a8 o4 e8 a8 o5 c8 e8 c8 o4 a8 e8 o3 | o3 b8 o4 f#8 b8 o5 d#8 f#8 d#8 o4 b8 f#8 o3 | o3 e8 b8 o4 e8 g8 b8 g8 e8 o3 b8 | o3 g8 o4 d8 g8 b8 o5 d8 o4 b8 g8 d8 o3 | o3 d8 a8 o4 d8 f#8 a8 f#8 d8 o3 a8 | o3 c8 g8 o4 c8 e8 g8 e8 c8 o3 g8 | o3 b8 o4 f#8 b8 o5 d#8 f#8 d#8 o4 b8 f#8 o3 | o3 e8 b8 o4 e8 g8 b8 g8 e8 o3 b8 | o3 a8 o4 e8 a8 o5 c8 e8 c8 o4 a8 e8 o3 | o3 b8 o4 f#8 b8 o5 d#8 f#8 d#8 o4 b8 f#8 o3 | o3 e8 b8 o4 e8 g8 b8 g8 e8 o3 b8</textus>
      </>
    </>
    <pars titulus="bassus" instrumentum="triangulum" lucrum="0.55">
      <frustum mensura="1">
        <textus!>o2 e1 | c1 | a1 | b1 | e1 | a1 | b1 | e1 | g1 | o3 d1 | c1 | o2 b1 | e1 | a1 | b1 | e1</textus>
      </>
    </>
  </>

  <carmen titulus="completorium" tempus="66" metrum="4/4" clavis="d minor">
    <instrumentum titulus="ison" basis="schola" vocalis="o"
        amplitudo="0.3" vibratus="0.05"/>
    <instrumentum titulus="pizzicato_gravis" basis="pizzicato"
        decrementum="0.6" amplitudo="1"/>
    <reverberatio aula="0.8" mollities="0.45" latitudo="1" lucrum="0.3"/>
    <pars titulus="cantus" instrumentum="schola" reverberatio="0.55">
      <frustum mensura="1">
        <textus!>o3 d4 e4 f4 g4 | a2 g4 f4 | g4 a4 b-4 a4 | g2 e2 | f4 e4 d4 e4 | f2 a2 | g4 f4 e2 | d1</textus>
      </>
      <frustum mensura="16">
        <textus!>o3 d1</textus>
      </>
    </>
    <pars titulus="ison" instrumentum="ison" positio="-0.3"
        reverberatio="0.45">
      <frustum mensura="1">
        <textus!>o3 d1 | d1 | d1 | d1 | d1 | d1 | d1 | d1</textus>
      </>
      <frustum mensura="16">
        <textus!>o3 d1</textus>
      </>
    </>
    <pars titulus="campanae" instrumentum="campanae_tubulares" lucrum="0.7"
        positio="0.5" reverberatio="0.7">
      <frustum mensura="1">
        <textus!>o4 d2 r2 | r1 | r1 | r1 | o4 a2 r2 | r1 | r1 | r1 | o4 d2 r2 | r1 | r1 | r1 | o4 a2 r2 | r1 | r1 | o4 d1</textus>
      </>
    </>
    <pars titulus="fistula" instrumentum="fistula" lucrum="0.55"
        positio="0.25" reverberatio="0.4">
      <frustum mensura="9">
        <textus!>o5 d4 e4 f4 g4 | o5 a2 g4 f4 | o5 g4 a4 b-4 a4 | o5 g2 e2 | o5 f4 e4 d4 e4 | o5 f2 a2 | o5 g4 f4 e2 | o5 d1</textus>
      </>
    </>
    <pars titulus="cembalo" instrumentum="cembalo" lucrum="0.75"
        positio="-0.35" reverberatio="0.25">
      <frustum mensura="9">
        <textus!>o4 d8 f8 a8 f8 d8 f8 a8 f8 | c8 f8 a8 f8 a8 f8 c8 f8 | o3 b-8 o4 d8 g8 d8 o3 b-8 o4 d8 b-8 g8 | c8 e8 g8 e8 c8 e8 g8 e8 | d8 f8 a8 f8 d8 f8 a8 f8 | c8 f8 a8 f8 f8 a8 c8 a8 | c#8 e8 a8 e8 c#8 e8 a8 c#8 | d8 f#8 a8 f#8 d2</textus>
      </>
    </>
    <pars titulus="bassus" instrumentum="pizzicato_gravis" lucrum="0.8"
        positio="0.1" reverberatio="0.15">
      <frustum mensura="9">
        <textus!>o3 d2 o2 a2 | o3 f2 c2 | o2 g1 | o3 c2 o2 g2 | o3 d2 o2 a2 | o3 f2 c2 | o2 a1 | o3 d1</textus>
      </>
    </>
  </>

  <carmen titulus="lilia" tempus="138" metrum="3/4" clavis="f maior"
          agogica="vindobonensis">
    <tempus mensura="15" valor="112" usque="16"/>
    <fermata mensura="16"/>
    <dynamica mensura="1" valor="f"/>
    <dynamica mensura="9" valor="1" usque="13"/>
