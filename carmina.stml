    <pars titulus="melodia" instrumentum="chordae" lucrum="1">
      <frustum mensura="1">
        <textus!>o4 a2 o5 c4/8 | o5 f2. | o5 e2 d4 | o5 c2 o4 b-4 | o4 g2 b-4 | o5 e2 d4 | o5 c2 o4 a4 | o4 f2./8 | o5 d2 f4 | o5 d4 c4 o4 b-4 | o4 a2 o5 c4 | o5 f#2 d4/ | o5 g2 d4 | o5 c2 e4 | o5 f2 c4 | o5 f2.</textus>
      </>
    </>
    <pars titulus="harpa_bassus" instrumentum="harpa" lucrum="1">
