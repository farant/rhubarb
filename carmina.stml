  <!-- ambulatio: blues in F (clavis caerulea), XII mensurae bis et
       finis. Melodia scripta; laeva et bassus GENERATI ex acordis:
       charleston / pulsus_bini sine radice (acorda bina), bassus
       ambulans "B:4 T Q A" / "B:4 A B A"; comitatus contigui statum
       continuant. Accessus C#3 super Gm7 (mensurae 12, 24) extra
       clavem nominatur - accessus chromaticus nondum agnoscitur. -->
  <carmen titulus="ambulatio" stylus="iazz" tempus="160" metrum="4/4" clavis="f maior caerulea"
          agogica="2 1 2 1 2 1 2 1">
    <reverberatio aula="0.4" mollities="0.6" latitudo="1" lucrum="0.25"/>
    <sectio titulus="chorus" mensura="1" usque="13"/>
    <acorda mensura="1" textus="F7 | Bb7 | F7 | Cm7:2 F7:2 | Bb7 | Bdim7 | F7 | D7b9 | Gm7 | C7 | F7:2 D7b9:2 | Gm7:2 C7:2"/>
    <!-- acorda non iterantur: chorus secundus et finis declarantur -->
    <acorda mensura="13" textus="F7 | Bb7 | F7 | Cm7:2 F7:2 | Bb7 | Bdim7 | F7 | D7b9 | Gm7 | C7 | F7:2 D7b9:2 | Gm7:2 C7:2 | F7"/>
    <repetitio sectio="chorus" mensura="13" partes="melodia"/>
    <fermata mensura="25"/>
    <pars titulus="melodia" instrumentum="cornu" lucrum="0.7" reverberatio="0.3">
      <frustum mensura="1"><textus!>o4 c8 e-8 f8 a-8 a4 f4 | o4 r8 f8 a-8 b-8 o5 d4 r4 | o5 c8 e-8 c8 o4 a-8 a4 f4 | o5 e-4 d8 c8 o4 a4 f4 | o4 d8 f8 a-8 b-8 o5 d4 o4 b-4 | o4 b8 o5 d8 f8 d8 o4 a-4 b4 | o5 c4 o4 a4 f8 a8 o5 c4 | o5 c8 o4 a8 f#8 d8 e-4 d4 | o4 b-4 g4 d4 g4 | o4 c8 e8 g8 b-8 o5 c4 o4 b-8 g8 | o4 a4 f4 f#4 a4 | o4 g4 b-4 e4 r4</textus></frustum>
      <frustum mensura="25"><textus!>o4 f1</textus></frustum>
    </pars>
    <figura titulus="tenuta" textus="[1 2 3 4]:1" positio="sine_radice"/>
