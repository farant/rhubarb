  <!-- PORTA aedilis ut verdictum (fabrica plan 5 T5b): bin/fabrica
       cursorem ipse currit (signum). Clausura C per librum lectionum
       (bin/aedilis, probationes - canalis T5a); cursor ipse et stipes
       ssh villae (probatio_villa_agens per execvp vocat: lectiones
       bash librum non intrant) per effectus. struere.sh generata
       (build/aedilis/probatio_*) clang directe vocant: fontes eorum
       aedilis ipse legit et notat - identitas clang declaratur. -->
  <actio titulus="porta_aedilis" genus="iudicium" lectiones="verum"
      signum="PORTA AEDILIS:">
    <mandatum>
      <verbum! (>./tools/aedilis_porta.sh
    </mandatum>
    <praecondicio actio="tabulariumd"/>
    <vestigium via="build/aedilis" communis="verum"/>
    <!-- scripta probationum radicis in build/ (nominatim, Fran
         2026-10-06: area una omnium probationum = desideratum) -->
    <vestigium via="build/probatio_generare_instrumenta"/>
    <vestigium via="build/probatio_git_arbores"/>
    <vestigium via="build/probatio_natura_canones"/>
    <vestigium via="build/probatio_silex_area"/>
    <vestigium via="build/probatio_thesaurus"/>
    <vestigium via="build/manus_ultimum.js" forma="plagula"/>
    <vestigium via="build/probatio_ct.db" forma="plagula"/>
    <vestigium via="build/probatio_ct.db-shm" forma="plagula"/>
    <vestigium via="build/probatio_ct.db-wal" forma="plagula"/>
    <vestigium via="build/probatio_ct.jsonl" forma="plagula"/>
    <vestigium via="build/probatio_ct_pid.txt" forma="plagula"/>
    <vestigium via="build/probatio_ct_portus.txt" forma="plagula"/>
    <vestigium via="build/probatio_filum.sera" forma="plagula"/>
    <vestigium via="build/probatio_glossae.html" forma="plagula"/>
    <vestigium via="build/probatio_lectiones.tsv" forma="plagula"/>
    <vestigium via="build/probatio_lectiones_s.txt" forma="plagula"/>
    <vestigium via="build/probatio_mensa.db" forma="plagula"/>
    <vestigium via="build/probatio_vigilia_binarium" forma="plagula"/>
    <vestigium via="build/probatio_vigilia_commissum" forma="plagula"/>
    <vestigium via="build/probatio_vigilia_fons.c" forma="plagula"/>
    <vestigium via="build/probatio_vigilia_manifestum" forma="plagula"/>
    <vestigium via="build/probatio_volumen.db" forma="plagula"/>
    <vestigium via="build/probatio_volumen_aut.db" forma="plagula"/>
    <vestigium via="build/probatio_sent.db" forma="plagula"/>
    <vestigium via="build/probatio_sent.db-shm" forma="plagula"/>
    <vestigium via="build/probatio_sent.db-wal" forma="plagula"/>
    <vestigium via="build/probatio_sent.jsonl" forma="plagula"/>
    <vestigium via="build/probatio_sent.portus" forma="plagula"/>
    <vestigium via="build/probatio_villa.db" forma="plagula"/>
    <vestigium via="build/probatio_villa.db-shm" forma="plagula"/>
    <vestigium via="build/probatio_villa.db-wal" forma="plagula"/>
    <vestigium via="build/probatio_villa.jsonl" forma="plagula"/>
    <vestigium via="build/probatio_villa.portus" forma="plagula"/>
    <ingressus genus="effectus" via="tools/aedilis_porta.sh"/>
    <ingressus genus="effectus" via="probationes/fixa/villa/ssh_stipes.sh"/>
    <ingressus genus="instrumentum_domus" via="bin/aedilis"/>
    <!-- binaria quae probationes per system() currunt: exsecutio
         librum non intrat (lectiones filii C eum intrant) -->
    <ingressus genus="instrumentum_domus" via="bin/generare"/>
    <ingressus genus="instrumentum_domus" via="bin/manus"/>
    <ingressus genus="instrumentum_domus" via="bin/natura"/>
    <ingressus genus="instrumentum_domus" via="bin/natura_canones"/>
    <ingressus genus="instrumentum_domus" via="bin/natura_glossae"/>
    <!-- daemon tabularii (praecondicio tabulariumd, numquam iudicata):
         fontes eius per manifesta fragmenti, non octeti binarii -->
    <ingressus genus="manifesta" via="build/fabrica/clausurae/gesta__tabulariumd_fontes_generata"/>
    <ingressus genus="fasciculus" via="gesta/tabulariumd.sh"/>
    <ingressus genus="fasciculus" via="gesta/tabulariumd_fontes_generata.sh"/>
    <ingressus genus="identitas_clang" via="clang"/>
    <exitus via="build/fabrica/verdicta/aedilis.txt" provenientia="verdictum"/>
  </actio>

  <!-- INSTITUTIONES (1b T5, Q42): copia ~/.bin actio sua - fasciculus
       per regenerationem (generator 'cp') iudicatus, celer (uncus
       sessionis copiam post binarium manentem videt). Nexus (relatio)
       et copia: genera diversa, actiones diversae. -->
  <actio titulus="institutio_briar" genus="institutio" memorabilis="verum" celer="verum">
    <mandatum>
      <verbum! (>./tools/instituere.sh
