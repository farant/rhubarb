  <!-- PORTA aedilis ut verdictum (fabrica plan 5 T5b): bin/fabrica
       cursorem ipse currit (signum). CORPUS aedilis solum (fabrica-7
       T7): derivatio, scripta emissa (build/aedilis/probatio_*) per
       clang directe structa - fontes eorum aedilis ipse legit et notat,
       identitas clang declaratur -, clausura contra clang -MM.
       Probationes NON currit: membra probationes_radicis sunt (porta
       radix); vestigia build/ probationum, praecondicio tabulariumd,
       binaria quae probationes currebant et stipes ssh villae inde
       sublata (debita membrorum, annotationes instrumenti). -->
  <actio titulus="porta_aedilis" genus="iudicium" lectiones="verum"
      signum="PORTA AEDILIS:">
    <mandatum>
      <verbum! (>./tools/aedilis_porta.sh
    </mandatum>
    <vestigium via="build/aedilis" communis="verum"/>
    <ingressus genus="effectus" via="tools/aedilis_porta.sh"/>
    <ingressus genus="instrumentum_domus" via="bin/aedilis"/>
    <ingressus genus="identitas_clang" via="clang"/>
    <exitus via="build/fabrica/verdicta/aedilis.txt" provenientia="verdictum"/>
  </actio>

  <!-- PROBATIONES RADICIS (fabrica-7 T4): suita radicis ut gradus -
       quaeque probationes/probatio_*.c actio sua (clausura aedilis,
       thesaurus, area, ambitus basis, vestigium suum, sectiones credo,
       instrumenta et facultates ex annotationibus). ORACULA usque ad
       commutationem (T7): compile_tests.sh (porta radix) et
       aedilis_porta.sh. Scripta extra aream = DEBITA nominata, quodque
       membri unius (spec 7 IV; olim vestigia porta_aedilis omnibus
       communia) - numerus ad nihil ducendus: scratch ad TMPDIR (area
       ipsa) et linea debiti delenda. -->
  <actio titulus="probationes_radicis" genus="iudicium">
    <probationes_c exemplar="probationes/probatio_*.c" praeter="probatio_*_benchmark.c"/>
    <praecondicio actio="tabulariumd"/>
    <praecondicio actio="speculum_hospes"/>
    <!-- commutatores manu (aurum rescribere, area plutil) et stipes ssh
         quem probatio ipsa ponit et filius legit -->
    <ambitus variabilis="PICTOR_DOCUMENTUM_AURUM_SCRIBERE"/>
    <ambitus variabilis="QUADRANS_AURUM_SCRIBERE"/>
    <ambitus variabilis="PLIST_AREA"/>
    <ambitus variabilis="VILLA_SSH"/>
    <!-- vectura TLS ambitu eligitur (lib/tls.c per lectiones_ambitus,
         tls-bearssl T3 R22): valor in clavi - RHUBARB_TLS mutatum
         probationes TLS iterum currit, verdicta vetera non reddit -->
    <ambitus variabilis="RHUBARB_TLS"/>
    <!-- bibliotheca lectoris (lector L3): vicus_applicatio per
         lectiones_ambitus legit; probatio_vicus_lector ad fixa ponit -->
    <ambitus variabilis="RHUBARB_CODICES"/>
    <!-- imagines pinacothecae (pictor-pinacotheca T7): commutator manu -
         probatio_pictor_pinacotheca PNG in directorium datum scribit,
         sine eo rete in memoria solum pingitur et iudicatur -->
    <ambitus variabilis="PINACOTHECA_IMAGINES"/>
    <debitum_scripturae membrum="probatio_generare" via="build/probatio_generare_instrumenta/" causa="instrumenta generata (scratch) in build/"/>
    <debitum_scripturae membrum="probatio_natura_canones" via="build/probatio_natura_canones/" causa="canones probationis (scratch)"/>
    <debitum_scripturae membrum="probatio_silex" via="build/probatio_silex_area/" causa="area silicis (scratch)"/>
    <debitum_scripturae membrum="probatio_thesaurus" via="build/probatio_thesaurus/" causa="thesaurus probationis (scratch)"/>
    <debitum_scripturae membrum="probatio_manus" via="build/manus_ultimum.js" causa="effusio manus ultima ad inspectionem"/>
    <debitum_scripturae membrum="probatio_filum" via="build/probatio_filum.sera" causa="sera probationis"/>
    <debitum_scripturae membrum="probatio_natura_glossae" via="build/probatio_glossae.html" causa="glossae HTML ad inspectionem"/>
    <debitum_scripturae membrum="probatio_lectiones" via="build/probatio_lectiones.tsv" causa="liber lectionum probationis"/>
    <debitum_scripturae membrum="probatio_multiplexor" via="build/pmx/" causa="socket servitoris tmux proprii (via brevis: sun_path CIV octeti - TMPDIR portae nimis profundus)"/>
    <debitum_scripturae membrum="probatio_vicus_comites_terminale" via="build/pmc/" causa="socket servitoris tmux proprii (via brevis: sun_path CIV octeti - area membri nimis profunda; ut probatio_vicus_saltus build/pmv)"/>
    <debitum_scripturae membrum="probatio_vicus_saltus" via="build/pmv/" causa="socket servitoris tmux proprii (via brevis: sun_path CIV octeti - area membri nimis profunda; lineae S, quaestio 4GY9MJ4; build/pmx multiplexoris est)"/>
    <debitum_scripturae membrum="probatio_lectiones" via="build/probatio_lectiones_s.txt" causa="liber lectionum probationis"/>
    <debitum_scripturae membrum="probatio_ludus_imago" via="build/probatio_ludus_imago_pictor.png" causa="imago ad inspectionem"/>
    <debitum_scripturae membrum="probatio_ludus_imago" via="build/probatio_ludus_imago_quattuor.png" causa="imago ad inspectionem"/>
    <debitum_scripturae membrum="probatio_terminale" via="build/probatio_terminale.png" causa="imago ad inspectionem"/>
    <debitum_scripturae membrum="probatio_vicus_paginae" via="build/probatio_vicus_paginae.png" causa="imago ad inspectionem"/>
    <debitum_scripturae membrum="probatio_vicus_iussa" via="build/probatio_vicus_iussa.png" causa="imago ad inspectionem"/>
    <debitum_scripturae membrum="probatio_pictor_aspergillum" via="build/probatio_pictor_aspergillum.png" causa="imago ad inspectionem"/>
    <debitum_scripturae membrum="probatio_pictor_palette" via="build/probatio_pictor_palette.png" causa="imago ad inspectionem"/>
    <debitum_scripturae membrum="probatio_vigilia" via="build/probatio_vigilia_binarium" causa="vigilia: artificia ficta probationis"/>
    <debitum_scripturae membrum="probatio_vigilia" via="build/probatio_vigilia_commissum" causa="vigilia: artificia ficta probationis"/>
    <debitum_scripturae membrum="probatio_vigilia" via="build/probatio_vigilia_fons.c" causa="vigilia: artificia ficta probationis"/>
    <debitum_scripturae membrum="probatio_vigilia" via="build/probatio_vigilia_manifestum" causa="vigilia: artificia ficta probationis"/>
  </actio>

  <!-- PROBATIONES VENENI (2026-10-22): porta venenum ut variantes
       probationum radicis - suitae quae piscinas notant et reficiunt,
       compilatae cum -DPISCINA_VENENUM=1 et sanitatoribus (vide
       tools/venenum_probare.sh). Vexilla in clave membri: obiecta
       variantis per thesaurum compilatoris SEMEL structa et inter membra
       communia (olim XVII suitae catenam suam quaeque iterum
       compilabant), membra immutata non recurrunt. -Wno-deprecated-
       declarations: SDK sprintf notat solum sub sanitatoribus. -->
  <actio titulus="probationes_veneni" genus="iudicium">
    <probationes_c exemplar="probationes/probatio_*.c"
        membra="probatio_piscina probatio_magnus probatio_fractio probatio_situs probatio_polynomium probatio_matrix probatio_laqueus probatio_extensio probatio_quaternio probatio_radices probatio_cellae probatio_reticulum probatio_plexus probatio_nervus probatio_dependentia probatio_chorda_aedificator probatio_communio_servus"
        vexilla="-g -O1 -fsanitize=address,undefined -fno-sanitize-recover=all -Wno-deprecated-declarations -Wno-overlength-strings -DPISCINA_VENENUM=1"
        vexilla_nexus="-fsanitize=address,undefined"/>
  </actio>

  <!-- INSTITUTIONES (1b T5, Q42): copia ~/.bin actio sua - fasciculus
       per regenerationem (generator 'cp') iudicatus, celer (uncus
       sessionis copiam post binarium manentem videt). Nexus (relatio)
       et copia: genera diversa, actiones diversae. -->
