      <verbum! (>compile_tests.sh
    </mandatum>
    <vestigium via="build/speculum/hospes"/>
    <!-- speculum_generare.sh aedilis super consumptorem currit (manifestum
         eius legit): derivatio in build/aedilis/<consumptor>/ (fabrica-7
         T4 - prius sub compile_tests.sh solo, numquam iudicata) -->
    <vestigium via="build/aedilis/probatio_vitrea_hospes"/>
    <ingressus genus="fasciculus" via="tools/speculum_generare.sh"/>
    <ingressus genus="fasciculus" via="tools/vexilla.sh"/>
