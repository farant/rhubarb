  <!-- SPECULUM HOSPITIS (fabrica plan 5 T5b): capsula fontium quam
       tools/speculum_generare.sh generat. DETERMINISTICA (quaestio
       …4HNHT89B, Franus 2026-10-23): tempus = tempus COMMISSI,
       digestum_fontium pro 'sordidum', manifestum 'generatum' ad
       epocham commissi - ergo provenientia REGENERATIO (fabrica eam
       regenerando iudicat, in scriptura sua) et membra probationum
       radicis eam per CONTENTUM clavant (olim strategia ignota et
       exstantia sola: mutatio fontium quos capsula condit membra
       speculi non iterum currebat). -->
  <actio titulus="speculum_hospes" genus="generator">
    <mandatum>
      <verbum! (>./tools/speculum_generare.sh
