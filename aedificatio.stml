  <!-- COMPOSITA (plan 1b T2): artificia ex artificiis, iudicium =
       pessimum partium. 'bin/fabrica iudicare installata' - partes et
       linea COMPOSITUM post eas. Partes trans subsystemata. -->
  <compositum titulus="installata">
