<!-- aedificatio.stml (radix) - declarationes actionum radicis
     (dialectus aedificatio, aedificatio.canon; bin/fabrica legit per
     fabrica.stml). Plan 1a: T3 iudicem ipsum declarat; T5 generata
     radicis, T7 binaria installata sequuntur. -->
<aedificatio>
  <!-- iudex ipse: primus iudicatur (stalus iudex sententias
       ceteras suspectas facit). Relatio '-provenientia' a T7. -->
  <!-- OBIECTA (1b T5, Q38): thesauri obiectorum per mtime structi quos
       installatores CAECE nectunt - strategia ignota, praecondicio sola
       (numquam iudicatur, numquam pars). Slice 2 obiecta per sigilla. -->
  <actio titulus="obiecta_radicis" genus="generator">
    <mandatum>
      <verbum! (>./compile_tests.sh
      <verbum! (>--obiecta
    </mandatum>
    <vestigium via="build" forma="plagulae" suffixa=".o"/>
    <!-- compile_libraries amalgamata commissa compilat (porta
         amalgamata_probare.sh): acta eius -->
    <vestigium via="build/amalgamata.txt" forma="plagula"/>
    <vestigium via="build/amalgamata_probatio"/>
    <vestigium via="build/test_logs/radix.log" forma="plagula"/>
    <!-- cursor communis (migratio ad compilatorem, gradus IV): mandata
         compilationis et vocationes bibliothecarum -->
    <vestigium via="build/clausurae"/>
    <ingressus genus="fasciculus" via="compile_tests.sh"/>
    <exitus via="build" provenientia="ignota"/>
  </actio>
  <actio titulus="obiecta_briar" genus="generator">
    <mandatum>
      <verbum! (>./briar/compile_probationes.sh
      <verbum! (>--obiecta
    </mandatum>
    <vestigium via="briar/build"/>
    <vestigium via="build/test_logs/briar.log" forma="plagula"/>
    <ingressus genus="fasciculus" via="briar/compile_probationes.sh"/>
    <exitus via="briar/build" provenientia="ignota"/>
  </actio>
  <actio titulus="fabrica" genus="institutio" iudex="verum">
    <mandatum>
      <verbum! (>./tools/fabrica_struere.sh
    </mandatum>
    <praecondicio actio="aedilis"/>
    <vestigium via="build/aedilis/fabrica"/>
    <vestigium via="build/aedilis/obiecta" communis="verum"/>
    <ingressus genus="manifestum" via="build/aedilis/fabrica/manifestum.stml"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="fasciculus" via="tools/fabrica_struere.sh"/>
    <ingressus genus="fasciculus" via="tools/provenientia_scribere.sh"/>
    <exitus via="bin/fabrica" provenientia="relatio"/>
  </actio>
  <!-- binaria installata (T7): SOLA cum relatione '-provenientia'
       declarantur - binarium vexillum ignorans aliquid facere posset -->
  <actio titulus="manus" genus="institutio">
    <mandatum>
      <verbum! (>./tools/manus_struere.sh
    </mandatum>
    <praecondicio actio="aedilis"/>
    <vestigium via="build/aedilis/manus_instrumentum"/>
    <vestigium via="build/aedilis/obiecta" communis="verum"/>
    <ingressus genus="manifestum" via="build/aedilis/manus_instrumentum/manifestum.stml"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="fasciculus" via="tools/manus_struere.sh"/>
    <ingressus genus="fasciculus" via="tools/provenientia_scribere.sh"/>
    <exitus via="bin/manus" provenientia="relatio"/>
  </actio>
  <!-- praeco (colloquia-plan T2): acta colloquiorum Claude Code ex
       hamis (praeco hamus / status / cauda) -->
  <actio titulus="praeco" genus="institutio">
    <mandatum>
      <verbum! (>./tools/praeco_struere.sh
    </mandatum>
    <praecondicio actio="aedilis"/>
    <vestigium via="build/aedilis/praeco"/>
    <vestigium via="build/aedilis/obiecta" communis="verum"/>
    <ingressus genus="manifestum" via="build/aedilis/praeco/manifestum.stml"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="fasciculus" via="tools/praeco_struere.sh"/>
    <ingressus genus="fasciculus" via="tools/provenientia_scribere.sh"/>
    <exitus via="bin/praeco" provenientia="relatio"/>
  </actio>
  <!-- auditio (sonus M5c): sonus et musica in terminali - praeparata,
       cantus, carmina (-carmen/-partitura/-censura/-auscultare/
       -recensio [-json]); instrumentum agentis componentis -->
  <actio titulus="auditio" genus="institutio">
    <mandatum>
      <verbum! (>./tools/auditio_struere.sh
    </mandatum>
    <praecondicio actio="aedilis"/>
    <vestigium via="build/aedilis/auditio"/>
    <vestigium via="build/aedilis/obiecta" communis="verum"/>
    <ingressus genus="manifestum" via="build/aedilis/auditio/manifestum.stml"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="fasciculus" via="tools/auditio_struere.sh"/>
    <ingressus genus="fasciculus" via="tools/provenientia_scribere.sh"/>
    <exitus via="bin/auditio" provenientia="relatio"/>
  </actio>
  <!-- clonare (pythonica S3): clonefile(2) arborum pro photographiis
       silvae (silva._clonare_ignorata) -->
  <actio titulus="clonare" genus="institutio">
    <mandatum>
      <verbum! (>./tools/clonare_struere.sh
    </mandatum>
    <praecondicio actio="aedilis"/>
    <vestigium via="build/aedilis/clonare"/>
    <vestigium via="build/aedilis/obiecta" communis="verum"/>
    <ingressus genus="manifestum" via="build/aedilis/clonare/manifestum.stml"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="fasciculus" via="tools/clonare_struere.sh"/>
    <ingressus genus="fasciculus" via="tools/provenientia_scribere.sh"/>
    <exitus via="bin/clonare" provenientia="relatio"/>
  </actio>
  <!-- compilator (plan 2 T4): 'clang -c' per thesaurum contentorum -->
  <actio titulus="compilator" genus="institutio" iudex="verum">
    <mandatum>
      <verbum! (>./tools/compilator_struere.sh
    </mandatum>
    <praecondicio actio="aedilis"/>
    <vestigium via="build/aedilis/compilator"/>
    <vestigium via="build/aedilis/obiecta" communis="verum"/>
    <ingressus genus="manifestum" via="build/aedilis/compilator/manifestum.stml"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="fasciculus" via="tools/compilator_struere.sh"/>
    <ingressus genus="fasciculus" via="tools/provenientia_scribere.sh"/>
    <exitus via="bin/compilator" provenientia="relatio"/>
  </actio>
  <!-- T7 pars II: binaria installata. Ingressus = clausura aedilis
       (manifestum, plenum post P1) etiam ubi installator indice manu
       struit; installator ipse et scriptor provenientiae. -->
  <actio titulus="aedilis" genus="institutio" iudex="verum">
    <mandatum>
      <verbum! (>./tools/aedilis_struere.sh
    </mandatum>
    <vestigium via="build/aedilis/aedilis"/>
    <vestigium via="bin/aedilis.dSYM"/>
    <vestigium via="build/aedilis" forma="plagulae" suffixa=".o"/>
    <vestigium via="build/aedilis/caput" communis="verum"/>
    <ingressus genus="manifestum" via="build/aedilis/aedilis/manifestum.stml"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="fasciculus" via="tools/aedilis_struere.sh"/>
    <ingressus genus="fasciculus" via="tools/provenientia_scribere.sh"/>
    <ingressus genus="fasciculus" via="tools/provenientia_obiectum.sh"/>
    <exitus via="bin/aedilis" provenientia="relatio"/>
  </actio>
  <!-- FAMILIA (plan 1b T5, D2): scriptum unum binaria duo struit - actio una, exitus duo eiusdem generis; digestum actionis in utroque -->
  <actio titulus="canon" genus="institutio">
    <mandatum>
      <verbum! (>./tools/canon_struere.sh
    </mandatum>
    <praecondicio actio="aedilis"/>
    <vestigium via="build/aedilis/canon_examen"/>
    <vestigium via="bin/canon_examen.dSYM"/>
    <vestigium via="build/aedilis/canon_coquere"/>
    <vestigium via="bin/canon_coquere.dSYM"/>
    <vestigium via="build/canon"/>
    <vestigium via="build/fabrica/provenientia" forma="plagulae" suffixa="canon_examen.c canon_examen.o canon_coquere.c canon_coquere.o"/>
    <ingressus genus="manifestum" via="build/aedilis/canon_examen/manifestum.stml"/>
    <ingressus genus="manifestum" via="build/aedilis/canon_coquere/manifestum.stml"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="fasciculus" via="tools/canon_struere.sh"/>
    <ingressus genus="fasciculus" via="tools/provenientia_scribere.sh"/>
    <ingressus genus="fasciculus" via="tools/provenientia_obiectum.sh"/>
    <exitus via="bin/canon_examen" provenientia="relatio"/>
    <exitus via="bin/canon_coquere" provenientia="relatio"/>
  </actio>
  <!-- FAMILIA (plan 1b T5, D2): scriptum unum binaria quattuor struit - actio una -->
  <actio titulus="natura" genus="institutio">
    <mandatum>
      <verbum! (>./tools/natura_struere.sh
    </mandatum>
    <praecondicio actio="aedilis"/>
    <vestigium via="build/aedilis/natura_examen"/>
    <vestigium via="bin/natura_examen.dSYM"/>
    <vestigium via="build/aedilis/natura_canones"/>
    <vestigium via="bin/natura_canones.dSYM"/>
    <vestigium via="build/aedilis/natura_glossae"/>
    <vestigium via="bin/natura_glossae.dSYM"/>
    <vestigium via="build/aedilis/natura_quaesitor"/>
    <vestigium via="bin/natura.dSYM"/>
    <vestigium via="build/natura"/>
    <vestigium via="build/fabrica/provenientia" forma="plagulae" suffixa="natura_examen.c natura_examen.o natura_canones.c natura_canones.o natura_glossae.c natura_glossae.o natura.c natura.o"/>
    <ingressus genus="manifestum" via="build/aedilis/natura_examen/manifestum.stml"/>
    <ingressus genus="manifestum" via="build/aedilis/natura_canones/manifestum.stml"/>
    <ingressus genus="manifestum" via="build/aedilis/natura_glossae/manifestum.stml"/>
    <ingressus genus="manifestum" via="build/aedilis/natura_quaesitor/manifestum.stml"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="fasciculus" via="tools/natura_struere.sh"/>
    <ingressus genus="fasciculus" via="tools/provenientia_scribere.sh"/>
    <ingressus genus="fasciculus" via="tools/provenientia_obiectum.sh"/>
    <exitus via="bin/natura_examen" provenientia="relatio"/>
    <exitus via="bin/natura_canones" provenientia="relatio"/>
    <exitus via="bin/natura_glossae" provenientia="relatio"/>
    <exitus via="bin/natura" provenientia="relatio"/>
  </actio>
  <actio titulus="stml" genus="institutio">
    <mandatum>
      <verbum! (>./tools/stml_struere.sh
    </mandatum>
    <praecondicio actio="aedilis"/>
    <praecondicio actio="obiecta_radicis"/>
    <vestigium via="build/aedilis/stml"/>
    <vestigium via="bin/stml.dSYM"/>
    <ingressus genus="manifestum" via="build/aedilis/stml/manifestum.stml"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="fasciculus" via="tools/stml_struere.sh"/>
    <ingressus genus="fasciculus" via="tools/provenientia_scribere.sh"/>
    <ingressus genus="fasciculus" via="tools/provenientia_obiectum.sh"/>
    <exitus via="bin/stml" provenientia="relatio"/>
  </actio>
  <actio titulus="mensor" genus="institutio">
    <mandatum>
      <verbum! (>./tools/mensor_struere.sh
    </mandatum>
    <praecondicio actio="aedilis"/>
    <vestigium via="build/aedilis/mensor"/>
    <vestigium via="build/aedilis/obiecta" communis="verum"/>
    <ingressus genus="manifestum" via="build/aedilis/mensor/manifestum.stml"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="fasciculus" via="tools/mensor_struere.sh"/>
    <ingressus genus="fasciculus" via="tools/provenientia_scribere.sh"/>
    <exitus via="bin/mensor" provenientia="relatio"/>
  </actio>
  <actio titulus="terminale" genus="institutio">
    <mandatum>
      <verbum! (>./tools/terminale_struere.sh
    </mandatum>
    <praecondicio actio="aedilis"/>
    <vestigium via="build/aedilis/terminale"/>
    <vestigium via="build/aedilis/obiecta" communis="verum"/>
    <ingressus genus="manifestum" via="build/aedilis/terminale/manifestum.stml"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="fasciculus" via="tools/terminale_struere.sh"/>
    <ingressus genus="fasciculus" via="tools/provenientia_scribere.sh"/>
    <exitus via="bin/terminale" provenientia="relatio"/>
  </actio>
  <actio titulus="mensor_ui" genus="institutio">
    <mandatum>
      <verbum! (>./tools/mensor_ui_struere.sh
    </mandatum>
    <praecondicio actio="aedilis"/>
    <vestigium via="build/aedilis/mensor_ui"/>
    <vestigium via="build/aedilis/obiecta" communis="verum"/>
    <ingressus genus="manifestum" via="build/aedilis/mensor_ui/manifestum.stml"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="fasciculus" via="tools/mensor_ui_struere.sh"/>
    <ingressus genus="fasciculus" via="tools/provenientia_scribere.sh"/>
    <exitus via="bin/mensor_ui" provenientia="relatio"/>
  </actio>
  <!-- T7 pars IIb: briar, spectator, silex. Clausura aedilis (plena
       post P1) + quae installator ipse generat (facies, icon,
       MUTATIONES). corpus infixum per ingressus 'plagulae' (decisio
       Frani 2026-09-30: 'rebake post lib/' tegitur). -->
  <!-- CAPSULAE BRIAR ET CORPUS (1b T6, Q40): olim intra briar_struere.sh
       (et silex, spectator, suite briar) - nunc actiones suae, per
       regenerationem iudicatae (radix umbra: tools/capsula_radicis.sh).
       corpus.versio = SIGILLUM contentorum (Fran, optio a'). -->
  <actio titulus="corpus_silicis" genus="generator" memorabilis="verum">
    <mandatum>
      <verbum! (>./tools/corpus_infixum.sh
    </mandatum>
    <vestigium via="corpus.symbola.tsv" forma="plagula"/>
    <vestigium via="corpus.versio" forma="plagula"/>
    <vestigium via="corpus_silicis.toml" forma="plagula"/>
    <!-- nexus silvae: cache arboris (incrementalis), alii quoque -->
    <vestigium via="build/nexus.tsv" forma="plagula" communis="verum"/>
    <vestigium via="build/inclusiones.tsv" forma="plagula" communis="verum"/>
    <vestigium via="silva/build" communis="verum"/>
    <ingressus genus="plagulae" via="lib" suffixa=".c .m"/>
    <ingressus genus="plagulae" via="include" suffixa=".h"/>
    <ingressus genus="plagulae" via="materia/fontes" suffixa=".c .h"/>
    <ingressus genus="plagulae" via="toml/fontes" suffixa=".c .h"/>
    <ingressus genus="plagulae" via="vendor"/>
    <ingressus genus="plagulae" via="natura/cocta" suffixa=".canon"/>
    <ingressus genus="plagulae" via="silva/grammatica" suffixa=".canon"/>
    <ingressus genus="fasciculus" via="natura/cocta/semina.census"/>
    <ingressus genus="fasciculus" via="tools/capsula_generare.c"/>
    <ingressus genus="fasciculus" via="tools/corpus_infixum.sh"/>
    <ingressus genus="fasciculus" via="canones.registrum"/>
    <ingressus genus="fasciculus" via="natura/natura.canon"/>
    <ingressus genus="fasciculus" via="aedilis.canon"/>
    <ingressus genus="fasciculus" via="canon.canon"/>
    <ingressus genus="fasciculus" via="silva/quaestiones.canon"/>
    <ingressus genus="fasciculus" via="silva/fontes/systema_c89.h"/>
    <ingressus genus="fasciculus" via="silva/fontes/systema_posix.h"/>
    <ingressus genus="fasciculus" via="tools/capsula_radicis.sh"/>
    <!-- nexus (corpus_symbola_generare -> silva/nexus.sh -renovare):
         instrumentum percursus ex fontibus suis structum - custodia
         memorabilium (2026-10-23) eos legi monstravit, non declaratos -->
    <ingressus genus="fasciculus" via="silva/amalgama/silva.c"/>
    <ingressus genus="fasciculus" via="silva/amalgama/silva.h"/>
    <ingressus genus="fasciculus" via="silva/instrumenta/nexus_ordines.c"/>
    <ingressus genus="fasciculus" via="silva/instrumenta/nexus_ordines.h"/>
    <ingressus genus="fasciculus" via="silva/instrumenta/principalia/nexus.c"/>
    <ingressus genus="fasciculus" via="silva/instrumenta/principalia/nexus_percursus.c"/>
    <ingressus genus="fasciculus" via="silva/nexus.sh"/>
    <ingressus genus="plagulae" via="silva" suffixa="nexus_fontes_generata.sh"/>
    <exitus via="build/capsula_corpus_silicis.c" provenientia="regeneratio"/>
    <exitus via="build/capsula_corpus_silicis.h" provenientia="regeneratio"/>
  </actio>
  <actio titulus="capsula_facies_briar" genus="generator" memorabilis="verum">
    <mandatum>
      <verbum! (>./tools/briar_facies_capsula.sh
    </mandatum>
    <ingressus genus="fasciculus" via="briar/facies/facies.html"/>
    <ingressus genus="fasciculus" via="briar/facies/facies.css"/>
    <ingressus genus="fasciculus" via="briar/facies/facies.js"/>
    <ingressus genus="fasciculus" via="briar/facies/md-html-facies.stml"/>
    <ingressus genus="fasciculus" via="tools/briar_facies_capsula.sh"/>
    <ingressus genus="fasciculus" via="tools/capsula_radicis.sh"/>
    <ingressus genus="fasciculus" via="tools/capsula_generare.c"/>
    <exitus via="build/capsula_facies_briar.c" provenientia="regeneratio"/>
    <exitus via="build/capsula_facies_briar.h" provenientia="regeneratio"/>
  </actio>
  <actio titulus="capsula_icon_briar" genus="generator" memorabilis="verum">
    <mandatum>
      <verbum! (>./tools/briar_icon_capsula.sh
    </mandatum>
    <ingressus genus="fasciculus" via="briar/icon/app-icon-transparent.png"/>
    <ingressus genus="fasciculus" via="tools/briar_icon_capsula.sh"/>
    <ingressus genus="fasciculus" via="tools/capsula_radicis.sh"/>
    <ingressus genus="fasciculus" via="tools/capsula_generare.c"/>
    <exitus via="build/capsula_icon_briar.c" provenientia="regeneratio"/>
    <exitus via="build/capsula_icon_briar.h" provenientia="regeneratio"/>
  </actio>
  <actio titulus="capsula_mutationes_briar" genus="generator" memorabilis="verum">
    <mandatum>
      <verbum! (>./tools/briar_mutationes_capsula.sh
    </mandatum>
    <ingressus genus="fasciculus" via="briar/MUTATIONES.md"/>
    <ingressus genus="fasciculus" via="tools/briar_mutationes_capsula.sh"/>
    <ingressus genus="fasciculus" via="tools/capsula_radicis.sh"/>
    <ingressus genus="fasciculus" via="tools/capsula_generare.c"/>
    <exitus via="build/capsula_mutationes_briar.c" provenientia="regeneratio"/>
    <exitus via="build/capsula_mutationes_briar.h" provenientia="regeneratio"/>
  </actio>
  <actio titulus="briar" genus="institutio">
    <mandatum>
      <verbum! (>./tools/briar_struere.sh
    </mandatum>
    <praecondicio actio="aedilis"/>
    <praecondicio actio="obiecta_radicis"/>
    <praecondicio actio="obiecta_briar"/>
    <vestigium via="build/aedilis/briar"/>
    <vestigium via="bin/briar.dSYM"/>
    <vestigium via="build/briar_aedificatio.c" forma="plagula"/>
    <ingressus genus="manifestum" via="build/aedilis/briar/manifestum.stml"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="fasciculus" via="tools/briar_struere.sh"/>
    <ingressus genus="fasciculus" via="tools/provenientia_scribere.sh"/>
    <ingressus genus="fasciculus" via="tools/provenientia_obiectum.sh"/>
    <!-- capsulae: actiones suae (1b T6) - arcus ad eas -->
    <ingressus genus="fasciculus" via="build/capsula_corpus_silicis.c"/>
    <ingressus genus="fasciculus" via="build/capsula_corpus_silicis.h"/>
    <ingressus genus="fasciculus" via="build/capsula_facies_briar.c"/>
    <ingressus genus="fasciculus" via="build/capsula_facies_briar.h"/>
    <ingressus genus="fasciculus" via="build/capsula_icon_briar.c"/>
    <ingressus genus="fasciculus" via="build/capsula_icon_briar.h"/>
    <ingressus genus="fasciculus" via="build/capsula_mutationes_briar.c"/>
    <ingressus genus="fasciculus" via="build/capsula_mutationes_briar.h"/>
    <exitus via="bin/briar" provenientia="relatio"/>
  </actio>
  <actio titulus="briar_spectator" genus="institutio">
    <mandatum>
      <verbum! (>./tools/briar_spectator_struere.sh
    </mandatum>
    <praecondicio actio="aedilis"/>
    <praecondicio actio="obiecta_radicis"/>
    <praecondicio actio="obiecta_briar"/>
    <vestigium via="build/aedilis/briar_spectator"/>
    <vestigium via="bin/briar-spectator.dSYM"/>
    <ingressus genus="manifestum" via="build/aedilis/briar_spectator/manifestum.stml"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="fasciculus" via="tools/briar_spectator_struere.sh"/>
    <ingressus genus="fasciculus" via="tools/provenientia_scribere.sh"/>
    <ingressus genus="fasciculus" via="tools/provenientia_obiectum.sh"/>
    <!-- capsulae: actiones suae (1b T6) -->
    <ingressus genus="fasciculus" via="build/capsula_corpus_silicis.c"/>
    <ingressus genus="fasciculus" via="build/capsula_corpus_silicis.h"/>
    <ingressus genus="fasciculus" via="build/capsula_facies_briar.c"/>
