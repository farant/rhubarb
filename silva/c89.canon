<!--
  c89.canon
  GENERATUM - NE MANU EDITES.

  Fons: c89.stml
  Regeneratio: ./silva/generare.sh
  Recentia: ./tools/silva_canon.sh -probare

  Canon documentorum <parsura> (arbor M2 par. 3): schema
  quo documenta arboris iudicantur. Duae partes:

    DERIVATA   - genera, loci, et QUAE genera quem locum
                 implere possint. Ex grammatica computata,
                 ergo cum motore putrescere non potest.
    MANU SCRIPTA - involucrum (parsura, fontes, cauda,
                 trivia, origines): forma SCRIPTORIS est,
                 non grammaticae. Porta corporis eam
                 falsificat.

  Cardinalitas: locus quisque SEMEL aut nusquam (minimum
  ZERO ordinarius est - absentia loci canonica est, e.g.
  definitio-ansi locum tertium NIHIL relinquit).

  SIGILLUM infra fontes DERIVATIONIS tegit (productiones
  cum annotationibus, genera-extra, registrum, nomina
  generum lexematum) - NON solas tabulas, quas
  'registrum-sigillum' documenti tegit. Distinctio
  necessaria: productio mutata exemplar contenti mutat
  dum tabulae intactae manent.
-->
<canon dialectus="c89" versio="1" sigillum="8b92ecb4">

  <!-- =============== FRAGMENTA ===============
       Vocabularia saepe repetita semel scripta.
       'expressio' et 'sententia' NONTERMINALIA
       grammaticae sunt: clausura (T4) per ea ad folia
       descendit, quod schema praecisum facit et
       CATEGORIAM delet. Fragmentum nomen reddit -
       '<<#expressio>>' dicit quod enumeratio XIX
       generum tacet.

       Factoring TEXTUALE: canon idem dicit quod
       diceret enumeratus, semel scriptum. Membra
       DERIVANTUR (clausura), non manu scripta.
       -->

  <#lexemata>
    <liberum nomen="lex-octetus-ignotus"/>
    <liberum nomen="lex-string-imperfectum"/>
    <liberum nomen="lex-character-imperfectum"/>
    <liberum nomen="lex-identificator"/>
    <liberum nomen="lex-integer"/>
    <liberum nomen="lex-float"/>
    <liberum nomen="lex-character-lit"/>
    <liberum nomen="lex-string-lit"/>
    <liberum nomen="lex-auto"/>
    <liberum nomen="lex-break"/>
    <liberum nomen="lex-case"/>
    <liberum nomen="lex-char"/>
    <liberum nomen="lex-const"/>
    <liberum nomen="lex-continue"/>
    <liberum nomen="lex-default"/>
    <liberum nomen="lex-do"/>
    <liberum nomen="lex-double"/>
    <liberum nomen="lex-else"/>
    <liberum nomen="lex-enum"/>
    <liberum nomen="lex-extern"/>
    <liberum nomen="lex-float-kw"/>
    <liberum nomen="lex-for"/>
    <liberum nomen="lex-goto"/>
    <liberum nomen="lex-if"/>
    <liberum nomen="lex-int"/>
    <liberum nomen="lex-long"/>
    <liberum nomen="lex-register"/>
    <liberum nomen="lex-return"/>
    <liberum nomen="lex-short"/>
    <liberum nomen="lex-signed"/>
    <liberum nomen="lex-sizeof"/>
    <liberum nomen="lex-static"/>
    <liberum nomen="lex-struct"/>
    <liberum nomen="lex-switch"/>
    <liberum nomen="lex-typedef"/>
    <liberum nomen="lex-union"/>
    <liberum nomen="lex-unsigned"/>
    <liberum nomen="lex-void"/>
    <liberum nomen="lex-volatile"/>
    <liberum nomen="lex-while"/>
    <liberum nomen="lex-quadra-aperta"/>
    <liberum nomen="lex-quadra-clausa"/>
    <liberum nomen="lex-paren-aperta"/>
    <liberum nomen="lex-paren-clausa"/>
    <liberum nomen="lex-brace-aperta"/>
    <liberum nomen="lex-brace-clausa"/>
    <liberum nomen="lex-punctum"/>
    <liberum nomen="lex-sagitta"/>
    <liberum nomen="lex-incrementum"/>
    <liberum nomen="lex-decrementum"/>
    <liberum nomen="lex-ampersand"/>
    <liberum nomen="lex-star"/>
    <liberum nomen="lex-plus"/>
    <liberum nomen="lex-minus"/>
    <liberum nomen="lex-tilde"/>
    <liberum nomen="lex-exclamatio"/>
    <liberum nomen="lex-solidus"/>
    <liberum nomen="lex-percentum"/>
    <liberum nomen="lex-sinistrorsum"/>
    <liberum nomen="lex-dextrorsum"/>
    <liberum nomen="lex-minor"/>
    <liberum nomen="lex-maior"/>
    <liberum nomen="lex-minor-aequalis"/>
    <liberum nomen="lex-maior-aequalis"/>
    <liberum nomen="lex-aequalis-aequalis"/>
    <liberum nomen="lex-non-aequalis"/>
    <liberum nomen="lex-caret"/>
    <liberum nomen="lex-barra"/>
    <liberum nomen="lex-et-et"/>
    <liberum nomen="lex-vel-vel"/>
    <liberum nomen="lex-quaestio"/>
    <liberum nomen="lex-colon"/>
    <liberum nomen="lex-semicolon"/>
    <liberum nomen="lex-ellipsis"/>
    <liberum nomen="lex-assignatio"/>
    <liberum nomen="lex-star-assignatio"/>
    <liberum nomen="lex-solidus-assignatio"/>
    <liberum nomen="lex-percentum-assignatio"/>
    <liberum nomen="lex-plus-assignatio"/>
    <liberum nomen="lex-minus-assignatio"/>
    <liberum nomen="lex-sinistrorsum-assignatio"/>
    <liberum nomen="lex-dextrorsum-assignatio"/>
    <liberum nomen="lex-ampersand-assignatio"/>
    <liberum nomen="lex-caret-assignatio"/>
    <liberum nomen="lex-barra-assignatio"/>
    <liberum nomen="lex-comma"/>
    <liberum nomen="lex-cancellum"/>
    <liberum nomen="lex-cancellum-cancellum"/>
    <liberum nomen="lex-spatia"/>
    <liberum nomen="lex-tabulae"/>
    <liberum nomen="lex-nova-linea"/>
    <liberum nomen="lex-continuatio"/>
    <liberum nomen="lex-commentum-clausum"/>
    <liberum nomen="lex-commentum-linea"/>
  </#>

  <#expressio>
    <liberum nomen="virgula" maximum="1"/>
    <liberum nomen="assignatio" maximum="1"/>
    <liberum nomen="ternarius" maximum="1"/>
    <liberum nomen="binarium" maximum="1"/>
    <liberum nomen="conversio" maximum="1"/>
    <liberum nomen="unarium" maximum="1"/>
    <liberum nomen="magnitudo-expressionis" maximum="1"/>
    <liberum nomen="magnitudo-typi" maximum="1"/>
    <liberum nomen="subscriptio" maximum="1"/>
    <liberum nomen="vocatio" maximum="1"/>
    <liberum nomen="accessus" maximum="1"/>
    <liberum nomen="postcrementum" maximum="1"/>
    <liberum nomen="folium-identificator" maximum="1"/>
    <liberum nomen="folium-integer" maximum="1"/>
    <liberum nomen="folium-fluitans" maximum="1"/>
    <liberum nomen="folium-character" maximum="1"/>
    <liberum nomen="folium-chorda" maximum="1"/>
    <liberum nomen="parenthesis" maximum="1"/>
    <liberum nomen="ambiguus"/>
  </#>

  <#sententia>
    <liberum nomen="sententia-expressionis" maximum="1"/>
    <liberum nomen="sententia-vacua" maximum="1"/>
    <liberum nomen="corpus" maximum="1"/>
    <liberum nomen="si" maximum="1"/>
    <liberum nomen="dum" maximum="1"/>
    <liberum nomen="fac-dum" maximum="1"/>
    <liberum nomen="per" maximum="1"/>
    <liberum nomen="commutatio" maximum="1"/>
    <liberum nomen="titulatum" maximum="1"/>
    <liberum nomen="salta" maximum="1"/>
    <liberum nomen="frange" maximum="1"/>
    <liberum nomen="perge" maximum="1"/>
    <liberum nomen="redde" maximum="1"/>
    <liberum nomen="ambiguus"/>
  </#>

  <!-- =============== INVOLUCRUM ===============
       Forma SCRIPTORIS (silva_arbor.c), non grammaticae:
       nullum eius vestigium in c89.stml est, ergo manu
       scriptum. Porta corporis (probatio_silva_canon) eam
       falsificat, non derivatio.
       -->

  <elementum nomen="parsura" radix="verum">
    <attributum nomen="grammatica" genus="nomen"
      necessarium="verum"/>
    <attributum nomen="registrum-sigillum" genus="nomen"
      necessarium="verum"
      nota="sigillum FNV-1a tabularum, hexadecimale"/>
    <attributum nomen="fons-princeps" genus="numerus"/>
    <liberum nomen="fontes" minimum="1" maximum="1"/>
    <liberum nomen="cauda"  maximum="1"/>
    <liberum nomen="directiva"/>
    <liberum nomen="invocatio-vacua"/>
    <liberum nomen="regio-directiva"/>
    <liberum nomen="regio-cruda"/>
    <liberum nomen="regio-finis"/>
    <!-- POLITIA, non derivatum: error et conditionalis in
         gradu supremo SOLO (spec par. 0.1 cautio II) -
         INFERTUM ex duabus sedibus constructionis, ergo
         hic positum ut corpus id falsificet. -->
    <liberum nomen="error"/>
    <liberum nomen="conditionalis"/>
    <liberum nomen="ambiguus"/>
    <liberum nomen="sententia-expressionis"/>
    <liberum nomen="sententia-vacua"/>
    <liberum nomen="corpus"/>
    <liberum nomen="si"/>
    <liberum nomen="dum"/>
    <liberum nomen="fac-dum"/>
    <liberum nomen="per"/>
    <liberum nomen="commutatio"/>
    <liberum nomen="titulatum"/>
    <liberum nomen="salta"/>
    <liberum nomen="frange"/>
    <liberum nomen="perge"/>
    <liberum nomen="redde"/>
    <liberum nomen="declaratio"/>
    <liberum nomen="definitio-functionis"/>
  </elementum>

  <elementum nomen="fontes">
    <liberum nomen="fons" minimum="1"
      nota="tabula vacua mendacium esset: lexema quodlibet
            fontem nominare potest"/>
  </elementum>

  <elementum nomen="fons">
    <attributum nomen="index" genus="numerus"
      necessarium="verum"/>
    <attributum nomen="via"   genus="textus"
      necessarium="verum"/>
    <attributum nomen="lexicon" genus="electio">
      <optio>true</optio>
    </attributum>
    <attributum nomen="syntheticus" genus="electio">
      <optio>true</optio>
    </attributum>
  </elementum>

  <elementum nomen="cauda"
    nota="lexema EOF trivia caudae plagulae fert - ergo
          documentum octetos finales non perdit">
    <attributum nomen="b"       genus="numerus"/>
    <attributum nomen="linea"   genus="numerus"/>
    <attributum nomen="columna" genus="numerus"/>
    <attributum nomen="linea-initium" genus="electio"
      nota="attributum NUDUM - stml praesentiam ut 'true'
            internat, ergo electio, non veritas (illa
            'verum|falsum' poscit)">
      <optio>true</optio>
    </attributum>
    <liberum nomen="lex-eof" minimum="1" maximum="1"/>
  </elementum>

  <!-- REINSERENDA: laminae lexematum quas arbor NON fert
       (directivae, invocationes vacuae, regiones non
       sumptae). Ordine octetorum inter nodos supremos
       inseruntur. -->

  <elementum nomen="directiva">
    <attributum nomen="b"       genus="numerus"/>
    <attributum nomen="linea"   genus="numerus"/>
    <attributum nomen="columna" genus="numerus"/>
    <attributum nomen="linea-initium" genus="electio"
      nota="attributum NUDUM - stml praesentiam ut 'true'
            internat, ergo electio, non veritas (illa
            'verum|falsum' poscit)">
      <optio>true</optio>
    </attributum>
    <<#lexemata>>
  </elementum>

  <elementum nomen="invocatio-vacua"
    nota="invocatio macri quae ZERO lexemata peperit:
          octetos tegit quos arbor non fert">
    <attributum nomen="b"       genus="numerus"/>
    <attributum nomen="linea"   genus="numerus"/>
    <attributum nomen="columna" genus="numerus"/>
    <attributum nomen="linea-initium" genus="electio"
      nota="attributum NUDUM - stml praesentiam ut 'true'
            internat, ergo electio, non veritas (illa
            'verum|falsum' poscit)">
      <optio>true</optio>
    </attributum>
    <<#lexemata>>
  </elementum>

  <elementum nomen="regio-directiva">
    <attributum nomen="regio"       genus="numerus"
      necessarium="verum"/>
    <attributum nomen="pater"       genus="numerus"/>
    <attributum nomen="regio-fons"  genus="numerus"
      necessarium="verum"/>
    <attributum nomen="regio-linea" genus="numerus"
      necessarium="verum"/>
    <attributum nomen="ramus"       genus="numerus"
      necessarium="verum"/>
    <attributum nomen="genus"       genus="electio">
      <optio>if</optio>
      <optio>ifdef</optio>
      <optio>ifndef</optio>
      <optio>elif</optio>
      <optio>else</optio>
    </attributum>
    <attributum nomen="conditio"    genus="numerus"
      necessarium="verum"/>
    <attributum nomen="b"       genus="numerus"/>
    <attributum nomen="linea"   genus="numerus"/>
    <attributum nomen="columna" genus="numerus"/>
    <attributum nomen="linea-initium" genus="electio"
      nota="attributum NUDUM - stml praesentiam ut 'true'
            internat, ergo electio, non veritas (illa
            'verum|falsum' poscit)">
      <optio>true</optio>
    </attributum>
    <<#lexemata>>
  </elementum>

  <elementum nomen="regio-cruda">
    <attributum nomen="regio"       genus="numerus"
      necessarium="verum"/>
    <attributum nomen="pater"       genus="numerus"/>
    <attributum nomen="regio-fons"  genus="numerus"
      necessarium="verum"/>
    <attributum nomen="regio-linea" genus="numerus"
      necessarium="verum"/>
    <attributum nomen="ramus"       genus="numerus"
      necessarium="verum"/>
    <attributum nomen="genus"       genus="electio">
      <optio>if</optio>
      <optio>ifdef</optio>
      <optio>ifndef</optio>
      <optio>elif</optio>
      <optio>else</optio>
    </attributum>
    <attributum nomen="conditio"    genus="numerus"
      necessarium="verum"/>
    <attributum nomen="b"       genus="numerus"/>
    <attributum nomen="linea"   genus="numerus"/>
    <attributum nomen="columna" genus="numerus"/>
    <attributum nomen="linea-initium" genus="electio"
      nota="attributum NUDUM - stml praesentiam ut 'true'
            internat, ergo electio, non veritas (illa
            'verum|falsum' poscit)">
      <optio>true</optio>
    </attributum>
    <<#lexemata>>
  </elementum>

  <elementum nomen="regio-finis">
    <attributum nomen="regio"       genus="numerus"
      necessarium="verum"/>
    <attributum nomen="pater"       genus="numerus"/>
    <attributum nomen="regio-fons"  genus="numerus"
      necessarium="verum"/>
    <attributum nomen="regio-linea" genus="numerus"
      necessarium="verum"/>
    <attributum nomen="b"       genus="numerus"/>
    <attributum nomen="linea"   genus="numerus"/>
    <attributum nomen="columna" genus="numerus"/>
    <attributum nomen="linea-initium" genus="electio"
      nota="attributum NUDUM - stml praesentiam ut 'true'
            internat, ergo electio, non veritas (illa
            'verum|falsum' poscit)">
      <optio>true</optio>
    </attributum>
    <<#lexemata>>
  </elementum>

  <!-- TRIVIA: unius domini semper (invariatum roundtrip) -->

  <elementum nomen="ante">
    <liberum nomen="lex-spatia"/>
    <liberum nomen="lex-tabulae"/>
    <liberum nomen="lex-nova-linea"/>
    <liberum nomen="lex-continuatio"/>
    <liberum nomen="lex-commentum-clausum"/>
    <liberum nomen="lex-commentum-linea"/>
  </elementum>

  <elementum nomen="post">
    <liberum nomen="lex-spatia"/>
    <liberum nomen="lex-tabulae"/>
    <liberum nomen="lex-nova-linea"/>
    <liberum nomen="lex-continuatio"/>
    <liberum nomen="lex-commentum-clausum"/>
    <liberum nomen="lex-commentum-linea"/>
  </elementum>

  <elementum nomen="scissura"
    nota="lamina '\\'+nova-linea INTRA lexema">
    <attributum nomen="offset" genus="numerus"
      necessarium="verum"/>
    <attributum nomen="crlf" genus="electio">
      <optio>true</optio>
    </attributum>
  </elementum>

  <!-- ORIGINES: elementum originis INTRA elementum
       lexematis sedet, iuxta textum valoris et trivia.
       Catenae NESTATIONE LITTERALI: macro ex macro natum
       elementum suum INTRA invocationem ferit. -->

  <elementum nomen="expansio">
    <attributum nomen="macro" genus="textus"/>
    <attributum nomen="def-f" genus="numerus"/>
    <attributum nomen="def-l" genus="numerus"/>
    <attributum nomen="def-c" genus="numerus"/>
    <liberum nomen="extentum" maximum="1"/>
    <<#lexemata>>
  </elementum>

  <elementum nomen="pasta">
    <attributum nomen="macro" genus="textus"/>
    <attributum nomen="def-f" genus="numerus"/>
    <attributum nomen="def-l" genus="numerus"/>
    <attributum nomen="def-c" genus="numerus"/>
    <liberum nomen="extentum" maximum="1"/>
    <<#lexemata>>
  </elementum>

  <elementum nomen="stringificatio">
    <attributum nomen="macro" genus="textus"/>
    <attributum nomen="def-f" genus="numerus"/>
    <attributum nomen="def-l" genus="numerus"/>
    <attributum nomen="def-c" genus="numerus"/>
    <liberum nomen="extentum" maximum="1"/>
    <<#lexemata>>
  </elementum>

  <elementum nomen="api"
    nota="lexema ab API iniectum (speculum): nullam sedem
          in plagula habet">
    <attributum nomen="macro" genus="textus"/>
    <attributum nomen="def-f" genus="numerus"/>
    <attributum nomen="def-l" genus="numerus"/>
    <attributum nomen="def-c" genus="numerus"/>
    <liberum nomen="extentum" maximum="1"/>
    <<#lexemata>>
  </elementum>

  <elementum nomen="extentum"
    nota="octeti invocationis [nomen..')'] quos NULLUM
          lexema arboris monstrat - portandi, non
          derivandi">
    <<#lexemata>>
  </elementum>

  <!-- =============== LEXEMATA ===============
       Ex enumeratione SilvaLexemaGenus (silva_token.h),
       NON ex terminalibus grammaticae: trivia terminalia
       non sunt, sed elementa lexematum sunt.
       -->

  <elementum nomen="lex-eof">
    <attributum nomen="f"        genus="numerus"/>
    <attributum nomen="standard" genus="numerus"/>
    <attributum nomen="b"       genus="numerus"/>
    <attributum nomen="linea"   genus="numerus"/>
    <attributum nomen="columna" genus="numerus"/>
    <attributum nomen="linea-initium" genus="electio"
      nota="attributum NUDUM - stml praesentiam ut 'true'
            internat, ergo electio, non veritas (illa
            'verum|falsum' poscit)">
      <optio>true</optio>
    </attributum>
    <liberum nomen="ante" maximum="1"/>
    <liberum nomen="post" maximum="1"/>
    <liberum nomen="scissura"/>
    <liberum nomen="expansio"       maximum="1"/>
    <liberum nomen="pasta"          maximum="1"/>
    <liberum nomen="stringificatio" maximum="1"/>
    <liberum nomen="api"            maximum="1"/>
  </elementum>

  <elementum nomen="lex-octetus-ignotus" textus="verum">
    <attributum nomen="f"        genus="numerus"/>
    <attributum nomen="standard" genus="numerus"/>
    <attributum nomen="b"       genus="numerus"/>
    <attributum nomen="linea"   genus="numerus"/>
    <attributum nomen="columna" genus="numerus"/>
    <attributum nomen="linea-initium" genus="electio"
      nota="attributum NUDUM - stml praesentiam ut 'true'
            internat, ergo electio, non veritas (illa
            'verum|falsum' poscit)">
      <optio>true</optio>
    </attributum>
    <liberum nomen="ante" maximum="1"/>
    <liberum nomen="post" maximum="1"/>
    <liberum nomen="scissura"/>
    <liberum nomen="expansio"       maximum="1"/>
    <liberum nomen="pasta"          maximum="1"/>
    <liberum nomen="stringificatio" maximum="1"/>
    <liberum nomen="api"            maximum="1"/>
  </elementum>

  <elementum nomen="lex-string-imperfectum" textus="verum">
    <attributum nomen="f"        genus="numerus"/>
    <attributum nomen="standard" genus="numerus"/>
    <attributum nomen="b"       genus="numerus"/>
    <attributum nomen="linea"   genus="numerus"/>
    <attributum nomen="columna" genus="numerus"/>
    <attributum nomen="linea-initium" genus="electio"
      nota="attributum NUDUM - stml praesentiam ut 'true'
            internat, ergo electio, non veritas (illa
            'verum|falsum' poscit)">
      <optio>true</optio>
    </attributum>
    <liberum nomen="ante" maximum="1"/>
    <liberum nomen="post" maximum="1"/>
    <liberum nomen="scissura"/>
    <liberum nomen="expansio"       maximum="1"/>
    <liberum nomen="pasta"          maximum="1"/>
    <liberum nomen="stringificatio" maximum="1"/>
    <liberum nomen="api"            maximum="1"/>
  </elementum>

  <elementum nomen="lex-character-imperfectum" textus="verum">
    <attributum nomen="f"        genus="numerus"/>
    <attributum nomen="standard" genus="numerus"/>
    <attributum nomen="b"       genus="numerus"/>
    <attributum nomen="linea"   genus="numerus"/>
    <attributum nomen="columna" genus="numerus"/>
    <attributum nomen="linea-initium" genus="electio"
      nota="attributum NUDUM - stml praesentiam ut 'true'
            internat, ergo electio, non veritas (illa
            'verum|falsum' poscit)">
      <optio>true</optio>
    </attributum>
    <liberum nomen="ante" maximum="1"/>
    <liberum nomen="post" maximum="1"/>
    <liberum nomen="scissura"/>
    <liberum nomen="expansio"       maximum="1"/>
    <liberum nomen="pasta"          maximum="1"/>
    <liberum nomen="stringificatio" maximum="1"/>
    <liberum nomen="api"            maximum="1"/>
  </elementum>

  <elementum nomen="lex-identificator" textus="verum">
    <attributum nomen="f"        genus="numerus"/>
    <attributum nomen="standard" genus="numerus"/>
    <attributum nomen="b"       genus="numerus"/>
    <attributum nomen="linea"   genus="numerus"/>
    <attributum nomen="columna" genus="numerus"/>
    <attributum nomen="linea-initium" genus="electio"
      nota="attributum NUDUM - stml praesentiam ut 'true'
            internat, ergo electio, non veritas (illa
            'verum|falsum' poscit)">
      <optio>true</optio>
    </attributum>
    <liberum nomen="ante" maximum="1"/>
    <liberum nomen="post" maximum="1"/>
    <liberum nomen="scissura"/>
