  <!-- =============== CLAVES ===============
       'index' fontis clavis est; quicumque fontem numero
       nominat eam citat. Prima usura gravis citationis
       extra naturam.
       -->

  <unicitas nomen="fontium-indices" attributum="index"
    super="fons"
    nota="index bis datus tabulam fontium ambiguam facit"/>

  <citatio nomen="lexematis-fons" attributum="f"
    ad="fons/index" super="*"
    nota="'f=' cuiuslibet lexematis fontem tabulae
          nominat; super='*' quia lexemata XCV sunt"/>

  <citatio nomen="definitionis-fons" attributum="def-f"
    ad="fons/index" super="expansio pasta stringificatio api"
    nota="sedes DEFINITIONIS macri - plagula alia quam
          invocatio"/>

  <citatio nomen="regionis-fons" attributum="regio-fons"
    ad="fons/index"
    super="regio-directiva regio-cruda regio-finis"/>

  <citatio nomen="principis-fons" attributum="fons-princeps"
    ad="fons/index" super="parsura"/>

</canon>
