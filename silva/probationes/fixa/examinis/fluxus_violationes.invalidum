/* violationes fluxus: frange extra contextum + salta ad titulum
 * ignotum - clang ambobus ERRAT; foramen paritatis verdicti
 * clausum (FLUXUS-0 tractus 2, codices 66/67). */

static int extra_ansam(int x)
{
    /* <exspecta codex="FRANGE_EXTRA_CONTEXTUM"/> */
    break;
    return x;
}

static int ad_ignotum(int x)
{
    /* <exspecta codex="SALTA_AD_TITULUM_IGNOTUM"/> */
    goto ignotum;
    return x;
}
