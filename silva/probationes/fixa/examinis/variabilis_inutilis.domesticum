/* variabilis inutilis (codex 69) - paritas -Wunused-variable
 * (in -Wall). Initiator cum effectu NON eximit; (void)x usus est.
 * ORACULUM -Wunused-variable */

static int g(void) { return 1; }
static void f(void)
{
    /* <exspecta codex="VARIABILIS_INUTILIS"/> */
    int mortuus;
    int visus = g();
    (void)visus;
    f();
}
