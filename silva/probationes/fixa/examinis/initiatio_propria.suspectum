/* initiatio propria (codex 71) - int x = x (specimen s02).
 * ORACULUM -Wuninitialized */

static int propria(void)
{
    /* EXSPECTA-PROXIMA: LECTIO_ININITIATA */
    int x = x;

    return x;
}

