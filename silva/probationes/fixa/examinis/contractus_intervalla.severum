/* Contractus intervallorum (01KYN533VY): intervallum ad TYPEDEF
 * ligatum (declarationes typum ferentes semen angustum accipiunt)
 * + contractus param intra inline. Fiducia sedis INTROITUS sola -
 * probationes SEVERAE et codicis 80 ambitum seminatum vident.
 * Annotatio commentarium PROPRIUM postulat (prosa ducens ligamen
 * frangit - mensuratum flatura 2026-07-28). Clang omnibus caecus.
 * ORACULUM -Wsign-conversion */

/* <contractus intra="0,16"/> */
typedef unsigned nb_t;

/* typedef refinatum: larva (1 << n) - 1 in [0, 65535] - TACET */
static unsigned larva_probata(nb_t n)
{
    unsigned v = (1 << n) - 1;
    return v;
}

/* sine contractu: fluctus [0, 2^32-1] improbabilis - SEVERA manet */
static unsigned larva_nuda(unsigned m)
{
    /* <exspecta codex="CONVERSIO_SIGNI_SEVERA"/> */
    unsigned v = (1 << m) - 1;
    return v;
}

/* param inline: subtractio custodita contractu - codex 80 TACET */
/* <contractus param="n" intra="2,16"/> */
static int subtractio_probata(unsigned n)
{
    unsigned x = n - 2u;

    if (x <= 0u)
    {
        return 1;
    }
    return 0;
}

/* typedef refinatum sed subtrahendum extra fines - codex 80 manet */
static int subtractio_nuda(nb_t n)
{
    unsigned x = n - 17u;

    /* <exspecta codex="SUBTRACTIO_COMPARATA"/> */
    if (x <= 0u)
    {
        return 1;
    }
    return 0;
}

/* intra pravum: grammatica recusata - CONTRACTUS_STALUS */
/* <exspecta codex="CONTRACTUS_STALUS"/> */
/* <contractus intra="banana"/> */
typedef unsigned malum_t;

/* contractus reditus (01KYN7V4G7): effectus vocationis fiducia */
/* <contractus reditus="1,255"/> */
static unsigned mensura_ex(void)
{
    return 7u;
}

static unsigned mensura_nuda(void)
{
    return 7u;
}

/* reditus probatus: [1,255] - 1 numquam involvit - TACET */
static int reditus_probatus(void)
{
    unsigned x = mensura_ex() - 1u;

    if (x <= 0u)
    {
        return 1;
    }
    return 0;
}

/* sine contractu reditus: involutio possibilis - manet */
static int reditus_nudus(void)
{
    unsigned x = mensura_nuda() - 1u;

    /* <exspecta codex="SUBTRACTIO_COMPARATA"/> */
    if (x <= 0u)
    {
        return 1;
    }
    return 0;
}

/* gradus 2 (01KYNRVKW5): probatio contra contractus - onus
 * inversum, emissio sola disiunctione probata. Clang caecus. */

/* argumentum constans extra contractum typedef - violatio */
static unsigned g2_argumentum(void)
{
    /* <exspecta codex="CONTRACTUS_INTERVALLI_VIOLATUS"/> */
    return larva_probata(99u);
}

/* argumentum intra contractum - TACET */
static unsigned g2_argumentum_bonum(void)
{
    return larva_probata(7u);
}

/* 'fortasse extra' TACET (criterium): fines typi contra [0,16] */
static unsigned g2_argumentum_fortasse(unsigned m)
{
    return larva_probata(m);
}

/* initiator localis typo refinato - violatio */
static unsigned g2_definitio(void)
{
    /* <exspecta codex="CONTRACTUS_INTERVALLI_VIOLATUS"/> */
    nb_t v = 99u;

    return v;
}

/* redde contra contractum reditus - violatio */
/* <contractus reditus="1,255"/> */
static unsigned g2_redde(void)
{
    /* <exspecta codex="CONTRACTUS_INTERVALLI_VIOLATUS"/> */
    return 0u;
}

/* violatio consulto tolerata - QUIETA */
static unsigned g2_tolerata(void)
{
    /* <tolera codex="CONTRACTUS_INTERVALLI_VIOLATUS" (>exemplar suppressionis fixturae: violatio consulta */
    return larva_probata(99u);
}

static unsigned radix(nb_t n, unsigned m)
{
    malum_t ignotum = 0u;

    return larva_probata(n) + larva_nuda(m)
        + (unsigned)subtractio_probata(m)
        + (unsigned)subtractio_nuda(n) + ignotum
        + (unsigned)reditus_probatus() + (unsigned)reditus_nudus()
        + g2_argumentum() + g2_argumentum_bonum()
        + g2_argumentum_fortasse(m) + g2_definitio()
        + g2_redde() + g2_tolerata();
}
