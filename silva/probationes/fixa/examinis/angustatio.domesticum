/* angustatio implicita (codex 68) - paritas -Wconversion directione
 * latitudinis (sub-vexilla clang: implicit-int-conversion /
 * constant-conversion / shorten-64-to-32 = codex unus noster).
 * Constantes capientes tacent (-1 in s8 quoque); casus vestitus
 * tacet. ORACULUM -Wconversion */

static void f(unsigned int magnum, int medium)
{
    /* EXSPECTA-PROXIMA: ANGUSTATIO */
    unsigned char parvum = magnum;
    /* EXSPECTA-PROXIMA: ANGUSTATIO */
    short breve = medium;
    unsigned char constans_bona = 100;
    signed char negativus = -1;
    (void)parvum;
    (void)breve;
    (void)constans_bona;
    (void)negativus;
}
