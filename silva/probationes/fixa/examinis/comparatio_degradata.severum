/* comparatio degradata - insignati <= 0 fit == 0. GRADUS DORMIT
 * (decretum 2026-07-17): census primus 228 = idioma vacuitatis
 * (mensura <= 0) formam possidet; re-armatur ut consumptor
 * analyseos fluxus (CFG gradus 2). Specimen dormiens - NULLAE
 * pinnae.
 * 2026-07-27: condicio re-armationis IMPLETA a codice 80 forma-
 * fluxus (subtractio_formae.severum) - separator = definitiones
 * operandi, exacte ut decretum 01KXRBS0VQ poposcit. 62 SUBSUMPTUS
 * dormit in aeternum; specimina infra recte TACENT etiam nunc
 * (variabile nudum sine subtractione = idioma vacuitatis). */

static unsigned mortua(unsigned u)
{
    return u <= 0;
}

static unsigned altera(unsigned u)
{
    return 0 >= u;
}

static unsigned radix(unsigned u)
{
    return mortua(u) + altera(u);
}
