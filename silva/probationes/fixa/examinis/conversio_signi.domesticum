/* conversio signi implicita - decipulae historicae domus (murus
 * i32-insignatus: -I ex functione insignata, -I ut argumentum,
 * assignationes trans signum). LEGALE C89 - verdictum examinis
 * ACCIPE manet (gradus DOMESTICUM), ordines tamen flagrant et
 * oraculum clang -Wsign-conversion easdem lineas monet. */

static unsigned locum_invenire(void)
{
    /* <exspecta codex="CONVERSIO_SIGNI"/> */
    return -1;
}

static void poscere(unsigned n)
{
    (void)n;
}

static void vocans(void)
{
    /* <exspecta codex="CONVERSIO_SIGNI"/> */
    poscere(-1);
}

static unsigned assignans(int sedes)
{
    unsigned index;

    /* <exspecta codex="CONVERSIO_SIGNI"/> */
    index = sedes;
    return index;
}

static int redditor(unsigned magnum)
{
    /* <exspecta codex="CONVERSIO_SIGNI"/> */
    return magnum;
}

static int radix(void)
{
    (void)locum_invenire();
    vocans();
    (void)assignans(-2);
    return redditor(7u);
}
