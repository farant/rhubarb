<!-- silva/transformationes/remove.stml - remove -> filum_delere (codex 97 SCRIPTURA_PRAETERITA, fabrica-8).
     filum_delere = remove() ipsum + linea S in libro lectionum.
     Conventio: functio cruda 0 in successu, -1 in defectu (errno);
     substituta VERUM in successu (b32). errno defectus servatur.
     Formae non tectae (valor ut numerus, errno in eadem expressione,
     macra) recusantur et manu emendantur: census primum,
       ./silva/transformare.sh -census <functio> <viae>
     consilium (nihil scribitur), deinde -scribere (custodia: codex 97
     exacte, nihil crescit, clang ante et post). -->
<transformatio functio="remove" codex="97">
  <inclusio>filum.h</inclusio>
  <regula>
    <si! (>(vacuum)remove($via);
    <fac! (>(vacuum)filum_delere($via);
  </regula>
  <regula>
    <si! (>remove($via);
    <fac! (>(vacuum)filum_delere($via);
  </regula>
  <regula>
    <si! (>remove($via) != ZEPHYRUM
    <fac! (>!filum_delere($via)
  </regula>
  <regula>
    <si! (>remove($via) == ZEPHYRUM
    <fac! (>filum_delere($via)
  </regula>
  <regula>
    <si! (>remove($via) < ZEPHYRUM
    <fac! (>!filum_delere($via)
  </regula>
  <regula>
    <si! (>remove($via) == -I
    <fac! (>!filum_delere($via)
  </regula>
  <regula>
    <si! (>remove($via) != -I
    <fac! (>filum_delere($via)
  </regula>
</transformatio>
