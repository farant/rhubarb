# imago portae Linux (glibc) - ubuntu LTS + gcc
# aedificatio: docker build -t rhubarb-proba-glibc -f tools/linux/Dockerfile.glibc tools/linux
FROM ubuntu:22.04
# curl: sectiones differentiales (hospitium v3 T9)
# openssl: certificata probationis in tempore (fiducia-linux T1)
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev curl ca-certificates openssl && rm -rf /var/lib/apt/lists/*
