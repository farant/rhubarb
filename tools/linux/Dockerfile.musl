# imago portae Linux (musl) - alpine + gcc
# aedificatio: docker build -t rhubarb-proba-musl -f tools/linux/Dockerfile.musl tools/linux
FROM alpine:3.20
# curl: sectiones differentiales (curl -F, vas crustulorum) - hospitium v3 T9
# openssl: certificata probationis in tempore (fiducia-linux T1)
# ca-certificates: fasciculus fiduciae (fiducia_posix; curl id iam trahit,
# hic expresse - fiducia-linux T3)
RUN apk add --no-cache gcc musl-dev bash curl openssl ca-certificates
