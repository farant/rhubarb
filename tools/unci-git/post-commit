#!/bin/bash

# post-commit - basis nexus.tsv commissiones sequitur (LEGATUS
# v0.1b: tabulae vetustas trans-sessionalis = lacuna maxima indicis;
# commissio = momentum quo plagulae "vigilatae" fiunt "clausae").
#
# Installatio (semel, localis):
#   git config core.hooksPath tools/unci-git
# Remotio: git config --unset core.hooksPath
#
# Percursus in FUNDO curritur (nice; fd-s solutae ne git pendeat);
# sera contra cumulationem; debounce 10 min. Scriptura tabulae
# ATOMICA (sweep .nova + rename) - lectores numquam truncata vident.

RADIX="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
TSV="$RADIX/build/nexus.tsv"
SERA="$RADIX/build/nexus_renovare.sera"

# stampa commissionis pro politica tacendi vigiliarum (lib/vigilia
# 2026-07-17): residentes eam per petitionem stat-ant - commissio
# agnitiones tacendi re-armat. ANTE debounce - semper tangitur.
touch "$RADIX/.vigilia_commissum" 2>/dev/null

# debounce: tabula satis recens - per stampam GENERATUM INTERNAM,
# non mtime (mtime fallax: sondae "touch" reload servi probant sine
# contentu novo et debounce venenabant - inventum shakedown MCP
# 2026-07-14: commissio chunk-2 tabulam NON renovavit, symbola nova
# "ignota"; stampa solum cum regeneratione vera mutatur)
if [ -f "$TSV" ]; then
    STAMPA="$(head -n 1 "$TSV" \
        | sed -n 's/^# nexus.tsv GENERATUM \([0-9]*\).*/\1/p')"
    NUNC="$(date +%s)"
    if [ -n "$STAMPA" ] && [ $((NUNC - STAMPA)) -lt 600 ]; then
        exit 0
    fi
fi

# sera: percursus iam currit; sera vetus (>15 min) = derelicta
if [ -f "$SERA" ]; then
    if [ -n "$(find "$SERA" -mmin +15 2>/dev/null)" ]; then
        rm -f "$SERA"
    else
        exit 0
    fi
fi

mkdir -p "$RADIX/build"
touch "$SERA"
(
    cd "$RADIX" || exit 1
    nice ./silva/nexus.sh -renovare \
        > build/nexus_renovare.log 2>&1
    rm -f "$SERA"
) < /dev/null > /dev/null 2>&1 &

exit 0
