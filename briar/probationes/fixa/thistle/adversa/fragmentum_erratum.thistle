#!/usr/bin/env briar
# Fragmentum erratum

A fragment with a type error: clang must name THIS file and the
fragment's own line, never the generated file (the fumus proves it).
No house include at all: the closure is EMPTY, which the plain build
script must survive (no `lib/*.c` glob).

<c! id="erratum">
i32 x = "non numerus";
</c>

<c!>
s32
principale (vacuum)
{
    <<#erratum>>

    imprimere("%d\n", (integer)x);
    redde ZEPHYRUM;
}
</c>
