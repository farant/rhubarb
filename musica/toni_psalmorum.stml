        textus="stérilem in domo" notae="i i k j i j"/>
    <exemplum pagina="20*" pars="mediatio" forma="A"
        textus="Tu mandásti" notae="k j i j"/>
    <exemplum pagina="20*" pars="mediatio" forma="A"
        textus="Dóminus ex Sion" notae="i i k j i j"/>
    <exemplum pagina="20*" pars="mediatio" forma="A"
        textus="propitiátio est" notae="i i i k j i j"/>
    <exemplum pagina="20*" pars="mediatio" forma="A"
        textus="Bonus es tu" notae="k j i j"/>
    <exemplum pagina="20*" pars="mediatio" forma="B"
        textus="miserátor Dóminus" notae="i i k j i jr j"/>
    <exemplum pagina="20*" pars="mediatio" forma="B"
        textus="séminant in lácrimis" notae="i i k j i jr j"/>
    <exemplum pagina="20*" pars="mediatio" forma="B"
        textus="propter quod locútus sum" notae="i i k j i jr j"/>
    <exemplum pagina="20*" pars="mediatio" forma="B"
        textus="pacem sunt Jerúsalem" notae="i i k j i jr j"/>
    <exemplum pagina="20*" pars="mediatio" forma="C"
        textus="faciéntibus eum" notae="i i k jr j i j"/>
    <exemplum pagina="20*" pars="mediatio" forma="C"
        textus="implébit ruínas" notae="i k jr j i j"/>
    <exemplum pagina="20*" pars="mediatio" forma="C"
        textus="ámove a me" notae="k jr j i j"/>
    <exemplum pagina="20*" pars="mediatio" forma="C"
        textus="dicta sunt de te" notae="k jr j i j"/>
    <exemplum pagina="20*" pars="mediatio" forma="C"
        textus="iniquitátis in me est" notae="i i i k jr j i j"/>
    <exemplum pagina="20*" pars="mediatio" forma="D"
        textus="magna ópera Dómini" notae="i i k jr j i jr j"/>
    <exemplum pagina="20*" pars="mediatio" forma="D"
        textus="sicut ovis quae périit" notae="i i k jr j i jr j"/>
    <exemplum pagina="20*" pars="mediatio" forma="D" nota="hebr."
        textus="eam in Éphrata" notae="k jr j i jr j"/>

    <!-- terminationes, formae A-D, differentia a (AR p. 20*-21*) -->
    <exemplum pagina="20*" pars="terminatio" forma="A" differentia="a"
        textus="loquéntium iníqua" notae="i i i j i h gf"/>
    <exemplum pagina="20*" pars="terminatio" forma="A" differentia="a"
        textus="timéntibus se" notae="i j i h gf"/>
    <!-- Sina: musica oxytonum (na j non transit in Si) -->
    <exemplum pagina="20*" pars="terminatio" forma="A" differentia="a"
        nota="hebr." textus="in Siná in sancto" notae="i i j i h gf"/>
    <exemplum pagina="20*" pars="terminatio" forma="B" differentia="a"
        textus="non commovébitur" notae="i j i h hr gf"/>
    <exemplum pagina="20*" pars="terminatio" forma="B" differentia="a"
        textus="órdinem Melchísedech" notae="i i j i h hr gf"/>
    <exemplum pagina="21*" pars="terminatio" forma="B" differentia="a"
        textus="Dóminus suscépit me" notae="i i j i h hr gf"/>
    <exemplum pagina="21*" pars="terminatio" forma="B" differentia="a"
        textus="et praecínxit se" notae="j i h hr gf"/>
    <exemplum pagina="21*" pars="terminatio" forma="C" differentia="a"
        textus="in terra multórum" notae="i j ir i h gf"/>
    <exemplum pagina="21*" pars="terminatio" forma="C" differentia="a"
        textus="retríbuit nobis" notae="i j ir i h gf"/>
    <exemplum pagina="21*" pars="terminatio" forma="D" differentia="a"
        textus="et usque in saéculum" notae="i j ir i h hr gf"/>
    <exemplum pagina="21*" pars="terminatio" forma="D" differentia="a"
        textus="in médio tui Jerúsalem" notae="i i i i j ir i h hr gf"/>
    <exemplum pagina="21*" pars="terminatio" forma="D" differentia="a"
        nota="hebr." textus="dicat nunc Ísrael" notae="j ir i h hr gf"/>

    <!-- per varias differentias (AR p. 21*) -->
    <exemplum pagina="21*" pars="terminatio" differentia="a"
        textus="in saéculum saéculi" notae="i j ir i h hr gf"/>
    <exemplum pagina="21*" pars="terminatio" differentia="b"
        textus="saéculi" notae="h hr g"/>
    <exemplum pagina="21*" pars="terminatio" differentia="c"
        textus="saéculi" notae="h hr gh"/>
    <exemplum pagina="21*" pars="terminatio" differentia="c2"
        textus="saéculi" notae="h hr ih"/>
    <exemplum pagina="21*" pars="terminatio" differentia="d"
        textus="saéculi" notae="h hr gi"/>

    <!-- clausulae deficientes (AR p. 21*) -->
    <exemplum pagina="21*" pars="mediatio" forma="abbreviata"
        textus="Qui fácit haec" notae="ikj i jr j"/>
    <exemplum pagina="21*" pars="terminatio" forma="abbreviata"
        differentia="a" textus="et tímui" notae="i h hr gf"/>
  </tonus>

  <!-- Tonus Octavus: AR p. 22*-23* (n1045-n1046). Clavis c4 (j = do).
       Mediatio "fit ut in Tono 2. vel 5.; et eodem modo corripitur ad
       vocem monosyllabam vel hebraicam" (p. 23*): exempla mediationis
       Toni 8 non impressa; superveniens et casus monosyllaba ex
       Tono 2 (AR p. 8*: pú-e-ri DÓ-mi-num; lo-cú-tus SUM, ex Si-ON). -->
  <tonus modus="8" clavis="c4" tenor="j" pagina="22*">
    <initium>g h</initium>
    <flexa>h</flexa>

    <mediatio>
      <!-- superveniens j: ex Tono 2 (non impressum pro Tono 8) -->
      <accentus superveniens="j">k</accentus>
      <nota>j</nota>
    </mediatio>

    <!-- ex Tono 2, AR p. 8*: syllaba ultima notam altam capit -->
    <mediatio casus="monosyllaba">
      <nota>k</nota>
    </mediatio>

    <terminatio differentia="G">
      <praeparatio>i</praeparatio>
      <praeparatio>j</praeparatio>
      <accentus superveniens="g">h</accentus>
      <nota>g</nota>
    </terminatio>

    <terminatio differentia="c">
      <praeparatio>h</praeparatio>
      <praeparatio>j</praeparatio>
      <accentus superveniens="j">k</accentus>
      <nota>j</nota>
    </terminatio>

    <!-- AR p. 22*: "Quando Antiphona notatur cum G*, potest ad libitum
         adhiberi Differentia sequens". Nota ultima h (la), non sol:
         littera G* probationem litterae non sequitur. Superveniens g
         ex differentia G (non impressum). -->
    <terminatio differentia="G*" vicaria="G">
      <praeparatio>i</praeparatio>
      <praeparatio>j</praeparatio>
      <accentus superveniens="g">h</accentus>
      <nota>gh</nota>
    </terminatio>

    <!-- OCTAVUS majusculis parvis sine signo, accentus additus -->
    <exemplum pagina="22*" pars="versus" differentia="G"
        textus="Octávus tonus sic incípitur, sic fléctitur † et sic mediátur * atque sic finítur."
        notae="g h j j j j j j j j j j h h † j j j j k j * j j i j h g"/>
    <exemplum pagina="22*" pars="terminatio" differentia="c"
        textus="Atque sic finítur." notae="j j h j k j"/>
    <exemplum pagina="22*" pars="terminatio" differentia="G*"
        textus="Atque sic finítur." notae="j j i j h gh"/>

    <!-- terminationes G (AR p. 23*) -->
    <exemplum pagina="23*" pars="terminatio" differentia="G"
        textus="véritas ejus" notae="j i j h g"/>
    <exemplum pagina="23*" pars="terminatio" differentia="G"
        textus="lucíferum génui te" notae="j j j j i j h g"/>
    <exemplum pagina="23*" pars="terminatio" differentia="G"
        textus="diligéntibus te" notae="j j i j h g"/>
    <exemplum pagina="23*" pars="terminatio" differentia="G"
        textus="non commovébitur" notae="j i j h gr g"/>
    <exemplum pagina="23*" pars="terminatio" differentia="G"
        textus="in saéculum saéculi" notae="j j i j h gr g"/>
    <exemplum pagina="23*" pars="terminatio" differentia="G"
        textus="et liberávit me" notae="j i j h gr g"/>
    <exemplum pagina="23*" pars="terminatio" differentia="G"
        textus="órdinem Melchísedech" notae="j j i j h gr g"/>
    <exemplum pagina="23*" pars="terminatio" forma="abbreviata"
        differentia="G" nota="hebr." textus="laus Ísrael"
        notae="j h gr g"/>

    <!-- terminationes c (AR p. 23*) -->
    <exemplum pagina="23*" pars="terminatio" differentia="c"
        textus="véritas ejus" notae="j h j k j"/>
    <exemplum pagina="23*" pars="terminatio" differentia="c"
        textus="a saéculo tu es" notae="j j h j k j"/>
    <exemplum pagina="23*" pars="terminatio" differentia="c"
        textus="lucíferum génui te" notae="j j j j h j k j"/>
    <exemplum pagina="23*" pars="terminatio" differentia="c"
        textus="vivífica me" notae="j h j k j"/>
    <exemplum pagina="23*" pars="terminatio" differentia="c"
        textus="in saéculum saéculi" notae="j j h j k jr j"/>
    <exemplum pagina="23*" pars="terminatio" differentia="c"
        textus="et liberávit me" notae="j h j k jr j"/>
    <exemplum pagina="23*" pars="terminatio" differentia="c"
        textus="tui Jerúsalem" notae="j h j k jr j"/>
    <exemplum pagina="23*" pars="terminatio" forma="abbreviata"
        differentia="c" textus="et salva me" notae="j k jr j"/>
  </tonus>

  <!-- Tonus Peregrinus: AR p. 24*-25* (n1047-n1048). Clavis c4.
       "In hoc Tono Mediatio incipitur in qualicumque syllaba secundo
       loco occurrente ante ultimum accentum" = duae <praeparatio>.
       Tenor h in prima parte, g in secunda (terminatio tenor="g").
       Versus primus: etiam secunda pars intonatur (do-mus: hixi), ceteri
       in tenore g incipiunt (Facta est ... * Israel). -->
  <tonus modus="peregrinus" clavis="c4" tenor="h" pagina="24*">
    <initium>hixi</initium>
    <flexa>g</flexa>

    <mediatio>
      <praeparatio>ixi</praeparatio>
      <praeparatio>h</praeparatio>
      <!-- superveniens f: AR p. 25* (Dó-mi-no: DÓ g, mi f, no f) -->
      <accentus superveniens="f">g</accentus>
      <nota>f</nota>
    </mediatio>

    <!-- "Mediatio contracta" (AR p. 24*): voce monosyllaba vel hebraica
         in fine, tres syllabae ultimae ixi g h, accentu non curato
         (su-per VOS, Is-ra-EL) -->
    <mediatio casus="monosyllaba">
      <praeparatio>ixi</praeparatio>
      <praeparatio>g</praeparatio>
      <nota>h</nota>
    </mediatio>

    <!-- PROPOSITUM: differentia nulla in libro (terminatio unica);
         initium="hixi" = intonatio secundae partis, versu primo solum
         (forma alias non habet locum intonationi secundae partis). -->
    <terminatio tenor="g" initium="hixi">
      <praeparatio>d</praeparatio>
      <accentus superveniens="f">f</accentus>
      <nota>ed</nota>
    </terminatio>

    <exemplum pagina="24*" pars="versus" nota="hebr."
        textus="In éxitu Ísrael de Ægýpto, * domus Jacob de pópulo bárbaro."
        notae="hixi h h h h h h ixi h g f * hixi g g g g g g d f fr ed"/>
    <exemplum pagina="24*" pars="versus" primus="falsum"
        textus="Facta est Judaéa sanctificátio ejus: * Ísrael potéstas ejus."
        notae="h h h h h h h h h h ixi h g f * g g g g g d f ed"/>
    <exemplum pagina="24*" pars="mediatio"
        textus="Mare vidit, et fugit" notae="h h h ixi h g f"/>
    <exemplum pagina="24*" pars="versus" primus="falsum"
        textus="Manus habent, et non palpábunt: † pedes habent, et non ambulábunt: * non clamábunt in gútture suo."
        notae="h h h h h h h h g † h h h h h h ixi h g f * g g g g g g g d f ed"/>
    <exemplum pagina="24*" pars="versus" primus="falsum" forma="contracta" nota="hebr."
        textus="Benedíxit dómui Ísrael: * benedíxit dómui Áaron."
        notae="h h h h h h h ixi g h * g g g g g g d f fr ed"/>
    <exemplum pagina="24*" pars="mediatio" forma="contracta"
        textus="Adjíciat Dóminus super vos" notae="h h h h h h h ixi g h"/>
    <exemplum pagina="25*" pars="versus"
        textus="Benedícite ómnia ópera Dómini Dómino: * laudáte et superexaltáte eum in saécula."
        notae="hixi h h h h h h h h h h h ixi h g fr f * hixi g g g g g g g g g g g d f fr ed"/>
    <exemplum pagina="25*" pars="versus"
        textus="Laudáte púeri Dóminum: * laudáte nomen Dómini."
        notae="hixi h h h ixi h g fr f * hixi g g g d f fr ed"/>
    <exemplum pagina="25*" pars="mediatio"
        textus="Sit nomen Dómini benedíctum" notae="h h h h h h ixi h g f"/>
  </tonus>

  <!-- Tonus in directum: AR p. 25*-26* (n1048-n1049). Clavis c3 (h = do).
       "pro Psalmis qui dicendi praescribuntur in Precibus Officii sine
       Antiphona" (Ps. 145 Vesp. Def., Ps. 129 Laud., Ps. 69 Litan.).
       Tonus verus: sine intonatione (versus primus in tenore incipit),
       flexa, mediatio, terminatio, et forma monosyllaba utriusque.
       PROPOSITUM: in tabula ut tonus, modus="in directum", sine
       differentia. -->
  <tonus modus="in directum" clavis="c3" tenor="h" pagina="25*">
    <flexa>f</flexa>

    <mediatio>
      <praeparatio>g</praeparatio>
      <praeparatio>f</praeparatio>
      <accentus superveniens="h">h</accentus>
      <nota>h</nota>
    </mediatio>

    <mediatio casus="monosyllaba">
      <praeparatio>g</praeparatio>
      <praeparatio>f</praeparatio>
      <nota>h</nota>
    </mediatio>

    <terminatio>
      <accentus superveniens="f">h</accentus>
      <nota>f</nota>
    </terminatio>

    <!-- PROPOSITUM: casus="monosyllaba" etiam in <terminatio> (in libro:
         "Finalis ... In monosyllaba, etc.", AR p. 26*) -->
    <terminatio casus="monosyllaba">
      <accentus superveniens="g">h</accentus>
      <nota>f</nota>
      <nota>g</nota>
    </terminatio>

    <exemplum pagina="25*" pars="versus"
        textus="Deus, in adjutórium meum inténde: * Dómine, ad adjuvándum me festína."
        notae="h h h h h h h h h g f h h * h h h h h h h h h h h f"/>
    <exemplum pagina="25*" pars="flexa"
        textus="adjútor ejus" notae="h h h h f"/>
    <exemplum pagina="25*" pars="flexa"
        textus="ánima mea Dóminum" notae="h h h h h h f f"/>
    <exemplum pagina="25*" pars="mediatio"
        textus="confídere in princípibus" notae="h h h h g f h hr h"/>
    <exemplum pagina="25*" pars="mediatio" forma="monosyllaba"
        textus="omnes qui quaerunt te" notae="h h h g f h"/>
    <exemplum pagina="26*" pars="mediatio" forma="monosyllaba"
        textus="propitiátio est" notae="h h h h g f h"/>
    <exemplum pagina="26*" pars="mediatio" forma="monosyllaba"
        textus="liberátor meus es tu" notae="h h h h h g f h"/>
    <exemplum pagina="26*" pars="mediatio" forma="monosyllaba"
        nota="hebr." textus="rédimet Ísrael" notae="h h h g f h"/>
    <exemplum pagina="26*" pars="terminatio"
        textus="sustínui te Dómine" notae="h h h h h h fr f"/>
    <exemplum pagina="26*" pars="terminatio" forma="monosyllaba"
        textus="quae in eis sunt" notae="h h h f g"/>
    <exemplum pagina="26*" pars="terminatio" forma="monosyllaba"
        textus="Deus ádjuva me" notae="h h h gr f g"/>
  </tonus>

</toni_psalmorum>
