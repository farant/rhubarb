        textus="órdinem Melchísedech" notae="h g h ih gr gf e"/>
    <exemplum pagina="15*" pars="terminatio" forma="abbreviata"
        differentia="E" textus="et tímui" notae="ih gr gf e"/>
  </tonus>

  <!-- PROPOSITUM: positio="altera" - "Altera Positio ejusdem Toni"
       (AR p. 13*): tonus IV transpositus (finalis la, tenor re),
       clavis c3. Differentiae c, A, A* solum hic. -->
  <tonus modus="4" positio="altera" clavis="c3" tenor="i" pagina="13*">
    <initium>i hi</initium>
    <flexa>h</flexa>

    <!-- superveniens non impressum; ex positione ordinaria -->
    <mediatio>
      <praeparatio>h</praeparatio>
      <praeparatio>i</praeparatio>
      <accentus superveniens="i">j</accentus>
      <nota>i</nota>
    </mediatio>

    <!-- non impressum; ex positione ordinaria (p. 14*) translatum -->
    <mediatio casus="monosyllaba">
      <praeparatio>h</praeparatio>
      <praeparatio>i</praeparatio>
      <nota>j</nota>
    </mediatio>

    <!-- superveniens non impressum; ex differentia g translatum -->
    <terminatio differentia="c">
      <accentus superveniens="h">i</accentus>
      <nota>h</nota>
    </terminatio>

    <terminatio differentia="A">
      <praeparatio>h</praeparatio>
      <praeparatio>i</praeparatio>
      <praeparatio>j</praeparatio>
      <accentus superveniens="f">h</accentus>
      <nota>f</nota>
    </terminatio>

    <!-- "Quando Antiphona notatur cum A*, potest ad libitum adhiberi
         Differentia sequens" (p. 13*). Nota ultima g = si, non la:
         probatio litterae nomina cum * excipiat. Superveniens non
         impressum; ex A. -->
    <terminatio differentia="A*" vicaria="A">
      <praeparatio>h</praeparatio>
      <praeparatio>i</praeparatio>
      <praeparatio>j</praeparatio>
      <accentus superveniens="f">h</accentus>
      <nota>fg</nota>
    </terminatio>

    <exemplum pagina="13*" pars="versus" differentia="c"
        textus="Quartus Tonus sic incípitur, sic fléctitur † et sic mediátur * atque sic finítur."
        notae="i hi i i i i i i i i i h h † i i h i j i * i i i i i h"/>
    <exemplum pagina="13*" pars="terminatio" differentia="A"
        textus="Atque sic finítur." notae="i h i j h f"/>
    <exemplum pagina="13*" pars="terminatio" differentia="A*"
        textus="Atque sic finítur." notae="i h i j h fg"/>
    <exemplum pagina="15*" pars="terminatio" differentia="A"
        textus="loquébar pacem de te" notae="i i h i j h f"/>
    <exemplum pagina="15*" pars="terminatio" differentia="A"
        textus="lucíferum génui te" notae="i i i h i j h f"/>
    <exemplum pagina="15*" pars="terminatio" differentia="A"
        textus="in saéculum saéculi" notae="i h i j h fr f"/>
    <exemplum pagina="15*" pars="terminatio" differentia="A"
        textus="et exaudívit me" notae="h i j h fr f"/>
    <exemplum pagina="15*" pars="terminatio" forma="abbreviata"
        differentia="A" textus="et tímui" notae="j h fr f"/>
  </tonus>

  <!-- Tonus V (AR p. 16*-17*). "Mediatio fit ut in Tono 2., et eodem
       modo corripitur ad vocem monosyllabam vel hebraicam" (p. 16*):
       exempla mediationis nulla; superveniens et casus monosyllaba
       ex Tono II (p. 8*: superveniens = nota finalis; in monosyllaba
       syllaba ultima notam accentus capit). -->
  <tonus modus="5" clavis="c3" tenor="h" pagina="16*">
    <initium>d f</initium>
    <flexa>f</flexa>

    <mediatio>
      <accentus superveniens="h">i</accentus>
      <nota>h</nota>
    </mediatio>

    <mediatio casus="monosyllaba">
      <nota>i</nota>
    </mediatio>

    <!-- "Finalis unica. a"; formae A-D (p. 17*) -->
    <terminatio differentia="a">
      <accentus superveniens="g">i</accentus>
      <nota>g</nota>
      <accentus superveniens="f">h</accentus>
      <nota>f</nota>
    </terminatio>

    <exemplum pagina="16*" pars="versus" differentia="a"
        textus="Quintus Tonus sic incípitur, sic fléctitur † et sic mediátur * atque sic finítur."
        notae="d f h h h h h h h h h f f † h h h h i h * h h i g h f"/>

    <exemplum pagina="17*" pars="terminatio" forma="A" differentia="a"
        textus="supersperávi" notae="h i g h f"/>
    <exemplum pagina="17*" pars="terminatio" forma="A" differentia="a"
        textus="non sum oblítus" notae="h i g h f"/>
    <!-- Sina in libro sine signo; musica non transit: oxytonum -->
    <exemplum pagina="17*" pars="terminatio" forma="A" differentia="a"
        nota="hebr." textus="in Siná in sancto" notae="h h i g h f"/>
    <exemplum pagina="17*" pars="terminatio" forma="A" differentia="a"
        textus="qui hábitas in coelis" notae="h h h i g h f"/>
    <exemplum pagina="17*" pars="terminatio" forma="A" differentia="a"
        textus="lucíferum génui te" notae="h h h h i g h f"/>
    <exemplum pagina="17*" pars="terminatio" forma="A" differentia="a"
        textus="vivífica me" notae="h i g h f"/>
    <exemplum pagina="17*" pars="terminatio" forma="B" differentia="a"
        textus="non commovébitur" notae="h i g h fr f"/>
    <exemplum pagina="17*" pars="terminatio" forma="B" differentia="a"
        textus="sustínui te Dómine" notae="h h h i g h fr f"/>
    <exemplum pagina="17*" pars="terminatio" forma="B" differentia="a"
        textus="et liberávit me" notae="h i g h fr f"/>
    <exemplum pagina="17*" pars="terminatio" forma="C" differentia="a"
        textus="inimicórum tuórum" notae="h h h i gr g h f"/>
    <exemplum pagina="17*" pars="terminatio" forma="D" differentia="a"
        textus="in saéculum saéculi" notae="h i gr g h fr f"/>
    <exemplum pagina="17*" pars="terminatio" forma="abbreviata"
        differentia="a" textus="et tímui" notae="g h fr f"/>
    <exemplum pagina="17*" pars="terminatio" forma="D" differentia="a"
        textus="in circúitu nostro sunt" notae="h h i gr g h fr f"/>
    <exemplum pagina="17*" pars="terminatio" forma="D" differentia="a"
        textus="in médio tui Jerúsalem" notae="h h h h i gr g h fr f"/>
  </tonus>

  <!-- Tonus VI (AR p. 18*-19*). Duae mediationes: "Apud antiquos
       Mediatio fiebat ut in 1. Tono: sed a saeculo XVI. sensim usus
       invaluit alterius Mediationis" (p. 18*); exempla libri solum
       recentioris. -->
  <tonus modus="6" clavis="c4" tenor="h" pagina="18*">
    <initium>f gh</initium>
    <flexa>g</flexa>

    <mediatio>
      <praeparatio>g</praeparatio>
      <accentus superveniens="f">h</accentus>
      <nota>f</nota>
    </mediatio>

    <mediatio casus="monosyllaba">
      <praeparatio>g</praeparatio>
      <nota>h</nota>
    </mediatio>

    <!-- PROPOSITUM: mediatio antiqua ut in Tono I, ad libitum.
         Superveniens non impressum; ex Tono I. -->
    <mediatio ad_libitum="verum">
      <accentus superveniens="h">ixi</accentus>
      <nota>h</nota>
      <accentus superveniens="h">g</accentus>
      <nota>h</nota>
    </mediatio>

    <!-- "Finalis unica. F (C)": (C) = eadem differentia cum antiphona
         transposita (finalis do); hic non scripta. -->
    <terminatio differentia="F">
      <praeparatio>f</praeparatio>
      <praeparatio>gh</praeparatio>
      <accentus superveniens="f">g</accentus>
      <nota>f</nota>
    </terminatio>

    <exemplum pagina="18*" pars="versus" differentia="F"
        textus="Sextus Tonus sic incípitur, sic fléctitur † et sic mediátur * atque sic finítur."
        notae="f gh h h h h h h h h h g g † h h h g h f * h h f gh g f"/>
    <exemplum pagina="18*" pars="mediatio" forma="antiqua"
        textus="et sic mediátur" notae="h h ixi h g h"/>

    <exemplum pagina="18*" pars="mediatio"
        textus="pópulo suo" notae="h h g h f"/>
    <exemplum pagina="18*" pars="mediatio"
        textus="ópera Dómini" notae="h h g h fr f"/>
    <exemplum pagina="18*" pars="mediatio" forma="monosyllaba"
        textus="locútus sum" notae="h h g h"/>
    <exemplum pagina="18*" pars="mediatio" forma="monosyllaba"
        textus="vivífica me" notae="h h h g h"/>
    <exemplum pagina="18*" pars="mediatio" forma="monosyllaba"
        nota="hebr." textus="Dóminus ex Sion" notae="h h h h g h"/>
    <exemplum pagina="18*" pars="mediatio" forma="monosyllaba"
        nota="hebr." textus="Jerúsalem" notae="h h g h"/>

    <exemplum pagina="18*" pars="terminatio" differentia="F"
        textus="glória ejus" notae="h f gh g f"/>
    <exemplum pagina="18*" pars="terminatio" differentia="F"
        textus="super domum David" notae="h h f gh g f"/>
    <exemplum pagina="18*" pars="terminatio" differentia="F"
        textus="diligéntibus te" notae="h h f gh g f"/>
    <exemplum pagina="19*" pars="terminatio" differentia="F"
        textus="vivífica me" notae="h f gh g f"/>
