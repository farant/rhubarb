  <!-- Tonus IV, positio ordinaria (AR p. 13*-15*). Praeparationes
       in tenore (h) non scriptae nisi visibiles. -->
  <tonus modus="4" clavis="c4" tenor="h" pagina="13*">
    <initium>h gh</initium>
    <flexa>g</flexa>

    <mediatio>
      <praeparatio>g</praeparatio>
      <praeparatio>h</praeparatio>
      <accentus superveniens="h">i</accentus>
      <nota>h</nota>
    </mediatio>

    <!-- "In monosyllaba vel hebraica voce" (AR p. 14*): syllaba
         ultima notam accentus capit, nulla nota finalis -->
    <mediatio casus="monosyllaba">
      <praeparatio>g</praeparatio>
      <praeparatio>h</praeparatio>
      <nota>i</nota>
    </mediatio>

    <terminatio differentia="g">
      <accentus superveniens="g">h</accentus>
      <nota>g</nota>
    </terminatio>

    <terminatio differentia="E">
      <praeparatio>g</praeparatio>
      <praeparatio>h</praeparatio>
      <praeparatio>ih</praeparatio>
      <accentus superveniens="g" anticipata="verum">gf</accentus>
      <nota>e</nota>
    </terminatio>

    <exemplum pagina="13*" pars="versus" differentia="g"
        textus="Quartus Tonus sic incípitur, sic fléctitur † et sic mediátur * atque sic finítur."
        notae="h gh h h h h h h h h h g g † h h g h i h * h h h h h g"/>
    <exemplum pagina="13*" pars="terminatio" differentia="E"
        textus="Atque sic finítur." notae="h g h ih gf e"/>

    <exemplum pagina="14*" pars="mediatio"
        textus="Dómino meo" notae="h g h i h"/>
    <exemplum pagina="14*" pars="mediatio"
        textus="splendóribus sanctórum" notae="h h h g h i h"/>
    <exemplum pagina="14*" pars="mediatio"
        textus="ópera Dómini" notae="h g h i hr h"/>
    <exemplum pagina="14*" pars="mediatio"
        textus="a terra ínopem" notae="h g h i hr h"/>
    <exemplum pagina="14*" pars="mediatio" forma="monosyllaba"
        textus="sol non uret te" notae="h h g h i"/>
    <exemplum pagina="14*" pars="mediatio" forma="monosyllaba"
        textus="propitiátio est" notae="h h h h g h i"/>
    <exemplum pagina="14*" pars="mediatio" forma="monosyllaba"
        nota="hebr." textus="Dómine David" notae="h h g h i"/>
    <exemplum pagina="14*" pars="mediatio" forma="monosyllaba"
        nota="hebr." textus="sunt Jerúsalem" notae="h h g h i"/>
    <exemplum pagina="14*" pars="mediatio" forma="monosyllaba"
        nota="hebr." textus="Dóminus ex Sion" notae="h h h g h i"/>
    <exemplum pagina="14*" pars="mediatio" forma="monosyllaba"
        textus="Qui fácit haec" notae="h g h i"/>

    <exemplum pagina="14*" pars="terminatio" differentia="g"
        textus="génui te" notae="h h h g"/>
    <exemplum pagina="14*" pars="terminatio" differentia="g"
        textus="pacem de te" notae="h h h g"/>
    <exemplum pagina="14*" pars="terminatio" differentia="g"
        textus="domum David" notae="h h h g"/>
    <exemplum pagina="14*" pars="terminatio" differentia="g"
        textus="in saéculum saéculi" notae="h h h h h gr g"/>
    <exemplum pagina="14*" pars="terminatio" differentia="g"
        textus="exaudívit me" notae="h h h gr g"/>
    <exemplum pagina="14*" pars="terminatio" differentia="g"
        textus="Jerúsalem" notae="h h gr g"/>

    <exemplum pagina="14*" pars="terminatio" differentia="E"
        textus="et congregatióne" notae="h h g h ih gf e"/>
    <exemplum pagina="14*" pars="terminatio" differentia="E"
        textus="lucíferum génui te" notae="h h h g h ih gf e"/>
    <exemplum pagina="15*" pars="terminatio" differentia="E"
        textus="in saéculum saéculi" notae="h g h ih gr gf e"/>
