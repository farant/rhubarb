    <exemplum pagina="19*" pars="terminatio" differentia="F"
        textus="órdinem Melchísedech" notae="h h f gh g fr f"/>
  </tonus>

  <!-- Tonus Septimus: AR p. 19*-21* (n1042-n1044). Clavis c3 (h = do). -->
  <tonus modus="7" clavis="c3" tenor="i" pagina="19*">
    <initium>hg hi</initium>
    <flexa>h</flexa>

    <mediatio>
      <accentus superveniens="j">k</accentus>
      <nota>j</nota>
      <accentus superveniens="j">i</accentus>
      <nota>j</nota>
    </mediatio>

    <!-- terminationes: forma A-D (AR p. 20*-21*, differentia a) ostendit
         locum <accentus> j cum superveniente i (ter-ra: TER j, ra i*) -->
    <terminatio differentia="a">
      <accentus superveniens="i">j</accentus>
      <nota>i</nota>
      <accentus superveniens="h">h</accentus>
      <nota>gf</nota>
    </terminatio>

    <terminatio differentia="b">
      <!-- superveniens i: ex differentia a (non impressum pro b) -->
      <accentus superveniens="i">j</accentus>
      <nota>i</nota>
      <accentus superveniens="h">h</accentus>
      <nota>g</nota>
    </terminatio>

    <terminatio differentia="c">
      <!-- superveniens i: ex differentia a (non impressum pro c) -->
      <accentus superveniens="i">j</accentus>
      <nota>i</nota>
      <accentus superveniens="h">h</accentus>
      <nota>gh</nota>
    </terminatio>

    <terminatio differentia="c2">
      <!-- superveniens i: ex differentia a (non impressum pro c2) -->
      <accentus superveniens="i">j</accentus>
      <nota>i</nota>
      <accentus superveniens="h">h</accentus>
      <nota>ih</nota>
    </terminatio>

    <terminatio differentia="d">
      <!-- superveniens i: ex differentia a (non impressum pro d) -->
      <accentus superveniens="i">j</accentus>
      <nota>i</nota>
      <accentus superveniens="h">h</accentus>
      <nota>gi</nota>
    </terminatio>

    <!-- versus exemplaris (AR p. 19*); SEPTIMUS in libro majusculis
         parvis sine signo, accentus additus -->
    <exemplum pagina="19*" pars="versus" differentia="a"
        textus="Séptimus tonus sic incípitur, sic fléctitur † et sic mediátur * atque sic finítur."
        notae="hg hi i i i i i i i i i i h h † i i k j i j * i i j i h gf"/>

    <!-- mediatio, formae A-D (AR p. 20*) -->
    <exemplum pagina="20*" pars="mediatio" forma="A"
        textus="confirmátum est cor ejus" notae="i i i i k j i j"/>
