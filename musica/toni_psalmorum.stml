<!-- toni_psalmorum.stml - toni psalmorum ex libro impresso.

     Forma a Frano probata 2026-11-07 (project-specs/psalmodia-spec.md
     P2, II). Transcripti: toni I-VIII, peregrinus, in directum (AR
     p. 3*-26*; mediationes solemnes canticorum omissae, P4). Formae
     novae notatae PROPOSITUM Frano recensendae sunt.

     Fons: Antiphonale sacrosanctae Romanae ecclesiae pro diurnis
     horis, Typis polyglottis Vaticanis 1912 ("AR"), appendix Toni
     communes (archive.org antiphonale00anonuoft, folia 1026-1048).
     pagina="4*" = pagina libri.

     GRAMMATICA
     <tonus modus clavis tenor pagina positio> - clavis gabc (c4:
       h = la); tenor = nota recitationis. modus = 1-8, "peregrinus",
       "in directum". positio="altera" = tonus transpositus cum
       differentiis suis (IV: "Altera Positio", AR p. 13*).
     <initium> - notae intonationis, una (aut neuma una) pro syllaba,
       ordine, sine accentu ("prout obveniunt", AR p. 5*).
     <flexa> - nota quo vox deprimitur. Regula (AR p. 5*): syllaba
       ultima deprimitur, et paenultima si brevis; in monosyllaba vel
       voce hebraica vox in tenore sustinetur cum pausa.
     <mediatio>, <terminatio differentia> - clausula = series locorum,
       quisque locus = syllaba una. Praeparationes initiales in
       altitudine tenoris non scribuntur (a tenore in libro
       indistinctae):
         <praeparatio> - syllaba una, numero fixo, sine accentu;
         <accentus superveniens anticipata> - cadit in syllabam
           accentu notatam (regula infra); superveniens = nota addita
           pro syllaba supervacua post accentum (liber: *; typis
           nostris cava, "r"); anticipata="verum": nota addita in
           syllaba accentus, neuma accentus in syllabam sequentem
           transit (AR p. 6*, "Superveniens anticipata");
         <nota> - syllaba una post accentum; ultima = finis.
       casus="monosyllaba" - clausula pro semiversu in monosyllabam vel
         vocem hebraicam desinente, solum in tonis qui eam imprimunt
         (alias regula communis valet).
       <mediatio ad_libitum="verum"> - mediatio altera (VI: antiqua).
       <terminatio clavis> - totus psalmus his litteris in hac clave
         canitur (II: "Finalis unica D vel A").
       <terminatio tenor initium> - tenor secundae partis et intonatio
         ejus in versu primo (peregrinus); terminatio sine differentia
         = unica.
       differentia = littera notae ultimae (A la ... G sol), majuscula
       si finalis modi, numerus si plures in eadem nota (AR p. 3*):
       lector hoc contra clavem probat (littera notae ultimae, sive
       minuscula sive majuscula = inclinata), nisi nomen "*" habet
       (A*, G*: nomina libri, nota ultima alia).
       vicaria="g" - liber permittit differentiam illam loco huius.
       ad_libitum="verum" - forma altera ejusdem differentiae.
     <exemplum> - exempla libri sub clausulis impressa: textus (accentus
       ut in libro; voces hebraicae sine signo in libro, accentus ex
       musica deductus, nota "hebr.") et notae exspectatae, una pro
       syllaba, "r" = superveniens. Probatio aptatoris haec reddere
       debet. pars = versus (versus primus cum intonatione, nisi
       primus="falsum") | semiversus | initium (solum incipit cum
       intonatione, liber "...") | mediatio | terminatio | flexa.
       canticum="verum" = intonatio in omni versu (AR p. 4*). forma =
       A-D | monosyllaba | contracta | abbreviata | antiqua. nota =
       hebr. | initium solemne (II Magníficat, exceptio libri) |
       mediatio omissa.

     REGULA ACCENTUS (ex exemplis AR p. 5*-6*, omnibus congruens):
     clausula retrorsum aptatur. Nota ultima syllabam ultimam capit;
     quisque <accentus> locum suum nominalem (syllabam ante locos
     sequentes) capit, NISI ea syllaba accentum verbi sui proxime
     sequitur (dó-MI-nus, sae-CU-li, lo-cú-TUS sum): tunc accentus in
     syllabam accentus recedit et syllaba transita supervenientem
     capit. Syllaba ultima proparoxytoni (dó-mi-NUS) accentum capere
     potest. Monosyllaba finalis accentum in syllabam priorem mittit
     (eadem regula). Formae A-D libri (sine / cum supervenienti in
     fine / in medio / utrobique) huius regulae eventus sunt, non
     data.
     TEXTUS DEFICIENS: in terminatione notae primae sine syllaba
     omittuntur (AR p. 6*); in mediatione notae reliquae cum tenore in
     syllabam primam contrahuntur (I: Qui = h ixi h; VII: Qui = i k j).
     Semiversus primus (aut canticum) nimis brevis pro intonatione et
     mediatione: mediatio omittitur (I, III: Magníficat).
     Probatio (scriptum ad tempus, 2026-11-07): CCXLV ex CCXLVI
     exemplis regula redduntur; exceptio = II Magníficat. -->
<toni_psalmorum>

  <tonus modus="1" clavis="c4" tenor="h" pagina="4*">
    <initium>f gh</initium>
    <flexa>g</flexa>

    <mediatio>
      <accentus superveniens="h">ixi</accentus>
      <nota>h</nota>
      <accentus superveniens="h">g</accentus>
      <nota>h</nota>
    </mediatio>

    <terminatio differentia="D">
      <praeparatio>g</praeparatio>
      <praeparatio>f</praeparatio>
      <accentus superveniens="g">gh</accentus>
      <nota>gvFED</nota>
    </terminatio>

    <terminatio differentia="D" ad_libitum="verum">
      <praeparatio>g</praeparatio>
      <praeparatio>f</praeparatio>
      <accentus superveniens="g">g</accentus>
      <nota>gvFED</nota>
    </terminatio>

    <terminatio differentia="D2">
      <praeparatio>g</praeparatio>
      <praeparatio>f</praeparatio>
      <accentus superveniens="g" anticipata="verum">gf</accentus>
      <nota>d</nota>
    </terminatio>

    <terminatio differentia="f">
      <praeparatio>g</praeparatio>
      <praeparatio>f</praeparatio>
      <accentus superveniens="g">gh</accentus>
      <nota>gf</nota>
    </terminatio>

    <terminatio differentia="g">
      <praeparatio>g</praeparatio>
      <praeparatio>f</praeparatio>
      <accentus superveniens="g">gh</accentus>
      <nota>g</nota>
    </terminatio>

    <terminatio differentia="g2" vicaria="g">
      <praeparatio>g</praeparatio>
      <praeparatio>f</praeparatio>
      <accentus superveniens="g">g</accentus>
      <nota>ghg</nota>
    </terminatio>

    <!-- g3: superveniens in libro non impressa; g ex analogia -->
    <terminatio differentia="g3">
      <praeparatio>g</praeparatio>
      <praeparatio>f</praeparatio>
      <accentus superveniens="g">g</accentus>
      <nota>g</nota>
    </terminatio>

    <terminatio differentia="a">
      <praeparatio>g</praeparatio>
      <praeparatio>f</praeparatio>
      <accentus superveniens="h">g</accentus>
      <nota>h</nota>
    </terminatio>

    <terminatio differentia="a2">
      <praeparatio>g</praeparatio>
      <praeparatio>f</praeparatio>
      <accentus superveniens="g">g</accentus>
      <nota>gh</nota>
    </terminatio>

    <terminatio differentia="a3" vicaria="a2">
      <praeparatio>g</praeparatio>
      <praeparatio>f</praeparatio>
      <accentus superveniens="g">gh</accentus>
      <nota>gh</nota>
    </terminatio>

    <!-- versus exemplaris (AR p. 4*), cum flexa -->
    <exemplum pagina="4*" pars="versus" differentia="D"
        textus="Primus tonus sic incípitur, sic fléctitur † et sic mediátur * atque sic finítur."
        notae="f gh h h h h h h h h h g g † h h ixi h g h * h h g f gh gvFED"/>

    <!-- canticum (AR p. 5*): semiversus nimis brevis pro initio et
         mediatione - mediatio omittitur -->
    <exemplum pagina="5*" pars="semiversus" canticum="verum"
        nota="mediatio omissa" textus="Magníficat" notae="f gh h h"/>

    <!-- mediatio, formae A-D (AR p. 5*-6*) -->
    <exemplum pagina="5*" pars="mediatio" forma="A"
        textus="splendóribus sanctórum" notae="h h h ixi h g h"/>
    <exemplum pagina="5*" pars="mediatio" forma="A"
        textus="Dóminus ex Sion" notae="h h ixi h g h"/>
    <exemplum pagina="5*" pars="mediatio" forma="A"
        textus="propitiátio est" notae="h h h ixi h g h"/>
    <exemplum pagina="5*" pars="mediatio" forma="A"
        textus="vivífica me" notae="h ixi h g h"/>
    <exemplum pagina="5*" pars="mediatio" forma="A" nota="hebr."
        textus="in Ísrael est" notae="h ixi h g h"/>
    <exemplum pagina="5*" pars="mediatio" forma="A" nota="hebr."
        textus="ex Basán convértam" notae="h h ixi h g h"/>
    <exemplum pagina="5*" pars="mediatio" forma="B"
        textus="miserátor Dóminus" notae="h h ixi h g hr h"/>
    <exemplum pagina="5*" pars="mediatio" forma="B"
        textus="propter quod locútus sum" notae="h h ixi h g hr h"/>
    <exemplum pagina="5*" pars="mediatio" forma="B" nota="hebr."
        textus="Ísrael in Dómino" notae="h h ixi h g hr h"/>
    <exemplum pagina="5*" pars="mediatio" forma="B"
        textus="séminant in lácrimis" notae="h h ixi h g hr h"/>
    <exemplum pagina="6*" pars="mediatio" forma="C"
        textus="faciéntibus eum" notae="h h ixi hr h g h"/>
    <exemplum pagina="6*" pars="mediatio" forma="C"
        textus="implébit ruínas" notae="h ixi hr h g h"/>
    <exemplum pagina="6*" pars="mediatio" forma="C"
        textus="sicut mons Sion" notae="ixi hr h g h"/>
    <exemplum pagina="6*" pars="mediatio" forma="D"
        textus="in saéculum saéculi" notae="h ixi hr h g hr h"/>
    <exemplum pagina="6*" pars="mediatio" forma="D"
        textus="decórem indútus est" notae="h ixi hr h g hr h"/>
    <exemplum pagina="6*" pars="mediatio" forma="D" nota="hebr."
        textus="eam in Éphrata" notae="ixi hr h g hr h"/>

    <!-- terminationes (AR p. 6*) -->
    <exemplum pagina="6*" pars="terminatio" differentia="g"
        textus="pópulo suo" notae="h g f gh g"/>
    <exemplum pagina="6*" pars="terminatio" differentia="g"
        textus="vivífica me" notae="h g f gh g"/>
    <exemplum pagina="6*" pars="terminatio" differentia="g"
        textus="ante lucíferum génui te" notae="h h h h h h g f gh g"/>
    <exemplum pagina="6*" pars="terminatio" differentia="g"
        textus="in tabernáculis Cham" notae="h h h g f gh g"/>
    <exemplum pagina="6*" pars="terminatio" differentia="g"
        textus="loquébar pacem de te" notae="h h h g f gh g"/>
    <exemplum pagina="6*" pars="terminatio" differentia="g"
        textus="in saéculum saéculi" notae="h h g f gh gr g"/>
    <exemplum pagina="6*" pars="terminatio" differentia="g"
        textus="et liberávit me" notae="h g f gh gr g"/>
    <exemplum pagina="6*" pars="terminatio" differentia="g"
        textus="órdinem Melchísedech" notae="h h g f gh gr g"/>
    <exemplum pagina="6*" pars="terminatio" differentia="D"
        textus="saéculum saéculi" notae="h g f gh gr gvFED"/>
    <exemplum pagina="6*" pars="terminatio" differentia="D2"
        textus="saéculum saéculi" notae="h g f gr gf d"/>
    <exemplum pagina="6*" pars="terminatio" differentia="f"
        textus="saéculum saéculi" notae="h g f gh gr gf"/>
    <exemplum pagina="6*" pars="terminatio" differentia="g2"
        textus="saéculi" notae="g gr ghg"/>
    <exemplum pagina="6*" pars="terminatio" differentia="a"
        textus="saéculi" notae="g hr h"/>
    <exemplum pagina="6*" pars="terminatio" differentia="a2"
        textus="saéculi" notae="g gr gh"/>
    <exemplum pagina="6*" pars="terminatio" differentia="a3"
        textus="saéculi" notae="gh gr gh"/>

    <!-- clausulae abbreviatae (AR p. 6*): textus deficiens -->
    <exemplum pagina="6*" pars="mediatio" forma="abbreviata"
        textus="Qui fácit haec" notae="hixih g hr h"/>
    <exemplum pagina="6*" pars="terminatio" forma="abbreviata"
        differentia="g" textus="et tímui" notae="f gh gr g"/>
    <exemplum pagina="6*" pars="terminatio" forma="abbreviata"
        differentia="g" textus="et salva me" notae="f gh gr g"/>
    <exemplum pagina="6*" pars="terminatio" forma="abbreviata"
        differentia="g" nota="hebr." textus="laus Ísrael"
        notae="f gh gr g"/>
  </tonus>

  <!-- Tonus Secundus: AR 1912 p. 8*-9* (folia n1031-n1032).
       Mediatio solemnis Toni II (p. 9*) omissa (P4). -->
  <tonus modus="2" clavis="f3" tenor="h" pagina="8*">
    <initium>e f</initium>
    <flexa>f</flexa>

    <mediatio>
      <accentus superveniens="h">i</accentus>
      <nota>h</nota>
    </mediatio>

    <!-- "In monosyllaba vel hebraica voce" (p. 8*): syllaba ultima
         notam accentus capit, nulla nota sequitur. -->
    <mediatio casus="monosyllaba">
      <nota>i</nota>
    </mediatio>

    <!-- "Finalis unica D vel A" (p. 8*). Praeparatio h ante g a
         tenore indistincta, non scripta. -->
    <terminatio differentia="D">
      <praeparatio>g</praeparatio>
      <accentus superveniens="f">e</accentus>
      <nota>f</nota>
    </terminatio>

    <!-- PROPOSITUM: clavis in terminatione = totus tonus in hac clave
         iisdem litteris canitur (liber clavem c3 ante terminationem
         ponit; f sub c3 = la). -->
    <terminatio differentia="A" clavis="c3">
      <praeparatio>g</praeparatio>
      <accentus superveniens="f">e</accentus>
      <nota>f</nota>
    </terminatio>

    <exemplum pagina="8*" pars="versus" differentia="D"
        textus="Secundus tonus sic incípitur, sic fléctitur † et sic mediátur * atque sic finítur."
        notae="e f h h h h h h h h h h f f † h h h h i h * h h h g e f"/>
    <exemplum pagina="8*" pars="terminatio" differentia="A"
        textus="atque sic finítur" notae="h h h g e f"/>

    <!-- cantica (p. 8*): inceptio ad singulos versus (AR p. 4*).
         PROPOSITUM: canticum="verum"; pars="semiversus" = solum
         semiversus primus (initium + mediatio). -->
    <!-- "Magníficat": initium solemne (= Mediatio solemnis Toni II,
         p. 9*, "Et ex-sul-"), non regula toni simplicis. -->
    <exemplum pagina="8*" pars="versus" differentia="D" canticum="verum"
        nota="initium solemne"
        textus="Magníficat * ánima mea Dóminum."
        notae="e fe eh h * h h h h g e fr f"/>
    <exemplum pagina="8*" pars="initium" canticum="verum"
        textus="Et exsultávit" notae="e f h h h"/>
    <exemplum pagina="8*" pars="semiversus" canticum="verum"
        textus="Quia fecit mihi magna qui potens est"
        notae="e f h h h h h h h h h i"/>
    <exemplum pagina="8*" pars="semiversus" canticum="verum" nota="hebr."
        textus="Benedíctus Dóminus Deus Israel"
        notae="e f h h h h h h h h h i"/>
    <exemplum pagina="8*" pars="initium" canticum="verum"
        textus="Et eréxit" notae="e f h h"/>

    <!-- mediatio (p. 8*) -->
    <exemplum pagina="8*" pars="mediatio"
        textus="púeri Dóminum" notae="h h h i hr h"/>
    <exemplum pagina="8*" pars="mediatio"
        textus="in judício" notae="h h i hr h"/>
    <exemplum pagina="8*" pars="mediatio" casus="monosyllaba"
        textus="locútus sum" notae="h h h i"/>
    <exemplum pagina="8*" pars="mediatio" casus="monosyllaba"
        textus="éripe me" notae="h h h i"/>
    <exemplum pagina="8*" pars="mediatio" casus="monosyllaba"
        textus="tua ex me" notae="h h h i"/>
    <exemplum pagina="8*" pars="mediatio" casus="monosyllaba"
        textus="in me est" notae="h h i"/>
    <exemplum pagina="8*" pars="mediatio" casus="monosyllaba"
        nota="hebr." textus="ex Sion" notae="h h i"/>
    <exemplum pagina="8*" pars="mediatio" casus="monosyllaba"
        nota="hebr." textus="in Ephrata" notae="h h h i"/>

    <!-- terminationes (p. 8*-9*) -->
    <exemplum pagina="8*" pars="terminatio" differentia="D"
        textus="éripe me" notae="h g e f"/>
    <exemplum pagina="8*" pars="terminatio" differentia="D"
        textus="timéntibus se" notae="h h g e f"/>
    <exemplum pagina="8*" pars="terminatio" differentia="D"
        textus="declináte a me" notae="h h h g e f"/>
    <exemplum pagina="9*" pars="terminatio" differentia="D"
        textus="in saéculum saéculi" notae="h h h g e fr f"/>
    <exemplum pagina="9*" pars="terminatio" differentia="D"
        textus="et liberávit me" notae="h h g e fr f"/>
    <exemplum pagina="9*" pars="terminatio" forma="abbreviata"
        differentia="D" textus="et tímui" notae="g e fr f"/>
  </tonus>

  <!-- Tonus Tertius: AR 1912 p. 10*-12* (folia n1033-n1035).
       Mediatio solemnis Toni III (p. 12*) omissa (P4).
       "Adaptatio textus fit ut in Mediatione Toni 1., sed in fine, si
       occurrat dictio acuta in antepenultima, locus datur Supervenienti
       anticipatae" (p. 10*). -->
  <tonus modus="3" clavis="c4" tenor="j" pagina="10*">
    <initium>g hj</initium>
    <flexa>h</flexa>

    <mediatio>
      <accentus superveniens="j">k</accentus>
      <nota>j</nota>
      <accentus superveniens="j" anticipata="verum">ih</accentus>
      <nota>j</nota>
    </mediatio>

    <!-- b, a: praeparatio j ante h a tenore indistincta, non scripta -->
    <terminatio differentia="b">
      <praeparatio>h</praeparatio>
      <accentus superveniens="j">j</accentus>
      <nota>i</nota>
    </terminatio>

    <terminatio differentia="a">
      <praeparatio>h</praeparatio>
      <accentus superveniens="j">j</accentus>
      <nota>ih</nota>
    </terminatio>

    <terminatio differentia="a2">
      <praeparatio>ji</praeparatio>
      <praeparatio>hi</praeparatio>
      <accentus superveniens="g">h</accentus>
      <nota>gh</nota>
    </terminatio>

    <terminatio differentia="g">
      <praeparatio>ji</praeparatio>
      <praeparatio>hi</praeparatio>
      <accentus superveniens="g">h</accentus>
      <nota>g</nota>
    </terminatio>

    <!-- g2: "cum solis Antiphonis Omnia, Quóniam, Dómine probásti, in
         Vesperis ferialibus usurpatur, adhiberi potest Differentia g"
         (p. 10*) -->
    <terminatio differentia="g2" vicaria="g">
      <praeparatio>h</praeparatio>
      <praeparatio>j</praeparatio>
      <praeparatio>i</praeparatio>
      <accentus superveniens="g">h</accentus>
      <nota>g</nota>
    </terminatio>

    <exemplum pagina="10*" pars="versus" differentia="b"
        textus="Tertius tonus sic incípitur, sic fléctitur † et sic mediátur * atque sic finítur."
        notae="g hj j j j j j j j j j j h h † j j k j ih j * j j j h j i"/>
    <exemplum pagina="10*" pars="terminatio" differentia="a"
        textus="Atque sic finítur" notae="j j j h j ih"/>
    <exemplum pagina="10*" pars="terminatio" differentia="a2"
        textus="Atque sic finítur" notae="j j ji hi h gh"/>
    <exemplum pagina="10*" pars="terminatio" differentia="g"
        textus="Atque sic finítur" notae="j j ji hi h g"/>
    <exemplum pagina="10*" pars="terminatio" differentia="g2"
        textus="Atque sic finítur" notae="j h j i h g"/>

    <!-- cantica (p. 10*). "Magníficat *": semiversus nimis brevis -
         initium tantum, deinde tenor; mediatio omissa. -->
    <exemplum pagina="10*" pars="semiversus" canticum="verum"
        nota="mediatio omissa" textus="Magníficat"
        notae="g hj j j"/>
    <exemplum pagina="10*" pars="semiversus" canticum="verum"
        textus="Et exsultávit spíritus meus"
        notae="g hj j j j k jr j ih j"/>
    <exemplum pagina="10*" pars="semiversus" canticum="verum"
        textus="Quia fecit mihi magna qui potens est"
        notae="g hj j j j j k jr j jr ih j"/>
    <exemplum pagina="10*" pars="semiversus" canticum="verum" nota="hebr."
        textus="Benedíctus Dóminus Deus Ísrael"
        notae="g hj j j j j j k j jr ih j"/>
    <exemplum pagina="10*" pars="initium" canticum="verum"
        textus="Et eréxit" notae="g hj j j"/>

    <!-- mediatio, formae A-D (p. 10*-11*) -->
    <exemplum pagina="10*" pars="mediatio" forma="A"
        textus="confirmátum est cor ejus" notae="j j j j k j ih j"/>
    <exemplum pagina="10*" pars="mediatio" forma="A"
        textus="splendóribus sanctórum" notae="j j j k j ih j"/>
    <exemplum pagina="11*" pars="mediatio" forma="A"
        textus="gáudio os nostrum" notae="j j k j ih j"/>
    <exemplum pagina="11*" pars="mediatio" forma="A"
        textus="Dóminus ex Sion" notae="j j k j ih j"/>
    <exemplum pagina="11*" pars="mediatio" forma="A" nota="hebr."
        textus="ex Basán convértam" notae="j j k j ih j"/>
    <exemplum pagina="11*" pars="mediatio" forma="A"
        textus="vivífica me" notae="j k j ih j"/>
    <exemplum pagina="11*" pars="mediatio" forma="A" nota="hebr."
        textus="in Ísrael est" notae="j k j ih j"/>
    <exemplum pagina="11*" pars="mediatio" forma="B"
        textus="miserátor Dóminus" notae="j j k j jr ih j"/>
    <exemplum pagina="11*" pars="mediatio" forma="B"
