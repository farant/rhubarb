{
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/generata-custos.sh",
            "timeout": 10,
            "statusMessage": "custos generatorum..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/censor-custos.sh",
            "timeout": 30,
            "statusMessage": "censor latinae..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/examen-custos.sh",
            "timeout": 30,
            "statusMessage": "examen C89..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/excubitor-custos.sh",
            "timeout": 10,
            "statusMessage": "excubitor capitum..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/natura-custos.sh",
            "timeout": 15,
            "statusMessage": "natura .genera..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/canon-custos.sh",
            "timeout": 15,
            "statusMessage": "canon .canon/.stml..."
          }
        ]
      }
    ]
  }
}