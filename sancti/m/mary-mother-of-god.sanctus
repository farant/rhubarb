<sanctus id="mary-mother-of-god" versio="1" genus="persona" status="sanctus">
  <nomen lingua="en" principale="verum">Mary, Mother of God</nomen>
  <nomen lingua="en" fontes="ce">Blessed Virgin Mary</nomen>
  <nomen lingua="el" fontes="ce">Theotokos</nomen>
