  <vitium phrasis="every year on feb 30" incipit="feb 30: no such date"/>
  <vitium phrasis="2026-10-30 from 2026-10-01"
          incipit="2026-10-30 from 2026-10-01: a single date can't have a start"/>
</corpus>
