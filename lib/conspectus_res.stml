<!-- conspectus_res.stml - genus quaerendum 'res': res agendae
     (indagatio S2; C: lib/indagatio_genera.c). Infixa in
     lib/conspectus_infixa.c per tools/conspectus_infigere.sh. -->
<conspectus nomen="res" versio="1">
  <clavis typus="nomen"/>
  <fons documentum="agenda" irritat="per-rem"/>
  <quaerendum genus="Agenda"/>
</conspectus>
