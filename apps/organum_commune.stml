<!-- organum_commune.stml - basis omnium organorum (status-plan S2;
     census IX inventum 4): campi quos machina (dispensator, montatio)
     in ramo cuiusque organi scribit. Additur per organum_basim_addere
     ANTE campos proprios.

     superficies = observatio (magnitudo fenestrae), focus = status
     applicationis: classificatio propria postea (census V). -->
<organum genus="organum_commune" versio="1">
  <actiones>
    <actio nomen="dispensator" systema="verum"/>
  </actiones>
  <status>
    <campus nomen="id" typus="nomen" vita="persistens"
            nota="montatio (insula rami R3/R4): tabula_latus_genus"/>
    <campus nomen="focus"         typus="textus" vita="persistens"
            scriptor="dispensator"/>
    <campus nomen="focus_acervus" typus="textus" vita="persistens"
            scriptor="dispensator"/>
    <campus nomen="superficies_latitudo" typus="numerus" vita="persistens"
            scriptor="dispensator" nota="dispensator scribit (013 B1)"/>
    <campus nomen="superficies_altitudo" typus="numerus" vita="persistens"
            scriptor="dispensator" nota="dispensator scribit (013 B1)"/>
  </status>
</organum>
