<!-- organum.stml - manifestum calendarii (agenda-plan A2). Pagina una
     (genus calendarium) cuius visus mutatur: mensis (A2), hebdomas
     (dies VII cum rebus apertis et notis diei), dies (A3), annus (A5).
     Contentum (res, perfectio) in documento agendae (volumen vici,
     spatium "agenda"), commune omnibus lateribus
     calendarii et agendae - hic solum status visus. Hodie ex porta
     horologii (radix vici, tempus_*), numquam ex systemate. -->
<organum genus="calendarium" versio="1">

  <ligamina>
    <ligamen nomen="documentum" genus="agenda" a="parens"/>
  </ligamina>

  <portae>
    <porta nomen="hodie" modus="petitio"
      nota="dies hodierna: tempus_* radicis vici (systema horologium)"/>
  </portae>

  <actiones>
    <actio nomen="calendarium.agere"/>
  </actiones>

  <status>
    <campus nomen="visus" typus="electio" vita="persistens"
            absens="mensis" scriptor="calendarium.agere"
            semita="ligatio" historia="impelle">
      <optio>mensis</optio>
      <optio>hebdomas</optio>
      <optio>dies</optio>
      <optio>annus</optio>
      <optio>agenda</optio>
    </campus>
    <campus nomen="dies_electus" typus="dies" vita="transiens"
            scriptor="calendarium.agere" semita="ligatio"
            nota="YYYY-MM-DD; absens = hodie (semita
                  'calendarium/dies' = dies hodierna semper)"/>
    <campus nomen="res_electa" typus="nomen" vita="transiens"
            scriptor="calendarium.agere"
            semita="status" ambitus="ligatio"
            nota="id rei electae (ULID aut decimale vetus) in visu
                  diei; absens = prima"/>
    <campus nomen="prompta" typus="electio" vita="transiens"
            absens="nulla" scriptor="calendarium.agere">
      <optio>nulla</optio>
      <optio>nova</optio>
      <optio>nota</optio>
      <optio>titulus</optio>
      <optio>dies</optio>
      <optio>rubricae</optio>
      <optio>filtrum</optio>
    </campus>
    <campus nomen="prompta_textus" typus="textus" vita="transiens"
            scriptor="calendarium.agere"
            nota="effugitus (scriba_effugere): quota duplex in attributo
                  irrepraesentabilis"/>
    <campus nomen="prompta_cursor" typus="numerus" vita="transiens"
            scriptor="calendarium.agere"/>
    <campus nomen="rubrica_filtrum" typus="textus" vita="persistens"
            scriptor="calendarium.agere" semita="status"
            nota="visus agendae: una rubrica (kebab: '-' in typo nomen
                  non licet); absens = omnes"/>
    <campus nomen="pagina" typus="numerus" vita="transiens"
            scriptor="calendarium.agere"
            semita="status" ambitus="ligatio"
            nota="pagina indicis (visus diei et agendae; 0 = prima);
                  ad 0 redit cum dies aut visus mutatur"/>
    <campus nomen="elenchus" typus="textus" vita="transiens"
            aspectus="popover" scriptor="calendarium.agere"
            nota="menu contextuale apertum (M2c): '<contextus> x y' -
                  larva contextus (I res, II dies mensis, IV vacuum) et
                  ancora in spatio calendarii; absens = clausum
                  (dimissio claudit: Esc, ictus extra, res electa)"/>
    <campus nomen="elenchus_electa" typus="numerus" vita="transiens"
            scriptor="calendarium.agere"
            nota="res menu illuminata (claves, motus muris); absens =
                  nulla; ad nullam redit cum menu aperitur"/>
    <campus nomen="natalis_super" typus="textus" vita="transiens"
            aspectus="popover" scriptor="calendarium.agere"
            nota="P6d: placenta natalis sub mure (visus mensis): 'YYYY-MM-DD
                  x y' - dies et punctum muris in spatio calendarii;
                  absens = nulla (exitus muris, ictus, clavis, visus aut
                  mensis mutatus, menu apertum)"/>
  </status>

  <!-- semitae R4e: argumentum nudum -> semita ("YYYY-MM" computatum in
       kalendarium.c, ante cognomina) -->
  <cognomina>
    <cognomen nomen="agenda" semita="calendarium/agenda"/>
    <cognomen typus="dies" semita="calendarium/dies/{}"/>
  </cognomina>

  <!-- comites P5: Cmd+F = quaestio intra visum -->
  <aditus>
    <iter nomen="quaestio" semita="indagatio?genus=res" advocare="verum"/>
  </aditus>

  <basis genus="organum_commune"/>
  <montationes>
    <!-- D5 S3c: liber notarum (scriba nidificata, id "<id>_notae");
         pagina eius in semita: ?notae.pagina=2 -->
    <montatio nomen="notae" genus="scriba"/>
  </montationes>
</organum>
