# exemplar.nginx - situs nginx (hospitium v3 T10; smaragda)
# installatur in /etc/nginx/sites-available/exemplar.golden.earth;
# certbot --nginx partem TLS (443) postea addit.
server {
    listen 80;
    listen [::]:80;
    server_name exemplar.golden.earth;

    # fila usque ad LXIV MB (exemplar petitio_maxima)
    client_max_body_size 64m;

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
