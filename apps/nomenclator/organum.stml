<!-- organum.stml - manifestum nomenclatoris (nomenclator-plan P2):
     index contactuum. Contentum (personae) in documento personarum
     (volumen vici, spatium "personae"), commune omnibus lateribus -
     hic solum status visus. -->
<organum genus="nomenclator" versio="1">

  <ligamina>
    <ligamen nomen="documentum" genus="personae" a="parens"/>
  </ligamina>

  <actiones>
    <actio nomen="nomenclator.agere"/>
  </actiones>

  <status>
    <campus nomen="visus" typus="electio" vita="persistens"
            absens="index" scriptor="nomenclator.agere">
      <optio>index</optio>
      <optio>rubricae</optio>
    </campus>
    <campus nomen="rubrica_filtrum" typus="textus" vita="persistens"
            scriptor="nomenclator.agere"
            nota="una rubrica (kebab); absens = omnes; valet in
                  visu utroque"/>
    <campus nomen="persona_electa" typus="numerus" vita="transiens"
            scriptor="nomenclator.agere"
            nota="id personae electae; absens = prima paginae"/>
    <campus nomen="pagina" typus="numerus" vita="transiens"
            scriptor="nomenclator.agere"
            nota="pagina indicis (0 = prima); persona electa paginam
                  sequitur"/>
    <campus nomen="prompta" typus="electio" vita="transiens"
            absens="nulla" scriptor="nomenclator.agere">
      <optio>nulla</optio>
      <optio>homo</optio>
      <optio>societas</optio>
      <optio>filtrum</optio>
    </campus>
    <campus nomen="prompta_textus" typus="textus" vita="transiens"
            scriptor="nomenclator.agere"
            nota="effugitus (scriba_effugere): quota duplex in attributo
                  irrepraesentabilis"/>
    <campus nomen="prompta_cursor" typus="numerus" vita="transiens"
            scriptor="nomenclator.agere"/>
    <campus nomen="elenchus" typus="textus" vita="transiens"
            aspectus="popover" scriptor="nomenclator.agere"
            nota="menu apertum: '<contextus> x y' (I = globulus +
                  New); absens = clausum"/>
    <campus nomen="elenchus_electa" typus="numerus" vita="transiens"
            scriptor="nomenclator.agere"
            nota="res menu illuminata; absens = nulla"/>
  </status>

  <basis genus="organum_commune"/>
  <montationes/>
</organum>
