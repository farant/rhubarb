<!--
  canon.canon
  Canon linguae canonum ipsius (plagulae *.canon) - SE HOSPITANS.
  Registrum '<canon>' ad hanc plagulam ligat, ergo haec plagula
  SE IPSAM iudicat quotiens iudicatur.

  CUR: canon_legere ignota TACITE praeterit (mos benignus lectoris,
  sed porta muta scribentis). Ante hanc plagulam quattuor vitia
  scribentis silenter transibant:
    I.   attributum ignotum ('necesarium=') - postulatum evanescit,
         canon de se ipso mentitur
    II.  genus ignotum ('nmuerus') - in textus tacite cadit,
         valores non iam iudicantur
    III. veritas mala ('radix="vreum"') - in falsum tacite cadit
    IV.  unicitas sine attributo= aut super= - porta quae nihil
         custodit sed custodire videtur
  Omnia quattuor nunc vitia sunt. Porta muta et porta mortua idem
  videntur (lex domus) - culpa PLANTATA in ortu probanda.

  INVENTUM TERTIO DIALECTO DESCRIBENDO: unicitas per documentum
  TOTUM currit, ergo 'nomen elementi semel' hic dici NON potest -
  aedilis.canon duas <elementum nomen="regula"> definitiones
  legitime fert (intra= diversa). Unicitas ADSTRICTA (per parentem,
  aut super pari intra+nomen) est postulatio quam dialectus tertius
  facit sed nondum accipit; si dialectus alius eandem faciet,
  aedificetur.

  DECISIONES (observatum non est postulatum):
    - dialectus= et versio= POSTULANTUR quamquam machina sine eis
      legit: canon sine nomine contractus anonymus est
    - unicitas attributum= et super= POSTULANTUR quia sine eis
      unicitas taciturna nihil agit (IV supra) - canon hic
      STRICTIOR machina est, quod rectum est: lector tolerat,
      contractus poscit
    - 'optio sub genus=electio solum' co-occurrentia est, supra
      canonem (eadem sententia ac natura.canon)
-->
<canon dialectus="canon" versio="1">

  <elementum nomen="canon" radix="verum">
    <attributum nomen="dialectus" genus="nomen"   necessarium="verum"/>
    <attributum nomen="versio"    genus="numerus" necessarium="verum"/>
    <liberum nomen="elementum" minimum="1"
      nota="canon sine elementis nihil describit"/>
    <liberum nomen="unicitas"/>
    <liberum nomen="citatio"/>
  </elementum>

  <!-- ================= ELEMENTUM ================= -->

  <!-- nomina elementorum GENERIS TITULI sunt (compositum + punctum
       unum ducens optionale): grammatica 'genera-extra' et regulas
       kebab fert; arbor porphyriana '<.species>' (2026-08-10) punctum
       coegit. Nomina attributorum composita MANENT (speculum
       lexatoris stml: tags puncta accipiunt, attributa numquam) -->
  <elementum nomen="elementum">
    <attributum nomen="nomen"  genus="titulus" necessarium="verum"/>
    <attributum nomen="intra"  genus="titulus"
      nota="definitio ad parentem adstricta (mos RELAX NG)"/>
    <attributum nomen="radix"  genus="veritas"/>
    <attributum nomen="textus" genus="electio"
      nota="verum = textus licet sine genere; genus nominatum =
            textus non vacuus generi congruere debet (vacuitas
            praeteritur - necessitas textus lectoris est). electio
            consulto abest: mechanismus optionum pro textu nondum
            existit">
      <optio>verum</optio>
      <optio>nomen</optio>
      <optio>numerus</optio>
      <optio>veritas</optio>
      <optio>dies</optio>
      <optio>compositum</optio>
    </attributum>
    <attributum nomen="nota"   genus="textus"/>
    <liberum nomen="attributum"/>
    <liberum nomen="liberum"/>
    <liberum nomen="glossa"/>
  </elementum>

  <elementum nomen="attributum">
    <attributum nomen="nomen" genus="compositum" necessarium="verum"/>
    <attributum nomen="genus" genus="electio"
      nota="absens = textus (ordinarius lectoris); electio hic
            vitium II supra claudit; identitas/referentia = signa
            ('#' individuum, '.' genus) - spec canon-referentia">
      <optio>textus</optio>
      <optio>nomen</optio>
      <optio>numerus</optio>
      <optio>veritas</optio>
      <optio>dies</optio>
      <optio>electio</optio>
      <optio>compositum</optio>
      <optio>identitas</optio>
      <optio>referentia</optio>
      <optio>titulus</optio>
    </attributum>
    <attributum nomen="necessarium" genus="veritas"/>
    <attributum nomen="ordinarius"  genus="textus"
      nota="valor praestitutus cum attributum abest - canon eum
            DICIT non applicat (documentatio, catalogus, generatio
            codicis); machina conformitatem generi in lectione
            cogit (praestitutum mendax canonem frangit)"/>
    <attributum nomen="fractio" genus="veritas"
      nota="FINES (spec fines), numerus solus: punctum decimale
            licet (digiti utrimque). Constrictio spatii valorum,
            numquam repraesentatio machinae"/>
    <attributum nomen="minimum" genus="numerus" fractio="verum"
      nota="finis INCLUSIVUS inferior - eadem verba ac cardinalitas
            liberi, elementum aliud, res alia (valor, non numerus
            liberorum). Machina in lectione cogit: fines inversi
            aut formae pravae canonem frangunt"/>
    <attributum nomen="maximum" genus="numerus" fractio="verum"/>
    <attributum nomen="nota"        genus="textus"/>
    <liberum nomen="optio"/>
  </elementum>

  <elementum nomen="optio" textus="verum"/>

  <elementum nomen="liberum">
    <attributum nomen="nomen"   genus="titulus" necessarium="verum"/>
    <attributum nomen="minimum" genus="numerus"/>
    <attributum nomen="maximum" genus="numerus"/>
    <attributum nomen="nota"    genus="textus"/>
  </elementum>

  <elementum nomen="glossa" textus="verum"
    nota="documentatio vernacula in canone (spec glossae) - iudicium
          eam numquam AGIT, formam solam cogit (lingua necessaria).
          canon_legere et canon_coquere eam praetereunt (liberum
          sine nomen=)">
    <attributum nomen="lingua" genus="nomen" necessarium="verum"/>
  </elementum>

  <!-- ================= UNICITAS ================= -->

  <elementum nomen="unicitas">
    <attributum nomen="nomen"      genus="compositum"
      necessarium="verum"/>
    <attributum nomen="attributum" genus="compositum"
      necessarium="verum"/>
    <attributum nomen="super"      genus="textus" necessarium="verum"
      nota="index spatiis separatus - ergo textus, non compositum"/>
    <attributum nomen="intra"      genus="compositum"
      nota="scopus per INSTANTIAM elementi nominati (postulatio
            secunda: parametra intra quaestionem); absens =
            documentum totum"/>
    <attributum nomen="nota"       genus="textus"/>
  </elementum>

  <!-- ================= CITATIO ================= -->

  <elementum nomen="citatio"
    nota="clavis-relatio INTRA documentum (mos xs:key/keyref -
          quod unum XSD recte fecit). Trans plagulas = gradus III,
          oneratoris manet">
    <attributum nomen="nomen"       genus="compositum"
      necessarium="verum"/>
    <attributum nomen="attributum"  genus="compositum"
      necessarium="verum"
      nota="attributum citans - valor eius clavem aequare debet"/>
    <attributum nomen="ad"          genus="textus"
      necessarium="verum"
      nota="forma 'elementum.../attributum' - tituli spatiis
            separati ante solidum (unus = forma simplex; plures =
            subsumptio compilata, generator posteros enumerat);
            solidus extra compositum, ergo textus; machina formam
            malam clamans frangit"/>
    <attributum nomen="super"       genus="textus"
      nota="index elementorum citantium spatiis separatus;
            absens = elementum quodlibet attributum ferens.
            Forma 'parens/titulus' (spec super-adstrictum):
            elementum sub parente illo solo - liberi multiplicati
            nomen trans parentes communicant, clausurae differunt"/>
    <attributum nomen="intra"       genus="compositum"
      nota="claves et citantes intra EANDEM instantiam (transitus
            statum machinae SUAE citat); absens = documentum"/>
    <attributum nomen="nota"        genus="textus"/>
  </elementum>

</canon>
