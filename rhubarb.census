<?xml version="1.0" encoding="UTF-8"?>
<!--
  rhubarb.census - census rerum huius repositorii (ambulatio XVI)

  DISCIPLINA (KAOS/DO-178C): radix una (causa finalis), nihil
  orbum - omnis res parentem habere debet. Ubi relatio deest,
  parentela in nota prosa iacet et in MESSE numeratur: hoc
  documentum mensurat quantum corpus dicere possit, non fingit.

  FOCUS: mesofacta - quae annos vera manent, deinde tacite
  mutantur (numeri, sedes, claves, conventiones).
  Iudicatur per monolithum (registrum: .census).

  FINIS (decretum Franis 2026-08-11): documentum SEMEN est, non
  index. Eo tendit ut advena peritus (homo aut agens) ex hoc
  solo, radice incipiens, inceptum RECREARE possit: fines,
  normae, architectura, pacta interfaciei, laquei, ars. Non
  fabrica granularis fontium (artefactum se ipsum melius dicit)
  sed quae REPOSITORIUM NUMQUAM DICIT: requisita, intentiones,
  causae. Semen, non species archetypa: reconstructio
  CONVERGENS petitur, non fidelitas byte.

  REGULA ADMISSIONIS (differentia advenae): ordo locum meretur
  si advena peritus sine eo erraret. Quod quisque peritus iam
  scit, exclusum; quod domus sola novit, inclusum.

  PORTA: regeneratio. Agens sine contextu documentum solum
  accipit et reficere conatur; lacunae relationis eius index
  operum ambulationis proximae sunt. Non ut re vera reficiamus -
  heuristica est quae documentum in formam rectam cogit, ut
  culpa plantata portas probat.
-->
<individua>

  <!-- ============ RADIX ET FINES (spina) ============ -->

  <causa-finalis nomen="&instauratio;" extra-ordinem="verum"
    contentum="Civilizationem catholicam instaurare per opera quae saecula durent.">
    <glossa lingua="en">The restoration: to rebuild Catholic
      civilization through works meant to last for centuries. The
      root end - marked extra-ordinem because nothing above it
      exists to cause it; every other end in this census depends
      on this one.</glossa>
  </causa-finalis>

  <causa-finalis nomen="&perennitas;"
    contentum="Opera sine putredine: nullae dependentiae externae, bibliothecae propriae, C89 quia stabile manet.">
    <glossa lingua="en">Permanence: works free of rot - no external
      dependencies, libraries of our own, C89 because it holds
      still. A program is a machine that does not wear out; decay
      enters only where it is invited in.</glossa>
    <pendet-ex ad="&instauratio;"/>
    <causat ad="&c;"/>
    <causat ad="&piscina;"/>
    <causat ad="&chorda;"/>
    <causat ad="&stml;"/>
    <causat ad="&canon;"/>
    <causat ad="&norma-vexillorum;"/>
    <causat ad="&norma-latinitatis;"/>
  </causa-finalis>

  <causa-finalis nomen="&intellectus;"
    contentum="Fran codicem OMNEM intellegit - homo est RAG systematis totius; quidquid intellectum servat, hic pendet.">
    <glossa lingua="en">Understanding: Fran understands ALL the
      code - the human is the retrieval system of the whole, the
      one mind holding the map. Whatever preserves understanding
      (the semantic dictionary, the onboarding letter, the ledger)
      hangs from this end.</glossa>
    <pendet-ex ad="&instauratio;"/>
    <causat ad="&claude-md;"/>
    <causat ad="&index-naturae;"/>
    <causat ad="&natura;"/>
    <causat ad="&metamodulus;"/>
    <causat ad="&norma-latinitatis;"/>
    <causat ad="&norma-plagularum-privatarum;"/>
    <causat ad="&annales-tabularii;"/>
  </causa-finalis>

  <causa-finalis nomen="&dominium;"
    contentum="Machinae nostrae: LSP proprium, analysta proprius, instrumenta propria - fiducia crescens in apparatu domus.">
    <glossa lingua="en">Ownership: our own machinery - our own
      language server, our own parser, our own build and judgment
      tools - with trust in the house's apparatus growing as it
      proves itself against real work.</glossa>
    <pendet-ex ad="&instauratio;"/>
    <causat ad="&silva;"/>
    <causat ad="&legatus;"/>
    <causat ad="&canon-examen;"/>
    <causat ad="&natura-examen;"/>
    <causat ad="&aedilis;"/>
    <causat ad="&tabulariumd;"/>
    <causat ad="&vps-debianum;"/>
    <causat ad="&clavis-vps;"/>
    <causat ad="&monolithus-canonum;"/>
    <causat ad="&claude-code;"/>
  </causa-finalis>

  <!-- ============ LINGUA ============ -->

  <!-- &c; in bibliotheca naturae vivit (claves externae, W1);
       augmentatio notam domus apponit - duplicatum mortuum -->
  <% &c;>
    <nota>C89 stricte (-pedantic).</nota>
  </%>

  <!-- ============ BIBLIOTHECAE (specimina) ============
       gradus = longitudo catenae dependentiarum domesticarum:
       0 = sola bibliotheca vulgaris, n = maximum fontium + 1.
       (Advena I: 'gradus 0-2 promissi, solus 0 datus' - nunc
       definitus et cuique datus.) -->

  <bibliotheca nomen="&piscina;" scripta-in="&c;" gradus="0">
    <nota>Arena memoriae - solum omnium.</nota>
    <glossa lingua="en">The memory arena - the ground beneath
      everything: every library builds on it, allocation moves a
      pointer, and freeing hands back the whole pool at
      once.</glossa>
  </bibliotheca>

  <bibliotheca nomen="&chorda;" scripta-in="&c;" gradus="1">
    <dependet-ex ad="&piscina;"/>
    <nota>Chorda mensuram fert, NUMQUAM nullo terminatur -
      functiones bibliothecae vulgaris alienae sunt. Functiones
      sumentes piscinam accipiunt (arcus quem census prior
      tacebat et advena I contra documentum recte divinavit).</nota>
  </bibliotheca>

  <bibliotheca nomen="&stml;" scripta-in="&c;" gradus="2">
    <dependet-ex ad="&piscina;"/>
    <dependet-ex ad="&chorda;"/>
    <nota>XML-varians domus. textus internus VERBATIM est
      (migratio 2026-08-06). silva exemplar suum vendicat -
      amalgamare.sh post mutationes.</nota>
  </bibliotheca>

  <bibliotheca nomen="&canon;" scripta-in="&c;" gradus="3">
    <dependet-ex ad="&stml;"/>
    <nota>Schemata STML: vocabularium, cardinalitas, genera
      valorum, citationes, fines. Lingua expressionum NUMQUAM.</nota>
  </bibliotheca>

  <bibliotheca nomen="&natura;" scripta-in="&c;" gradus="4">
    <dependet-ex ad="&stml;"/>
    <dependet-ex ad="&canon;"/>
    <nota>Numeri eius NON hic iacent sed in signis infra:
      quisque viam suam fert, ideo re-examinari potest.</nota>
  </bibliotheca>

  <bibliotheca nomen="&silva;" scripta-in="&c;" gradus="2">
    <dependet-ex ad="&piscina;"/>
    <dependet-ex ad="&chorda;"/>
    <nota>Analysta C89 robustus: emissio byte-fidelis, codices
      54-88, fundamentum legati et instrumentorum.</nota>
  </bibliotheca>

  <bibliotheca nomen="&credo;" scripta-in="&c;" gradus="1">
    <dependet-ex ad="&piscina;"/>
    <nota>Probationum bibliotheca domus: asserta CREDO_*,
      compendium probationis. Exemplar usūs canonicum:
      probationes/probatio_piscina.c. Cursor suitarum:
      ./compile_tests.sh [pars] - vexilla eadem norma
      vexillorum. Silentium advenae I acerbissimum: census sine
      probationibus stabat dum periculum cardinale eius porta
      vacua erat.</nota>
  </bibliotheca>

  <!-- ============ PROGRAMMATA ============ -->

  <daemon nomen="&tabulariumd;">
    <adhibet ad="&piscina;"/>
    <adhibet ad="&chorda;"/>
    <nota>Tabularium residens (MCP super TCP). Refectio: pkill
      tabulariumd. Servus_mcp QUOQUE est - sodalitas secundaria
      (etiam=) in documentis censūs indicibilis. Veritas eius:
      #annales-tabularii.</nota>
  </daemon>

  <daemon nomen="&legatus;">
    <adhibet ad="&silva;"/>
    <nota>LSP residens + legati MCP. CAVE: promptuarium
      plagularum capitis numquam revalidat (01KZ6GH88Z) -
      examen frigidum auctoritas post editiones capitum.</nota>
  </daemon>

  <instrumentum-lineae nomen="&canon-examen;">
    <adhibet ad="&canon;"/>
    <adhibet ad="&stml;"/>
    <nota>Iudex documentorum per registrum (canones.registrum in
      radice). Exitus 2 = NIHIL iudicatum, defectus non salus.</nota>
  </instrumentum-lineae>

  <instrumentum-lineae nomen="&natura-examen;">
    <adhibet ad="&natura;"/>
    <adhibet ad="&canon;"/>
    <nota>Porta celeris (0.03s contra visus 14s), uncus
      natura-custos eam ignit in *.genera.</nota>
  </instrumentum-lineae>

  <instrumentum-lineae nomen="&silva-examen;">
    <adhibet ad="&silva;"/>
    <nota>./silva/examen.sh via - iudicium C89 frigidum ex
      disco: AUCTORITAS post editiones capitum (remedium
      periculi promptuarii). In prosa notarum vivebat dum
      remedium cardinale erat - ambulatio realista eum
      enrollavit.</nota>
  </instrumentum-lineae>

  <instrumentum-lineae nomen="&compile-tests;">
    <adhibet ad="&credo;"/>
    <nota>./compile_tests.sh pars - cursor suitarum radicis
      (congruentia contra nomina plagularum probationis; exitus
      2 = NIHIL CURSUM, pactum exituum). Vexilla norma
      vexillorum, fons verus GCC_FLAGS.</nota>
  </instrumentum-lineae>

  <instrumentum-lineae nomen="&amalgamare;">
    <adhibet ad="&stml;"/>
    <adhibet ad="&silva;"/>
    <nota>./silva/amalgamare.sh - exemplar stml venditum silvae
      synchronizat; post mutationes stml CURRENDUM aut silva
      cum stml dissentit.</nota>
  </instrumentum-lineae>

  <instrumentum-lineae nomen="&frigida;">
    <adhibet ad="&annales-tabularii;"/>
    <nota>./gesta/frigida.sh - via frigida tabularii: scribit
      in annales cum residens iacet. Par calidi/frigidi quod
      veritatem annalium probat.</nota>
  </instrumentum-lineae>

  <instrumentum-lineae nomen="&census-orbi;">
    <adhibet ad="&do_178c;"/>
    <nota>./tools/census_orbi.sh via - custos orbitatis huius
      ipsius documenti: disciplinam traceabilitatis DO-178C/KAOS
      applicat (radix declarata, pertinentia vera computata).
      Claves externas seminum novit et nomina ignota NOMINAT
      exitu 1 (01KZRS606V clausa). Pertinentia sua prior FICTA
      erat: praesens analystae in augmentationem sequentem
      manabat - mendum sanatum eodem die quo inventum.</nota>
  </instrumentum-lineae>

  <instrumentum-lineae nomen="&census-recensere;">
    <adhibet ad="&stml;"/>
    <nota>./tools/census_recensere.sh - signa huius documenti
      contra vias suas confert: RECENS / MOTUS / VIA MORTUA
      (via sana exitu 0 mensurat). Circuitus mensurae clausus:
      numerus sine recensore tacite putrescebat, quod census
      contra CLAUDE.md nasci fecit. Pars C per stml analysat -
      pactum parseris unius.</nota>
  </instrumentum-lineae>

  <!-- &aedilis; in bibliotheca naturae vivit (genus
       instrumentum-aedificationis stat - essentia super
       operationem, decretum Franis); census adhibitionem
       silvae et notam apponit -->
  <% &aedilis;>
    <adhibet ad="&silva;"/>
    <nota>Stratum aedificationis: clausura inclusionum, --partes,
      indices generati.</nota>
  </%>

  <!-- ============ UNCI (custodes machinales) ============
       Vigilantia sine vocatione: eventus eos evocat, nemo
       currit. Ambulatio realista eos e prosa levavit - sex
       res cum biographia (mors communis mensurata, observatio
       infra) sine genere vivebant. -->

  <uncus nomen="&censor;" eventus="editio .c/.h/.m"
    custodit="&norma-latinitatis;">
    <adhibet ad="&silva;"/>
    <nota>./silva/censor.sh: macro-verbum latina.h in
      declaratore deprehendit et culpam nominat - cascata
      erroris cryptici ante eum diagnosis manualis erat.</nota>
  </uncus>

  <uncus nomen="&uncus-examinis;" eventus="editio .c/.h"
    custodit="&norma-vexillorum;">
    <adhibet ad="&silva-examen;"/>
    <nota>Iudicium C89 post editionem, verdictum ACCIPE/REICE
      statim. CAVE: editiones acervatas currit - examen
      frigidum arbiter (vide periculum promptuarii).</nota>
  </uncus>

  <uncus nomen="&natura-custos;" eventus="servatio natura/*.genera"
    custodit="&natura;">
    <adhibet ad="&natura-examen;"/>
    <nota>Vulnera trans-exemplaria post servationem nominat -
      sanationem trium vulnerum hodiernam VIVE narravit
      (3 -> 1 -> 0 per editiones).</nota>
  </uncus>

  <uncus nomen="&canon-custos;" eventus="servatio .canon/.stml/.census"
    custodit="&canon;">
    <adhibet ad="&canon-examen;"/>
    <nota>Contractum documenti post scriptionem iudicat -
      citationem praematuram in media serie editionum
      deprehendit (ambulatio regenerationis, res viva).</nota>
  </uncus>

  <uncus nomen="&excubitor;" eventus="editio capitum (include/*.h)"
    custodit="&aedilis;">
    <adhibet ad="&silva;"/>
    <nota>Radius editionis capitis: quot plagulae directe
      includunt, obiecta consumptorum stala fiunt. Graphum
      inclusionum silvae legit.</nota>
  </uncus>

  <uncus nomen="&natura-canonum-custos;" eventus="servatio *.genera"
    custodit="&monolithus-canonum;">
    <nota>Canones coctos RANCIDOS post mutationem generum
      clamat et mandatum regenerationis nominat
      (./tools/natura_canones.sh) - recusatio clara cum
      remedio suo.</nota>
  </uncus>

  <!-- ============ NORMAE (conventiones domus) ============ -->

  <norma nomen="&norma-vexillorum;" titulus="vexilla compilationis"
    status-vigor="vigens" proprium="&c;"
    contentum="clang -std=c89 -pedantic -Wall -Wextra -Werror -Wconversion -Wsign-conversion -Wcast-qual -Wstrict-prototypes -Wmissing-prototypes -Wwrite-strings -Wno-long-long -Wno-overlength-strings -fbracket-depth=512">
    <nota>Fons verus: compile_tests.sh GCC_FLAGS. ADVENA I
      (regeneratio prima) defectum invenit: index prior X vexilla
      ex memoria ferebat, re vera XIV - et -std=c89 IPSUM aberat,
      constrictio cardinalis in indice scripto nusquam. Idem
      defectus in CLAUDE.md adhuc manet (X vexilla, sine -std).</nota>
  </norma>

  <norma nomen="&norma-latinitatis;" titulus="latinitas nominum"
    status-vigor="vigens"
    contentum="Identificatores, commenta, nuntii Latine; verba technica singula (offset...) intacta licent. Verba latina.h identificatores VETITI (nomen, casus, per, magnitudo, structura...) - mechanismus in pacto latinitatis fontis.">
    <nota>Duos fines habet (superdeterminata: RM 18) - vide
      spinam. VOCABULARIUM RESERVATUM praeter latina.h: verba
      par.3/4 METAMODULI in dominio naturae (genus, species,
      actio, status, fons...) et nomina generum censūs (signum,
      observatio...) - advena I 'signum' pro nota arenae
      adhibuit et se ipse correxit: lexicon reservatorum
      deerat.</nota>
  </norma>

  <norma nomen="&norma-plagularum-privatarum;"
    titulus="plagulae Franis ab agente numquam tanguntur"
    status-vigor="vigens"
    contentum="FAQ.md, gesta/annales/forum.jsonl, gesta/annales/tabula.md, gesta/annales/tabularium.jsonl: Fran solus eas addit et committit; agens numquam ('git add -A' vetitum, additio explicita per viam). Plagulae ipsae COMMITTUNTUR - annales veritas committenda est. Vetitum de AGENTE est, non de plagulis.">
    <nota>ADVENA I contradictionem invenit: titulus prior 'numquam
      committuntur' cum annalibus 'VERITAS committenda' pugnabat -
      reaedificator disciplinam git sorte dimidia male fecisset.
      Subiectum vetiti deerat; nunc dictum.</nota>
  </norma>

  <norma nomen="&metamodulus;" titulus="METAMODULUS - forma naturae"
    status-vigor="vigens" normat="&natura;"
    contentum="Forma exemplarium naturae: par.8 contractus lectoris (regulae XVII), par.9 doctrina. Tabula par.3 GENERATA - natura.canon fons, numquam tabula ipsa editur."/>

  <!-- ============ PACTA (foedera consilii) ============
       Forma artefactorum quam implementatio QUAEVIS honorare
       debet. Advena I capita poscebat; censui PACTA debentur:
       interfacies in capitibus vivunt (artefactum se ipsum
       optime dicit), foedera formae HIC. Relatio proprium
       ABSENS = commune (lingua quavis honorandum); praesens =
       linguae huic proprium (decretum Franis 2026-08-11). -->

  <pactum nomen="&pactum-interfaciei-primae;"
    contentum="Interfacies thesaurus est, implementatio fluit: interfaciem primam recte fingere; implementatio post libere emendatur, interfacies refingi dolet."
    ex-fonte="&eskil_steenberg;" tendit-ad="&perennitas;">
    <informat ad=".bibliotheca"/>
  </pactum>

  <pactum nomen="&pactum-chordae;"
    contentum="Chorda par (datum, mensura) est, sentinella NUMQUAM terminata; limes ad mundum sentinellarum functio una explicita. Mensura portatur, non quaeritur."
    tendit-ad="&perennitas;">
    <informat ad="&chorda;"/>
    <nota>Commune: in C disciplina est (vide periculum
      chordae), in linguis recentioribus natura ipsa.</nota>
  </pactum>

  <pactum nomen="&pactum-piscinae;"
    contentum="Memoria per piscinas: sumptio in arenam ambitūs, liberatio TOTIUS simul, rei singulae numquam; interfacies sumens piscinam EXPLICITE accipit."
    tendit-ad="&perennitas;">
    <informat ad="&piscina;"/>
  </pactum>

  <pactum nomen="&pactum-exituum;"
    contentum="Exitus 0 purus, 1 defectus inventi, 2 NIHIL CURSUM - defectus, non salus. Custos omnis hoc pactum servat; qui solum 0 spectat fallitur."
    tendit-ad="&dominium;">
    <natum-ex ad="&periculum-exitus-secundi;"/>
    <informat ad=".instrumentum-lineae"/>
    <informat ad=".uncus"/>
  </pactum>

  <pactum nomen="&pactum-recusationis;"
    contentum="Defectus CLARE recusat et causam nominat; degradatio tacita vetita - quod tacet, fidem fabricat."
    tendit-ad="&dominium;"/>

  <pactum nomen="&pactum-fidelitatis;"
    contentum="Analysta circuitum byte-idem servat: quod legitur et remittitur idem est (silva in C, stml sine ornatu). Scriptor lectorem probat."
    tendit-ad="&dominium;">
    <informat ad="&stml;"/>
    <informat ad="&silva;"/>
  </pactum>

  <pactum nomen="&pactum-parseris-unius;"
    contentum="Analysta UNUS cuique formae; instrumenta cetera tabulas eius consumunt, praesentatio sola. Lectiones plures corporis unius dissensum tacitum parant."
    tendit-ad="&intellectus;"/>

  <pactum nomen="&pactum-veritatis;"
    contentum="Veritas UNA committitur; visus omnis proiectio refectibilis (annales/db, corpus/INDEX, liber/arbor). Quod bis stat, semel mentietur."
    tendit-ad="&intellectus;">
    <informat ad="&annales-tabularii;"/>
  </pactum>

  <pactum nomen="&pactum-portae-natalis;"
    contentum="Porta quaeque culpa plantata RUBRA nascitur antequam viridi eius creditur: porta tacita et porta mortua idem videntur."
    tendit-ad="&dominium;">
    <natum-ex ad="&casus-uncorum-mutorum;"/>
    <informat ad=".uncus"/>
  </pactum>

  <pactum nomen="&pactum-numerorum;"
    contentum="Numeri insignati ordinarii, signati nominatim (domi: i32/i64 insignati, s32/s64 signati); quod ex horologio venit SEMPER signatum - differentia temporis natura sua signata est, involutio insignata ramus est qui tacite numquam currit."
    tendit-ad="&perennitas;"/>

  <pactum nomen="&pactum-latinitatis-fontis;"
    contentum="Fons PER macros latina.h scribitur (si, alioquin, per, dum, redde, structura...): verba clavium Latina in ipso textu stant, unde macro-verba identificatoribus VETITA."
    proprium="&c;" tendit-ad="&intellectus;">
    <nota>Coniectura stili maxima advenae I ('mutat omnem
      lineam') hic soluta: per macros, non solum praeter
      verba.</nota>
  </pactum>

  <pactum nomen="&pactum-suturae;"
    contentum="Quod machinae proprium est post suturam iacet; nucleus systema numquam directe vocat - portatio suturam novam scribit, nucleum numquam."
    tendit-ad="&perennitas;"/>

  <pactum nomen="&pactum-generatorum;"
    contentum="Artefactum generatum generatorem suum se ipso declarat et manu numquam editur: fons mutatur, artefactum refit."
    tendit-ad="&intellectus;">
    <informat ad="&monolithus-canonum;"/>
    <informat ad="&index-naturae;"/>
  </pactum>

  <!-- ============ PERICULA (laquei quos domus novit) ======= -->

  <periculum nomen="&periculum-chordae;"
    contentum="Functiones bibliothecae vulgaris in chorda adhibitae: chorda mensuram fert nec nullo terminatur, ideo strcpy/strlen silenter corrumpunt."
    probabilitas="0.6" gravitas="gravis" minatur="&claude-code;">
    <minuitur-per ad="&claude-md;"/>
    <minuitur-per ad="&pactum-chordae;"/>
    <nota>Custos machinalis NULLUS hoc periculum vigilat -
      solum documentum et pactum (ambulatio realista: pericula
      cum unco contra pericula sine unco nunc quaeri
      possunt).</nota>
  </periculum>

  <periculum nomen="&periculum-promptuarii-legati;"
    contentum="Legatus capita promptuaria numquam revalidat: post caput editum verdictum REICE falsum reddit et 'renovare' se recentem dicit."
    probabilitas="0.7" gravitas="levis" minatur="&claude-code;">
    <minuitur-per ad="&claude-md;"/>
    <minuitur-per ad="&silva-examen;"/>
    <nota>Mensuratum 01KZ6GH88Z. Remedium nunc RES est, non
      prosa: instrumentum silva-examen (examen frigidum)
      auctoritas post editiones capitum.</nota>
  </periculum>

  <periculum nomen="&periculum-expansionis-aequalis;"
    contentum="Verbum '===' nudum in mandato zsh expansionem aequalis evocat: separator innocens cursum abrumpit et exitum falsum instrumento innocenti tribuit."
    probabilitas="0.7" gravitas="levis" minatur="&claude-code;">
    <minuitur-per ad="&claude-md;"/>
    <nota>Probabilitas MENSURATA, non aestimata: ictus VII in
      tabulario (res 01KYRCJ340...), saepissime icta rerum
      omnium - disciplina signorum (via) in pericula extensa:
      numerus morsuum pro numero ex memoria.</nota>
  </periculum>

  <periculum nomen="&periculum-exitus-secundi;"
