<!-- officina/aedificatio.stml - declarationes aedificationis officina (dialectus
     aedificatio, aedificatio.canon; bin/fabrica per fabrica.stml).
     Plan 1a T4: catena amalgamatis - manifesta amalgamatoris
     (aedilis) -> amalgama officina.c commissa, provenientia regeneratione.
     CATENA MEMORABILIS (parcum fabricae …AR15, 2026-10-01): ingressus
     probabiliter pleni per clausuras (genus 'manifesta', modus fragmentorum
     plan 1a T6). fontes_officina manifestum unum per radicem scribit
     (build/fabrica/clausurae/officina__amalgama); excludenda_officina clausuram amalgamatoris ipsius
     (amalgamator.c + mechanismus communis, build/fabrica/clausurae/officina__mechanismus).
     Scriptor cuiusque directorii est actio quae id ipsa legit (inclusio
     nova = plagula clausurae mutata = clavis mutata = rescriptio);
     amalgama_officina infra in catena solum legit. aedilis per BINARIUM
     (instrumentum, sine arcu: aedilis ex amalgamate struitur - manifestum
     eius cyclum faceret). Clang ambiens manet. -->
<aedificatio>
  <!-- praelatio ordinis ex exitu COMMISSO legitur (generator
       idempotens per constructionem) - ergo exitus et ingressus -->
  <actio titulus="fontes_officina" genus="generator" memorabilis="verum">
    <mandatum>
      <verbum! (>./tools/amalgama_fontes_generare.sh
      <verbum! (>officina
    </mandatum>
    <vestigium via="build/aedilis/amalgama_fontes" communis="verum"/>
    <vestigium via="build/aedilis/caput" communis="verum"/>
    <vestigium via="build/fabrica/clausurae/officina__amalgama"/>
    <ingressus genus="manifesta" via="build/fabrica/clausurae/officina__amalgama"/>
    <ingressus genus="fasciculus" via="officina/instrumenta/principalia/fontes_politica.sh"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="radices" via="aedilis.stml"/>
    <ingressus genus="instrumentum" via="bin/aedilis"/>
    <ingressus genus="fasciculus" via="tools/amalgama_fontes_generare.sh"/>
    <ingressus genus="directorium" via="officina/fontes"/>
    <ingressus genus="fasciculus" via="officina/instrumenta/principalia/fontes_generata.h"/>
    <exitus via="officina/instrumenta/principalia/fontes_generata.h" provenientia="regeneratio"/>
  </actio>
  <!-- OBIECTA MECHANISMI (1b T5): officina/build/*.o per mtime structa,
       a generatore excludendorum CAECE nexa - strategia ignota,
       praecondicio sola (numquam iudicatur) -->
  <actio titulus="obiecta_mechanismi_officina" genus="generator">
    <mandatum>
      <verbum! (>./officina/amalgamare.sh
      <verbum! (>-obiecta
    </mandatum>
    <vestigium via="officina/build" forma="plagulae" suffixa=".o"/>
    <ingressus genus="fasciculus" via="officina/amalgamare.sh"/>
    <exitus via="officina/build" provenientia="ignota"/>
  </actio>
  <actio titulus="excludenda_officina" genus="generator" memorabilis="verum">
    <mandatum>
      <verbum! (>./tools/amalgama_excludenda_generare.sh
      <verbum! (>officina
    </mandatum>
    <praecondicio actio="obiecta_mechanismi_officina"/>
    <vestigium via="build/aedilis/excludenda" communis="verum"/>
    <vestigium via="build/fabrica/clausurae/officina__mechanismus"/>
    <ingressus genus="manifesta" via="build/fabrica/clausurae/officina__amalgama"/>
    <ingressus genus="manifesta" via="build/fabrica/clausurae/officina__mechanismus"/>
    <ingressus genus="radices" via="aedilis.stml"/>
    <ingressus genus="instrumentum" via="bin/aedilis"/>
    <ingressus genus="fasciculus" via="tools/amalgama_excludenda_generare.sh"/>
    <ingressus genus="fasciculus" via="officina/instrumenta/principalia/fontes_generata.h"/>
    <ingressus genus="fasciculus" via="officina/instrumenta/principalia/fontes_politica.sh"/>
    <ingressus genus="fasciculus" via="tools/mechanismus_fontes.sh"/>
    <!-- officina/build/mech_*.o per globum nexa: praecondicio
         obiecta_mechanismi_officina (1b T5; olim ingressus directorii,
         nomina solum tegens) -->
    <exitus via="officina/instrumenta/principalia/excludenda_generata.h" provenientia="regeneratio"/>
  </actio>
  <actio titulus="amalgama_officina" genus="generator" memorabilis="verum">
    <mandatum>
      <verbum! (>./officina/amalgamare.sh
    </mandatum>
    <praecondicio actio="obiecta_mechanismi_officina"/>
    <vestigium via="officina/build"/>
    <vestigium via="silva/build" communis="verum"/>
    <vestigium via="build/aedilis/amalgama_fontes" communis="verum"/>
    <vestigium via="build/aedilis/excludenda" communis="verum"/>
    <vestigium via="build/aedilis/caput" communis="verum"/>
    <ingressus genus="fasciculus" via="officina/instrumenta/principalia/fontes_generata.h"/>
    <ingressus genus="fasciculus" via="officina/instrumenta/principalia/excludenda_generata.h"/>
    <ingressus genus="manifesta" via="build/fabrica/clausurae/officina__amalgama"/>
    <ingressus genus="manifesta" via="build/fabrica/clausurae/officina__mechanismus"/>
    <ingressus genus="radices" via="aedilis.stml"/>
    <ingressus genus="fasciculus" via="officina/amalgamare.sh"/>
    <ingressus genus="fasciculus" via="officina/instrumenta/principalia/fontes_politica.sh"/>
    <ingressus genus="fasciculus" via="tools/mechanismus_fontes.sh"/>
    <exitus via="officina/amalgama/officina.c" provenientia="regeneratio"/>
  </actio>
  <!-- FRAGMENTA RADIX_FONTES (plan 1a T6): MEMORABILIA - ingressus
       probabiliter pleni: generator manifestum unum per radicem in
       build/fabrica/clausurae/ scribit (aedilis --manifestum), iudex
       eas explicat (genus 'manifesta'); radices = nomina directoriorum
       inclusorum aedilis.stml. Verificatio (build/fabrica.db) cum
       clave ingressuum ET mandati regenerationem supplet. aedilis per
       FONTES suos (manifestum), non per binarium: relinkatum octetis
       differt (LC_UUID), clavis per cursum mutaretur. -->
  <actio titulus="fragmentum_officina_colloquium" genus="generator" lectiones="verum">
    <mandatum>
      <verbum! (>./tools/fontes_generare.sh
      <verbum! (>officina/colloquium_fontes_generata.sh
      <verbum! (>officina/instrumenta/principalia/colloquium.c
      <verbum! (>officina/fontes/officina_conexio.c
      <verbum! (>officina/fontes/officina_demissio.c
      <verbum! (>officina/fontes/officina_indicium.c
      <verbum! (>officina/fontes/officina_machinula.c
      <verbum! (>officina/fontes/officina_medulla.c
      <verbum! (>officina/fontes/officina_medulla_textus.c
      <verbum! (>officina/fontes/officina_regio.c
    </mandatum>
    <vestigium via="build/fabrica/clausurae/officina__colloquium_fontes_generata"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="manifestum" via="build/aedilis/aedilis/manifestum.stml"/>
    <ingressus genus="fasciculus" via="tools/fontes_generare.sh"/>
    <exitus via="officina/colloquium_fontes_generata.sh" provenientia="regeneratio"/>
  </actio>
  <actio titulus="fragmentum_officina_cursor" genus="generator" lectiones="verum">
    <mandatum>
      <verbum! (>./tools/fontes_generare.sh
      <verbum! (>officina/cursor_fontes_generata.sh
      <verbum! (>officina/instrumenta/principalia/cursor.c
      <verbum! (>officina/fontes/officina_conexio.c
      <verbum! (>officina/fontes/officina_demissio.c
      <verbum! (>officina/fontes/officina_indicium.c
      <verbum! (>officina/fontes/officina_machinula.c
      <verbum! (>officina/fontes/officina_medulla.c
      <verbum! (>officina/fontes/officina_medulla_textus.c
      <verbum! (>officina/fontes/officina_regio.c
    </mandatum>
    <vestigium via="build/fabrica/clausurae/officina__cursor_fontes_generata"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="manifestum" via="build/aedilis/aedilis/manifestum.stml"/>
    <ingressus genus="fasciculus" via="tools/fontes_generare.sh"/>
    <exitus via="officina/cursor_fontes_generata.sh" provenientia="regeneratio"/>
  </actio>
  <actio titulus="fragmentum_officina_fusor" genus="generator" lectiones="verum">
    <mandatum>
      <verbum! (>./tools/fontes_generare.sh
      <verbum! (>officina/fusor_fontes_generata.sh
      <verbum! (>officina/instrumenta/principalia/fusor.c
      <verbum! (>officina/fontes/officina_conexio.c
      <verbum! (>officina/fontes/officina_demissio.c
      <verbum! (>officina/fontes/officina_indicium.c
      <verbum! (>officina/fontes/officina_machinula.c
      <verbum! (>officina/fontes/officina_medulla.c
      <verbum! (>officina/fontes/officina_medulla_textus.c
      <verbum! (>officina/fontes/officina_regio.c
    </mandatum>
    <vestigium via="build/fabrica/clausurae/officina__fusor_fontes_generata"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="manifestum" via="build/aedilis/aedilis/manifestum.stml"/>
    <ingressus genus="fasciculus" via="tools/fontes_generare.sh"/>
    <exitus via="officina/fusor_fontes_generata.sh" provenientia="regeneratio"/>
  </actio>
  <actio titulus="fragmentum_officina_interpretare" genus="generator" lectiones="verum">
    <mandatum>
      <verbum! (>./tools/fontes_generare.sh
      <verbum! (>officina/interpretare_fontes_generata.sh
      <verbum! (>officina/instrumenta/principalia/interpretare.c
      <verbum! (>officina/fontes/officina_conexio.c
      <verbum! (>officina/fontes/officina_demissio.c
      <verbum! (>officina/fontes/officina_indicium.c
      <verbum! (>officina/fontes/officina_machinula.c
      <verbum! (>officina/fontes/officina_medulla.c
      <verbum! (>officina/fontes/officina_medulla_textus.c
      <verbum! (>officina/fontes/officina_regio.c
    </mandatum>
    <vestigium via="build/fabrica/clausurae/officina__interpretare_fontes_generata"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="manifestum" via="build/aedilis/aedilis/manifestum.stml"/>
    <ingressus genus="fasciculus" via="tools/fontes_generare.sh"/>
    <exitus via="officina/interpretare_fontes_generata.sh" provenientia="regeneratio"/>
  </actio>
  <actio titulus="fragmentum_officina_legatus" genus="generator" lectiones="verum">
    <mandatum>
      <verbum! (>./tools/fontes_generare.sh
      <verbum! (>officina/legatus_fontes_generata.sh
      <verbum! (>officina/instrumenta/principalia/legatus.c
      <verbum! (>officina/instrumenta/praeparator.c
      <verbum! (>officina/instrumenta/compendium.c
      <verbum! (>officina/instrumenta/legatus.c
      <verbum! (>silva/instrumenta/nexus_ordines.c
      <verbum! (>silva/instrumenta/silva_lexicon.c
    </mandatum>
    <vestigium via="build/fabrica/clausurae/officina__legatus_fontes_generata"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="manifestum" via="build/aedilis/aedilis/manifestum.stml"/>
    <ingressus genus="fasciculus" via="tools/fontes_generare.sh"/>
    <exitus via="officina/legatus_fontes_generata.sh" provenientia="regeneratio"/>
  </actio>
  <actio titulus="fragmentum_officina_sonda" genus="generator" lectiones="verum">
    <mandatum>
      <verbum! (>./tools/fontes_generare.sh
      <verbum! (>officina/sonda_fontes_generata.sh
      <verbum! (>officina/instrumenta/principalia/sonda.c
      <verbum! (>officina/instrumenta/praeparator.c
      <verbum! (>officina/instrumenta/compendium.c
      <verbum! (>officina/instrumenta/legatus.c
      <verbum! (>silva/instrumenta/nexus_ordines.c
      <verbum! (>silva/instrumenta/silva_lexicon.c
    </mandatum>
    <vestigium via="build/fabrica/clausurae/officina__sonda_fontes_generata"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="manifestum" via="build/aedilis/aedilis/manifestum.stml"/>
    <ingressus genus="fasciculus" via="tools/fontes_generare.sh"/>
    <exitus via="officina/sonda_fontes_generata.sh" provenientia="regeneratio"/>
  </actio>
  <actio titulus="fragmentum_officina_vindex" genus="generator" lectiones="verum">
    <mandatum>
      <verbum! (>./tools/fontes_generare.sh
      <verbum! (>officina/vindex_fontes_generata.sh
      <verbum! (>officina/instrumenta/principalia/vindex.c
      <verbum! (>officina/instrumenta/praeparator.c
      <verbum! (>officina/instrumenta/vindex_onerator.c
      <verbum! (>officina/instrumenta/vindex_visum.c
      <verbum! (>silva/instrumenta/silva_lexicon.c
    </mandatum>
    <vestigium via="build/fabrica/clausurae/officina__vindex_fontes_generata"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="manifestum" via="build/aedilis/aedilis/manifestum.stml"/>
    <ingressus genus="fasciculus" via="tools/fontes_generare.sh"/>
    <exitus via="officina/vindex_fontes_generata.sh" provenientia="regeneratio"/>
  </actio>
</aedificatio>
