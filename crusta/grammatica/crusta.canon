  </elementum>

  <elementum nomen="inclusa"
    nota="( expressio )">
    <liberum nomen="tok_apertura" maximum="1"/>
    <liberum nomen="post_aperturam" maximum="1"/>
    <liberum nomen="expressio" maximum="1"/>
    <liberum nomen="post_expressionem" maximum="1"/>
