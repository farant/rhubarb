    <liberum nomen="tok_subscriptum" maximum="1"/>
  </elementum>

  <elementum nomen="tok_titulus" intra="variabilis">
    <liberum nomen="crusta-variabilis" maximum="1"/>
  </elementum>

  <elementum nomen="tok_subscriptum" intra="variabilis">
    <liberum nomen="crusta-subscriptum" maximum="1"/>
  </elementum>

  <elementum nomen="praeposita"
    nota="-x !x ~x ++x --x +x">
    <liberum nomen="tok_operator" maximum="1"/>
    <liberum nomen="post_signum" maximum="1"/>
    <liberum nomen="operandum" maximum="1"/>
  </elementum>

  <elementum nomen="tok_operator" intra="praeposita">
