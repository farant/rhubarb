    <liberum nomen="tok_quaestio" maximum="1"/>
    <liberum nomen="post_quaestionem" maximum="1"/>
    <liberum nomen="sinister" maximum="1"/>
    <liberum nomen="post_sinistrum" maximum="1"/>
    <liberum nomen="tok_colon" maximum="1"/>
    <liberum nomen="post_colon" maximum="1"/>
