  </elementum>

  <elementum nomen="operandum" intra="praeposita">
    <<#expressio-una>>
  </elementum>

  <elementum nomen="postposita"
    nota="x++ x--">
    <liberum nomen="operandum" maximum="1"/>
    <liberum nomen="post_operandum" maximum="1"/>
    <liberum nomen="tok_operator" maximum="1"/>
  </elementum>

  <elementum nomen="operandum" intra="postposita">
