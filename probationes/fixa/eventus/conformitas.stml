<!-- conformitas.stml - tabula conformitatis fontium eventuum (eventus
     A4; spec D7). Lector: lib/eventus_conformitas.c. Cursor fenestrae:
     ./tools/conformitas.sh (in postulatione; fenestra retro aperitur).

     immissio <clavis>: codex = macOS kVK (a=0, i=34, Tab=48, Escape=53,
     sagittae 123..126), modificantes = NSEventModifierFlags cruda
     (Shift 131072 + latus sinistrum 2; Ctrl 262144 + 1; Alt 524288 +
     32), characteres UTF-8. <mus>: genus ut fenestra_musarius.
     expectata: attributa quae scaena nominat (scriptura rara: actio
     'pressa', runa 0 non scribuntur - ergo non nominantur).
     'genera' = genera considerata; aliorum generum eventa omittuntur.
     terminalis (eventus B4b): <terminalis profilum octeti> - octeti
     cum effugiis C (\e ESC, \t, \xHH; valores attributorum STML
     crudi sunt). Cursor: probatio_conformitas_terminalis (rivus
     purus, cellula 1x1 pixelum: cellula c = pixelum c-1). legacy =
     mus solum declaratus; kitty = vexilla 31 impulsa.
     excusationes (B4a): differentiae per FACULTATEM; valent solum si
     fons eam facultatem negat (fenestra omnes habet: stricta manet).

     NOTA (B4b): 'characteres' fenestrae (&#27; &#9; &#xF702;) CRUDI
     immittuntur (STML entitates in attributis non solvit) - scaenae
     conformes manent quia fenestra his clavibus textum non emittit.

     SAGITTAE: AppKit NSEventModifierFlagFunction (0x800000 = 8388608)
     sagittis ipse addit (etiam immissis; hardware idem) - modificantes
     crudi id ferunt: Shift+sinistra = 0x820002 = 8519682. Mensuratum
     2026-10-01 (cursus primus A4). -->
<conformitas>
  <scaena
    titulus="shift-a"
     genera="clavis_depressus clavis_liberatus textus"
     excusationes="liberationes codex_physicus latera modificantes_textus"
         ((((>
    <immissio((>
      <clavis
               codex="0"
        modificantes="131074"
         characteres="A"
            depressa="1"/>
      <clavis
               codex="0"
        modificantes="131074"
         characteres="A"
            depressa="0"/>
    <expectata(((>
      <eventus
               genus="clavis_depressus"
               codex="KeyA"
                runa="97"
        modificantes="131074"/>
      <eventus genus="textus" contentum="A"/>
      <eventus genus="clavis_liberatus" codex="KeyA" actio="soluta"/>
    <terminalis profilum="legacy" octeti="A"/>
    <terminalis profilum="kitty" octeti="\e[97:65;2;65u\e[97:65;2:3u"/>
  <scaena
    titulus="tabula"
     genera="clavis_depressus clavis_liberatus textus"
     excusationes="liberationes codex_physicus"
         ((((>
    <immissio((>
      <clavis
               codex="48"
        modificantes="0"
         characteres="&#9;"
            depressa="1"/>
      <clavis
               codex="48"
        modificantes="0"
         characteres="&#9;"
            depressa="0"/>
    <expectata((>
      <eventus genus="clavis_depressus" codex="Tab"/>
      <eventus genus="clavis_liberatus" codex="Tab" actio="soluta"/>
    <terminalis profilum="legacy" octeti="\t"/>
    <terminalis profilum="kitty" octeti="\e[9u\e[9;1:3u"/>
  <scaena
    titulus="ctrl-i"
     genera="clavis_depressus clavis_liberatus textus"
     excusationes="tabula_distincta latera"
         ((((>
    <immissio((>
      <clavis
               codex="34"
        modificantes="262145"
         characteres="&#9;"
            depressa="1"/>
      <clavis
               codex="34"
        modificantes="262145"
         characteres="&#9;"
            depressa="0"/>
    <expectata((>
      <eventus
               genus="clavis_depressus"
               codex="KeyI"
                runa="105"
        modificantes="262145"/>
      <eventus genus="clavis_liberatus" codex="KeyI" actio="soluta"/>
    <terminalis profilum="legacy" octeti="\t"/>
    <terminalis profilum="kitty" octeti="\e[105;5u\e[105;5:3u"/>
  <scaena titulus="sagittae" genera="clavis_depressus textus" excusationes="latera" ((((>
    <immissio>
      <clavis
               codex="123"
        modificantes="131074"
         characteres="&#xF702;"
            depressa="1"/>
      <clavis
               codex="124"
        modificantes="524320"
         characteres="&#xF703;"
            depressa="1"/>
      <clavis
               codex="126"
        modificantes="0"
         characteres="&#xF700;"
            depressa="1"/>
      <clavis
               codex="125"
        modificantes="0"
         characteres="&#xF701;"
            depressa="1"/>
    </>
    <expectata>
      <eventus
               genus="clavis_depressus"
               codex="ArrowLeft"
        modificantes="8519682"/>
      <eventus
               genus="clavis_depressus"
               codex="ArrowRight"
        modificantes="8912928"/>
      <eventus
               genus="clavis_depressus"
               codex="ArrowUp"
        modificantes="8388608"/>
      <eventus
               genus="clavis_depressus"
               codex="ArrowDown"
        modificantes="8388608"/>
    </>
    <terminalis profilum="legacy" octeti="\e[1;2D\e[1;3C\e[A\e[B"/>
    <terminalis profilum="kitty" octeti="\e[1;2D\e[1;2:3D\e[1;3C\e[1;3:3C\e[A\e[1;1:3A\e[B\e[1;1:3B"/>
  <scaena titulus="effugium" genera="clavis_depressus textus" excusationes="codex_physicus" ((((>
    <immissio(> <clavis codex="53" modificantes="0" characteres="&#27;" depressa="1"/>
    <expectata(> <eventus genus="clavis_depressus" codex="Escape"/>
    <terminalis profilum="legacy" octeti="\e"/>
    <terminalis profilum="kitty" octeti="\e[27u\e[27;1:3u"/>
  <scaena
    titulus="ictus"
     genera="mus_depressus mus_liberatus mus_duplex"
         ((((>
    <immissio((>
      <mus genus="depressio" x="10" y="20"/>
      <mus genus="liberatio" x="10" y="20"/>
    <expectata((>
      <eventus genus="mus_depressus" x="10" y="20" botton="1"/>
      <eventus genus="mus_liberatus" x="10" y="20" botton="1"/>
    <terminalis profilum="legacy" octeti="\e[<0;11;21M\e[<0;11;21m"/>
    <terminalis profilum="kitty" octeti="\e[<0;11;21M\e[<0;11;21m"/>
  <scaena
    titulus="ictus-duplex-crudus"
     genera="mus_depressus mus_liberatus mus_duplex"
         ((((>
    <immissio>
      <mus genus="depressio" x="40" y="40"/>
      <mus genus="liberatio" x="40" y="40"/>
      <mus genus="depressio" x="40" y="40"/>
      <mus genus="liberatio" x="40" y="40"/>
    </>
    <expectata>
      <eventus genus="mus_depressus" x="40" y="40"/>
      <eventus genus="mus_liberatus" x="40" y="40"/>
      <eventus genus="mus_depressus" x="40" y="40"/>
      <eventus genus="mus_liberatus" x="40" y="40"/>
    </>
    <terminalis profilum="legacy" octeti="\e[<0;41;41M\e[<0;41;41m\e[<0;41;41M\e[<0;41;41m"/>
    <terminalis profilum="kitty" octeti="\e[<0;41;41M\e[<0;41;41m\e[<0;41;41M\e[<0;41;41m"/>
  <scaena
    titulus="tractus"
     genera="mus_depressus mus_motus mus_liberatus"
         ((((>
    <immissio>
      <mus genus="depressio" x="10" y="10"/>
      <mus genus="tractus" x="20" y="20"/>
      <mus genus="tractus" x="30" y="30"/>
      <mus genus="liberatio" x="30" y="30"/>
    </>
    <expectata(((>
      <eventus genus="mus_depressus" x="10" y="10"/>
      <eventus genus="mus_motus" x="30" y="30"/>
      <eventus genus="mus_liberatus" x="30" y="30"/>
    <terminalis profilum="legacy" octeti="\e[<0;11;11M\e[<32;21;21M\e[<32;31;31M\e[<0;31;31m"/>
    <terminalis profilum="kitty" octeti="\e[<0;11;11M\e[<32;21;21M\e[<32;31;31M\e[<0;31;31m"/>
</conformitas>