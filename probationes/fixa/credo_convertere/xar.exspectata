        /* Ponere vexillum ordinarium */
        xar_ponere_vexilla(xar, XAR_VEXILLUM_ORDINARIUS);

        /* Addere debet operari */
        elem = (i32*)xar_addere(xar);
        CREDO_NON_NIHIL(elem);
