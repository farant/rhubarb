<!-- vectores.stml - vectores aemulatoris, phasis A (aemulator-plan A0)

     Ex probationibus Ghostty (MIT, (c) 2024 Mitchell Hashimoto,
     Ghostty contributors), ../ghostty pin 12752b2: fons = plagula:linea
     probationis sub src/terminal/. Probationes Terminal.zig API vocant
     (t.print, t.setCursorPos) - hic in octetos canonicos versae:
     print(c) -> c; setCursorPos(r, c) -> CSI r;c H; cursorUp(n) ->
     CSI n A (B C D similiter); carriageReturn -> \r; linefeed -> \n;
     backspace -> \x08; eraseLine(.right/.left) -> CSI K / CSI 1K;
     eraseDisplay(.below/.above) -> CSI J / CSI 1J; setAttribute -> SGR.
     fons="domus": vector noster (nota dicit cur).

     casus: latitudo x altitudo cellularum; gradus in ordine: initus
     (octeti; effugia \xHH \n \r \t \\) deinde assertiones:
       textus      = effusio plana ut Ghostty plainString (cellulae
                     vacuae ante textum = spatia; spatia finalia
                     scripta manent; lineae vacuae finales absunt;
                     cellulae spatii omittuntur)
       cursor_x/_y = cursor (0-based); pendens = involutio pendens;
       visibilis   = DECTCEM; altera = alterum schirmum activum;
       ignota      = numerus serierum ignotarum
       cellula     x y: textus (graphema), vacua, latitudo (angusta |
                   lata | cauda | caput), stilus (SGR canonicum
                   stilus_codificare, \x1B[0...m)
     Nullum valorem vacuum (stml scriptor 'a=""' in 'verum' vertit). -->
<vectores pin="12752b2">

  <casus titulus="basic print" fons="stream_terminal.zig:2321" latitudo="10" altitudo="10">
    <gradus initus="Hello" cursor_x="5" cursor_y="0" textus="Hello"/>
  </casus>

  <casus titulus="cursor movement" fons="stream_terminal.zig:2370" latitudo="10" altitudo="10">
    <gradus initus="Hello\x1B[1;1H" cursor_x="0" cursor_y="0"/>
    <gradus initus="\x1B[2;3H" cursor_x="2" cursor_y="1"/>
  </casus>

  <casus titulus="erase operations" fons="stream_terminal.zig:2388" latitudo="20" altitudo="10">
    <gradus initus="Hello World" cursor_x="11" cursor_y="0"/>
    <gradus initus="\x1B[1;6H\x1B[K" textus="Hello"/>
  </casus>

  <casus titulus="tabs" fons="stream_terminal.zig:2409" latitudo="80" altitudo="10">
    <gradus initus="A\tB" cursor_x="9" textus="A       B"/>
  </casus>

  <casus titulus="alt screen" fons="stream_terminal.zig:2470" latitudo="10" altitudo="5">
    <gradus initus="Primary" altera="falsum"/>
    <gradus initus="\x1B[?1049h" altera="verum"/>
    <gradus initus="Alt"/>
    <gradus initus="\x1B[?1049l" altera="falsum" textus="Primary"/>
  </casus>

  <casus titulus="cursor save and restore" fons="stream_terminal.zig:2497" latitudo="80" altitudo="24">
    <gradus initus="\x1B[10;15H" cursor_x="14" cursor_y="9"/>
    <gradus initus="\x1B7"/>
    <gradus initus="\x1B[1;1H" cursor_x="0" cursor_y="0"/>
    <gradus initus="\x1B8" cursor_x="14" cursor_y="9"/>
  </casus>

  <casus titulus="attributes" fons="stream_terminal.zig:2523" latitudo="80" altitudo="24">
    <gradus initus="\x1B[1mBold\x1B[0m" textus="Bold"/>
  </casus>

  <casus titulus="input with no control characters" fons="Terminal.zig:5005" latitudo="40" altitudo="40">
    <gradus initus="hello" cursor_x="5" cursor_y="0" textus="hello"/>
  </casus>

  <casus titulus="input with basic wraparound" fons="Terminal.zig:5026" latitudo="5" altitudo="40">
    <gradus initus="helloworldabc12" cursor_x="4" cursor_y="2" pendens="verum" textus="hello\nworld\nabc12"/>
  </casus>

  <casus titulus="input that forces scroll" fons="Terminal.zig:5060" latitudo="1" altitudo="5">
    <gradus initus="abcdef" cursor_x="0" cursor_y="4" textus="b\nc\nd\ne\nf"/>
  </casus>

  <casus titulus="zero-width character at start" fons="Terminal.zig:5121" latitudo="80" altitudo="80">
    <gradus initus="\xE2\x80\x8D" cursor_x="0" cursor_y="0"/>
  </casus>

  <casus titulus="print wide char" fons="Terminal.zig:5186" latitudo="80" altitudo="80">
    <gradus initus="\xF0\x9F\x98\x80" cursor_x="2" cursor_y="0">
      <cellula x="0" y="0" textus="\xF0\x9F\x98\x80" latitudo="lata"/>
      <cellula x="1" y="0" latitudo="cauda"/>
    </gradus>
  </casus>

  <casus titulus="print wide char at edge creates spacer head" fons="Terminal.zig:5209" latitudo="10" altitudo="10">
    <gradus initus="\x1B[1;10H\xF0\x9F\x98\x80" cursor_x="2" cursor_y="1">
      <cellula x="9" y="0" latitudo="caput"/>
      <cellula x="0" y="1" textus="\xF0\x9F\x98\x80" latitudo="lata"/>
      <cellula x="1" y="1" latitudo="cauda"/>
    </gradus>
  </casus>

  <casus titulus="print over wide char at 0,0" fons="Terminal.zig:5274" latitudo="80" altitudo="80">
    <gradus initus="\xF0\x9F\x98\x80\x1B[0;0HA" cursor_x="1" cursor_y="0">
      <cellula x="0" y="0" textus="A" latitudo="angusta"/>
      <cellula x="1" y="0" vacua="verum" latitudo="angusta"/>
    </gradus>
  </casus>

  <casus titulus="print over wide spacer tail" fons="Terminal.zig:5341" latitudo="5" altitudo="5">
    <gradus initus="\xE6\xA9\x8B\x1B[1;2HX" textus=" X">
      <cellula x="0" y="0" vacua="verum" latitudo="angusta"/>
      <cellula x="1" y="0" textus="X" latitudo="angusta"/>
    </gradus>
  </casus>

  <casus titulus="soft wrap" fons="Terminal.zig:7012" latitudo="3" altitudo="80">
    <gradus initus="hello" cursor_x="2" cursor_y="1" textus="hel\nlo"/>
  </casus>

  <casus titulus="linefeed and carriage return" fons="Terminal.zig:7546" latitudo="80" altitudo="80">
    <gradus initus="hello\r\nworld" cursor_x="5" cursor_y="1" textus="hello\nworld"/>
  </casus>

  <casus titulus="linefeed unsets pending wrap" fons="Terminal.zig:7574" latitudo="5" altitudo="80">
    <gradus initus="hello" pendens="verum"/>
    <gradus initus="\n" pendens="falsum"/>
  </casus>

  <casus titulus="carriage return unsets pending wrap" fons="Terminal.zig:7604" latitudo="5" altitudo="80">
    <gradus initus="hello" pendens="verum"/>
    <gradus initus="\r" pendens="falsum"/>
  </casus>

  <casus titulus="backspace" fons="Terminal.zig:7646" latitudo="80" altitudo="80">
    <gradus initus="hello\x08y" cursor_x="5" cursor_y="0" textus="helly"/>
  </casus>

  <casus titulus="cursorPos resets wrap" fons="Terminal.zig:7809" latitudo="5" altitudo="5">
    <gradus initus="ABCDE" pendens="verum"/>
    <gradus initus="\x1B[1;1H" pendens="falsum"/>
    <gradus initus="X" textus="XBCDE"/>
  </casus>

  <!-- pars sine modo originis (origo, regio volutionis: phasis B/D) -->
  <casus titulus="setCursorPos (original test), prior part" fons="Terminal.zig:7906" latitudo="80" altitudo="80">
    <gradus cursor_x="0" cursor_y="0"/>
    <gradus initus="\x1B[0;0H" cursor_x="0" cursor_y="0"/>
    <gradus initus="\x1B[81;81H" cursor_x="79" cursor_y="79"/>
    <gradus initus="\x1B[0;80Hc" pendens="verum"/>
    <gradus initus="\x1B[0;80H" pendens="falsum"/>
  </casus>

  <casus titulus="cursorUp basic" fons="Terminal.zig:10867" latitudo="5" altitudo="5">
    <gradus initus="\x1B[3;1HA\x1B[10AX" textus=" X\n\nA"/>
  </casus>

  <casus titulus="cursorUp resets wrap" fons="Terminal.zig:10924" latitudo="5" altitudo="5">
    <gradus initus="ABCDE" pendens="verum"/>
    <gradus initus="\x1B[1A" pendens="falsum"/>
    <gradus initus="X" textus="ABCDX"/>
  </casus>

  <casus titulus="cursorLeft no wrap" fons="Terminal.zig:10943" latitudo="10" altitudo="5">
    <gradus initus="A\r\nB\x1B[10D" textus="A\nB"/>
  </casus>

  <casus titulus="cursorLeft unsets pending wrap state" fons="Terminal.zig:10962" latitudo="5" altitudo="5">
    <gradus initus="ABCDE" pendens="verum"/>
    <gradus initus="\x1B[1D" pendens="falsum"/>
    <gradus initus="X" textus="ABCXE"/>
  </casus>

  <casus titulus="cursorDown basic" fons="Terminal.zig:11243" latitudo="5" altitudo="5">
    <gradus initus="A\x1B[10BX" textus="A\n\n\n\n X"/>
  </casus>

  <casus titulus="cursorRight resets wrap" fons="Terminal.zig:11316" latitudo="5" altitudo="5">
    <gradus initus="ABCDE" pendens="verum"/>
    <gradus initus="\x1B[1C" pendens="falsum"/>
    <gradus initus="X" textus="ABCDX"/>
  </casus>

  <casus titulus="eraseLine simple erase right" fons="Terminal.zig:13721" latitudo="5" altitudo="5">
    <gradus initus="ABCDE\x1B[1;3H\x1B[K" textus="AB"/>
  </casus>

  <casus titulus="eraseLine resets pending wrap" fons="Terminal.zig:13740" latitudo="5" altitudo="5">
    <gradus initus="ABCDE" pendens="verum"/>
    <gradus initus="\x1B[K" pendens="falsum"/>
    <gradus initus="B" textus="ABCDB"/>
  </casus>

  <casus titulus="eraseLine right preserves background sgr" fons="Terminal.zig:13787" latitudo="5" altitudo="5">
    <gradus initus="ABCDE\x1B[1;2H\x1B[48;2;255;0;0m\x1B[K" textus="A">
      <cellula x="1" y="0" vacua="verum" stilus="\x1B[0;48;2;255;0;0m"/>
      <cellula x="4" y="0" vacua="verum" stilus="\x1B[0;48;2;255;0;0m"/>
    </gradus>
  </casus>

  <casus titulus="eraseLine simple erase left" fons="Terminal.zig:13926" latitudo="5" altitudo="5">
    <gradus initus="ABCDE\x1B[1;3H\x1B[1K" textus="   DE"/>
  </casus>

  <casus titulus="eraseDisplay simple erase below" fons="Terminal.zig:14718" latitudo="5" altitudo="5">
    <gradus initus="ABC\r\nDEF\r\nGHI\x1B[2;2H\x1B[J" textus="ABC\nD"/>
  </casus>

  <casus titulus="eraseDisplay simple erase above" fons="Terminal.zig:14909" latitudo="5" altitudo="5">
    <gradus initus="ABC\r\nDEF\r\nGHI\x1B[2;2H\x1B[1J" textus="\n  F\nGHI"/>
  </casus>

  <!-- index() ut \n (LF = index sine LNM) -->
  <casus titulus="index bottom of primary screen background sgr" fons="Terminal.zig:10379" latitudo="5" altitudo="5">
    <gradus initus="\x1B[5;1HA\x1B[48;2;255;0;0m\n" textus="\n\n\nA">
      <cellula x="0" y="4" vacua="verum" stilus="\x1B[0;48;2;255;0;0m"/>
      <cellula x="4" y="4" vacua="verum" stilus="\x1B[0;48;2;255;0;0m"/>
    </gradus>
  </casus>

  <!-- vectores domus: superficies phasis A quam probationes Ghostty
       per octetos non tegunt -->

  <!-- ED 2: totum vacuum, cursor manet (xterm; Ghostty eraseDisplay
       .complete cursorem non movet) -->
  <casus titulus="erase display complete keeps cursor" fons="domus" latitudo="5" altitudo="5">
    <gradus initus="ABC\r\nDEF\x1B[2J" cursor_x="3" cursor_y="1">
      <cellula x="0" y="0" vacua="verum"/>
      <cellula x="2" y="1" vacua="verum"/>
    </gradus>
  </casus>

  <!-- SGR per stilus_applicare; forma canonica stilus_codificare
       (colores tabulae semper 5;n) -->
  <casus titulus="sgr bold then reset" fons="domus" latitudo="10" altitudo="2">
    <gradus initus="\x1B[1mA\x1B[0mB" textus="AB">
      <cellula x="0" y="0" textus="A" stilus="\x1B[0;1m"/>
      <cellula x="1" y="0" textus="B" stilus="\x1B[0m"/>
    </gradus>
  </casus>

  <casus titulus="sgr palette colours" fons="domus" latitudo="10" altitudo="2">
    <gradus initus="\x1B[31;44mX" textus="X">
      <cellula x="0" y="0" textus="X" stilus="\x1B[0;38;5;1;48;5;4m"/>
    </gradus>
  </casus>

  <casus titulus="dectcem hides and shows the cursor" fons="domus" latitudo="10" altitudo="2">
    <gradus visibilis="verum"/>
    <gradus initus="\x1B[?25l" visibilis="falsum"/>
    <gradus initus="\x1B[?25h" visibilis="verum"/>
  </casus>

  <!-- 1049: cursor servatus in ingressu, restitutus in exitu (xterm
       DECSET 1049 = 1048 + 1047); alterum schirmum purgatur -->
  <casus titulus="alt screen 1049 saves and restores the cursor" fons="domus" latitudo="10" altitudo="5">
    <gradus initus="\x1B[3;3H\x1B[?1049h" cursor_x="2" cursor_y="2" altera="verum"/>
    <gradus initus="\x1B[1;1HAlt" cursor_x="3" cursor_y="0" textus="Alt"/>
    <gradus initus="\x1B[?1049l" cursor_x="2" cursor_y="2" altera="falsum"/>
    <gradus initus="\x1B[?1049h" altera="verum">
      <cellula x="0" y="0" vacua="verum"/>
    </gradus>
  </casus>

  <!-- series ignota consumitur et numeratur, numquam fatalis -->
  <casus titulus="unknown csi is consumed and counted" fons="domus" latitudo="10" altitudo="2">
    <gradus initus="A\x1B[999zB" textus="AB" ignota="1"/>
  </casus>

  <!-- 2026: modus servatur (nucleus sine tempore: nihil aliud) -->
  <casus titulus="synchronized output mode is tracked" fons="domus" latitudo="10" altitudo="2">
    <gradus initus="\x1B[?2026h">
      <modus privatus="2026" status="verum"/>
    </gradus>
    <gradus initus="\x1B[?2026l">
      <modus privatus="2026" status="falsum"/>
    </gradus>
  </casus>

</vectores>
