<!-- vectores.stml - vectores aemulatoris, phasis A (aemulator-plan A0)

     Ex probationibus Ghostty (MIT, (c) 2024 Mitchell Hashimoto,
     Ghostty contributors), ../ghostty pin 12752b2: fons = plagula:linea
     probationis sub src/terminal/. Probationes Terminal.zig API vocant
     (t.print, t.setCursorPos) - hic in octetos canonicos versae:
     print(c) -> c; setCursorPos(r, c) -> CSI r;c H; cursorUp(n) ->
     CSI n A (B C D similiter); carriageReturn -> \r; linefeed -> \n;
     backspace -> \x08; eraseLine(.right/.left) -> CSI K / CSI 1K;
     eraseDisplay(.below/.above) -> CSI J / CSI 1J; setAttribute -> SGR.
     fons="domus": vector noster (nota dicit cur).

     casus: latitudo x altitudo cellularum; gradus in ordine: initus
     (octeti; effugia \xHH \n \r \t \\) deinde assertiones:
       textus      = effusio plana ut Ghostty plainString (cellulae
                     vacuae ante textum = spatia; spatia finalia
                     scripta manent; lineae vacuae finales absunt;
                     cellulae spatii omittuntur)
       cursor_x/_y = cursor (0-based); pendens = involutio pendens;
       visibilis   = DECTCEM; altera = alterum schirmum activum;
       ignota      = numerus serierum ignotarum
       cellula     x y: textus (graphema), vacua, latitudo (angusta |
                   lata | cauda | caput), stilus (SGR canonicum
                   stilus_codificare, \x1B[0...m)
     Nullum valorem vacuum (stml scriptor 'a=""' in 'verum' vertit). -->
<vectores pin="12752b2">

  <casus titulus="basic print" fons="stream_terminal.zig:2321" latitudo="10" altitudo="10">
    <gradus initus="Hello" cursor_x="5" cursor_y="0" textus="Hello"/>
  </casus>

  <casus titulus="cursor movement" fons="stream_terminal.zig:2370" latitudo="10" altitudo="10">
    <gradus initus="Hello\x1B[1;1H" cursor_x="0" cursor_y="0"/>
    <gradus initus="\x1B[2;3H" cursor_x="2" cursor_y="1"/>
  </casus>

  <casus titulus="erase operations" fons="stream_terminal.zig:2388" latitudo="20" altitudo="10">
    <gradus initus="Hello World" cursor_x="11" cursor_y="0"/>
    <gradus initus="\x1B[1;6H\x1B[K" textus="Hello"/>
  </casus>

  <casus titulus="tabs" fons="stream_terminal.zig:2409" latitudo="80" altitudo="10">
    <gradus initus="A\tB" cursor_x="9" textus="A       B"/>
