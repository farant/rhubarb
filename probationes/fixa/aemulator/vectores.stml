  <casus titulus="scrolling moves viewport" fons="Screen.zig:5543" latitudo="10" altitudo="3">
    <gradus initus="1ABCD\r\n2EFGH\r\n3IJKL\r\n1ABCD\r\n2EFGH\r\n3IJKL" visum_movere="2" visus="2" visus_textus="2EFGH\n3IJKL\n1ABCD"/>
  </casus>

  <casus titulus="scrollback doesn't move viewport if not at bottom" fons="Screen.zig:5204" latitudo="10" altitudo="3">
    <gradus initus="1ABCD\r\n2EFGH\r\n3IJKL\r\n4ABCD\r\n5EFGH" visum_movere="1" visus_textus="2EFGH\n3IJKL\n4ABCD"/>
    <gradus initus="\x1BD" visus_textus="2EFGH\n3IJKL\n4ABCD"/>
    <gradus initus="\x1BD" visus_textus="2EFGH\n3IJKL\n4ABCD"/>
  </casus>

  <casus titulus="scrollback with multi-row delta" fons="Screen.zig:5161" latitudo="10" altitudo="3">
