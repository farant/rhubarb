  <casus titulus="resize (no reflow) less rows trims blank lines" fons="Screen.zig:7060" latitudo="10" altitudo="3" historia_octeti="0">
    <gradus initus="1ABCD\x1B[41m\r\n \x1B[2K\r\n \x1B[2K\x1B[1;6H\x1B[0m" cursor_x="5" cursor_y="0"/>
    <gradus amplitudo_latitudo="6" amplitudo_altitudo="2" cursor_x="5" cursor_y="0" visus_textus="1ABCD"/>
  </casus>

  <casus titulus="resize (no reflow) more rows trims blank lines" fons="Screen.zig:7096" latitudo="10" altitudo="3" historia_octeti="0">
