  <casus titulus="mode 1048 saves and restores the cursor" fons="domus" latitudo="10" altitudo="5">
    <gradus initus="\x1B[2;3H\x1B[?1048h\x1B[1;1H\x1B[?1048l" cursor_x="2" cursor_y="1"/>
  </casus>

  <!-- RIS (Ghostty fullReset): schirmum, historia, cursor, alterum -->
  <casus titulus="ris resets screen, history and cursor" fons="domus" latitudo="5" altitudo="2">
