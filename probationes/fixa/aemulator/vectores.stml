    <gradus initus="P\x1B[?47h\x1B[1;1HA\x1B[?47l" textus="P" altera="falsum"/>
    <gradus initus="\x1B[?47h" textus="A" altera="verum"/>
  </casus>

  <!-- 1047: exitus schirmum alterum delet -->
  <casus titulus="mode 1047 clears the alternate screen on exit" fons="domus" latitudo="5" altitudo="2">
    <gradus initus="\x1B[?1047h\x1B[1;1HA\x1B[?1047l\x1B[?1047h" textus="\0" altera="verum"/>
