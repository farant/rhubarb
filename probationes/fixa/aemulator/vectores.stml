  </casus>

  <casus titulus="input with basic wraparound" fons="Terminal.zig:5026" latitudo="5" altitudo="40">
    <gradus initus="helloworldabc12" cursor_x="4" cursor_y="2" pendens="verum" textus="hello\nworld\nabc12"/>
