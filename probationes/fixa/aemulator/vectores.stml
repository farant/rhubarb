  </casus>

  <casus titulus="printRepeat no previous character" fons="Terminal.zig:14313" latitudo="5" altitudo="5">
    <gradus initus="\x1B[b" textus="\0" ignota="0"/>
  </casus>

  <!-- Ghostty modum origo quoque ponit (D2); effectus visibilis idem -->
  <casus titulus="decaln reset margins" fons="Terminal.zig:12293" latitudo="3" altitudo="3">
    <gradus initus="\x1B[2;3r\x1B#8\x1B[T" textus="\nEEE\nEEE"/>
  </casus>

  <!-- HPR/VPR (Ghostty cursor_col/row_relative): 0 explicitum = nihil,
