      <cellula x="4" y="4" vacua="verum" stilus="\x1B[0;48;2;255;0;0m"/>
    </gradus>
  </casus>

  <!-- phasis B1 (superficies conchae): regiones volutionis, IND RI NEL SU SD,
       IL DL ICH DCH ECH, tabulationes, LNM. Conversiones additae:
       setTopAndBottomMargin(t,b) -> CSI t;b r; index -> ESC D;
       reverseIndex -> ESC M; scrollUp/Down(n) -> CSI n S/T;
       insertLines/deleteLines(n) -> CSI n L/M; insertBlanks(n) -> CSI n @;
       deleteChars(n) -> CSI n P; eraseChars(n) -> CSI n X;
       horizontalTabBack -> CSI Z; printString \n -> \r\n;
       modes.set(.linefeed) -> CSI 20 h. -->
  <casus titulus="horizontal tabs" fons="Terminal.zig:7663" latitudo="20" altitudo="5">
    <gradus initus="1\t" cursor_x="8"/>
    <gradus initus="\t" cursor_x="16"/>
    <gradus initus="\t" cursor_x="19"/>
    <gradus initus="\t" cursor_x="19"/>
  </casus>

  <casus titulus="horizontal tabs starting on tabstop" fons="Terminal.zig:7685" latitudo="20" altitudo="5">
    <gradus initus="\x1B[1;9HX\x1B[1;9H\tA" textus="        X       A"/>
  </casus>

  <casus titulus="horizontal tabs back" fons="Terminal.zig:7724" latitudo="20" altitudo="5">
    <gradus initus="\x1B[1;20H\x1B[Z" cursor_x="16"/>
    <gradus initus="\x1B[Z" cursor_x="8"/>
    <gradus initus="\x1B[Z" cursor_x="0"/>
    <gradus initus="\x1B[Z" cursor_x="0"/>
  </casus>

  <casus titulus="horizontal tabs back starting on tabstop" fons="Terminal.zig:7748" latitudo="20" altitudo="5">
    <gradus initus="\x1B[1;9HX\x1B[1;9H\x1B[ZA" textus="A       X"/>
  </casus>

