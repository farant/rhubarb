    </gradus>
  </casus>

  <casus titulus="soft wrap" fons="Terminal.zig:7012" latitudo="3" altitudo="80">
    <gradus initus="hello" cursor_x="2" cursor_y="1" textus="hel\nlo"/>
  </casus>

  <casus titulus="linefeed and carriage return" fons="Terminal.zig:7546" latitudo="80" altitudo="80">
    <gradus initus="hello\r\nworld" cursor_x="5" cursor_y="1" textus="hello\nworld"/>
  </casus>

  <casus titulus="linefeed unsets pending wrap" fons="Terminal.zig:7574" latitudo="5" altitudo="80">
    <gradus initus="hello" pendens="verum"/>
    <gradus initus="\n" pendens="falsum"/>
  </casus>

  <casus titulus="carriage return unsets pending wrap" fons="Terminal.zig:7604" latitudo="5" altitudo="80">
