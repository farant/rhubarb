    <gradus initus="1\r\n2\r\n" amplitudo_latitudo="5" amplitudo_altitudo="2" historia="1" cursor_y="1" textus="2"/>
  </casus>

  <!-- ED 3 (Ghostty eraseHistory): historia vacua, schirmum intactum,
