    <gradus visum_movere="-5" visus="0" visus_textus="4ABCD\n5EFGH\n6IJKL"/>
  </casus>

  <casus titulus="scrollback empty" fons="Screen.zig:5188" latitudo="10" altitudo="3">
    <gradus initus="1ABCD\r\n2EFGH\r\n3IJKL" visum_movere="-1" visus="0" visus_textus="1ABCD\n2EFGH\n3IJKL"/>
  </casus>

  <casus titulus="print writes to bottom if scrolled" fons="Terminal.zig:6854" latitudo="5" altitudo="2">
    <gradus initus="hello\x1B[1;1H\x1BD\x1BD\x1BD" visus_textus="\0"/>
    <gradus visum_movere="1000" visus_textus="hello"/>
    <gradus initus="A" visus_textus="hello" textus="\nA"/>
    <gradus visum_movere="-1000" visus_textus="\nA"/>
  </casus>

  <!-- decisio XXI: visus in historia sub effusione manet -->
  <casus titulus="the view stays put while output arrives" fons="domus" latitudo="5" altitudo="2">
    <gradus initus="1\r\n2\r\n3" visum_movere="1" visus="1" visus_textus="1\n2"/>
    <gradus initus="\r\n4\r\n5" historia="3" visus="3" visus_textus="1\n2"/>
  </casus>

  <!-- ==== C4: mutatio magnitudinis sine refluxu (Ghostty PageList
