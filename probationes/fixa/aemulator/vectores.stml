      <cellula x="0" y="0" textus="A" latitudo="angusta"/>
      <cellula x="1" y="0" vacua="verum" latitudo="angusta"/>
    </gradus>
  </casus>

  <casus titulus="print over wide spacer tail" fons="Terminal.zig:5341" latitudo="5" altitudo="5">
    <gradus initus="\xE6\xA9\x8B\x1B[1;2HX" textus=" X">
      <cellula x="0" y="0" vacua="verum" latitudo="angusta"/>
