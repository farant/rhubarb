  <elementum nomen="officium">
    <glossa lingua="en">An office: a charge stably established, with
    burdens, powers and conditions OF ITS OWN, which does NOT
    inhere in the one who holds it - the same office remains while
    one holder succeeds another, and it REMAINS WITH NO HOLDER AT
    ALL. Vacancy is a true state, not a missing datum.</glossa>
    <glossa lingua="fr">Un office : une charge établie de manière
    stable, avec ses propres devoirs, pouvoirs et conditions, et
    qui n'adhère PAS à son titulaire - le même office demeure
    tandis que les titulaires se succèdent, et il DEMEURE MÊME SANS
    TITULAIRE. La vacance est un état véritable, non une donnée
    absente.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="ad-tempus" genus="veritas"/>
    <attributum nomen="collegiale" genus="veritas"/>
    <attributum nomen="status-tenentia" genus="electio">
      <optio>vacans</optio>
      <optio>occupatum</optio>
    </attributum>
    <attributum nomen="intra" genus="referentia"/>
    <attributum nomen="tenetur-a" genus="referentia"/>
    <attributum nomen="exercetur-a" genus="referentia"/>
    <attributum nomen="constituitur-per" genus="referentia"/>
    <attributum nomen="subest" genus="referentia"/>
    <liberum nomen="requisita"/>
    <liberum nomen="postulat"/>
    <liberum nomen="confert-capacitatem"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
    <liberum nomen="glossa"/>
  </elementum>
