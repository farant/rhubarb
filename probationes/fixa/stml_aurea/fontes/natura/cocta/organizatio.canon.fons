  <citatio nomen="universitas-personarum-pars-de" attributum="pars-de" ad="organizatio persona-iuridica universitas-personarum universitas-rerum corpus-normans societas magistratus/nomen" super="universitas-personarum"/>
  <citatio nomen="universitas-rerum-pars-de" attributum="pars-de" ad="organizatio persona-iuridica universitas-personarum universitas-rerum corpus-normans societas magistratus/nomen" super="universitas-rerum"/>
