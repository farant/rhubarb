  <elementum nomen="requisita" intra="praeses-collegii" textus="verum"/>
  <elementum nomen="postulat" intra="praeses-collegii">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="confert-capacitatem" intra="praeses-collegii">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="praeses-collegii">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="corpus-normans">
    <glossa lingua="en">A standards body: an organization whose proper
    end is to publish and keep standards - authoritative
    descriptions to which others conform. Its authority comes from
    consent, not from command.</glossa>
    <glossa lingua="fr">Un organisme de normalisation : une
    organisation dont la fin propre est d'éditer et de garder des
    normes - des descriptions faisant autorité auxquelles les
    autres se conforment. Son autorité vient du consentement, non
    du commandement.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="pars-de" genus="referentia"/>
    <attributum nomen="membrum" genus="referentia"/>
    <attributum nomen="condita" genus="dies"/>
    <attributum nomen="dissoluta" genus="dies"/>
    <attributum nomen="sedes" genus="textus"/>
    <attributum nomen="mutatio-membrorum" genus="electio">
      <optio>lenta</optio>
      <optio>velox</optio>
      <optio>nulla</optio>
    </attributum>
    <attributum nomen="unde-ordo" genus="electio">
      <optio>ab_intus</optio>
      <optio>ab_extra</optio>
    </attributum>
    <liberum nomen="edit"/>
    <liberum nomen="nomina"/>
    <liberum nomen="condita-a"/>
    <liberum nomen="administrat"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
    <liberum nomen="glossa"/>
  </elementum>
  <elementum nomen="edit" intra="corpus-normans">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="nomina" intra="corpus-normans" textus="verum"/>
  <elementum nomen="condita-a" intra="corpus-normans">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="administrat" intra="corpus-normans">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="corpus-normans">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="societas">
    <glossa lingua="en">A company: an organization whose proper end is
    gain through the works it sells, and which has owners to whom
    it answers.</glossa>
    <glossa lingua="fr">Une société : une organisation dont la fin
    propre est le gain par les ouvrages qu'elle vend, et qui a des
    propriétaires devant lesquels elle répond.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="pars-de" genus="referentia"/>
    <attributum nomen="membrum" genus="referentia"/>
    <attributum nomen="condita" genus="dies"/>
    <attributum nomen="dissoluta" genus="dies"/>
    <attributum nomen="sedes" genus="textus"/>
    <attributum nomen="mutatio-membrorum" genus="electio">
      <optio>lenta</optio>
      <optio>velox</optio>
      <optio>nulla</optio>
    </attributum>
    <attributum nomen="unde-ordo" genus="electio">
      <optio>ab_intus</optio>
      <optio>ab_extra</optio>
    </attributum>
    <liberum nomen="nomina"/>
    <liberum nomen="condita-a"/>
    <liberum nomen="administrat"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
    <liberum nomen="glossa"/>
  </elementum>
  <elementum nomen="nomina" intra="societas" textus="verum"/>
  <elementum nomen="condita-a" intra="societas">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="administrat" intra="societas">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="societas">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="magistratus">
    <glossa lingua="en">A public authority: an organization whose
    authority comes from COMMAND over a place, not from consent (as
    a standards body) nor from gain (as a company). It makes laws
    that bind everyone within its jurisdiction, whether they
    consent or not; coercive force is its difference.</glossa>
    <glossa lingua="fr">Une autorité publique : une organisation dont
    l'autorité vient du COMMANDEMENT sur un territoire, non du
    consentement (comme un organisme de normalisation) ni du gain
    (comme une société). Elle porte des lois qui lient tous ceux
    qui sont dans sa juridiction, qu'ils y consentent ou non ; la
    force coercitive est sa différence.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="pars-de" genus="referentia"/>
    <attributum nomen="membrum" genus="referentia"/>
    <attributum nomen="condita" genus="dies"/>
    <attributum nomen="dissoluta" genus="dies"/>
    <attributum nomen="sedes" genus="textus"/>
    <attributum nomen="mutatio-membrorum" genus="electio">
      <optio>lenta</optio>
      <optio>velox</optio>
      <optio>nulla</optio>
    </attributum>
    <attributum nomen="unde-ordo" genus="electio">
      <optio>ab_intus</optio>
      <optio>ab_extra</optio>
    </attributum>
    <liberum nomen="exercet"/>
    <liberum nomen="concedit"/>
    <liberum nomen="nomina"/>
    <liberum nomen="condita-a"/>
    <liberum nomen="administrat"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
    <liberum nomen="glossa"/>
  </elementum>
  <elementum nomen="exercet" intra="magistratus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="concedit" intra="magistratus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="nomina" intra="magistratus" textus="verum"/>
  <elementum nomen="condita-a" intra="magistratus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="administrat" intra="magistratus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="magistratus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="nota" textus="verum"
    nota="margo curatorialis individui - stratum
          documenti quod stratum generum iam habebat"/>

  <elementum nomen="glossa" textus="verum"
    nota="glossa vernacula individui - lingua ISO 639-1
          (en/fr/...); definitio Latine VERITAS manet,
          glossa explicat, numquam renominat">
    <attributum nomen="lingua" genus="nomen" necessarium="verum"/>
  </elementum>

  <elementum nomen="eventum" intra="historia" textus="verum">
    <attributum nomen="quando" genus="dies"/>
    <attributum nomen="actio" genus="electio">
      <optio>condi</optio>
      <optio>dissolvi</optio>
      <optio>dividi</optio>
      <optio>fundi</optio>
      <optio>edere</optio>
    </attributum>
    <attributum nomen="certitudo" genus="nomen"/>
    <attributum nomen="fons" genus="nomen"/>
    <attributum nomen="nota" genus="textus"/>
  </elementum>

  <unicitas nomen="identitas" attributum="nomen"
    nota="nomen= identitas est (par. 5.3): spatium nominum UNUM per genera omnia"
    super="universitas organizatio colonia colonia-apium grex persona-iuridica
           universitas-personarum universitas-rerum officium parochus episcopus
           notarius curator praeses-collegii corpus-normans societas magistratus"/>

  <!-- CITATIONES: relatio petitum resolutum ferens clavem documenti fit.
       Subsumptio COMPILATA est: petitum cum posteris omnibus in
       indicem ad= enumeratur, quia claves per titulum exactum
       colliguntur et subgenus titulum alium fert. Signa: '#'
       individuum inscriptum (clavis verbatim), '.' genus e
       vocabulario indicis. -->
