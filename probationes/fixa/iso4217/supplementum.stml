  <moneta codex="JEP" exponens="2" status="extra_iso" titulus="Jersey Pound"
          fons="https://www.gov.je/Leisure/Jersey/pages/profile.aspx (British pound sterling or Jersey currency of same value)"/>
</supplementum>
