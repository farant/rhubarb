          fons="https://web.archive.org/web/20221107144009/https://www.six-group.com/dam/download/financial-information/data-center/iso-currrency/lists/list-one.xml (Pblshd 2022-09-23)"/>
  <moneta codex="HRK" exponens="2" status="historica" titulus="Kuna"
          fons="https://web.archive.org/web/20221107144009/https://www.six-group.com/dam/download/financial-information/data-center/iso-currrency/lists/list-one.xml (Pblshd 2022-09-23)"/>
  <moneta codex="LTL" exponens="2" status="historica" titulus="Lithuanian Litas"
          fons="https://web.archive.org/web/20131001235407/http://www.currency-iso.org:80/dam/downloads/table_a1.xml (Pblshd 2013-04-09)"/>
  <moneta codex="LVL" exponens="2" status="historica" titulus="Latvian Lats"
          fons="https://web.archive.org/web/20131001235407/http://www.currency-iso.org:80/dam/downloads/table_a1.xml (Pblshd 2013-04-09)"/>
  <moneta codex="MRO" exponens="2" status="historica" titulus="Ouguiya"
          fons="https://web.archive.org/web/20170422215735/https://www.currency-iso.org/dam/downloads/lists/list_one.xml (Pblshd 2017-01-01)"/>
  <moneta codex="GGP" exponens="2" status="extra_iso" titulus="Guernsey Pound"
          fons="https://gov.gg/CHttpHandler.ashx?id=113527&amp;p=0 (States of Guernsey: banknotes and coins issued in its name, sterling at par)"/>
  <moneta codex="IMP" exponens="2" status="extra_iso" titulus="Isle of Man Pound"
