<aedilis>
  <inclusa>
    <via (>include
    <via (>probationes
    <via (>book_assets
    <via (>probationes/vitrea_assets
    <via (>probationes/tabella_assets
    <via (>vendor
    <via (>gesta/fontes
    <via (>silva/amalgama
    <via (>silva/instrumenta
    <via (>officina/fontes
    <via (>tessera/amalgama
    <via (>tessera/fontes
    <via (>saltuarius/fontes
  </inclusa>
  <vexilla>
    <vexillum! (>-std=c89
    <vexillum! (>-pedantic
    <vexillum! (>-Wall
    <vexillum! (>-Wextra
    <vexillum! (>-Werror
    <vexillum! (>-Wconversion
    <vexillum! (>-Wsign-conversion
    <vexillum! (>-Wcast-qual
    <vexillum! (>-Wstrict-prototypes
    <vexillum! (>-Wmissing-prototypes
    <vexillum! (>-Wwrite-strings
    <vexillum! (>-Wno-long-long
    <vexillum! (>-Wno-overlength-strings
    <vexillum! (>-fbracket-depth=512
  </vexilla>
  <variantes praelatio="macos posix"/>
  <nexus>
    <regula obiectum="fenestra_macos">
      <vexillum! (>-framework Cocoa
    </regula>
    <regula obiectum="tls_macos">
      <vexillum! (>-framework Security
      <vexillum! (>-framework CoreFoundation
    </regula>
    <regula obiectum="vitrea_macos">
      <vexillum! (>-framework WebKit
      <vexillum! (>-framework Cocoa
    </regula>
    <regula obiectum="clipboard_platform_macos">
      <vexillum! (>-framework Cocoa
    </regula>
  </nexus>
  <vendor>
    <fons via="vendor/sqlite3.c">
      <vexillum! (>-O2
      <vexillum! (>-DSQLITE_ENABLE_FTS5
      <vexillum! (>-DSQLITE_THREADSAFE=0
      <vexillum! (>-DSQLITE_DQS=0
      <vexillum! (>-DSQLITE_DEFAULT_MEMSTATUS=0
      <vexillum! (>-DSQLITE_OMIT_LOAD_EXTENSION
      <vexillum! (>-DSQLITE_OMIT_DEPRECATED
      <vexillum! (>-DSQLITE_DEFAULT_WAL_SYNCHRONOUS=1
    </fons>
  </vendor>
  <irregularia>
    <regula caput="include/fenestra.h">
      <obiectum (>lib/fenestra_macos.m
      <obiectum (>lib/fenestra_textus.c
    </regula>
    <regula caput="include/biblia.h">
      <obiectum (>lib/biblia_dr.c
    </regula>
    <regula caput="include/entitas_repositorium.h">
      <obiectum (>lib/entitas_repositorium_impl.c
    </regula>
    <regula caput="include/nuntium_schema.h">
      <obiectum (>lib/nuntium_schema.c
      <obiectum (>lib/nuntium_schema_generare.c
    </regula>
    <regula caput="include/arbor2_glr.h">
      <obiectum (>lib/arbor2_glr.c
      <obiectum (>lib/arbor2_glr_tabula.c
    </regula>
    <regula caput="include/persistentia.h">
      <obiectum (>lib/persistentia_memoria.c
      <obiectum (>lib/persistentia_nuntium.c
    </regula>
    <regula caput="include/calendarium_liturgicum.h">
      <obiectum (>lib/calendarium_liturgicum.c
      <obiectum (>lib/sanctorale.c
    </regula>
    <regula caput="include/lapifex_c89.h">
      <obiectum (>lib/lapifex_c89_grammatica.c
    </regula>
  </irregularia>
</aedilis>
