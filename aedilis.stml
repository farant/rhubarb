<aedilis>
  <inclusa>
    <via (>include
    <via (>materia/fontes
    <via (>toml/fontes
    <via (>probationes
    <via (>book_assets
    <via (>probationes/vitrea_assets
    <via (>probationes/tabella_assets
    <via (>apps/forum
    <via (>apps/forum/assets
    <via (>apps/villa
    <via (>apps/villa/assets
    <via (>apps/mensor
    <via (>apps/mensor/assets
    <via (>vendor
    <via (>gesta/fontes
    <via (>silva/amalgama
    <via (>silva/instrumenta
    <via (>officina/fontes
    <via (>tessera/amalgama
    <via (>tessera/fontes
    <via (>tessera/instrumenta/folium
    <via (>tessera/instrumenta/effigies
    <via (>tessera/instrumenta/musivum
    <via (>saltuarius/fontes
    <via (>briar/fontes
    <via (>md/fontes
    <via (>officina/instrumenta
    <via (>silva/fontes
    <via (>officina/amalgama
    <via (>css/fontes
    <via (>crusta/fontes
  </inclusa>
  <vexilla>
    <vexillum! (>-std=c89
    <vexillum! (>-pedantic
    <vexillum! (>-Wall
    <vexillum! (>-Wextra
    <vexillum! (>-Werror
    <vexillum! (>-Wconversion
    <vexillum! (>-Wsign-conversion
    <vexillum! (>-Wcast-qual
    <vexillum! (>-Wstrict-prototypes
    <vexillum! (>-Wmissing-prototypes
    <vexillum! (>-Wwrite-strings
    <vexillum! (>-Wno-long-long
    <vexillum! (>-Wno-overlength-strings
    <vexillum! (>-fbracket-depth=512
  </vexilla>
  <variantes praelatio="macos posix"/>
  <nexus>
    <regula obiectum="fenestra_macos">
      <vexillum! (>-framework Cocoa
    </regula>
    <regula obiectum="tls_macos">
      <vexillum! (>-framework Security
      <vexillum! (>-framework CoreFoundation
    </regula>
    <regula obiectum="vitrea_macos">
      <vexillum! (>-framework WebKit
      <vexillum! (>-framework Cocoa
    </regula>
    <regula obiectum="clipboard_platform_macos">
      <vexillum! (>-framework Cocoa
    </regula>
  </nexus>
  <vendor>
    <fons via="vendor/sqlite3.c">
      <vexillum! (>-O2
      <vexillum! (>-DSQLITE_ENABLE_FTS5
      <vexillum! (>-DSQLITE_THREADSAFE=0
      <vexillum! (>-DSQLITE_DQS=0
      <vexillum! (>-DSQLITE_DEFAULT_MEMSTATUS=0
      <vexillum! (>-DSQLITE_OMIT_LOAD_EXTENSION
      <vexillum! (>-DSQLITE_OMIT_DEPRECATED
      <vexillum! (>-DSQLITE_DEFAULT_WAL_SYNCHRONOUS=1
    </fons>
  </vendor>
  <!-- compilatio: vexilla per fontem nostrum, nomine obiecti lata
       (lib__sigillum__O2.o). sigillum -O2 (fabrica T8, mensuratum):
       XLVI MB II,8x celerius, iudicium celer II,65 s -> ~I,45 s. -->
  <compilatio>
    <fons via="lib/sigillum.c">
      <vexillum! (>-O2
    </fons>
  </compilatio>
  <!-- irregularia vacua: exceptiones caput->corpus nunc IN
       capitibus ipsis vivunt (annotatio "corpus", quae cum proba
       conventionis COMPONITUR). Regulae hic manent pro capitibus
       non nostris aut divisionibus per-variantem futuris. -->
  <irregularia>
  </irregularia>
</aedilis>
