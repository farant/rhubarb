<?xml version="1.0" encoding="UTF-8"?>
<!--
  natura/mensura.genera
  Exemplar semanticum: MENSURA (versio 1, PLASTICUM)
  Genera: quantitas, unitas_mensurae, magnitudo_mensurabilis.

  Natum ex experimento pistrinae: "500 grammata", "180 gradus",
  "25 minuta" - nihil in bibliotheca numerum CUM UNITATE ferebat.
  Proprietas genere "numerus" quantitatem nudam fert, quod
  mendacium est: numerus sine unitate quantitas non est.

  MATERIA LINNAEANA PURISSIMA post formas datorum: unitates
  individua recordi publici sunt, per normas definitae, cum
  historiis veris (kilogramma anno 2019 REDEFINITUM est -
  unitas quae historiam habet).

  DUBIUM PLANTAE HIC PARTIM SOLUTUM: proprietates viventium
  ambitus sunt (altitudo 2-5 m). Genus quantitas ambitum ferre
  potest (minimum/maximum) - sed an proprietas genere
  "quantitas" esse debeat, an ambitus proprietas CAMPI sit
  (vide schema), apertum manet.
-->
<natura modulus="mensura" versio="1" lingua="latina">

<!-- ==================================================
     MAGNITUDO MENSURABILIS - quod mensurari potest
     ================================================== -->

<.genus nomen="magnitudo_mensurabilis">

  <definitio>
    Id quod mensurari potest: longitudo, massa, tempus,
    temperatura. Praedicamentum quantitatis Aristotelicum -
    ante omnes unitates, quae eam solum PARTIUNTUR. Longitudo
    est etiamsi nemo metrum invenerit.
  </definitio>

  <glossa lingua="en">A measurable magnitude: that which can be
    measured - length, mass, time, temperature. The Aristotelian
    category of quantity, prior to all units, which merely PARTITION
    it: length is there even if no one had ever invented the
    metre.</glossa>
  <glossa lingua="fr">Une grandeur mesurable : ce qui peut être
    mesuré - longueur, masse, temps, température. Le prédicament
    aristotélicien de la quantité, antérieur à toutes les unités,
    lesquelles ne font que la PARTAGER : la longueur est là même si
    personne n'avait inventé le mètre.</glossa>

  <relationes>
    <relatio nomen="mensuratur_per" ad="unitas_mensurae"
      multiplex="verum"
      nota="unitates eiusdem magnitudinis inter se converti
            possunt (metrum/pes); trans magnitudines numquam -
            hic radix erroris dimensionum"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <.species nomen="longitudo"/>
  <.species nomen="massa"
    nota="a PONDERE distinguenda: pondus vis est, massa
          quantitas materiae - confusio vulgaris"/>
  <.species nomen="tempus_intervallum"/>
  <.species nomen="temperatura"/>
  <.species nomen="capacitas"
    nota="volumen liquidorum - pistrina utrumque adhibet"/>
  <.species nomen="numerositas"
    nota="res NUMERATAE, non mensuratae: duodecim ova. Discrimen
          reale inter numerabilia et mensurabilia (vide
          materia)"/>

</.genus>

<!-- ==================================================
     UNITAS MENSURAE - partitio conventa magnitudinis
     ================================================== -->

<.genus nomen="unitas_mensurae">

  <definitio>
    Partitio conventa magnitudinis mensurabilis, qua quantitates
    numerari possunt. CONVENTIO est, non natura - sed conventio
    normata, publice custodita, et ideo res de qua veritas dici
    potest.
  </definitio>

  <glossa lingua="en">A unit of measure: an agreed partition of a
    measurable magnitude, by which quantities can be counted. It is
    a CONVENTION and not a nature - but a standardized convention,
    publicly kept, and therefore a thing about which the truth can
    be told.</glossa>
  <glossa lingua="fr">Une unité de mesure : une partition convenue
    d'une grandeur mesurable, par laquelle les quantités peuvent
    être dénombrées. C'est une CONVENTION et non une nature - mais
    une convention normalisée, gardée publiquement, et donc une
    chose dont on peut dire le vrai.</glossa>

  <proprietates>
    <proprietas nomen="symbolum" genus="textus"
      nota="'g', 'kg', '°C' - abbreviatio normata"/>
    <proprietas nomen="fundamentalis" genus="veritas"
      ordinarius="falsum"
      nota="fundamentalis = per naturam definita (SI septem
            habet); ceterae ex his derivantur"/>
  </proprietates>

  <relationes>
    <relatio nomen="mensurat" ad="magnitudo_mensurabilis"/>
    <relatio nomen="normata_per" ad="norma" modulus="norma"/>
    <relatio nomen="custodita_a" ad="organizatio"
      modulus="organizatio"
      nota="unitates CUSTODEM habent - BIPM metrum, non opinio
            publica"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <individuum nomen="gramma">
    <valor nomen="symbolum">g</valor>
    <relatum nomen="mensurat" ad="massa"/>
    <nota>
      Millesima kilogrammatis - unitas fundamentalis SI
      kilogramma est, non gramma: praefixum in NOMINE unitatis
      fundamentalis, singularitas historica.
    </nota>
  </individuum>

  <individuum nomen="kilogramma">
    <valor nomen="symbolum">kg</valor>
    <valor nomen="fundamentalis">verum</valor>
    <relatum nomen="mensurat" ad="massa"/>
    <historia>
      <eventum quando="1889">prototypum ex platino-iridio in
        BIPM depositum - unitas quae RES erat</eventum>
      <eventum quando="2019-05-20">per constantem Planck
        redefinitum - unitas quae LEX facta est; artefactum
        physicum deposuit</eventum>
    </historia>
    <nota>
      Unitas cum historia vera: res fuit, deinde definitio -
      exemplum quod unitates entia historica sunt, non aeterna.
    </nota>
  </individuum>

  <individuum nomen="metrum">
    <valor nomen="symbolum">m</valor>
    <valor nomen="fundamentalis">verum</valor>
    <relatum nomen="mensurat" ad="longitudo"/>
    <historia>
      <eventum quando="1799">decima milionesima pars quadrantis
        meridiani - mensura ex terra ipsa sumpta</eventum>
      <eventum quando="1983">per celeritatem lucis definitum
        (1/299792458 secundi)</eventum>
    </historia>
  </individuum>

  <individuum nomen="secundum">
    <valor nomen="symbolum">s</valor>
    <valor nomen="fundamentalis">verum</valor>
    <relatum nomen="mensurat" ad="tempus_intervallum"/>
    <nota>
      Per transitionem caesii definitum (1967) - fundamentum
      omnium horologiorum, computatralium quoque.
    </nota>
  </individuum>

  <individuum nomen="minutum">
    <valor nomen="symbolum">min</valor>
    <relatum nomen="mensurat" ad="tempus_intervallum"/>
    <nota>
      Sexagesimale, non decimale: hereditas Babylonica quae
      metricationem supervixit - conventio antiquissima adhuc
      vivens.
    </nota>
  </individuum>

  <individuum nomen="gradus_celsius">
    <valor nomen="symbolum">°C</valor>
    <relatum nomen="mensurat" ad="temperatura"/>
    <nota>
      Scala cum ZERO CONVENTO (glacies liquescens), non
      absoluto: ideo differentiae additionem ferunt, valores
      ipsi multiplicationem NON ("bis calidior" nihil
      significat). Kelvin zerum absolutum habet - discrimen
      quod formam mensurae mordet.
    </nota>
  </individuum>

</.genus>

<!-- ==================================================
     QUANTITAS - numerus cum unitate
     ================================================== -->

<.genus nomen="quantitas">

  <definitio>
    Numerus CUM UNITATE: mensura rei determinata. Numerus solus
    quantitas non est - "500" nihil est donec "grammata" adsit.
    Additio solum inter eiusdem magnitudinis quantitates licet;
    quod trans magnitudines temptare error dimensionum est
    (Mars Climate Orbiter perditus 1999 - pondus in libris pro
    newtonis: quantitas sine unitate custodita).
  </definitio>

  <glossa lingua="en">A quantity: a number WITH A UNIT, the settled
    measure of a thing. A number by itself is no quantity - "500" is
    nothing until "grams" is present. Addition is permitted only
    between quantities of the same magnitude; attempting it across
    magnitudes is a dimensional error, as the Mars Climate Orbiter
    lost in 1999 showed, where pounds passed for newtons - a
    quantity whose unit went unguarded.</glossa>
  <glossa lingua="fr">Une quantité : un nombre AVEC UNE UNITÉ, la
    mesure déterminée d'une chose. Un nombre seul n'est pas une
    quantité - « 500 » n'est rien tant que « grammes » n'est pas là.
    L'addition n'est permise qu'entre quantités de même grandeur ;
    la tenter à travers des grandeurs est une erreur de dimensions,
    comme l'a montré la perte du Mars Climate Orbiter en 1999, où
    des livres ont été prises pour des newtons - une quantité dont
    l'unité n'était pas gardée.</glossa>

  <proprietates>
    <proprietas nomen="valor" genus="numerus" fractio="verum"/>
    <proprietas nomen="minimum" genus="numerus" fractio="verum"
      nota="AMBITUS (cum maximo): altitudo rosae 2-5 m,
            fornax 170-190 °C. Dubium plantae hic partim
            solutum - res verae saepe ambitum habent, non
            punctum"/>
    <proprietas nomen="maximum" genus="numerus" fractio="verum"/>
    <proprietas nomen="praecisio" genus="numerus" fractio="verum"
      nota="figurae significantes: '500 g' et '500.0 g' idem
            valorem, aliam praecisionem dicunt - mensura
            praecisionem suam FERT"/>
  </proprietates>

  <relationes>
    <relatio nomen="in_unitate" ad="unitas_mensurae"/>
    <relatio nomen="cum_incertitudine" ad="incertitudo"
      nota="quantum de valore vero ignoretur. NON IDEM QUOD
            minimum/maximum supra: illa AMBITUM rei dicunt (rosa
            vere inter duo et quinque metra crescit), haec
            ignorantiam nostram de valore uno. Doctrina
            metrologiae: quantitas sine incertitudine INCOMPLETA
            est, non modo imprecisa - quod bibliotheca nostra
            fere ubique adhuc peccat, et honeste notandum"/>
  </relationes>

</.genus>


<!-- ==================================================
     INCERTITUDO - mensura ignorantiae nostrae

     Cursu quinto decimo (officina calibrationis). Doctrina
     dominii (GUM): MENSURA SINE INCERTITUDINE SUA MENSURA NON
     EST - non imprecisa sed INCOMPLETA. Numerus solus quid
     scias non dicit.

     CAVE NE CUM AMBITU CONFUNDATUR (quantitas.minimum/maximum):
     ambitus dicit rem ipsam VARIARE - rosa vere inter duo et
     quinque metra crescit, et utrumque verum est. Incertitudo
     dicit rem valorem UNUM habere quem nos exacte non novimus.
     Illa in re est, haec in nobis. Qui eas confundit dispersionem
     naturae pro ignorantia sua sumit, aut contra.
     ================================================== -->

<.genus nomen="incertitudo">

  <definitio>
    Mensura eius quantum de valore vero ignoremus: intervallum
    circa valorem mensuratum intra quod valor verus, probabilitate
    stata, iacere creditur.
  </definitio>

  <differentia>
    DE NOBIS, NON DE RE. Ambitus proprietas rei est (arbores
    vere altitudine differunt); incertitudo proprietas
    COGNITIONIS nostrae de re una. Unde consequentia practica:
    ambitus mensuris melioribus NON minuitur, incertitudo
    minuitur - et si mensura melior ambitum minuit, ambitus non
    erat sed incertitudo male nominata.
  </differentia>

  <glossa lingua="en">An uncertainty: the measure of how much of the
    true value we do not know - the interval around the measured
    value within which the true value is believed to lie, at a
    stated probability. It is ABOUT US, not about the thing: a range
    says the thing itself varies, an uncertainty says the thing has
    one value that we do not know exactly.</glossa>
  <glossa lingua="fr">Une incertitude : la mesure de ce que nous
    ignorons de la valeur vraie - l'intervalle, autour de la valeur
    mesurée, dans lequel on croit que la valeur vraie se trouve,
    avec une probabilité déclarée. Elle porte SUR NOUS et non sur la
    chose : un intervalle dit que la chose elle-même varie, une
    incertitude dit que la chose a une seule valeur que nous ne
    connaissons pas exactement.</glossa>

  <proprietates>
    <proprietas nomen="magnitudo" genus="numerus"
      nota="quantum, in unitatibus rei mensuratae"/>
    <proprietas nomen="factor_tegumenti" genus="numerus"
      ordinarius="1"
      nota="quo multiplicata incertitudo normalis ampliatur (k).
            SINE HOC NUMERUS NIHIL DICIT: '±0,5' cum k=1 aliud
            est quam '±0,5' cum k=2, et alterum bis latius.
            Relationes quae factorem tacent inter se conferri
            NON possunt - error vulgatissimus"/>
    <proprietas nomen="fiducia_stata" genus="numerus"
      nota="quanta probabilitate valorem verum intra intervallum
            iacere dicamus (95%, 99%)"/>
    <proprietas nomen="genus_aestimationis" genus="electio"
      nota="unde aestimata sit. DIVISIO GUM, et honesta: typus A
            ex repetitionibus statistice computatur; typus B ex
            aliis fontibus AESTIMATUR (attestatio instrumenti,
            iudicium periti, forma distributionis assumpta).
            Typus B iudicium est, non computatio - et plerumque
            MAIOR pars summae, quod pauci fatentur">
      <optio>typus_a</optio>
      <optio>typus_b</optio>
    </proprietas>
  </proprietates>

  <relationes>
    <relatio nomen="de_quantitate" ad="quantitas"/>
    <relatio nomen="componitur_ex" ad="incertitudo"
      multiplex="verum"
      nota="RATIO INCERTITUDINIS (uncertainty budget): incertitudo
            composita ex partibus surgit - incertitudo
            exemplaris, repetibilitas, resolutio, effectus
            temperaturae - quae in quadratum coniunguntur, non
            simpliciter additae. Unde pars maxima ceteras
            OBRUIT: si una pars decuplo maior est, reliquas
            minuere nihil paene valet. Ideo ratio scribitur et
            recensetur: ut appareat QUAE pars pretium ferat"/>
    <relatio nomen="asseritur_per" ad="iudicium" modulus="iudicium"
      nota="typus B praesertim: quis aestimavit, quo fundamento,
            quanto assensu"/>
  </relationes>

  <nota>
    QUOD DOCTRINA HAEC ALIBI VALET: nulla mensura in bibliotheca
    nostra incertitudinem suam fert - dies natales personarum,
    altitudines plantarum, tempora rerum gestarum. Mechanismus
    fidei (certitudo, fons) gradum assensus DE PROPOSITIONE dicit;
    hoc genus quantitatem erroris DE NUMERO dicit. Duo strata,
    et alterum alterum non substituit: 'natus 1225, certitudine
    opinionis' et '1225 ± 2 anni' res diversas dicunt, et
    historia utraque utitur.
  </nota>

</.genus>

<!-- ==================================================
     INSTRUMENTUM MENSURAE - quod characterizat, non mutat
     ================================================== -->

<.genus nomen="instrumentum_mensurae" sub="instrumentum"
  modulus="corporalia">

  <differentia>
    Instrumentum quod rem suam NON MUTAT sed characterizat:
    fornax panem coquit, statera panem relinquit qualis erat.
    Et solum inter instrumenta IPSUM MENSURATUR - calibratio
    est mensura mensoris, unde catena quae alibi non exsistit.
  </differentia>

  <glossa lingua="en">A measuring instrument: a tool that does NOT
    change its thing but characterizes it - an oven bakes the bread,
    a balance leaves the bread as it was. And it is the only tool
    that is ITSELF measured: calibration is the measure of the
    measurer, which gives it a chain that exists nowhere
    else.</glossa>
  <glossa lingua="fr">Un instrument de mesure : un instrument qui ne
    MODIFIE PAS sa chose mais la caractérise - le four cuit le pain,
    la balance laisse le pain tel qu'il était. Et c'est le seul
    instrument qui soit LUI-MÊME mesuré : l'étalonnage est la mesure
    du mesureur, d'où une chaîne qui n'existe nulle part
    ailleurs.</glossa>

  <proprietates>
    <proprietas nomen="error_systematicus" genus="numerus"
      nota="quantum constanter aberret (bias). PROPRIETAS
            PERICULOSISSIMA quia REPETITIO EAM NUMQUAM PRODIT:
            instrumentum quod bis centies idem falsum reddit
            constantissimum videtur. Sola collatio cum meliore
            eam ostendit - unde calibratio necessaria est et
            diligentia non sufficit"/>
    <proprietas nomen="dispersio" genus="numerus"
      nota="quantum inter se differant mensurae eiusdem rei
            repetitae (repetibilitas). DISTINCTA AB ERRORE
            SYSTEMATICO: instrumentum exactissime repetens et
            constanter falsum esse potest - 'praecisum et
            pravum', quod sermo vulgaris in unam 'accurationem'
            confundit"/>
    <proprietas nomen="resolutio" genus="numerus"
      nota="minima differentia quam ostendere potest. Distincta
            ab utraque supra: instrumentum resolutionis magnae
            errorem magnum habere potest - digiti multi
            veritatem non praestant"/>
    <proprietas nomen="intervallum_calibrationis" genus="quantitas"
      nota="post quantum tempus fides eius cessat. Non ex vitio
            sed ex DERIVA praesumpta - vide licentia.
            recentia_postulata (obligatio): eadem forma, subiecto
            alio. Ibi peritia hominis desuetudine decrescit, hic
            accuratio instrumenti usu et tempore"/>
  </proprietates>

  <machina_statuum nomen="fides" gerens="individuum">
    <status nomen="calibratum"/>
    <status nomen="in_usu"/>
    <status nomen="expiratum"
      nota="intervallo lapso: non pravum probatum sed non amplius
            probatum. Distinctio quam usus cotidianus perdit"/>
    <status nomen="extra_tolerantiam"
      nota="collatione pravum INVENTUM. Status qui retro agit -
            vide notam infra"/>
    <transitus a="calibratum" ad="in_usu" per="usus"/>
    <transitus a="in_usu" ad="expiratum" per="lapsus_intervalli"/>
    <transitus a="expiratum" ad="calibratum" per="calibratio"/>
    <transitus a="expiratum" ad="extra_tolerantiam"
      per="inventio_erroris"/>
    <transitus a="extra_tolerantiam" ad="calibratum"
      per="emendatio"/>
  </machina_statuum>

  <relationes>
    <relatio nomen="calibratum_contra" ad="instrumentum_mensurae"
      nota="CATENA TRACTUS (traceability): quodque instrumentum
            contra melius calibratur, illud contra melius, usque
            ad exemplar nationale et definitionem SI. Catena
            attestationum quae in RADICE FIDUCIAE desinit (vide
            acta.radix_fiduciae) - et quaeque anulus
            incertitudinem propriam addit, unde catena longa
            incertitudinem auget quantumvis exacta singula sint"/>
    <relatio nomen="attestatur_per" ad="attestatio" modulus="acta"
      nota="attestatio calibrationis: 'expirat' et 'fundamentum'
            eius (quae PKI addere coegit) hic prorsus conveniunt -
            dies proximae calibrationis ab EMITTENTE statutus, et
            contra quod exemplar quaque incertitudine collatum
            sit"/>
  </relationes>

  <nota>
    EXTRA TOLERANTIAM INVENTUM RETRO AGIT, et hoc est cur
    calibratio pretiosa sit: si instrumentum hodie pravum
    invenitur, OMNIA quae ab ultima calibratione bona mensuravit
    suspecta fiunt. Est depravatio (fabricatio) cum fenestra
    (inter calibrationes), ambitu (quae mensurata sint), et
    propagatione (an effectus in res emissas ierint) - genus
    rotae LIII pro rationibus corruptis in systemate solutionum
    scriptum, quod hic officinae mechanicae sine ullo verbo
    mutato convenit.
  </nota>

</.genus>

</natura>
