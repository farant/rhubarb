<!--
  natura/exempla/hortus.census

  Documentum verum sub monolitho (extensio .census -> individua.canon,
  registrum). Non fixum probationis solum: TESTIMONIUM catenae -
  genus semel descriptum tria parit, bibliothecam tagorum,
  schema, structuram C.

  SIGNA (spec canon-referentia): '#' nomen proprium individui -
  in declaratione ET in referentia, congruentia verbatim; '.'
  genus e vocabulario; valor nudus litteralis est.

  INSCRIPTIO (spec census): census sodales suos sedet - linea una
  <persona nomen="#carl_linnaeus"/> Linnaeum praesentat, et
  auctor-nominis="#carl_linnaeus" RESOLVITUR. (Sub extensione
  .planta retirata haec referentia trans modulos inresolubilis
  erat - verruca classis D, mortua cum extensione.)

  Quae absunt PROBANT: habitus et altitudo-matura tacent, ergo
  ordinarius= (ex <valor> naturae per catenam vectus) apparere
  debet - et diversus per genus (frutex rosae, arbor mali).
-->
<individua>
  <persona nomen="#carl_linnaeus"/>

  <rosa-canina nomen="#rosa-ad-murum"
               status-vita="florens"
               auctor-nominis="#carl_linnaeus">
    <radix nota="muro proxima"/>
    <historia>
      <eventum quando="2024-04" actio="nominari"/>
    </historia>
  </rosa-canina>

  <granny-smith nomen="#malus-prima" altitudo-matura="4"/>
</individua>
