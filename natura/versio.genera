<?xml version="1.0" encoding="UTF-8"?>
<!--
  natura/versio.genera
  Exemplar semanticum: VERSIO (versio 0, PLASTICUM)

  ABSENTIA STRUCTURALIS TERTIA, eodem signo inventa quo programma
  (cursus V) et acta (rota XLIV): formae speciales exstabant,
  forma generalis numquam nominata. Hic signum FORTISSIMUM fuit,
  quia species non una sed QUATTUOR erant, et quaeque apparatum
  eundem sibi rursus excogitaverat:

    versio_linguae        titulus, edita, versio_de, sequitur
    versio_systematis     titulus, edita, versio_de, sequitur
    versio_architecturae  titulus, edita, versio_de, sequitur
    versio_praescripti                    versio_de, sequitur

  Quater idem, nullo parente. Et collatio DEFECTUM statim
  ostendit quem nemo per se videre poterat: versio_praescripti
  titulo caret, cum definitio eius 'nominata et CITABILIS'
  dicat - res quae se citabilem profitetur et campum nominis non
  habet. Duplicatio non modo sumptuosa est sed INAEQUALIS, et
  inaequalitas latet donec formae iuxta ponantur.

  QUOD OMNES QUATTUOR OMISERUNT est id in quo tota vis versionis
  consistit: COMPATIBILITAS. Nulla earum rogat an nova cum
  vetere stare possit - quae sola interrogatio est propter quam
  homines versiones omnino numerant.
-->
<natura modulus="versio" versio="0" lingua="latina">

<fontes>
  <fons clavis="corpus" genus="corpus_institutionis"
    modulus="iudicium" verificatus="falsum">
    Corpus institutionis scribae: dies et res gestae ex textibus
    innumeris haustae. NON VERIFICATUM.
  </fons>
</fontes>

<genus nomen="versio">

  <definitio>
    Editio rei nominata et citabilis, quae rem ipsam per
    mutationem manentem SIGNAT: res una est, versiones multae,
    et versio non alia res sed eadem res ut tunc se habuit.
  </definitio>

  <differentia>
    Quaestio identitatis hic sedet et raro ponitur: QUID FACIT
    UT VERSIO SECUNDA EADEM RES SIT AC PRIMA? Non contentum -
    illud mutatum est, ideo enim versio nova est. Sed
    continuatio AUCTORITATIS NOMINANTIS et FINIS: idem qui rem
    tenet eam pergere declarat ad eundem finem. Ubi alterum
    deficit, versio nova non est sed res alia (unde furcae, quae
    versiones non sunt sed nativitates).
  </differentia>

  <glossa lingua="en">A version: a named and citable edition of a
    thing, which marks that thing itself across enduring change -
    there is one thing and many versions, and a version is not
    another thing but the same thing as it stood at that time. What
    makes the second version the same thing as the first is not the
    content, which has changed (that is precisely why there is a new
    version), but the continuity of the naming authority and of the
    purpose. Where either of these fails, what you have is not a new
    version but a different thing - hence forks, which are not
    versions but births.</glossa>
  <glossa lingua="fr">Une version : une édition nommée et citable
    d'une chose, qui marque cette chose même à travers un changement
    qui dure - il y a une seule chose et plusieurs versions, et une
    version n'est pas une autre chose mais la même chose telle
    qu'elle était alors. Ce qui fait que la seconde version est la
    même chose que la première n'est pas le contenu, qui a changé
    (c'est bien pour cela qu'il y a une version nouvelle), mais la
    continuité de l'autorité qui nomme et celle de la fin
    poursuivie. Là où l'une des deux manque, ce n'est plus une
    version nouvelle mais une autre chose - d'où les fourches, qui
    ne sont pas des versions mais des naissances.</glossa>

  <proprietates>
    <proprietas nomen="titulus" genus="textus"
      nota="designatio qua citatur - '3.1.4', 'C89', 'Sonoma'.
            NECESSARIA: versio innominata citari non potest, et
            citabilitas ratio essendi eius est. Quod
            versio_praescripti omittebat"/>
    <proprietas nomen="edita" genus="dies"/>
    <proprietas nomen="schema_numerandi" genus="electio"
      nota="QUOMODO tituli ordinentur, et quantum promittant.
            DISCRIMEN GRAVISSIMUM: schema semanticum
            COMPATIBILITATEM ASSERIT (numerus maior mutatus =
            fractio promissa), temporale et nominale NIHIL
            promittunt. Unde paradoxum practicum - schemata quae
            nihil promittunt numquam falluntur, semanticum saepe
            frangitur QUIA aliquid dicit. Qui '2024.03' videt
            nihil de compatibilitate coniectat; qui '2.0' videt
            multa, et interdum falso">
      <optio>semanticum</optio>
      <optio>sequentiale</optio>
      <optio>temporale</optio>
      <optio>nominale</optio>
      <optio>mixtum</optio>
    </proprietas>
    <proprietas nomen="retro_compatibilis" genus="veritas"
      nota="an quod priori versioni scriptum est huic quoque
            serviat. NON FACTUM SED ASSERTIO: editor promittit,
            et promissum frangi potest - vide relationem
            asseritur_per. Qui hoc ut factum tractat mutationem
            fractoriam non inveniet donec utentes clament"/>
    <proprietas nomen="mutationes_fractoriae" genus="textus"
      nota="QUID praecise fractum sit. Campus quem omnes
            desiderant et pauci implent: 'mutationes fractorias
            continet' nihil valet sine enumeratione, quia
            consumptor scire debet an SUUM usum tangant"/>
  </proprietates>

  <machina_statuum nomen="sustentatio" gerens="individuum">
    <status nomen="praenuntiata"
      nota="edita ut probetur, non ut adhibeatur - promissa
            stabilitatis nulla"/>
    <status nomen="vigens" nota="commendata"/>
    <status nomen="sustentata"
      nota="non amplius commendata, adhuc emendata (saepe
            securitatis solum). STATUS QUEM SCHEMATA BINARIA
            PERDUNT et quo omnis consilium migrandi nititur:
            inter 'utere' et 'noli uti' spatium longum iacet, et
            in eo pleraeque res vivunt"/>
    <status nomen="deprecata"
      nota="ACTUS LOQUENDI, non factum: editor migrandum esse
            DECLARAT dum adhuc operatur. Idem discrimen quod
            functio.deprecata (declaratum) contra mortuam
            (inventum) fert"/>
    <status nomen="derelicta"
      nota="nulla emendatio amplius, ne securitatis quidem -
            quod eam adhibet periculum SUUM suscipit"/>
    <transitus a="praenuntiata" ad="vigens" per="editio"/>
    <transitus a="vigens" ad="sustentata" per="successio"
      nota="versione nova edita, vetus huc labitur - transitus
            quem SUCCESSOR movet, non ipsa"/>
    <transitus a="sustentata" ad="deprecata" per="deprecatio"/>
    <transitus a="deprecata" ad="derelicta" per="derelictio"/>
    <transitus a="sustentata" ad="derelicta" per="derelictio"/>
  </machina_statuum>

  <actiones>
    <actio nomen="edi"/>
    <actio nomen="deprecari"/>
    <actio nomen="derelinqui"/>
  </actiones>

  <relationes>
    <relatio nomen="versio_de" ad="*"
      nota="res cuius haec versio est - apertum consulto, quia
            quidlibet versiones habere potest. SUB-GENERA HANC
            ANGUSTANT (versio_linguae ad linguam solam), quod
            NARRATIO PRIMA huius formae est: relatio hereditata
            in specie arctius definita. Utraque manet - parens
            quid sit dicit, filia quid hic liceat"/>
    <relatio nomen="sequitur" ad="versio"
      nota="versio proxime prior in eadem serie"/>
    <relatio nomen="compatibilis_cum" ad="versio" multiplex="verum"
      nota="RELATIO PROPTER QUAM VERSIONES NUMERANTUR, et quam
            quattuor formae speciales omnes omiserunt.
            Compatibilitas non semper cum PROXIMA sola agitur:
            res quae versiones plures simul sustentat (bases
            datorum, protocolla) reticulum compatibilitatis
            habet, non catenam"/>
    <relatio nomen="asseritur_per" ad="iudicium" modulus="iudicium"
      nota="COMPATIBILITAS PER IUDICIUM ASSERITUR: editor dicit,
            cum auctore et gradu assensus, et falli potest.
            'Versio 2.1 retro compatibilis' propositio est quam
            probatio refellere potest - quod cotidie fit"/>
    <relatio nomen="edita_a" ad="organizatio" modulus="organizatio"
      nota="auctoritas nominans, cuius CONTINUITAS identitatem
            rei per versiones servat (vide differentiam)"/>
  </relationes>

  <nota>
    QUOD HOC GENUS NON EST: editio operis scripti
    (opus_scriptum.editio). Illa MANIFESTATIO est - opus idem
    aliis signis aut alia charta prolatum, sine ulla
    successionis promissione. Versio successionem ET
    substitutionem implicat: nova venit ut vetus cedat. Editio
    Londinensis editionem Novi Eboraci non substituit; versio
    2.0 versionem 1.0 substituit. Ideo hic sustentatio et
    deprecatio, ibi nihil tale.
  </nota>

  <dubium>
    FURCA (fork) versio non est - continuatio auctoritatis
    deficit, unde res nova. Sed casus medii sunt: quid de furca
    quae nomen retinet et auctoritatem novam habet
    (LibreOffice), aut de auctoritate quae mutatur re manente
    (Oracle Javam accipiens)? Differentia nostra duo poscit
    (auctoritas ET finis); an alterum sufficiat non decisum.
    Casus cogens unus adhuc.
  </dubium>

</genus>

</natura>
