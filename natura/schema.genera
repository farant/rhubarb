<?xml version="1.0" encoding="UTF-8"?>
<!--
  natura/schema.genera
  Exemplar semanticum: SCHEMA (versio 0, PLASTICUM)
  Genera: schema, campus, genus_valoris.

  SUI DESCRIPTIO: exemplar hoc ossa bibliothecae ipsius
  describit - proprietates naturae CAMPI sunt, paletta generum
  (textus/dies/numerus/veritas/electio/relatio) dictionarium
  generis_valoris est, attributum genus= in proprietate hoc
  ipsum genus refert. Naturalista non solum paroeciam sed
  sceletum suum describit.

  DISCIPLINA BIFIDA (inventum domus): schema aut CONSTRINGIT
  (quod non congruit reicitur - via basium datorum) aut
  IUDICAT (accipitur et notatur - via fori nostri: "definitio
  iudicat, non constringit"). Iudicans veritatem numquam
  amittit; constringens eam ante portam vertit.
-->
<natura modulus="schema" versio="0" lingua="latina">

<!-- ==================================================
     SCHEMA - forma datorum declarata
     ================================================== -->

<.genus nomen="schema">

  <definitio>
    Forma datorum declarata: figura quam res eiusdem generis
    implere debent - campi nominati, genera valorum,
    necessitates. Promissum de datis FUTURIS: schema hodie
    scribitur, res cras adveniunt.
  </definitio>

  <glossa lingua="en">A schema: a declared form for data - the
    shape that things of the same kind must fill out: named
    fields, kinds of value, requirements. It is a promise about
    FUTURE data: the schema is written today, the things arrive
    tomorrow.</glossa>
  <glossa lingua="fr">Un schéma : une forme de données déclarée
    - la figure que doivent remplir les choses d'un même genre :
    champs nommés, genres de valeurs, obligations. C'est une
    promesse portant sur les données À VENIR : le schéma s'écrit
    aujourd'hui, les choses arrivent demain.</glossa>

  <proprietates>
    <proprietas nomen="disciplina" genus="electio"
      nota="constringens: non congruens REICITUR (basis
            datorum); iudicans: accipitur et NOTATUR (forum
            domus). Electio gravissima schematis - quid facit
            cum veritas formae non paret">
      <optio>constringens</optio>
      <optio>iudicans</optio>
    </proprietas>
  </proprietates>

  <relationes>
    <relatio nomen="continet" ad="campus" multiplex="verum"/>
    <relatio nomen="describit" ad="*"
      nota="genus rerum quas format - schema de aliquo est"/>
  </relationes>

</.genus>

<!-- ==================================================
     CAMPUS - atomus formae
     ================================================== -->

<.genus nomen="campus">

  <definitio>
    Locus nominatus in schemate: nomen, genus valoris,
    necessitas. Atomus formae - schema ex campis constat ut
    sententia ex verbis.
  </definitio>

  <glossa lingua="en">A field: a named place in a schema - a
    name, a kind of value, a requirement. It is the atom of the
    form: a schema is made of fields as a sentence is made of
    words.</glossa>
  <glossa lingua="fr">Un champ : un emplacement nommé dans un
    schéma - un nom, un genre de valeur, une obligation. C'est
    l'atome de la forme : un schéma est fait de champs comme une
    phrase est faite de mots.</glossa>

  <proprietates>
    <proprietas nomen="necessarius" genus="veritas"
      ordinarius="falsum"/>
    <proprietas nomen="multiplex" genus="veritas"
      ordinarius="falsum"
      nota="valores plures sub nomine uno - nomina personae
            testis in bibliotheca ipsa"/>
    <proprietas nomen="ordinarius_valor" genus="textus"
      nota="valor praesumptus absente dato - nomen ipsum e
            metamodulo nostro (ordinarius=)"/>
  </proprietates>

  <relationes>
    <relatio nomen="campus_de" a="schema" inversa="verum"
      nota="impletur a schema.continet"/>
    <relatio nomen="genus_eius" ad="genus_valoris"/>
  </relationes>

</.genus>

<!-- ==================================================
     GENUS VALORIS - intentio valoris, non repraesentatio
     ================================================== -->

<.genus nomen="genus_valoris">

  <definitio>
    Genus valoris quod campus tenere potest: INTENTIO valoris,
    non repraesentatio machinae - s32 et char* realizationes
    sunt (typus linguae materiam praebet, genus valoris
    formam). Dies dies manet, sive chorda sive numerus sub ea
    iacet.
  </definitio>

  <glossa lingua="en">A kind of value: the kind of value a field
    can hold - the INTENT of the value, not its machine
    representation; s32 and char* are realizations (the language
    type supplies the matter, the kind of value the form). A date
    stays a date, whether a string or a number lies under
    it.</glossa>
  <glossa lingua="fr">Un genre de valeur : le genre de valeur
    qu'un champ peut contenir - l'INTENTION de la valeur, non sa
    représentation machine ; s32 et char* en sont des
    réalisations (le type du langage fournit la matière, le genre
    de valeur la forme). Une date reste une date, qu'une chaîne
    ou un nombre se trouve dessous.</glossa>

  <dubium>
    Paletta domus etiam "area" (textus amplus) et "annus"
    (dies grossior) habet: species propriae, an textus cum
    praesentatione et dies cum granularitate? Praesentatio et
    praecisio fortasse proprietates CAMPI sunt, non genera
    valoris. Apertum - realitas fori iudicabit.
  </dubium>

  <!-- ================= DICTIONARIUM =================
       paletta ipsa: dictionarium harvestum e metamodulo -->

  <.species nomen="textus">
    <definitio>Series characterum libera: nomen, titulus,
      prosa.</definitio>
  </.species>

  <.species nomen="numerus">
    <definitio>Quantitas: comparari, ordinari, computari
      potest.</definitio>
  </.species>

  <.species nomen="dies">
    <definitio>Punctum in tempore civili: ordinandum,
      intervallis mensurandum.</definitio>
  </.species>

  <.species nomen="veritas">
    <definitio>Duorum alterum: est aut non est.</definitio>
  </.species>

  <.species nomen="electio">
    <definitio>
      Valor e copia clausa optionum: quod optiones declaratae
      sunt, forma valores novos non timet.
    </definitio>
  </.species>

  <.species nomen="citatio">
    <definitio>
      Valor qui RES ALIA est: campus rem citat, non describit
      (in paletta domus "relatio" dictum). Clavis externa
      basium, nexus voluminum - unde interoperabilitas: res
      duae eandem rem citantes de eadem re loquuntur.
    </definitio>
  </.species>

</.genus>

</natura>
