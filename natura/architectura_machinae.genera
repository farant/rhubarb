<?xml version="1.0" encoding="UTF-8"?>
<!--
  natura/architectura_machinae.genera
  Exemplar semanticum: ARCHITECTURA MACHINAE (versio 2, PLASTICUM)

  Distinctio eadem ac lingua/implementatio, gradu ferri:
  architectura FORMA est (copia instructionum quam programma
  alloquitur); processorium exemplar producti quod eam
  exsequitur (v0->v1: umbra 'chip' impleta et renominata -
  vide genus infra).

  EXEMPLUM TERTIUM LEGIS LABENTIS: latitudo verbi non
  architecturae familiae sed VERSIONI pertinet (x86 per 16/32/64
  transiit) - proprietates ad subiectum verum labuntur, sicut
  "compilata" ad implementationem lapsa est.
-->
<natura modulus="architectura_machinae" versio="2" lingua="latina">

<fontes>
  <fons clavis="corpus" genus="corpus_institutionis"
    modulus="iudicium" verificatus="falsum">
    Corpus institutionis scribae: dies et res gestae ex textibus
    innumeris haustae. NON VERIFICATUM.
  </fons>
</fontes>

<genus nomen="architectura_machinae">

  <definitio>
    Forma abstracta machinae computatoriae quam programmata
    alloquuntur: copia instructionum, registra, modellum
    memoriae. Foedus inter compilatorem et ferrum - multa
    exsecutoria (chips), architectura una; per versiones
    crescit identitate manente.
  </definitio>

  <glossa lingua="en">A machine architecture: the abstract form
    of a computing machine that programs address - instruction
    set, registers, memory model. It is the covenant between
    compiler and hardware: many chips execute it, the
    architecture is one; it grows through versions while its
    identity remains.</glossa>
  <glossa lingua="fr">Une architecture machine : la forme
    abstraite d'une machine de calcul à laquelle les programmes
    s'adressent - jeu d'instructions, registres, modèle de
    mémoire. C'est le pacte entre le compilateur et le matériel :
    de nombreuses puces l'exécutent, l'architecture est une ;
    elle croît par versions tout en gardant son identité.</glossa>

  <proprietates>
    <proprietas nomen="indoles_copiae" genus="electio">
      <optio>cisc</optio>
      <optio>risc</optio>
      <optio>mixta</optio>
    </proprietas>
    <proprietas nomen="licentia_aperta" genus="veritas"
      ordinarius="falsum"
      nota="riscv verum - differentia eius historica"/>
  </proprietates>

  <actiones>
    <actio nomen="ortus"/>
    <actio nomen="edi" nota="versio nova - vide genus
      versio_architecturae"/>
  </actiones>

  <relationes>
    <relatio nomen="auctor" ad="organizatio"
      modulus="organizatio" multiplex="verum"
      nota="architecturae a societatibus/consortiis nascuntur,
            raro a personis solis"/>
    <relatio nomen="habet_versionem" ad="versio_architecturae"/>
    <relatio nomen="exsecuta_a" ad="processorium"
      nota="umbra 'chip' rota XLV impleta - et renominata:
            processorium exemplar PRODUCTI est (8086, M1), non
            assula singula physica. Vide differentiam eius"/>
    <relatio nomen="emissa_pro" a="implementatio_linguae"
      modulus="lingua_programmandi" inversa="verum"
      nota="compilatores pro architecturis emittunt"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <individuum nomen="x86">
    <definitio>
      Familia CISC ab Intel 8086 orta: instructiones longitudinis
      variae, compatibilitas retrorsum quasi-religiosa - onus et
      arx eius.
    </definitio>
    <differentia>
      Compatibilitas retrorsum supra puritatem: stratum super
      stratum, nihil umquam abiectum.
    </differentia>
    <valor nomen="indoles_copiae">cisc</valor>
    <relatum nomen="auctor" ad="intel" modulus="organizatio"/>
    <historia>
      <eventum quando="1978-06-08" actio="ortus">8086</eventum>
    </historia>
  </individuum>

  <individuum nomen="arm">
    <definitio>
      Familia RISC efficientiae dedita: instructiones fixae,
      registra ampla; a machinis manualibus ad servos ascendit.
    </definitio>
    <differentia>
      Efficientia energiae ut principium formans, non additum.
    </differentia>
    <valor nomen="indoles_copiae">risc</valor>
    <relatum nomen="auctor" ad="arm_ltd" modulus="organizatio"/>
    <historia>
      <eventum quando="1985-04-26" actio="ortus">ARM1 (apud
        Acorn)</eventum>
    </historia>
  </individuum>

  <individuum nomen="riscv">
    <definitio>
      Copia instructionum RISC aperta: forma sine domino unico,
      per consortium custodita; modularis (fundamentum +
      extensiones nominatae).
    </definitio>
    <differentia>
      Licentia aperta ut essentia, non accidens: quivis
      exsequitur sine venia.
    </differentia>
    <valor nomen="indoles_copiae">risc</valor>
    <valor nomen="licentia_aperta">verum</valor>
    <historia>
      <eventum quando="2010" actio="ortus">apud Berkeley</eventum>
    </historia>
  </individuum>

</genus>

<!-- ==================================================
     VERSIO ARCHITECTURAE - eadem solutio ac versio_linguae:
     editio in rem citabilem crystallizata. Latitudo verbi
     HIC vivit, non in familia.
     ================================================== -->

<genus nomen="versio_architecturae" sub="versio" modulus="versio">

  <definitio>
    Editio architecturae nominata: quam copiam instructionum
    chip vere exsequitur et compilator vere alloquitur -
    "aedifica pro x86_64" versionem citat, non familiam.
  </definitio>

  <glossa lingua="en">An architecture version: a named edition
    of an architecture - which instruction set a chip really
    executes and a compiler really addresses. To say build for
    x86_64 is to cite a version, not a family.</glossa>
  <glossa lingua="fr">Une version d'architecture : une édition
    nommée d'une architecture - le jeu d'instructions qu'une puce
    exécute réellement et auquel un compilateur s'adresse
    réellement. Dire compiler pour x86_64, c'est citer une
    version, non une famille.</glossa>

  <proprietates>
    <proprietas nomen="titulus" genus="textus"/>
    <proprietas nomen="latitudo_verbi" genus="numerus"
      nota="bits; VERSIONI pertinet - x86 per 16/32/64
            transiit"/>
    <proprietas nomen="edita" genus="dies"/>
  </proprietates>

  <relationes>
    <relatio nomen="versio_de" ad="architectura_machinae"/>
    <relatio nomen="sequitur" ad="versio_architecturae"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <individuum nomen="i386">
    <valor nomen="titulus">i386 (IA-32)</valor>
    <valor nomen="latitudo_verbi">32</valor>
    <valor nomen="edita">1985-10</valor>
    <relatum nomen="versio_de" ad="x86"/>
  </individuum>

  <individuum nomen="x86_64">
    <valor nomen="titulus">x86-64 (AMD64)</valor>
    <valor nomen="latitudo_verbi">64</valor>
    <valor nomen="edita">2003-04-22</valor>
    <relatum nomen="versio_de" ad="x86"/>
    <relatum nomen="sequitur" ad="i386"/>
    <nota>
      Extensio 64-bit ab AMD, non ab Intel, edita - auctor
      versionis auctori familiae non idem: historia vera
      schemate simplici non caperetur.
    </nota>
  </individuum>

  <individuum nomen="armv8">
    <valor nomen="titulus">ARMv8-A (AArch64)</valor>
    <valor nomen="latitudo_verbi">64</valor>
    <valor nomen="edita">2011-10-27</valor>
    <relatum nomen="versio_de" ad="arm"/>
    <nota>machinae nostrae (Apple Silicon) hanc exsequuntur</nota>
  </individuum>

</genus>

<!-- ==================================================
     PROCESSORIUM - exemplar producti quod architecturam
     exsequitur

     Umbra 'chip' impleta ET RENOMINATA, quia 'chip' duas res
     tegebat: exemplar productum (Intel 8086 - res una, milia
     milium assularum) et assulam physicam singulam (haec in
     manu, cum vitiis suis). Individua quae citare volumus
     EXEMPLARIA sunt - praecedens :x86 ipsum: architectura forma
     est, individua eius formae nominatae, nemo assulam suam.
     Assula physica artefactum est (corporalia) cum haecceitate;
     divisio eadem quam libri iam fecerunt (editio/codex).
     ================================================== -->

<genus nomen="processorium">

  <definitio>
    Exemplar productum circuli computantis: forma nominata quam
    officina in assulas innumeras imprimit, quae architecturam
    (unam pluresve versiones eius) in silicio exsequitur.
  </definitio>

  <differentia>
    Tertium in serie forma-instantia bibliothecae, sed gradu
    MEDIO: architectura forma pura est, assula physica res
    corporea unica - processorium inter utrumque stat, forma
    quae fabricari potest. Ab architectura differt quod
    frequentiam, nucleos, pretium habet; ab assula quod
    haecceitate caret - "M1" milia milium est et res una.
  </differentia>

  <glossa lingua="en">A processor: a product model of a
    computing circuit - a named form that a foundry prints into
    countless chips, and which executes an architecture (one or
    several of its versions) in silicon. It stands midway between
    the architecture, which is pure form, and the physical chip,
    which is a single corporeal thing: it has a clock frequency,
    cores and a price, but no haecceity - M1 is millions of chips
    and one thing.</glossa>
  <glossa lingua="fr">Un processeur : un modèle de produit de
    circuit de calcul - une forme nommée qu'une fonderie imprime
    en d'innombrables puces, et qui exécute une architecture (une
    ou plusieurs de ses versions) dans le silicium. Il se tient à
    mi-chemin entre l'architecture, qui est forme pure, et la
    puce physique, qui est une chose corporelle unique : il a une
    fréquence, des coeurs et un prix, mais pas d'eccéité - le M1
    est des millions de puces et une seule chose.</glossa>

  <proprietates>
    <proprietas nomen="nuclei" genus="numerus"/>
    <proprietas nomen="frequentia" genus="quantitas"
      modulus="mensura"/>
    <proprietas nomen="bits" genus="numerus"
      nota="latitudo verbi: 8, 16, 32, 64"/>
  </proprietates>

  <actiones>
    <actio nomen="edi" nota="in mercatum"/>
    <actio nomen="retiri" nota="productio finita - assulae
      exstantes vivunt, exemplar mortuum est"/>
  </actiones>

  <relationes>
    <relatio nomen="exsequitur" ad="architectura_machinae"
      multiplex="verum"
      nota="inversa exsecuta_a supra; multiplex quia exemplaria
            hodierna saepe plures (M1: armv8 et Rosetta x86_64
            translatione)"/>
    <relatio nomen="fabricatum_a" ad="organizatio"
      modulus="organizatio"/>
    <relatio nomen="designatum_a" ad="organizatio"
      modulus="organizatio"
      nota="designator et officina saepe diversi (Apple designat,
            TSMC imprimit) - unde relationes DUAE, quod aetas
            fabless nominat"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <individuum nomen="intel_8086" certitudo="opinio" fons="corpus">
    <definitio>
      Processorium quod architecturae x86 nomen dedit: 16 bits,
      anno 1978 editum - electum ab IBM pro PC (immo frater 8088
      eius), unde dominatus quadraginta annorum.
    </definitio>
    <valor nomen="bits">16</valor>
    <relatum nomen="exsequitur" ad="x86"/>
    <relatum nomen="fabricatum_a" ad="intel"
      modulus="organizatio"/>
    <relatum nomen="designatum_a" ad="intel"
      modulus="organizatio"/>
    <historia>
      <eventum quando="1978-06-08" actio="edi"/>
    </historia>
  </individuum>

  <individuum nomen="apple_m1" certitudo="opinio" fons="corpus">
    <definitio>
      Primum processorium Apple pro computatris scriptorii
      propriis: transitio ab Intel ad designationem domesticam
      super architecturam arm - "PowerPC -> Intel" iterum, via
      inversa.
    </definitio>
    <valor nomen="nuclei">8</valor>
    <valor nomen="bits">64</valor>
    <relatum nomen="exsequitur" ad="armv8"/>
    <relatum nomen="designatum_a" ad="apple"
      modulus="organizatio"/>
    <historia>
      <eventum quando="2020-11-10" actio="edi"/>
    </historia>
    <nota>
      Designatum ab Apple, impressum a TSMC - specimen quod
      relationes duas supra poposcit. (TSMC individuum nondum
      descriptum: umbram non pono quia relatum fabricatum_a
      simpliciter omitto - absentia honesta, non citatio
      pendens.)
    </nota>
  </individuum>

</genus>

</natura>
