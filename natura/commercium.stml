<?xml version="1.0" encoding="UTF-8"?>
<!--
  natura/commercium.stml
  Exemplar semanticum: COMMERCIUM (versio 2, PLASTICUM)
  Genera: moneta, pecunia, possessio, venditio, pretium,
  ratio_rationaria.

  Natum ex experimento pistrinae. INVENTUM GRAVISSIMUM ROTAE:
  tabula mercatoria ACTA venditionum est, et calculus vespertinus
  PLICATURA - ratio duplex (Pacioli 1494) fons eventuum
  ORIGINALIS est. Doctrina voluminis nostri maiorem natu quinque
  saeculis habet: acta immutabilia, status per plicaturam,
  emendatio per actum NOVUM (stornatio) numquam per rasuram.

  Quod nos "event sourcing" nuper vocavimus, mercatores
  Venetiarum saeculo XV iam sciebant - et propter EANDEM causam:
  ratio quae rescribi potest ratio non est.

  MERX NON EST GENUS (confirmatio regulae multiplicitatis Fran):
  esse-venale MUNUS est, ergo relatio - panis idem panis manet
  sive venalis sive donatus.
-->
<natura modulus="commercium" versio="2" lingua="latina">

<!-- ==================================================
     MONETA - genus pecuniae
     ================================================== -->

<genus nomen="moneta">

  <definitio>
    Genus pecuniae ab auctoritate emissum et receptum: unitas
    mensurae valoris - sed unitas cuius valor ipse MUTATUR
    (metrum longitudinem servat, moneta valorem non).
  </definitio>

  <proprietates>
    <proprietas nomen="codex" genus="textus"
      nota="ISO 4217: EUR, USD - norma iterum praestat"/>
    <proprietas nomen="symbolum" genus="textus"/>
  </proprietates>

  <relationes>
    <relatio nomen="emissa_a" ad="organizatio"
      modulus="organizatio"
      nota="argentaria centralis - magistratus fere semper"/>
    <relatio nomen="normata_per" ad="norma" modulus="norma"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <individuum nomen="euro">
    <valor nomen="codex">EUR</valor>
    <valor nomen="symbolum">€</valor>
    <historia>
      <eventum quando="1999-01-01">rationibus introducta</eventum>
      <eventum quando="2002-01-01">nummis et chartis</eventum>
    </historia>
    <nota>
      Moneta multarum civitatum - una moneta, magistratus multi:
      relatio emissa_a hic complexior quam alibi.
    </nota>
  </individuum>

  <individuum nomen="dollarium_americanum">
    <valor nomen="codex">USD</valor>
    <valor nomen="symbolum">$</valor>
  </individuum>

</genus>

<!-- ==================================================
     PECUNIA - quantitas monetae
     ================================================== -->

<genus nomen="pecunia">

  <definitio>
    Quantitas in moneta: numerus CUM MONETA - "3,50" nihil est
    donec moneta adsit (eadem forma qua quantitas unitatem
    poscit). Additio solum intra monetam unam; trans monetas
    CONVERSIO opus est, cuius ratio in tempore mutatur -
    additio quae hodie valet cras non valet.
  </definitio>

  <proprietates>
    <proprietas nomen="valor" genus="numerus"/>
  </proprietates>

  <relationes>
    <relatio nomen="in_moneta" ad="moneta"/>
  </relationes>

  <nota>
    Captura computatralis celeberrima: pecunia numero fluitanti
    NUMQUAM servanda est (0.1 + 0.2 ≠ 0.3 in binario) - minima
    unitas integra (centesimae) servetur. Genus quod
    repraesentationem suam praescribit, raro sed vere.
  </nota>

</genus>

<!-- ==================================================
     POSSESSIO - relatio iuris ad rem
     ================================================== -->

<genus nomen="possessio">

  <definitio>
    Relatio inter personam (aut organizationem) et rem: quis
    quid habeat. Non proprietas rei sed RELATIO - panis idem
    manet cum dominum mutat, relatio sola mutatur. Ideo
    venditio rem non tangit: relationem transfert.
  </definitio>

  <relationes>
    <relatio nomen="possessor" ad="*"
      nota="persona aut organizatio"/>
    <relatio nomen="possessum" ad="*"
      nota="res corporea, artefactum, etiam res incorporalis
            (ius, nomen) - apertum consulto"/>
  </relationes>

</genus>

<!-- ==================================================
     PRETIUM - valor petitus in tempore
     ================================================== -->

<genus nomen="pretium">

  <definitio>
    Pecunia pro re petita: relatio TEMPORE VARIANS inter rem et
    pecuniam - non proprietas rei. Idem panis heri aliud pretium
    habuit; pretium rei inhaerere putare error vulgaris (lex
    lapsus iterum: pretium ad relationem labitur, non ad rem).
  </definitio>

  <proprietates>
    <proprietas nomen="valens_a" genus="dies"/>
    <proprietas nomen="valens_ad" genus="dies"
      nota="vacuum = adhuc valens"/>
  </proprietates>

  <relationes>
    <relatio nomen="pretium_rei" ad="*"/>
    <relatio nomen="quantum" ad="pecunia"/>
  </relationes>

</genus>

<!-- ==================================================
     VENDITIO - eventus quo possessio transit
     ================================================== -->

<genus nomen="venditio">

  <definitio>
    Eventus quo possessio rei transit et pecunia contrarie
    fluit: mutatio DUPLEX simul - quod ratio duplex (Pacioli)
    ante omnes computatra scripsit. Venditio res non est sed
    ACCIDIT; quod manet, acta eius sunt.
  </definitio>

  <relationes>
    <relatio nomen="venditor" ad="*"/>
    <relatio nomen="emptor" ad="*"/>
    <relatio nomen="res_vendita" ad="*" multiplex="verum"/>
    <relatio nomen="solutum" ad="pecunia"/>
    <relatio nomen="parit" ad="obligatio" modulus="obligatio"
      nota="venditio sine solutione statim OBLIGATIONEM parit
            (ratio caffeae mensualis) - unde exemplar
            obligationis"/>
  </relationes>

</genus>

<!-- ==================================================
     TESSERA - res cuius exhibitio ius CONSTITUIT

     ARBOR HAEC MODO LINNAEANO INVENTA (Fran, rota XXIII):
     non ex abstractione ("an nomen 'charta' nimis angustum
     sit?") sed ex SPECIMINIBUS - quid re vera in silvestri
     inveniatur. Collectis exemplaribus (charta onerum, apocha
     horrei, syngrapha, perscriptio, NUMMUS CHARTACEUS, tessera
     spectaculi, tessera repositoria, tessera digitalis), arbor
     sponte apparuit, altior et acutior quam v0.

     ROMANI VERBUM HABEBANT: tessera hospitalis in duas partes
     frangebatur, et partes congruentes hospitium probabant;
     tessera frumentaria annonam dabat; tessera militaris
     signum ferebat. Vox exacta, duo milia annorum vetus.
     (Nomen bibliothecae nostrae TUI idem sonat - dominia
     diversa, nulla confusio: haec natura, illa codex.)
     ================================================== -->

<genus nomen="tessera">

  <definitio>
    Res cuius EXHIBITIO ius constituit, non probat: differentia
    ab apocha vulgari tota hic est - apocha te solvisse
    TESTATUR, tessera ius ipsum FERT. Ideo tessera amissa ius
    amissum, apocha amissa molestia sola.
  </definitio>

  <proprietates>
    <proprietas nomen="modus_transferendi" genus="electio"
      nota="axis principalis, e speciminibus haustus">
      <optio>ad_portitorem</optio>
      <optio>ad_ordinem</optio>
      <!-- ad_ordinem = per adscriptionem transfertur ("solve
           ordini N"), catena adscriptionum historiam ferens -->
    </proprietas>
    <proprietas nomen="materia_tesserae" genus="electio">
      <optio>corporea</optio>
      <optio>digitalis</optio>
    </proprietas>
    <proprietas nomen="exhibitione_consumitur" genus="veritas"
      nota="tessera spectaculi semel valet, charta onerum
            traditur et exstinguitur, tessera digitalis usque
            ad terminum suum iterari potest"/>
  </proprietates>

  <relationes>
    <relatio nomen="fert_ius_in" ad="*"
      nota="merces, pecunia, admissio, auctoritas"/>
    <relatio nomen="emissa_a" ad="*"/>
    <relatio nomen="possessio_eius" ad="possessio"
      nota="POSSESSIO TESSERAE ET POSSESSIO REI COPULATAE:
            locus unicus bibliothecae ubi possessiones duae
            necessario simul moventur"/>
  </relationes>

  <nota>
    TERMINI NEGATIVI, QUI GENUS PROBANT:
    (a) Instrumenta NOMINATIVA (pars societatis in tabulis
        inscripta) tesserae NON sunt: ius in TABULIS habitat,
        charta id probat solum. Ideo charta perdita ius non
        perdit - libellum novum petis.
    (b) CLAVIS tessera non est: potestatem confert, ius non.
        Qui clavem furatam tenet ianuam aperire POTEST,
        intrare ei non LICET. Discrimen inter posse et licere,
        quod hoc genus totum sustinet.
  </nota>

  <dubium>
    An tessera sub instrumento (corporalia) collocanda sit? Non
    convenit: instrumentum usu suo OPERATUR (fornax coquit),
    tessera nihil operatur sed SIGNIFICAT et ius fert. Res
    corporea est, instrumentum non. Apertum - fortasse res
    corporea sola parens rectus, cum tesserae digitales
    corpore careant.
  </dubium>

</genus>

<!-- ==================================================
     TESSERA NEGOTIABILIS - quae titulum PURGAT
     ================================================== -->

<genus nomen="tessera_negotiabilis" sub="tessera">

  <differentia>
    Accipiens bona fide et pretio dato titulum PURUM accipit,
    etiam si tradens ipse ius non habuit: EXCEPTIO ad regulam
    'nemo dat quod non habet'. Non possessio sola (id omnibus
    tesseris commune est) sed PURGATIO vitiorum priorum -
    haec sola differentia negotiabilitatem facit, et haec
    sola commercium trans ignotos possibile reddit.
  </differentia>

  <nota>
    Hinc et virtus et periculum: quod titulum purgat, furem
    quoque iuvat - qui a fure bona fide emit, dominum verum
    excludit. Ideo mundus a tesseris ad portitorem ad
    instrumenta nominativa saeculo XX recessit (obligationes
    ad portitorem in America anno 1982 fere abolitae; partes
    ad portitorem multis in locis vetitae) - non quia forma
    defecit sed quia NIMIS bene operabatur.
  </nota>

  <!-- ================= DICTIONARIUM ================= -->

  <species nomen="charta_onerum">
    <definitio>
      A vectore data, merces acceptas testans et dominium
      earum ferens: dum navis navigat, merces venduntur charta
      tradita - res in mari, dominium in foro.
    </definitio>
    <valor nomen="exhibitione_consumitur">verum</valor>
    <relatum nomen="fert_ius_in" ad="onus" modulus="vectura"/>
  </species>

  <species nomen="apocha_horrei">
    <definitio>
      Idem officium, re QUIESCENTE: merces in horreo positas
      testatur et dominium earum fert. Geminum chartae onerum
      - illa res in motu, haec res in statione. Specimen quod
      axem novum ostendit: motus an statio, non natura mercis.
    </definitio>
    <relatum nomen="fert_ius_in" ad="res_corporea"
      modulus="corporalia"/>
  </species>

  <species nomen="syngrapha">
    <definitio>
      Promissum scriptum solvendi: debitum ipsum in chartam
      versum, ideo vendibile. Obligatio quae MERX fit.
    </definitio>
    <relatum nomen="fert_ius_in" ad="pecunia"/>
  </species>

  <species nomen="perscriptio">
    <definitio>
      Iussum argentario datum ut ex ratione solvat: pecunia
      quae non movetur sed IUBETUR moveri - charta pro
      pecunia, quia fides argentarii pecunia est.
    </definitio>
    <valor nomen="modus_transferendi">ad_ordinem</valor>
    <relatum nomen="fert_ius_in" ad="pecunia"/>
  </species>

  <species nomen="nummus_chartaceus">
    <definitio>
      Tessera ad portitorem quam nemo tesseram vocat: "promitto
      me portitori ad petitionem soluturum" in chartis
      Britannicis adhuc IMPRESSUM stat. Pecunia ipsa huius
      generis est - et purgatio titulorum, quae ceteris
      periculosa videtur, hic tam necessaria ut invisibilis
      fiat: nemo nummum acceptum de origine interrogat.
    </definitio>
    <valor nomen="modus_transferendi">ad_portitorem</valor>
    <valor nomen="exhibitione_consumitur">falsum</valor>
    <relatum nomen="fert_ius_in" ad="pecunia"/>
    <nota>
      Specimen quod tota arbor poposcit: si nummus chartaceus
      species non est, definitio nostra falsa erat. Est - ergo
      pecunia et tessera se tangunt, quod v0 non vidit.
    </nota>
  </species>

  <species nomen="obligatio_ad_portitorem">
    <definitio>
      Debitum publicum sine nomine, cum foliis usurariis
      resecandis: species fere exstincta, cuius mors CAUSAM
      generis illustrat (tributa vitata, pecunia lota).
    </definitio>
    <valor nomen="modus_transferendi">ad_portitorem</valor>
  </species>

</genus>

<!-- ==================================================
     TESSERA SIMPLEX - possessio sufficit, titulus non purgatur
     ================================================== -->

<genus nomen="tessera_simplex" sub="tessera">

  <differentia>
    Possessio sufficit ad exhibendum, sed nulla titulorum
    purgatio: qui tesseram furatam exhibet admittitur (custos
    nescit), ius tamen non acquirit - dominus verus eam
    vindicare potest. Mechanismus idem, DOCTRINA absens.
  </differentia>

  <!-- ================= DICTIONARIUM ================= -->

  <species nomen="tessera_spectaculi">
    <definitio>
      Ius admissionis ad locum et tempus certum: exhibetur,
      consumitur, exstinguitur.
    </definitio>
    <valor nomen="exhibitione_consumitur">verum</valor>
  </species>

  <species nomen="tessera_repositoria">
    <definitio>
      Ius recipiendi rem certam depositam (vestiarium, pignus):
      tessera rem INDIVIDUAM designat, non genus - unde numerus
      in ea scriptus rem unam significat.
    </definitio>
  </species>

  <species nomen="tessera_digitalis">
    <definitio>
      Tessera ad portitorem sine corpore: qui eam tenet
      auctoritatem exercet, nullo nomine quaesito. In arte
      munitionis "facultas" (capability) dicitur, et ratio
      eadem est quae in tessera Romana fuit.
    </definitio>
    <valor nomen="materia_tesserae">digitalis</valor>
    <valor nomen="modus_transferendi">ad_portitorem</valor>
    <valor nomen="exhibitione_consumitur">falsum</valor>
    <nota>
      INVENTUM METHODI LINNAEANAE (rota XXIII): abstractione
      progressi tesseram digitalem inter negotiabilia
      posuissemus - "possessio ius confert, eadem forma".
      Speciminibus collatis apparuit MECHANISMUM communem esse,
      DOCTRINAM non: nulla purgatio titulorum in systematibus
      nostris est, tessera furata furata manet. Ideo hic, non
      supra. Divisio quam sola abstractio numquam vidisset -
      et responsum quaestioni apertae rotae XXII, in partem
      inexspectatam.
    </nota>
  </species>

</genus>

<!-- ==================================================
     RATIO RATIONARIA - acta rerum pecuniariarum
     (fons eventuum ORIGINALIS - vide caput)
     ================================================== -->

<genus nomen="ratio_rationaria">

  <definitio>
    Acta rerum pecuniariarum ordine temporis: veritas est cauda
    eventuum, status omnis (summa, debitum, lucrum) PLICATURA.
    Emendatio numquam per rasuram sed per actum novum
    contrarium (stornatio) - quia ratio quae rescribi potest
    ratio non est.
  </definitio>

  <nota>
    DOCTRINA VOLUMINIS NOSTRI, QUINQUE SAECULIS ANTIQUIOR:
    acta immutabilia, status derivatus, correctio per eventum
    novum. Luca Pacioli hanc formam anno 1494 descripsit (non
    invenit: mercatores Venetiarum iam utebantur). Quod nos
    "fontem eventuum" vocamus, ars rationaria semper fuit.
  </nota>

  <relationes>
    <relatio nomen="continet" ad="venditio" multiplex="verum"/>
    <relatio nomen="rationarius" ad="persona" modulus="persona"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <species nomen="ratio_duplex">
    <definitio>
      Omnis eventus BIS scribitur (debitum et creditum): summa
      omnium debitorum summae creditorum semper aequalis -
      INVARIANS in actis ipsis inaedificata (vide
      elementa_programmatis.assertio: invarians ante
      computatra). Error se ipsum prodit cum summae non
      conveniunt.
    </definitio>
  </species>

</genus>

</natura>
