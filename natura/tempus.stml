<?xml version="1.0" encoding="UTF-8"?>
<!--
  natura/tempus.stml
  Exemplar semanticum: TEMPUS (versio 4, PLASTICUM)
  Genera: momentum, intervallum, recurrentia, horarium,
  calendarium, reservatio.

  ============================================================
  MECHANISMUS METAMODULI: TEMPUS VALIDITATIS (rota XVIII)
  ============================================================
  Attributa valens_a= et valens_ad= in <valor> et <relatum>:
  QUANDO affirmatio vera fuit. Rota XVI dedit quanta certitudine
  (certitudo=) et unde (fons=); haec tertiam coordinatam dat.

  DEFECTUS INVENTUS IN NOBIS (cursu tertio circuli): organizatio
  affirmabat `bell_labs pars_de att` PLANE - verum ab anno 1925
  usque ad divisionem Lucentem anni 1996. Rem quae ante triginta
  annos desiit ut perpetuam praebebamus. Non exemplum fictum sed
  MENDACIUM NOSTRUM, a circulo inventum.

  REGULA TRIPLEX (quando notandum sit - pars caram doctrinae):
  I.   ESSENTIALIA (definitiones, differentiae, proprietates
       speciei: "C imperativa est") - PERPETUA, numquam notanda.
       Quod rei est qua talis est, tempus non habet.
  II.  STATUS (valores machinarum: vita=vigens) - PRAESENTIA
       natura sua: status PLICATURA historiae est, ergo "nunc"
       significat ex definitione. Non notanda; historia veritatem
       fert.
  III. ACCIDENTIA RELATIVA (parens organizationis, pretium,
       locus rei, conductio personae) - HAEC SOLA NOTANDA.
       Vera fuerunt, desierunt, et forma plana mentitur.
  Ideo exemplaria XXV fere sine mendacio vixerunt: casus I et II
  scribebant. Mendacium in casu III solo apparuit.

  CONVENTIO TERMINORUM: valens_ad absens = ADHUC VALET (idem quo
  organizatio.dissoluta: "vacuum = perdurans"). Si vere ignotum,
  certitudo= id dicat aut nota.

  VIA ALTERA - REIFICATIO: factum tempore ligatum ENTITAS fieri
  potest cum proprietatibus suis (sic pretium in commercio:
  valens_a/valens_ad proprietates habet, non attributa). Gravior
  sed ditior - eligenda cum factum ipsum auctorem, causam,
  pretium suum habet. Attributa cum factum nudum est.
  (Pretium mechanismum hunc rota XIV SPONTE invenit, localiter:
  signum quod metamodulus eo egeret - eadem lex qua relatio
  notis gravata res fieri petit.)
  ============================================================

  Natum ex experimento pistrinae: coctio hora quarta,
  hebdomadis rhythmus, horae apertionis, vices operariorum.
  Genus momentum iam diu superfuerat (tempus_creatus in actor.c,
  proprietas 'dies' ubique) - pistrina id tandem evocavit cum
  RECURRENTIA.

  DISCRIMEN QUOD OMNIA REGIT: momentum PUNCTUM est, intervallum
  SPATIUM inter puncta, recurrentia REGULA quae momenta gignit.
  Recurrentia non est copia momentorum: regula est, et copia
  eius INFINITA - "omni die Lunae" finem non habet. Ideo
  recurrentia servanda est ut REGULA, numquam ut acta expansa;
  qui expandit, futurum truncat.

  Hoc exemplar solum inter nostra HOROLOGIUM supponit -
  mensuram temporis (secundum, minutum) in exemplari mensurae
  invenies; hic de temporis STRUCTURA agitur, non de mensura.
-->
<natura modulus="tempus" versio="4" lingua="latina">

<!-- ==================================================
     MOMENTUM - punctum in tempore
     ================================================== -->

<genus nomen="momentum">

  <definitio>
    Punctum in tempore: quando aliquid accidit. Sine duratione -
    quod durat, intervallum est. Omne eventum momentum habet;
    hinc historiae omnium exemplarium pendent.
  </definitio>

  <proprietates>
    <proprietas nomen="praecisio" genus="electio"
      nota="momentum praecisionem SUAM fert: '1225' anno solo
            notum (Thomas natus), '2019-05-20' die, log
            millesima secundi. Praecisionem fingere mendacium
            est - annus in diem versus falsum dicit">
      <optio>annus</optio>
      <optio>mensis</optio>
      <optio>dies</optio>
      <optio>hora</optio>
      <optio>secundum</optio>
      <optio>minutia</optio>
    </proprietas>
    <proprietas nomen="zona_horaria" genus="textus"
      nota="idem momentum absolutum, nomina localia varia -
            'hora quarta' pistrinae zonam SUPPONIT; momenta
            trans zonas comparanda in absoluto servanda sunt"/>
  </proprietates>

  <nota>
    CAPTURA COMPUTATRALIS: differentia duorum momentorum SIGNATA
    est necessario (praeteritum minus futurum negativum est) -
    numerus insignatus hic vulnus notum est in domo nostra (s64
    pro omni tempore ex horologio).
  </nota>

</genus>

<!-- ==================================================
     INTERVALLUM - spatium inter momenta
     ================================================== -->

<genus nomen="intervallum">

  <definitio>
    Spatium temporis inter duo momenta: initium, finis, ideo
    duratio. Quod duratione caret momentum est; quod fine caret
    (adhuc currens) intervallum APERTUM est - status verus,
    non defectus datorum.
  </definitio>

  <proprietates>
    <proprietas nomen="duratio" genus="quantitas"
      modulus="mensura"
      nota="DERIVATA ex initio et fine - sed quantitas vera:
            '25 minuta' unitatem poscit"/>
  </proprietates>

  <relationes>
    <relatio nomen="initium" ad="momentum"/>
    <relatio nomen="finis" ad="momentum"
      nota="vacuum = adhuc currens (intervallum apertum)"/>
  </relationes>

  <nota>
    Intervalla se SUPERPONERE possunt, contineri, tangere -
    algebra intervallorum (Allen tredecim relationes numeravit)
    quam schemata vulgaria ignorant et postea dolent: "vices
    duae eodem tempore" quaestio de superpositione est.
  </nota>

</genus>

<!-- ==================================================
     RECURRENTIA - regula momenta gignens
     ================================================== -->

<genus nomen="recurrentia">

  <definitio>
    Regula quae momenta (aut intervalla) gignit: "omni die hora
    quarta", "omni die Lunae", "prima die cuiusque mensis".
    REGULA est, non copia - copia eius saepe infinita. Servetur
    ut regula; qui in acta expandit, futurum ad terminum
    arbitrarium truncat.
  </definitio>

  <proprietates>
    <proprietas nomen="periodus" genus="electio">
      <optio>cotidiana</optio>
      <optio>hebdomadaria</optio>
      <optio>menstrua</optio>
      <optio>annua</optio>
    </proprietas>
    <proprietas nomen="frequentia" genus="numerus"
      ordinarius="1"
      nota="'omni tertia hebdomade' - periodus cum numero"/>
    <proprietas nomen="exceptiones" genus="dies" multiplex="verum"
      nota="dies festi, feriae: EXCEPTIO pars regulae est, non
            error eius - pistrina die Dominico clausa"/>
  </proprietates>

  <nota>
    Recurrentia cyclum machinae statuum COMPLET: planta 'per ver'
    transit (cyclus intra machinam), recurrentia cyclum ipsum
    NOMINAT et momenta eius gignit. Duo modi eiusdem veritatis:
    res quaedam iterum atque iterum fiunt.
  </nota>

</genus>

<!-- ==================================================
     RECURRENTIA COMPUTATA - regula quae CALCULUM poscit
     (DUBIUM rotae XIV HIC CLAUSUM: festa mobilia
     periodum simplicem excedunt)
     ================================================== -->

<genus nomen="recurrentia_computata" sub="recurrentia">

  <differentia>
    Momenta non ex periodo simplici sed ex ALGORITHMO oriuntur:
    regula ipsa calculum continet, saepe corpora caelestia aut
    alias recurrentias consulens. Ideo "quando proxime?" sine
    computatione responderi non potest - quod periodica semper
    potest.
  </differentia>

  <proprietates>
    <proprietas nomen="algorithmus" genus="textus"
      nota="regula computandi ipsa - hic descripta, non
            exsecuta: bibliotheca id quod EST dicit, non id
            quod fit"/>
    <proprietas nomen="pendet_ex_alia" genus="veritas"
      ordinarius="falsum"
      nota="an alias recurrentias consulat - dies negotiorum
            calendarium feriarum poscunt, unde recurrentiae
            se invicem componunt"/>
  </proprietates>

  <nota>
    GENUS NON RELIGIOSUM, quamvis a paroecia surrexerit:
    specimina in negotio, in fisco, in agricultura eadem sunt.
    Probatio Linnaeana iterum - specimina collecta genus
    latius quam scaena ostenderunt.
  </nota>

  <!-- ================= DICTIONARIUM ================= -->

  <species nomen="pascha">
    <definitio>
      Dominica post plenilunium quod aequinoctium vernum
      sequitur: computus lunisolaris, unde festa mobilia tota
      pendent (Quadragesima, Ascensio, Pentecoste).
    </definitio>
    <valor nomen="algorithmus">computus lunisolaris</valor>
    <nota>
      Specimen quod dubium peperit et clausit: nulla periodus
      simplex hoc exprimit, et tamen regula est - determinata,
      publica, saeculis ante computatra computata. Calendarium
      liturgicum (vide supra) hoc nunc dicere potest.
    </nota>
    <dubium>
      GRADUS AMBIGUUS (rota XXIX): una est regula paschalis,
      ergo individuum videtur; at "pascha" etiam de quovis anno
      dicitur ("pascha huius anni"), quod praedicationem sapit.
      Discrimen fortasse inter REGULAM (individuum) et
      OCCURRENTIAS quas gignit (quae in voluminibus vivunt, per
      regulam residentiae). APERTUM.
    </dubium>
  </species>

  <species nomen="dies_negotiorum">
    <definitio>
      "Post dies negotiorum triginta": dies festis et diebus
      Solis exclusis - regula quae ALIAM recurrentiam
      (calendarium feriarum) consulere debet.
    </definitio>
    <valor nomen="pendet_ex_alia">verum</valor>
    <nota>
      Specimen NON RELIGIOSUM quod genus generalizat: idem
      calculus in contractibus, in solutionibus, in terminis
      iudicialibus. Et ferias per iurisdictiones VARIANT -
      unde eadem clausula in duabus civitatibus duos dies
      significat.
    </nota>
  </species>

  <species nomen="dies_ordinalis_mensis">
    <definitio>
      "Tertia feria secunda cuiusque mensis": ordo intra
      mensem, non intervallum fixum - unde intervalla inaequalia
      (28 aut 35 dies) sine ullo errore.
    </definitio>
  </species>

</genus>

<!-- ==================================================
     RECURRENTIA PER USUM - clavis non tempus sed USUS
     (aviatio poposcit: "post horas volatus quingentas")
     ================================================== -->

<genus nomen="recurrentia_per_usum" sub="recurrentia">

  <differentia>
    Non tempore sed USU ACCUMULATO regitur: horis operis,
    cyclis, spatio confecto. Ideo instrumentum quiescens
    numquam recurrit, laborans saepe - quod tempus solum dicere
    non potest.
  </differentia>

  <proprietates>
    <proprietas nomen="mensura_usus" genus="quantitas"
      modulus="mensura"
      nota="quantum usus intersit"/>
  </proprietates>

  <nota>
    PRETIUM ABSCONDITUM: recurrentia temporis GRATIS est
    (calendarium omnes habent); recurrentia usus INSTRUMENTUM
    poscit quod usum metiatur et servet. Ideo domus quae
    "post horas quingentas" praescribit horometrum prius habere
    debet - regula mensuram supponit, et mensura non gratis
    venit.
  </nota>

  <!-- ================= DICTIONARIUM ================= -->

  <species nomen="per_horas_operis">
    <definitio>Horis quibus res re vera operata est.</definitio>
  </species>

  <species nomen="per_cyclos">
    <definitio>
      Numero vicium quibus res a quiete ad opus et retro
      transiit: ubi damnum ex TRANSITU oritur, non ex duratione
      (metallum fatigatur pressione alternante, non stante).
    </definitio>
  </species>

  <species nomen="per_spatium">
    <definitio>Distantia confecta: vehiculis propria.</definitio>
  </species>

</genus>

<!-- ==================================================
     HORARIUM - recurrentiae ordinatae ad opus
     ================================================== -->

<genus nomen="horarium">

  <definitio>
    Recurrentiae in ordinem compositae quibus opus regitur:
    horae apertionis, vices operariorum, ordo coctionis. Non
    una regula sed SYSTEMA regularum quae inter se conveniunt
    (aut non conveniunt - unde conflictus vicium).
  </definitio>

  <relationes>
    <relatio nomen="continet" ad="recurrentia" multiplex="verum"/>
    <relatio nomen="regit" ad="*"
      nota="organizatio, aedificium, persona - quod horario
            ordinatur"/>
    <relatio nomen="vinctum_per" ad="instrumentum"
      modulus="corporalia" multiplex="verum"
      nota="capacitas instrumenti horarium DETERMINAT: fornax
            duodecim panes simul - vinculum corporeum quod
            tempus ordinat. Non abstractio: ferrum horas
            imperat"/>
  </relationes>

</genus>

<!-- ==================================================
     CALENDARIUM - systema dierum nominandorum
     ================================================== -->

<genus nomen="calendarium">

  <definitio>
    Systema quo dies nominantur et ordinantur: menses,
    hebdomadae, anni, dies festi. CONVENTIO cum historia -
    calendaria mutantur, et mutatio dies REVERA delet.
  </definitio>

  <relationes>
    <relatio nomen="conditum_a" ad="*"
      nota="persona aut auctoritas - Gregorius XIII, magistratus"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <individuum nomen="calendarium_gregorianum">
    <historia>
      <eventum quando="1582-10-15">a Gregorio XIII introductum:
        dies decem OMISSI (4 Oct sequebatur 15 Oct) - momenta
        quae numquam fuerunt, in historia vera</eventum>
    </historia>
    <nota>
      Testis quod calendarium conventio est, non natura: dies
      decem lege deleti sunt. Quod nulla forma temporis
      "naturalis" ferre potest, historia vera poscit.
    </nota>
  </individuum>

  <individuum nomen="calendarium_liturgicum">
    <nota>
      Annus per festa et tempora ordinatus (Adventus,
      Quadragesima, Pascha): festa MOBILIA (Pascha per lunam
      computatum) recurrentiam calculatam poscunt, non
      periodicam simplicem - species recurrentiae quam periodus
      nostra nondum capit. Dubium honestum, apertum.
    </nota>
  </individuum>

</genus>

<!-- ==================================================
     RESERVATIO - vindicatio capacitatis futurae
     ================================================== -->

<genus nomen="reservatio">

  <definitio>
    Vindicatio capacitatis futurae: intervallum et res (sedes,
    cella, hora medici) alicui SERVATA ne alteri detur. Tempus
    dicere poteramus; DICERE VINDICATUM non poteramus. Duo
    parit simul: ius vindicantis et obligationem servantis.
  </definitio>

  <machina_statuum nomen="vita" gerens="individuum">
    <status nomen="petita"/>
    <status nomen="confirmata"/>
    <status nomen="adhibita" nota="exitus optatus"/>
    <status nomen="deserta"
      nota="tempus praeteriit, nemo venit - damnum PURUM:
            capacitas perit nec alteri data est. Unde
            superscriptio infra"/>
    <status nomen="cancellata"/>
    <transitus a="petita" ad="confirmata" per="confirmatio"/>
    <transitus a="confirmata" ad="adhibita" per="usus"/>
    <transitus a="confirmata" ad="deserta" per="absentia"/>
    <transitus a="confirmata" ad="cancellata" per="cancellatio"/>
    <transitus a="petita" ad="cancellata" per="recusatio"/>
  </machina_statuum>

  <relationes>
    <relatio nomen="tempus_servatum" ad="intervallum"/>
    <relatio nomen="res_servata" ad="*"/>
    <relatio nomen="vindicans" ad="*"/>
    <relatio nomen="parit" ad="obligatio" modulus="obligatio"
      nota="servans tenetur servare - obligatio ex contractu,
            etiam sine pretio soluto"/>
  </relationes>

  <nota>
    SUPERSCRIPTIO (plures reservationes quam capacitas):
    consilium consultum, non error - nititur PERICULO
    computato (pars desertorum nota), et cum fallit,
    obligationem violat consulto. Exemplum ubi periculum,
    obligatio, reservatio simul operantur; nullum eorum
    solum rem explicat.
  </nota>

</genus>

</natura>
