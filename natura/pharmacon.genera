<?xml version="1.0" encoding="UTF-8"?>
<!--
  natura/pharmacon.genera
  Exemplar semanticum: PHARMACON (versio 2, PLASTICUM)

  Cursus septimus circuli (pharmacopolium), euristica punitionis
  electus: qui dosem, interactionem, dispensationem contra
  praescriptionem errat, hominem occidit - unde dominium haec
  omnia prae ceteris elaboravit.

  QUATTUOR GENERA, quorum tria SCALAM faciunt quam dominium
  IPSUM IAM AEDIFICAVIT et cui gradibus singulis identificatores
  dedit (RxNorm: ingrediens -> medicamentum clinicum -> nomen
  mercatorium -> fasciculus; CAS substantiae, NDC producto, lot
  coctura). Non abstractio nostra sed inventio: series forma-
  instantia bibliothecae hic quartum et quintum exemplum invenit,
  ab aliis exculta.

  SUBSTANTIA / MEDICAMENTUM / COCTURA - tres gradus:
    substantia_chemica  quid EST (molecula; CAS)
    medicamentum        quid PRAESCRIBITUR (substantia + vis +
                        forma; quod praescriptio nominat)
    coctura             quid FACTUM EST hoc cursu (lot; quod
                        revocatio alloquitur)
  Coctura gradum NOVUM bibliothecae adfert: inter exemplar
  producti (processorium) et rem singularem cum haecceitate -
  OMNIA quae uno cursu facta sunt, provenientiam communem et
  FATUM COMMUNE habentia. Revocationes cocturas alloquuntur,
  numquam res singulas; idem in vaccinis, ferro fuso, cibo.

  INTERACTIO quartum est, et relatio REIFICATA: 'relatio cuius
  notae gravescunt res fieri vult' (lex domus) plus probatio
  allocutionis - bases datorum interactionibus identificatores
  dant. Specimen secundum ex dominio alieno: tabulae
  segregationis mercium periculosarum eandem formam ferunt.
-->
<natura modulus="pharmacon" versio="2" lingua="latina">

<fontes>
  <fons clavis="corpus" genus="corpus_institutionis"
    modulus="iudicium" verificatus="falsum">
    Corpus institutionis scribae: dies et res gestae ex textibus
    innumeris haustae. NON VERIFICATUM.
  </fons>
</fontes>

<!-- ==================================================
     SUBSTANTIA CHEMICA - quid est
     ================================================== -->

<.genus nomen="substantia_chemica">

  <definitio>
    Genus materiae compositione determinatum: quod omnia
    exemplaria eiusdem substantiae communicant, ubicumque et
    quandocumque facta. Non acervus sed GENUS acervorum -
    "aspirinum" res una est de qua loquimur, etsi acervi
    innumeri sunt.
  </definitio>

  <differentia>
    A materia (corporalia) ut genus a suo exemplari: materia
    MENSURABILIS est et hic nunc iacet ("tria grammata farinae");
    substantia chemica genus est quod nec ponderari nec tangi
    potest. Distinctio quam identificatores probant: CAS
    substantiam numerat, non acervum.
  </differentia>

  <glossa lingua="en">A chemical substance: a kind of matter
    determined by its composition - what all samples of the same
    substance share, wherever and whenever they were made. Not a
    heap but the KIND of heaps: "aspirin" is one thing we speak of,
    although the heaps of it are countless. It can be neither
    weighed nor touched, whereas matter can.</glossa>
  <glossa lingua="fr">Une substance chimique : un genre de matière
    déterminé par sa composition - ce que partagent tous les
    exemplaires d'une même substance, où et quand qu'ils aient été
    faits. Non pas un tas mais le GENRE des tas : « l'aspirine » est
    une seule chose dont nous parlons, quoique les tas en soient
    innombrables. Elle ne peut être ni pesée ni touchée, alors que
    la matière le peut.</glossa>

  <proprietates>
    <proprietas nomen="formula" genus="textus"/>
    <proprietas nomen="massa_molecularis" genus="quantitas"
      modulus="mensura"/>
    <proprietas nomen="solubilitas" genus="electio">
      <optio>aquosa</optio>
      <optio>lipidica</optio>
      <optio>utraque</optio>
    </proprietas>
  </proprietates>

  <relationes>
    <relatio nomen="exemplatur_in" ad="materia"
      necessitudo="successio"
      modulus="corporalia" multiplex="verum"
      nota="acervi concreti huius substantiae"/>
    <relatio nomen="classificata_ut" ad="classis_normativa"
      necessitudo="normata_per"
      modulus="norma" multiplex="verum"
      nota="schedulae substantiarum huc adhaerent - et
            RESCHEDULATIO substantiam non mutat, quod genus
            classis normativae probat"/>
    <relatio nomen="interagit" a="interactio" inversa="verum"
      necessitudo="participatio"
      nota="impletur ab interactio.inter"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <individuum nomen="amoxicillinum" certitudo="opinio"
    fons="corpus">
    <definitio>
      Antibioticum beta-lactamicum penicillinorum familiae,
      spectro amplo, ore sumendum.
    </definitio>
    <valor nomen="formula">C16H19N3O5S</valor>
  </individuum>

  <individuum nomen="warfarinum" certitudo="opinio" fons="corpus">
    <definitio>
      Anticoagulans quod vitaminum K antagonizat: fenestra
      therapeutica angusta, unde mensura perpetua (INR)
      necessaria.
    </definitio>
    <valor nomen="formula">C19H16O4</valor>
    <nota>
      Substantia interactionibus notissima - fenestra angusta
      facit ut mutatio parva effectus magnos ferat. Ideo
      specimen electum: ubi periculum magnum, dominium
      distinctiones acuit.
    </nota>
  </individuum>

</.genus>

<!-- ==================================================
     MEDICAMENTUM - quid praescribitur
     ================================================== -->

<.genus nomen="medicamentum">

  <definitio>
    Substantia (aut plures) cum VI et FORMA determinatis ad
    morbum tractandum praeparata: quod praescriptio nominat et
    quod pharmacopola dispensat. "Amoxicillinum 500 mg capsula"
    - non substantia sola, nondum res in manu.
  </definitio>

  <differentia>
    Gradus MEDIUS quem dominium ipsum nominavit: substantia
    nimis abstracta est ut praescribatur (quanta? quo modo
    sumenda?), res singula nimis concreta (haec capsula, non
    alia). Medicamentum id est de quo iudicium clinicum fertur
    et cui aequivalentia asseritur.
  </differentia>

  <glossa lingua="en">A drug: one substance (or several) prepared
    with a determinate STRENGTH and FORM for treating illness -
    what a prescription names and what a pharmacist dispenses.
    "Amoxicillin 500 mg capsule" is not the substance alone, and is
    not yet the thing in the hand.</glossa>
  <glossa lingua="fr">Un médicament : une substance (ou plusieurs)
    préparée avec une PUISSANCE et une FORME déterminées pour
    traiter une maladie - ce que l'ordonnance nomme et ce que le
    pharmacien délivre. « Amoxicilline 500 mg gélule » n'est pas la
    substance seule, et n'est pas encore la chose que l'on tient en
    main.</glossa>

  <proprietates>
    <proprietas nomen="vis" genus="quantitas" modulus="mensura"
      nota="quantum substantiae in unitate"/>
    <proprietas nomen="forma_sumendi" genus="electio">
      <optio>capsula</optio>
      <optio>tabella</optio>
      <optio>suspensio</optio>
      <optio>unguentum</optio>
      <optio>iniectio</optio>
    </proprietas>
    <proprietas nomen="via_sumendi" genus="electio">
      <optio>oralis</optio>
      <optio>topica</optio>
      <optio>venosa</optio>
      <optio>muscularis</optio>
    </proprietas>
    <proprietas nomen="sine_praescriptione" genus="veritas"
      ordinarius="falsum"/>
    <proprietas nomen="conservatio" genus="quantitas"
      modulus="mensura"
      nota="temperatura qua servandum - AMBITUS, non punctum
            ('2-8 gradus'): quantitas minimum et maximum IUXTA
            valorem fert, unde forma hoc IAM ferebat. Dubium
            plantae de ambitibus (altitudo '2-5 m') solutum erat
            antequam pharmacopolium idem posceret - mechanismus
            semel recte positus dominium novum sine mutatione
            cepit, quod est quod 'dimensiones ante nomina'
            promittit"/>
  </proprietates>

  <relationes>
    <relatio nomen="continet" ad="substantia_chemica"
      multiplex="verum"
      nota="ingredientia activa"/>
    <relatio nomen="aequivalens" ad="medicamentum"
      necessitudo="conformitas"
      multiplex="verum"
      nota="RELATIO PER IUDICIUM, non per naturam:
            aequivalentia therapeutica ASSERITUR ab auctoritate
            (Orange Book gradus suos fert), non ex compositione
            legitur. Duo medicamenta idem ingrediens habere et
            aequivalentia NON esse possunt"/>
    <relatio nomen="asseritur_per" ad="iudicium" modulus="iudicium"
      nota="aequivalentiam vide supra"/>
    <relatio nomen="fabricatum_in" ad="coctura"
      multiplex="verum"
      nota="conversum coctura.coquitur - identitas in
            necessitudines declarata (vulnus inversae-ut-nominis
            hac via sanatum)"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <.species nomen="medicamentum_genericum">
    <differentia>
      Post privilegium inventionis elapsum ab aliis fabricatum,
      aequivalentia asserta, nomine substantiae venditum.
    </differentia>
  </.species>

  <.species nomen="medicamentum_nominatum">
    <differentia>
      Nomine mercatorio venditum, plerumque ab eo qui invenit -
      idem medicamentum, nomen aliud, pretium aliud.
    </differentia>
  </.species>

  <.species nomen="medicamentum_compositum">
    <definitio>
      In officina pharmacopolii ad singularem aegrum
      praeparatum, quia forma mercatoria non convenit (dosis
      infantilis, allergia ad excipiens, sapor).
    </definitio>
    <differentia>
      Species cuius PRAESCRIPTUM (formula) et IUSSUM
      (praescriptio) simul adsunt et distincta manent - locus
      ubi collisio etymologica solvitur: formula praescriptum
      est quia iteratur, charta iussum quia hunc aegrum
      nominat.
    </differentia>
  </.species>

</.genus>

<!-- ==================================================
     COCTURA - quid hoc cursu factum est
     ================================================== -->

<.genus nomen="coctura">

  <definitio>
    Omnia quae uno cursu fabricationis facta sunt, provenientiam
    communem et ideo FATUM COMMUNE habentia: quod contaminatum
    est in una unitate contaminatum esse potest in omnibus, unde
    revocatio cocturam alloquitur, non rem singulam.
  </definitio>

  <differentia>
    GRADUS NOVUS in serie forma-instantia: inter exemplar
    (medicamentum, processorium) et rem singularem cum
    haecceitate. Non forma, quia hic nunc facta est et tempore
    perit; non res singula, quia unitates innumeras continet.
    Quod eam unam facit est PROVENIENTIA, non natura - eadem
    formula cras cocta coctura alia est.
  </differentia>

  <glossa lingua="en">A batch: everything made in one manufacturing
    run, sharing a common provenance and therefore a COMMON FATE -
    what is contaminated in one unit may be contaminated in all of
    them, and so a recall addresses the batch and never the single
    item.</glossa>
  <glossa lingua="fr">Un lot : tout ce qui a été fait au cours d'une
    même production, partageant une provenance commune et donc un
    DESTIN COMMUN - ce qui est contaminé dans une unité peut l'être
    dans toutes, et c'est pourquoi un rappel vise le lot et jamais
    l'objet isolé.</glossa>

  <proprietates>
    <proprietas nomen="numerus_cocturae" genus="textus"
      nota="quo alloquitur - in unitate ipsa impressus, quia
            revocatio unitates in manibus hominum invenire
            debet"/>
    <proprietas nomen="quantitas_facta" genus="quantitas"
      modulus="mensura"/>
    <proprietas nomen="expirat" genus="dies"
      nota="COCTURAE pertinet, non medicamento: eadem formula
            cocturis diversis dies diversos habet. Proprietas
            quae gradum hunc necessarium probat"/>
  </proprietates>

  <machina_statuum nomen="status" gerens="individuum">
    <status nomen="fabricata"/>
    <status nomen="probata" nota="qualitate examinata"/>
    <status nomen="dimissa" nota="in mercatum"/>
    <status nomen="revocata"
      nota="EVENTUS PROPTER QUEM GENUS EXSISTIT: unitates omnes
            ubicumque sunt simul quaeruntur - actio quae rem
            singulam alloqui non potest"/>
    <status nomen="exhausta"/>
    <status nomen="elapsa"/>
    <transitus a="fabricata" ad="probata" per="examinatio"/>
    <transitus a="probata" ad="dimissa" per="dimissio"/>
    <transitus a="dimissa" ad="revocata" per="revocatio"/>
    <transitus a="dimissa" ad="exhausta" per="consumptio"/>
    <transitus a="dimissa" ad="elapsa" per="lapsus_temporis"/>
  </machina_statuum>

  <relationes>
    <relatio nomen="coquitur" ad="*"
      nota="cuius rei haec coctura sit. Clausura medicamenti
            APERTA 2026-08-08 (lacuna L2): parochialis erat,
            differentia numquam - glossae, assulae, panes uno
            cursu factae aeque coquuntur. Radix universalis non
            est, ergo relatio aperta (signum manet, clavis
            nulla)"/>
    <relatio nomen="fabricata_a" ad="organizatio"
      necessitudo="origo"
      modulus="organizatio"/>
    <relatio nomen="acta_sua" ad="acta" modulus="acta"
      necessitudo="repraesentatio"
      nota="acta fabricationis (batch record) - species
            acta_auditus: quis quid quando, contra fabricantem
            ipsum valitura"/>
  </relationes>

  <nota>
    GENUS TRANS DOMINIA: coctura vaccinorum, fusio ferri (heat
    number), coctura cibi, fasciculus seminum - omnia eandem
    formam ferunt, et omnia eandem ob causam: quod simul factum
    est simul corrumpi potest. Nomen 'coctura' ex arte
    pharmaceutica et pistoria simul venit; 'massa' adhiberi non
    potuit (bis occupata: mensura.massa et massae voluminis).
  </nota>

</.genus>

<!-- ==================================================
     INTERACTIO - relatio reificata incompatibilitatis
     ================================================== -->

<.genus nomen="interactio">

  <definitio>
    Relatio inter res duas (aut plures) quarum praesentia
    simultanea effectum mutat quem singulae haberent: non
    proprietas alterutrius sed rei TERTIAE quae ex coniunctione
    oritur.
  </definitio>

  <differentia>
    RELATIO REIFICATA, et iure: notae eius (gravitas, mechanismus,
    testimonium, consilium) tam graves sunt ut relatio nuda eas
    ferre non possit, et bases datorum ei identificatorem dant -
    utraque probatio domus simul (relatio cuius notae gravescunt;
    probatio allocutionis). Cave tamen: relata IPSA identitatem
    non accipiunt ab hac relatione - substantiae suam habent.
  </differentia>

  <glossa lingua="en">An interaction: a relation between two things
    (or more) whose simultaneous presence changes the effect each
    would have on its own. It is not a property of either one but of
    a THIRD thing that arises from their conjunction.</glossa>
  <glossa lingua="fr">Une interaction : une relation entre deux
    choses (ou davantage) dont la présence simultanée modifie
    l'effet que chacune aurait seule. Ce n'est pas une propriété de
    l'une ou de l'autre, mais d'une TROISIÈME chose qui naît de leur
    conjonction.</glossa>

  <proprietates>
    <proprietas nomen="gravitas" genus="electio">
      <optio>levis</optio>
      <optio>moderata</optio>
      <optio>gravis</optio>
      <optio>contraindicatio</optio>
    </proprietas>
    <proprietas nomen="mechanismus" genus="textus"
      nota="CUR fiat - quod consilium possibile facit: qui
            mechanismum scit tempus interponere aut dosem
            mutare potest, qui solum 'cave' legit non potest"/>
    <proprietas nomen="testimonium" genus="fundamentum"
      modulus="iudicium"
      nota="genus commune rota LIX datum. Quantum sciatur - distinctum a gravitate: coniectura
            theoretica de effectu gravi et probatio firma de
            levi res prorsus aliae. OPTIONES LOCALES ROTA LIX
            SUBLATAE: 'theoreticum' illatio est, 'relationes
            casuum' auctoritas_testis, 'studia' mensuratio -
            species fundamenti, non enumeratio huius loci"/>
    <proprietas nomen="consilium" genus="textus"
      nota="quid agendum - vitare, tempus interponere, dosem
            minuere, mensurare"/>
  </proprietates>

  <relationes>
    <relatio nomen="inter" ad="*" multiplex="verum"
      necessitudo="participatio"
      nota="relata - apertum consulto: substantiae, sed etiam
            merces periculosae, cibus, morbi, condiciones"/>
    <relatio nomen="asseritur_per" ad="iudicium" modulus="iudicium"
      nota="PER IUDICIUM: gravitas et testimonium asseruntur,
            et fontes inter se dissentiunt - qui interactiones
            ut FACTA tractat basim datorum unam pro veritate
            sumit"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <.species nomen="interactio_medicamentorum">
    <definitio>
      Inter medicamenta duo: alterum alterius concentrationem
      aut effectum mutat, plerumque per enzymata hepatis aut
      per viam eandem.
    </definitio>
  </.species>

  <.species nomen="interactio_cum_cibo">
    <definitio>
      Inter medicamentum et cibum: absorptio mutata, aut
      substantia in cibo eandem viam occupans.
    </definitio>
  </.species>

  <.species nomen="incompatibilitas_mercium">
    <definitio>
      Inter merces periculosas quae simul vehi aut condi non
      debent: oxidantia cum inflammabilibus, acida cum basibus.
    </definitio>
    <differentia>
      Specimen ex dominio prorsus alieno (vectura), quod genus
      aedificari permisit: forma eadem - res duae innocuae
      seorsum, periculosae simul - et tabulae segregationis
      idem officium praestant quod bases interactionum.
    </differentia>
    <nota>
      Hic classis_normativa et interactio conveniunt: tabulae
      segregationis per CLASSES loquuntur, non per merces
      singulas - interactio inter classes, non inter res.
      Confirmat relationem 'inter' apertam recte esse.
    </nota>
  </.species>

  <dubium>
    AN INTERACTIO SEMPER MALA SIT. Species omnes hic nocumentum
    ferunt, sed synergismus therapeuticus (medicamenta duo
    consulto coniuncta ut alterum alterius effectum augeat)
    eandem structuram habet cum signo contrario, et
    'contraindicatio' in gravitate id non capit. An proprietas
    'utilitas' addenda (nocens/utilis/neutra), an synergismus
    genus proprium? Casus cogens unus adhuc - notatum,
    non solutum.
  </dubium>

</.genus>

</natura>
