<?xml version="1.0" encoding="UTF-8"?>
<!--
  natura/norma.stml
  Exemplar semanticum: NORMA (versio 2, PLASTICUM)

  Genus a Frane petitum: norma res est, non chorda - editorem,
  diem, statum, successionem habet. Normae se invicem SUBSTITUUNT:
  catena temporalis (stratum historicum in relationibus ipsis).
-->
<natura modulus="norma" versio="2" lingua="latina">

<genus nomen="norma">

  <definitio>
    Documentum publicum quod formam praescribit: quid conformitas
    significet definit. A re normata distinguitur - norma de
    lingua C non EST lingua C; descriptio auctoritativa est.
  </definitio>

  <proprietates>
    <proprietas nomen="index" genus="textus"
      nota="designatio canonica, e.g. ISO/IEC 9899:1990"/>
    <proprietas nomen="titulus" genus="textus"/>
    <proprietas nomen="publicata" genus="dies"/>
  </proprietates>
  <!-- editor olim textus erat (mendacium commoditatis conscium)
       - nunc relatio ad corpus_normans, exemplari organizationis
       nato (v0->v1) -->


  <machina_statuum nomen="vigor">
    <status nomen="proposita" nota="in deliberatione"/>
    <status nomen="vigens"/>
    <status nomen="substituta"
      nota="a successore; adhuc citabilis - normae veteres non
            evanescunt, C89 noster testis"/>
    <status nomen="retracta"/>
    <transitus a="proposita" ad="vigens" per="publicatio"/>
    <transitus a="vigens" ad="substituta" per="substitutio"/>
    <transitus a="vigens" ad="retracta" per="retractio"/>
  </machina_statuum>

  <actiones>
    <actio nomen="publicari"/>
    <actio nomen="substitui" nota="a norma recentiore"/>
  </actiones>

  <relationes>
    <relatio nomen="editor" ad="corpus_normans"
      modulus="organizatio" multiplex="verum"/>
    <relatio nomen="substituit" ad="norma"
      nota="catena successionis - historia in relationibus"/>
    <relatio nomen="normat" ad="*"
      nota="rem normatam cuiusvis generis - linguam, protocollum,
            formam plagulae"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <individuum nomen="iso_9899_1990">
    <valor nomen="index">ISO/IEC 9899:1990</valor>
    <valor nomen="titulus">Programming languages - C</valor>
    <valor nomen="publicata">1990-12-15</valor>
    <relatum nomen="editor" ad="iso" modulus="organizatio"/>
    <relatum nomen="editor" ad="iec" modulus="organizatio"/>
    <valor nomen="vigor">substituta</valor>
    <relatum nomen="normat" ad="c89"
      modulus="lingua_programmandi"/>
  </individuum>

  <individuum nomen="iso_9899_1999">
    <valor nomen="index">ISO/IEC 9899:1999</valor>
    <valor nomen="titulus">Programming languages - C</valor>
    <valor nomen="publicata">1999-12-01</valor>
    <relatum nomen="editor" ad="iso" modulus="organizatio"/>
    <relatum nomen="editor" ad="iec" modulus="organizatio"/>
    <valor nomen="vigor">substituta</valor>
    <relatum nomen="substituit" ad="iso_9899_1990"/>
    <relatum nomen="normat" ad="c99"
      modulus="lingua_programmandi"/>
  </individuum>

  <individuum nomen="posix_1">
    <valor nomen="index">IEEE Std 1003.1</valor>
    <valor nomen="titulus">Portable Operating System Interface</valor>
    <valor nomen="publicata">1988</valor>
    <relatum nomen="editor" ad="ieee" modulus="organizatio"/>
    <valor nomen="vigor">vigens</valor>
    <dubium>
      Editio "1003.1" continenter renovatur (1988, 2001, 2008,
      2024...) - norma UNA vivens an series normarum se
      substituentium? Idem dubium quod versiones linguarum:
      identitas rei trans editiones. Solutio versio-generis
      fortasse hic quoque valet.
    </dubium>
  </individuum>

</genus>

<!-- ==================================================
     LEX - praeceptum quod OBLIGAT, non quod dirigit

     Divisio quam magistratus (organizatio, rota XIV) iam
     implicabat et hoc exemplar non secutum est: auctoritas
     corporis normantis EX CONSENSU, magistratus EX IMPERIO.
     Ergo et documenta eorum differunt - normae CONFORMARIS,
     lex TE OBLIGAT sive consentias sive non.
     ================================================== -->

<genus nomen="lex">

  <definitio>
    Ordinatio rationis ad bonum commune, ab eo qui curam
    communitatis habet promulgata (Thomas, ST I-II q.90 a.4):
    non consilium sed praeceptum, cum vi obligandi et
    plerumque cum sanctione. A norma differt FONTE
    AUCTORITATIS - norma conformitatem OFFERT, lex
    oboedientiam POSCIT.
  </definitio>

  <proprietates>
    <proprietas nomen="sanctio" genus="textus"
      nota="poena violationi adnexa - non omni legi (leges
            imperfectae sine poena exsistunt), sed plerisque"/>
    <proprietas nomen="vacatio" genus="quantitas"
      modulus="mensura"
      nota="VACATIO LEGIS: intervallum inter promulgationem et
            vim obligandi, ut lex sciri possit antequam
            obliget. Status quem schemata binaria (lata/vigens)
            perdunt, et quo praeparatio negotiorum tota
            nititur"/>
  </proprietates>

  <machina_statuum nomen="vigor" gerens="individuum">
    <status nomen="lata" nota="ab auctoritate sancita, nondum
      promulgata - textus, nondum lex"/>
    <status nomen="promulgata" nota="publicata, in vacatione"/>
    <status nomen="vigens"/>
    <status nomen="abrogata" nota="ab auctoritate sublata"/>
    <status nomen="desueta"
      nota="vi consuetudinis contrariae amissa, NULLO ACTU -
            lex quam mora et usus occidunt, non legislator"/>
    <transitus a="lata" ad="promulgata" per="promulgatio"
      nota="ACTUS SOLLEMNIS - vide actus.promulgatio: ante eum
            lex non est, textus tantum"/>
    <transitus a="promulgata" ad="vigens" per="lapsus_vacationis"/>
    <transitus a="vigens" ad="abrogata" per="abrogatio"/>
    <transitus a="vigens" ad="desueta" per="desuetudo"/>
  </machina_statuum>

  <relationes>
    <relatio nomen="lata_a" ad="magistratus" modulus="organizatio"
      nota="auctoritas ex imperio - unde differentia a norma"/>
    <relatio nomen="in_iurisdictione" ad="iurisdictio"
      modulus="locus"
      nota="lex FINES habet: extra iurisdictionem non obligat.
            Norma fines non habet (ISO ubique eadem est) -
            differentia practica gravissima inter genera"/>
    <relatio nomen="promulgata_per" ad="actus_sollemnis"
      modulus="actus"/>
    <relatio nomen="abrogat" ad="lex" multiplex="verum"/>
    <relatio nomen="parit" ad="obligatio" modulus="obligatio"
      multiplex="verum"
      nota="obligatio ex lege - hic fons eius describitur"/>
  </relationes>

  <!-- ================= DICTIONARIUM =================
       divisio Thomistica (ST I-II qq. 91-95): genera legis
       per FONTEM, non per materiam -->

  <species nomen="lex_aeterna">
    <definitio>
      Ratio divinae sapientiae universum gubernans: fons
      omnium legum, ipsa a nullo lata.
    </definitio>
  </species>

  <species nomen="lex_naturalis">
    <definitio>
      Participatio legis aeternae in creatura rationali: quod
      homo ratione sua cognoscit esse faciendum aut vitandum,
      nullo legislatore humano dicente.
    </definitio>
    <nota>
      Species quae discrimen legis a norma ad extremum ducit:
      nemo eam tulit, nulla iurisdictio eam terminat, nulla
      abrogatio eam tollit - et tamen obligat. Lex sine
      legislatore humano, quod norma esse omnino non potest.
    </nota>
  </species>

  <species nomen="lex_humana">
    <definitio>
      Ex lege naturali per rationem derivata et ab auctoritate
      humana lata: civilis aut canonica. Sola species quam
      applicationes fere semper tractabunt.
    </definitio>
    <nota>
      Derivatio DUPLEX (Thomas): per CONCLUSIONEM ("noli
      nocere" ergo "noli occidere" - quod ubique idem est) et
      per DETERMINATIONEM ("puniendum est" ergo "poena haec" -
      quod arbitrio legislatoris variat). Unde leges quaedam
      per orbem conveniunt, aliae per iurisdictiones dissonant:
      non inconstantia sed duo modi derivandi.
    </nota>
  </species>

  <species nomen="lex_divina_positiva">
    <definitio>
      A Deo revelata, ratione sola non cognoscibilis: quod
      humana ratio ad finem supernaturalem non attingit.
    </definitio>
  </species>

  <species nomen="consuetudo">
    <definitio>
      Usus diuturnus communitatis cum animo se obligandi, a
      legislatore tolerata: lex NON SCRIPTA quae tamen obligat.
    </definitio>
    <nota>
      Species quae machinam supra FLECTIT: consuetudo nullum
      actum promulgationis habet - non promulgatur sed CRESCIT,
      et vim ex tempore et consensu accipit. Machina nostra
      promulgationem poscit; haec species eam praeterit.
      Dubium: an transitus "introductio per usum" addendus sit,
      an consuetudo machinam propriam petat. APERTUM.
    </nota>
  </species>

</genus>

</natura>