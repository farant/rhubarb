<?xml version="1.0" encoding="UTF-8"?>
<!--
  natura/locus.genera
  Exemplar semanticum: LOCUS (versio 0, PLASTICUM)
  Genera: locus, inscriptio, iurisdictio, aedificium.

  Natum ex experimento pistrinae: taberna alicubi EST, et hoc
  omnia mutat - quas leges sequitur, quis eam inspicit, quo
  clientes veniunt.

  DISTINCTIO PRIMA: locus in NATURA est (punctum terrae);
  inscriptio NOMEN loci est (conventio postalis, mutabilis
  manente loco); iurisdictio POTESTAS super locum est. Tria
  quae schemata vulgaria in "address" unum confundunt - et
  confusio dolet, quia inscriptio mutari potest sine motu, et
  iurisdictio mutari potest sine motu quoque (fines mutantur,
  civitates oriuntur).
-->
<natura modulus="locus" versio="0" lingua="latina">

<.genus nomen="locus">

  <definitio>
    Pars spatii determinata ubi res corporeae esse possunt:
    punctum aut area in terra. Ante omnem nominationem est -
    locus manet etiamsi nomen eius pereat.
  </definitio>

  <glossa lingua="en">A place: a determinate part of space where
    bodily things can be - a point or an area on the earth. It is
    prior to all naming: the place remains even if its name
    perishes.</glossa>
  <glossa lingua="fr">Un lieu : une partie déterminée de
    l'espace où des choses corporelles peuvent se trouver - un
    point ou une aire sur la terre. Il est antérieur à toute
    dénomination : le lieu demeure même si son nom
    disparaît.</glossa>

  <proprietates>
    <proprietas nomen="latitudo" genus="numerus"
      nota="gradus; coordinatae identitatem stabilem dant quam
            inscriptiones non dant"/>
    <proprietas nomen="longitudo_geo" genus="numerus"/>
  </proprietates>

  <relationes>
    <relatio nomen="intra" ad="locus"
      nota="loci se continent: taberna in vico, vicus in urbe -
            hierarchia partitiva"/>
    <relatio nomen="sub_iurisdictione" ad="iurisdictio"
      multiplex="verum"
      nota="MULTIPLEX vere: idem locus sub municipio, provincia,
            civitate simul est - potestates se superponunt"/>
  </relationes>

</.genus>

<!-- ==================================================
     INSCRIPTIO - nomen loci conventum
     ================================================== -->

<.genus nomen="inscriptio">

  <definitio>
    Nomen loci ad inveniendum conventum: via, numerus, urbs,
    codex postalis. CONVENTIO est, non locus - vici renominantur,
    numeri mutantur, codices postales finguntur, loco immoto.
  </definitio>

  <glossa lingua="en">An address: the agreed name of a place,
    used to find it - street, number, city, postal code. It is a
    CONVENTION, not the place: streets are renamed, numbers
    change, postal codes are invented, while the place itself
    does not move.</glossa>
  <glossa lingua="fr">Une adresse : le nom convenu d'un lieu,
    servant à le trouver - rue, numéro, ville, code postal. C'est
    une CONVENTION, non le lieu : les rues sont rebaptisées, les
    numéros changent, les codes postaux sont inventés, alors que
    le lieu ne bouge pas.</glossa>

  <proprietates>
    <proprietas nomen="linea" genus="textus" multiplex="verum"
      nota="lineae plures, ordine servato - forma inscriptionis
            per civitates VARIAT (codex ante urbem, post urbem;
            numerus ante viam, post viam): schema unum omnibus
            aptum non est, mendacium vulgare"/>
    <proprietas nomen="codex_postalis" genus="textus"/>
  </proprietates>

  <relationes>
    <relatio nomen="designat" ad="locus"/>
  </relationes>

</.genus>

<!-- ==================================================
     IURISDICTIO - potestas super locum
     ================================================== -->

<.genus nomen="iurisdictio">

  <definitio>
    Potestas legum ferendarum et exigendarum super loco:
    municipium, provincia, civitas. Non locus sed POTESTAS -
    ideo se superponere possunt (idem locus sub tribus simul),
    quod loci ipsi non possunt.
  </definitio>

  <glossa lingua="en">A jurisdiction: the power to make and
    enforce laws over a place - municipality, province, state.
    Not a place but a POWER, which is why jurisdictions can
    overlap (the same place under three at once), something
    places themselves cannot do.</glossa>
  <glossa lingua="fr">Une juridiction : le pouvoir de faire des
    lois et de les faire appliquer sur un lieu - commune,
    province, État. Non pas un lieu mais un POUVOIR, et c'est
    pourquoi les juridictions peuvent se superposer (le même lieu
    sous trois à la fois), ce que les lieux eux-mêmes ne peuvent
    pas.</glossa>

  <relationes>
    <relatio nomen="exercetur_a" ad="organizatio"
      modulus="organizatio"
      nota="magistratus - sub-genus organizationis ab hoc
            exemplari postulatum"/>
    <relatio nomen="fert" ad="norma" modulus="norma"
      multiplex="verum"
      nota="leges et regulae sanitatis - unde inspectio
            pistrinae"/>
    <relatio nomen="intra" ad="iurisdictio"
      nota="hierarchia potestatum, distincta ab hierarchia
            locorum"/>
  </relationes>

</.genus>

<!-- ==================================================
     AEDIFICIUM - res corporea loco fixa
     ================================================== -->

<.genus nomen="aedificium">

  <definitio>
    Structura loco fixa quam homines occupant: res corporea
    quae moveri non potest - immobilitas essentia eius, unde
    "res immobiles" in iure.
  </definitio>

  <glossa lingua="en">A building: a structure fixed to a place
    which people occupy - a bodily thing that cannot be moved.
    Immobility is its essence, whence the legal term immovable
    property.</glossa>
  <glossa lingua="fr">Un bâtiment : une structure fixée à un
    lieu et que des hommes occupent - une chose corporelle qui ne
    peut être déplacée. L'immobilité est son essence, d'où le
    terme juridique de biens immeubles.</glossa>

  <partes>
    <pars nomen="spatia" necessaria="verum"
      nota="cellae interiores: pistrinum, taberna, cella
            frigida - spatium quodque usum proprium habet"/>
  </partes>

  <relationes>
    <relatio nomen="situm_in" ad="locus"/>
    <relatio nomen="inscriptio_eius" ad="inscriptio"/>
    <relatio nomen="occupatum_a" ad="*" multiplex="verum"
      nota="persona aut organizatio - per contractum locationis
            plerumque (vide obligatio.locatio_conductio)"/>
  </relationes>

</.genus>

</natura>
