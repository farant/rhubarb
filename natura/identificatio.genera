<?xml version="1.0" encoding="UTF-8"?>
<!--
  natura/identificatio.genera
  Exemplar semanticum: IDENTIFICATIO (versio 1, PLASTICUM)
  Genus schema_identificandi + species e teste EXPOSITIONIS
  electae.

  Natum ex regula Fran (rota XXIV): PRAEFER GENUS SPECIFICUM.
  "Identificator" verum est sed onus non fert; ISBN onus fert -
  quid designet, quomodo probetur, quando mutatus sit.

  DISCRIMEN QUOD HOC EXEMPLAR A LINGUIS DISTINGUIT (Fran):
  linguae SINGULARIA sunt - una C, una Python; ideo species aut
  individua, sine sub-generibus. Ratio identificandi contra
  GENUS est cuius instantiae innumerae sunt: ISBN unum est,
  numeri ISBN miliones. Ideo hic proprietates communes vere
  operantur - quod omnibus rationibus commune est ONUS fert
  quod quaeque species implet.

  SYNERGIA (Fran, ratio ipsa bibliothecae): antea liber campum
  habebat "isbn" generis TEXTUS - chorda nuda, nihil sciens.
  Nunc campus genus IDENTIFICATIONIS habet, et peritia tota
  (structura, nota custos, quid designet, an reassignabilis)
  ADVENIT GRATIS, quamvis de LIBRIS solis cogitares.
  Vide opus_scriptum.editio.index_isbn - iam ita typatum.

  QUOUSQUE ENUMERANDUM: probatio EXPOSITIONIS (METAMODULUS §9),
  non dignitatis. Hae decem paene inevitabiles sunt; VIN,
  codices nationales, tesserae fiscales caudam longam
  incolunt et exspectent donec specimen adveniat.
-->
<natura modulus="identificatio" versio="1" lingua="latina">

<fontes>
  <fons clavis="corpus" genus="corpus_institutionis"
    modulus="iudicium" verificatus="falsum">
    Corpus institutionis scribae: algorithmi notarum custodum,
    structurae, dies. NON VERIFICATUM - lector ad fontes
    normativos (ISO, agentiae) vocatur. Hoc exemplar plus
    quam cetera verificatione eget: numeri PRECISI sunt et
    facunde falli possunt.
  </fons>
</fontes>

<genus nomen="schema_identificandi">

  <definitio>
    Ratio instituta nomina rebus assignandi, ita ut nomen unum
    rem unam designet intra ambitum suum: structura definita,
    auctoritas administrans, regulae assignandi. Non
    identificator ipse sed FORMA identificatorum - ISBN ratio
    est, "978-0-13-110362-7" identificator.
  </definitio>

  <proprietates>
    <proprietas nomen="quid_designat" genus="textus"
      nota="PROPRIETAS GRAVISSIMA, et saepissime neglecta: ISBN
            EDITIONEM designat non opus, E.164 LINEAM non
            hominem, ORCID PERSONAM trans nomina et
            institutiones. Qui hoc ignorat schema aedificat
            quod res alias numerat quam putat"/>
    <proprietas nomen="opacus" genus="veritas"
      nota="verum = nihil significat (UUID); falsum = partes
            sensum ferunt (ISBN editorem, IBAN argentariam).
            Distinctio 'callidi/stulti' identificatoris: callidus
            informationem praebet sed MUTARI potest cum res
            mutatur (editor venditus), stultus nihil promittit
            et nihil frangit"/>
    <proprietas nomen="reassignabilis" genus="veritas"
      ordinarius="falsum"
      nota="an idem identificator alii rei postea dari possit.
            FONS INSECTORUM GRAVISSIMUS: numeri telephonici
            REASSIGNANTUR, ideo 'idem numerus' non significat
            'eadem persona' - restitutio rationum per nuntios
            telephonicos hic frangitur. ISBN reassignari NON
            debet, interdum tamen fit"/>
    <proprietas nomen="probabilis_solus" genus="veritas"
      nota="an sine registro probari possit (nota custos) an
            interrogatio necessaria sit. Nota custos errores
            SCRIBENDI capit, non identificatorem FICTUM:
            numerus bene formatus exsistere non necesse est"/>
    <proprietas nomen="longitudo_fixa" genus="veritas"/>
    <proprietas nomen="praesentatio" genus="textus"
      nota="lineolae, spatia, capitalia = CONVENTIO non
            essentia (eadem lex qua suffixa plagularum):
            '978-0-13-110362-7' et '9780131103627' idem sunt.
            Qui lineolas servat et comparat duos identificatores
            eosdem diversos iudicabit"/>
  </proprietates>

  <partes>
    <pars nomen="praefixum" necessaria="falsum"
      nota="ambitum aut auctoritatem designans"/>
    <pars nomen="corpus_identificatoris" necessaria="verum"/>
    <pars nomen="nota_custos" necessaria="falsum"/>
  </partes>

  <machina_statuum nomen="vigor" gerens="individuum">
    <status nomen="vigens"/>
    <status nomen="clausa"
      nota="nova non assignantur, vetera valent - status quem
            ISBN-10 tenet: numeri exsistentes legitimi manent,
            novi non dantur. Schemata raro MORIUNTUR, plerumque
            CLAUDUNTUR"/>
    <status nomen="obsoleta"/>
    <transitus a="vigens" ad="clausa" per="clausura"/>
    <transitus a="clausa" ad="obsoleta" per="desuetudo"/>
  </machina_statuum>

  <relationes>
    <relatio nomen="administrata_a" ad="organizatio"
      modulus="organizatio"
      nota="ratio sine auctoritate ratio non est - quis numeros
            dat, quis conflictus solvit"/>
    <relatio nomen="normata_per" ad="norma" modulus="norma"/>
    <relatio nomen="gignit" ad="identificator_baptismalis"
      modulus="elementa_programmatis"
      nota="ratio identificandi MACHINA est quae identificatores
            baptismales cudit (vide lineam Scoti): nomen datum,
            non ex contento derivatum"/>
    <relatio nomen="successit" ad="schema_identificandi"/>
  </relationes>

  <!-- ================= DICTIONARIUM =================
       probatio EXPOSITIONIS: his omnibus applicatio quaevis
       fere occurret -->

  <species nomen="uuid">
    <definitio>
      Identificator 128 bitorum sine auctoritate centrali:
      spatium tam amplum ut collisio fortuita neglegi possit.
      Ratio quae PROBLEMA COORDINATIONIS SOLVIT probabilitate,
      non registro - unde ubiquitas eius in systematibus
      distributis.
    </definitio>
    <valor nomen="opacus">verum</valor>
    <valor nomen="probabilis_solus">falsum</valor>
    <valor nomen="longitudo_fixa">verum</valor>
    <valor nomen="quid_designat">quidlibet - ambitus ab
      applicatione datur, non a ratione</valor>
    <valor nomen="praesentatio">octo-quattuor-quattuor-quattuor-
      duodecim digiti hexadecimales lineolis iuncti</valor>
    <nota>
      Nulla nota custos: numerus male scriptus indiscernibilis
      est. Pretium carentiae auctoritatis - nemo probat quia
      nemo administrat.
    </nota>
  </species>

  <species nomen="ulid">
    <definitio>
      Identificator 128 bitorum cuius pars prior TEMPUS fert,
      ideo lexicographice ordinabilis: unde in indicibus
      ordinatis melius sedet quam UUID fortuitus.
    </definitio>
    <valor nomen="opacus">falsum</valor>
    <valor nomen="longitudo_fixa">verum</valor>
    <nota>
      Domus nostra hoc utitur (tabularium, res omnes). Testis
      quod opacitas ELECTIO est cum pretio: ULID ordinem donat
      et momentum creationis PRODIT - quod aliquando commodum,
      aliquando indiscretio.
    </nota>
  </species>

  <species nomen="isbn">
    <definitio>
      Ratio libros identificandi ab industria libraria
      instituta: praefixum coetus, editor, titulus, nota
      custos.
    </definitio>
    <valor nomen="quid_designat">EDITIONEM (manifestationem),
      non opus nec expressionem</valor>
    <valor nomen="opacus">falsum</valor>
    <valor nomen="probabilis_solus">verum</valor>
    <valor nomen="reassignabilis">falsum</valor>
    <relatum nomen="administrata_a" ad="agentia_isbn"
      modulus="organizatio"
      nota="impleta rota XLV: individuum sub organizatione
            descripta (historia umbrae: primo ad genus
            'organizatio' falso, tum umbra vera nominata, nunc
            res ipsa)"/>
    <nota>
      MENDACIUM VULGARE (exemplar librorum rota VII iam
      occidit, hic ratio ipsa id dicit): catalogi qui ISBN pro
      identitate LIBRI habent editiones numerant et opera
      vocant. Moby-Dick opus unum, ISBN multa.
    </nota>

    <species nomen="isbn_10">
      <definitio>
        Forma antiquior, decem characterum: nota custos modulo
        undecim, unde character 'X' pro valore decem - unicus
        in his rationibus qui litteram in nota custode fert.
      </definitio>
      <valor nomen="vigor">clausa</valor>
      <historia>
        <eventum quando="1970" certitudo="fides" fons="corpus">
          ut norma ISO recepta
        </eventum>
        <eventum quando="2007-01-01" certitudo="fides"
          fons="corpus">
          nova assignatio cessavit - ad ISBN-13 transitum
        </eventum>
      </historia>
    </species>

    <species nomen="isbn_13">
      <definitio>
        Forma hodierna, tredecim digitorum: praefixo 978 aut
        979 aucta, ut in spatium EAN codicum mercium
        conveniret - nota custos ideo EAN, modulo decem
        ponderibus alternis.
      </definitio>
      <nota>
        Testis quod rationes se INVICEM ABSORBENT: ISBN in
        GTIN migravit ut libri in tabernis ut merces ceterae
        legerentur. Numerus idem duas rationes simul servit.
      </nota>
    </species>
  </species>

  <species nomen="issn">
    <definitio>
      Ratio SERIES identificandi (ephemerides, acta): octo
      digiti, nota custos modulo undecim cum 'X'.
    </definitio>
    <valor nomen="quid_designat">SERIEM ipsam, non fasciculum
      nec articulum - unde ISSN unum per ephemeridem, per
      saecula</valor>
    <valor nomen="probabilis_solus">verum</valor>
    <nota>
      Geminum ISBN quod discrimen operis/manifestationis aliter
      secat: liber editiones habet, ephemeris fasciculos - et
      ISSN totum designat, ISBN partem.
    </nota>
  </species>

  <species nomen="doi">
    <definitio>
      Identificator documentorum PERSISTENS et RESOLVABILIS:
      praefixum editoris (10.NNNN) et suffixus liber. Non
      solum nominat sed ad locum praesentem DUCIT per
      registrum.
    </definitio>
    <valor nomen="quid_designat">documentum (articulum,
      datorum copiam) trans mutationes loci</valor>
    <valor nomen="probabilis_solus">falsum</valor>
    <valor nomen="longitudo_fixa">falsum</valor>
    <nota>
      SOLUTIO PROBLEMATIS QUOD URL HABET: locus mutatur, nomen
      manet, registrum medium est. Ratio quae INSTITUTIONEM
      poscit ut vivat - si registrum cadit, identificator
      nomen nudum fit.
    </nota>
  </species>

  <species nomen="orcid">
    <definitio>
      Identificator PERSONARUM in re litteraria: sedecim
      digiti, nota custos ISO 7064 modulo 11-2 cum 'X'.
    </definitio>
    <valor nomen="quid_designat">personam - trans nomina
      mutata, institutiones, homonymos</valor>
    <valor nomen="probabilis_solus">verum</valor>
    <relatum nomen="gignit" ad="identificator_baptismalis"
      modulus="elementa_programmatis"/>
    <nota>
      Ratio nata quia NOMINA PERSONAS NON IDENTIFICANT:
      homonymi multi, nomina mutantur (matrimonio, religione,
      translitteratione). Confirmat proprietatem 'nomina'
      exemplaris personae esse MULTIPLICEM - et ostendit cur
      identificator opus sit.
    </nota>
  </species>

  <species nomen="iban">
    <definitio>
      Ratio rationum argentariarum trans fines: codex
      civitatis, duo digiti custodes, codex argentariae et
      numerus rationis intus - nota custos modulo 97.
    </definitio>
    <valor nomen="quid_designat">rationem argentariam</valor>
    <valor nomen="opacus">falsum</valor>
    <valor nomen="probabilis_solus">verum</valor>
    <valor nomen="longitudo_fixa">falsum</valor>
    <nota>
      Longitudo per civitates VARIAT (15-34 characteres) -
      testis quod 'longitudo fixa' proprietas rationis est,
      non identificationis in genere. Nota custos modulo 97
      fortissima harum: errores scribendi et transpositiones
      fere omnes capit.
    </nota>
  </species>

  <species nomen="e164">
    <definitio>
      Ratio numerorum telephonicorum mundi: codex civitatis et
      numerus nationalis, quindecim digitis non excedens.
    </definitio>
    <valor nomen="quid_designat">LINEAM (aut abonnement), non
      hominem - discrimen quod schemata identitatis
      perdunt</valor>
    <valor nomen="reassignabilis">verum</valor>
    <valor nomen="probabilis_solus">falsum</valor>
    <valor nomen="longitudo_fixa">falsum</valor>
    <nota>
      SPECIES QUAE PROPRIETATEM 'REASSIGNABILIS' POSTULAVIT:
      numeri relicti post tempus aliis dantur, ideo "idem
      numerus" NON significat "eadem persona". Systemata quae
      numerum pro identitate habent (restitutio rationum per
      nuntium) hic franguntur - et fractura non rara sed
      certa est, tempore solo.
    </nota>
    <nota>
      Rationes NATIONALES intus vivunt et propria historia
      mutantur: Brasilia digitum nonum numeris mobilibus
      addidit (per regiones, 2010-2016), ideo numerus olim
      validus hodie brevis est. Exemplum quod Fran nominavit:
      ratio generalis (E.164) rationem localem NON continet,
      et applicatio utramque scire debet.
    </nota>
  </species>

  <species nomen="gtin">
    <definitio>
      Ratio mercium in commercio (EAN, UPC): praefixum
      societatis, numerus mercis, nota custos modulo decem
      ponderibus alternis.
    </definitio>
    <valor nomen="quid_designat">GENUS mercis, non exemplar
      singulare - omnes eiusdem lactis lagoenae idem GTIN
      ferunt</valor>
    <valor nomen="opacus">falsum</valor>
    <valor nomen="probabilis_solus">verum</valor>
    <nota>
      Discrimen quod inventarium totum regit: GTIN speciem
      numerat, numerus seriei individuum. Qui GTIN pro
      individuo habet duas lagoenas unam putabit.
    </nota>
  </species>

  <species nomen="uri">
    <definitio>
      Ratio generalissima: nomen cum schemate quod
      interpretationem regit (http, mailto, urn, et nostrum
      'massa').
    </definitio>
    <valor nomen="quid_designat">quidlibet - schema intus
      ambitum determinat</valor>
    <valor nomen="probabilis_solus">falsum</valor>
    <valor nomen="longitudo_fixa">falsum</valor>
    <nota>
      DISTINCTIO INTUS: URL locum dicit (ubi res est), URN
      nomen solum (quid res est). Qui URL pro identitate
      perenni habet locum cum re confundit - unde DOI natum
      est. Ratio quae rationes ALIAS continere potest
      (urn:isbn:...), unde vis eius et ambiguitas.
    </nota>
  </species>

  <!-- ORDO PHARMACEUTICUS (cursus septimus): quattuor schemata
       quae SCALAM pharmaci alloquuntur, singula gradu suo -
       probatio quod gradus illi reales sunt, quia dominium
       cuique identificatorem proprium dedit. Numerus DEA
       additur ut specimen schematis quod AUCTORITATEM
       identificat, non rem. -->

  <species nomen="cas">
    <definitio>
      Numerus quo Chemical Abstracts Service substantias
      chemicas registrat: nihil de structura dicens, sed unicus
      et perpetuus - registrum, non descriptio.
    </definitio>
    <valor nomen="quid_designat">SUBSTANTIAM chemicam, non
      acervum nec productum</valor>
    <valor nomen="opacus">verum</valor>
    <valor nomen="probabilis_solus">verum</valor>
    <valor nomen="reassignabilis">falsum</valor>
    <valor nomen="longitudo_fixa">falsum</valor>
    <nota>
      Schema quod gradum infimum scalae pharmaceuticae
      alloquitur (vide pharmacon.substantia_chemica) -
      probatio quod ille gradus res vera est, non abstractio
      nostra.
    </nota>
  </species>

  <species nomen="ndc">
    <definitio>
      Codex nationalis medicamentorum (Civitatum Foederatarum):
      tres partes - fabricator, productum (substantia, vis,
      forma), fasciculus (magnitudo).
    </definitio>
    <valor nomen="quid_designat">PRODUCTUM in fasciculo certo -
      gradum supra medicamentum, infra cocturam</valor>
    <valor nomen="opacus">falsum</valor>
    <valor nomen="probabilis_solus">falsum</valor>
    <valor nomen="reassignabilis">falsum</valor>
    <nota>
      CAVE QUOD SCHEMA NON DICIT: NDC cocturam non alloquitur.
      Revocatio ergo NDC et numerum cocturae SIMUL nominare
      debet - quod probat cocturam gradum proprium esse, non
      NDC subdivisionem.
    </nota>
  </species>

  <species nomen="rxnorm">
    <definitio>
      Vocabularium normatum quo medicamenta clinica nominantur
      et gradus inter se nectuntur: ingrediens, medicamentum
      clinicum, nomen mercatorium, fasciculus.
    </definitio>
    <valor nomen="quid_designat">MEDICAMENTUM clinicum
      (substantia + vis + forma)</valor>
    <valor nomen="opacus">verum</valor>
    <valor nomen="reassignabilis">falsum</valor>
    <nota>
      SCHEMA QUOD SCALAM IPSAM FERT, non gradum unum: gradus
      nominat ET nexus inter eos. Rarum et instructivum -
      pleraque schemata gradum unum alloquuntur et nexus aliis
      relinquunt. Quod bibliotheca nostra generibus facit,
      RxNorm intra schema unum fecit.
    </nota>
  </species>

  <species nomen="numerus_dea">
    <definitio>
      Numerus quo auctoritas Americana eos registrat quibus
      substantias regulatas praescribere aut tractare licet:
      litterae duae, deinde novem numeri quorum ultimus custos
      est.
    </definitio>
    <valor nomen="quid_designat">AUCTORITATEM praescribendi -
      personam qua praescriptor, non personam simpliciter</valor>
    <valor nomen="opacus">falsum</valor>
    <valor nomen="probabilis_solus">verum</valor>
    <valor nomen="longitudo_fixa">verum</valor>
    <nota>
      SPECIMEN QUOD GENUS ALIUD ALLOQUITUR: non rem sed
      TITULUM (obligatio.titulus) - facultatem quam persona
      gerit et amittere potest. Ideo numerus cum officio
      moritur, persona vivente. Nota custos praescriptiones
      fictas prohibet, quod probat schemata identificandi
      munus SECURITATIS quoque gerere - pharmacopola numerum
      computare potest antequam credat.
    </nota>
  </species>

</genus>

</natura>
