<?xml version="1.0" encoding="UTF-8"?>
<!--
  natura/animal.genera
  Exemplar semanticum: ANIMAL (versio 1, PLASTICUM)
  Genus animal (sub corporalia.vivens), species homo inclusa.

  Umbra vetustissima bibliothecae IMPLETA: animal a planta
  rota VII superfectum est (pollinatur_a), decem rotas
  exspectavit, et cursus secundus circuli (valetudinarium) eum
  tandem evocavit - corpus aegrotae animal est.

  ARBOR PORPHYRIANA HIC PERFICITUR:
    substantia -> corpus -> vivens -> ANIMAL -> animal
    rationale (homo)
  Forma nostra nomen ab hac arbore traxit et eam sine consilio
  reconstruxit, ramum post ramum, per duas dies. Non imitatio:
  res ita se habent.

  DE HOMINE ET PERSONA (distinctio quam Fran quaeret): homo
  species animalis est - corpus, sensus, generatio. Persona
  (exemplar personae) "naturae rationabilis individua
  substantia" est. Homo utrumque EST simul; angelus persona
  est nec animal; canis animal est nec persona. Regula
  multiplicitatis (rota IV) hic maximum fructum fert: duo
  genera vera, unum ens.
-->
<natura modulus="animal" versio="1" lingua="latina">

<.genus nomen="animal" sub="vivens" modulus="corporalia">

  <differentia>
    SENSUM habet et motum localem: mundum percipit et se ad eum
    movet - unde appetitus, unde fuga, unde quaesitio. Planta
    manet et sumit quod advenit; animal quaerit.
  </differentia>

  <glossa lingua="en">An animal: a living thing that has sensation
    and local motion - it perceives the world and moves itself
    toward it, whence appetite, whence flight, whence seeking. A
    plant stays where it is and takes what comes to it; an animal
    goes looking.</glossa>
  <glossa lingua="fr">Un animal : un vivant qui a la sensation et
    le mouvement local - il perçoit le monde et se meut vers lui,
    d'où l'appétit, d'où la fuite, d'où la quête. La plante demeure
    et prend ce qui lui vient ; l'animal cherche.</glossa>

  <valor nomen="anima">sensitiva</valor>

  <proprietates>
    <proprietas nomen="victus" genus="electio">
      <optio>carnivorus</optio>
      <optio>herbivorus</optio>
      <optio>omnivorus</optio>
    </proprietas>
    <proprietas nomen="sanguine_calidus" genus="veritas"
      nota="temperatura interna servata contra ambientem -
            pretium: cibus multo maior"/>
    <proprietas nomen="vita_media" genus="quantitas"
      modulus="mensura"
      nota="AMBITUS vere (minimum/maximum): dubium plantae
            (rota VII) hic iam solutum nascitur - quantitas
            ambitum fert"/>
  </proprietates>

  <partes>
    <pars nomen="caput" necessaria="falsum"
      nota="honeste optionale: stella maris caput non habet.
            Partes animalium multo minus communes quam
            plantarum - regnum diversius"/>
    <pars nomen="cor" necessaria="falsum"/>
    <pars nomen="membra" necessaria="falsum"/>
  </partes>

  <machina_statuum nomen="aetas" gerens="individuum">
    <status nomen="fetus"/>
    <status nomen="pullus"/>
    <status nomen="adultus"/>
    <status nomen="senex"/>
    <transitus a="fetus" ad="pullus" per="nativitas"/>
    <transitus a="pullus" ad="adultus" per="maturitas"/>
    <transitus a="adultus" ad="senex" per="senectus"/>
  </machina_statuum>
  <!-- mors hic NON est: a vivente hereditatur, ubi rem aliam
       relinquit (mutatio substantialis) - hereditas machinarum
       recte operatur -->

  <actiones>
    <actio nomen="sentire"/>
    <actio nomen="moveri" nota="motus localis - differentia
      ipsa in actione"/>
    <actio nomen="generare"/>
  </actiones>

  <relationes>
    <relatio nomen="pollinat" ad="planta" modulus="planta"
      nota="conversum planta.pollinatur_a - identitas UNA in
            necessitudines declarata (par conversum primum),
            directio utraque nomine suo"/>
    <relatio nomen="praedatur" ad="animal"
      necessitudo="afficit" multiplex="verum"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <.species nomen="apis" gradus="genus">
    <definitio>
      Insectum sociale mel faciens: colonia ut unum agens
      (examen), communicatio per saltationem, pollinatio ut
      effectus secundarius nutritionis suae.
    </definitio>
    <differentia>
      Vivens cuius COLONIA proprietates habet quas individuum
      non habet (calor servatus, decisio communis) - societas
      biologica, quae organizationem nostram (universitas cum
      perduratione) mire imitatur.
    </differentia>
    <valor nomen="victus">herbivorus</valor>
    <relatum nomen="pollinat" ad="malus_domestica"
      modulus="planta"
      nota="umbra rotae VII (malus_domestica.pollinatur_a=apis)
            hic IMPLETA"/>
    <nota>
      Individuum quod exemplar plantarum poposcit. Decem rotas
      ut umbra stetit - testimonium quod umbrae computatae
      (natura_visus) agenda vera sunt, non decor.
    </nota>
  </.species>

  <.species nomen="canis" gradus="species">
    <definitio>
      Canis familiaris: lupus ab homine per millennia mutatus -
      species cuius forma ipsa OPUS HOMINIS est, sicut malus
      domestica inter plantas.
    </definitio>
    <valor nomen="victus">omnivorus</valor>
    <valor nomen="sanguine_calidus">verum</valor>
    <nota>
      Domestication utrimque: species quae hominem elegit non
      minus quam homo eam - relatio quam nulla proprietas
      capit, sed historia utriusque fert.
    </nota>

    <individuum nomen="laika" certitudo="scientia"
      nota="individuum primum sub specie (arbor porphyriana
            2026-08-10): species instantiabilis facta - olim
            canon individuum sub specie vetabat">
      <definitio>
        Canis Moscoviensis errabunda, primum animal quod orbem
        Terrae circumivit: in Sputnik II missa, in ipso itinere
        mortua. Res publici iuris - monumentum Moscuae stat.
      </definitio>
      <historia>
        <eventum quando="1957-11-03" certitudo="scientia">
          in Sputnik II in orbitam missa
        </eventum>
        <eventum quando="2008-04-11" certitudo="fides">
          monumentum Moscuae dedicatum
        </eventum>
      </historia>
    </individuum>
  </.species>

  <.species nomen="homo" gradus="species">
    <definitio>
      Animal rationale: corpus animale cum anima quae
      intellegit et eligit. Species in qua arbor Porphyriana
      terminatur - non quia infima sed quia hic ratio advenit.
    </definitio>
    <differentia>
      RATIONALITAS: universalia apprehendit, de fine deliberat,
      se ipsum cognoscit. Unde artes, unde leges, unde haec
      ipsa bibliotheca - naturalista species sua est.
    </differentia>
    <valor nomen="anima">rationalis</valor>
    <valor nomen="victus">omnivorus</valor>
    <valor nomen="sanguine_calidus">verum</valor>
    <nota>
      HOMO ET PERSONA: hoc genus corpus describit; exemplar
      personae rationalem substantiam individuam (Boethius).
      Homo utrumque simul est; angelus persona nec animal;
      canis animal nec persona. Duo genera vera, unum ens -
      regula multiplicitatis (rota IV) in casu gravissimo.
      Individua hominum in PERSONA vivunt, non hic: qui de
      Ritchie loquitur de persona loquitur, non de corpore.
    </nota>
  </.species>

</.genus>

</natura>
