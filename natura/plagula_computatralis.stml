<?xml version="1.0" encoding="UTF-8"?>
<!--
  natura/plagula_computatralis.stml
  Exemplar semanticum: PLAGULA COMPUTATRALIS (versio 2, PLASTICUM)

  Exemplar paroeciae maxime nostrum - quod silex olim consumet
  (plagulae repositorii specie sua notatae, non commutatione
  suffixuum improvisata).

  ARBOR ALTISSIMA ADHUC: genus -> sub-genera (fontis, scriptum,
  notationis, figurationis, datorum) -> sub-sub (sqlite) ->
  species (volumen NOSTRUM). Mechanismus novus: sub-genus
  proprietatem hereditatam FIGERE potest (<valor> in genere -
  omnes species infra eam ferunt).

  RHYTHMUS DOMESTICUS: identitas plagulae trans contentum mutatum
  perdurat - distinctio eadem quam volumen fecit (plagula nominata
  vs massa contentu addressata). Semantica nostra repositionem
  nostram iam noverat.
-->
<natura modulus="plagula_computatralis" versio="2" lingua="latina">

<genus nomen="plagula_computatralis">

  <definitio>
    Sequentia octetorum NOMINATA in systemate plagularum:
    identitas quae perdurat dum contentum mutatur (ut universitas
    mutatis membris). A contentu suo distinguitur - plagula res
    nominata est, contentum status eius temporalis.
  </definitio>

  <proprietates>
    <proprietas nomen="forma_contenti" genus="electio">
      <optio>textualis</optio>
      <optio>binaria</optio>
    </proprietas>
    <proprietas nomen="suffixus_solitus" genus="textus"
      multiplex="verum"
      nota="CONVENTIO, non essentia: plagula C sine .c manet
            plagula C - suffixus mos nominandi est"/>
    <proprietas nomen="mimen_solitum" genus="textus"
      nota="conventio item (registrum IANA)"/>
  </proprietates>

  <machina_statuum nomen="exsistentia">
    <status nomen="exsistens"/>
    <status nomen="ablata"/>
    <transitus a="exsistens" ad="ablata" per="deletio"/>
  </machina_statuum>

  <actiones>
    <actio nomen="creari"/>
    <actio nomen="scribi" nota="contentum mutatur, identitas
      manet"/>
    <actio nomen="legi"/>
    <actio nomen="moveri" nota="nomen/sedes mutatur, identitas
      manet - quaestio identitatis vetus, a volumine nostro iam
      responsa: identitas in actis vivit, non in via"/>
    <actio nomen="deleri"/>
  </actiones>

  <relationes>
    <relatio nomen="continetur_in" ad="directorium"
      nota="quaesitum umbrae RESOLUTUM (rota XLIV): directorium
            descriptum est, et 'estne ipsum plagula' relatione
            (directorium.est_plagula) respondetur, NON
            subordinatione - quia responsum a systemate pendet,
            et taxinomia unius systematis consilium in arborem
            suam inaedificare non debet"/>
    <relatio nomen="conformis_ad" ad="norma" modulus="norma"/>
  </relationes>

  <!-- dubium divisionis transversae SOLUTUM (Fran, v0->v1):
       entia res plures esse possunt. Gradus duo:
       (1) species essentialiter utraque (scriptum conchae ET
           fons est, semper) -> attributum etiam= in specie;
       (2) individuum accidentaliter utrumque (.py cum crena) ->
           classificatio individui in voluminibus, non hic.
       NB: exemplum Franis (persona auctor et inventor) iam
       mechanismo exsistente solutum erat - AUCTOR RELATIO est,
       non genus: munera relationes SUNT, et relationum quot res
       habet tot habet. -->


</genus>

<!-- ==================================================
     PLAGULA FONTIS - textus pro translatore et persona
     ================================================== -->

<genus nomen="plagula_fontis" sub="plagula_computatralis">

  <differentia>
    Textus a personis scriptus, a personis ET translatoribus
    lectus: forma exsecutionis futurae, non exsecutio ipsa.
  </differentia>

  <valor nomen="forma_contenti">textualis</valor>
  <!-- mechanismus novus: genus proprietatem hereditatam FIGIT -
       species infra omnes textuales sunt -->

  <relationes>
    <relatio nomen="scripta_in" ad="lingua_programmandi"
      modulus="lingua_programmandi"
      nota="relatio fons_scriptus_in exemplaris linguarum HIC
            impletur - externum v0 tandem domum venit"/>
    <relatio nomen="scripta_in_versione" ad="versio_linguae"
      modulus="lingua_programmandi"
      nota="finius quam lingua: 'hoc c89 est' - domus nostra
            hoc cotidie dicit"/>
  </relationes>

  <species nomen="fons_c">
    <definitio>Corpus translationis C: definitiones functionum
      et datorum.</definitio>
    <valor nomen="suffixus_solitus">.c</valor>
    <valor nomen="mimen_solitum">text/x-c</valor>
    <relatum nomen="scripta_in" ad="c"
      modulus="lingua_programmandi"/>
  </species>

  <species nomen="caput_c">
    <definitio>Caput C: declarationes communicandae -
      interfacies, non corpus. Convenio aedilis nostri: caput
      corpus suum nominat (include/X.h -> lib/X.c).</definitio>
    <differentia>Interfacies sine corpore: quod alii videre
      debent, nihil amplius.</differentia>
    <valor nomen="suffixus_solitus">.h</valor>
    <relatum nomen="scripta_in" ad="c"
      modulus="lingua_programmandi"/>
  </species>

  <species nomen="fons_python">
    <valor nomen="suffixus_solitus">.py</valor>
    <relatum nomen="scripta_in" ad="python"
      modulus="lingua_programmandi"/>
  </species>

  <species nomen="fons_rust">
    <valor nomen="suffixus_solitus">.rs</valor>
    <relatum nomen="scripta_in" ad="rust"
      modulus="lingua_programmandi"/>
  </species>

</genus>

<!-- ==================================================
     SCRIPTUM EXSECUTABILE - plagula quae programma EST
     (dubium divisionis transversae in genere parente)
     ================================================== -->

<genus nomen="scriptum_exsecutabile" sub="plagula_computatralis">

  <differentia>
    Directe exsequenda sine translatione praevia: crena (#!)
    interpretem suum ipsa nominat - plagula quae scit quomodo
    currere.
  </differentia>

  <valor nomen="forma_contenti">textualis</valor>

  <species nomen="scriptum_conchae" etiam="plagula_fontis">
    <definitio>Scriptum linguae iussuum: imperia quae manu dari
      possent, conservata.</definitio>
    <valor nomen="suffixus_solitus">.sh</valor>
    <relatum nomen="scripta_in" ad="bash"
      modulus="lingua_programmandi"
      nota="aut sh, zsh - relatio ad speciem usitatissimam"/>
    <!-- etiam: omne scriptum conchae essentialiter ET fons est
         (textus pro translatore) - membrum generum duorum,
         exemplum primum attributi etiam= -->
  </species>

</genus>

<!-- ==================================================
     PLAGULA NOTATIONIS - structura et prosa intertextae
     ================================================== -->

<genus nomen="plagula_notationis" sub="plagula_computatralis">

  <differentia>
    Contentum = prosa cum structura interposita: signa
    structuram ferunt, textus sensum - pro lectore humano
    per machinam formatus.
  </differentia>

  <valor nomen="forma_contenti">textualis</valor>

  <species nomen="plagula_xml">
    <valor nomen="suffixus_solitus">.xml</valor>
    <valor nomen="mimen_solitum">application/xml</valor>
  </species>

  <species nomen="plagula_stml">
    <definitio>Varians XML domus nostrae: notatio annotationum,
      quaestionum silvae, et horum ipsorum exemplarium.</definitio>
    <differentia>Hoc ipsum documentum species haec est -
      dictionarium se ipsum continet, honeste.</differentia>
    <valor nomen="suffixus_solitus">.stml</valor>
  </species>

  <species nomen="plagula_markdown">
    <valor nomen="suffixus_solitus">.md</valor>
    <valor nomen="mimen_solitum">text/markdown</valor>
  </species>

</genus>

<!-- ==================================================
     PLAGULA FIGURATIONIS - mores programmatis declarati
     ================================================== -->

<genus nomen="plagula_figurationis" sub="plagula_computatralis">

  <differentia>
    A programmate in initio lecta ut mores suos formet:
    declarativa, non exsecutiva - dicit quid, numquam quomodo.
  </differentia>

  <valor nomen="forma_contenti">textualis</valor>

  <species nomen="plagula_toml">
    <valor nomen="suffixus_solitus">.toml</valor>
    <nota>silex.toml nostra - capsulae figurantur hac specie</nota>
  </species>

  <species nomen="plagula_plist">
    <valor nomen="suffixus_solitus">.plist</valor>
    <nota>paroecia macOS</nota>
  </species>

</genus>

<!-- ==================================================
     PLAGULA DATORUM - pro programmatibus, non personis
     ================================================== -->

<genus nomen="plagula_datorum" sub="plagula_computatralis">

  <differentia>
    Contentum pro programmatibus primo: structura stricta,
    lector humanus hospes non dominus.
  </differentia>

  <species nomen="plagula_json">
    <valor nomen="forma_contenti">textualis</valor>
    <valor nomen="suffixus_solitus">.json</valor>
    <valor nomen="mimen_solitum">application/json</valor>
  </species>

  <species nomen="plagula_csv">
    <valor nomen="forma_contenti">textualis</valor>
    <valor nomen="suffixus_solitus">.csv</valor>
  </species>

</genus>

<!-- ==================================================
     PLAGULA SQLITE - sub-sub-genus (datorum profundius):
     basis datorum in plagula una
     ================================================== -->

<genus nomen="plagula_sqlite" sub="plagula_datorum">

  <differentia>
    Basis datorum integra in plagula una: tabulae, indices,
    transactiones - omnia intra sequentiam octetorum unam,
    sine servo.
  </differentia>

  <valor nomen="forma_contenti">binaria</valor>
  <valor nomen="suffixus_solitus">.db</valor>

  <species nomen="volumen">
    <definitio>
      Plagula sqlite schemate domus nostrae: acta (veritas,
      solum-appende), massae (contentum sigillo addressatum),
      plagulae (proiectio manifesti). Documentum = repositorium.
    </definitio>
    <differentia>
      Veritas eventilis intus: status quivis plicatura caudae
      est - plagula quae historiam suam integram fert.
    </differentia>
    <valor nomen="suffixus_solitus">.volumen</valor>
    <historia>
      <eventum quando="2026-08-03" actio="creari">natum in domo
        nostra (G2)</eventum>
    </historia>
    <nota>
      Arbor quattuor graduum hic completur: computatralis ->
      datorum -> sqlite -> volumen. Species profundissima
      dictionarii res nostra propria est - paroecia usque ad
      fundum.
    </nota>
  </species>

</genus>

<!-- ==================================================
     SYSTEMA PLAGULARUM et DIRECTORIUM

     Duae umbrae quae exercitio modellationis (silex+volumen)
     STATIM obstiterunt: 'fabrica' silicis directorium est, et
     nullum genus id ferebat. Exemplar plagularum septem genera
     plagulae habebat et locum ubi plagulae vivunt non habebat.
     ================================================== -->

<genus nomen="systema_plagularum">

  <definitio>
    Ordinatio quae sequentiis octetorum NOMINA, locum in arbore,
    et notas circumstantes dat: quod inter medium (discum,
    rete, memoriam) et nomina mediat. Sine eo octeti sunt,
    plagulae non sunt.
  </definitio>

  <proprietates>
    <proprietas nomen="capsas_discernit" genus="veritas"
      nota="an 'Chorda.h' et 'chorda.h' plagulae duae sint.
            PROPRIETAS QUAE MENSE OCTAVO MORDET: systema
            domesticum (macos ordinarie) non discernit, servus
            aedificationis (linux) discernit, unde arbor quae
            domi aedificatur et in rete frangitur - et nuntius
            erroris de plagula ABSENTE loquitur quae adest.
            Nulla alia proprietas huius exemplaris tam saepe
            horam perdit"/>
    <proprietas nomen="capsas_servat" genus="veritas"
      nota="DISTINCTUM a discernendo: systema servare potest
            quod scripsisti et tamen non discernere. Qui haec
            duo confundit probationem falsam scribit"/>
    <proprietas nomen="mensura_nominis_maxima" genus="numerus"/>
    <proprietas nomen="nexus_fert" genus="electio"
      nota="an nomina plura ad idem contentum ire possint">
      <optio>nullos</optio>
      <optio>symbolicos</optio>
      <optio>duros</optio>
      <optio>utrosque</optio>
    </proprietas>
    <proprietas nomen="transactiones_fert" genus="veritas"
      nota="an mutatio plagularum plurium omnia-aut-nihil esse
            possit. Fere semper FALSUM, quod causa est cur
            volumen (plagula sqlite una) transactiones habeat
            quas arbor plagularum praestare non potest -
            ratio architecturae, non commoditas"/>
  </proprietates>

  <partes>
    <pars nomen="radix" necessaria="verum"
      nota="unde omnis via incipit"/>
    <pars nomen="directorium" necessaria="falsum"
      nota="systemata plana exsistunt (obiecta in repositorio
            nubis nomina cum '/' ferunt quae arborem SIMULANT
            sine arbore). Ideo non necessaria - et qui arborem
            supponit ubi nulla est mox 'directorium vacuum'
            quaerit quod exsistere non potest"/>
    <pars nomen="notae_circumstantes" necessaria="falsum"
      nota="tempora, dominus, permissiones"/>
  </partes>

  <relationes>
    <relatio nomen="continet" ad="plagula_computatralis"
      multiplex="verum"/>
    <relatio nomen="iacet_in" ad="systema_operativum"
      modulus="systema_operativum"/>
  </relationes>

  <nota>
    "Omnia plagulae sunt" (systema_unixiforme) affirmatio de HOC
    genere est: eadem arbor nominum non solum contenta condita
    sed etiam machinas, processus, canales exhibet. Affirmatio
    de nominatione, non de conditura.
  </nota>

</genus>

<genus nomen="directorium">

  <definitio>
    Continens nominatum plagularum et directoriorum aliorum:
    nodus arboris nominum. Contentum eius non octeti sunt sed
    NOMINA - unde "quid in eo est" enumeratio est, non lectio.
  </definitio>

  <differentia>
    Non collocatum sub plagula consulto. Systemata unixiformia
    directorium plagulam faciunt (genus speciale quod nomina
    continet), alia non; utrumque describi debet, et taxinomia
    quae unius systematis consilium in arborem suam inaedificat
    alterum describere desinit. Relatio infra id quod verum est
    dicit sine electione.
  </differentia>

  <proprietates>
    <proprietas nomen="occultum" genus="veritas"
      nota="conventione (nomen puncto incipiens) non structura -
            unde 'occultum' proprietas NOMINIS est, non rei, et
            instrumenta quae id ignorant plagulas invisibiles
            inveniunt quas utens numquam vidit"/>
  </proprietates>

  <relationes>
    <relatio nomen="continet" ad="*" multiplex="verum"
      nota="plagulas et directoria - apertum quia se ipsum
            includit"/>
    <relatio nomen="continetur_in" ad="directorium"
      inversa="continet"
      nota="radix sola caret"/>
    <relatio nomen="est_plagula" ad="plagula_computatralis"
      nota="apud systemata unixiformia directorium plagula EST
            (genus speciale); alibi non. Relatio, non
            subordinatio - vide differentiam"/>
  </relationes>

</genus>

</natura>
