<?xml version="1.0" encoding="UTF-8"?>
<!--
  natura/fabricatio.stml
  Exemplar semanticum: FABRICATIO (versio 0, PLASTICUM)
  Genera: postulatum, facultas, probatio, vitium.

  QUADRATUM INTENTIONIS: postulatum intentionem DECLARAT ante
  opus; facultas intentio POSSESSA est; probatio realizationem
  contra intentionem INTERROGAT; vitium discrepantia MENSURATA.
  Quattuor genera, stratum unum - nullum eorum in moribus solis
  observari potest.

  TESTIMONIUM: lis vulgata "non vitium sed facultas est" lis de
  GENERE est - mores iidem, genus disputatur - et solvi non
  potest nisi intentione consulta. Quod probat totum quadratum
  in strato intentionis vivere.
-->
<natura modulus="fabricatio" versio="2" lingua="latina">

<!-- ==================================================
     POSTULATUM - intentio declarata ante opus
     ================================================== -->

<genus nomen="postulatum">

  <definitio>
    Intentio declarata ANTE opus: quod verum esse debet ut opus
    perfectum dicatur. Fons iudicii ceterorum: vitium contra
    postulatum mensuratur, probatio postulatum interrogat,
    facultas postulatum implet.
  </definitio>

  <machina_statuum nomen="vita" gerens="individuum">
    <status nomen="propositum"/>
    <status nomen="receptum"/>
    <status nomen="impletum"/>
    <status nomen="reiectum"/>
    <transitus a="propositum" ad="receptum" per="receptio"/>
    <transitus a="propositum" ad="reiectum" per="reiectio"/>
    <transitus a="receptum" ad="impletum" per="impletio"/>
  </machina_statuum>

  <relationes>
    <relatio nomen="impletur_a" a="facultas" inversa="verum"
      nota="impletur a facultas.implet"/>
    <relatio nomen="interrogatur_a" a="probatio" inversa="verum"
      nota="impletur a probatio.interrogat"/>
  </relationes>
  <!-- in domo: postulata_posix.h nomen ipsum gerit - quae
       plagula a systemate POSIX postulat, declarata primo -->

</genus>

<!-- ==================================================
     FACULTAS - intentio possessa
     ================================================== -->

<genus nomen="facultas">

  <definitio>
    Quod opus praestare potest, ab utente aestimatum: unitas
    VALORIS. Postulatum est intentio petita; facultas intentio
    possessa - quod utens nominat cum narrat quid programma
    faciat.
  </definitio>

  <relationes>
    <relatio nomen="implet" ad="postulatum" multiplex="verum"/>
    <relatio nomen="realizata_a" ad="*" multiplex="verum"
      nota="functiones, bibliothecae, elementa quae eam
            efficiunt - facultas una, elementa multa"/>
  </relationes>

</genus>

<!-- ==================================================
     PROBATIO - interrogatio exsecutabilis intentionis
     ================================================== -->

<genus nomen="probatio">

  <definitio>
    Interrogatio exsecutabilis intentionis: scaena parata,
    actio exercita, effectus contra exspectationem collatus.
    Vas assertionum - probatio assertiones continet, quibus
    iudicat (in domo nostra bibliotheca credo).
  </definitio>

  <nota>
    HONESTAS: probatio mentiri potest - quod non exercet, non
    probat; apparatus fictus assumptiones auctoris communicat
    (in domo mensuratum: probationes virides mendaces,
    apparatus qui assumptiones communicant). Probatio transiens
    id solum probat quod re vera exercuit.
  </nota>

  <relationes>
    <relatio nomen="interrogat" ad="postulatum"/>
    <relatio nomen="continet" ad="assertio"
      modulus="elementa_programmatis" multiplex="verum"/>
    <relatio nomen="exercet" ad="functio"
      modulus="elementa_programmatis" multiplex="verum"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <species nomen="probatio_unitatis">
    <definitio>
      Elementum SOLUM probat, in insula: unum genus, unus mos,
      apparatus minimus. In domo nostra probationes/ per
      bibliothecam - unitas est bibliotheca.
    </definitio>
  </species>

  <species nomen="probatio_integrationis">
    <definitio>
      Elementa UNA probat: suturae ipsae interrogantur - nam
      vitia in suturis habitant, ubi assumptiones duorum
      elementorum conveniunt nec semper congruunt.
    </definitio>
  </species>

  <species nomen="probatio_regressionis">
    <definitio>
      Nata ex vitio: umbra vitii sanati custos posita, ne
      redeat. Orta ex re quam custodit - probatio cum historia.
    </definitio>
  </species>

  <species nomen="probatio_fumi">
    <definitio>
      "Vivitne omnino?" - levissima latissima: nihil profundum,
      omnia tacta. Prima post mutationem magnam, non ultima.
    </definitio>
  </species>

</genus>

<!-- ==================================================
     VITIUM - discrepantia inter intentionem et mores
     ================================================== -->

<genus nomen="vitium">

  <definitio>
    Discrepantia inter intentionem et mores: programma facit
    quod scriptum est, non quod volitum - vitium in hiatu
    vivit. Mores soli vitiosi esse non possunt: vitium
    relationem ad intentionem postulat (postulatum, assertionem,
    exspectationem), sine qua tantum "mores" sunt.
  </definitio>

  <nota>
    Vitium quod observatione fugit "heisenbug" vulgo dicitur -
    observatio ipsa mores mutat (tempora, memoria); species
    nondum, fama iam.
  </nota>

  <nota>
    TRIAS DEFECTUUM (rota XXI): tria genera mali per NORMAM ad
    quam mensurantur distinguuntur - vitium ab INTENTIONE
    (hic), morbus a NATURA (morbus.morbus), damnum ab
    INTEGRITATE (corporalia.damnum). Ideo programma vitiosum,
    animal aegrotum, saxum damnatum: quo plus rei debetur, eo
    plura mala pati potest. Trias eadem in tribus plagulis
    scripta est ne lector ullam solam inveniens partem pro
    toto sumat.
  </nota>

  <dubium>
    SANATIO REBUS CORPOREIS NON CONVENIT (inventum experimenti
    pistrinae): sanatio = mutatio fontis, quae rem emendabilem
    supponit. Panis adustus non emendatur - abicitur et
    RECOQUITUR. Materia irreversibilis est; emendatio
    privilegium rerum digitalium. An transitus 'refectio'
    (novum facere) iuxta 'sanationem' addendus, an vitium
    corporeum aliud genus omnino? Quadratum ipsum tenuit -
    hic solus locus flexus est. APERTUM.
    (Vide corporalia.instrumentum: machina eius iam REFECTIONEM
    dicit, non sanationem - lingua ibi iam divisit.)
  </dubium>

  <machina_statuum nomen="vita" gerens="individuum">
    <status nomen="relatum_est"
      nota="querella accepta, nondum probata"/>
    <status nomen="confirmatum"/>
    <status nomen="sanatum"/>
    <status nomen="clausum"/>
    <status nomen="non_reproductum"
      nota="querella quam probare non potuimus - nec falsa
            declarata nec vera: honeste incognita"/>
    <status nomen="non_sanandum"
      nota="mores manent, INTENTIO mutatur: vitium moritur
            sine mutatione codicis - resolutio per
            re-declarationem; philosophice ditissimus exitus"/>
    <transitus a="relatum_est" ad="confirmatum"
      per="reproductio"
      nota="reproductio = probatio ex querella facta"/>
    <transitus a="relatum_est" ad="non_reproductum"
      per="defectio_reproductionis"/>
    <transitus a="confirmatum" ad="sanatum" per="sanatio"
      nota="sanatio = mutatio fontis - vide
            elementa_programmatis.mutatio"/>
    <transitus a="confirmatum" ad="non_sanandum"
      per="re_declaratio"/>
    <transitus a="sanatum" ad="clausum" per="verificatio"/>
    <transitus a="clausum" ad="relatum_est" per="regressio"
      nota="vitium rediens - vide speciem; cyclus honestus"/>
  </machina_statuum>

  <relationes>
    <relatio nomen="violat" ad="postulatum"/>
    <relatio nomen="habitat_in" ad="*"
      nota="functio, bibliotheca, sutura - sedes eius in
            elementis"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <species nomen="regressio">
    <definitio>
      Vitium REDIENS: sanatum olim, reversum - quod semel
      fractum et refectum, iterum fractum. Causa fundationis
      probationum domus nostrae: sine probationibus periculum
      regressionum nimium. Custoditur a probatione
      regressionis - umbra sua ipsius custos.
    </definitio>
  </species>

</genus>

<!-- ==================================================
     DEBITUM TECHNICUM - imperfectio CONSULTO suscepta

     GENUS PER IUDICIUM (rota XXXIV, Fran): membrum huius
     generis non ex inspectione legitur sed ASSERITUR ab eo
     qui vocabularium habet. Non ideo infirmius - tertia
     pars bibliothecae ita se habet (morbus dignoscitur,
     vitium iudicatur, incidens declaratur), et hic ipse
     locus est ubi PERITIA vocabularii pretium suum ostendit:
     tiro codicem molestum videt, peritus DEBITUM videt, et
     vocabulum statim actiones affordat (principal aestimare,
     usuram pensare, solvere an servire).
     ================================================== -->

<genus nomen="debitum_technicum">

  <definitio>
    Imperfectio in opere CONSULTO suscepta ut aliquid citius
    praestetur, cum cognitione pretii posterioris: non defectus
    sed COMMUTATIO - valor nunc sumptus, pretium postea
    solvendum. Ideo metaphora nummaria portat: debitum non
    culpa est sed instrumentum, et sicut in re nummaria debitum
    bonum et malum datur.
  </definitio>

  <nota>
    MENDACIUM VULGARE, ET PIEPERIANUM: usus hodiernus "debitum
    technicum" pro quolibet codice pravo dicit. Ward Cunningham,
    qui metaphoram anno 1992 finxit, aliud significabat -
    emittere quod intellectum PRAESENTEM refert, deinde
    reficere dum intellectus crescit; ipse dixit se codicem
    prave scribi numquam probare. Ergo:
    - imperfectio CONSULTA cum pretio cognito = debitum;
    - imperfectio INSCIA aut neglegens = non debitum sed
      vitium aut ars mala.
    Vocabulum ad usum lapsum est ut culpam excusaret ("debitum
    habemus" mollius sonat quam "male scripsimus") - abusus
    linguae exemplum purum, in dominio nostro.
  </nota>

  <proprietates>
    <proprietas nomen="usura" genus="textus"
      nota="quod SINGULIS VICIBUS solvitur dum debitum manet:
            mora cuiusque mutationis, probationes fragiles,
            tirones tardius discentes. Usura, non principal,
            decisionem regit - debitum sine usura solvi non
            oportet"/>
    <proprietas nomen="consulta" genus="veritas"
      ordinarius="verum"
      nota="an suscepta sit sciente auctore - falsum reddit
            genus dubium (vide notam supra)"/>
  </proprietates>

  <machina_statuum nomen="cursus" gerens="individuum">
    <status nomen="susceptum"/>
    <status nomen="servitum"
      nota="usura solvitur, principal manet - status in quo
            debita plurima PERPETUO vivunt, quod tabulae raro
            fatentur"/>
    <status nomen="solutum"/>
    <status nomen="remissum"
      nota="pars codicis deleta aut substituta: debitum sine
            solutione perit - exitus verus et frequens, quem
            'refactoring' solum non capit"/>
    <transitus a="susceptum" ad="servitum" per="mora"/>
    <transitus a="servitum" ad="solutum" per="solutio"/>
    <transitus a="servitum" ad="remissum" per="remotio"/>
    <transitus a="susceptum" ad="solutum" per="solutio"/>
  </machina_statuum>

  <relationes>
    <relatio nomen="asseritur_per" ad="iudicium" modulus="iudicium"
      nota="MEMBRUM PER IUDICIUM: quod hic codex debitum sit
            affirmatio est cum auctore, momento, gradu assensus -
            non proprietas ex inspectione lecta. Duo periti
            dissentire possunt, nec alter ideo errat"/>
    <relatio nomen="inhaeret" ad="*"
      nota="cui parti operis - bibliothecae, functioni, schemati"/>
    <relatio nomen="emit" ad="facultas" multiplex="verum"
      nota="QUID PRETIO EMPTUM SIT: debitum sine facultate
            empta debitum non est sed damnum purum. Relatio
            quae iudicium honestum facit"/>
    <relatio nomen="solvitur_per" ad="pensum" modulus="operatio"
      multiplex="verum"/>
  </relationes>

</genus>

</natura>
