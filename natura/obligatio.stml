<?xml version="1.0" encoding="UTF-8"?>
<!--
  natura/obligatio.stml
  Exemplar semanticum: OBLIGATIO (versio 6, PLASTICUM)
  Genera: obligatio, contractus, licentia.

  Natum ex experimento pistrinae (ratio caffeae, conductio
  operariorum, licentia sanitatis).

  REPATRIATIO, NON TRANSLATIO: hoc dominium ius Romanum iam
  descripsit, et lingua eius NOSTRA est. Institutiones Gaii et
  Iustiniani obligationes ex CONTRACTU et ex DELICTO dividunt;
  definitio classica obligationem "iuris vinculum quo necessitate
  adstringimur alicuius solvendae rei" vocat - vinculum, non res.
  Linnaeus huius dominii Gaius est; nos verba eius sumimus quia
  meliora sunt, non quia antiqua.

  DISCRIMEN QUOD FRAN NOTAVIT: contractus consensu DUORUM oritur
  et utrumque ligat; licentia ab auctoritate UNILATERALITER
  datur, revocari potest, expirat. Non idem genus - quod
  schemata vulgaria confundunt.
-->
<natura modulus="obligatio" versio="6" lingua="latina">

<fontes>
  <fons clavis="corpus" genus="corpus_institutionis"
    modulus="iudicium" verificatus="falsum">
    Corpus institutionis scribae: ius Romanum, ius gentium,
    ius agentiae. NON VERIFICATUM.
  </fons>
</fontes>

<!-- ==================================================
     OBLIGATIO - vinculum iuris
     ================================================== -->

<genus nomen="obligatio">

  <definitio>
    Iuris vinculum quo quis alicui aliquid praestare adstringitur
    (Institutiones): non res sed VINCULUM inter personas -
    debitor et creditor duo termini eius. Sine relatione
    obligatio non est.
  </definitio>

  <machina_statuum nomen="vita" gerens="individuum">
    <status nomen="orta"/>
    <status nomen="soluta" nota="praestatione finita - exitus
      ordinarius"/>
    <status nomen="remissa" nota="creditor eam DIMISIT: moritur
      sine praestatione, voluntate creditoris - exitus quem
      schema mere computatrale numquam praevideret"/>
    <status nomen="praescripta" nota="tempore exstincta: ius non
      exercitum diu perit (praescriptio) - obligatio quam MORA
      sola occidit"/>
    <status nomen="violata" nota="terminus praeteriit,
      praestatio deest"/>
    <transitus a="orta" ad="soluta" per="solutio"/>
    <transitus a="orta" ad="remissa" per="remissio"/>
    <transitus a="orta" ad="violata" per="mora_debitoris"/>
    <transitus a="orta" ad="praescripta" per="praescriptio"/>
    <transitus a="violata" ad="soluta" per="solutio_sera"/>
  </machina_statuum>

  <relationes>
    <relatio nomen="debitor" ad="*"/>
    <relatio nomen="creditor" ad="*"/>
    <relatio nomen="praestandum" ad="*"
      nota="pecunia, res, opus, aut ABSTINENTIA (non facere est
            praestatio quoque - obligatio negativa)"/>
    <relatio nomen="orta_ex" ad="*"
      nota="fons: contractus, delictum, venditio, lex ipsa"/>
  </relationes>

  <!-- ================= DICTIONARIUM =================
       divisio Gaiana: ex contractu / ex delicto -->

  <species nomen="obligatio_ex_contractu">
    <definitio>
      Ex consensu orta: quod promisisti praestandum est.
    </definitio>
  </species>

  <species nomen="obligatio_ex_delicto">
    <definitio>
      Ex damno illato orta: qui nocuit reparare tenetur -
      obligatio quam nemo VOLUIT, tamen vera. Testis quod
      obligatio consensum non postulat.
    </definitio>
  </species>

  <species nomen="obligatio_ex_lege">
    <definitio>
      Ex lege ipsa orta: tributa, alimenta - nec pactum nec
      damnum, sed praeceptum publicum.
    </definitio>
  </species>

</genus>

<!-- ==================================================
     CONTRACTUS - conventio obligationes pariens
     ================================================== -->

<genus nomen="contractus">

  <definitio>
    Conventio duorum (aut plurium) quae obligationes parit:
    consensus est fundamentum - ideo utrumque ligat, et neuter
    solus eum tollere potest. Res una, obligationes plures:
    conductio operis mercedem ab uno, laborem ab altero poscit.
  </definitio>

  <proprietates>
    <proprietas nomen="initium" genus="dies"/>
    <proprietas nomen="finis" genus="dies"
      nota="vacuum = sine termino"/>
  </proprietates>

  <relationes>
    <relatio nomen="partes" ad="*" multiplex="verum"
      nota="qui consenserunt - DUO saltem, semper"/>
    <relatio nomen="parit" ad="obligatio" multiplex="verum"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <species nomen="emptio_venditio">
    <definitio>Res pro pretio: contractus omnium
      frequentissimus.</definitio>
  </species>

  <species nomen="locatio_conductio">
    <definitio>
      Usus rei aut opera pro mercede: sub hac specie ius
      Romanum et habitationem et LABOREM ponit - conductio
      operarum, unde nostra "conductio" hodierna.
    </definitio>
  </species>

  <species nomen="societas_contractus">
    <definitio>
      Plures in commune negotium: unde organizatio ipsa nascitur
      - contractus qui personam novam (societatem) parit.
    </definitio>
  </species>

  <species nomen="mandatum">
    <definitio>
      Alius pro me agit: fundamentum repraesentationis -
      procurator, agens. (Agens artificialis mandato vivit
      quoque: forma antiqua, materia nova.)
    </definitio>
  </species>

</genus>

<!-- ==================================================
     LICENTIA - concessio unilateralis auctoritatis
     ================================================== -->

<genus nomen="licentia">

  <definitio>
    Concessio ab auctoritate data ut quid liceat quod aliter non
    liceret: UNILATERALIS (consensu accipientis non indiget),
    REVOCABILIS (dans eam auferre potest), saepe TEMPORALIS.
    Ideo contractus non est - quod schemata vulgaria confundunt.
  </definitio>

  <proprietates>
    <proprietas nomen="data" genus="dies"/>
    <proprietas nomen="expirat" genus="dies"/>
    <proprietas nomen="condiciones" genus="textus"
      multiplex="verum"
      nota="quibus servatis valet - inspectio, merces annua"/>
    <proprietas nomen="recentia_postulata" genus="veritas"
      ordinarius="falsum"
      nota="RECENTIA (aviatio poposcit, rota XXXIX): an vigor
            ex USU RECENTI pendeat, non ex probatione praeterita -
            gubernator tres descensus nonaginta diebus egit ut
            vectores ferat. Unde TRIA genera cessandi, non duo:
            titulus NUMQUAM cadit (factum testatur); licentia
            ordinaria TEMPORE cadit (terminus lapsus); licentia
            cum recentia DESUETUDINE cadit - qui non exercet
            amittit, quamvis terminus absit. Peritia enim
            decrescit, et hoc sola inter tria id agnoscit"/>
  </proprietates>

  <machina_statuum nomen="vigor" gerens="individuum">
    <status nomen="petita"/>
    <status nomen="concessa"/>
    <status nomen="suspensa"/>
    <status nomen="revocata"/>
    <status nomen="expirata"/>
    <transitus a="petita" ad="concessa" per="concessio"/>
    <transitus a="concessa" ad="suspensa" per="suspensio"/>
    <transitus a="suspensa" ad="concessa" per="restitutio"/>
    <transitus a="concessa" ad="revocata" per="revocatio"/>
    <transitus a="concessa" ad="expirata" per="lapsus_temporis"/>
    <transitus a="expirata" ad="concessa" per="renovatio"/>
  </machina_statuum>

  <relationes>
    <relatio nomen="concedens" ad="organizatio"
      modulus="organizatio"
      nota="magistratus fere semper - auctoritas publica"/>
    <relatio nomen="accipiens" ad="*"/>
    <relatio nomen="secundum_normam" ad="norma" modulus="norma"
      nota="licentia normam SUPPONIT: quod inspector metitur,
            norma dicit - nexus qui exemplar normae iterum
            praestare facit"/>
  </relationes>

  <nota>
    Licentia programmatis (GPL, MIT) huius generis est: auctor
    unilateraliter concedit quod ius auctoris aliter vetaret.
    Nexus futurus ad opus_scriptum et bibliothecam - dominium
    forense et computatrale idem genus habent.
  </nota>

</genus>

<!-- ==================================================
     TRIBUTUM - obligatio ad magistratum ex lege
     (cursu tertio circuli poscente: portorium ad limites.
     Vocabularium Romanum integrum sumimus - dominium hoc
     ius Romanum descripsit et verba eius nostra sunt)
     ================================================== -->

<genus nomen="tributum" sub="obligatio">

  <differentia>
    Obligatio ad MAGISTRATUM, ex lege orta, non ex consensu:
    debetur quia lex ita statuit, non quia quis promisit. Ideo
    nec recusari nec remitti privatim potest - creditor eam
    remittere non potest quia creditor non homo sed res publica
    est.
  </differentia>

  <proprietates>
    <proprietas nomen="ratio" genus="electio"
      nota="quo facto oriatur - basis tributi">
      <optio>ex_transitu</optio>
      <optio>ex_reditu</optio>
      <optio>ex_possessione</optio>
      <optio>ex_venditione</optio>
      <optio>ex_capite</optio>
    </proprietas>
  </proprietates>

  <relationes>
    <relatio nomen="exigitur_a" ad="magistratus"
      modulus="organizatio"/>
    <relatio nomen="secundum_normam" ad="norma" modulus="norma"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <species nomen="portorium">
    <definitio>
      Tributum ex TRANSITU limitis: quod merces limitem
      transeuntes debent. Species quae iurisdictionem ipsam
      lucrativam facit - unde limites custoditi, unde
      declarationes, unde tota vecturae difficultas.
    </definitio>
    <valor nomen="ratio">ex_transitu</valor>
    <nota>
      Nomen Romanum, res eadem: portoria ad portus et pontes
      exigebantur. Duo milia annorum, mechanismus idem.
    </nota>
  </species>

  <species nomen="vectigal">
    <definitio>
      Reditus publicus ex re publica: ex agris, salinis,
      viis. Tributum quod non ex persona sed ex USU rei
      publicae oritur.
    </definitio>
    <valor nomen="ratio">ex_possessione</valor>
  </species>

  <species nomen="decuma">
    <definitio>
      Pars decima fructuum: tributum ratione PARTIS, non
      summae - forma antiquissima, quae quantitatem numeratam
      non poscit sed proportionem.
    </definitio>
    <valor nomen="ratio">ex_reditu</valor>
  </species>

  <species nomen="tributum_capitis">
    <definitio>
      Ex capite, non ex re: debetur quia es, non quia habes.
      Species cuius aequitas per saecula disputata est -
      exemplum quod tributum iudicium morale semper fert.
    </definitio>
    <valor nomen="ratio">ex_capite</valor>
  </species>

</genus>

<!-- ==================================================
     TITULUS - attestatio permanens auctoritatis
     (v0->v1: exemplar ultra obligationem crevit ad
     familiam eorum QUAE AUCTORITAS CONFERT - licentia
     permissio revocabilis, titulus attestatio perpetua.
     Contrarium quod exemplar valetudinarii ostendit:
     licentia medici revocari potest, gradus doctoris
     numquam)
     ================================================== -->

<genus nomen="titulus">

  <definitio>
    Attestatio publica et permanens ab auctoritate data, quod
    aliquis aliquid consecutus est aut aliquid EST: non
    permissio agendi sed testimonium facti. Ideo non expirat
    nec revocatur - quod factum est infectum fieri nequit.
  </definitio>

  <proprietates>
    <proprietas nomen="collatus" genus="dies"/>
    <proprietas nomen="appellatio" genus="textus"
      nota="quo titulo nominatur - 'doctor', 'magister'"/>
  </proprietates>

  <relationes>
    <relatio nomen="conferens" ad="organizatio"
      modulus="organizatio"/>
    <relatio nomen="latus_a" ad="persona" modulus="persona"/>
    <relatio nomen="fundat" ad="licentia"
      nota="titulus licentiam saepe PRAECEDIT et fundat
            (gradus medicinae ante licentiam medendi): unum
            testatur, alterum permittit - et alterum solum
            aufertur"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <species nomen="gradus_academicus">
    <definitio>
      Ab universitate collatus post studia probata:
      baccalaureatus, licentia (nomen antiquum!), doctoratus.
      Testatur quid quis DIDICERIT, non quid facere ei liceat.
    </definitio>
    <nota>
      "Licentia docendi" medii aevi utrumque simul erat -
      gradus ET permissio; distinctio nostra posterior est,
      et nomen hodiernum "licentiae" ex illa radice manet.
      Historia verborum distinctionem generum servat.
    </nota>
  </species>

  <species nomen="character_indelebilis">
    <definitio>
      Signum spirituale quod sacramenta tria imprimunt
      (baptismus, confirmatio, ordo): ontologicum, unicum,
      irreiterabile. Casus terminalis generis - quod NE
      AUCTORITAS QUIDEM CONFERENS auferre potest: sacerdos ad
      statum laicalem reductus ordinatus manet, licentia sola
      ablata.
    </definitio>
    <nota>
      Species quae differentiam tituli et licentiae ad
      extremum ducit et ideo eam probat: si permanentia gradus
      esset, hic terminus eius. Utrumque simul in eodem homine
      videri potest - character manens, facultas ministrandi
      suspensa: distinctio non subtilis sed practica.
    </nota>
  </species>

  <species nomen="titulus_honoris">
    <definitio>
      Ob merita collatus, non ob probationem: honores,
      dignitates. Species in qua auctoritas non factum
      testatur sed AESTIMATIONEM suam publicat - unde
      iudicium (aestimatio) et titulus se tangunt.
    </definitio>
  </species>

</genus>

<!-- ==================================================
     IUSSUM - directivum auctoritate latum quod PERDURAT

     INVENTUM CURSU SEPTIMO (pharmacopolium), et hiatum
     structuralem implet quem duo genera circumstabant sine eo:
     actus_iuridicus ACTUM describit (momentaneum), obligatio
     VINCULUM (quid debeatur) - directivum ipsum, quod post
     actum manet et ante executionem exspectat, neutrum erat.

     COLLISIO ETYMOLOGICA MONENDA: praescriptio medica
     'praescriptum' videtur et NON EST. Praescriptum nostrum
     PROCEDURA est (gradus ordinati, ab exsequente sequendi);
     praescriptio medica IUSSUM est (directivum auctoritate
     latum, a TERTIO exsecutum, forma validum aut irritum).
     Verbum anglicum 'recipe' ex Rx pharmaceutico venit - unde
     confusio vera in linguis, falsa in rebus. Officina
     compositoria utrumque simul habet: formula praescriptum
     est, charta quae eam iubet iussum.

     NOMEN ROMANUM: iussum auctorizatio patrisfamilias erat qua
     alius (filius, servus) negotium valide gerebat - eadem
     structura: potestas alterius actum validum facit.
     ================================================== -->

<genus nomen="iussum">

  <definitio>
    Directivum ab eo qui potestatem habet latum, quod agendum
    quid, a quo, et intra quod tempus determinat, et quod ACTU
    LATO PERDURAT: res facta, non eventus praeteritus. Effectus
    eius a forma et ab auctoritate iubentis pendet - unde
    VALIDUM aut IRRITUM, non bonum aut malum.
  </definitio>

  <differentia>
    Ab obligatione: obligatio VINCULUM est inter personas (quid
    debeatur); iussum RES est quam quis tenet, ostendit,
    transfert, consumit. Ab actu iuridico: actus MOMENTUM est
    (iubere), iussum quod post momentum manet. A praescripto:
    praescriptum QUOMODO docet et iteratur; iussum QUID imperat
    hac vice, et exhaustum moritur.
  </differentia>

  <proprietates>
    <proprietas nomen="usus_reliqui" genus="numerus"
      nota="quotiens adhuc exsequi liceat. IUSSA CONSUMUNTUR -
            proprietas quam nec obligatio nec actus habet:
            praescriptio duas repetitiones fert, mandatum
            comparandi semel solvitur. Nullus = exhaustum"/>
    <proprietas nomen="valens_ad" genus="dies"
      nota="post quod nemo exsequi debet nec potest"/>
    <proprietas nomen="transferibile" genus="veritas"
      ordinarius="falsum"
      nota="an alius exsecutor substitui possit (praescriptio
            ad pharmacopolium aliud transferri potest, sub
            limitibus; mandatum iudicis non)"/>
    <proprietas nomen="poena_neglegentis" genus="electio"
      nota="quid accidat exsecutori qui neglegit - AXIS QUI
            iussum a petitione dividit: petitionem negare
            licet, iussum non">
      <optio>nulla</optio>
      <optio>disciplinaris</optio>
      <optio>iuridica</optio>
    </proprietas>
  </proprietates>

  <machina_statuum nomen="vita" gerens="individuum">
    <status nomen="latum"/>
    <status nomen="acceptum" nota="ab exsecutore receptum"/>
    <status nomen="exsecutum" nota="semel aut pluries"/>
    <status nomen="exhaustum" nota="usus reliqui nulli"/>
    <status nomen="revocatum" nota="a iubente retractum"/>
    <status nomen="elapsum" nota="tempore, non usu"/>
    <status nomen="recusatum"
      nota="ab exsecutore reiectum - status qui iussum a
            necessitate dividit: pharmacopola praescriptionem
            irritam recusare DEBET, et recusatio actus
            professionis est, non inoboedientia"/>
    <transitus a="latum" ad="acceptum" per="receptio"/>
    <transitus a="latum" ad="revocatum" per="revocatio"/>
    <transitus a="acceptum" ad="exsecutum" per="executio"/>
    <transitus a="acceptum" ad="recusatum" per="recusatio"/>
    <transitus a="exsecutum" ad="exsecutum" per="executio"
      nota="CYCLUS dum usus supersunt - repetitiones"/>
    <transitus a="exsecutum" ad="exhaustum" per="consumptio"/>
    <transitus a="acceptum" ad="elapsum" per="lapsus_temporis"/>
    <transitus a="exsecutum" ad="elapsum" per="lapsus_temporis"/>
  </machina_statuum>

  <actiones>
    <actio nomen="ferri" nota="a iubente"/>
    <actio nomen="exsequi"/>
    <actio nomen="recusari"/>
    <actio nomen="revocari"/>
  </actiones>

  <relationes>
    <relatio nomen="iubens" ad="*"
      nota="persona aut organizatio - sed non quaelibet: vide
            relationem potestatis infra"/>
    <relatio nomen="potestate" ad="titulus"
      nota="QUA AUCTORITATE iubeat. Iussum sine potestate
            IRRITUM est, non malum - unde titulus (licentia
            medici, officium iudicis) pars validitatis, non
            ornamentum"/>
    <relatio nomen="exsecutor" ad="*"
      nota="cui exsequendum - saepe non idem ac beneficiarius:
            medicus iubet, pharmacopola exsequitur, aeger
            accipit. TRES personae, quod iussum a contractu
            (duae) distinguit"/>
    <relatio nomen="beneficiarius" ad="*"/>
    <relatio nomen="latum_per" ad="actus_iuridicus" modulus="actus"
      nota="actus quo natum est"/>
    <relatio nomen="parit" ad="obligatio"
      nota="iussum acceptum obligationem exsequendi parit -
            unde duo genera cognata sed diversa"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <species nomen="praescriptio_medica">
    <definitio>
      Iussum medici quo pharmacopola medicamentum aegro certo
      dispensare iubetur: substantia, vis, quantitas, modus
      sumendi, repetitiones.
    </definitio>
    <differentia>
      Exsecutor PERITUS est cum officio proprio recusandi:
      pharmacopola non minister sed custos secundus - iussum
      quod interactionem periculosam ferat recusare DEBET,
      etiam medico dissentiente. Iussum cuius executio iudicium
      independens poscit.
    </differentia>
    <valor nomen="transferibile">verum</valor>
    <valor nomen="poena_neglegentis">iuridica</valor>
  </species>

  <species nomen="mandatum_iudicis">
    <definitio>
      Iussum a iudice latum quo quis aliquid facere aut omittere
      iubetur: vis publica post illud stat.
    </definitio>
    <valor nomen="transferibile">falsum</valor>
    <valor nomen="poena_neglegentis">iuridica</valor>
    <nota>
      Species in qua neglegentia CONTUMACIA fit - poena non ex
      damno sed ex contemptu auctoritatis ipsius.
    </nota>
  </species>

  <species nomen="iussum_emptionis">
    <definitio>
      Iussum quo organizatio a venditore merces poscit, pretio
      et condicionibus praestitutis: quod "purchase order"
      vocatur.
    </definitio>
    <valor nomen="poena_neglegentis">nulla</valor>
    <nota>
      Species QUAE LIMITEM PROBAT: exsecutor externus est et
      recusare libere potest, unde poena nulla - et tamen
      iussum manet quia numero suo allocutione dignum est, usus
      consumit, tempore elapsum. Confinium cum petitione, quod
      axis poenae mensurat.
    </nota>
  </species>

  <species nomen="iussum_operis">
    <definitio>
      Iussum internum quo opus certum alicui committitur, saepe
      cum loco, tempore, materiis: quod "work order" vocatur.
    </definitio>
    <valor nomen="poena_neglegentis">disciplinaris</valor>
    <nota>
      Iussum et PENSUM (operatio) hic se tangunt sed non
      coincidunt: iussum charta est quae opus imperat, pensum
      opus ipsum quod suscipitur et perficitur. Unum iussum
      pensa plura parere potest.
    </nota>
  </species>

  <species nomen="iussum_ne_resuscitetur">
    <definitio>
      Iussum quo medicus, aegro consentiente aut prius
      declarante, resuscitationem cardiopulmonalem OMITTI
      iubet.
    </definitio>
    <differentia>
      Iussum cuius contentum OMISSIO est, non actio - et cuius
      beneficiarius idem est ac is qui consensit. Probat
      'agendum quid' in definitione late sumendum: quod non
      agendum sit aeque imperari potest.
    </differentia>
    <valor nomen="poena_neglegentis">iuridica</valor>
  </species>

</genus>


<!-- ==================================================
     PETITIO - rogatio quae negari potest

     DIFFERENDI FRUCTUS: cursu septimo (pharmacopolio) proposita
     et RECUSATA uno dominio, causa nominata - "casus secundus
     eam vertet". Cursus decimus (systemata distributa) eum
     attulit, et fortiorem quam sperabatur: ibi petitio res
     esse DEBET, non eventus.

     IUXTA IUSSUM POSITA CONSULTO (doctrina rotae L: genera se
     mutuo definientia rotis diversis inventa sine nexu manent).
     Axis qui ea dividit iam in iusso scriptus erat:
     poena_neglegentis. Iussum neglectum poenam parit; petitio
     negari LICET, et negatio nihil violat.
     ================================================== -->

<genus nomen="petitio">

  <definitio>
    Rogatio ad alium directa ut aliquid faciat aut praestet, quam
    ille CONCEDERE AUT NEGARE potest sine ulla violatione: quod
    petenti debetur non est res petita sed RESPONSUM.
  </definitio>

  <differentia>
    A iusso AUCTORITATE: iubens potestatem in exsecutorem habet
    et neglegentia poenam parit; petens non habet, et negatio
    legitima est. Ideo petitio SEMPER responsum exspectat -
    iussum executionem exspectat, petitio iudicium. Utraque
    perdurant, utraque tempore elabuntur, sed sola petitio
    negari potest sine culpa.
  </differentia>

  <proprietates>
    <proprietas nomen="identificator_petitionis" genus="textus"
      nota="QUO PETITIO EADEM AGNOSCITUR SI ITERUM VENIAT. In
            colloquio certo supervacuus; ubi responsum perire
            potest, NECESSARIUS - quia petens qui responsum non
            accepit nescit an petitio pervenerit, et iterum
            petit. Sine hoc campo repetitio petitionem NOVAM
            facit, unde bis solvitur quod semel debebatur.
            Hic petitio ex eventu in REM transit: quod occurrit
            agnosci non potest, quod nomen habet potest"/>
    <proprietas nomen="terminus_exspectandi" genus="quantitas"
      modulus="mensura"
      nota="quousque petens responsum exspectet. TERMINUS
            ELAPSUS RESPONSUM NON EST: petens nescit an petitio
            perierit, an responsum perierit, an adhuc agatur -
            ignotum verum, non negatio (vide iudicium.ignotum)"/>
    <proprietas nomen="conatus" genus="numerus"
      nota="quotiens missa sit. Numerus qui petitionem ab eventu
            distinguit: eventus semel accidit, petitio saepe
            eadem manens"/>
  </proprietates>

  <machina_statuum nomen="cursus" gerens="individuum">
    <status nomen="missa"/>
    <status nomen="accepta" nota="pervenit, nondum iudicata"/>
    <status nomen="concessa"/>
    <status nomen="negata"
      nota="EXITUS LEGITIMUS, non defectus - quod petitionem a
            iusso dividit"/>
    <status nomen="elapsa"
      nota="termino exspectandi transacto sine responso. STATUS
            PETENTIS, non petitionis: apud recipientem petitio
            adhuc concedi potest, et saepe conceditur postquam
            petens desperavit - unde duo status simul veri et
            discordes, quod nullum aliud genus bibliothecae
            patitur"/>
    <transitus a="missa" ad="accepta" per="receptio"/>
    <transitus a="missa" ad="elapsa" per="lapsus_termini"/>
    <transitus a="accepta" ad="concessa" per="concessio"/>
    <transitus a="accepta" ad="negata" per="negatio"/>
    <transitus a="accepta" ad="elapsa" per="lapsus_termini"/>
  </machina_statuum>

  <actiones>
    <actio nomen="peti"/>
    <actio nomen="concedi"/>
    <actio nomen="negari"/>
    <actio nomen="iterari" nota="eadem petitio denuo missa -
      non nova, quod identificator praestat"/>
  </actiones>

  <relationes>
    <relatio nomen="petens" ad="*"/>
    <relatio nomen="rogatus" ad="*"/>
    <relatio nomen="de" ad="*" nota="quid petatur"/>
    <relatio nomen="iudicatur_per" ad="iudicium" modulus="iudicium"
      nota="concessio aut negatio IUDICIUM est, cum auctore et
            fundamento - unde petitiones negatae rationem
            debent, et systemata quae eam non servant appellare
            non possunt"/>
    <relatio nomen="parit" ad="obligatio"
      nota="petitio CONCESSA obligationem parit; petitio ipsa
            nullam. Discrimen quod tota ratio assecurationis
            fert"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <species nomen="petitio_assecurationis">
    <definitio>
      Rogatio ad assecuratorem ut damnum ex polliciatione
      praestet: quod "claim" vocatur.
    </definitio>
    <nota>
      Specimen cursus septimi, quod solum genus portare non
      potuit. Hic negatio exitus ordinarius est et appellatio
      procedura statuta - unde relatio iudicatur_per necessaria,
      non ornamentum.
    </nota>
  </species>

  <species nomen="petitio_remota">
    <definitio>
      Rogatio ad programma per rete missa ut operationem agat
      aut datum reddat.
    </definitio>
    <differentia>
      Species in qua identificator et conatus NECESSARII fiunt,
      quia responsum perire potest: sola species ubi petens et
      rogatus de eadem petitione simul dissentire possunt sine
      culpa utriusque.
    </differentia>
    <nota>
      LEX HUIUS SPECIEI: traditio semel-exacte impossibilis est,
      TRACTATIO semel-exacte possibilis - per idempotentiam
      (vide elementa_programmatis.mutatio et
      praescriptum.procedura_automata, quae eandem proprietatem
      independenter declarant). Ideo systemata quae 'exactly
      once' pollicentur aut idempotentiam supponunt aut
      mentiuntur.
    </nota>
  </species>

  <species nomen="supplicatio">
    <definitio>
      Rogatio ad auctoritatem directa quae de re sua statuere
      potest: petitio venia, gratiae, licentiae.
    </definitio>
    <nota>
      Species quae inversionem ostendit: hic rogatus potestatem
      habet, petens non - contrarium iussi, ubi iubens potestatem
      habet. Eadem duo capita, ordine converso.
    </nota>
  </species>

</genus>


<!-- ==================================================
     DELEGATIO - potestas alterius nomine agendi

     Cursu undecimo (diplomatia ante telegraphum) inventa, et
     QUATTUOR dominiis simul postulata: plena potestas legati,
     procuratio, facultas canonica, tessera potestatis
     computatralis. Bibliotheca licentiam habebat (quid TIBI
     liceat) et officium (munus stabile) et titulum (quid SIS),
     et nihil pro potestate qua acta TUA ALIUM obligant.

     IUXTA LICENTIAM POSITA quia contrarium eius acutissimum
     est: licentia te agere sinit pro te; delegatio acta tua
     ALTERIUS facit.
     ================================================== -->

<genus nomen="delegatio">

  <definitio>
    Potestas alterius nomine agendi, ita ut acta delegati
    delegantem OBLIGENT tamquam ipse egisset: non licentia
    agendi sed transfusio auctoritatis, intra fines statutos.
  </definitio>

  <differentia>
    A licentia PERSONA OBLIGATA: licentia te agere sinit, et
    acta tua tua manent; delegatio acta tua ALIENA facit. Ab
    officio MOBILITATE: officium stabiliter constitutum est et
    tenentem suum non respicit (vacat, manet); delegatio
    personae huic datur et morte, revocatione, tempore perit.
  </differentia>

  <proprietates>
    <proprietas nomen="ambitus" genus="textus"
      nota="quid obligari possit. EXTRA AMBITUM ACTUM NEMINEM
            OBLIGAT - unde ratio cur pars altera plenam
            potestatem EXHIBERI poscat antequam negotietur:
            qui potestatem non inspexit periculum suum agit"/>
    <proprietas nomen="subdelegabilis" genus="veritas"
      ordinarius="falsum"
      nota="an delegatus alium substituere possit. Ordinarie
            NON (delegata potestas non delegatur), quod catenas
            breves servat - et regula contraria, ubi admittitur,
            catenam facit cuius fides quantum infimum anulum
            valet"/>
    <proprietas nomen="revocabilis" genus="veritas"
      ordinarius="verum"/>
    <proprietas nomen="effectus_post_revocationem" genus="electio"
      nota="CAPUT REI, et hic dominium vetus rem novam docet.
            Delegans mense Martio revocat; delegatus mense Maio,
            nihil sciens, signat. Obligaturne delegans? Ius
            agentiae dicit PLERUMQUE ITA - qui bona fide credidit
            tuendus est, et damnum in delegantem cadit qui
            nuntiare debuit. Id est 'auctoritas apparens', et
            IDEM PRORSUS est quod attestatio de revocatione dicit
            ('revocatio nuntianda est ne frustra sit'): credentia
            revocata quae non propagata est adhuc valet apud eum
            qui nescit. Saecula doctrinae de eo quis damnum
            ferat, quod ars computatralis vix incohavit">
      <optio>nullus</optio>
      <optio>obligat_donec_nuntietur</optio>
    </proprietas>
    <proprietas nomen="durat_usque" genus="dies"/>
  </proprietates>

  <machina_statuum nomen="vigor" gerens="individuum">
    <status nomen="data"/>
    <status nomen="exercita" nota="semel aut pluries adhibita"/>
    <status nomen="revocata"/>
    <status nomen="elapsa"/>
    <status nomen="extincta"
      nota="morte aut incapacitate delegantis - modus finiendi
            quem nulla nuntiatio praevenit, unde periculum
            proprium: delegatus vivum se credit agere pro
            mortuo"/>
    <transitus a="data" ad="exercita" per="exercitium"/>
    <transitus a="exercita" ad="exercita" per="exercitium"/>
    <transitus a="data" ad="revocata" per="revocatio"/>
    <transitus a="exercita" ad="revocata" per="revocatio"/>
    <transitus a="data" ad="elapsa" per="lapsus_temporis"/>
    <transitus a="data" ad="extincta" per="mors_delegantis"/>
  </machina_statuum>

  <relationes>
    <relatio nomen="delegans" ad="*"/>
    <relatio nomen="delegatus" ad="*"/>
    <relatio nomen="probatur_per" ad="attestatio" modulus="acta"
      nota="charta qua potestas exhibetur (litterae plenae
            potestatis, instrumentum procurationis). CHARTA
            POTESTAS NON EST: potestas revocari potest charta
            intacta manente - unde omnia problemata"/>
    <relatio nomen="obligat_per" ad="actus_sollemnis" modulus="actus"
      multiplex="verum"
      nota="actus quos delegatus nomine alieno ponit"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <species nomen="plena_potestas">
    <definitio>
      Potestas legato data ut tractatum nomine principis
      concludat: exhibenda alteri parti ante negotiationem,
      et ambitu suo circumscripta.
    </definitio>
    <valor nomen="subdelegabilis">falsum</valor>
    <nota>
      Species quae RATIFICATIONEM explicat: princeps plenam
      potestatem dat et tamen ratificationem sibi servat -
      delegatio ergo hic non plena est sed ad SIGNANDUM
      solum. Duo gradus consulto, ne latentia mensium principem
      ligaret sine ultima inspectione.
    </nota>
  </species>

  <species nomen="procuratio">
    <definitio>
      Potestas negotia alterius gerendi, instrumento publico
      plerumque data: emere, vendere, agere in iudicio.
    </definitio>
    <valor nomen="effectus_post_revocationem">obligat_donec_nuntietur</valor>
    <nota>
      Species in qua 'extincta' periculum maximum fert:
      procuratio ordinaria morte mandantis perit ipso facto, et
      tertius qui nescit tutus non semper est - unde procuratio
      'durabilis' inventa, quae incapacitatem superstat. Casus
      purus rei quae in systemate distributo 'sessio orphana'
      vocaretur.
    </nota>
  </species>

  <species nomen="delegatio_canonica">
    <definitio>
      Facultas ab ordinario data ut alius potestatem quae ipsi
      competit exerceat: absolvendi, assistendi matrimonio,
      confirmandi.
    </definitio>
    <nota>
      Species cuius defectus actum IRRITUM facit, non illicitum
      solum: qui sine delegatione matrimonio assistit
      matrimonium non facit. Nexus cum actus_sollemnis
      (capacitas agentis) hic strictissimus.
    </nota>
  </species>

</genus>

<!-- ==================================================
     TRACTATUS - conventio inter summas potestates

     Structura DUARUM PHASIUM hic non metaphora est sed ius:
     signatio textum figit et NEMINEM obligat; ratificatio
     obligat. Inter ea status verus iacet cum lege propria
     (signatarius obiectum tractatus frustrari non debet) -
     transactio parata quae claustra sua tenet.
     ================================================== -->

<genus nomen="tractatus" sub="contractus">

  <differentia>
    Conventio inter eos qui superiorem non habent: nullum
    tribunal supra partes est, unde consensus non semel datur
    sed BIS - a legato signante, a principe ratificante - et
    exsecutio ex fide et reciprocitate pendet, non ex coactione.
  </differentia>

  <proprietates>
    <proprietas nomen="multilateralis" genus="veritas"
      ordinarius="falsum"
      nota="duae partes an plures. Multilateralis omnia
            complicat: accessio postea fieri potest, limitationes
            reticulum obligationum pariunt, et vis ex numero
            ratificantium pendet"/>
    <proprietas nomen="numerus_ad_vigorem" genus="numerus"
      nota="quot ratificationes vim pariant - vide actus.quorum,
            cuius hoc species est"/>
  </proprietates>

  <machina_statuum nomen="vigor" gerens="individuum">
    <status nomen="negotiatus"/>
    <status nomen="signatus"
      nota="PHASIS PRIMA (paratus): textus fixus, nemo obligatus.
            NON NIHIL TAMEN - signatarius obiectum et finem
            tractatus frustrare non debet dum ratificatio pendet.
            Status verus cum lege propria, quem schema binarium
            (est/non est) omnino perdit"/>
    <status nomen="ratificatus" nota="a parte, nondum in vigore"/>
    <status nomen="vigens"
      nota="PHASIS SECUNDA PERFECTA: numero ratificationum
            impleto"/>
    <status nomen="suspensus"/>
    <status nomen="terminatus"/>
    <status nomen="abortus"
      nota="ratificatione NEGATA: signatio in nihilum abit.
            Exitus legitimus, non defectus - princeps ratificare
            non tenetur, et id est cur duae phases exsistant"/>
    <transitus a="negotiatus" ad="signatus" per="signari"/>
    <transitus a="signatus" ad="ratificatus" per="ratificari"/>
    <transitus a="signatus" ad="abortus" per="negari"/>
    <transitus a="ratificatus" ad="vigens" per="vigere"/>
    <transitus a="vigens" ad="suspensus" per="suspendi"/>
    <transitus a="vigens" ad="terminatus" per="denuntiari"/>
  </machina_statuum>

  <actiones>
    <actio nomen="signari"/>
    <actio nomen="ratificari"/>
    <actio nomen="negari"/>
    <actio nomen="vigere"/>
    <actio nomen="accedere" nota="ab eo qui non signavit"/>
    <actio nomen="suspendi"/>
    <actio nomen="denuntiari" nota="cum praemonitione plerumque"/>
  </actiones>

  <relationes>
    <relatio nomen="depositarius" ad="organizatio"
      modulus="organizatio"
      nota="qui textum authenticum et indicem ratificationum,
            limitationum, accessionum, denuntiationum custodit.
            ACTA CONSTITUTIVA (vide acta.vis): accedens pars fit
            cum depositum INSCRIBITUR, non cum mittitur - unde
            registrum rem facit, non refert"/>
    <relatio nomen="signatus_per" ad="delegatio" multiplex="verum"
      nota="plenae potestates quibus signatum est"/>
    <relatio nomen="limitatus_per" ad="limitatio" multiplex="verum"/>
    <relatio nomen="ad_vigorem_per" ad="quorum" modulus="actus"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <individuum nomen="tractatus_gandavensis" certitudo="opinio"
    fons="corpus">
    <definitio>
      Tractatus quo bellum inter Britanniam et Civitates
      Foederatas (1812-1815) finitum est, Gandavi confectus.
    </definitio>
    <valor nomen="multilateralis">falsum</valor>
    <historia>
      <eventum quando="1814-12-24" actio="signari">a legatis
        Gandavi signatus - textus fixus, nemo obligatus</eventum>
      <eventum quando="1815-02-17" actio="ratificari">ratificationibus
        permutatis, bellum vere finitum</eventum>
    </historia>
    <nota>
      INDIVIDUUM QUOD STATUM 'SIGNATUS' DOCET MELIUS QUAM ULLA
      DEFINITIO: proelium Novae Aureliae die VIII Ianuarii 1815
      commissum est - post signationem, ante ratificationem, et
      antequam nuntius Americam attigit. Milia ceciderunt intra
      fenestram quam structura duarum phasium ipsa creat.
      Non 'lectio rancida' sola (etsi et ea fuit) sed ACTIO
      INTRA INTERVALLUM INCERTUM - quod systemata distributa
      cotidie patiuntur et raro tam caro pretio.
    </nota>
  </individuum>

</genus>

<!-- ==================================================
     LIMITATIO - consensus partialis

     Nomen electum quia 'reservatio' iam genus est (tempus:
     capacitas futura alicui servata) et 'exceptio' quoque
     occupatum - probatio collisionum ante ambulationem hoc
     ipsum praevenit.
     ================================================== -->

<genus nomen="limitatio">

  <definitio>
    Declaratio unilateralis qua pars, tractatum accipiens,
    effectum quorundam articulorum in se excludit aut mutat:
    consensus non integer sed circumscriptus.
  </definitio>

  <differentia>
    CONSENSUS NON EST BINARIUS, et hoc genus id probat. Sed
    effectus mirabilior est: limitatio inter limitantem et
    UNAMQUAMQUE aliam partem seorsum agit, prout illa obiecerit
    necne. Unde tractatus unus multilateralis in RETICULUM
    obligationum bilateralium solvitur - una charta, obligationes
    quot paria sunt. Nulla alia res bibliothecae hanc formam
    habet.
  </differentia>

  <proprietates>
    <proprietas nomen="articuli" genus="textus"
      nota="quos articulos tangat"/>
    <proprietas nomen="modus" genus="electio">
      <optio>exclusio</optio>
      <optio>modificatio</optio>
    </proprietas>
    <proprietas nomen="compatibilis_cum_fine" genus="veritas"
      nota="an obiecto et fini tractatus repugnet. LIMES
            LIMITATIONIS: quae obiectum ipsum evertit non
            admittitur - aliter pars accipere posset omnia
            negando. Iudicium, non factum (vide asseritur_per)"/>
  </proprietates>

  <relationes>
    <relatio nomen="ad_tractatum" ad="tractatus"/>
    <relatio nomen="lata_a" ad="*"/>
    <relatio nomen="obiecta_a" ad="*" multiplex="verum"
      nota="partes quae obiecerunt. RETICULUM HINC ORITUR:
            inter limitantem et non-obicientem tractatus
            limitatus valet; inter limitantem et obicientem
            articuli tacti inter eos non valent; obiectio
            gravior totum vinculum inter eos tollere potest.
            Tres status ex una charta, per paria"/>
    <relatio nomen="asseritur_per" ad="iudicium" modulus="iudicium"
      nota="compatibilitas cum fine ASSERITUR, non legitur"/>
  </relationes>

  <nota>
    COGNATIO COMPUTATRALIS: negotiatio optionum in protocollis
    idem facit - duo pares copiam suam offerunt, et colloquium
    INTERSECTIONE regitur, non norma. Ideo 'norma implementata'
    parum dicit: quaerendum est quid hic par cum illo pare
    conveniat. Diplomatia hoc saeculis ante nominavit et
    doctrinam de limitibus eius (compatibilitas cum fine)
    elaboravit, quam ars computatralis non habet.
  </nota>

</genus>

</natura>
