<?xml version="1.0" encoding="UTF-8"?>
<!--
  natura/acta.stml
  Exemplar semanticum: ACTA (versio 3, PLASTICUM)

  ABSENTIA STRUCTURALIS, exercitio modellationis inventa (rota
  XLIV): non circulus coverturae qui hiatus quaerit, sed subiectum
  domesticum (silex+volumen) quod bibliotheca DESCRIBERE conata
  est. Genus deerat quod bibliotheca QUINQUIES iam implebat:
  gesta, tabularium, volumen, ratio_rationaria, et mechanismus
  <historia>/<eventum> FORMAE NOSTRAE IPSIUS.

  IDEM GENUS ABSENTIAE QUOD 'programma' (cursus quintus): genus
  quod solum in forma specializata vivebat. Ibi bibliotheca se
  contra programma definiebat sine programmate; hic
  ratio_rationaria formam generalem verbis suis DICEBAT ('veritas
  est cauda eventuum, status omnis PLICATURA') dum apparatus eius
  pecuniarius manebat - continet->venditio, rationarius->persona.
  Species erat cuius parens numquam natus est.

  QUOD NOVUM NON EST: hoc "fontem eventuum" nuper vocamus; ars
  rationaria ab anno 1494 descriptum tenet, chancellaria regesta
  sua a saeculo XII, populus Romanus acta diurna ante Christum.
  Nomen 'acta' ideo non ex arte computatrali sumitur sed ex
  usu Romano, qui prior est.

  DUO GENERA HIC: acta ipsa, et PUNCTUM ACTORUM - locus nominatus
  in cauda. Punctum asperitatem mensuratam solvit: conditio
  silicis in TEMPORE non est sed in SERIE ('numquam timestamp',
  lex eius), et /tempus/momentum id ferre non potuit.
-->
<natura modulus="acta" versio="3" lingua="latina">

<fontes>
  <fons clavis="corpus" genus="corpus_institutionis"
    modulus="iudicium" verificatus="falsum">
    Corpus institutionis scribae: dies et res gestae ex textibus
    innumeris haustae. NON VERIFICATUM.
  </fons>
</fontes>

<genus nomen="acta">

  <definitio>
    Series eventuum ordinata cui SOLUM APPENDITUR, et quae rerum
    descriptarum VERITAS est: status quilibet (summa, manifestum,
    saldum, arbor) non seorsum custoditur sed ex cauda PLICATUR.
    Emendatio numquam per rasuram sed per eventum novum, quia
    acta quae rescribi possunt acta non sunt.
  </definitio>

  <differentia>
    Non series eventuum quaelibet: series quae PRIMA est. In
    ratione vulgari status custoditur et acta eum COMITANTUR
    (annales additi ne quis quaerat "quando mutatum est?"); hic
    acta sola manent et status omnis derivatus est. Discrimen
    operativum: proiectionem perdere nihil perdit, acta perdere
    omnia perdit.
  </differentia>

  <proprietates>
    <proprietas nomen="ordinatio" genus="electio"
      nota="unde ordo veniat. ASPERITAS MENSURATA silicis hic
            sedet: proicere -ad SEQUENTIAM ambulat, numquam
            horologium ('NUMQUAM timestamp' lex eius), quia
            solum contentum 'a te editum' ab 'novius' distinguit.
            Horologia mentiuntur, discrepant, retro saliunt;
            positio non potest">
      <optio>sequentialis</optio>
      <optio>temporalis</optio>
      <optio>utraque</optio>
    </proprietas>
    <proprietas nomen="immutabilitas" genus="electio"
      nota="quid appensum custodiat. Distinctio gravis: quod
            disciplina sola servat servari DESINIT cum quis
            festinat">
      <optio>disciplina</optio>
      <optio>structura</optio>
      <optio>cryptographica</optio>
    </proprietas>
    <proprietas nomen="retentio" genus="quantitas"
      modulus="mensura"
      nota="quamdiu servetur. Acta quae truncantur veritas esse
            DESINUNT pro eo quod truncatum est - unde
            proiectiones tunc necessariae, non commodae"/>
    <proprietas nomen="publica" genus="veritas"
      nota="an quivis legere possit. Acta diurna Romana in foro
            proponebantur; acta senatus non"/>
    <proprietas nomen="vis" genus="electio"
      nota="INTERROGATIO QUAM NEMO BASI DATORUM PONIT, cursu
            octavo (registro civili) postulata: FACIUNTNE ACTA
            REM, an rem factam RECORDANT? Nativitas declaratoria
            est - infans natus est sive quis inscribat sive non,
            et inscriptio falsa esse potest quia veritas alibi
            iacet. Societas constitutiva: ANTE inscriptionem
            nihil est de quo erretur. Discrimen practicum
            immane: acta constitutiva 'ex fonte veritatis
            synchronizare' velle est veritatem invertere, quia
            fons ipsa sunt">
      <optio>declaratoria</optio>
      <optio>constitutiva</optio>
    </proprietas>
  </proprietates>

  <!-- PARTES: index quo ABSENTIA visibilis fit. Mechanismus a
       septem generibus solis adhibitus (mensuratum rota XLIII) et
       hic proprie postulatus: acta sine puncto nominato
       interrogationi "qualis erat cum emisimus?" respondere NON
       POSSUNT, et nemo id sentit donec quaerat -->
  <partes>
    <pars nomen="eventum" necessaria="verum"
      nota="introitus ipsi"/>
    <pars nomen="ordo" necessaria="verum"
      nota="principium ordinandi - vide proprietatem ordinationis"/>
    <pars nomen="punctum_nominatum" necessaria="falsum"
      nota="ABSENTIA MAXIME LATENS: acta sine punctis nominatis
            plicari possunt ad quemlibet locum sed ad nullum
            locum SIGNIFICANTEM. 'ut erat ad eventum 4471' semper
            licet; 'ut erat cum emisimus' non nisi punctum
            positum sit"/>
    <pars nomen="proiectio" necessaria="falsum"
      nota="plicatura materializata. Non necessaria - acta parva
            ad quamlibet interrogationem replicari possunt;
            necessaria fit cum replicatio pretiosior est quam
            custodia"/>
    <pars nomen="promptuarium_contenti" necessaria="falsum"
      nota="ubi eventus contentum GRANDE portat, acta plerumque
            SIGILLUM referunt et contentum alibi condunt (massae
            voluminis). Tunc veritas DUPLEX est - acta et
            promptuarium - et neutrum solum sufficit. Hoc facile
            neglegitur: qui acta sola servat contenta perdidit"/>
  </partes>

  <machina_statuum nomen="admissio" gerens="individuum">
    <status nomen="aperta" nota="appensionem admittit"/>
    <status nomen="clausa"
      nota="periodus rationaria clausa, emissio sigillata: nihil
            amplius huc appenditur. Non deletio sed FINIS -
            emendatio in acta SEQUENTIA it (stornatio)"/>
    <status nomen="archivata"
      nota="mota ubi legi potest sed non currit"/>
    <transitus a="aperta" ad="clausa" per="clausura"/>
    <transitus a="clausa" ad="archivata" per="archivatio"/>
  </machina_statuum>

  <actiones>
    <actio nomen="appendere"
      nota="actio UNICA quae acta mutat"/>
    <actio nomen="plicare"
      nota="statum ex cauda computare, ad quemlibet locum"/>
    <actio nomen="signare"
      nota="punctum nominatum ponere"/>
    <actio nomen="stornare"
      nota="eventum novum appendere qui priorem CONTRARIAT.
            Verbum artis rationariae; quod VCS 'revert' vocat
            (non 'rebase' - illud rasura est, quam haec forma
            vetat)"/>
    <actio nomen="claudere"/>
  </actiones>

  <relationes>
    <relatio nomen="de" ad="*"
      nota="cuius rei acta sint - apertum consulto: quidlibet
            actis describi potest"/>
    <relatio nomen="plicatur_in" ad="proiectio"
      modulus="elementa_programmatis" multiplex="verum"
      nota="plicatura proiectio est, et LICENTIAM DELENDI inde
            accipit. Voluminis nostri probatio hoc ipsum figit:
            plicam_ad(0) enumerationi manifesti aequalis - eadem
            replicatio quae proiectionem probat"/>
    <relatio nomen="signata_per" ad="punctum_actorum"
      multiplex="verum"/>
    <relatio nomen="appenditur_a" ad="*"
      nota="quis appendat - persona, processus, magistratus"/>
  </relationes>

  <!-- ================= DICTIONARIUM =================
       divisio per DOMINIUM, quia forma eadem est et usus
       differt. Nulla harum ficta: omnes nomina propria in
       dominiis suis ferunt, saecula ante artem computatralem -->

  <species nomen="acta_publica" certitudo="opinio" fons="corpus">
    <definitio>
      Res gestae communitatis ordine temporis propositae: acta
      diurna populi Romani (in foro albata proponebantur), acta
      senatus. Publicatio pars formae est, non additamentum -
      quod omnes legere possunt nemo tacite mutat.
    </definitio>
    <valor nomen="publica">verum</valor>
    <nota>
      Immutabilitas hic non cryptographica sed SOCIALIS:
      exemplaria multa apud multos, unde emendatio clandestina
      impossibilis. Eadem ratio qua catenae sigillorum hodie
      utuntur, per homines potius quam per numeros.
    </nota>
  </species>

  <species nomen="regesta" certitudo="opinio" fons="corpus">
    <definitio>
      Liber cancellariae in quo acta EMISSA (litterae, privilegia,
      bullae) ordine describuntur antequam mittantur: exemplar
      apud emittentem manet, ut quid dictum sit constet cum
      exemplar acceptoris perierit aut fictum sit.
    </definitio>
    <nota>
      Motivum quod ad hodiernum transit: acta non ad memoriam
      sed ad PROBATIONEM contra falsarium. Regesta Vaticana
      hanc formam a saeculo XII continue tenent - series
      actorum longissima quae currere non desiit.
    </nota>
  </species>

  <species nomen="acta_transactionum">
    <definitio>
      Cauda mutationum ANTE applicationem scripta (write-ahead):
      basis datorum ipsa proiectio est, et post casum ex actis
      reficitur. Forma inversa eius quod intuitio suggerit -
      acta non basim sequuntur sed praecedunt.
    </definitio>
    <valor nomen="ordinatio">sequentialis</valor>
    <nota>
      Hic pars 'promptuarium_contenti' abest et abesse debet:
      eventus contentum suum TOTUM portat, quia post casum nihil
      aliud superest quo referatur.
    </nota>
  </species>

  <species nomen="acta_versionum">
    <definitio>
      Acta mutationum plagularum, quorum plicatura ARBOR est:
      manifestum viarum ad contenta. Quod "commit" vocatur
      punctum nominatum est, non obiectum.
    </definitio>
    <valor nomen="ordinatio">sequentialis</valor>
    <valor nomen="immutabilitas">cryptographica</valor>
    <nota>
      DUAE DISCIPLINAE HIC DIVIDUNTUR, et divisio bibliothecae
      nostrae aliquid dicit. Instrumenta quae CAPUT ferunt
      (git) historiam rescribere permittunt - rebase rasura
      est, quam definitio horum actorum vetat. Volumen nostrum
      capite CARET consulto: cauda tota manet, arbor vetus fit,
      conditio sequens praeteritum praesens facit ut punctum
      NOVUM. Id stornatio est, non rasura - disciplina Pacioli
      electa ubi disciplina git offerebatur.
    </nota>
  </species>

  <species nomen="acta_auditus">
    <definitio>
      Acta quorum finis est ut QUIS QUID QUANDO fecerit postea
      constet, praesertim contra ipsum qui fecit. Unde
      immutabilitas non commoditas sed ratio essendi.
    </definitio>
    <nota>
      Genus unicum in quo APPENDENS et is contra quem acta
      valent idem esse possunt - unde structura sola sufficit,
      disciplina non sufficit. Vide proprietatem
      immutabilitatis: hic 'disciplina' responsum FALSUM est
      semper, et hoc dicere pars descriptionis est.
    </nota>
  </species>

</genus>

<!-- ==================================================
     PUNCTUM ACTORUM - locus nominatus in cauda
     ================================================== -->

<genus nomen="punctum_actorum">

  <definitio>
    Locus in actis nominatus et allocutione dignus, ita ut
    interrogatio "qualia erant HIC?" responsum habeat quod homo
    petere velit. Non eventus sed POSITIO inter eventus.
  </definitio>

  <differentia>
    Positio in SERIE, non in tempore. Momentum temporis quemlibet
    locum designare potest sed horologio nititur, quod discrepat,
    retro salit, et duobus eventibus idem valere potest. Positio
    haec vitia natura non habet - unde acta quae serio se gerunt
    per positionem ambulant, non per horas.
  </differentia>

  <proprietates>
    <proprietas nomen="positio" genus="numerus"
      nota="index in cauda"/>
    <proprietas nomen="titulus" genus="textus"
      nota="cur hoc punctum positum sit - 'nuntius conditionis'.
            Punctum sine titulo positionem habet, significationem
            non"/>
    <proprietas nomen="momentum_positionis" genus="citatio"
      nota="quando positum. ACCIDENS, non identitas: punctum
            sine horologio integrum manet, quod inversum falsum
            est"/>
    <proprietas nomen="automaticum" genus="veritas"
      nota="a machina positum an ab homine. Puncta automatica
            (statio basis datorum) multa et muta sunt; humana
            pauca et significantia. Utraque plicari possunt,
            sed sola humana interrogationi 'cum emisimus'
            respondent"/>
  </proprietates>

  <relationes>
    <relatio nomen="in" ad="acta"/>
    <relatio nomen="praecedens" ad="punctum_actorum"
      nota="punctum proximum ante. Series simplex, non arbor:
            arbor ramorum (git) puncta MULTIPLICIA post idem
            punctum ponit, quod haec relatio nondum fert -
            vide dubium"/>
    <relatio nomen="positum_a" ad="*"/>
  </relationes>

  <species nomen="conditio">
    <definitio>
      Punctum in actis versionum, cum titulo ab homine dato:
      quod "commit" vulgo vocatur. Non obiectum quod arborem
      CONTINET sed locus ad quem arbor plicari potest.
    </definitio>
    <nota>
      Distinctio in silice explicita: "conditio non obiectum sed
      punctum nominatum in cauda actorum - arbores plicae sunt,
      manifestum plica currens". Instrumenta quae conditionem
      OBIECTUM faciunt (git commit continens arborem) idem
      praestant pretio maiore et historia rescribili.
    </nota>
  </species>

  <species nomen="clausura_rationis">
    <definitio>
      Punctum quo periodus rationaria clauditur et saldum
      constat: post id nihil in periodum appenditur, emendatio
      in periodum sequentem it.
    </definitio>
    <valor nomen="automaticum">falsum</valor>
  </species>

  <species nomen="statio">
    <definitio>
      Punctum a machina positum ut plicatura pretiosa semel fiat
      et postea ab eo, non ab initio, incipiat: quod
      "checkpoint" aut "snapshot" vocatur.
    </definitio>
    <valor nomen="automaticum">verum</valor>
    <nota>
      Species quae SOLA propter pretium exsistit, non propter
      significationem - unde deleri potest sine damno, ubi
      conditio et clausura non possunt. Signum quod puncta duo
      genera officiorum gerunt.
    </nota>
  </species>

  <dubium>
    RAMI: haec relatio 'praecedens' seriem simplicem supponit.
    Acta ramosa (git) puncta plura post idem punctum ferunt, et
    tunc 'plicatura ad punctum' viam eligere debet. An ramus
    proprietas actorum sit, an genus proprium (ramus), an acta
    ramosa acta PLURA sint quae puncta communia participant -
    non decisum. Silex ramos nondum habet, ergo casus cogens
    unus tantum est; lex domus DUOS poscit.
  </dubium>

</genus>


<!-- ==================================================
     ATTESTATIO - proiectio DETRACTA

     Cursu octavo inventa (registrum civile), et lex quam fert
     longe extra registra valet: PROIECTIO QUAM TRADIDISTI
     PROIECTIO ESSE DESINIT.

     Proiectio (elementa_programmatis) LICENTIAM DELENDI habet -
     dele et renascitur. Attestatio ea caret non natura sed
     SITU: in manibus alterius est. Acta mutantur, charta non;
     et nemo eam revocare potest quia ubi sit ignoratur.
     Eadem forma: relationes impressae, credentia promptuaria,
     figurationes distributae, claves API emissae.

     NON EST TITULUS (probatum ante aedificationem): titulus
     'permanens' definitur, 'non expirat nec revocatur - quod
     factum est infectum fieri nequit'. Attestatio nativitatis
     hoc omnino non est: senescit (multae auctoritates eam ultra
     tres menses natam recusant), superatur, iterum emittitur.
     Titulus REM attestatam est; attestatio CHARTA.
     ================================================== -->

<genus nomen="attestatio">

  <definitio>
    Exemplar authenticum ex actis auctoritativis sumptum, quod
    quid in actis steterit MOMENTO EMISSIONIS testatur, et
    traditum ab actis suis SEPARATUR: veritas pergit mutari,
    charta non.
  </definitio>

  <differentia>
    Proiectio quae TRADITA est. Proiectio ordinaria delectionem
    patitur quia renascitur; haec renasci potest (aliam pete)
    sed EA QUAM TENES renovari non potest, nec ab emittente
    attingi. Ideo quaestio propria attestationis non 'estne
    vera?' sed 'QUANDO vera fuit?' - quam nulla proiectio
    domestica ponere cogitur.
  </differentia>

  <proprietates>
    <proprietas nomen="emissa" genus="dies"
      nota="momentum veritatis eius - non accidens sed
            IDENTITAS: attestatio sine die emissionis nihil
            asserit, quia quod asserit tempore ligatum est"/>
    <proprietas nomen="aetas_accepta" genus="quantitas"
      modulus="mensura"
      nota="quamdiu accipiens eam recentem habeat (saepe tres
            menses). PROPRIETAS ACCIPIENTIS, non chartae: eadem
            attestatio ab uno accepta ab alio recusatur, quod
            probat senescentiam in usu vivere, non in re"/>
    <proprietas nomen="expirat" genus="dies"
      nota="DEFECTUS MENSURATUS CURSU NONO (infrastructura
            fidei) et hic sanatus. Genus ex chartis status
            civilis natum senectutem SOLAM accipientis noverat -
            attestatio nativitatis per se numquam expirat, et
            registrarius qui trimestrem recusat REGULAM SUAM
            imponit. Certificatum autem TLS diem finalem ab
            EMITTENTE fixum fert: expirat in se, nullo accipiente
            iudicante. Machina statum 'expirata' iam habebat et
            causam intrinsecam non habebat - status sine motore.
            Utraque manent quia utraque vera sunt, et confundere
            eas est renovationem eo tempore agere quo nemo
            poposcit (aut non agere cum omnes poscent)"/>
    <proprietas nomen="fundamentum" genus="textus"
      nota="QUID EMITTENS RE VERA PROBAVERIT antequam testaretur.
            Cursu nono postulatum: certificatum 'domanio
            validatum' et 'validatione extensa' res EIUSDEM
            FORMAE sunt et warrantum prorsus diversum ferunt -
            illud probat quod petens litteras electronicas
            legere potuit, hoc quod societas re vera exsistit et
            eam possidet. Sine hoc campo attestatio dicit se
            testari et tacet quantum sciat. Vide iudicium:
            gradus assensus emittentis hic vivit"/>
    <proprietas nomen="signum_authenticitatis" genus="electio">
      <optio>sigillum</optio>
      <optio>subscriptio</optio>
      <optio>charta_secura</optio>
      <optio>subscriptio_digitalis</optio>
    </proprietas>
    <proprietas nomen="integra" genus="veritas"
      ordinarius="verum"
      nota="an totum introitum ferat an partem (extractus
            brevis qui filiationem celat) - attestatio PARTIALIS
            legitima est et saepe iure postulata"/>
  </proprietates>

  <machina_statuum nomen="vigor" gerens="individuum">
    <status nomen="emissa"/>
    <status nomen="superata"
      nota="acta post emissionem mutata sunt. CHARTA INTACTA
            MANET - status hic de RELATIONE ad acta dicitur, non
            de re ipsa: nihil ei accidit, et tamen falsa facta
            est. Status quem nulla res corporea habere potest
            nisi ab alio pendeat"/>
    <status nomen="revocata"
      nota="ab emittente irrita declarata - sed charta adhuc in
            manibus est, unde revocatio NUNTIANDA est ne
            frustra sit"/>
    <status nomen="expirata" nota="aetate acceptationis elapsa"/>
    <transitus a="emissa" ad="superata" per="mutatio_actorum"/>
    <transitus a="emissa" ad="revocata" per="revocatio"/>
    <transitus a="emissa" ad="expirata" per="lapsus_temporis"/>
  </machina_statuum>

  <actiones>
    <actio nomen="emitti"/>
    <actio nomen="exhiberi" nota="apud eum qui eam poscit"/>
    <actio nomen="legalizari" nota="ut extra fines valeat"/>
  </actiones>

  <relationes>
    <relatio nomen="ex_actis" ad="acta"
      nota="fons veritatis. Attestatio sine actis nominatis
            adseveratio est, non attestatio.
            HAEC SENTENTIA DEFECTUM HISTORICUM PRAEDIXIT, cursu
            nono inventa: certificata telae ante annum 2013 acta
            NULLA habebant - auctoritas signabat et nemo
            enumerare poterat quid signavisset, unde
            certificatum male emissum invisibile manebat donec
            adhiberetur. Id est adseveratio, non attestatio, hac
            definitione. Transparentia certificatorum (acta
            solum-appendia, cryptographice immutabilia, publice
            auditabilia) ACTA DEESSE RETRO ADDIDIT - remedium
            quod definitio nostra ut REQUISITUM iam ferebat.
            Genus e registro civili natum vitium quod PKI telae
            per duo decennia fregit definitione sua dicit"/>
    <relatio nomen="ad_punctum" ad="punctum_actorum"
      nota="qualis status actorum testetur - plerumque tacitum
            ('ut nunc stat'), sed explicitum fieri potest, et
            tunc attestatio superari NON potest quia punctum
            immotum est. Solutio quam pauci adhibent"/>
    <relatio nomen="emissa_a" ad="organizatio" modulus="organizatio"/>
    <relatio nomen="de" ad="*"
      nota="cuius rei - persona, res, societas, eventus"/>
    <relatio nomen="testatur" ad="attestatio"
      nota="attestatio DE ATTESTATIONE (apostilla): recursio
            quae ex definitione sponte sequitur, nullo
            mechanismo addito - signum quod genus recte
            sectum est"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <species nomen="attestatio_civilis">
    <definitio>
      Ex actis status civilis sumpta: nativitatis, matrimonii,
      mortis. Species usitatissima et exemplar ceterarum.
    </definitio>
    <nota>
      Confusio vulgatissima quam genus tollit: "charta
      nativitatis mea" identitatem meam NON constituit -
      introitus in actis eam fert, charta eum refert. Qui
      chartam perdit nihil perdit nisi chartam; qui acta perdit
      civem perdit. Registra quae hoc confundunt homines
      apatridas faciunt cum archivum ardet.
    </nota>
  </species>

  <species nomen="instrumentum_publicum">
    <definitio>
      A notario (aut persona publica) confectum, cui fides
      publica inest: quod in eo scriptum est verum praesumitur
      donec falsitas probetur.
    </definitio>
    <differentia>
      Attestatio cuius acta NOTARII ipsius sunt (protocollum),
      non magistratus: notarius originale servat et exemplaria
      authentica partibus emittit - eadem structura prorsus,
      auctoritate privata gesta.
    </differentia>
    <nota>
      TRANSLATUM ex actus.actus_iuridicus (rota XLIX). Ibi
      SPECIES ACTUS erat, et definitio ipsa se prodebat: "quod
      IN EO SCRIPTUM est verum praesumitur" - de charta
      loquitur, non de actu. Idem discrimen quod iussum solvit
      (actus momentaneus contra rem perdurantem), hic in
      altera parte inventum: ibi actus in rem versus, hic res
      inter actus posita. Actus confectionis manet actus;
      quod tenes attestatio est.
      Specimen quod CAPACITATEM purissime ostendit: eadem verba
      a privato scripta nihil praesumunt. Officium hominem
      distinguit, non peritia.
    </nota>
  </species>

  <species nomen="apostilla">
    <definitio>
      Attestatio quae subscriptionem aut sigillum attestationis
      ALTERIUS authenticam esse testatur, ut extra fines valeat
      (conventio Hagana 1961).
    </definitio>
    <differentia>
      Cuius subiectum ipsa attestatio est, non res. Nihil de re
      dicit - de CHARTA sola loquitur, et ideo falsam
      attestationem authenticam declarare potest sine mendacio:
      quod testatur signum est, non contentum.
    </differentia>
    <nota>
      Quod ante conventionem catena legalizationum erat
      (minister, legatio, ministerium alterius) apostilla ad
      gradum UNUM redegit - recursio abbreviata per pactum, non
      per naturam.
    </nota>
  </species>

</genus>


<!-- ==================================================
     RADIX FIDUCIAE - ubi regressus PONITUR, non probatur

     Cursu nono inventa. Attestatio attestationem testari potest
     (relatio testatur, apostilla eam peperit), unde CATENA; sed
     catena finiri debet, et finis probari non potest - probaretur
     enim ab attestatione altera, et regressus pergeret. Ergo
     terminus DECERNITUR.

     PERICULUM POSITIONIS AGNITUM: bibliotheca bis genus occidit
     quod POSITIONEM nominabat, non naturam (effectus, actio).
     Cur hoc superest: radix non est locus quem res forte tenet
     sed STATUS COLLATUS - navigatri auctor radicem ADMITTIT,
     lex notarium CREAT, et admissio actus est cum die, auctore,
     revocabilitate. Praeterea radices allocutione dignae sunt
     et enumerantur. Probatio allocutionis transit.
     ================================================== -->

<genus nomen="radix_fiduciae">

  <definitio>
    Terminus catenae attestationum, cui fides non ex alia
    attestatione venit sed ex DECRETO eius qui catenam
    adhibet: quod creditur non quia probatum sed quia
    susceptum.
  </definitio>

  <differentia>
    Sola res in catena quae se ipsam attestatur (aut nihil), et
    hoc non vitium est sed necessitas: regressus infinitus fidem
    omnem tolleret. Ideo quaestio de radice numquam "estne
    vera?" sed "CUR HANC SUSCEPIMUS, et quis eam tollere
    potest?"
  </differentia>

  <proprietates>
    <proprietas nomen="modus_susceptionis" genus="electio"
      nota="unde in catenam venerit. AXIS GRAVISSIMUS: quod cum
            systemate venit nemo eligit, et tamen omnia ei
            credunt - fiducia ordinaria non decreta sed
            HEREDITATA est">
      <optio>cum_systemate_missa</optio>
      <optio>ab_utente_addita</optio>
      <optio>lege_statuta</optio>
      <optio>consuetudine_recepta</optio>
    </proprietas>
    <proprietas nomen="tollibilis_a" genus="textus"
      nota="QUIS eam removere possit. Interrogatio practica quae
            rem politicam facit: radicem systematis solus
            venditor systematis tollit, unde qui radices regit
            fidem interretis regit sine ullo iure formali"/>
    <proprietas nomen="ambitus_fidei" genus="textus"
      nota="ad quid valeat - radices modernae limitantur (haec
            certificata telae sola, illa subscriptiones codicis).
            Radix sine limite omnia potest, quod olim ordinarium
            erat et periculum eius sero agnitum"/>
  </proprietates>

  <machina_statuum nomen="susceptio" gerens="individuum">
    <status nomen="suscepta"/>
    <status nomen="limitata"
      nota="fides angustata sed non ablata - quod fieri solet
            ubi auctoritas erravit nec tamen tota reicienda est"/>
    <status nomen="reiecta"
      nota="EVENTUS QUI OMNIA SUB EA SIMUL OCCIDIT: attestationes
            innumerae, quarum nulla per se vitiosa, uno decreto
            cadunt. Damnum collaterale in natura catenae
            inaedificatum"/>
    <status nomen="refundata"
      nota="EADEM RADIX, FUNDAMENTUM ALIUD - status cursu XV
            (metrologia) postulatus, quem forma non habebat quia
            reiectionem solam praevidebat.
            SPECIMEN: chilogramma usque ad annum 2019 in RE
            CORPOREA desinebat (prototypum internationale), et
            prototypum cum exemplaribus suis per saeculum
            decinis microgrammatum DISCESSIT - nec dici poterat
            quid mutatum esset, quia prototypum chilogramma ERAT
            et falsum esse non poterat, sed aliud tantum ab
            omnibus. Ideo SI redefinitum est ut chilogramma ex
            constante Planck flueret - ET VALOR NUMERICUS ITA
            ELECTUS UT MOMENTO TRANSITUS NIHIL MUTARETUR.
            Radix ergo nec reiecta nec limitata sed SUBTER
            SUBSTITUTA, continuitate servata: quod supra eam
            stat nihil sensit.
            GEMINA COMPUTATRALIA EXACTA: radix fiduciae migrata,
            algorithmus digestionis mutatus identitate servata,
            clavis rederivata sine invalidatione eorum quae
            signaverat. Difficillimum omnium, et sola via qua
            radix mutari potest sine damno collaterali quod
            'reiecta' fert"/>
    <transitus a="suscepta" ad="limitata" per="limitatio"/>
    <transitus a="suscepta" ad="reiecta" per="reiectio"/>
    <transitus a="limitata" ad="reiecta" per="reiectio"/>
    <transitus a="suscepta" ad="refundata" per="refundatio"/>
    <transitus a="refundata" ad="refundata" per="refundatio"
      nota="iterari potest: fundamentum mutari potest quotiens
            melius invenitur, valore semper servato"/>
  </machina_statuum>

  <relationes>
    <relatio nomen="fundat" ad="attestatio" multiplex="verum"
      nota="quas attestationes (per catenam) sustineat"/>
    <relatio nomen="suscepta_per" ad="actus_iuridicus"
      modulus="actus"
      nota="MEMBRUM PER ACTUM: nemo radix fit natura sua -
            admittitur, et admissio diem, auctorem, revocationem
            habet"/>
    <relatio nomen="tenetur_a" ad="organizatio"
      modulus="organizatio"
      nota="cuius sit"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <species nomen="radix_systematis">
    <definitio>
      Auctoritas certificatoria cuius attestatio cum systemate
      aut navigatro missa est: fides praeinstallata.
    </definitio>
    <valor nomen="modus_susceptionis">cum_systemate_missa</valor>
    <nota>
      Specimen quod proprietatem 'tollibilis_a' postulavit:
      utens radicem removere theoretice potest, re vera non -
      quia remota, dimidium telae frangitur. Fiducia quae
      technice electiva est et practice necessaria.
    </nota>
  </species>

  <species nomen="commissio_notarii">
    <definitio>
      Auctoritas ipsius notarii, a magistratu collata: quae
      instrumenta eius publica facit et ipsa ab alio notario
      non pendet.
    </definitio>
    <valor nomen="modus_susceptionis">lege_statuta</valor>
    <nota>
      Radix eiusdem formae in dominio mille annorum: quis
      notarium notarizat? Nemo - lex eum constituit, et ibi
      regressus sistit. Specimen quod genus a rebus
      computatralibus liberat.
    </nota>
  </species>

  <species nomen="origo_dominii">
    <definitio>
      Primum in catena titulorum praedii, ultra quod investigatio
      non procedit: concessio principis, adiudicatio, aut
      possessio antiquissima quae probari potest.
    </definitio>
    <valor nomen="modus_susceptionis">consuetudine_recepta</valor>
    <nota>
      Nomen mutatum ante commissionem (monitum regulae XVIII):
      titulus_originarius stirpem titulus ferebat et speciem
      eius videbatur, cum obligatio.titulus ATTESTATIO sit
      (gradus, honor) et haec CATENAE DOMINII origo - homonymia
      Latina vera (titulus = et honor et iusta causa acquirendi)
      sed in indice fallax. Regula quae monet, non prohibet,
      hic emendationem ANTE partum peperit.
      Radix per LASSITUDINEM potius quam per decretum: nemo eam
      elegit, sed investigatio alicubi desinere debet, et lex
      terminum statuit (saepe annos LX aut XC). Species quae
      ostendit radices non semper poni consulto - aliquando
      catena simpliciter deficit et id quod restat radix fit.
    </nota>
  </species>

</genus>

</natura>
