<?xml version="1.0" encoding="UTF-8"?>
<!--
  natura/persona.genera
  Exemplar semanticum: PERSONA (versio 7, PLASTICUM)
  v3->v4: Meyer (bis postulatus: CQS et pactum), Dijkstra
  (superfectus a verbo goto), Scotus (haecceitas ad
  identificatorem) - dictionarium a stratis elementorum et
  communicationis poscentibus crevit. Pacioli additus (v5).

  EXEMPLAR PRIMUM MECHANISMI FIDEI (rota XVI): hoc exemplar
  primum <fontes> declarat et valores suos certitudine= notat.
  Cur hic primum? Quia mendacissimum erat: dies natales et
  mortuales omnes ex corpore institutionis scribae veniunt,
  NULLUS verificatus, et forma prior eos ut certos praebebat.
  Bibliotheca quae de veritate loquitur de SUA veritate primum
  loqui debet.

  Genus trans-dominiale primum: relationes aliorum exemplarium
  (auctor linguae, scriptor normae) hoc genus POPOSCERUNT -
  auctores ut textus mendacium commoditatis erat; Dennis Ritchie
  persona est, non chorda.

  Individua notabilia recordi publici hic vivunt (prosopographia,
  more dictionarii biographici); personae TUAE (contactus, socii)
  in voluminibus applicationum, genus hoc citantes.
-->
<natura modulus="persona" versio="7" lingua="latina">

<!-- FONTES: claves quas valores per fons= citant.
     Mechanismus rotae XVI - dubium <fons> (rota VII) solutum
     genere iudicium.fons. -->
<fontes>
  <fons clavis="corpus" genus="corpus_institutionis"
    modulus="iudicium" verificatus="falsum">
    Corpus institutionis scribae (Claude): dies et res gestae
    ex textibus innumeris haustae, sine memoria singulorum.
    NON VERIFICATUM - lector ad verificationem vocatur, non ad
    fidem. Nisi aliter notatum, omnis dies huius exemplaris
    hunc fontem habet et gradum FIDEI, non scientiae.
  </fons>
</fontes>

<.genus nomen="persona">

  <definitio>
    Naturae rationabilis individua substantia (Boethius).
    Subiectum actionum liberarum: auctor esse potest, non solum
    causa.
  </definitio>

  <glossa lingua="en">A person: an individual substance of a
    rational nature (Boethius). A person is the subject of free
    acts - able to be an author, and not merely a cause.</glossa>
  <glossa lingua="fr">Une personne : une substance individuelle de
    nature raisonnable (Boèce). La personne est le sujet des actes
    libres - elle peut être auteur, et non seulement cause.</glossa>

  <proprietates>
    <proprietas nomen="nomina" genus="textus" multiplex="verum"
      nota="personae nomina plura habent - natale, publicum,
            religiosum; primum = usitatissimum"/>
    <proprietas nomen="natus" genus="dies"/>
    <proprietas nomen="mortuus" genus="dies"
      nota="CONFUSIO HIC OLIM FASSA ('vacuum = vivens aut
            ignotum') - duo facta prorsus diversa unam
            repraesentationem communicabant, quod problema NULLI
            Coddianum est in bibliotheca nostra ipsa.
            SOLUTIO NOMINATA (rota XXXVIII): vacuum hic
            'vivens' significat; ubi dies mortis re vera
            IGNORATUR, applicatio IGNOTUM ponat
            (iudicium.ignotum, species ignotum_notum aut
            amissum) - hiatus enim nominatus tractari potest,
            campus vacuus non. Vide graydon_hoare infra, ubi
            dies natalis CONSULTO abest: id ignotum non est
            sed IUDICIUM de eo quod dici non debet - tertium
            genus absentiae, quod nec vacuum nec ignotum
            capit"/>
  </proprietates>

  <!-- MACHINA STATUS CIVILIS (rota XLIX, registro civili
       postulata): exemplar hoc quinquies emendatum machinam
       nullam habebat, dum dominium quod personas PROFESSIONE
       tractat statum civilem prae omnibus elaborat. Non genus
       novum - proprie machina, quia status hi personae ipsi
       insunt et per ACTUS mutantur quos iam habemus. Exemplum
       eius quod bibliotheca 'tenue ubi dominium densum est'
       vocare potest: hiatus non in generibus sed in
       apparatu generis exsistentis -->
  <machina_statuum nomen="status_civilis" gerens="individuum">
    <status nomen="caelebs" nota="numquam nuptus"/>
    <status nomen="coniugatus"/>
    <status nomen="viduus"
      nota="STATUS PROPRIUS, non 'caelebs iterum': iura
            hereditatis, pensionis, nominis ex eo fluunt quae
            caelibi non competunt. Qui hunc statum ad
            'caelebs' reducit vidua exheredat"/>
    <status nomen="divortiatus"
      nota="item proprius - vinculum solutum, sed effectus
            (alimenta, nomen, impedimenta affinitatis) manent"/>
    <transitus a="caelebs" ad="coniugatus" per="matrimonium"
      nota="actus sollemnis ET iuridicus simul - vide
            actus.matrimonium et actus.actus_iuridicus:
            eventus unus, duo genera eum legentia"/>
    <transitus a="coniugatus" ad="viduus" per="mors_coniugis"
      nota="TRANSITUS QUEM SUBIECTUM NON AGIT: solus in machina
            hac ab eventu alieno movetur - status meus mutatur
            actu quem alius patitur"/>
    <transitus a="coniugatus" ad="divortiatus" per="divortium"/>
    <transitus a="viduus" ad="coniugatus" per="matrimonium"/>
    <transitus a="divortiatus" ad="coniugatus" per="matrimonium"/>
  </machina_statuum>

  <actiones>
    <actio nomen="creare" nota="opus novum gignere - fons
      relationum auctoris trans exemplaria"/>
  </actiones>

  <relationes>
    <relatio nomen="auctor_de" ad="*" necessitudo="auctor"
      nota="ad opus cuiusvis generis - relatio aperta consulto:
            opera personarum genera omnia transeunt"/>
    <relatio nomen="membrum_de" ad="organizatio"
      modulus="organizatio" multiplex="verum"/>
    <relatio nomen="domicilium" ad="locus"
      necessitudo="situm_in" modulus="locus"
      nota="DOMICILIUM NON EST UBI ES: sedes quam animo
            manendi habes. Discrimen practicum quod peregrinus
            statim invenit - iurisdictio in personam
            plerumque domicilium sequitur, non praesentiam,
            unde quaestiones tributi, hereditatis, status
            civilis omnes hinc pendent. Locus mutatur cotidie,
            domicilium actu et animo"/>
    <relatio nomen="inscriptus_in" ad="acta"
      necessitudo="continet" modulus="acta"
      multiplex="verum"
      nota="registra in quibus persona introitum habet.
            IMPLICATIO GRAVIS: qui in nullis inscriptus est
            iura probare non potest, unde apatridia non
            defectus personae est sed ACTORUM"/>
  </relationes>
  <!-- dubium organizationis SOLUTUM (v0->v1): exemplar
       organizatio natum - universitas personarum, non persona -->


  <!-- ================= DICTIONARIUM ================= -->

  <individuum nomen="dennis_ritchie">
    <valor nomen="nomina">Dennis MacAlistair Ritchie</valor>
    <valor nomen="natus" certitudo="fides" fons="corpus">1941-09-09</valor>
    <valor nomen="mortuus" certitudo="fides" fons="corpus"
      nota="exemplum principale: forma prior hunc diem eodem
            modo praebebat quo definitiones nostras - quasi
            aeque certum. Non erat">2011-10-12</valor>
    <historia>
      <eventum quando="1972" actio="creare">lingua C</eventum>
      <eventum quando="1978" actio="creare">liber "The C
        Programming Language" (cum Kernighan)</eventum>
    </historia>
  </individuum>

  <individuum nomen="thomas_aquinas">
    <valor nomen="nomina">Thomas de Aquino</valor>
    <valor nomen="natus" certitudo="opinio" fons="corpus"
      nota="annus IPSE disputatus (c. 1225): non solum fide
            acceptus sed inter fontes controversus - gradus
            infra fidem, quia auctoritates ipsae dissentiunt.
            Praecisio 'annus' hic honesta est, non pigritia">1225</valor>
    <valor nomen="mortuus" certitudo="fides" fons="corpus">1274-03-07</valor>
    <historia>
      <eventum quando="1265" actio="creare">Summa Theologiae
        (inceptum; imperfecta relicta)</eventum>
    </historia>
  </individuum>

  <individuum nomen="carl_linnaeus">
    <valor nomen="nomina">Carl Linnaeus</valor>
    <valor nomen="nomina">Carolus Linnaeus</valor>
    <valor nomen="natus">1707-05-23</valor>
    <valor nomen="mortuus">1778-01-10</valor>
    <historia>
      <eventum quando="1735" actio="creare">Systema Naturae</eventum>
      <eventum quando="1753" actio="creare">Species
        Plantarum</eventum>
    </historia>
    <nota>
      Pater formae huius bibliothecae: taxinomia + dictionarium in
      uno artefacto, lingua latina, manu curata.
    </nota>
  </individuum>

  <individuum nomen="josef_pieper">
    <valor nomen="nomina">Josef Pieper</valor>
    <valor nomen="natus">1904-05-04</valor>
    <valor nomen="mortuus">1997-11-06</valor>
    <historia>
      <eventum quando="1974" actio="creare">Missbrauch der
        Sprache, Missbrauch der Macht</eventum>
    </historia>
    <nota>Auctor disciplinae huius bibliothecae (lingua ad
      realitatem, non ad usum)</nota>
  </individuum>

  <individuum nomen="herman_melville">
    <valor nomen="nomina">Herman Melville</valor>
    <valor nomen="natus">1819-08-01</valor>
    <valor nomen="mortuus">1891-09-28</valor>
    <historia>
      <eventum quando="1851" actio="creare">Moby-Dick</eventum>
    </historia>
  </individuum>

  <individuum nomen="ken_thompson">
    <valor nomen="nomina">Kenneth Lane Thompson</valor>
    <valor nomen="natus">1943-02-04</valor>
    <historia>
      <eventum quando="1969" actio="creare">Unix (cum
        Ritchie)</eventum>
      <eventum quando="1969" actio="creare">lingua B</eventum>
    </historia>
  </individuum>

  <individuum nomen="linus_torvalds">
    <valor nomen="nomina">Linus Benedict Torvalds</valor>
    <valor nomen="natus">1969-12-28</valor>
    <historia>
      <eventum quando="1991" actio="creare">nucleus Linux</eventum>
      <eventum quando="2005" actio="creare">git</eventum>
    </historia>
  </individuum>

  <individuum nomen="guido_van_rossum">
    <valor nomen="nomina">Guido van Rossum</valor>
    <valor nomen="natus">1956-01-31</valor>
    <historia>
      <eventum quando="1991" actio="creare">lingua Python</eventum>
    </historia>
  </individuum>

  <individuum nomen="graydon_hoare">
    <valor nomen="nomina">Graydon Hoare</valor>
    <historia>
      <eventum quando="2006" actio="creare" certitudo="fides"
        fons="corpus">lingua Rust (inceptum privatum; publicum
        2010)</eventum>
    </historia>
    <nota>
      Dies natalis ABEST consulto: viventes privati sunt, et
      absentia honestior quam coniectura. Vacuum non est
      defectus dati sed iudicium de eo quod dici non debet.
    </nota>
  </individuum>

  <individuum nomen="brian_fox">
    <valor nomen="nomina">Brian Jhan Fox</valor>
    <valor nomen="natus" certitudo="fides" fons="corpus"
      nota="annus solus notus - praecisio vera, non truncata">1959</valor>
    <historia>
      <eventum quando="1989" actio="creare">bash</eventum>
    </historia>
  </individuum>

  <individuum nomen="edsger_dijkstra">
    <valor nomen="nomina">Edsger Wybe Dijkstra</valor>
    <valor nomen="natus">1930-05-11</valor>
    <valor nomen="mortuus">2002-08-06</valor>
    <historia>
      <eventum quando="1968" actio="creare">epistula "Go To
        Statement Considered Harmful"</eventum>
      <eventum quando="1965" actio="creare">semaphora</eventum>
    </historia>
    <nota>Programmatio structa; clavis una (goto) eum in hoc
      dictionarium vocavit.</nota>
  </individuum>

  <individuum nomen="bertrand_meyer">
    <valor nomen="nomina">Bertrand Meyer</valor>
    <valor nomen="natus">1950-11-21</valor>
    <historia>
      <eventum quando="1985" actio="creare">lingua
        Eiffel</eventum>
      <eventum quando="1988" actio="creare">liber
        "Object-Oriented Software Construction" (pactum ut
        disciplina)</eventum>
    </historia>
    <nota>
      Bis a stratis nostris postulatus uno die: separatio
      quaestionis et imperii (gemini status), deinde
      programmatio per pactum (assertio). Doctor canalium
      declaratorum ante nos.
    </nota>
  </individuum>

  <individuum nomen="luca_pacioli">
    <valor nomen="nomina">Luca Bartolomeo de Pacioli</valor>
    <valor nomen="natus">1447</valor>
    <valor nomen="mortuus">1517-06-19</valor>
    <historia>
      <eventum quando="1494" actio="creare">Summa de arithmetica,
        geometria, proportioni et proportionalita - ratio duplex
        descripta</eventum>
    </historia>
    <nota>
      Frater Franciscanus. Rationem duplicem NON invenit sed
      descripsit (mercatores Venetiarum iam utebantur) - forma
      quam nos "fontem eventuum" vocamus, quinque saeculis ante
      computatra: acta immutabilia, status per plicaturam,
      correctio per actum novum. Pater doctrinae voluminis
      nostri quem numquam novimus.
    </nota>
  </individuum>

  <individuum nomen="duns_scotus">
    <valor nomen="nomina">Ioannes Duns Scotus</valor>
    <valor nomen="natus">1266</valor>
    <valor nomen="mortuus">1308-11-08</valor>
    <historia>
      <eventum quando="1300" actio="creare">Ordinatio
        (inceptum; imperfecta relicta)</eventum>
    </historia>
    <nota>
      Doctor Subtilis. Haecceitas eius genus identificatorem
      divisit: nomen baptismale huius-itatem prensat, sigillum
      contenti eam consulto abicit.
    </nota>
  </individuum>

</.genus>

</natura>
