<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATUM a natura_canones e formae_datorum - NOLI MANU MUTARE.
     Regenera: ./tools/natura_canones.sh -->
<canon dialectus="formae_datorum" versio="1">

  <elementum nomen="individua" radix="verum">
    <liberum nomen="forma-datorum"/>
    <liberum nomen="series"/>
    <liberum nomen="cauda"/>
    <liberum nomen="acervus"/>
    <liberum nomen="tabula-associativa"/>
    <liberum nomen="copia"/>
    <liberum nomen="arbor"/>
  </elementum>

  <elementum nomen="forma-datorum">
    <glossa lingua="en">A data structure: a shape for arranging data
    defined by its OPERATIONS rather than by its implementation -
    what you may ask of it, what is promised, and at what cost. The
    essence lives in the interface (what is called an abstract data
    type); the implementation beneath it changes freely so long as
    the promises hold.</glossa>
    <glossa lingua="fr">Une structure de données : une figure pour
    ordonner les données, définie par ses OPÉRATIONS et non par son
    implémentation - ce que l'on peut lui demander, ce qui est
    promis, et à quel prix. L'essence habite l'interface (ce qu'on
    appelle un type de données abstrait) ; l'implémentation qui se
    trouve dessous change librement tant que les promesses
    tiennent.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <liberum nomen="realizata-a"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="realizata-a" intra="forma-datorum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="forma-datorum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="series">
    <attributum nomen="nomen" genus="identitas"/>
    <liberum nomen="realizata-a"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="realizata-a" intra="series">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="series">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="cauda">
    <attributum nomen="nomen" genus="identitas"/>
    <liberum nomen="realizata-a"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="realizata-a" intra="cauda">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="cauda">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="acervus">
    <attributum nomen="nomen" genus="identitas"/>
    <liberum nomen="realizata-a"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="realizata-a" intra="acervus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="acervus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="tabula-associativa">
    <attributum nomen="nomen" genus="identitas"/>
    <liberum nomen="realizata-a"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="realizata-a" intra="tabula-associativa">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="tabula-associativa">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="copia">
    <attributum nomen="nomen" genus="identitas"/>
    <liberum nomen="realizata-a"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="realizata-a" intra="copia">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="copia">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="arbor">
    <attributum nomen="nomen" genus="identitas"/>
    <liberum nomen="realizata-a"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="realizata-a" intra="arbor">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="arbor">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="nota" textus="verum"
    nota="margo curatorialis individui - stratum
          documenti quod stratum generum iam habebat"/>

  <elementum nomen="eventum" intra="historia" textus="verum">
    <attributum nomen="quando" genus="dies"/>
    <attributum nomen="actio" genus="nomen"/>
    <attributum nomen="certitudo" genus="nomen"/>
    <attributum nomen="fons" genus="nomen"/>
    <attributum nomen="nota" genus="textus"/>
  </elementum>

  <unicitas nomen="identitas" attributum="nomen"
    nota="nomen= identitas est (par. 5.3): spatium nominum UNUM per genera omnia"
    super="forma-datorum series cauda acervus tabula-associativa copia arbor"/>

</canon>
