  <elementum nomen="servus">
    <attributum nomen="nomen" genus="compositum"/>
    <attributum nomen="status-inter-petitiones" genus="electio">
      <optio>sine_statu</optio>
      <optio>cum_statu</optio>
    </attributum>
    <attributum nomen="simultas" genus="electio">
      <optio>singularis</optio>
      <optio>multiplex</optio>
    </attributum>
    <attributum nomen="agnitio-petentis" genus="electio">
      <optio>nulla</optio>
      <optio>asserta</optio>
      <optio>probata</optio>
    </attributum>
    <attributum nomen="praebet" genus="nomen"/>
    <attributum nomen="auditur-in" genus="nomen"/>
    <attributum nomen="currit-ut" genus="nomen"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="historia" intra="servus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="curl">
