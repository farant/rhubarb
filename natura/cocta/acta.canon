  <elementum nomen="punctum-actorum">
    <glossa lingua="en">A record point: a named, addressable place
    in a record, so that the question what did things look like
    HERE has an answer a person would actually want to ask for.
    Not an event but a POSITION between events - a position in
    the series, not in time, since clocks disagree, jump
    backwards, and can read the same for two events.</glossa>
    <glossa lingua="fr">Un point de registre : un endroit nommé et
    adressable dans un registre, de sorte que la question de quoi
    les choses avaient-elles l'air ICI reçoive une réponse qu'une
    personne voudrait vraiment demander. Non pas un événement
    mais une POSITION entre les événements - une position dans la
    série, non dans le temps, car les horloges divergent,
    reculent, et peuvent donner la même valeur à deux
    événements.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="positio" genus="numerus"/>
    <attributum nomen="titulus" genus="textus"/>
    <attributum nomen="momentum-positionis" genus="textus"/>
    <attributum nomen="automaticum" genus="veritas"/>
    <attributum nomen="in" genus="referentia"/>
    <attributum nomen="praecedens" genus="referentia"/>
    <attributum nomen="positum-a" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="punctum-actorum">
    <liberum nomen="eventum"/>
  </elementum>

