  </elementum>

  <elementum nomen="acta">
    <glossa lingua="en">A record (acta): an ordered series of
    events to which one ONLY APPENDS, and which is the TRUTH of
    the things it describes. No state (a total, a manifest, a
    balance, a tree) is kept apart; every state is FOLDED out of
    the series. Correction never comes by erasure but by a new
    event, because records that can be rewritten are not
    records.</glossa>
    <glossa lingua="fr">Un registre (acta) : une série ordonnée
    d'événements à laquelle on ne fait qu'AJOUTER, et qui est la
    VÉRITÉ des choses qu'elle décrit. Aucun état (un total, un
    manifeste, un solde, un arbre) n'est conservé à part ; tout
    état est REPLIÉ à partir de la série. La correction ne se
    fait jamais par rature mais par un événement nouveau, car un
    registre que l'on peut réécrire n'est pas un registre.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="ordinatio" genus="electio">
      <optio>sequentialis</optio>
      <optio>temporalis</optio>
      <optio>utraque</optio>
    </attributum>
    <attributum nomen="immutabilitas" genus="electio">
      <optio>disciplina</optio>
      <optio>structura</optio>
      <optio>cryptographica</optio>
    </attributum>
    <attributum nomen="retentio" genus="textus"/>
    <attributum nomen="publica" genus="veritas"/>
    <attributum nomen="vis" genus="electio">
      <optio>declaratoria</optio>
      <optio>constitutiva</optio>
    </attributum>
    <attributum nomen="status-admissio" genus="electio">
      <optio>aperta</optio>
      <optio>clausa</optio>
      <optio>archivata</optio>
    </attributum>
    <attributum nomen="de" genus="referentia"/>
    <attributum nomen="appenditur-a" genus="referentia"/>
    <liberum nomen="eventum" maximum="1"/>
    <liberum nomen="ordo" maximum="1"/>
    <liberum nomen="punctum-nominatum" maximum="1"/>
    <liberum nomen="proiectio" maximum="1"/>
    <liberum nomen="promptuarium-contenti" maximum="1"/>
    <liberum nomen="plicatur-in"/>
    <liberum nomen="signata-per"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
