  <elementum nomen="radix-fiduciae">
    <glossa lingua="en">A root of trust: the end of a chain of
    attestations, whose credit comes not from another attestation
    but from a DECISION of the one who uses the chain - what is
    believed not because it was proven but because it was
    accepted. It is the only thing in the chain that attests
    itself (or nothing), and that is no defect but a necessity,
    since an infinite regress would destroy all trust.</glossa>
    <glossa lingua="fr">Une racine de confiance : le terme d'une
    chaîne d'attestations, dont le crédit ne vient pas d'une
    autre attestation mais d'une DÉCISION de celui qui emploie la
    chaîne - ce que l'on croit non parce que cela a été prouvé,
    mais parce que cela a été accepté. C'est la seule chose de la
    chaîne qui s'atteste elle-même (ou rien), et ce n'est pas un
    défaut mais une nécessité, car une régression à l'infini
    ruinerait toute confiance.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="modus-susceptionis" genus="electio">
      <optio>cum_systemate_missa</optio>
      <optio>ab_utente_addita</optio>
      <optio>lege_statuta</optio>
      <optio>consuetudine_recepta</optio>
    </attributum>
    <attributum nomen="tollibilis-a" genus="textus"/>
    <attributum nomen="ambitus-fidei" genus="textus"/>
    <attributum nomen="status-susceptio" genus="electio">
      <optio>suscepta</optio>
      <optio>limitata</optio>
      <optio>reiecta</optio>
      <optio>refundata</optio>
    </attributum>
    <attributum nomen="suscepta-per" genus="referentia"/>
    <attributum nomen="tenetur-a" genus="referentia"/>
    <liberum nomen="fundat"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="fundat" intra="radix-fiduciae">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="radix-fiduciae">
    <liberum nomen="eventum"/>
  </elementum>

