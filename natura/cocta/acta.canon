  <elementum nomen="attestatio">
    <glossa lingua="en">An attestation: an authentic copy drawn
    from authoritative records, testifying to what stood in those
    records AT THE MOMENT OF ISSUE, and which once handed over is
    SEPARATED from the records it came from - the truth goes on
    changing, the paper does not. It is a projection that has
    been given away, so the question proper to it is not whether
    it is true but WHEN it was true.</glossa>
    <glossa lingua="fr">Une attestation : une copie authentique
    tirée de registres faisant autorité, qui témoigne de ce qui
    figurait dans ces registres AU MOMENT DE SA DÉLIVRANCE et
    qui, une fois remise, est SÉPARÉE des registres dont elle
    provient - la vérité continue de changer, le papier non.
    C'est une projection que l'on a livrée ; la question qui lui
    est propre n'est donc pas si elle est vraie, mais QUAND elle
    l'a été.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="emissa" genus="dies"/>
    <attributum nomen="aetas-accepta" genus="textus"/>
    <attributum nomen="expirat" genus="dies"/>
    <attributum nomen="fundamentum" genus="textus"/>
    <attributum nomen="signum-authenticitatis" genus="electio">
      <optio>sigillum</optio>
      <optio>subscriptio</optio>
      <optio>charta_secura</optio>
      <optio>subscriptio_digitalis</optio>
    </attributum>
    <attributum nomen="integra" genus="veritas"/>
    <attributum nomen="status-vigor" genus="electio">
      <optio>emissa</optio>
      <optio>superata</optio>
      <optio>revocata</optio>
      <optio>expirata</optio>
    </attributum>
    <attributum nomen="ex-actis" genus="referentia"/>
    <attributum nomen="ad-punctum" genus="referentia"/>
    <attributum nomen="emissa-a" genus="referentia"/>
    <attributum nomen="de" genus="referentia"/>
    <attributum nomen="testatur" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="attestatio">
    <liberum nomen="eventum"/>
  </elementum>

