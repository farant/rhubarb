  <elementum nomen="planta">
    <attributum nomen="nomen" genus="compositum"/>
    <attributum nomen="habitus" genus="electio">
      <optio>herba</optio>
      <optio>frutex</optio>
      <optio>arbor</optio>
      <optio>scandens</optio>
    </attributum>
    <attributum nomen="durata" genus="electio">
      <optio>annua</optio>
      <optio>biennis</optio>
      <optio>perennis</optio>
    </attributum>
    <attributum nomen="folia-permanentia" genus="electio">
      <optio>decidua</optio>
      <optio>sempervirens</optio>
    </attributum>
    <attributum nomen="altitudo-matura" genus="numerus"/>
    <attributum nomen="status-vita" genus="electio">
      <optio>semen</optio>
      <optio>germinans</optio>
      <optio>iuvenis</optio>
      <optio>florens</optio>
      <optio>fructifera</optio>
      <optio>quiescens</optio>
      <optio>mortua</optio>
    </attributum>
    <attributum nomen="auctor-nominis" genus="nomen"/>
    <attributum nomen="nomen-publicatum-in" genus="nomen"/>
    <attributum nomen="pollinatur-a" genus="nomen"/>
