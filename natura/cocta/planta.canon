<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATUM a natura_canones e planta - NOLI MANU MUTARE.
     Regenera: ./tools/natura_canones.sh -->
<canon dialectus="planta" versio="1">

  <elementum nomen="individua" radix="verum">
    <attributum nomen="fons" genus="nomen"/>
    <liberum nomen="planta"/>
    <liberum nomen="rosaceae"/>
