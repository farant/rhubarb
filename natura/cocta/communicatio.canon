<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATUM a natura_canones e communicatio - NOLI MANU MUTARE.
     Regenera: ./tools/natura_canones.sh -->
<canon dialectus="communicatio" versio="1">

  <elementum nomen="individua" radix="verum">
    <liberum nomen="actor"/>
    <liberum nomen="nuntius"/>
    <liberum nomen="eventum"/>
    <liberum nomen="stigmergia"/>
    <liberum nomen="vestigium-chemicum"/>
    <liberum nomen="semita-trita"/>
    <liberum nomen="tabula-communis"/>
    <liberum nomen="vestigia-operis"/>
  </elementum>

  <elementum nomen="actor">
    <glossa lingua="en">An actor: a logical entity with an
    identity, private state, and behaviour, which communicates
    with others ONLY by messages. It alone changes its own state
    and never touches anyone else's - it asks, by sending a
    message. The form was named by Hewitt (1973), proven by
    Erlang, and realized in this house in actor.c.</glossa>
    <glossa lingua="fr">Un acteur : une entité logique dotée d'une
    identité, d'un état privé et de comportements, qui ne
    communique avec les autres QUE par messages. Lui seul modifie
    son propre état et ne touche jamais celui d'autrui - il le
    demande, en envoyant un message. La forme fut nommée par
    Hewitt (1973), éprouvée par Erlang, et réalisée dans cette
    maison dans actor.c.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="capsa-eius" genus="referentia"/>
    <liberum nomen="mittit"/>
    <liberum nomen="accipit"/>
    <liberum nomen="custodit"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="mittit" intra="actor">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="accipit" intra="actor">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="custodit" intra="actor">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="actor">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="nuntius">
    <glossa lingua="en">A message: communication made into a thing
    - data in transit, ADDRESSED, since a recipient is owed to
    it. The act of communicating turned into an object: it can be
    put in a queue, recorded, replayed. To send a message is to
    ask another to change itself; the request itself has been
    made a thing.</glossa>
    <glossa lingua="fr">Un message : la communication réifiée -
    des données en transit, ADRESSÉES, car un destinataire lui
    est dû. L'acte de communiquer converti en chose : on peut le
    mettre en file, l'enregistrer, le rejouer. Envoyer un
    message, c'est demander à un autre de se modifier ; la
    demande elle-même devenue chose.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="genus-nuntii" genus="textus"/>
    <attributum nomen="disciplina-schematis" genus="electio">
      <optio>sine_schemate</optio>
      <optio>cum_schemate</optio>
    </attributum>
    <attributum nomen="garantia-traditionis" genus="electio">
      <optio>ad_summum_semel</optio>
      <optio>ad_minimum_semel</optio>
      <optio>semel_exacte_tractatum</optio>
    </attributum>
    <attributum nomen="status-cursus" genus="electio">
      <optio>creatus</optio>
      <optio>missus</optio>
      <optio>traditus</optio>
      <optio>consumptus</optio>
    </attributum>
    <attributum nomen="portat" genus="referentia"/>
    <attributum nomen="missus-a" genus="referentia"/>
    <attributum nomen="destinatus-ad" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="historia" intra="nuntius">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="eventum">
    <glossa lingua="en">An event: something done that is NOT
    addressed - it happens, and any observer can see it; it is
    owed to no one. It differs from a message by address: a
    message goes TO someone, an event happens BEFORE
    everyone.</glossa>
    <glossa lingua="fr">Un événement : un fait qui n'est PAS
    adressé - il survient, et quiconque observe peut le voir ; il
    n'est dû à personne. Il diffère du message par l'adresse : le
    message va À quelqu'un, l'événement se produit DEVANT
    tous.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <liberum nomen="observatur-ab"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="observatur-ab" intra="eventum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="eventum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="stigmergia">
    <glossa lingua="en">Stigmergy: coordination by a trace that an
    agent leaves in a shared medium - a sign addressed to no one,
    which remains, which any passer-by can read, and which decays
    of itself. It is neither sent nor does it merely happen: it
    LIES there. Having neither sender nor recipient, it makes
    coordination possible among agents who need neither know one
    another nor be present at the same time.</glossa>
    <glossa lingua="fr">La stigmergie : la coordination par une
    trace qu'un agent laisse dans un milieu commun - un signe
    adressé à personne, qui demeure, que tout passant peut lire,
    et qui s'efface de lui-même. Elle n'est ni envoyée ni un
    simple fait : elle GÎT là. N'ayant ni expéditeur ni
    destinataire, elle rend possible la coordination d'agents qui
    n'ont besoin ni de se connaître ni d'être présents en même
    temps.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="tabescentia" genus="textus"/>
    <attributum nomen="cumulativa" genus="veritas"/>
    <attributum nomen="medium" genus="textus"/>
    <attributum nomen="movet" genus="referentia"/>
    <liberum nomen="relinquitur-a"/>
    <liberum nomen="legitur-a"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="relinquitur-a" intra="stigmergia">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="legitur-a" intra="stigmergia">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="stigmergia">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="vestigium-chemicum">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="tabescentia" genus="textus"/>
    <attributum nomen="cumulativa" genus="veritas"/>
    <attributum nomen="medium" genus="textus"/>
    <attributum nomen="movet" genus="referentia"/>
    <liberum nomen="relinquitur-a"/>
    <liberum nomen="legitur-a"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="relinquitur-a" intra="vestigium-chemicum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="legitur-a" intra="vestigium-chemicum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="vestigium-chemicum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="semita-trita">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="tabescentia" genus="textus"/>
    <attributum nomen="cumulativa" genus="veritas" ordinarius="verum"/>
    <attributum nomen="medium" genus="textus"/>
    <attributum nomen="movet" genus="referentia"/>
    <liberum nomen="relinquitur-a"/>
    <liberum nomen="legitur-a"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="relinquitur-a" intra="semita-trita">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="legitur-a" intra="semita-trita">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="semita-trita">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="tabula-communis">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="tabescentia" genus="textus"/>
    <attributum nomen="cumulativa" genus="veritas" ordinarius="falsum"/>
    <attributum nomen="medium" genus="textus"/>
    <attributum nomen="movet" genus="referentia"/>
    <liberum nomen="relinquitur-a"/>
    <liberum nomen="legitur-a"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="relinquitur-a" intra="tabula-communis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="legitur-a" intra="tabula-communis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="tabula-communis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="vestigia-operis">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="tabescentia" genus="textus"/>
    <attributum nomen="cumulativa" genus="veritas"/>
    <attributum nomen="medium" genus="textus"/>
    <attributum nomen="movet" genus="referentia"/>
    <liberum nomen="relinquitur-a"/>
    <liberum nomen="legitur-a"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="relinquitur-a" intra="vestigia-operis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="legitur-a" intra="vestigia-operis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="vestigia-operis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="eventum" intra="historia" textus="verum">
    <attributum nomen="quando" genus="dies"/>
    <attributum nomen="actio" genus="nomen"/>
    <attributum nomen="certitudo" genus="nomen"/>
    <attributum nomen="fons" genus="nomen"/>
    <attributum nomen="nota" genus="textus"/>
  </elementum>

  <unicitas nomen="identitas" attributum="nomen"
    nota="nomen= identitas est (par. 5.3): spatium nominum UNUM per genera omnia"
    super="actor nuntius eventum stigmergia vestigium-chemicum semita-trita
           tabula-communis vestigia-operis"/>

  <!-- CITATIONES: relatio petitum resolutum ferens clavem documenti fit.
       Subsumptio COMPILATA est: petitum cum posteris omnibus in
       indicem ad= enumeratur, quia claves per titulum exactum
       colliguntur et subgenus titulum alium fert. Signa: '#'
       individuum inscriptum (clavis verbatim), '.' genus e
       vocabulario indicis. -->
  <citatio nomen="nuntius-missus-a" attributum="missus-a" ad="actor/nomen" super="nuntius"/>
  <citatio nomen="nuntius-destinatus-ad" attributum="destinatus-ad" ad="actor/nomen" super="nuntius"/>

</canon>
