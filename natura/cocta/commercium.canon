  <elementum nomen="ratio-duplex">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="rationarius" genus="referentia"/>
    <attributum nomen="ordinatio" genus="electio">
      <optio>sequentialis</optio>
      <optio>temporalis</optio>
      <optio>utraque</optio>
    </attributum>
    <attributum nomen="immutabilitas" genus="electio">
      <optio>disciplina</optio>
      <optio>structura</optio>
      <optio>cryptographica</optio>
    </attributum>
    <attributum nomen="retentio" genus="textus"/>
    <attributum nomen="publica" genus="veritas"/>
    <attributum nomen="vis" genus="electio">
      <optio>declaratoria</optio>
      <optio>constitutiva</optio>
    </attributum>
    <attributum nomen="status-admissio" genus="electio">
      <optio>aperta</optio>
      <optio>clausa</optio>
      <optio>archivata</optio>
    </attributum>
    <attributum nomen="de" genus="referentia"/>
    <attributum nomen="appenditur-a" genus="referentia"/>
    <liberum nomen="continet"/>
    <liberum nomen="eventum" maximum="1"/>
    <liberum nomen="ordo" maximum="1"/>
    <liberum nomen="punctum-nominatum" maximum="1"/>
    <liberum nomen="proiectio" maximum="1"/>
    <liberum nomen="promptuarium-contenti" maximum="1"/>
    <liberum nomen="plicatur-in"/>
    <liberum nomen="signata-per"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="continet" intra="ratio-duplex">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="eventum" intra="ratio-duplex">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="ordo" intra="ratio-duplex">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="punctum-nominatum" intra="ratio-duplex">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="proiectio" intra="ratio-duplex">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="promptuarium-contenti" intra="ratio-duplex">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="plicatur-in" intra="ratio-duplex">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="signata-per" intra="ratio-duplex">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="ratio-duplex">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="eventum" intra="historia" textus="verum">
    <attributum nomen="quando" genus="dies"/>
    <attributum nomen="actio" genus="electio">
      <optio>appendere</optio>
      <optio>plicare</optio>
      <optio>signare</optio>
      <optio>stornare</optio>
      <optio>claudere</optio>
    </attributum>
    <attributum nomen="certitudo" genus="nomen"/>
    <attributum nomen="fons" genus="nomen"/>
    <attributum nomen="nota" genus="textus"/>
  </elementum>

  <unicitas nomen="identitas" attributum="nomen"
    nota="nomen= identitas est (par. 5.3): spatium nominum UNUM per genera omnia"
    super="moneta pecunia possessio pretium venditio tessera tessera-negotiabilis
           tessera-simplex ratio-rationaria charta-onerum apocha-horrei syngrapha
           perscriptio nummus-chartaceus obligatio-ad-portitorem tessera-spectaculi
           tessera-repositoria tessera-digitalis ratio-duplex"/>

  <!-- CITATIONES: relatio petitum resolutum ferens clavem documenti fit.
       Subsumptio COMPILATA est: petitum cum posteris omnibus in
       indicem ad= enumeratur, quia claves per titulum exactum
       colliguntur et subgenus titulum alium fert. Signa: '#'
       individuum inscriptum (clavis verbatim), '.' genus e
       vocabulario indicis. -->
  <citatio nomen="pecunia-in-moneta" attributum="in-moneta" ad="moneta/nomen" super="pecunia"/>
  <citatio nomen="pretium-quantum" attributum="quantum" ad="pecunia/nomen" super="pretium"/>
  <citatio nomen="venditio-solutum" attributum="solutum" ad="pecunia/nomen" super="venditio"/>
  <citatio nomen="tessera-possessio-eius" attributum="possessio-eius" ad="possessio/nomen" super="tessera"/>
  <citatio nomen="tessera-negotiabilis-possessio-eius" attributum="possessio-eius" ad="possessio/nomen" super="tessera-negotiabilis"/>
  <citatio nomen="tessera-simplex-possessio-eius" attributum="possessio-eius" ad="possessio/nomen" super="tessera-simplex"/>
  <citatio nomen="charta-onerum-possessio-eius" attributum="possessio-eius" ad="possessio/nomen" super="charta-onerum"/>
  <citatio nomen="apocha-horrei-possessio-eius" attributum="possessio-eius" ad="possessio/nomen" super="apocha-horrei"/>
  <citatio nomen="syngrapha-possessio-eius" attributum="possessio-eius" ad="possessio/nomen" super="syngrapha"/>
  <citatio nomen="perscriptio-possessio-eius" attributum="possessio-eius" ad="possessio/nomen" super="perscriptio"/>
  <citatio nomen="nummus-chartaceus-possessio-eius" attributum="possessio-eius" ad="possessio/nomen" super="nummus-chartaceus"/>
  <citatio nomen="obligatio-ad-portitorem-possessio-eius" attributum="possessio-eius" ad="possessio/nomen" super="obligatio-ad-portitorem"/>
  <citatio nomen="tessera-spectaculi-possessio-eius" attributum="possessio-eius" ad="possessio/nomen" super="tessera-spectaculi"/>
  <citatio nomen="tessera-repositoria-possessio-eius" attributum="possessio-eius" ad="possessio/nomen" super="tessera-repositoria"/>
  <citatio nomen="tessera-digitalis-possessio-eius" attributum="possessio-eius" ad="possessio/nomen" super="tessera-digitalis"/>

</canon>
