    <liberum nomen="materiae-constituentes" maximum="1"/>
    <liberum nomen="ex-materia"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="apta-viae" intra="navis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="materiae-constituentes" intra="navis">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="ex-materia" intra="navis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="navis">
