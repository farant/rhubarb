<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATUM a natura_canones e vectura - NOLI MANU MUTARE.
     Regenera: ./tools/natura_canones.sh -->
<canon dialectus="vectura" versio="1">

  <elementum nomen="individua" radix="verum">
    <liberum nomen="iter"/>
    <liberum nomen="via"/>
    <liberum nomen="vehiculum"/>
    <liberum nomen="onus"/>
    <liberum nomen="via-terrestris"/>
    <liberum nomen="via-maritima"/>
    <liberum nomen="via-aeria"/>
    <liberum nomen="via-appia"/>
    <liberum nomen="canalis-suesianus"/>
    <liberum nomen="navis"/>
    <liberum nomen="currus-onerarius"/>
    <liberum nomen="tramen"/>
    <liberum nomen="aeroplanum"/>
  </elementum>

  <elementum nomen="iter">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="distantia" genus="textus"/>
    <attributum nomen="mora-aestimata" genus="textus"/>
    <attributum nomen="status-cursus" genus="electio">
      <optio>paratum</optio>
      <optio>in_cursu</optio>
      <optio>perfectum</optio>
      <optio>interruptum</optio>
    </attributum>
    <attributum nomen="a-loco" genus="referentia"/>
    <attributum nomen="ad-locum" genus="referentia"/>
    <attributum nomen="vehitur" genus="referentia"/>
    <attributum nomen="suscipitur-a" genus="referentia"/>
    <liberum nomen="per-viam"/>
    <liberum nomen="fert"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="per-viam" intra="iter">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="fert" intra="iter">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="iter">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="via">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="longitudo" genus="textus"/>
    <attributum nomen="publica" genus="veritas"/>
    <liberum nomen="iungit"/>
    <liberum nomen="sub-iurisdictione"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="iungit" intra="via">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="sub-iurisdictione" intra="via">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="via">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="vehiculum">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="capacitas-oneris" genus="textus"/>
    <attributum nomen="velocitas-media" genus="textus"/>
    <attributum nomen="regitur-a" genus="referentia"/>
    <attributum nomen="capacitas" genus="textus"/>
    <attributum nomen="status-usus" genus="electio">
      <optio>otiosum</optio>
      <optio>in_usu</optio>
      <optio>in_reparatione</optio>
      <optio>fractum</optio>
    </attributum>
    <attributum nomen="factum-per" genus="referentia"/>
    <attributum nomen="factum-a" genus="referentia"/>
    <attributum nomen="massa" genus="textus"/>
    <attributum nomen="perituram" genus="veritas"/>
    <attributum nomen="status-conditio" genus="electio">
      <optio>recens</optio>
      <optio>vetus</optio>
      <optio>corrupta</optio>
    </attributum>
    <attributum nomen="sita-in" genus="referentia"/>
    <liberum nomen="apta-viae"/>
    <liberum nomen="materiae-constituentes" maximum="1"/>
    <liberum nomen="ex-materia"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="apta-viae" intra="vehiculum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="materiae-constituentes" intra="vehiculum">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="ex-materia" intra="vehiculum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="vehiculum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="onus">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="massa-tota" genus="textus"/>
    <attributum nomen="periturum" genus="veritas"/>
    <attributum nomen="status-custodia" genus="electio">
      <optio>susceptum</optio>
      <optio>in_itinere</optio>
      <optio>traditum</optio>
      <optio>amissum</optio>
    </attributum>
    <attributum nomen="fertur-per" genus="referentia"/>
    <attributum nomen="possessio-eius" genus="referentia"/>
    <liberum nomen="continet"/>
    <liberum nomen="passum"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="continet" intra="onus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="passum" intra="onus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="onus">
    <liberum nomen="eventum"/>
  </elementum>

