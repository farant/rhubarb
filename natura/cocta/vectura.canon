  </elementum>

  <elementum nomen="onus">
    <glossa lingua="en">Freight: bodily things while under way - not a
    kind of thing but a CONDITION of things. The same barrel is
    freight while it is carried, merchandise while it is sold,
    furniture while it is used. A role, and therefore a
    relation.</glossa>
    <glossa lingua="fr">Une cargaison : des choses corporelles en cours
    de trajet - non pas un genre de choses mais une CONDITION des
    choses. Le même tonneau est cargaison tant qu'on le transporte,
    marchandise tant qu'on le vend, mobilier tant qu'on s'en sert.
    Un rôle, donc une relation.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="massa-tota" genus="textus"/>
    <attributum nomen="periturum" genus="veritas"/>
    <attributum nomen="status-custodia" genus="electio">
      <optio>susceptum</optio>
      <optio>in_itinere</optio>
      <optio>traditum</optio>
      <optio>amissum</optio>
    </attributum>
    <attributum nomen="fertur-per" genus="referentia"/>
    <attributum nomen="possessio-eius" genus="referentia"/>
    <liberum nomen="continet"/>
    <liberum nomen="passum"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="continet" intra="onus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="passum" intra="onus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="onus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="nota" textus="verum"
    nota="margo curatorialis individui - stratum
          documenti quod stratum generum iam habebat"/>

  <elementum nomen="eventum" intra="historia" textus="verum">
    <attributum nomen="quando" genus="dies"/>
    <attributum nomen="actio" genus="nomen"/>
    <attributum nomen="certitudo" genus="nomen"/>
    <attributum nomen="fons" genus="nomen"/>
    <attributum nomen="nota" genus="textus"/>
  </elementum>

  <unicitas nomen="identitas" attributum="nomen"
    nota="nomen= identitas est (par. 5.3): spatium nominum UNUM per genera omnia"
    super="iter via via-terrestris via-maritima via-aeria vehiculum navis
           currus-onerarius tramen aeroplanum onus"/>

  <!-- CITATIONES: relatio petitum resolutum ferens clavem documenti fit.
       Subsumptio COMPILATA est: petitum cum posteris omnibus in
       indicem ad= enumeratur, quia claves per titulum exactum
       colliguntur et subgenus titulum alium fert. Signa: '#'
       individuum inscriptum (clavis verbatim), '.' genus e
       vocabulario indicis. -->
  <citatio nomen="iter-per-viam" attributum="ad" ad="via via-terrestris via-maritima via-aeria/nomen" super="iter/per-viam"/>
  <citatio nomen="iter-vehitur" attributum="vehitur" ad="vehiculum navis currus-onerarius tramen aeroplanum/nomen" super="iter"/>
  <citatio nomen="iter-fert" attributum="ad" ad="onus/nomen" super="iter/fert"/>
  <citatio nomen="vehiculum-apta-viae" attributum="ad" ad="via via-terrestris via-maritima via-aeria/nomen" super="vehiculum/apta-viae"/>
  <citatio nomen="navis-apta-viae" attributum="ad" ad="via via-terrestris via-maritima via-aeria/nomen" super="navis/apta-viae"/>
  <citatio nomen="currus-onerarius-apta-viae" attributum="ad" ad="via via-terrestris via-maritima via-aeria/nomen" super="currus-onerarius/apta-viae"/>
  <citatio nomen="tramen-apta-viae" attributum="ad" ad="via via-terrestris via-maritima via-aeria/nomen" super="tramen/apta-viae"/>
  <citatio nomen="aeroplanum-apta-viae" attributum="ad" ad="via via-terrestris via-maritima via-aeria/nomen" super="aeroplanum/apta-viae"/>

</canon>
