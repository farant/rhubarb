    <attributum nomen="factum-per" genus="referentia"/>
    <attributum nomen="factum-a" genus="referentia"/>
    <attributum nomen="massa" genus="textus"/>
    <attributum nomen="perituram" genus="veritas"/>
    <attributum nomen="status-conditio" genus="electio">
