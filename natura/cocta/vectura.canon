<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATUM a natura_canones e vectura - NOLI MANU MUTARE.
     Regenera: ./tools/natura_canones.sh -->
<canon dialectus="vectura" versio="1">

  <elementum nomen="individua" radix="verum">
    <liberum nomen="iter"/>
    <liberum nomen="via"/>
    <liberum nomen="via-terrestris"/>
    <liberum nomen="via-maritima"/>
    <liberum nomen="via-aeria"/>
    <liberum nomen="vehiculum"/>
    <liberum nomen="navis"/>
    <liberum nomen="currus-onerarius"/>
    <liberum nomen="tramen"/>
    <liberum nomen="aeroplanum"/>
    <liberum nomen="onus"/>
  </elementum>

  <elementum nomen="iter">
    <glossa lingua="en">A journey: the movement of a thing or a person
    from one place to another, undertaken with a purpose - a
    beginning, an end, a route, a time. Not a place but a CHANGE of
    place: what the model of place could not say, this says.</glossa>
    <glossa lingua="fr">Un trajet : le mouvement d'une chose ou d'une
    personne d'un lieu à un autre, entrepris dans un but - un
    commencement, une fin, une voie, un temps. Non pas un lieu mais
    un CHANGEMENT de lieu : ce que le modèle du lieu ne pouvait pas
    dire, celui-ci le dit.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="distantia" genus="textus"/>
    <attributum nomen="mora-aestimata" genus="textus"/>
    <attributum nomen="status-cursus" genus="electio">
      <optio>paratum</optio>
      <optio>in_cursu</optio>
      <optio>perfectum</optio>
      <optio>interruptum</optio>
    </attributum>
    <attributum nomen="a-loco" genus="referentia"/>
    <attributum nomen="ad-locum" genus="referentia"/>
    <attributum nomen="vehitur" genus="referentia"/>
    <attributum nomen="suscipitur-a" genus="referentia"/>
    <liberum nomen="per-viam"/>
    <liberum nomen="fert"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="per-viam" intra="iter">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="fert" intra="iter">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="iter">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="via">
    <glossa lingua="en">A route: a way along which one can travel,
    usually a public thing, common to countless journeys. It exists
    before any journey and remains after it - the via Appia lies
    there today though no one carries freight along it. Hence not a
    journey but the CONDITION of a journey.</glossa>
    <glossa lingua="fr">Une voie : un chemin par lequel on peut aller,
    le plus souvent une chose publique, commune à d'innombrables
    trajets. Elle est là avant tout trajet et demeure après lui - la
    via Appia subsiste aujourd'hui bien que personne n'y transporte
    de marchandises. Donc non pas un trajet mais la CONDITION du
    trajet.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="longitudo" genus="textus"/>
    <attributum nomen="publica" genus="veritas"/>
    <liberum nomen="iungit"/>
    <liberum nomen="sub-iurisdictione"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="iungit" intra="via">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="sub-iurisdictione" intra="via">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="via">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="via-terrestris">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="longitudo" genus="textus"/>
    <attributum nomen="publica" genus="veritas"/>
    <liberum nomen="iungit"/>
    <liberum nomen="sub-iurisdictione"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="iungit" intra="via-terrestris">
