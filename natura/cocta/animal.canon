    <liberum nomen="cor" maximum="1"/>
    <liberum nomen="membra" maximum="1"/>
    <liberum nomen="praedatur"/>
    <liberum nomen="generat"/>
    <liberum nomen="laborat"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
