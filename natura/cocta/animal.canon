    <attributum nomen="victus" genus="electio" ordinarius="omnivorus">
      <optio>carnivorus</optio>
      <optio>herbivorus</optio>
      <optio>omnivorus</optio>
    </attributum>
    <attributum nomen="sanguine-calidus" genus="veritas" ordinarius="verum"/>
    <attributum nomen="vita-media" genus="textus"/>
    <attributum nomen="status-aetas" genus="electio">
      <optio>fetus</optio>
