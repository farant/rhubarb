<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATUM a natura_canones e animal - NOLI MANU MUTARE.
     Regenera: ./tools/natura_canones.sh -->
<canon dialectus="animal" versio="1">

  <elementum nomen="individua" radix="verum">
    <liberum nomen="animal"/>
    <liberum nomen="apis"/>
    <liberum nomen="canis"/>
    <liberum nomen="homo"/>
  </elementum>

  <elementum nomen="animal">
    <glossa lingua="en">An animal: a living thing that has sensation
    and local motion - it perceives the world and moves itself
    toward it, whence appetite, whence flight, whence seeking. A
    plant stays where it is and takes what comes to it; an animal
    goes looking.</glossa>
    <glossa lingua="fr">Un animal : un vivant qui a la sensation et
    le mouvement local - il perçoit le monde et se meut vers lui,
    d'où l'appétit, d'où la fuite, d'où la quête. La plante demeure
    et prend ce qui lui vient ; l'animal cherche.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="victus" genus="electio">
      <optio>carnivorus</optio>
      <optio>herbivorus</optio>
      <optio>omnivorus</optio>
    </attributum>
    <attributum nomen="sanguine-calidus" genus="veritas"/>
    <attributum nomen="vita-media" genus="textus"/>
    <attributum nomen="status-aetas" genus="electio">
      <optio>fetus</optio>
      <optio>pullus</optio>
      <optio>adultus</optio>
      <optio>senex</optio>
    </attributum>
    <attributum nomen="pollinat" genus="referentia"/>
    <attributum nomen="anima" genus="electio" ordinarius="sensitiva">
      <optio>vegetativa</optio>
      <optio>sensitiva</optio>
      <optio>rationalis</optio>
    </attributum>
    <attributum nomen="status-vita" genus="electio">
      <optio>vivum</optio>
      <optio>mortuum</optio>
    </attributum>
    <attributum nomen="massa" genus="textus"/>
    <attributum nomen="perituram" genus="veritas"/>
    <attributum nomen="status-conditio" genus="electio">
      <optio>recens</optio>
      <optio>vetus</optio>
      <optio>corrupta</optio>
    </attributum>
    <attributum nomen="sita-in" genus="referentia"/>
    <liberum nomen="caput" maximum="1"/>
    <liberum nomen="cor" maximum="1"/>
    <liberum nomen="membra" maximum="1"/>
    <liberum nomen="praedatur"/>
    <liberum nomen="generat"/>
    <liberum nomen="laborat"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="caput" intra="animal">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="cor" intra="animal">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="membra" intra="animal">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="praedatur" intra="animal">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="generat" intra="animal">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="laborat" intra="animal">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="animal">
    <liberum nomen="eventum"/>
  </elementum>

