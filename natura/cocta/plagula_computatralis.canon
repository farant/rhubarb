      <optio>deleri</optio>
    </attributum>
    <attributum nomen="certitudo" genus="nomen"/>
    <attributum nomen="fons" genus="nomen"/>
    <attributum nomen="nota" genus="textus"/>
  </elementum>

  <unicitas nomen="identitas" attributum="nomen"
    nota="nomen= identitas est (par. 5.3): spatium nominum UNUM per genera omnia"
    super="plagula-computatralis plagula-fontis scriptum-exsecutabile plagula-notationis
           plagula-figurationis plagula-datorum plagula-sqlite systema-plagularum
           directorium fons-c caput-c fons-python fons-rust scriptum-conchae
           plagula-xml plagula-stml plagula-markdown plagula-toml plagula-plist
           plagula-json plagula-csv volumen"/>

</canon>
