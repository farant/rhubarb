<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATUM a natura_canones e plagula_computatralis - NOLI MANU MUTARE.
     Regenera: ./tools/natura_canones.sh -->
<canon dialectus="plagula_computatralis" versio="1">

  <elementum nomen="individua" radix="verum">
    <liberum nomen="plagula-computatralis"/>
    <liberum nomen="plagula-fontis"/>
    <liberum nomen="scriptum-exsecutabile"/>
    <liberum nomen="plagula-notationis"/>
    <liberum nomen="plagula-figurationis"/>
    <liberum nomen="plagula-datorum"/>
