<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATUM a natura_canones e versio - NOLI MANU MUTARE.
     Regenera: ./tools/natura_canones.sh -->
<canon dialectus="versio" versio="1">

  <elementum nomen="individua" radix="verum">
    <liberum nomen="versio"/>
  </elementum>

  <elementum nomen="versio">
    <glossa lingua="en">A version: a named and citable edition of a
    thing, which marks that thing itself across enduring change -
    there is one thing and many versions, and a version is not
    another thing but the same thing as it stood at that time. What
    makes the second version the same thing as the first is not the
    content, which has changed (that is precisely why there is a new
    version), but the continuity of the naming authority and of the
    purpose. Where either of these fails, what you have is not a new
    version but a different thing - hence forks, which are not
    versions but births.</glossa>
    <glossa lingua="fr">Une version : une édition nommée et citable
    d'une chose, qui marque cette chose même à travers un changement
    qui dure - il y a une seule chose et plusieurs versions, et une
    version n'est pas une autre chose mais la même chose telle
    qu'elle était alors. Ce qui fait que la seconde version est la
    même chose que la première n'est pas le contenu, qui a changé
    (c'est bien pour cela qu'il y a une version nouvelle), mais la
    continuité de l'autorité qui nomme et celle de la fin
    poursuivie. Là où l'une des deux manque, ce n'est plus une
    version nouvelle mais une autre chose - d'où les fourches, qui
    ne sont pas des versions mais des naissances.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="titulus" genus="textus"/>
    <attributum nomen="edita" genus="dies"/>
    <attributum nomen="schema-numerandi" genus="electio">
      <optio>semanticum</optio>
      <optio>sequentiale</optio>
      <optio>temporale</optio>
      <optio>nominale</optio>
      <optio>mixtum</optio>
    </attributum>
    <attributum nomen="retro-compatibilis" genus="veritas"/>
    <attributum nomen="mutationes-fractoriae" genus="textus"/>
    <attributum nomen="status-sustentatio" genus="electio">
      <optio>praenuntiata</optio>
      <optio>vigens</optio>
      <optio>sustentata</optio>
      <optio>deprecata</optio>
      <optio>derelicta</optio>
    </attributum>
    <attributum nomen="versio-de" genus="referentia"/>
    <attributum nomen="sequitur" genus="referentia"/>
    <attributum nomen="asseritur-per" genus="referentia"/>
    <attributum nomen="edita-a" genus="referentia"/>
    <liberum nomen="compatibilis-cum"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="compatibilis-cum" intra="versio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="versio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="eventum" intra="historia" textus="verum">
    <attributum nomen="quando" genus="dies"/>
    <attributum nomen="actio" genus="electio">
      <optio>edi</optio>
      <optio>deprecari</optio>
      <optio>derelinqui</optio>
    </attributum>
    <attributum nomen="certitudo" genus="nomen"/>
    <attributum nomen="fons" genus="nomen"/>
    <attributum nomen="nota" genus="textus"/>
  </elementum>

  <unicitas nomen="identitas" attributum="nomen"
    nota="nomen= identitas est (par. 5.3): spatium nominum UNUM per genera omnia"
    super="versio"/>

</canon>
