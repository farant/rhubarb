    <attributum nomen="licentia-aperta" genus="veritas"/>
    <attributum nomen="habet-versionem" genus="nomen"/>
    <attributum nomen="exsecuta-a" genus="nomen"/>
    <attributum nomen="emissa-pro" genus="nomen"/>
    <liberum nomen="auctor"/>
