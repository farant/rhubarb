  <elementum nomen="riscv">
    <attributum nomen="nomen" genus="compositum"/>
    <attributum nomen="indoles-copiae" genus="electio" ordinarius="risc">
      <optio>cisc</optio>
      <optio>risc</optio>
      <optio>mixta</optio>
    </attributum>
    <attributum nomen="licentia-aperta" genus="veritas" ordinarius="verum"/>
    <attributum nomen="habet-versionem" genus="nomen"/>
    <attributum nomen="exsecuta-a" genus="nomen"/>
