<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATUM a natura_canones e architectura_machinae - NOLI MANU MUTARE.
     Regenera: ./tools/natura_canones.sh -->
<canon dialectus="architectura_machinae" versio="1">

  <elementum nomen="individua" radix="verum">
    <liberum nomen="architectura-machinae"/>
    <liberum nomen="versio-architecturae"/>
    <liberum nomen="processorium"/>
  </elementum>

  <elementum nomen="architectura-machinae">
    <glossa lingua="en">A machine architecture: the abstract form
    of a computing machine that programs address - instruction
    set, registers, memory model. It is the covenant between
    compiler and hardware: many chips execute it, the
    architecture is one; it grows through versions while its
    identity remains.</glossa>
    <glossa lingua="fr">Une architecture machine : la forme
    abstraite d'une machine de calcul à laquelle les programmes
    s'adressent - jeu d'instructions, registres, modèle de
    mémoire. C'est le pacte entre le compilateur et le matériel :
    de nombreuses puces l'exécutent, l'architecture est une ;
    elle croît par versions tout en gardant son identité.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="indoles-copiae" genus="electio">
      <optio>cisc</optio>
      <optio>risc</optio>
      <optio>mixta</optio>
    </attributum>
    <attributum nomen="licentia-aperta" genus="veritas"/>
    <attributum nomen="habet-versionem" genus="referentia"/>
    <attributum nomen="exsecuta-a" genus="referentia"/>
    <attributum nomen="emissa-pro" genus="referentia"/>
    <liberum nomen="auctor"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="auctor" intra="architectura-machinae">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="architectura-machinae">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="versio-architecturae">
    <glossa lingua="en">An architecture version: a named edition
    of an architecture - which instruction set a chip really
    executes and a compiler really addresses. To say build for
    x86_64 is to cite a version, not a family.</glossa>
    <glossa lingua="fr">Une version d'architecture : une édition
    nommée d'une architecture - le jeu d'instructions qu'une puce
    exécute réellement et auquel un compilateur s'adresse
    réellement. Dire compiler pour x86_64, c'est citer une
    version, non une famille.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="titulus" genus="textus"/>
    <attributum nomen="latitudo-verbi" genus="numerus"/>
    <attributum nomen="edita" genus="dies"/>
    <attributum nomen="versio-de" genus="referentia"/>
    <attributum nomen="sequitur" genus="referentia"/>
    <attributum nomen="schema-numerandi" genus="electio">
      <optio>semanticum</optio>
      <optio>sequentiale</optio>
      <optio>temporale</optio>
      <optio>nominale</optio>
      <optio>mixtum</optio>
    </attributum>
    <attributum nomen="retro-compatibilis" genus="veritas"/>
    <attributum nomen="mutationes-fractoriae" genus="textus"/>
    <attributum nomen="status-sustentatio" genus="electio">
      <optio>praenuntiata</optio>
      <optio>vigens</optio>
      <optio>sustentata</optio>
      <optio>deprecata</optio>
      <optio>derelicta</optio>
    </attributum>
    <attributum nomen="asseritur-per" genus="referentia"/>
    <attributum nomen="edita-a" genus="referentia"/>
    <liberum nomen="compatibilis-cum"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="compatibilis-cum" intra="versio-architecturae">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="versio-architecturae">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="processorium">
    <glossa lingua="en">A processor: a product model of a
    computing circuit - a named form that a foundry prints into
    countless chips, and which executes an architecture (one or
    several of its versions) in silicon. It stands midway between
    the architecture, which is pure form, and the physical chip,
    which is a single corporeal thing: it has a clock frequency,
    cores and a price, but no haecceity - M1 is millions of chips
    and one thing.</glossa>
    <glossa lingua="fr">Un processeur : un modèle de produit de
    circuit de calcul - une forme nommée qu'une fonderie imprime
    en d'innombrables puces, et qui exécute une architecture (une
    ou plusieurs de ses versions) dans le silicium. Il se tient à
    mi-chemin entre l'architecture, qui est forme pure, et la
    puce physique, qui est une chose corporelle unique : il a une
    fréquence, des coeurs et un prix, mais pas d'eccéité - le M1
    est des millions de puces et une seule chose.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="nuclei" genus="numerus"/>
    <attributum nomen="frequentia" genus="textus"/>
    <attributum nomen="bits" genus="numerus"/>
    <attributum nomen="fabricatum-a" genus="referentia"/>
    <attributum nomen="designatum-a" genus="referentia"/>
    <liberum nomen="exsequitur"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="exsequitur" intra="processorium">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="processorium">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="eventum" intra="historia" textus="verum">
    <attributum nomen="quando" genus="dies"/>
    <attributum nomen="actio" genus="electio">
      <optio>ortus</optio>
      <optio>edi</optio>
      <optio>deprecari</optio>
      <optio>derelinqui</optio>
      <optio>retiri</optio>
    </attributum>
    <attributum nomen="certitudo" genus="nomen"/>
    <attributum nomen="fons" genus="nomen"/>
    <attributum nomen="nota" genus="textus"/>
  </elementum>

  <unicitas nomen="identitas" attributum="nomen"
    nota="nomen= identitas est (par. 5.3): spatium nominum UNUM per genera omnia"
    super="architectura-machinae versio-architecturae processorium"/>

  <!-- CITATIONES: relatio petitum resolutum ferens clavem documenti fit.
       Subsumptio COMPILATA est: petitum cum posteris omnibus in
       indicem ad= enumeratur, quia claves per titulum exactum
       colliguntur et subgenus titulum alium fert. Signa: '#'
       individuum inscriptum (clavis verbatim), '.' genus e
       vocabulario indicis. -->
  <citatio nomen="architectura-machinae-habet-versionem" attributum="habet-versionem" ad="versio-architecturae/nomen" super="architectura-machinae"/>
  <citatio nomen="architectura-machinae-exsecuta-a" attributum="exsecuta-a" ad="processorium/nomen" super="architectura-machinae"/>
  <citatio nomen="versio-architecturae-versio-de" attributum="versio-de" ad="architectura-machinae/nomen" super="versio-architecturae"/>
  <citatio nomen="versio-architecturae-sequitur" attributum="sequitur" ad="versio-architecturae/nomen" super="versio-architecturae"/>
  <citatio nomen="processorium-exsequitur" attributum="ad" ad="versio-architecturae/nomen" super="processorium/exsequitur"/>

</canon>
