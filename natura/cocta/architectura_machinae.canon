  <elementum nomen="auctor" intra="x86">
    <attributum nomen="ad" genus="nomen"/>
  </elementum>
  <elementum nomen="historia" intra="x86">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="arm">
    <attributum nomen="nomen" genus="compositum"/>
    <attributum nomen="indoles-copiae" genus="electio" ordinarius="risc">
