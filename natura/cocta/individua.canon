  </elementum>
  <elementum nomen="signata-per" intra="acta">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="acta">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="punctum-actorum">
    <glossa lingua="en">A record point: a named, addressable place
    in a record, so that the question what did things look like
    HERE has an answer a person would actually want to ask for.
    Not an event but a POSITION between events - a position in
    the series, not in time, since clocks disagree, jump
    backwards, and can read the same for two events.</glossa>
    <glossa lingua="fr">Un point de registre : un endroit nommé et
    adressable dans un registre, de sorte que la question de quoi
    les choses avaient-elles l'air ICI reçoive une réponse qu'une
    personne voudrait vraiment demander. Non pas un événement
    mais une POSITION entre les événements - une position dans la
    série, non dans le temps, car les horloges divergent,
    reculent, et peuvent donner la même valeur à deux
    événements.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="positio" genus="numerus"/>
    <attributum nomen="titulus" genus="textus"/>
    <attributum nomen="momentum-positionis" genus="textus"/>
    <attributum nomen="automaticum" genus="veritas"/>
    <attributum nomen="in" genus="referentia"/>
    <attributum nomen="praecedens" genus="referentia"/>
    <attributum nomen="positum-a" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="punctum-actorum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="attestatio">
    <glossa lingua="en">An attestation: an authentic copy drawn
    from authoritative records, testifying to what stood in those
    records AT THE MOMENT OF ISSUE, and which once handed over is
    SEPARATED from the records it came from - the truth goes on
    changing, the paper does not. It is a projection that has
    been given away, so the question proper to it is not whether
    it is true but WHEN it was true.</glossa>
    <glossa lingua="fr">Une attestation : une copie authentique
    tirée de registres faisant autorité, qui témoigne de ce qui
    figurait dans ces registres AU MOMENT DE SA DÉLIVRANCE et
    qui, une fois remise, est SÉPARÉE des registres dont elle
    provient - la vérité continue de changer, le papier non.
    C'est une projection que l'on a livrée ; la question qui lui
    est propre n'est donc pas si elle est vraie, mais QUAND elle
    l'a été.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="emissa" genus="dies"/>
    <attributum nomen="aetas-accepta" genus="textus"/>
    <attributum nomen="expirat" genus="dies"/>
    <attributum nomen="fundamentum" genus="textus"/>
    <attributum nomen="signum-authenticitatis" genus="electio">
      <optio>sigillum</optio>
      <optio>subscriptio</optio>
      <optio>charta_secura</optio>
      <optio>subscriptio_digitalis</optio>
    </attributum>
    <attributum nomen="integra" genus="veritas"/>
    <attributum nomen="status-vigor" genus="electio">
      <optio>emissa</optio>
      <optio>superata</optio>
      <optio>revocata</optio>
      <optio>expirata</optio>
    </attributum>
    <attributum nomen="ex-actis" genus="referentia"/>
    <attributum nomen="ad-punctum" genus="referentia"/>
    <attributum nomen="emissa-a" genus="referentia"/>
    <attributum nomen="de" genus="referentia"/>
    <attributum nomen="testatur" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="attestatio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="radix-fiduciae">
    <glossa lingua="en">A root of trust: the end of a chain of
    attestations, whose credit comes not from another attestation
    but from a DECISION of the one who uses the chain - what is
    believed not because it was proven but because it was
    accepted. It is the only thing in the chain that attests
    itself (or nothing), and that is no defect but a necessity,
    since an infinite regress would destroy all trust.</glossa>
    <glossa lingua="fr">Une racine de confiance : le terme d'une
    chaîne d'attestations, dont le crédit ne vient pas d'une
    autre attestation mais d'une DÉCISION de celui qui emploie la
    chaîne - ce que l'on croit non parce que cela a été prouvé,
    mais parce que cela a été accepté. C'est la seule chose de la
    chaîne qui s'atteste elle-même (ou rien), et ce n'est pas un
    défaut mais une nécessité, car une régression à l'infini
    ruinerait toute confiance.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="modus-susceptionis" genus="electio">
      <optio>cum_systemate_missa</optio>
      <optio>ab_utente_addita</optio>
      <optio>lege_statuta</optio>
      <optio>consuetudine_recepta</optio>
    </attributum>
    <attributum nomen="tollibilis-a" genus="textus"/>
    <attributum nomen="ambitus-fidei" genus="textus"/>
    <attributum nomen="status-susceptio" genus="electio">
      <optio>suscepta</optio>
      <optio>limitata</optio>
      <optio>reiecta</optio>
      <optio>refundata</optio>
    </attributum>
    <attributum nomen="suscepta-per" genus="referentia"/>
    <attributum nomen="tenetur-a" genus="referentia"/>
    <liberum nomen="fundat"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="fundat" intra="radix-fiduciae">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="radix-fiduciae">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="actus-sollemnis">
    <glossa lingua="en">A solemn act: an act whose EFFECT depends on a
    prescribed form and on the capacity of the agent, and which is
    therefore VALID or VOID rather than good or bad - what is done
    rightly places its effect infallibly, what is done defectively
    places nothing at all. INSTITUTIONAL facts arise from here:
    offices, titles, obligations, and possessions do not come about
    of themselves but are constituted by a solemn act.</glossa>
    <glossa lingua="fr">Un acte solennel : un acte dont l'EFFET dépend
    d'une forme prescrite et de la capacité de l'agent, et qui est
    donc VALIDE ou NUL, non pas bon ou mauvais - ce qui est fait
    correctement pose son effet infailliblement, ce qui est fait de
    façon vicieuse ne pose rien. Les faits INSTITUÉS naissent de là :
    offices, titres, obligations et possessions ne se font pas
    d'eux-mêmes mais sont constitués par un acte solennel.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="forma-praescripta" genus="textus"/>
    <attributum nomen="intentio-necessaria" genus="veritas"/>
    <attributum nomen="testes-postulati" genus="numerus"/>
    <attributum nomen="iterabilis" genus="veritas"/>
    <attributum nomen="revocabilis" genus="veritas"/>
    <attributum nomen="status-vigor" genus="electio">
      <optio>perfectus</optio>
      <optio>irritus</optio>
      <optio>rescissus</optio>
      <optio>solutus</optio>
    </attributum>
    <attributum nomen="agens" genus="referentia"/>
    <attributum nomen="capacitas-per" genus="referentia"/>
    <attributum nomen="constituit" genus="referentia"/>
    <attributum nomen="afficit" genus="referentia"/>
    <attributum nomen="secundum-legem" genus="referentia"/>
    <attributum nomen="forma-eius" genus="referentia"/>
    <liberum nomen="testes"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="testes" intra="actus-sollemnis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="actus-sollemnis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="ritus">
    <glossa lingua="en">A rite: a solemn act ordered to divine worship
    - a sensible matter and a form of words, through a minister, for
    a spiritual effect. What civil authority supplies in a juridical
    act, divine or ecclesiastical institution supplies here.</glossa>
    <glossa lingua="fr">Un rite : un acte solennel ordonné au culte
    divin - une matière sensible et une forme de paroles, par un
    ministre, en vue d'un effet spirituel. Ce que l'autorité civile
    fournit dans un acte juridique, l'institution divine ou
    ecclésiastique le fournit ici.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="materia-ritus" genus="textus"/>
    <attributum nomen="minister" genus="referentia"/>
    <attributum nomen="recipiens" genus="referentia"/>
    <attributum nomen="adhibet" genus="referentia"/>
    <attributum nomen="forma-praescripta" genus="textus"/>
    <attributum nomen="intentio-necessaria" genus="veritas"/>
    <attributum nomen="testes-postulati" genus="numerus"/>
    <attributum nomen="iterabilis" genus="veritas"/>
    <attributum nomen="revocabilis" genus="veritas"/>
    <attributum nomen="status-vigor" genus="electio">
      <optio>perfectus</optio>
      <optio>irritus</optio>
      <optio>rescissus</optio>
      <optio>solutus</optio>
    </attributum>
    <attributum nomen="agens" genus="referentia"/>
    <attributum nomen="capacitas-per" genus="referentia"/>
    <attributum nomen="constituit" genus="referentia"/>
    <attributum nomen="afficit" genus="referentia"/>
    <attributum nomen="secundum-legem" genus="referentia"/>
    <attributum nomen="forma-eius" genus="referentia"/>
    <liberum nomen="testes"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="testes" intra="ritus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="ritus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="sacramentum">
    <glossa lingua="en">A sacrament: a rite that is an efficacious sign
    of grace, instituted by Christ - it places its effect EX OPERE
    OPERATO, from the act itself rightly performed, and not from the
    worthiness of the minister or of the recipient. An unworthy
    minister therefore acts validly, which separates the form from
    the man ENTIRELY.</glossa>
    <glossa lingua="fr">Un sacrement : un rite qui est signe efficace
    de la grâce, institué par le Christ - il pose son effet EX OPERE
    OPERATO, par l'acte lui-même correctement posé, et non par la
    dignité du ministre ou de celui qui le reçoit. Un ministre
    indigne agit donc validement, ce qui sépare TOTALEMENT la forme
    de l'homme.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="materia-ritus" genus="textus"/>
    <attributum nomen="minister" genus="referentia"/>
    <attributum nomen="recipiens" genus="referentia"/>
    <attributum nomen="adhibet" genus="referentia"/>
    <attributum nomen="forma-praescripta" genus="textus"/>
    <attributum nomen="intentio-necessaria" genus="veritas" ordinarius="verum"/>
    <attributum nomen="testes-postulati" genus="numerus"/>
    <attributum nomen="iterabilis" genus="veritas"/>
    <attributum nomen="revocabilis" genus="veritas"/>
    <attributum nomen="status-vigor" genus="electio">
      <optio>perfectus</optio>
      <optio>irritus</optio>
      <optio>rescissus</optio>
      <optio>solutus</optio>
    </attributum>
    <attributum nomen="agens" genus="referentia"/>
    <attributum nomen="capacitas-per" genus="referentia"/>
    <attributum nomen="constituit" genus="referentia"/>
    <attributum nomen="afficit" genus="referentia"/>
    <attributum nomen="secundum-legem" genus="referentia"/>
    <attributum nomen="forma-eius" genus="referentia"/>
    <liberum nomen="testes"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="testes" intra="sacramentum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="sacramentum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="sacramentale">
    <glossa lingua="en">A sacramental: a rite instituted by the Church
    and not by Christ - it places its effect EX OPERE OPERANTIS,
    from the disposition of the one acting and from the prayers of
    the Church, and not from the work itself. It therefore admits
    degrees of efficacy where a sacrament has a binary
    threshold.</glossa>
    <glossa lingua="fr">Un sacramental : un rite institué par l'Église
    et non par le Christ - il pose son effet EX OPERE OPERANTIS, par
    la disposition de celui qui agit et par les prières de l'Église,
    et non par l'œuvre elle-même. Il connaît donc des degrés
    d'efficacité là où le sacrement n'a qu'un seuil binaire.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="materia-ritus" genus="textus"/>
    <attributum nomen="minister" genus="referentia"/>
    <attributum nomen="recipiens" genus="referentia"/>
    <attributum nomen="adhibet" genus="referentia"/>
    <attributum nomen="forma-praescripta" genus="textus"/>
    <attributum nomen="intentio-necessaria" genus="veritas"/>
    <attributum nomen="testes-postulati" genus="numerus"/>
    <attributum nomen="iterabilis" genus="veritas"/>
    <attributum nomen="revocabilis" genus="veritas"/>
    <attributum nomen="status-vigor" genus="electio">
      <optio>perfectus</optio>
      <optio>irritus</optio>
      <optio>rescissus</optio>
      <optio>solutus</optio>
    </attributum>
    <attributum nomen="agens" genus="referentia"/>
    <attributum nomen="capacitas-per" genus="referentia"/>
    <attributum nomen="constituit" genus="referentia"/>
    <attributum nomen="afficit" genus="referentia"/>
    <attributum nomen="secundum-legem" genus="referentia"/>
    <attributum nomen="forma-eius" genus="referentia"/>
    <liberum nomen="testes"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="testes" intra="sacramentale">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="sacramentale">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="actus-iuridicus">
    <glossa lingua="en">A juridical act: a solemn act whose force civil
    authority supplies - the law prescribes the form, and the law
    acknowledges the effect. Its form therefore VARIES across
    jurisdictions where a rite stays the same the world over, and
    that is the difference which breaks international
    schemas.</glossa>
    <glossa lingua="fr">Un acte juridique : un acte solennel dont
    l'autorité civile fournit la force - la loi prescrit la forme,
    et la loi reconnaît l'effet. Sa forme VARIE donc selon les
    juridictions, là où un rite demeure le même par tout le monde,
    et c'est la différence qui brise les schémas
    internationaux.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="in-iurisdictione" genus="referentia"/>
    <attributum nomen="forma-praescripta" genus="textus"/>
    <attributum nomen="intentio-necessaria" genus="veritas"/>
    <attributum nomen="testes-postulati" genus="numerus"/>
    <attributum nomen="iterabilis" genus="veritas"/>
    <attributum nomen="revocabilis" genus="veritas"/>
    <attributum nomen="status-vigor" genus="electio">
      <optio>perfectus</optio>
      <optio>irritus</optio>
      <optio>rescissus</optio>
      <optio>solutus</optio>
    </attributum>
    <attributum nomen="agens" genus="referentia"/>
    <attributum nomen="capacitas-per" genus="referentia"/>
    <attributum nomen="constituit" genus="referentia"/>
    <attributum nomen="afficit" genus="referentia"/>
    <attributum nomen="secundum-legem" genus="referentia"/>
    <attributum nomen="forma-eius" genus="referentia"/>
    <liberum nomen="testes"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="testes" intra="actus-iuridicus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="actus-iuridicus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="quorum">
    <glossa lingua="en">A quorum: the number (or the fraction) of
    members whose presence or consent is required for a body to act
    validly - below it, the acts are not bad but NULL, since it was
    not the body that acted but a few of its members. It is a
    condition of VALIDITY, not of prudence: a council of a few may
    be wise and still void, a quorate one foolish and still
    valid.</glossa>
    <glossa lingua="fr">Un quorum : le nombre (ou la part) de membres
    dont la présence ou le consentement est requis pour qu'une
    assemblée agisse validement - en dessous, les actes ne sont pas
    mauvais mais NULS, car ce n'est pas l'assemblée qui a agi mais
    quelques-uns. C'est une condition de VALIDITÉ et non de
    prudence : un conseil restreint peut être sage et pourtant nul,
    un conseil au quorum insensé et pourtant valide.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="modus-computandi" genus="electio">
      <optio>ex_praesentibus</optio>
      <optio>ex_membris_omnibus</optio>
      <optio>ex_suffragiis_latis</optio>
    </attributum>
    <attributum nomen="pars-requisita" genus="textus"/>
    <attributum nomen="numerus-membrorum" genus="numerus"/>
    <attributum nomen="coetus" genus="referentia"/>
    <attributum nomen="statutum-per" genus="referentia"/>
    <liberum nomen="condicio-actus"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="condicio-actus" intra="quorum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="quorum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="animal">
    <glossa lingua="en">An animal: a living thing that has sensation
    and local motion - it perceives the world and moves itself
    toward it, whence appetite, whence flight, whence seeking. A
    plant stays where it is and takes what comes to it; an animal
    goes looking.</glossa>
    <glossa lingua="fr">Un animal : un vivant qui a la sensation et
    le mouvement local - il perçoit le monde et se meut vers lui,
    d'où l'appétit, d'où la fuite, d'où la quête. La plante demeure
    et prend ce qui lui vient ; l'animal cherche.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="victus" genus="electio">
      <optio>carnivorus</optio>
      <optio>herbivorus</optio>
      <optio>omnivorus</optio>
    </attributum>
    <attributum nomen="sanguine-calidus" genus="veritas"/>
    <attributum nomen="vita-media" genus="textus"/>
    <attributum nomen="status-aetas" genus="electio">
      <optio>fetus</optio>
      <optio>pullus</optio>
      <optio>adultus</optio>
      <optio>senex</optio>
    </attributum>
    <attributum nomen="pollinat" genus="referentia"/>
    <attributum nomen="anima" genus="electio" ordinarius="sensitiva">
      <optio>vegetativa</optio>
      <optio>sensitiva</optio>
      <optio>rationalis</optio>
    </attributum>
    <attributum nomen="status-vita" genus="electio">
      <optio>vivum</optio>
      <optio>mortuum</optio>
    </attributum>
    <attributum nomen="massa" genus="textus"/>
    <attributum nomen="perituram" genus="veritas"/>
    <attributum nomen="status-conditio" genus="electio">
      <optio>recens</optio>
      <optio>vetus</optio>
      <optio>corrupta</optio>
    </attributum>
    <attributum nomen="sita-in" genus="referentia"/>
    <liberum nomen="caput" maximum="1"/>
    <liberum nomen="cor" maximum="1"/>
    <liberum nomen="membra" maximum="1"/>
    <liberum nomen="praedatur"/>
    <liberum nomen="generat"/>
    <liberum nomen="laborat"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="caput" intra="animal">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="cor" intra="animal">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="membra" intra="animal">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="praedatur" intra="animal">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="generat" intra="animal">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="laborat" intra="animal">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="animal">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="architectura-machinae">
    <glossa lingua="en">A machine architecture: the abstract form
    of a computing machine that programs address - instruction
    set, registers, memory model. It is the covenant between
    compiler and hardware: many chips execute it, the
    architecture is one; it grows through versions while its
    identity remains.</glossa>
    <glossa lingua="fr">Une architecture machine : la forme
    abstraite d'une machine de calcul à laquelle les programmes
    s'adressent - jeu d'instructions, registres, modèle de
    mémoire. C'est le pacte entre le compilateur et le matériel :
    de nombreuses puces l'exécutent, l'architecture est une ;
    elle croît par versions tout en gardant son identité.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="indoles-copiae" genus="electio">
      <optio>cisc</optio>
      <optio>risc</optio>
      <optio>mixta</optio>
    </attributum>
    <attributum nomen="licentia-aperta" genus="veritas"/>
    <attributum nomen="habet-versionem" genus="referentia"/>
    <attributum nomen="exsecuta-a" genus="referentia"/>
    <attributum nomen="emissa-pro" genus="referentia"/>
    <liberum nomen="auctor"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="auctor" intra="architectura-machinae">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="architectura-machinae">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="versio-architecturae">
    <glossa lingua="en">An architecture version: a named edition
    of an architecture - which instruction set a chip really
    executes and a compiler really addresses. To say build for
    x86_64 is to cite a version, not a family.</glossa>
    <glossa lingua="fr">Une version d'architecture : une édition
    nommée d'une architecture - le jeu d'instructions qu'une puce
    exécute réellement et auquel un compilateur s'adresse
    réellement. Dire compiler pour x86_64, c'est citer une
    version, non une famille.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="titulus" genus="textus"/>
    <attributum nomen="latitudo-verbi" genus="numerus"/>
    <attributum nomen="edita" genus="dies"/>
    <attributum nomen="versio-de" genus="referentia"/>
    <attributum nomen="sequitur" genus="referentia"/>
    <attributum nomen="schema-numerandi" genus="electio">
      <optio>semanticum</optio>
      <optio>sequentiale</optio>
      <optio>temporale</optio>
      <optio>nominale</optio>
      <optio>mixtum</optio>
    </attributum>
    <attributum nomen="retro-compatibilis" genus="veritas"/>
    <attributum nomen="mutationes-fractoriae" genus="textus"/>
    <attributum nomen="status-sustentatio" genus="electio">
      <optio>praenuntiata</optio>
      <optio>vigens</optio>
      <optio>sustentata</optio>
      <optio>deprecata</optio>
      <optio>derelicta</optio>
    </attributum>
    <attributum nomen="asseritur-per" genus="referentia"/>
    <attributum nomen="edita-a" genus="referentia"/>
    <liberum nomen="compatibilis-cum"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="compatibilis-cum" intra="versio-architecturae">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="versio-architecturae">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="processorium">
    <glossa lingua="en">A processor: a product model of a
    computing circuit - a named form that a foundry prints into
    countless chips, and which executes an architecture (one or
    several of its versions) in silicon. It stands midway between
    the architecture, which is pure form, and the physical chip,
    which is a single corporeal thing: it has a clock frequency,
    cores and a price, but no haecceity - M1 is millions of chips
    and one thing.</glossa>
    <glossa lingua="fr">Un processeur : un modèle de produit de
    circuit de calcul - une forme nommée qu'une fonderie imprime
    en d'innombrables puces, et qui exécute une architecture (une
    ou plusieurs de ses versions) dans le silicium. Il se tient à
    mi-chemin entre l'architecture, qui est forme pure, et la
    puce physique, qui est une chose corporelle unique : il a une
    fréquence, des coeurs et un prix, mais pas d'eccéité - le M1
    est des millions de puces et une seule chose.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="nuclei" genus="numerus"/>
    <attributum nomen="frequentia" genus="textus"/>
    <attributum nomen="bits" genus="numerus"/>
    <attributum nomen="fabricatum-a" genus="referentia"/>
    <attributum nomen="designatum-a" genus="referentia"/>
    <liberum nomen="exsequitur"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="exsequitur" intra="processorium">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="processorium">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="causa">
    <glossa lingua="en">A cause: that by whose power something is or
    comes to be - not merely what comes before (that is an
    antecedent) but what BRINGS IT ABOUT. A most ancient
    distinction, neglected today: once the fallacy "post hoc ergo
    propter hoc" is admitted, the whole matter collapses.</glossa>
    <glossa lingua="fr">Une cause : ce par la vertu de quoi une chose
    est ou devient - non pas seulement ce qui précède (cela est un
    antécédent) mais ce qui PRODUIT. Distinction très ancienne et
    aujourd'hui négligée : une fois admis le sophisme « post hoc
    ergo propter hoc », toute la question est à terre.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="necessaria" genus="veritas"/>
    <attributum nomen="sufficiens" genus="veritas"/>
    <attributum nomen="causat" genus="referentia"/>
    <attributum nomen="asseritur-per" genus="referentia"/>
    <liberum nomen="pendet-ex"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="pendet-ex" intra="causa">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="causa">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="cliens">
    <glossa lingua="en">A client: a program that consumes someone
    else's service, acting on behalf of a user - the requesting half
    of a conversation. A client without a server is nothing; its
    essence lies in the relation.</glossa>
    <glossa lingua="fr">Un client : un programme qui consomme le
    service d'autrui en agissant pour un utilisateur - la moitié
    demandeuse du dialogue. Un client sans serveur n'est rien ; son
    essence tient dans la relation.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="agit-pro" genus="referentia"/>
    <liberum nomen="consumit"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="consumit" intra="cliens">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="cliens">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="cliens-telae">
    <glossa lingua="en">A web client: a client that lives in the
    browser. It needs no installation - the URL is itself the
    distribution. Everywhere at once, and bounded by the powers the
    system grants it.</glossa>
    <glossa lingua="fr">Un client web : un client qui vit dans le
    navigateur. Il ne demande aucune installation - l'adresse URL
    est elle-même la distribution. Partout aussitôt, et borné par
    les pouvoirs que le système lui accorde.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="agit-pro" genus="referentia"/>
    <liberum nomen="consumit"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="consumit" intra="cliens-telae">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="cliens-telae">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="cliens-nativus">
    <glossa lingua="en">A native client: a client that lives on the
    system itself. It requires installation and is repaid with
    fullness - files, processes, windows, the whole system lies open
    to it.</glossa>
    <glossa lingua="fr">Un client natif : un client qui vit sur le
    système même. Il exige une installation et s'en trouve
    récompensé par la plénitude - fichiers, processus, fenêtres,
    tout le système lui est ouvert.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="agit-pro" genus="referentia"/>
    <liberum nomen="consumit"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="consumit" intra="cliens-nativus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="cliens-nativus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="cliens-terminalis">
    <glossa lingua="en">A terminal client: a client that lives in the
    terminal and paints with text alone. Wherever the terminal
    reaches, it reaches - across SSH onto remote machines, without
    modification. In this house tessera clothes it, and saltuarius
    is the example.</glossa>
    <glossa lingua="fr">Un client en terminal : un client qui vit
    dans le terminal et ne peint qu'avec du texte. Là où parvient le
    terminal, il parvient - à travers SSH jusqu'aux machines
    distantes, sans modification. Dans cette maison, tessera
    l'habille, et saltuarius en est l'exemple.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="agit-pro" genus="referentia"/>
    <liberum nomen="consumit"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="consumit" intra="cliens-terminalis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="cliens-terminalis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="cliens-api">
    <glossa lingua="en">An API client: a client with no human face,
    machine serving machine, which consumes a programmatic
    interface. Its boundary with a library is thin - an API client
    is often just a library that speaks over the network.</glossa>
    <glossa lingua="fr">Un client d'API : un client sans visage
    humain, machine au service de la machine, qui consomme une
    interface programmatique. Sa frontière avec une bibliothèque est
    mince - un client d'API n'est souvent qu'une bibliothèque qui
    parle par le réseau.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="agit-pro" genus="referentia"/>
    <liberum nomen="consumit"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="consumit" intra="cliens-api">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="cliens-api">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="cliens-mcp">
    <glossa lingua="en">An MCP client: a client whose user is an
    artificial agent. It consumes services through a protocol of
    instruments, acting for a person by way of an agent. Genuinely
    new to our age - the axis of who is using has gained a third
    member. In this house: cliens_tabularii and legati.</glossa>
    <glossa lingua="fr">Un client MCP : un client dont l'utilisateur
    est un agent artificiel. Il consomme des services par un
    protocole d'instruments, agissant pour une personne par
    l'entremise d'un agent. Espèce vraiment nouvelle de notre
    époque - l'axe du qui s'en sert a reçu un troisième membre. Dans
    la maison : cliens_tabularii et legati.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="agit-pro" genus="referentia"/>
    <liberum nomen="consumit"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="consumit" intra="cliens-mcp">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="cliens-mcp">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="cliens-cli">
    <glossa lingua="en">A command-line client: a client that is a
    tool of one command - it is called, it acts, it exits.
    Composition is its essence: it joins with others through pipes,
    its output becoming another's input (the Unix philosophy). In
    this house: silex and aedilis.</glossa>
    <glossa lingua="fr">Un client en ligne de commande : un client
    qui est l'outil d'une seule commande - on l'appelle, il agit, il
    sort. La composition en est l'essence : il se joint aux autres
    par des tubes, sa sortie devenant l'entrée d'un autre
    (philosophie Unix). Dans la maison : silex et aedilis.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="agit-pro" genus="referentia"/>
    <liberum nomen="consumit"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="consumit" intra="cliens-cli">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="cliens-cli">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="cliens-mobilis">
    <glossa lingua="en">A mobile client: a client that lives on the
    telephone - touch instead of a mouse, interruptions instead of a
    session, the battery as its limit. Its constraints are what set
    it apart. In this house, vitrea servus carries applications to
    the phone.</glossa>
    <glossa lingua="fr">Un client mobile : un client qui vit sur le
    téléphone - le toucher au lieu de la souris, les interruptions
    au lieu d'une session, la batterie pour limite. Ce sont ses
    contraintes qui le distinguent. Dans la maison, vitrea servus
    porte les applications jusqu'au téléphone.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="agit-pro" genus="referentia"/>
    <liberum nomen="consumit"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="consumit" intra="cliens-mobilis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="cliens-mobilis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="servus">
    <glossa lingua="en">A server: a program that offers a service to
    others - the answering half of a conversation. It does not
    begin but waits, and it acts for whoever asks, where a client
    acts for one user and opens the conversation. The dividing line
    is neither size nor place, since a server may run on the same
    machine, but who calls first: the caller is the client, the one
    called is the server.</glossa>
    <glossa lingua="fr">Un serveur : un programme qui offre un
    service à autrui - la moitié répondante du dialogue. Il ne
    commence pas mais attend, et il agit pour quiconque demande, là
    où le client agit pour un seul utilisateur et ouvre le dialogue.
    La ligne de partage n'est ni la taille ni le lieu, puisqu'un
    serveur peut tourner sur la même machine, mais l'initiative :
    celui qui appelle est le client, celui qu'on appelle est le
    serveur.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="status-inter-petitiones" genus="electio">
      <optio>sine_statu</optio>
      <optio>cum_statu</optio>
    </attributum>
    <attributum nomen="simultas" genus="electio">
      <optio>singularis</optio>
      <optio>multiplex</optio>
    </attributum>
    <attributum nomen="agnitio-petentis" genus="electio">
      <optio>nulla</optio>
      <optio>asserta</optio>
      <optio>probata</optio>
    </attributum>
    <attributum nomen="praebet" genus="referentia"/>
    <attributum nomen="auditur-in" genus="referentia"/>
    <attributum nomen="currit-ut" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="servus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="moneta">
    <glossa lingua="en">A currency: a kind of money issued by an
    authority and accepted in payment - a unit for measuring value,
    but a unit whose own value shifts. A metre keeps its length; a
    currency does not keep its value.</glossa>
    <glossa lingua="fr">Une monnaie : un genre de numéraire émis par
    une autorité et reçu en paiement - une unité de mesure de la
    valeur, mais une unité dont la valeur propre change. Le mètre
    conserve sa longueur ; la monnaie ne conserve pas la
    sienne.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="codex" genus="textus"/>
    <attributum nomen="symbolum" genus="textus"/>
    <attributum nomen="emissa-a" genus="referentia"/>
    <attributum nomen="normata-per" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="moneta">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="pecunia">
    <glossa lingua="en">A sum of money: a number together with a
    currency - "3,50" is nothing until a currency is named, just as
    a quantity demands a unit. Addition holds only within one
    currency; across currencies a conversion is needed, and its rate
    changes over time, so a sum that is right today is wrong
    tomorrow.</glossa>
    <glossa lingua="fr">Une somme d'argent : un nombre accompagné
    d'une monnaie - « 3,50 » n'est rien tant qu'une monnaie n'est
    pas donnée, de même qu'une quantité réclame une unité.
    L'addition ne vaut qu'à l'intérieur d'une seule monnaie ; d'une
    monnaie à l'autre il faut une conversion, dont le taux change
    avec le temps - une addition juste aujourd'hui ne l'est plus
    demain.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="valor" genus="numerus"/>
    <attributum nomen="in-moneta" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="pecunia">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="possessio">
    <glossa lingua="en">Ownership: the relation between a person (or
    an organization) and a thing - who holds what. It is not a
    property of the thing but a relation; the loaf stays the same
    loaf when its owner changes, and only the relation changes.
    That is why a sale never touches the thing: it transfers the
    relation.</glossa>
    <glossa lingua="fr">La possession : la relation entre une
    personne (ou une organisation) et une chose - qui détient quoi.
    Ce n'est pas une propriété de la chose mais une relation ; le
    pain reste le même pain quand son maître change, et seule la
    relation change. C'est pourquoi la vente ne touche jamais la
    chose : elle transfère la relation.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="possessor" genus="referentia"/>
    <attributum nomen="possessum" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="possessio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="pretium">
    <glossa lingua="en">A price: the money asked for a thing - a
    relation between the thing and money that varies with time, not
    a property of the thing. The same loaf had a different price
    yesterday; to suppose that the price inheres in the thing is the
    common error.</glossa>
    <glossa lingua="fr">Un prix : l'argent demandé pour une chose -
    une relation entre la chose et l'argent qui varie avec le temps,
    et non une propriété de la chose. Le même pain avait hier un
    autre prix ; croire que le prix est inhérent à la chose est
    l'erreur courante.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="valens-a" genus="dies"/>
    <attributum nomen="valens-ad" genus="dies"/>
    <attributum nomen="pretium-rei" genus="referentia"/>
    <attributum nomen="quantum" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="pretium">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="venditio">
    <glossa lingua="en">A sale: the event in which ownership of a
    thing passes one way while money flows the other - a double
    change at once, which double-entry bookkeeping (Pacioli) wrote
    down before any computer existed. A sale is not a thing but
    something that happens; what remains of it is its
    record.</glossa>
    <glossa lingua="fr">Une vente : l'événement par lequel la
    possession d'une chose passe dans un sens tandis que l'argent
    coule dans l'autre - un double changement simultané, que la
    comptabilité en partie double (Pacioli) a consigné avant tout
    ordinateur. Une vente n'est pas une chose mais un fait qui
    arrive ; ce qui en demeure, ce sont ses écritures.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="venditor" genus="referentia"/>
    <attributum nomen="emptor" genus="referentia"/>
    <attributum nomen="solutum" genus="referentia"/>
    <attributum nomen="parit" genus="referentia"/>
    <liberum nomen="res-vendita"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="res-vendita" intra="venditio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="venditio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="tessera">
    <glossa lingua="en">A token: a thing whose presentation
    constitutes a right rather than proving one. The whole
    difference from an ordinary receipt lies here - a receipt
    attests that you paid, a token carries the right itself. So a
    lost token is a lost right, whereas a lost receipt is only a
    nuisance.</glossa>
    <glossa lingua="fr">Un titre (tessera) : une chose dont la
    présentation constitue un droit au lieu de le prouver.
    Toute la différence avec un simple reçu tient là - le reçu
    atteste que vous avez payé, le titre porte le droit lui-même.
    Un titre perdu est donc un droit perdu, tandis qu'un reçu perdu
    n'est qu'un désagrément.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="modus-transferendi" genus="electio">
      <optio>ad_portitorem</optio>
      <optio>ad_ordinem</optio>
    </attributum>
    <attributum nomen="materia-tesserae" genus="electio">
      <optio>corporea</optio>
      <optio>digitalis</optio>
    </attributum>
    <attributum nomen="exhibitione-consumitur" genus="veritas"/>
    <attributum nomen="fert-ius-in" genus="referentia"/>
    <attributum nomen="emissa-a" genus="referentia"/>
    <attributum nomen="possessio-eius" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="tessera">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="tessera-negotiabilis">
    <glossa lingua="en">A negotiable token: a token - a thing whose
    presentation constitutes a right - such that whoever takes it in
    good faith and for value receives clean title, even if the one
    who handed it over held no right himself. This is the exception
    to the rule that no one gives what he does not have. Not mere
    possession, which every token confers, but the purging of prior
    defects: that alone makes a token negotiable, and that alone
    makes trade between strangers possible.</glossa>
    <glossa lingua="fr">Un titre négociable : un titre - chose dont
    la présentation constitue un droit - tel que celui qui le reçoit
    de bonne foi et à titre onéreux acquiert un titre pur, même si
    celui qui le remettait n'avait lui-même aucun droit. C'est
    l'exception à la règle selon laquelle nul ne donne ce qu'il n'a
    pas. Non la simple possession, commune à tous les titres, mais
    la purge des vices antérieurs : elle seule fait la
    négociabilité, et elle seule rend possible le commerce entre
    inconnus.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="modus-transferendi" genus="electio">
      <optio>ad_portitorem</optio>
      <optio>ad_ordinem</optio>
    </attributum>
    <attributum nomen="materia-tesserae" genus="electio">
      <optio>corporea</optio>
      <optio>digitalis</optio>
    </attributum>
    <attributum nomen="exhibitione-consumitur" genus="veritas"/>
    <attributum nomen="fert-ius-in" genus="referentia"/>
    <attributum nomen="emissa-a" genus="referentia"/>
    <attributum nomen="possessio-eius" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="tessera-negotiabilis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="tessera-simplex">
    <glossa lingua="en">A plain token: a token - a thing whose
    presentation constitutes a right - where possession is enough to
    present it, but where no title is purged. Whoever presents a
    stolen token is admitted, since the doorkeeper cannot know, and
    yet he acquires no right: the true owner may still reclaim it.
    The mechanism is the same as for a negotiable token; the legal
    doctrine is absent.</glossa>
    <glossa lingua="fr">Un titre simple : un titre - chose dont la
    présentation constitue un droit - où la possession suffit pour
    le présenter, mais où aucun titre n'est purgé. Celui qui
    présente un titre volé est admis, car le gardien ne peut pas le
    savoir, et pourtant il n'acquiert aucun droit : le véritable
    propriétaire peut encore le revendiquer. Le mécanisme est le
    même que pour le titre négociable ; la doctrine, elle, fait
    défaut.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="modus-transferendi" genus="electio">
      <optio>ad_portitorem</optio>
      <optio>ad_ordinem</optio>
    </attributum>
    <attributum nomen="materia-tesserae" genus="electio">
      <optio>corporea</optio>
      <optio>digitalis</optio>
    </attributum>
    <attributum nomen="exhibitione-consumitur" genus="veritas"/>
    <attributum nomen="fert-ius-in" genus="referentia"/>
    <attributum nomen="emissa-a" genus="referentia"/>
    <attributum nomen="possessio-eius" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="tessera-simplex">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="ratio-rationaria">
    <glossa lingua="en">An account ledger: a record of monetary
    events in order of time. The truth is the tail of events, and
    every state - balance, debt, profit - is a fold over them.
    Correction is never by erasure but by a new and contrary entry
    (a reversal), because a record that can be rewritten is not a
    record. What makes it monetary rather than a plain record is
    that its events carry amounts in a currency, so the fold is
    arithmetic and numerical invariants become possible.</glossa>
    <glossa lingua="fr">Un livre de comptes : le registre des faits
    monétaires par ordre du temps. La vérité, c'est la suite des
    événements, et tout état - solde, dette, bénéfice - en est le
    repli. La correction ne se fait jamais par rature mais par une
    écriture nouvelle et contraire (une contre-passation), car un
    registre que l'on peut réécrire n'est pas un registre. Ce qui le
    rend monétaire plutôt que simple registre, c'est que ses
    événements portent des montants dans une monnaie : le repli est
    donc arithmétique et des invariants numériques deviennent
    possibles.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="rationarius" genus="referentia"/>
    <attributum nomen="ordinatio" genus="electio">
      <optio>sequentialis</optio>
      <optio>temporalis</optio>
      <optio>utraque</optio>
    </attributum>
    <attributum nomen="immutabilitas" genus="electio">
      <optio>disciplina</optio>
      <optio>structura</optio>
      <optio>cryptographica</optio>
    </attributum>
    <attributum nomen="retentio" genus="textus"/>
    <attributum nomen="publica" genus="veritas"/>
    <attributum nomen="vis" genus="electio">
      <optio>declaratoria</optio>
      <optio>constitutiva</optio>
    </attributum>
    <attributum nomen="status-admissio" genus="electio">
      <optio>aperta</optio>
      <optio>clausa</optio>
      <optio>archivata</optio>
    </attributum>
    <attributum nomen="de" genus="referentia"/>
    <attributum nomen="appenditur-a" genus="referentia"/>
    <liberum nomen="continet"/>
    <liberum nomen="eventum" maximum="1"/>
    <liberum nomen="ordo" maximum="1"/>
    <liberum nomen="punctum-nominatum" maximum="1"/>
    <liberum nomen="proiectio" maximum="1"/>
    <liberum nomen="promptuarium-contenti" maximum="1"/>
    <liberum nomen="plicatur-in"/>
    <liberum nomen="signata-per"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="continet" intra="ratio-rationaria">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="eventum" intra="ratio-rationaria">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="ordo" intra="ratio-rationaria">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="punctum-nominatum" intra="ratio-rationaria">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="proiectio" intra="ratio-rationaria">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="promptuarium-contenti" intra="ratio-rationaria">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="plicatur-in" intra="ratio-rationaria">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="signata-per" intra="ratio-rationaria">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="ratio-rationaria">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="actor">
    <glossa lingua="en">An actor: a logical entity with an
    identity, private state, and behaviour, which communicates
    with others ONLY by messages. It alone changes its own state
    and never touches anyone else's - it asks, by sending a
    message. The form was named by Hewitt (1973), proven by
    Erlang, and realized in this house in actor.c.</glossa>
    <glossa lingua="fr">Un acteur : une entité logique dotée d'une
    identité, d'un état privé et de comportements, qui ne
    communique avec les autres QUE par messages. Lui seul modifie
    son propre état et ne touche jamais celui d'autrui - il le
    demande, en envoyant un message. La forme fut nommée par
    Hewitt (1973), éprouvée par Erlang, et réalisée dans cette
    maison dans actor.c.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="capsa-eius" genus="referentia"/>
    <liberum nomen="mittit"/>
    <liberum nomen="accipit"/>
    <liberum nomen="custodit"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="mittit" intra="actor">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="accipit" intra="actor">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="custodit" intra="actor">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="actor">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="nuntius">
    <glossa lingua="en">A message: communication made into a thing
    - data in transit, ADDRESSED, since a recipient is owed to
    it. The act of communicating turned into an object: it can be
    put in a queue, recorded, replayed. To send a message is to
    ask another to change itself; the request itself has been
    made a thing.</glossa>
    <glossa lingua="fr">Un message : la communication réifiée -
    des données en transit, ADRESSÉES, car un destinataire lui
    est dû. L'acte de communiquer converti en chose : on peut le
    mettre en file, l'enregistrer, le rejouer. Envoyer un
    message, c'est demander à un autre de se modifier ; la
    demande elle-même devenue chose.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="genus-nuntii" genus="textus"/>
    <attributum nomen="disciplina-schematis" genus="electio">
      <optio>sine_schemate</optio>
      <optio>cum_schemate</optio>
    </attributum>
    <attributum nomen="garantia-traditionis" genus="electio">
      <optio>ad_summum_semel</optio>
      <optio>ad_minimum_semel</optio>
      <optio>semel_exacte_tractatum</optio>
    </attributum>
    <attributum nomen="status-cursus" genus="electio">
      <optio>creatus</optio>
      <optio>missus</optio>
      <optio>traditus</optio>
      <optio>consumptus</optio>
    </attributum>
    <attributum nomen="portat" genus="referentia"/>
    <attributum nomen="missus-a" genus="referentia"/>
    <attributum nomen="destinatus-ad" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="nuntius">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="eventum">
    <glossa lingua="en">An event: something done that is NOT
    addressed - it happens, and any observer can see it; it is
    owed to no one. It differs from a message by address: a
    message goes TO someone, an event happens BEFORE
    everyone.</glossa>
    <glossa lingua="fr">Un événement : un fait qui n'est PAS
    adressé - il survient, et quiconque observe peut le voir ; il
    n'est dû à personne. Il diffère du message par l'adresse : le
    message va À quelqu'un, l'événement se produit DEVANT
    tous.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <liberum nomen="observatur-ab"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="observatur-ab" intra="eventum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="eventum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="stigmergia">
    <glossa lingua="en">Stigmergy: coordination by a trace that an
    agent leaves in a shared medium - a sign addressed to no one,
    which remains, which any passer-by can read, and which decays
    of itself. It is neither sent nor does it merely happen: it
    LIES there. Having neither sender nor recipient, it makes
    coordination possible among agents who need neither know one
    another nor be present at the same time.</glossa>
    <glossa lingua="fr">La stigmergie : la coordination par une
    trace qu'un agent laisse dans un milieu commun - un signe
    adressé à personne, qui demeure, que tout passant peut lire,
    et qui s'efface de lui-même. Elle n'est ni envoyée ni un
    simple fait : elle GÎT là. N'ayant ni expéditeur ni
    destinataire, elle rend possible la coordination d'agents qui
    n'ont besoin ni de se connaître ni d'être présents en même
    temps.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="tabescentia" genus="textus"/>
    <attributum nomen="cumulativa" genus="veritas"/>
    <attributum nomen="medium" genus="textus"/>
    <attributum nomen="movet" genus="referentia"/>
    <liberum nomen="relinquitur-a"/>
    <liberum nomen="legitur-a"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="relinquitur-a" intra="stigmergia">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="legitur-a" intra="stigmergia">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="stigmergia">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="res-corporea">
    <glossa lingua="en">A bodily thing: what has matter, occupies a
    place and is corrupted by time - a thing that can be touched
    with the hands. It differs from digital things in that it
    CANNOT be copied: a copy of a loaf demands another loaf, a copy
    of a file demands nothing.</glossa>
    <glossa lingua="fr">Une chose corporelle : ce qui a de la matière,
    occupe un lieu et se corrompt avec le temps - une chose que
    l'on peut toucher de la main. Elle diffère des choses
    numériques en ce qu'elle ne peut PAS être copiée : copier un
    pain exige un second pain, copier un fichier n'exige rien.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="massa" genus="textus"/>
    <attributum nomen="perituram" genus="veritas"/>
    <attributum nomen="status-conditio" genus="electio">
      <optio>recens</optio>
      <optio>vetus</optio>
      <optio>corrupta</optio>
    </attributum>
    <attributum nomen="sita-in" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="res-corporea">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="artefactum">
    <glossa lingua="en">An artefact: a bodily thing made by man for an
    end. It is COUNTABLE and singular and has thisness - this loaf,
    not another, even when its twin sits beside it. Its form is
    imposed on it by the maker, it does not arise from
    nature.</glossa>
    <glossa lingua="fr">Un artefact : une chose corporelle faite par
    l'homme en vue d'une fin. Il est DÉNOMBRABLE et singulier et
    possède une eccéité - ce pain-ci, non un autre, même si son
    jumeau est à côté. Sa forme lui est imposée par l'artisan, elle
    ne naît pas de la nature.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="factum-per" genus="referentia"/>
    <attributum nomen="factum-a" genus="referentia"/>
    <attributum nomen="massa" genus="textus"/>
    <attributum nomen="perituram" genus="veritas"/>
    <attributum nomen="status-conditio" genus="electio">
      <optio>recens</optio>
      <optio>vetus</optio>
      <optio>corrupta</optio>
    </attributum>
    <attributum nomen="sita-in" genus="referentia"/>
    <liberum nomen="materiae-constituentes" maximum="1"/>
    <liberum nomen="ex-materia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="materiae-constituentes" intra="artefactum">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="ex-materia" intra="artefactum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="artefactum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="materia">
    <glossa lingua="en">Matter, or stuff: a bodily thing that is
    MEASURED and not counted - flour, water, oil; "three flours"
    means nothing. Divided, it stays what it was (half a mass of
    flour is flour), whereas a divided artefact perishes (half a
    loaf is not a loaf but a part of one). Individual identity is
    LACKING to it: its form alone constitutes it.</glossa>
    <glossa lingua="fr">La matière : une chose corporelle que l'on
    MESURE au lieu de la compter - farine, eau, huile ; « trois
    farines » ne signifie rien. Divisée, elle reste ce qu'elle
    était (la moitié d'une masse de farine est de la farine),
    tandis qu'un artefact divisé périt (une moitié de pain n'est
    pas un pain mais une partie de pain). L'identité individuelle
    lui MANQUE : sa forme seule la constitue.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="quantitas-praesens" genus="textus"/>
    <attributum nomen="massa" genus="textus"/>
    <attributum nomen="perituram" genus="veritas"/>
    <attributum nomen="status-conditio" genus="electio">
      <optio>recens</optio>
      <optio>vetus</optio>
      <optio>corrupta</optio>
    </attributum>
    <attributum nomen="sita-in" genus="referentia"/>
    <liberum nomen="ingreditur"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="ingreditur" intra="materia">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="materia">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="instrumentum">
    <glossa lingua="en">A tool: an artefact made for making and not
    for consuming. Use PRESERVES it (indeed use is its very end)
    rather than destroying it: the oven bakes the bread and the
    oven remains, which is what sets a tool apart from food and
    from matter.</glossa>
    <glossa lingua="fr">Un instrument : un artefact fait pour
    produire, non pour être consommé. L'usage le CONSERVE (l'usage
    est même sa fin) au lieu de le détruire : le four cuit le pain
    et le four demeure, ce qui distingue l'instrument de l'aliment
    et de la matière.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="capacitas" genus="textus"/>
    <attributum nomen="status-usus" genus="electio">
      <optio>otiosum</optio>
      <optio>in_usu</optio>
      <optio>in_reparatione</optio>
      <optio>fractum</optio>
    </attributum>
    <attributum nomen="factum-per" genus="referentia"/>
    <attributum nomen="factum-a" genus="referentia"/>
    <attributum nomen="massa" genus="textus"/>
    <attributum nomen="perituram" genus="veritas"/>
    <attributum nomen="status-conditio" genus="electio">
      <optio>recens</optio>
      <optio>vetus</optio>
      <optio>corrupta</optio>
    </attributum>
    <attributum nomen="sita-in" genus="referentia"/>
    <liberum nomen="materiae-constituentes" maximum="1"/>
    <liberum nomen="ex-materia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="materiae-constituentes" intra="instrumentum">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="ex-materia" intra="instrumentum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="instrumentum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="res-sacra">
    <glossa lingua="en">A sacred thing: a bodily thing set apart for
    divine worship by an ACT, not by its nature nor by its matter.
    The same wood can be a table or an altar, and the whole
    difference rests on the consecration. The kind is therefore a
    pure test of the doctrine of the solemn act: the status of the
    thing comes from the act, not from the material.</glossa>
    <glossa lingua="fr">Une chose sacrée : une chose corporelle dédiée
    au culte divin par un ACTE, non par sa nature ni par sa
    matière. Le même bois peut être une table ou un autel, et toute
    la différence tient à la consécration. Ce genre est donc une
    épreuve pure de la doctrine de l'acte solennel : le statut de
    la chose vient de l'acte, non du matériau.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="alienabilis" genus="veritas"/>
    <attributum nomen="status-dedicatio" genus="electio">
      <optio>profana</optio>
      <optio>sacra</optio>
      <optio>violata</optio>
      <optio>reducta</optio>
    </attributum>
    <attributum nomen="consecrata-per" genus="referentia"/>
    <attributum nomen="custoditur-ab" genus="referentia"/>
    <attributum nomen="massa" genus="textus"/>
    <attributum nomen="perituram" genus="veritas"/>
    <attributum nomen="status-conditio" genus="electio">
      <optio>recens</optio>
      <optio>vetus</optio>
      <optio>corrupta</optio>
    </attributum>
    <attributum nomen="sita-in" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="res-sacra">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="damnum">
    <glossa lingua="en">Damage: an injury to the integrity of a bodily
    thing inflicted by an outside force - what was one is divided,
    what was whole is broken, what was pure is mixed. It is a
    failing not of intention nor of nature but of INTEGRITY, and so
    it can befall any body whatever, even one that has neither an
    end nor a nature of its own.</glossa>
    <glossa lingua="fr">Le dommage : une atteinte à l'intégrité d'une
    chose corporelle infligée par une force extérieure - ce qui
    était un est divisé, ce qui était entier est brisé, ce qui
    était pur est mêlé. Ce n'est un défaut ni de l'intention ni de
    la nature mais de l'INTÉGRITÉ ; aussi peut-il atteindre tout
    corps, même celui qui n'a ni fin ni nature propre.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="gravitas" genus="electio">
      <optio>levis</optio>
      <optio>gravis</optio>
      <optio>totalis</optio>
    </attributum>
    <attributum nomen="reparabile" genus="veritas"/>
    <attributum nomen="status-integritas" genus="electio">
      <optio>integrum</optio>
      <optio>damnatum</optio>
      <optio>refectum</optio>
      <optio>perditum</optio>
    </attributum>
    <attributum nomen="affligit" genus="referentia"/>
    <attributum nomen="illatum-per" genus="referentia"/>
    <attributum nomen="praevisum-ut" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="damnum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="vivens">
    <glossa lingua="en">A living thing: a bodily thing that moves,
    feeds and generates itself, holding the principle of its motion
    WITHIN, where an artefact receives its motion from another and
    matter has none. It is not made by man (though it may be tended
    by him); being countable and having thisness, it is not
    matter.</glossa>
    <glossa lingua="fr">Un vivant : une chose corporelle qui se meut,
    se nourrit et s'engendre elle-même, tenant EN elle-même le
    principe de son mouvement, là où l'artefact reçoit son
    mouvement d'autrui et où la matière n'en a aucun. Il n'est pas
    fait par l'homme (même s'il est cultivé par lui) ; étant
    dénombrable et doté d'une eccéité, il n'est pas de la
    matière.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="anima" genus="electio">
      <optio>vegetativa</optio>
      <optio>sensitiva</optio>
      <optio>rationalis</optio>
    </attributum>
    <attributum nomen="status-vita" genus="electio">
      <optio>vivum</optio>
      <optio>mortuum</optio>
    </attributum>
    <attributum nomen="massa" genus="textus"/>
    <attributum nomen="perituram" genus="veritas"/>
    <attributum nomen="status-conditio" genus="electio">
      <optio>recens</optio>
      <optio>vetus</optio>
      <optio>corrupta</optio>
    </attributum>
    <attributum nomen="sita-in" genus="referentia"/>
    <liberum nomen="generat"/>
    <liberum nomen="laborat"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="generat" intra="vivens">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="laborat" intra="vivens">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="vivens">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="dictionarium">
    <glossa lingua="en">A dictionary (reference work): a work
    intended for consultation - it teaches what things ARE, entry
    by entry, ordered for seeking rather than reading. The reader
    comes for one thing, finds it, and leaves; the work is
    visited, not read through.</glossa>
    <glossa lingua="fr">Un dictionnaire (ouvrage de référence) :
    une œuvre destinée à la consultation - elle enseigne ce que
    SONT les choses, entrée par entrée, ordonnée pour chercher et
    non pour lire. Le lecteur vient pour une chose, la trouve et
    s'en va ; l'œuvre se consulte, elle ne se lit pas d'un
    trait.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="titulus-originalis" genus="textus"/>
    <attributum nomen="lingua-originalis" genus="textus"/>
    <attributum nomen="status-compositio" genus="electio">
      <optio>concepta</optio>
      <optio>in_scriptione</optio>
      <optio>perfecta</optio>
      <optio>imperfecta_relicta</optio>
    </attributum>
    <attributum nomen="habet-expressionem" genus="referentia"/>
    <attributum nomen="continuatio-de" genus="referentia"/>
    <attributum nomen="respondet-ad" genus="referentia"/>
    <attributum nomen="pars-de" genus="referentia"/>
    <liberum nomen="materia"/>
    <liberum nomen="auctor"/>
    <liberum nomen="scriba"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="materia" intra="dictionarium" textus="verum"/>
  <elementum nomen="auctor" intra="dictionarium">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="scriba" intra="dictionarium">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="dictionarium">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="manuale">
    <glossa lingua="en">A manual: a work intended for action - it
    teaches what is to be DONE. The reader wants to accomplish some
    task and receives the steps from the text; a dictionary says
    what a thing is, a manual says how it is done.</glossa>
    <glossa lingua="fr">Un manuel : une œuvre destinée à l'action -
    elle enseigne ce qu'il faut FAIRE. Le lecteur veut accomplir
    une tâche et reçoit du texte les étapes ; le dictionnaire dit
    ce qu'est une chose, le manuel dit comment elle se
    fait.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="titulus-originalis" genus="textus"/>
    <attributum nomen="lingua-originalis" genus="textus"/>
    <attributum nomen="status-compositio" genus="electio">
      <optio>concepta</optio>
      <optio>in_scriptione</optio>
      <optio>perfecta</optio>
      <optio>imperfecta_relicta</optio>
    </attributum>
    <attributum nomen="habet-expressionem" genus="referentia"/>
    <attributum nomen="continuatio-de" genus="referentia"/>
    <attributum nomen="respondet-ad" genus="referentia"/>
    <attributum nomen="pars-de" genus="referentia"/>
    <liberum nomen="materia"/>
    <liberum nomen="auctor"/>
    <liberum nomen="scriba"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="materia" intra="manuale" textus="verum"/>
  <elementum nomen="auctor" intra="manuale">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="scriba" intra="manuale">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="manuale">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="exemplum">
    <glossa lingua="en">A worked example: a complete specimen meant
    for imitation - it shows rather than describes. The reader
    copies it and adapts it; completeness is the differentia - a
    fragment demonstrates, a worked example gets you
    started.</glossa>
    <glossa lingua="fr">Un exemple complet : un spécimen intégral
    destiné à l'imitation - il montre au lieu de décrire. Le
    lecteur le transcrit et l'adapte ; l'intégralité fait la
    différence - un fragment démontre, un exemple complet fait
    démarrer.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="titulus-originalis" genus="textus"/>
    <attributum nomen="lingua-originalis" genus="textus"/>
    <attributum nomen="status-compositio" genus="electio">
      <optio>concepta</optio>
      <optio>in_scriptione</optio>
      <optio>perfecta</optio>
      <optio>imperfecta_relicta</optio>
    </attributum>
    <attributum nomen="habet-expressionem" genus="referentia"/>
    <attributum nomen="continuatio-de" genus="referentia"/>
    <attributum nomen="respondet-ad" genus="referentia"/>
    <attributum nomen="pars-de" genus="referentia"/>
    <liberum nomen="materia"/>
    <liberum nomen="auctor"/>
    <liberum nomen="scriba"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="materia" intra="exemplum" textus="verum"/>
  <elementum nomen="auctor" intra="exemplum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="scriba" intra="exemplum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="exemplum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="legenda">
    <glossa lingua="en">A legend: the key to a notation - it teaches
    what the signs in another work mean. Without a legend a
    notation is mute: the reader sees a mark and cannot tell
    ornament from statement.</glossa>
    <glossa lingua="fr">Une légende : la clef d'une notation - elle
    enseigne ce que signifient les signes d'une autre œuvre. Sans
    légende, une notation est muette : le lecteur voit un signe
    sans savoir s'il est ornement ou énoncé.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="titulus-originalis" genus="textus"/>
    <attributum nomen="lingua-originalis" genus="textus"/>
    <attributum nomen="status-compositio" genus="electio">
      <optio>concepta</optio>
      <optio>in_scriptione</optio>
      <optio>perfecta</optio>
      <optio>imperfecta_relicta</optio>
    </attributum>
    <attributum nomen="habet-expressionem" genus="referentia"/>
    <attributum nomen="continuatio-de" genus="referentia"/>
    <attributum nomen="respondet-ad" genus="referentia"/>
    <attributum nomen="pars-de" genus="referentia"/>
    <liberum nomen="materia"/>
    <liberum nomen="auctor"/>
    <liberum nomen="scriba"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="materia" intra="legenda" textus="verum"/>
  <elementum nomen="auctor" intra="legenda">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="scriba" intra="legenda">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="legenda">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="defectus-documenti">
    <glossa lingua="en">A document defect: what the text owed the
    reader and a reading does not yield - the discrepancy between
    what the document owed and what a reader can construe from it.
    Parallel to vitium without inheriting from it: a vitium sets
    intention against behavior, and a document has no behavior -
    it does not act, it is read.</glossa>
    <glossa lingua="fr">Un défaut de document : ce que le texte
    devait au lecteur et qu'une lecture ne rend pas - l'écart
    entre ce que le document devait et ce que le lecteur peut en
    tirer. Parallèle au vitium sans en hériter : le vitium oppose
    l'intention au comportement, et un document n'a pas de
    comportement - il n'agit pas, il se lit.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="contentum" genus="textus"/>
    <attributum nomen="in-opere" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="defectus-documenti">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="deceptio">
    <glossa lingua="en">Active misleading: the text teaches a
    falsehood - a correct reading leads the reader into error. It
    has a victim, hence its rank first in force: the trouble is
    not what is missing but what is falsely present.</glossa>
    <glossa lingua="fr">L'égarement actif : le texte enseigne une
    fausseté - une lecture correcte conduit le lecteur à l'erreur.
    Il a une victime, d'où son rang premier en force : le mal
    n'est pas ce qui manque mais ce qui est faussement
    présent.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="contentum" genus="textus"/>
    <attributum nomen="in-opere" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="deceptio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="silentium">
    <glossa lingua="en">Silence: the text withholds what it knows -
    the knowledge exists and the telling omits it. Distinct from
    iudicium's ignotum, which is the reader's named gap; this is
    the page's side of the same absence.</glossa>
    <glossa lingua="fr">Le silence : le texte tait ce qu'il sait -
    le savoir existe et le récit l'omet. Distinct de l'ignotum du
    iudicium, qui est la lacune nommée du lecteur ; ici c'est le
    versant de la page de la même absence.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="contentum" genus="textus"/>
    <attributum nomen="in-opere" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="silentium">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="ambiguitas">
    <glossa lingua="en">Ambiguity: the text admits several readings
    and gives the reader no ground to choose among them.</glossa>
    <glossa lingua="fr">L'ambiguïté : le texte admet plusieurs
    lectures et ne donne au lecteur aucun fondement pour choisir
    entre elles.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="contentum" genus="textus"/>
    <attributum nomen="in-opere" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="ambiguitas">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="ambulatio-lectoris">
    <glossa lingua="en">A reader-walk: a test of a document by a
    restricted reader - the reader is confined to the source under
    test, so that the source itself is what gets measured. The
    oracle is not an assertion but the reader's success at a
    stated task.</glossa>
    <glossa lingua="fr">Une marche de lecteur : un test d'un
    document par un lecteur restreint - le lecteur est confiné à
    la source testée, afin que ce soit la source elle-même qui
    soit mesurée. L'oracle n'est pas une assertion mais la
    réussite du lecteur à une tâche donnée.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="lector" genus="referentia"/>
    <attributum nomen="contentum" genus="textus"/>
    <attributum nomen="interrogat" genus="referentia"/>
    <liberum nomen="invenit"/>
    <liberum nomen="exercet"/>
    <liberum nomen="continet"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="invenit" intra="ambulatio-lectoris">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="exercet" intra="ambulatio-lectoris">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="continet" intra="ambulatio-lectoris">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="ambulatio-lectoris">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="status">
    <glossa lingua="en">State: a kept value that can change over time -
    it persists between events and is changed by them. The present
    state is the FOLD of all past changes (the log is the truth, the
    state its projection). It is always carried by some BEARER, and
    its lifetime follows the bearer's.</glossa>
    <glossa lingua="fr">L'état : une valeur gardée qui peut changer
    dans le temps - elle subsiste entre les événements et se trouve
    modifiée par eux. L'état présent est le PLIAGE de toutes les
    modifications passées (le journal est la vérité, l'état sa
    projection). Il est toujours porté par un PORTEUR, et sa durée
    de vie suit celle du porteur.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="durabilitas" genus="electio">
      <optio>ephemera</optio>
      <optio>persistens</optio>
    </attributum>
    <attributum nomen="congruentia" genus="electio">
      <optio>statim</optio>
      <optio>tandem</optio>
    </attributum>
    <attributum nomen="geritur-a" genus="referentia"/>
    <attributum nomen="legitur-a" genus="referentia"/>
    <attributum nomen="mutatur-a" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="status">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="proiectio">
    <glossa lingua="en">A projection: state that can be recomputed in
    full from another state, its TRUTH. Hence the LICENCE TO DELETE -
    erasing a projection loses nothing that cannot be reborn, an
    operational property of the first importance that no syntax
    carries; intention alone declares it.</glossa>
    <glossa lingua="fr">Une projection : un état qui peut être
    entièrement recalculé à partir d'un autre état, sa VÉRITÉ. D'où
    la LICENCE DE SUPPRIMER - effacer une projection ne perd rien qui
    ne puisse renaître, propriété opératoire capitale qu'aucune
    syntaxe ne porte ; seule l'intention la déclare.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="veritas-sua" genus="referentia"/>
    <attributum nomen="durabilitas" genus="electio">
      <optio>ephemera</optio>
      <optio>persistens</optio>
    </attributum>
    <attributum nomen="congruentia" genus="electio">
      <optio>statim</optio>
      <optio>tandem</optio>
    </attributum>
    <attributum nomen="geritur-a" genus="referentia"/>
    <attributum nomen="legitur-a" genus="referentia"/>
    <attributum nomen="mutatur-a" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="proiectio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="artefactum-aedificationis">
    <glossa lingua="en">A build artifact: a projection of the sources
    made by building - the source is the truth, the artifact the
    projection. "make clean" is harmless BECAUSE the artifact is a
    projection; the licence to delete lives in every builder's habits
    and is rarely named.</glossa>
    <glossa lingua="fr">Un artefact de construction : une projection
    des sources produite par la compilation - la source est la
    vérité, l'artefact la projection. « make clean » est inoffensif
    PARCE QUE l'artefact est une projection ; la licence de supprimer
    habite les habitudes de tout constructeur, rarement
    nommée.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="per-instrumentum" genus="referentia"/>
    <attributum nomen="veritas-sua" genus="referentia"/>
    <attributum nomen="durabilitas" genus="electio">
      <optio>ephemera</optio>
      <optio>persistens</optio>
    </attributum>
    <attributum nomen="congruentia" genus="electio">
      <optio>statim</optio>
      <optio>tandem</optio>
    </attributum>
    <attributum nomen="geritur-a" genus="referentia"/>
    <attributum nomen="legitur-a" genus="referentia"/>
    <attributum nomen="mutatur-a" genus="referentia"/>
    <liberum nomen="ex-fontibus"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="ex-fontibus" intra="artefactum-aedificationis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="artefactum-aedificationis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="promptuarium">
    <glossa lingua="en">A cache: a projection kept for speed - a value
    computed once so that it need not be computed again. A corrupted
    cache can be deleted, never repaired: deletion is harmless,
    repair superfluous.</glossa>
    <glossa lingua="fr">Un cache : une projection conservée pour la
    vitesse - une valeur calculée une fois afin de ne pas la
    recalculer. Un cache corrompu peut être supprimé, jamais réparé :
    la suppression est inoffensive, la réparation superflue.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="status-fides" genus="electio">
      <optio>congruens</optio>
      <optio>rancidum</optio>
    </attributum>
    <attributum nomen="veritas-sua" genus="referentia"/>
    <attributum nomen="durabilitas" genus="electio">
      <optio>ephemera</optio>
      <optio>persistens</optio>
    </attributum>
    <attributum nomen="congruentia" genus="electio">
      <optio>statim</optio>
      <optio>tandem</optio>
    </attributum>
    <attributum nomen="geritur-a" genus="referentia"/>
    <attributum nomen="legitur-a" genus="referentia"/>
    <attributum nomen="mutatur-a" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="promptuarium">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="index">
    <glossa lingua="en">An index: a projection arranged for searching -
    the truth does not hold the order the searcher asks for, and the
    index supplies it. ORDER is its essence: the same data, a new
    arrangement.</glossa>
    <glossa lingua="fr">Un index : une projection ordonnée pour la
    recherche - la vérité ne possède pas l'ordre que réclame celui
    qui cherche, et l'index le fournit. L'ORDRE en est l'essence :
    les mêmes données, une disposition nouvelle.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="veritas-sua" genus="referentia"/>
    <attributum nomen="durabilitas" genus="electio">
      <optio>ephemera</optio>
      <optio>persistens</optio>
    </attributum>
    <attributum nomen="congruentia" genus="electio">
      <optio>statim</optio>
      <optio>tandem</optio>
    </attributum>
    <attributum nomen="geritur-a" genus="referentia"/>
    <attributum nomen="legitur-a" genus="referentia"/>
    <attributum nomen="mutatur-a" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="index">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="lectio">
    <glossa lingua="en">A read: the event in which state is observed
    without being altered - the other half of a state's life, since
    change writes it and reading draws its fruit. It leaves no trace
    unless some guard deliberately records it (security regimes
    reify reads too, as an access log).</glossa>
    <glossa lingua="fr">Une lecture : l'événement par lequel un état
    est observé sans être modifié - l'autre moitié de la vie d'un
    état, car la modification l'écrit et la lecture en tire le fruit.
    Elle ne laisse aucune trace, à moins qu'une surveillance ne
    l'enregistre à dessein (les régimes de sécurité réifient aussi
    les lectures, sous forme de journal d'accès).</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="obiectum" genus="referentia"/>
    <attributum nomen="hauritur-a" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="lectio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="mutatio">
    <glossa lingua="en">A change: the event in which state is altered -
    what the log records. Where changes are kept as things in their
    own right, the whole history remains and any state can be
    recomputed by folding them; its species divide by the bearer of
    the state changed - what changes, not how. A change effected
    outside the declared channel is commonly called a "side effect",
    which is a position, not a kind.</glossa>
    <glossa lingua="fr">Une modification : l'événement par lequel un
    état change - ce que le journal enregistre. Là où les
    modifications sont conservées comme des choses à part entière,
    l'histoire entière subsiste et tout état peut être recalculé par
    pliage ; ses espèces se divisent selon le porteur de l'état
    modifié - ce qui change, non comment. Une modification effectuée
    hors du canal déclaré s'appelle communément un « effet de bord »,
    ce qui est une position et non un genre.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="declaratio" genus="electio">
      <optio>apertus</optio>
      <optio>occultus</optio>
    </attributum>
    <attributum nomen="idempotens" genus="veritas"/>
    <attributum nomen="commutativa" genus="veritas"/>
    <attributum nomen="obiectum" genus="referentia"/>
    <attributum nomen="efficitur-a" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="mutatio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="functio">
    <glossa lingua="en">A function: a named subprogram that takes
    parameters, computes, and may return a value, effect changes, or
    draw reads. It is called and it returns - the smallest named unit
    of work a program can repeat.</glossa>
    <glossa lingua="fr">Une fonction : un sous-programme nommé qui
    reçoit des paramètres, calcule, et peut rendre une valeur,
    effectuer des modifications ou puiser des lectures. On l'appelle
    et elle revient - la plus petite unité de travail nommée qu'un
    programme puisse répéter.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="reddit-valorem" genus="veritas"/>
    <attributum nomen="parametra-varia" genus="veritas"/>
    <attributum nomen="mortua" genus="veritas"/>
    <attributum nomen="status-vita" genus="electio">
      <optio>vigens</optio>
      <optio>deprecata</optio>
      <optio>remota</optio>
    </attributum>
    <attributum nomen="reddit" genus="referentia"/>
    <attributum nomen="praebetur-a" genus="referentia"/>
    <liberum nomen="accipit"/>
    <liberum nomen="vocat"/>
    <liberum nomen="legit"/>
    <liberum nomen="mutat"/>
    <liberum nomen="efficit"/>
    <liberum nomen="haurit"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="accipit" intra="functio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="vocat" intra="functio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="legit" intra="functio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="mutat" intra="functio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="efficit" intra="functio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="haurit" intra="functio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="functio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="functio-pura">
    <glossa lingua="en">A pure function: a function with no hidden
    channels - it reads only through its parameters (pointed-to
    memory included, as strlen shows) and makes NO changes at all,
    not even through parameters, so its whole fruit is the returned
    value. The same arguments always yield the same value and a call
    leaves no trace; saying "without side effects" names only half of
    it, since a function that merely reads global state is still not
    pure. Referential transparency follows: a call may be replaced by
    its value.</glossa>
    <glossa lingua="fr">Une fonction pure : une fonction sans canaux
    cachés - elle ne lit que par ses paramètres (mémoire pointée
    comprise, comme le montre strlen) et n'effectue AUCUNE
    modification, pas même par ses paramètres, si bien que tout son
    fruit est la valeur rendue. Les mêmes arguments donnent toujours
    la même valeur et un appel ne laisse aucune trace ; dire « sans
    effets de bord » n'en nomme que la moitié, car une fonction qui
    se borne à lire un état global n'est pas pure pour autant. La
    transparence référentielle s'ensuit : un appel peut être remplacé
    par sa valeur.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="reddit-valorem" genus="veritas"/>
    <attributum nomen="parametra-varia" genus="veritas"/>
    <attributum nomen="mortua" genus="veritas"/>
    <attributum nomen="status-vita" genus="electio">
      <optio>vigens</optio>
      <optio>deprecata</optio>
      <optio>remota</optio>
    </attributum>
    <attributum nomen="reddit" genus="referentia"/>
    <attributum nomen="praebetur-a" genus="referentia"/>
    <liberum nomen="accipit"/>
    <liberum nomen="vocat"/>
    <liberum nomen="legit"/>
    <liberum nomen="mutat"/>
    <liberum nomen="efficit"/>
    <liberum nomen="haurit"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="accipit" intra="functio-pura">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="vocat" intra="functio-pura">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="legit" intra="functio-pura">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="mutat" intra="functio-pura">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="efficit" intra="functio-pura">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="haurit" intra="functio-pura">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="functio-pura">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="constans">
    <glossa lingua="en">A constant: a value whose INTENTION is never to
    change once it has come to be - the opposite of state, which is
    expected to change where this is forbidden to. The kind comes
    from the intention, not from the construct: one and the same
    constant may be dressed as a macro, an enumerator, a qualified
    object, or bare discipline - four garments, one
    constant.</glossa>
    <glossa lingua="fr">Une constante : une valeur dont l'INTENTION est
    de ne jamais changer une fois née - le contraire de l'état, qui
    est censé changer là où celle-ci se l'interdit. Le genre vient de
    l'intention, non du construit : une même constante peut se vêtir
    en macro, en énumérateur, en objet qualifié ou en simple
    discipline - quatre vêtements, une seule constante.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <liberum nomen="realizatur-per"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="realizatur-per" intra="constans">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="constans">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="constans-numerica">
    <glossa lingua="en">A numeric constant: a constant that is a
    quantity, so arithmetic is allowed on it. Left without a name it
    is called a "magic number" - a constant whose intention stayed
    unspoken, and the best known abuse of the kind, because a bare
    number does not carry its own intention.</glossa>
    <glossa lingua="fr">Une constante numérique : une constante qui est
    une quantité, sur laquelle l'arithmétique est permise. Laissée
    sans nom, on l'appelle « nombre magique » - une constante dont
    l'intention est restée tue, et l'abus le plus célèbre du genre,
    car un nombre nu ne porte pas son intention.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <liberum nomen="realizatur-per"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="realizatur-per" intra="constans-numerica">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="constans-numerica">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="constans-textualis">
    <glossa lingua="en">A textual constant: a constant sequence of
    characters, usually meant for a human reader - messages, titles,
    formats.</glossa>
    <glossa lingua="fr">Une constante textuelle : une suite constante
    de caractères, destinée le plus souvent à un lecteur humain -
    messages, titres, formats.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <liberum nomen="realizatur-per"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="realizatur-per" intra="constans-textualis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="constans-textualis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="bibliotheca">
    <glossa lingua="en">A library: a collection of elements -
    functions, constants, types - published for repeated use; it
    offers an interface and hides its body. It differs from a program
    in having no beginning of its own: it lives by being called and
    never runs of its own accord.</glossa>
    <glossa lingua="fr">Une bibliothèque : une collection d'éléments -
    fonctions, constantes, types - publiée pour un usage répété ;
    elle offre une interface et cache son corps. Elle diffère d'un
    programme en ce qu'elle n'a pas de commencement propre : elle vit
    d'être appelée et ne s'exécute jamais d'elle-même.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="scripta-in" genus="referentia"/>
    <liberum nomen="interfacies" maximum="1"/>
    <liberum nomen="corpus" maximum="1"/>
    <liberum nomen="probationes" maximum="1"/>
    <liberum nomen="documenta" maximum="1"/>
    <liberum nomen="praebet"/>
    <liberum nomen="dependet-ex"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="interfacies" intra="bibliotheca">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="corpus" intra="bibliotheca">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="probationes" intra="bibliotheca">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="documenta" intra="bibliotheca">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="praebet" intra="bibliotheca">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="dependet-ex" intra="bibliotheca">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="bibliotheca">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="assertio">
    <glossa lingua="en">An assertion: an executable proposition - a
    claim about the state of the program at a point, which carries
    its own oracle, so that the running program tests it itself. It
    is documentation that cannot lie for long: when false, it cries
    out.</glossa>
    <glossa lingua="fr">Une assertion : une proposition exécutable -
    une affirmation sur l'état du programme en un point, qui porte
    son propre oracle, de sorte que le programme en cours
    d'exécution la vérifie lui-même. C'est une documentation qui ne
    peut mentir longtemps : fausse, elle crie.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="affirmat-de" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="assertio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="commentarium">
    <glossa lingua="en">A comment: the part of the source that the
    language does NOT promise to read - text inside the artifact,
    addressed to readers other than the compiler. Its species divide
    by addressee and intention: to whom it speaks, and about what
    time.</glossa>
    <glossa lingua="fr">Un commentaire : la partie du source que le
    langage ne promet PAS de lire - un texte à l'intérieur de
    l'artefact, adressé à d'autres lecteurs que le compilateur. Ses
    espèces se divisent selon le destinataire et l'intention : à qui
    il parle, et de quel temps.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="commentarium">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="identificator">
    <glossa lingua="en">An identifier: a name whose essence is
    REFERENCE and not meaning - a handle on a thing. What it tries to
    grasp is what Scotus called "haecceity", the very this-ness of a
    thing. Its species divide by the SOURCE of the identity: given or
    derived.</glossa>
    <glossa lingua="fr">Un identifiant : un nom dont l'essence est la
    RÉFÉRENCE et non la signification - une poignée sur une chose. Ce
    qu'il tente de saisir, Duns Scot l'appelait l'« heccéité » : le
    fait, pour une chose, d'être celle-ci et nulle autre. Ses espèces
    se divisent selon la SOURCE de l'identité : donnée ou
    dérivée.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="identificator">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="programma">
    <glossa lingua="en">A program: a collection of elements with a
    BEGINNING OF ITS OWN - once invoked it runs and carries on by
    itself, where a library only lives while it is being called. The
    beginning (main) is not an ornament but the very difference: what
    can begin has a destiny of its own.</glossa>
    <glossa lingua="fr">Un programme : une collection d'éléments dotée
    d'un COMMENCEMENT PROPRE - une fois lancé, il s'exécute et
    poursuit de lui-même, là où une bibliothèque ne vit qu'appelée.
    Le commencement (principale) n'est pas un ornement mais la
    différence même : ce qui peut commencer a son propre
    destin.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="modus-finiendi" genus="electio">
      <optio>terminans</optio>
      <optio>perpetuum</optio>
    </attributum>
    <attributum nomen="interactivum" genus="veritas"/>
    <attributum nomen="initium" genus="referentia"/>
    <attributum nomen="currit-ut" genus="referentia"/>
    <liberum nomen="adhibet"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="adhibet" intra="programma">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="programma">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="instrumentum-aedificationis">
    <glossa lingua="en">A build tool: a program whose purpose is to
    derive build artifacts from sources - it knows the dependency
    graph (what comes from what), and from that graph comes its
    power, since it rebuilds only what changed. It differs from a
    language implementation as a commander differs from a soldier: it
    orders the sequence and entrusts the work itself to
    others.</glossa>
    <glossa lingua="fr">Un outil de construction : un programme dont la
    fin est de dériver les artefacts de construction à partir des
    sources - il connaît le graphe des dépendances (ce qui vient de
    quoi), et c'est de ce graphe que vient sa force, puisqu'il ne
    reconstruit que ce qui a changé. Il diffère d'une implémentation
    de langage comme le chef diffère du soldat : il commande l'ordre
    et confie le travail lui-même à d'autres.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="incrementale" genus="veritas"/>
    <attributum nomen="graphum-unde" genus="electio">
      <optio>declaratum</optio>
      <optio>derivatum</optio>
    </attributum>
    <attributum nomen="dirigitur-a" genus="referentia"/>
    <attributum nomen="modus-finiendi" genus="electio">
      <optio>terminans</optio>
      <optio>perpetuum</optio>
    </attributum>
    <attributum nomen="interactivum" genus="veritas"/>
    <attributum nomen="initium" genus="referentia"/>
    <attributum nomen="currit-ut" genus="referentia"/>
    <liberum nomen="invocat"/>
    <liberum nomen="producit"/>
    <liberum nomen="adhibet"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="invocat" intra="instrumentum-aedificationis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="producit" intra="instrumentum-aedificationis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="adhibet" intra="instrumentum-aedificationis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="instrumentum-aedificationis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="postulatum">
    <glossa lingua="en">A requirement: an intention declared BEFORE
    the work - what must be true for the work to be called complete.
    It is the source of judgement for the others: a defect is
    measured against a requirement, a test interrogates a
    requirement, a capability fulfils one.</glossa>
    <glossa lingua="fr">Une exigence : une intention déclarée AVANT le
    travail - ce qui doit être vrai pour que l'œuvre soit dite
    achevée. Elle est la source du jugement pour les autres : un
    défaut se mesure à une exigence, un test interroge une exigence,
    une capacité en satisfait une.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="contentum" genus="textus"/>
    <attributum nomen="ordo" genus="numerus" minimum="1"/>
    <attributum nomen="status-vita" genus="electio">
      <optio>propositum</optio>
      <optio>receptum</optio>
      <optio>impletum</optio>
      <optio>reiectum</optio>
    </attributum>
    <attributum nomen="impletur-a" genus="referentia"/>
    <attributum nomen="interrogatur-a" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="postulatum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="facultas">
    <glossa lingua="en">A capability: what the work is able to
    deliver, as the user reckons it - the unit of VALUE. A
    requirement is an intention sought; a capability is an intention
    possessed, and it is what the user names when saying what the
    program does.</glossa>
    <glossa lingua="fr">Une capacité : ce que l'œuvre est en mesure de
    fournir, telle que l'utilisateur l'estime - l'unité de VALEUR.
    L'exigence est une intention demandée ; la capacité est une
    intention possédée, et c'est elle que l'utilisateur nomme
    lorsqu'il raconte ce que le programme fait.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="contentum" genus="textus"/>
    <liberum nomen="implet"/>
    <liberum nomen="realizata-a"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="implet" intra="facultas">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="realizata-a" intra="facultas">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="facultas">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="probatio">
    <glossa lingua="en">A test: an executable interrogation of an
    intention - a stage prepared, an action exercised, a result set
    against the expectation. It is a vessel of assertions: a test
    holds the assertions by which it judges (in this house, the
    credo library).</glossa>
    <glossa lingua="fr">Un test : une interrogation exécutable de
    l'intention - une scène préparée, une action exercée, un
    résultat confronté à l'attente. C'est un vase d'assertions : le
    test contient les assertions par lesquelles il juge (dans cette
    maison, la bibliothèque credo).</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="contentum" genus="textus"/>
    <attributum nomen="interrogat" genus="referentia"/>
    <liberum nomen="continet"/>
    <liberum nomen="exercet"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="continet" intra="probatio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="exercet" intra="probatio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="probatio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="vitium">
    <glossa lingua="en">A defect: the discrepancy between intention
    and behaviour - the program does what was written, not what was
    wanted, and the defect lives in that gap. Behaviour by itself
    cannot be defective: a defect demands a relation to an intention
    (a requirement, an assertion, an expectation), and without one
    there is only "behaviour".</glossa>
    <glossa lingua="fr">Un défaut : l'écart entre l'intention et le
    comportement - le programme fait ce qui a été écrit, non ce qui
    a été voulu, et le défaut habite cet intervalle. Le comportement
    seul ne peut être défectueux : le défaut exige une relation à
    une intention (une exigence, une assertion, une attente), et
    sans elle il n'y a que du « comportement ».</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="contentum" genus="textus"/>
    <attributum nomen="gravitas" genus="electio">
      <optio>levis</optio>
      <optio>gravis</optio>
    </attributum>
    <attributum nomen="status-vita" genus="electio">
      <optio>relatum_est</optio>
      <optio>confirmatum</optio>
      <optio>sanatum</optio>
      <optio>clausum</optio>
      <optio>non_reproductum</optio>
      <optio>non_sanandum</optio>
    </attributum>
    <attributum nomen="violat" genus="referentia"/>
    <attributum nomen="habitat-in" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="vitium">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="debitum-technicum">
    <glossa lingua="en">Technical debt: an imperfection in the work
    taken on DELIBERATELY so that something may be delivered sooner,
    with knowledge of the later price - not a failing but a TRADE,
    value drawn now against a price to be paid afterwards. The
    monetary metaphor therefore carries: debt is not a fault but an
    instrument, and as in money matters there is such a thing as
    good debt and bad debt.</glossa>
    <glossa lingua="fr">Une dette technique : une imperfection
    assumée DÉLIBÉRÉMENT dans l'œuvre afin de livrer quelque chose
    plus tôt, en connaissance du prix ultérieur - non un manquement
    mais un ÉCHANGE, une valeur prise maintenant contre un prix à
    payer plus tard. La métaphore monétaire porte donc : la dette
    n'est pas une faute mais un instrument, et comme en matière
    d'argent il existe de bonnes et de mauvaises dettes.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="usura" genus="textus"/>
    <attributum nomen="consulta" genus="veritas"/>
    <attributum nomen="status-cursus" genus="electio">
      <optio>susceptum</optio>
      <optio>servitum</optio>
      <optio>solutum</optio>
      <optio>remissum</optio>
    </attributum>
    <attributum nomen="asseritur-per" genus="referentia"/>
    <attributum nomen="inhaeret" genus="referentia"/>
    <liberum nomen="emit"/>
    <liberum nomen="solvitur-per"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="emit" intra="debitum-technicum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="solvitur-per" intra="debitum-technicum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="debitum-technicum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="complicatio">
    <glossa lingua="en">A complication: a consideration of
    implementation that CANNOT be foreseen in planning but appears
    only once the work has been begun, and that may force the plan
    to be withdrawn. Not a failure of planning but its LIMIT: some
    things are learned only by doing. The whole use of the term
    rests on NOT FORESEEN against NOT FORESEEABLE - negligence could
    have been foreseen and was not, which better planning cures,
    while a complication could not have been foreseen at all, and
    more planning would have availed nothing.</glossa>
    <glossa lingua="fr">Une complication : une considération
    d'implémentation qui NE PEUT être prévue lors de la
    planification et n'apparaît qu'une fois le travail commencé, et
    qui peut contraindre à retirer le plan. Non un défaut de la
    planification mais sa LIMITE : certaines choses ne s'apprennent
    qu'en faisant. Toute l'utilité du terme tient à la distinction
    entre NON PRÉVU et NON PRÉVISIBLE - la négligence pouvait être
    prévue et ne l'a pas été, ce que corrige un meilleur plan, alors
    que la complication ne pouvait aucunement être prévue, et plus
    de planification n'y eût servi de rien.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="praevidenda" genus="veritas"/>
    <attributum nomen="effectus-in-consilium" genus="electio">
      <optio>nullus</optio>
      <optio>localis</optio>
      <optio>consilium_retractandum</optio>
      <optio>consilium_irritum</optio>
    </attributum>
    <attributum nomen="status-cursus" genus="electio">
      <optio>latens</optio>
      <optio>aperta</optio>
      <optio>absorpta</optio>
      <optio>consilio_mutato</optio>
    </attributum>
    <attributum nomen="aperitur-in" genus="referentia"/>
    <attributum nomen="retractat" genus="referentia"/>
    <attributum nomen="asseritur-per" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="complicatio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="consilium">
    <glossa lingua="en">A plan: a proposed ordering of works toward an
    end to be sought ONCE - what will be done in what order, what is
    committed to whom, what must stand before what. It speaks of the
    future and is therefore always provisional: a plan that cannot
    be changed is not a plan but a binding. It differs from a
    prescription by ITERATION, since a prescription lives by being
    repeated while a plan dies once completed or withdrawn, and from
    a requirement in MODE, since a requirement says what must be
    true and is silent about order whereas a plan professes the
    order itself.</glossa>
    <glossa lingua="fr">Un plan : un ordre de travaux proposé en vue
    d'une fin à poursuivre UNE SEULE FOIS - ce qui sera fait et dans
    quel ordre, ce qui est confié à qui, ce qui doit précéder quoi.
    Il parle de l'avenir et demeure donc toujours provisoire : un
    plan qui ne peut être modifié n'est pas un plan mais un lien. Il
    diffère de la prescription par l'ITÉRATION, car la prescription
    vit de se répéter tandis que le plan meurt une fois achevé ou
    retiré, et de l'exigence par le MODE, car l'exigence dit ce qui
    doit être vrai et se tait sur l'ordre, alors que le plan
    professe l'ordre lui-même.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="horizon" genus="electio">
      <optio>operis</optio>
      <optio>editionis</optio>
      <optio>anni</optio>
      <optio>ultra</optio>
    </attributum>
    <attributum nomen="status-cursus" genus="electio">
      <optio>propositum</optio>
      <optio>susceptum</optio>
      <optio>perfectum</optio>
      <optio>retractatum</optio>
      <optio>derelictum</optio>
    </attributum>
    <attributum nomen="retractatur-a" genus="referentia"/>
    <liberum nomen="ordinat"/>
    <liberum nomen="ad-postulata"/>
    <liberum nomen="exsequitur-per"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="ordinat" intra="consilium">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="ad-postulata" intra="consilium">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="exsequitur-per" intra="consilium">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="consilium">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="depravatio">
    <glossa lingua="en">Corruption of state: the state of a thing
    become other than it ought to have been, whether or not anyone
    notices - not a failure in the making (that is a defect), nor a
    failure on show (that is an incident), but THE THING ITSELF
    already gone wrong. It HIDES by its very nature: a defect can be
    read in the code and an incident cries out, but corruption is
    silent, since bad data sits as neatly as good and nothing in it
    gives it away. It is therefore the only one of the three that
    must be SOUGHT: no one finds it who does not look for it, and
    usually one looks only after an incident has betrayed it.</glossa>
    <glossa lingua="fr">Une corruption d'état : l'état d'une chose
    devenu autre qu'il n'aurait dû être, que quelqu'un s'en aperçoive
    ou non - non un défaut dans la fabrication (c'est le défaut), ni
    une défaillance visible (c'est l'incident), mais LA CHOSE
    ELLE-MÊME déjà faussée. Elle SE CACHE par nature : le défaut se
    lit dans le code et l'incident crie, mais la corruption se tait,
    car une donnée fausse s'installe aussi bien qu'une donnée juste
    et rien en elle ne la trahit. Elle est donc la seule des trois
    qu'il faille CHERCHER : nul ne la trouve s'il ne la cherche, et
    l'on ne la cherche d'ordinaire qu'après qu'un incident l'a
    dénoncée.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="ambitus" genus="textus"/>
    <attributum nomen="fenestra" genus="textus"/>
    <attributum nomen="sanabilis" genus="electio">
      <optio>recomputabilis</optio>
      <optio>manu_sananda</optio>
      <optio>insanabilis</optio>
    </attributum>
    <attributum nomen="propagata" genus="veritas"/>
    <attributum nomen="repugnans" genus="veritas"/>
    <attributum nomen="status-cognitio" genus="electio">
      <optio>latens</optio>
      <optio>detecta</optio>
      <optio>circumscripta</optio>
      <optio>sanata</optio>
      <optio>tolerata</optio>
    </attributum>
    <attributum nomen="ex-vitio" genus="referentia"/>
    <attributum nomen="detecta-per" genus="referentia"/>
    <liberum nomen="prodita-per"/>
    <liberum nomen="afficit"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="prodita-per" intra="depravatio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="afficit" intra="depravatio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="depravatio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="interventio">
    <glossa lingua="en">An intervention: an act undertaken upon a
    thing that already exists, so that it may be preserved, healed
    or bettered - not making (nothing new comes to be) nor damage
    (nothing is harmed on purpose) but the ALTERATION OF A THING
    BELONGING TO ANOTHER TIME, which both the past and the future
    judge. It is done to a thing YOU DID NOT MAKE, and before
    successors who will know more. Hence the three conditions that
    divide this kind from every other work - reversibility,
    minimality, distinguishability - none of which flows from the
    purpose of the work but from the CONDITION OF THE AGENT, namely
    that the agent passes and the thing remains.</glossa>
    <glossa lingua="fr">Une intervention : un acte entrepris sur une
    chose déjà existante afin qu'elle soit conservée, réparée ou
    améliorée - non une fabrication (rien de nouveau ne naît) ni un
    dommage (rien n'est lésé à dessein) mais la MODIFICATION D'UNE
    CHOSE APPARTENANT À UN AUTRE TEMPS, que jugent à la fois le
    passé et l'avenir. Elle s'exerce sur une chose QUE L'ON N'A PAS
    FAITE, et devant des successeurs qui en sauront davantage. De là
    les trois conditions qui séparent ce genre de tout autre travail
    - réversibilité, minimalité, distinguibilité - dont aucune ne
    découle de la fin de l'ouvrage mais de la CONDITION DE L'AGENT,
    à savoir que l'agent est passager et que la chose
    demeure.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="reversibilis" genus="veritas"/>
    <attributum nomen="minima" genus="veritas"/>
    <attributum nomen="distinguibilis" genus="veritas"/>
    <attributum nomen="documentata" genus="veritas"/>
    <attributum nomen="status-cursus" genus="electio">
      <optio>proposita</optio>
      <optio>approbata</optio>
      <optio>perfecta</optio>
      <optio>revocata</optio>
    </attributum>
    <attributum nomen="in-rem" genus="referentia"/>
    <attributum nomen="propter" genus="referentia"/>
    <attributum nomen="agens" genus="referentia"/>
    <attributum nomen="acta-sua" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="interventio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="forma-datorum">
    <glossa lingua="en">A data structure: a shape for arranging data
    defined by its OPERATIONS rather than by its implementation -
    what you may ask of it, what is promised, and at what cost. The
    essence lives in the interface (what is called an abstract data
    type); the implementation beneath it changes freely so long as
    the promises hold.</glossa>
    <glossa lingua="fr">Une structure de données : une figure pour
    ordonner les données, définie par ses OPÉRATIONS et non par son
    implémentation - ce que l'on peut lui demander, ce qui est
    promis, et à quel prix. L'essence habite l'interface (ce qu'on
    appelle un type de données abstrait) ; l'implémentation qui se
    trouve dessous change librement tant que les promesses
    tiennent.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <liberum nomen="realizata-a"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="realizata-a" intra="forma-datorum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="forma-datorum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="schema-identificandi">
    <glossa lingua="en">An identification scheme: an established way
    of assigning names to things, such that one name designates one
    thing within its scope - a defined structure, an administering
    authority, rules for assignment. It is not the identifier
    itself but the FORM of identifiers: ISBN is a scheme,
    "978-0-13-110362-7" is an identifier.</glossa>
    <glossa lingua="fr">Un schéma d'identification : une manière
    instituée d'assigner des noms aux choses, de sorte qu'un seul
    nom désigne une seule chose dans son domaine - une structure
    définie, une autorité administrante, des règles d'assignation.
    Ce n'est pas l'identifiant lui-même mais la FORME des
    identifiants : l'ISBN est un schéma, « 978-0-13-110362-7 » est
    un identifiant.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="quid-designat" genus="textus"/>
    <attributum nomen="opacus" genus="veritas"/>
    <attributum nomen="reassignabilis" genus="veritas"/>
    <attributum nomen="probabilis-solus" genus="veritas"/>
    <attributum nomen="longitudo-fixa" genus="veritas"/>
    <attributum nomen="praesentatio" genus="textus"/>
    <attributum nomen="status-vigor" genus="electio">
      <optio>vigens</optio>
      <optio>clausa</optio>
      <optio>obsoleta</optio>
    </attributum>
    <attributum nomen="administrata-a" genus="referentia"/>
    <attributum nomen="normata-per" genus="referentia"/>
    <attributum nomen="gignit" genus="referentia"/>
    <attributum nomen="successit" genus="referentia"/>
    <liberum nomen="praefixum" maximum="1"/>
    <liberum nomen="corpus-identificatoris" maximum="1"/>
    <liberum nomen="nota-custos" maximum="1"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="praefixum" intra="schema-identificandi">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="corpus-identificatoris" intra="schema-identificandi">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="nota-custos" intra="schema-identificandi">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="historia" intra="schema-identificandi">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="gradus-assensus">
    <glossa lingua="en">Degree of assent: how firmly the mind adheres
    to a proposition. It concerns not the thing itself but the
    ADHERENCE - the same proposition is known by one person,
    believed by another, suspected by a third. The degree is
    therefore a property of the judgement, not of the thing.</glossa>
    <glossa lingua="fr">Degré d'assentiment : avec quelle fermeté
    l'esprit adhère à une proposition. Il ne s'agit pas de la chose
    elle-même mais de l'ADHÉSION - la même proposition est sue par
    l'un, crue par l'autre, soupçonnée par un troisième. Le degré
    est donc une propriété du jugement, non de la chose.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="gradus-assensus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="fons">
    <glossa lingua="en">A source: that from which a proposition was
    received - a work, a measurement, a witness, an institutional
    corpus. A source does not prove a proposition true; it says
    where the proposition came from, which is a different thing and
    often more useful, since a named source can be verified and a
    concealed one never can.</glossa>
    <glossa lingua="fr">Une source : ce dont une proposition a été
    reçue - un ouvrage, une mesure, un témoin, un corpus
    institutionnel. La source ne prouve pas qu'une proposition soit
    vraie ; elle dit d'où celle-ci vient, ce qui est autre chose et
    souvent plus utile, car une source nommée peut être vérifiée et
    une source cachée jamais.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="clavis" genus="textus"/>
    <attributum nomen="verificatus" genus="veritas"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="fons">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="observatio">
    <glossa lingua="en">An observation: notice of a particular thing
    received, able to ground a judgement - what is seen, what is
    felt, what is measured. It differs from a judgement because it
    AFFIRMS nothing beyond what appears: "fever 38.5" is an
    observation, "she has pneumonia" is a judgement.</glossa>
    <glossa lingua="fr">Une observation : la notice d'une chose
    singulière reçue, capable de fonder un jugement - ce qui est vu,
    ce qui est ressenti, ce qui est mesuré. Elle diffère du jugement
    parce qu'elle n'AFFIRME rien au-delà de ce qui apparaît :
    « fièvre 38,5 » est une observation, « elle a une pneumonie »
    est un jugement.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="facta" genus="dies"/>
    <attributum nomen="verificabilis-ab-alio" genus="veritas"/>
    <attributum nomen="de" genus="referentia"/>
    <attributum nomen="ex-fonte" genus="referentia"/>
    <attributum nomen="fundat" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="observatio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="iudicium">
    <glossa lingua="en">A judgement: a proposition about a thing that
    someone holds, with an author, a moment, a ground and a degree
    of assent. It is distinguished from a FACT - a fact either is or
    is not, whereas a judgement HAPPENS, and its having happened
    stays certain even if its content is false. This is why records
    preserve mistaken judgements: what was judged is part of the
    history.</glossa>
    <glossa lingua="fr">Un jugement : une proposition sur une chose
    que quelqu'un tient, avec un auteur, un moment, un fondement et
    un degré d'assentiment. Il se distingue du FAIT - un fait est ou
    n'est pas, tandis qu'un jugement ARRIVE, et le fait qu'il soit
    arrivé demeure certain même si son contenu est faux. C'est
    pourquoi les archives conservent les jugements erronés : ce qui
    a été jugé fait partie de l'histoire.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="contentum" genus="textus"/>
    <attributum nomen="latum" genus="dies"/>
    <attributum nomen="status-vita" genus="electio">
      <optio>latum</optio>
      <optio>confirmatum</optio>
      <optio>revisum</optio>
      <optio>retractatum</optio>
    </attributum>
    <attributum nomen="auctor" genus="referentia"/>
    <attributum nomen="de" genus="referentia"/>
    <attributum nomen="assensus" genus="referentia"/>
    <attributum nomen="superat" genus="referentia"/>
    <liberum nomen="fundatur-in"/>
    <liberum nomen="ex-fonte"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="fundatur-in" intra="iudicium">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="ex-fonte" intra="iudicium">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="iudicium">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="annotatio">
    <glossa lingua="en">A machine-proved proposition: proved by an
    instrument running outside the program - no assent, no
    revision by persuasion; against its rule it stands or falls.
    Its authority is transitive, flowing through the rule and
    through the instrument's maker - the machine is the proximate
    prover, never the author.</glossa>
    <glossa lingua="fr">Une proposition prouvée par machine : prouvée
    par un instrument hors du programme - sans assentiment, sans
    révision par persuasion ; devant sa règle elle tient ou tombe.
    Son autorité est transitive, coulant par la règle et par
    l'artisan de l'instrument - la machine est le prouveur
    prochain, jamais l'auteur.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="contentum" genus="textus"/>
    <attributum nomen="de" genus="referentia"/>
    <attributum nomen="probator" genus="referentia"/>
    <attributum nomen="ex-regula" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="annotatio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="periculum">
    <glossa lingua="en">A risk: a harm that can happen and is not
    certain - a kind of judgement about the future, but a DOUBLE
    one, since it consists of probability and gravity at once. It
    therefore cannot be stated as a single number without lying:
    what happens rarely but ruins everything and what happens often
    but harms little are not the same risk, even when the product is
    the same.</glossa>
    <glossa lingua="fr">Un risque : un dommage qui peut arriver sans
    être certain - une espèce de jugement sur l'avenir, mais un
    jugement DOUBLE, car il consiste à la fois en une probabilité et
    en une gravité. On ne peut donc l'énoncer par un seul nombre
    sans mentir : ce qui arrive rarement mais ruine tout et ce qui
    arrive souvent mais nuit peu ne sont pas le même risque, même
    lorsque le produit est identique.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="probabilitas" genus="numerus" fractio="verum" minimum="0" maximum="1"/>
    <attributum nomen="gravitas" genus="electio">
      <optio>levis</optio>
      <optio>gravis</optio>
      <optio>exitialis</optio>
    </attributum>
    <attributum nomen="minatur" genus="referentia"/>
    <attributum nomen="transfertur-per" genus="referentia"/>
    <liberum nomen="minuitur-per"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="minuitur-per" intra="periculum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="periculum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="ignotum">
    <glossa lingua="en">An unknown: an absence of knowledge
    ACKNOWLEDGED and named - a gap that can be handled precisely
    because it has been named. Not plain ignorance, which posits
    nothing, but ignorance turned into a thing: something that can
    be inquired into, assigned, counted and resolved.</glossa>
    <glossa lingua="fr">Un inconnu : une absence de connaissance
    RECONNUE et nommée - une lacune que l'on peut traiter justement
    parce qu'elle a été nommée. Non pas l'ignorance simple, qui ne
    pose rien, mais l'ignorance convertie en chose : ce sur quoi on
    peut enquêter, ce que l'on peut assigner, dénombrer et
    résoudre.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="quaestio" genus="textus"/>
    <attributum nomen="impediens" genus="veritas"/>
    <attributum nomen="status-cursus" genus="electio">
      <optio>agnitum</optio>
      <optio>quaesitum</optio>
      <optio>solutum</optio>
      <optio>relictum</optio>
      <optio>insolubile</optio>
    </attributum>
    <attributum nomen="de" genus="referentia"/>
    <attributum nomen="agnitum-per" genus="referentia"/>
    <liberum nomen="impedit"/>
    <liberum nomen="solvitur-per"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="impedit" intra="ignotum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="solvitur-per" intra="ignotum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="ignotum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="investigatio">
    <glossa lingua="en">An investigation: an ordered inquiry into the
    causes of an event, producing judgements about those causes. It
    differs from an observation because it CONCLUDES, and from a
    simple judgement because it proceeds by method and gathers
    testimony before concluding.</glossa>
    <glossa lingua="fr">Une enquête : une recherche ordonnée sur les
    causes d'un événement, qui produit des jugements sur ces causes.
    Elle diffère de l'observation parce qu'elle CONCLUT, et du
    simple jugement parce qu'elle procède par méthode et recueille
    les témoignages avant de conclure.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="finis" genus="electio">
      <optio>praeventio</optio>
      <optio>attributio_culpae</optio>
      <optio>uterque</optio>
    </attributum>
    <attributum nomen="status-cursus" genus="electio">
      <optio>aperta</optio>
      <optio>colligens</optio>
      <optio>concludens</optio>
      <optio>relata</optio>
      <optio>suspensa</optio>
    </attributum>
    <attributum nomen="de" genus="referentia"/>
    <liberum nomen="colligit"/>
    <liberum nomen="producit"/>
    <liberum nomen="invenit"/>
    <liberum nomen="parit"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="colligit" intra="investigatio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="producit" intra="investigatio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="invenit" intra="investigatio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="parit" intra="investigatio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="investigatio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="secretum">
    <glossa lingua="en">A secret: a thing whose usefulness consists in
    the fact that few know it - once divulged it is neither
    corrupted nor destroyed but STRIPPED OF ITS OFFICE, remaining
    whole and made useless. Its life runs ONE WAY, and that defines
    the kind: no action makes a divulged secret secret again. Other
    things can be repaired; a secret is not repaired but REPLACED,
    and the replacement is another thing, not the same one
    restored.</glossa>
    <glossa lingua="fr">Un secret : une chose dont l'utilité consiste
    en ce que peu de gens la connaissent - divulguée, elle n'est ni
    corrompue ni détruite mais DÉPOUILLÉE DE SA FONCTION, demeurant
    entière et devenue inutile. Sa vie est à SENS UNIQUE, et cela
    définit le genre : aucune action ne rend secret un secret
    divulgué. Les autres choses se réparent ; un secret ne se répare
    pas mais se REMPLACE, et le remplaçant est autre chose, non le
    même restitué.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="numerus-scientium" genus="numerus"/>
    <attributum nomen="substituibile" genus="veritas"/>
    <attributum nomen="valor-temporarius" genus="veritas"/>
    <attributum nomen="status-custodia" genus="electio">
      <optio>custoditum</optio>
      <optio>suspectum</optio>
      <optio>compromissum</optio>
      <optio>emeritum</optio>
    </attributum>
    <attributum nomen="substituit" genus="referentia"/>
    <liberum nomen="scitur-a"/>
    <liberum nomen="custodia-obligat"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="scitur-a" intra="secretum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="custodia-obligat" intra="secretum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="secretum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="peritia-communis">
    <glossa lingua="en">Common expertise: a knowledge or skill that
    resides in the community as a whole and is complete in no single
    member - it is handed on by taking part, not by teaching alone,
    and it perishes when the group is dissolved even though no one
    has forgotten it. THE BEARER IS THE GROUP, not the member, so
    its proper way of dying is not forgetfulness but DISCONTINUITY:
    members can be replaced one at a time and the expertise
    survives, replaced all at once and it is gone. The loss is
    therefore measured not by how many were lost but by how many
    were lost at the same time.</glossa>
    <glossa lingua="fr">Un savoir-faire collectif : une connaissance
    ou un art qui réside dans la communauté entière et n'est complet
    en aucun de ses membres - il se transmet par la participation,
    non par le seul enseignement, et il périt lorsque le groupe se
    dissout même si personne ne l'a oublié. LE PORTEUR EST LE
    GROUPE, non le membre ; sa manière propre de mourir n'est donc
    pas l'oubli mais la DISCONTINUITÉ : on peut remplacer les
    membres un à un sans perdre le savoir, tous à la fois et il
    disparaît. Le dommage se mesure donc non au nombre des perdus
    mais au nombre de ceux qui furent perdus en même temps.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="modus-traditionis" genus="electio">
      <optio>participatione</optio>
      <optio>institutione</optio>
      <optio>utroque</optio>
    </attributum>
    <attributum nomen="scribi-potest" genus="veritas"/>
    <attributum nomen="tempus-restituendi" genus="textus"/>
    <attributum nomen="status-vita" genus="electio">
      <optio>vigens</optio>
      <optio>attenuata</optio>
      <optio>amissa</optio>
      <optio>restituta</optio>
    </attributum>
    <attributum nomen="residet-in" genus="referentia"/>
    <attributum nomen="de" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="peritia-communis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="attributio">
    <glossa lingua="en">An attribution: a judgement - a proposition
    held by someone, with author, moment and degree of assent -
    about WHO MADE a work. It uses two measures at once: how firmly
    it is held (certainty, as in every judgement) and how far the
    named author was present to the work (proximity, proper to this
    kind). Two things that ordinary speech confuses into a single
    "perhaps".</glossa>
    <glossa lingua="fr">Une attribution : un jugement - une
    proposition tenue par quelqu'un, avec auteur, moment et degré
    d'assentiment - sur QUI A FAIT une œuvre. Elle emploie deux
    mesures à la fois : la fermeté avec laquelle on la tient (la
    certitude, comme pour tout jugement) et la part que la main de
    l'auteur nommé a prise à l'œuvre (la proximité, propre à ce
    genre). Deux choses que le langage courant confond en un seul
    « peut-être ».</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="propinquitas" genus="electio">
      <optio>manu_ipsius</optio>
      <optio>cum_adiutoribus</optio>
      <optio>officinae</optio>
      <optio>circuli</optio>
      <optio>sectatoris</optio>
      <optio>post_eum</optio>
      <optio>in_modo_eius</optio>
    </attributum>
    <attributum nomen="de-opere" genus="referentia"/>
    <attributum nomen="ad-auctorem" genus="referentia"/>
    <attributum nomen="contentum" genus="textus"/>
    <attributum nomen="latum" genus="dies"/>
    <attributum nomen="status-vita" genus="electio">
      <optio>latum</optio>
      <optio>confirmatum</optio>
      <optio>revisum</optio>
      <optio>retractatum</optio>
    </attributum>
    <attributum nomen="auctor" genus="referentia"/>
    <attributum nomen="de" genus="referentia"/>
    <attributum nomen="assensus" genus="referentia"/>
    <attributum nomen="superat" genus="referentia"/>
    <liberum nomen="fundamentum-attributionis"/>
    <liberum nomen="fundatur-in"/>
    <liberum nomen="ex-fonte"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="fundamentum-attributionis" intra="attributio" textus="verum"/>
  <elementum nomen="fundatur-in" intra="attributio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="ex-fonte" intra="attributio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="attributio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="fundamentum">
    <glossa lingua="en">A ground: that on which a proposition rests -
    not where it was received from (that is the source), nor how
    firmly it is held (that is the degree of assent), but WHAT KIND
    OF THING SUSTAINS IT. A fourth and distinct axis for qualifying
    a claim, free of the other three: a proposition resting on
    firsthand sight may be held hesitantly, and a conjecture most
    firmly of all.</glossa>
    <glossa lingua="fr">Un fondement : ce sur quoi une proposition
    s'appuie - non pas d'où elle a été reçue (c'est la source), ni
    avec quelle fermeté on la tient (c'est le degré d'assentiment),
    mais QUELLE EST LA NATURE DE CE QUI LA SOUTIENT. Un quatrième
    axe, distinct, pour qualifier une assertion, libre des trois
    autres : une proposition fondée sur la vue directe peut être
    tenue avec hésitation, et une conjecture avec la plus grande
    fermeté.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="verificabile-ab-alio" genus="veritas"/>
    <attributum nomen="repetibile" genus="veritas"/>
    <attributum nomen="sustinet" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="fundamentum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="lingua-programmandi">
    <glossa lingua="en">A programming language: a formal system of
    signs for expressing computations, with a defined grammar and a
    prescribed semantics (more or less strictly). It is distinct
    from its IMPLEMENTATIONS - the language is the form, while a
    compiler or interpreter is the thing that carries the form out.
    Many implementations, one language; editions pass by VERSIONS
    while the identity remains.</glossa>
    <glossa lingua="fr">Un langage de programmation : un système formel
    de signes pour exprimer des calculs, à la grammaire définie et à
    la sémantique prescrite (plus ou moins strictement). Il se
    distingue de ses IMPLÉMENTATIONS - le langage est la forme,
    tandis qu'un compilateur ou un interpréteur est la chose qui
    exécute cette forme. Plusieurs implémentations, un seul langage ;
    les éditions passent par des VERSIONS, l'identité
    demeurant.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="typatio-tempus" genus="electio">
      <optio>statica</optio>
      <optio>dynamica</optio>
      <optio>mixta</optio>
    </attributum>
    <attributum nomen="typatio-vis" genus="electio">
      <optio>fortis</optio>
      <optio>debilis</optio>
    </attributum>
    <attributum nomen="gestio-memoriae" genus="electio">
      <optio>manualis</optio>
      <optio>collecta</optio>
      <optio>per_possessionem</optio>
      <optio>mixta</optio>
    </attributum>
    <attributum nomen="completa-turing" genus="veritas"/>
    <attributum nomen="status-vita" genus="electio">
      <optio>nascens</optio>
      <optio>vigens</optio>
      <optio>senescens</optio>
      <optio>derelicta</optio>
    </attributum>
    <attributum nomen="orta-ex" genus="referentia"/>
    <attributum nomen="habet-versionem" genus="referentia"/>
    <attributum nomen="implementata-ab" genus="referentia"/>
    <attributum nomen="normata-per" genus="referentia"/>
    <attributum nomen="fons-scriptus-in" genus="referentia"/>
    <liberum nomen="paradigmata"/>
    <liberum nomen="auctor"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="paradigmata" intra="lingua-programmandi" textus="verum"/>
  <elementum nomen="auctor" intra="lingua-programmandi">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="lingua-programmandi">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="lingua-iussuum">
    <glossa lingua="en">A command language: a programming language
    whose first word calls an EXTERNAL PROCESS rather than a
    function of its own. It is born for issuing commands
    (interactive) and becomes scriptable afterwards; pipes,
    redirection, and textual expansion come before all else.</glossa>
    <glossa lingua="fr">Un langage de commandes : un langage de
    programmation dont le premier mot appelle un PROCESSUS EXTERNE
    plutôt qu'une fonction propre. Il naît pour donner des ordres
    (de façon interactive) et devient scriptable ensuite ; les
    tubes, la redirection et l'expansion textuelle passent avant
    tout le reste.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="typatio-tempus" genus="electio">
      <optio>statica</optio>
      <optio>dynamica</optio>
      <optio>mixta</optio>
    </attributum>
    <attributum nomen="typatio-vis" genus="electio">
      <optio>fortis</optio>
      <optio>debilis</optio>
    </attributum>
    <attributum nomen="gestio-memoriae" genus="electio">
      <optio>manualis</optio>
      <optio>collecta</optio>
      <optio>per_possessionem</optio>
      <optio>mixta</optio>
    </attributum>
    <attributum nomen="completa-turing" genus="veritas"/>
    <attributum nomen="status-vita" genus="electio">
      <optio>nascens</optio>
      <optio>vigens</optio>
      <optio>senescens</optio>
      <optio>derelicta</optio>
    </attributum>
    <attributum nomen="orta-ex" genus="referentia"/>
    <attributum nomen="habet-versionem" genus="referentia"/>
    <attributum nomen="implementata-ab" genus="referentia"/>
    <attributum nomen="normata-per" genus="referentia"/>
    <attributum nomen="fons-scriptus-in" genus="referentia"/>
    <liberum nomen="paradigmata"/>
    <liberum nomen="auctor"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="paradigmata" intra="lingua-iussuum" textus="verum"/>
  <elementum nomen="auctor" intra="lingua-iussuum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="lingua-iussuum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="versio-linguae">
    <glossa lingua="en">A language version: a named and citable edition
    of a language - the event of release turned into a thing. A
    source file is written in a VERSION ("this is c89"), while the
    language keeps its identity across versions.</glossa>
    <glossa lingua="fr">Une version de langage : une édition nommée et
    citable d'un langage - l'événement de publication converti en
    chose. Un fichier source s'écrit dans une VERSION (« ceci est du
    c89 »), tandis que le langage garde son identité à travers les
    versions.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="titulus" genus="textus"/>
    <attributum nomen="edita" genus="dies"/>
    <attributum nomen="versio-de" genus="referentia"/>
    <attributum nomen="sequitur" genus="referentia"/>
    <attributum nomen="normata-per" genus="referentia"/>
    <attributum nomen="schema-numerandi" genus="electio">
      <optio>semanticum</optio>
      <optio>sequentiale</optio>
      <optio>temporale</optio>
      <optio>nominale</optio>
      <optio>mixtum</optio>
    </attributum>
    <attributum nomen="retro-compatibilis" genus="veritas"/>
    <attributum nomen="mutationes-fractoriae" genus="textus"/>
    <attributum nomen="status-sustentatio" genus="electio">
      <optio>praenuntiata</optio>
      <optio>vigens</optio>
      <optio>sustentata</optio>
      <optio>deprecata</optio>
      <optio>derelicta</optio>
    </attributum>
    <attributum nomen="asseritur-per" genus="referentia"/>
    <attributum nomen="edita-a" genus="referentia"/>
    <liberum nomen="compatibilis-cum"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="compatibilis-cum" intra="versio-linguae">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="versio-linguae">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="implementatio-linguae">
    <glossa lingua="en">A language implementation: the program that
    carries a language out - a compiler, an interpreter, or a
    mixture of the two. It is a concrete thing with its own authors,
    history, and faults: one language, many implementations, each
    with a character of its own (added memory safety, speed, the
    ports it has been given).</glossa>
    <glossa lingua="fr">Une implémentation de langage : le programme
    qui exécute un langage - compilateur, interpréteur, ou mélange
    des deux. C'est une chose concrète, avec ses auteurs, son
    histoire et ses défauts : un seul langage, de multiples
    implémentations, chacune avec un caractère propre (protection
    mémoire ajoutée, rapidité, portages).</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="modus-exsecutionis" genus="electio">
      <optio>compilans</optio>
      <optio>interpretans</optio>
      <optio>mixtus</optio>
    </attributum>
    <attributum nomen="tutela-memoriae-addita" genus="veritas"/>
    <attributum nomen="implementat" genus="referentia"/>
    <attributum nomen="implementat-versionem" genus="referentia"/>
    <attributum nomen="scripta-in" genus="referentia"/>
    <liberum nomen="auctor"/>
    <liberum nomen="emittit-pro"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="auctor" intra="implementatio-linguae">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="emittit-pro" intra="implementatio-linguae">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="implementatio-linguae">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="verbum-clavis">
    <glossa lingua="en">A keyword: a word the language claims for
    itself - it serves the grammar and is denied to identifiers. It
    is the vocabulary of the language itself, not of the program: a
    program coins its own words, but receives these already coined,
    as grammar.</glossa>
    <glossa lingua="fr">Un mot-clé : un mot que le langage se réserve -
    il sert la grammaire et est refusé aux identificateurs. C'est le
    vocabulaire du langage lui-même, non du programme : un programme
    forge ses propres mots, mais reçoit ceux-ci déjà forgés, comme
    grammaire.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="verbum-de" genus="referentia"/>
    <attributum nomen="additum-in" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="verbum-clavis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="locus">
    <glossa lingua="en">A place: a determinate part of space where
    bodily things can be - a point or an area on the earth. It is
    prior to all naming: the place remains even if its name
    perishes.</glossa>
    <glossa lingua="fr">Un lieu : une partie déterminée de
    l'espace où des choses corporelles peuvent se trouver - un
    point ou une aire sur la terre. Il est antérieur à toute
    dénomination : le lieu demeure même si son nom
    disparaît.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="latitudo" genus="numerus"/>
    <attributum nomen="longitudo-geo" genus="numerus"/>
    <attributum nomen="intra" genus="referentia"/>
    <liberum nomen="sub-iurisdictione"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="sub-iurisdictione" intra="locus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="locus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="inscriptio">
    <glossa lingua="en">An address: the agreed name of a place,
    used to find it - street, number, city, postal code. It is a
    CONVENTION, not the place: streets are renamed, numbers
    change, postal codes are invented, while the place itself
    does not move.</glossa>
    <glossa lingua="fr">Une adresse : le nom convenu d'un lieu,
    servant à le trouver - rue, numéro, ville, code postal. C'est
    une CONVENTION, non le lieu : les rues sont rebaptisées, les
    numéros changent, les codes postaux sont inventés, alors que
    le lieu ne bouge pas.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="codex-postalis" genus="textus"/>
    <attributum nomen="designat" genus="referentia"/>
    <liberum nomen="linea"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="linea" intra="inscriptio" textus="verum"/>
  <elementum nomen="historia" intra="inscriptio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="iurisdictio">
    <glossa lingua="en">A jurisdiction: the power to make and
    enforce laws over a place - municipality, province, state.
    Not a place but a POWER, which is why jurisdictions can
    overlap (the same place under three at once), something
    places themselves cannot do.</glossa>
    <glossa lingua="fr">Une juridiction : le pouvoir de faire des
    lois et de les faire appliquer sur un lieu - commune,
    province, État. Non pas un lieu mais un POUVOIR, et c'est
    pourquoi les juridictions peuvent se superposer (le même lieu
    sous trois à la fois), ce que les lieux eux-mêmes ne peuvent
    pas.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="exercetur-a" genus="referentia"/>
    <attributum nomen="intra" genus="referentia"/>
    <liberum nomen="fert"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="fert" intra="iurisdictio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="iurisdictio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="aedificium">
    <glossa lingua="en">A building: a structure fixed to a place
    which people occupy - a bodily thing that cannot be moved.
    Immobility is its essence, whence the legal term immovable
    property.</glossa>
    <glossa lingua="fr">Un bâtiment : une structure fixée à un
    lieu et que des hommes occupent - une chose corporelle qui ne
    peut être déplacée. L'immobilité est son essence, d'où le
    terme juridique de biens immeubles.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="situm-in" genus="referentia"/>
    <attributum nomen="inscriptio-eius" genus="referentia"/>
    <liberum nomen="spatia" maximum="1"/>
    <liberum nomen="occupatum-a"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="spatia" intra="aedificium">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="occupatum-a" intra="aedificium">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="aedificium">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="magnitudo-mensurabilis">
    <glossa lingua="en">A measurable magnitude: that which can be
    measured - length, mass, time, temperature. The Aristotelian
    category of quantity, prior to all units, which merely PARTITION
    it: length is there even if no one had ever invented the
    metre.</glossa>
    <glossa lingua="fr">Une grandeur mesurable : ce qui peut être
    mesuré - longueur, masse, temps, température. Le prédicament
    aristotélicien de la quantité, antérieur à toutes les unités,
    lesquelles ne font que la PARTAGER : la longueur est là même si
    personne n'avait inventé le mètre.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <liberum nomen="mensuratur-per"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="mensuratur-per" intra="magnitudo-mensurabilis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="magnitudo-mensurabilis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="unitas-mensurae">
    <glossa lingua="en">A unit of measure: an agreed partition of a
    measurable magnitude, by which quantities can be counted. It is
    a CONVENTION and not a nature - but a standardized convention,
    publicly kept, and therefore a thing about which the truth can
    be told.</glossa>
    <glossa lingua="fr">Une unité de mesure : une partition convenue
    d'une grandeur mesurable, par laquelle les quantités peuvent
    être dénombrées. C'est une CONVENTION et non une nature - mais
    une convention normalisée, gardée publiquement, et donc une
    chose dont on peut dire le vrai.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="symbolum" genus="textus"/>
    <attributum nomen="fundamentalis" genus="veritas"/>
    <attributum nomen="mensurat" genus="referentia"/>
    <attributum nomen="normata-per" genus="referentia"/>
    <attributum nomen="custodita-a" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="unitas-mensurae">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="quantitas">
    <glossa lingua="en">A quantity: a number WITH A UNIT, the settled
    measure of a thing. A number by itself is no quantity - "500" is
    nothing until "grams" is present. Addition is permitted only
    between quantities of the same magnitude; attempting it across
    magnitudes is a dimensional error, as the Mars Climate Orbiter
    lost in 1999 showed, where pounds passed for newtons - a
    quantity whose unit went unguarded.</glossa>
    <glossa lingua="fr">Une quantité : un nombre AVEC UNE UNITÉ, la
    mesure déterminée d'une chose. Un nombre seul n'est pas une
    quantité - « 500 » n'est rien tant que « grammes » n'est pas là.
    L'addition n'est permise qu'entre quantités de même grandeur ;
    la tenter à travers des grandeurs est une erreur de dimensions,
    comme l'a montré la perte du Mars Climate Orbiter en 1999, où
    des livres ont été prises pour des newtons - une quantité dont
    l'unité n'était pas gardée.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="valor" genus="numerus" fractio="verum"/>
    <attributum nomen="minimum" genus="numerus" fractio="verum"/>
    <attributum nomen="maximum" genus="numerus" fractio="verum"/>
    <attributum nomen="praecisio" genus="numerus" fractio="verum"/>
    <attributum nomen="in-unitate" genus="referentia"/>
    <attributum nomen="cum-incertitudine" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="quantitas">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="incertitudo">
    <glossa lingua="en">An uncertainty: the measure of how much of the
    true value we do not know - the interval around the measured
    value within which the true value is believed to lie, at a
    stated probability. It is ABOUT US, not about the thing: a range
    says the thing itself varies, an uncertainty says the thing has
    one value that we do not know exactly.</glossa>
    <glossa lingua="fr">Une incertitude : la mesure de ce que nous
    ignorons de la valeur vraie - l'intervalle, autour de la valeur
    mesurée, dans lequel on croit que la valeur vraie se trouve,
    avec une probabilité déclarée. Elle porte SUR NOUS et non sur la
    chose : un intervalle dit que la chose elle-même varie, une
    incertitude dit que la chose a une seule valeur que nous ne
    connaissons pas exactement.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="magnitudo" genus="numerus"/>
    <attributum nomen="factor-tegumenti" genus="numerus"/>
    <attributum nomen="fiducia-stata" genus="numerus"/>
    <attributum nomen="genus-aestimationis" genus="electio">
      <optio>typus_a</optio>
      <optio>typus_b</optio>
    </attributum>
    <attributum nomen="de-quantitate" genus="referentia"/>
    <attributum nomen="asseritur-per" genus="referentia"/>
    <liberum nomen="componitur-ex"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="componitur-ex" intra="incertitudo">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="incertitudo">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="instrumentum-mensurae">
    <glossa lingua="en">A measuring instrument: a tool that does NOT
    change its thing but characterizes it - an oven bakes the bread,
    a balance leaves the bread as it was. And it is the only tool
    that is ITSELF measured: calibration is the measure of the
    measurer, which gives it a chain that exists nowhere
    else.</glossa>
    <glossa lingua="fr">Un instrument de mesure : un instrument qui ne
    MODIFIE PAS sa chose mais la caractérise - le four cuit le pain,
    la balance laisse le pain tel qu'il était. Et c'est le seul
    instrument qui soit LUI-MÊME mesuré : l'étalonnage est la mesure
    du mesureur, d'où une chaîne qui n'existe nulle part
    ailleurs.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="error-systematicus" genus="numerus"/>
    <attributum nomen="dispersio" genus="numerus"/>
    <attributum nomen="resolutio" genus="numerus"/>
    <attributum nomen="intervallum-calibrationis" genus="textus"/>
    <attributum nomen="status-fides" genus="electio">
      <optio>calibratum</optio>
      <optio>in_usu</optio>
      <optio>expiratum</optio>
      <optio>extra_tolerantiam</optio>
    </attributum>
    <attributum nomen="calibratum-contra" genus="referentia"/>
    <attributum nomen="attestatur-per" genus="referentia"/>
    <attributum nomen="capacitas" genus="textus"/>
    <attributum nomen="status-usus" genus="electio">
      <optio>otiosum</optio>
      <optio>in_usu</optio>
      <optio>in_reparatione</optio>
      <optio>fractum</optio>
    </attributum>
    <attributum nomen="factum-per" genus="referentia"/>
    <attributum nomen="factum-a" genus="referentia"/>
    <attributum nomen="massa" genus="textus"/>
    <attributum nomen="perituram" genus="veritas"/>
    <attributum nomen="status-conditio" genus="electio">
      <optio>recens</optio>
      <optio>vetus</optio>
      <optio>corrupta</optio>
    </attributum>
    <attributum nomen="sita-in" genus="referentia"/>
    <liberum nomen="materiae-constituentes" maximum="1"/>
    <liberum nomen="ex-materia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="materiae-constituentes" intra="instrumentum-mensurae">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="ex-materia" intra="instrumentum-mensurae">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="instrumentum-mensurae">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="morbus">
    <glossa lingua="en">A disease: a disposition of a living thing
    contrary to its nature, by which an operation that is owed to it
    is impeded - a falling short of what is due to the nature of the
    thing. It is not a thing but a privation, what is lacking to
    health as darkness is lacking to light. Hence a disease cannot
    be defined unless a nature is first supposed.</glossa>
    <glossa lingua="fr">Une maladie : une disposition du vivant
    contraire à sa nature, par laquelle une opération qui lui est
    due se trouve empêchée - un manquement à ce qui est dû à la
    nature de la chose. Ce n'est pas une chose mais une privation :
    ce qui fait défaut à la santé, comme les ténèbres à la lumière.
    Aussi la maladie ne peut-elle être définie sans qu'une nature
    soit d'abord supposée.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="contagiosus" genus="veritas"/>
    <attributum nomen="duratio-typica" genus="textus"/>
    <attributum nomen="letalitas" genus="numerus"/>
    <attributum nomen="status-cursus" genus="electio">
      <optio>latens</optio>
      <optio>manifestus</optio>
      <optio>convalescens</optio>
      <optio>sanatus</optio>
      <optio>chronicus</optio>
      <optio>lethalis</optio>
    </attributum>
    <attributum nomen="afficit" genus="referentia"/>
    <attributum nomen="sedes" genus="referentia"/>
    <attributum nomen="dignoscitur-per" genus="referentia"/>
    <attributum nomen="classificatus-in" genus="referentia"/>
    <liberum nomen="curatur-per"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="curatur-per" intra="morbus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="morbus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="norma">
    <glossa lingua="en">A standard: a public document that
    prescribes a form - it defines what conformity means. It is
    distinct from the thing standardized: the standard for the C
    language is not the C language; it is an authoritative
    description.</glossa>
    <glossa lingua="fr">Une norme : un document public qui
    prescrit une forme - elle définit ce que signifie la
    conformité. Elle se distingue de la chose normée : la norme
    du langage C n'EST pas le langage C ; c'est une description
    faisant autorité.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="index" genus="textus"/>
    <attributum nomen="titulus" genus="textus"/>
    <attributum nomen="publicata" genus="dies"/>
    <attributum nomen="status-vigor" genus="electio">
      <optio>proposita</optio>
      <optio>vigens</optio>
      <optio>substituta</optio>
      <optio>retracta</optio>
    </attributum>
    <attributum nomen="substituit" genus="referentia"/>
    <attributum nomen="normat" genus="referentia"/>
    <liberum nomen="editor"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="editor" intra="norma">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="norma">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="lex">
    <glossa lingua="en">A law: an ordinance of reason for the
    common good, promulgated by the one who has care of the
    community (Aquinas, ST I-II q.90 a.4) - not counsel but
    precept, with binding force and usually with a sanction. It
    differs from a standard by its SOURCE OF AUTHORITY: a
    standard OFFERS conformity, a law DEMANDS obedience.</glossa>
    <glossa lingua="fr">Une loi : une ordonnance de la raison en
    vue du bien commun, promulguée par celui qui a la charge de
    la communauté (Thomas, ST I-II q.90 a.4) - non pas un conseil
    mais un précepte, avec force obligatoire et le plus souvent
    avec une sanction. Elle diffère de la norme par sa SOURCE
    D'AUTORITÉ : la norme OFFRE la conformité, la loi EXIGE
    l'obéissance.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="sanctio" genus="textus"/>
    <attributum nomen="vacatio" genus="textus"/>
    <attributum nomen="status-vigor" genus="electio">
      <optio>lata</optio>
      <optio>promulgata</optio>
      <optio>vigens</optio>
      <optio>abrogata</optio>
      <optio>desueta</optio>
    </attributum>
    <attributum nomen="lata-a" genus="referentia"/>
    <attributum nomen="in-iurisdictione" genus="referentia"/>
    <attributum nomen="promulgata-per" genus="referentia"/>
    <liberum nomen="abrogat"/>
    <liberum nomen="parit"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="abrogat" intra="lex">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="parit" intra="lex">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="lex">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="classis-normativa">
    <glossa lingua="en">A regulatory class: a category established
    by a standard, into which things are assigned and to which
    consequences (obligations, prohibitions, procedures) ATTACH.
    What is owed to the class is owed to every member, and a
    member that changes class changes its consequences without
    changing in itself at all. Membership is conferred by an act
    and taken away by an act, so a regulatory class has a history
    that the nature of a thing does not.</glossa>
    <glossa lingua="fr">Une classe réglementaire : une catégorie
    établie par une norme, dans laquelle des choses sont
    assignées et à laquelle des conséquences (obligations,
    interdictions, procédures) SONT ATTACHÉES. Ce qui est dû à la
    classe est dû à tous ses membres, et un membre qui change de
    classe change de conséquences sans changer en lui-même.
    L'appartenance est conférée par un acte et retirée par un
    acte ; la classe réglementaire a donc une histoire que la
    nature d'une chose n'a pas.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="ordinata" genus="veritas"/>
    <attributum nomen="criterium" genus="textus"/>
    <attributum nomen="assignatio-quomodo" genus="electio">
      <optio>norma_nominatim</optio>
      <optio>decreto_administrativo</optio>
      <optio>iudicio_periti</optio>
    </attributum>
    <attributum nomen="status-vigor" genus="electio">
      <optio>proposita</optio>
      <optio>vigens</optio>
      <optio>abrogata</optio>
    </attributum>
    <attributum nomen="constituta-per" genus="referentia"/>
    <attributum nomen="assignatur-per" genus="referentia"/>
    <attributum nomen="gradus-supra" genus="referentia"/>
    <liberum nomen="continet"/>
    <liberum nomen="imponit"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="continet" intra="classis-normativa">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="imponit" intra="classis-normativa">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="classis-normativa">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="fictio-iuris">
    <glossa lingua="en">A legal fiction: a precept by which the
    law orders a thing that stands one way to be treated AS IF it
    stood otherwise, knowing that it does not, for the sake of a
    good that cannot be reached any other way. Not an error nor a
    pretence but an as-if deliberately undertaken - it differs
    from a presumption in that a presumption yields once the
    contrary is proven, while a fiction already knows the
    contrary and does not yield.</glossa>
    <glossa lingua="fr">Une fiction juridique : un précepte par
    lequel la loi ordonne de traiter une chose COMME SI elle
    était autre, sachant qu'elle ne l'est pas, en vue d'un bien
    qui ne peut être atteint autrement. Ni une erreur ni une
    simulation, mais un comme-si délibérément assumé - elle
    diffère de la présomption en ce que la présomption cède
    lorsque le contraire est prouvé, tandis que la fiction sait
    déjà le contraire et ne cède pas.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="ratio" genus="textus"/>
    <attributum nomen="refragabilis" genus="veritas"/>
    <attributum nomen="ambitus" genus="electio">
      <optio>universalis</optio>
      <optio>ad_certos_effectus</optio>
    </attributum>
    <attributum nomen="instituta-per" genus="referentia"/>
    <attributum nomen="applicatur-per" genus="referentia"/>
    <attributum nomen="fingit" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="fictio-iuris">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="obligatio">
    <glossa lingua="en">An obligation: a bond of law by which someone
    is bound to render something to another (the Institutes). It is
    not a thing but a BOND between persons - debtor and creditor are
    its two ends. Without the relation there is no
    obligation.</glossa>
    <glossa lingua="fr">Une obligation : un lien de droit par lequel
    quelqu'un est astreint à fournir quelque chose à autrui (les
    Institutes). Ce n'est pas une chose mais un LIEN entre personnes
    - le débiteur et le créancier en sont les deux termes. Sans la
    relation, il n'y a pas d'obligation.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="status-vita" genus="electio">
      <optio>orta</optio>
      <optio>soluta</optio>
      <optio>remissa</optio>
      <optio>praescripta</optio>
      <optio>violata</optio>
    </attributum>
    <attributum nomen="debitor" genus="referentia"/>
    <attributum nomen="creditor" genus="referentia"/>
    <attributum nomen="praestandum" genus="referentia"/>
    <attributum nomen="orta-ex" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="obligatio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="contractus">
    <glossa lingua="en">A contract: an agreement of two parties (or
    more) that gives birth to obligations. Consent is its foundation,
    which is why it binds both sides and neither may undo it alone.
    One thing, several obligations: a contract of hire demands wages
    from the one party and labour from the other.</glossa>
    <glossa lingua="fr">Un contrat : une convention de deux parties (ou
    plus) qui engendre des obligations. Le consentement en est le
    fondement : voilà pourquoi il lie les deux côtés, et aucun ne
    peut le défaire seul. Une seule chose, plusieurs obligations : le
    louage d'ouvrage exige un salaire de l'un et un travail de
    l'autre.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="initium" genus="dies"/>
    <attributum nomen="finis" genus="dies"/>
    <liberum nomen="partes"/>
    <liberum nomen="parit"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="partes" intra="contractus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="parit" intra="contractus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="contractus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="licentia">
    <glossa lingua="en">A licence: a grant made by an authority so that
    something becomes lawful which otherwise would not be. It is
    UNILATERAL (it needs no consent from the one receiving it),
    REVOCABLE (the grantor may take it away), and often TEMPORARY. It
    is therefore not a contract - a distinction that common schemas
    confuse.</glossa>
    <glossa lingua="fr">Une licence : une concession accordée par une
    autorité pour rendre licite ce qui autrement ne le serait pas.
    Elle est UNILATÉRALE (elle n'exige pas le consentement de celui
    qui la reçoit), RÉVOCABLE (celui qui l'accorde peut la retirer)
    et souvent TEMPORAIRE. Ce n'est donc pas un contrat - distinction
    que les schémas courants confondent.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="data" genus="dies"/>
    <attributum nomen="expirat" genus="dies"/>
    <attributum nomen="recentia-postulata" genus="veritas"/>
    <attributum nomen="status-vigor" genus="electio">
      <optio>petita</optio>
      <optio>concessa</optio>
      <optio>suspensa</optio>
      <optio>revocata</optio>
      <optio>expirata</optio>
    </attributum>
    <attributum nomen="concedens" genus="referentia"/>
    <attributum nomen="accipiens" genus="referentia"/>
    <attributum nomen="secundum-normam" genus="referentia"/>
    <liberum nomen="condiciones"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="condiciones" intra="licentia" textus="verum"/>
  <elementum nomen="historia" intra="licentia">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="tributum">
    <glossa lingua="en">A tax: an obligation owed to the MAGISTRATE,
    arising from law and not from consent - it is due because the law
    so provides, not because anyone promised. It can therefore
    neither be refused nor privately forgiven: the creditor cannot
    release it, because the creditor is not a person but the
    commonwealth.</glossa>
    <glossa lingua="fr">Un impôt : une obligation envers le MAGISTRAT,
    née de la loi et non du consentement - il est dû parce que la loi
    le prescrit, non parce que quelqu'un l'a promis. Il ne peut donc
    être ni refusé ni remis à titre privé : le créancier ne peut en
    faire remise, car le créancier n'est pas une personne mais la
    chose publique.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="ratio" genus="electio">
      <optio>ex_transitu</optio>
      <optio>ex_reditu</optio>
      <optio>ex_possessione</optio>
      <optio>ex_venditione</optio>
      <optio>ex_capite</optio>
    </attributum>
    <attributum nomen="exigitur-a" genus="referentia"/>
    <attributum nomen="secundum-normam" genus="referentia"/>
    <attributum nomen="status-vita" genus="electio">
      <optio>orta</optio>
      <optio>soluta</optio>
      <optio>remissa</optio>
      <optio>praescripta</optio>
      <optio>violata</optio>
    </attributum>
    <attributum nomen="debitor" genus="referentia"/>
    <attributum nomen="creditor" genus="referentia"/>
    <attributum nomen="praestandum" genus="referentia"/>
    <attributum nomen="orta-ex" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="tributum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="titulus">
    <glossa lingua="en">A title: a public and permanent attestation
    given by an authority that someone has attained something or IS
    something - not a permission to act but testimony to a fact. It
    therefore neither expires nor is revoked: what has been done
    cannot be undone.</glossa>
    <glossa lingua="fr">Un titre : une attestation publique et
    permanente donnée par une autorité, portant que quelqu'un a
    obtenu quelque chose ou EST quelque chose - non une permission
    d'agir mais le témoignage d'un fait. Il n'expire donc pas et ne
    se révoque pas : ce qui a été fait ne peut être défait.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="collatus" genus="dies"/>
    <attributum nomen="appellatio" genus="textus"/>
    <attributum nomen="conferens" genus="referentia"/>
    <attributum nomen="latus-a" genus="referentia"/>
    <attributum nomen="fundat" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="titulus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="iussum">
    <glossa lingua="en">An order: a directive issued by one who holds
    the power to issue it, determining what is to be done, by whom,
    and within what time, and which ENDURES once issued - a thing
    made, not a bygone event. Its effect depends on its form and on
    the authority of the one commanding, so it is VALID or VOID
    rather than good or bad. It differs from an obligation, which is
    a bond between persons, in being a thing one holds, shows,
    transfers, and uses up; and from a procedure, which teaches HOW
    and is repeated, in commanding WHAT this once and dying when
    exhausted.</glossa>
    <glossa lingua="fr">Un ordre : une directive émise par celui qui en
    a le pouvoir, déterminant ce qui doit être fait, par qui et dans
    quel délai, et qui SUBSISTE une fois émise - une chose faite, non
    un événement passé. Son effet dépend de sa forme et de l'autorité
    de celui qui commande : il est donc VALIDE ou NUL, et non bon ou
    mauvais. Il diffère de l'obligation, qui est un lien entre
    personnes, en ce qu'il est une chose que l'on tient, montre,
    transfère et consomme ; et de la procédure, qui enseigne COMMENT
    et se répète, en ce qu'il commande QUOI cette fois-ci et meurt
    une fois épuisé.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="usus-reliqui" genus="numerus"/>
    <attributum nomen="valens-ad" genus="dies"/>
    <attributum nomen="transferibile" genus="veritas"/>
    <attributum nomen="poena-neglegentis" genus="electio">
      <optio>nulla</optio>
      <optio>disciplinaris</optio>
      <optio>iuridica</optio>
    </attributum>
    <attributum nomen="status-vita" genus="electio">
      <optio>latum</optio>
      <optio>acceptum</optio>
      <optio>exsecutum</optio>
      <optio>exhaustum</optio>
      <optio>revocatum</optio>
      <optio>elapsum</optio>
      <optio>recusatum</optio>
    </attributum>
    <attributum nomen="iubens" genus="referentia"/>
    <attributum nomen="potestate" genus="referentia"/>
    <attributum nomen="exsecutor" genus="referentia"/>
    <attributum nomen="beneficiarius" genus="referentia"/>
    <attributum nomen="latum-per" genus="referentia"/>
    <attributum nomen="parit" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="iussum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="fiducia">
    <glossa lingua="en">A trust: the holding of a thing in one's own
    name and title, but for ANOTHER'S BENEFIT and under duties - the
    trustee looks like the owner and is not, because what is held is
    not held for the holder. It differs from possession by DUTY (a
    possessor may do as they please with their own thing, whereas
    what a trustee may do is prescribed) and from delegation by SIDE:
    a delegate acts in another's name, while a trustee acts in their
    own name and holds true title, yet the fruit belongs to
    another.</glossa>
    <glossa lingua="fr">Une fiducie : la détention d'une chose en son
    propre nom et sous son propre titre, mais au PROFIT D'AUTRUI et
    sous des devoirs - le fiduciaire paraît propriétaire et ne l'est
    pas, car ce qu'il détient, il ne le détient pas pour lui-même.
    Elle diffère de la possession par le DEVOIR (le possesseur fait
    de sa chose ce qu'il veut, tandis que l'usage du fiduciaire est
    prescrit) et de la délégation par le CÔTÉ : le délégué agit au
    nom d'autrui, tandis que le fiduciaire agit en son propre nom et
    détient un titre véritable, mais le fruit est à autrui.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="lucrum-proprium" genus="veritas"/>
    <attributum nomen="alienatio" genus="electio">
      <optio>libera</optio>
      <optio>ad_certos_fines</optio>
      <optio>nulla</optio>
    </attributum>
    <attributum nomen="perpetua" genus="veritas"/>
    <attributum nomen="status-cursus" genus="electio">
      <optio>constituta</optio>
      <optio>gesta</optio>
      <optio>soluta</optio>
      <optio>violata</optio>
    </attributum>
    <attributum nomen="fiduciarius" genus="referentia"/>
    <attributum nomen="constituta-per" genus="referentia"/>
    <liberum nomen="beneficiarius"/>
    <liberum nomen="res-fiduciaria"/>
    <liberum nomen="officia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="beneficiarius" intra="fiducia">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="res-fiduciaria" intra="fiducia">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="officia" intra="fiducia">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="fiducia">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="petitio">
    <glossa lingua="en">A request: an asking directed to another that
    they do or render something, which they may GRANT OR REFUSE
    without any breach - what is owed to the one asking is not the
    thing asked for but an ANSWER. It differs from an order by
    AUTHORITY: whoever commands holds power over the executor and
    neglect brings a penalty, whereas whoever asks holds none and
    refusal is legitimate. A request therefore always awaits an
    answer, where an order awaits execution.</glossa>
    <glossa lingua="fr">Une demande : une requête adressée à autrui
    pour qu'il fasse ou fournisse quelque chose, et qu'il peut
    ACCORDER OU REFUSER sans aucune violation - ce qui est dû au
    demandeur n'est pas la chose demandée mais une RÉPONSE. Elle
    diffère de l'ordre par l'AUTORITÉ : celui qui commande a pouvoir
    sur l'exécutant et la négligence entraîne une peine, tandis que
    celui qui demande n'en a aucun et le refus est légitime. La
    demande attend donc toujours une réponse, là où l'ordre attend
    une exécution.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="identificator-petitionis" genus="textus"/>
    <attributum nomen="terminus-exspectandi" genus="textus"/>
    <attributum nomen="conatus" genus="numerus"/>
    <attributum nomen="status-cursus" genus="electio">
      <optio>missa</optio>
      <optio>accepta</optio>
      <optio>concessa</optio>
      <optio>negata</optio>
      <optio>elapsa</optio>
    </attributum>
    <attributum nomen="petens" genus="referentia"/>
    <attributum nomen="rogatus" genus="referentia"/>
    <attributum nomen="de" genus="referentia"/>
    <attributum nomen="iudicatur-per" genus="referentia"/>
    <attributum nomen="parit" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="petitio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="delegatio">
    <glossa lingua="en">A delegation: the power to act in another's
    name, such that the delegate's acts BIND the one delegating as
    though that person had acted - not a licence to act but a
    transfusion of authority, within stated bounds. It differs from a
    licence by WHO IS BOUND (a licence lets you act and your acts
    stay yours, whereas delegation makes your acts another's) and
    from an office by MOBILITY: an office is stably constituted and
    does not depend on who holds it, while a delegation is given to
    this person and perishes by death, revocation, or lapse of
    time.</glossa>
    <glossa lingua="fr">Une délégation : le pouvoir d'agir au nom
    d'autrui, de telle sorte que les actes du délégué OBLIGENT le
    délégant comme si celui-ci avait agi lui-même - non une licence
    d'agir mais une transfusion d'autorité, dans des limites fixées.
    Elle diffère de la licence par la PERSONNE OBLIGÉE (la licence
    vous laisse agir et vos actes restent les vôtres, tandis que la
    délégation rend vos actes ceux d'un autre) et de la charge par la
    MOBILITÉ : une charge est constituée de façon stable et ne
    dépend pas de qui l'occupe, tandis qu'une délégation est donnée à
    cette personne-ci et périt par la mort, la révocation ou
    l'écoulement du temps.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="ambitus" genus="textus"/>
    <attributum nomen="subdelegabilis" genus="veritas"/>
    <attributum nomen="revocabilis" genus="veritas"/>
    <attributum nomen="effectus-post-revocationem" genus="electio">
      <optio>nullus</optio>
      <optio>obligat_donec_nuntietur</optio>
    </attributum>
    <attributum nomen="durat-usque" genus="dies"/>
    <attributum nomen="status-vigor" genus="electio">
      <optio>data</optio>
      <optio>exercita</optio>
      <optio>revocata</optio>
      <optio>elapsa</optio>
      <optio>extincta</optio>
    </attributum>
    <attributum nomen="delegans" genus="referentia"/>
    <attributum nomen="delegatus" genus="referentia"/>
    <attributum nomen="probatur-per" genus="referentia"/>
    <liberum nomen="obligat-per"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="obligat-per" intra="delegatio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="delegatio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="tractatus">
    <glossa lingua="en">A treaty: a contract between parties who have
    no superior - no tribunal stands above them, so consent is given
    not once but TWICE, by the envoy who signs and by the sovereign
    who ratifies, and performance rests on good faith and reciprocity
    rather than on compulsion.</glossa>
    <glossa lingua="fr">Un traité : un contrat entre parties qui n'ont
    pas de supérieur - aucun tribunal ne se tient au-dessus d'elles,
    si bien que le consentement n'est pas donné une fois mais DEUX,
    par le légat qui signe et par le prince qui ratifie, et
    l'exécution repose sur la bonne foi et la réciprocité plutôt que
    sur la contrainte.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="multilateralis" genus="veritas"/>
    <attributum nomen="numerus-ad-vigorem" genus="numerus"/>
    <attributum nomen="status-vigor" genus="electio">
      <optio>negotiatus</optio>
      <optio>signatus</optio>
      <optio>ratificatus</optio>
      <optio>vigens</optio>
      <optio>suspensus</optio>
      <optio>terminatus</optio>
      <optio>abortus</optio>
    </attributum>
    <attributum nomen="depositarius" genus="referentia"/>
    <attributum nomen="ad-vigorem-per" genus="referentia"/>
    <attributum nomen="initium" genus="dies"/>
    <attributum nomen="finis" genus="dies"/>
    <liberum nomen="signatus-per"/>
    <liberum nomen="limitatus-per"/>
    <liberum nomen="partes"/>
    <liberum nomen="parit"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="signatus-per" intra="tractatus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="limitatus-per" intra="tractatus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="partes" intra="tractatus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="parit" intra="tractatus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="tractatus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="limitatio">
    <glossa lingua="en">A reservation: a unilateral declaration by
    which a party, in accepting a treaty, excludes or alters for
    itself the effect of certain articles - consent that is not
    entire but circumscribed. CONSENT IS NOT BINARY, and this kind
    proves it; stranger still, a reservation works separately between
    the reserving party and EACH other party, according to whether
    that party objected. One multilateral treaty thus dissolves into
    a NETWORK of bilateral obligations - one document, as many
    obligations as there are pairs.</glossa>
    <glossa lingua="fr">Une réserve : une déclaration unilatérale par
    laquelle une partie, en acceptant un traité, exclut ou modifie
    pour elle-même l'effet de certains articles - un consentement non
    entier mais circonscrit. LE CONSENTEMENT N'EST PAS BINAIRE, et ce
    genre le prouve ; plus étrange encore, une réserve joue
    séparément entre la partie réservataire et CHACUNE des autres
    parties, selon que celle-ci a objecté ou non. Un seul traité
    multilatéral se dissout ainsi en un RÉSEAU d'obligations
    bilatérales - un seul document, autant d'obligations qu'il y a de
    paires.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="articuli" genus="textus"/>
    <attributum nomen="modus" genus="electio">
      <optio>exclusio</optio>
      <optio>modificatio</optio>
    </attributum>
    <attributum nomen="compatibilis-cum-fine" genus="veritas"/>
    <attributum nomen="ad-tractatum" genus="referentia"/>
    <attributum nomen="lata-a" genus="referentia"/>
    <attributum nomen="asseritur-per" genus="referentia"/>
    <liberum nomen="obiecta-a"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="obiecta-a" intra="limitatio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="limitatio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="portio-communis">
    <glossa lingua="en">A common share: a determined part of a finite
    common resource that someone is allowed to use while others draw
    on the same source - a measured right, not a mere permission,
    because what you take is missing to the rest. It differs from a
    licence by the SOURCE (a licence permits what would otherwise be
    unlawful and says nothing about supply, whereas a share
    presupposes a finite and rival supply, so that measure belongs to
    its essence) and from possession by COMMUNALITY: a possessor has
    a thing of their own, while a shareholder has a part of a thing
    that is another's and common - the source stays one and is never
    divided.</glossa>
    <glossa lingua="fr">Une part commune : une partie déterminée d'une
    ressource commune finie dont quelqu'un peut user tandis que
    d'autres puisent à la même source - un droit mesuré, non une
    simple permission, car ce que vous prenez manque aux autres. Elle
    diffère de la licence par la SOURCE (la licence permet ce qui
    autrement serait illicite et ne dit rien de l'abondance, tandis
    que la part suppose une ressource finie et rivale, si bien que la
    mesure appartient à son essence) et de la possession par la
    COMMUNAUTÉ : le possesseur a une chose à lui, tandis que le
    titulaire d'une part a une partie d'une chose autre et commune -
    la source demeure une et n'est jamais divisée.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="mensura" genus="textus"/>
    <attributum nomen="adhaeret" genus="electio">
      <optio>personae</optio>
      <optio>praedio</optio>
      <optio>navi</optio>
      <optio>officio</optio>
    </attributum>
    <attributum nomen="transferibilis" genus="veritas"/>
    <attributum nomen="periodica" genus="veritas"/>
    <attributum nomen="in-re-communi" genus="referentia"/>
    <attributum nomen="competit" genus="referentia"/>
    <attributum nomen="statuta-per" genus="referentia"/>
    <attributum nomen="custodita-per" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="portio-communis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="ambitus">
    <glossa lingua="en">An environment: an ordered place where
    programs run - machines, configurations, data, names. Not a
    patch of hardware but the whole context a program finds
    around itself.</glossa>
    <glossa lingua="fr">Un environnement : un lieu ordonné où les
    programmes s'exécutent - machines, configurations, données,
    noms. Non pas un morceau de matériel mais le contexte entier
    que le programme trouve autour de lui.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="realitas-consequentiae" genus="electio">
      <optio>ficta</optio>
      <optio>vera</optio>
    </attributum>
    <attributum nomen="data-vera" genus="veritas"/>
    <attributum nomen="situs-in" genus="referentia"/>
    <liberum nomen="fert"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="fert" intra="ambitus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="ambitus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="pensum">
    <glossa lingua="en">A task: a definite piece of work entrusted
    to someone - what is to be done, by whom, in what state. Not
    a requirement (what must be true), nor a capability (what the
    work delivers), nor a defect (a discrepancy), but a
    COMMISSION TO ACT - the fourth term the engineering square
    was missing.</glossa>
    <glossa lingua="fr">Une tâche : un travail déterminé confié à
    quelqu'un - ce qui est à faire, par qui, en quel état. Ni une
    exigence (ce qui doit être vrai), ni une fonctionnalité (ce
    que le travail fournit), ni un défaut (un écart), mais une
    COMMISSION D'AGIR - le quatrième terme qui manquait au carré
    de la fabrication.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="aestimatio-laboris" genus="textus"/>
    <attributum nomen="terminus" genus="dies"/>
    <attributum nomen="status-cursus" genus="electio">
      <optio>propositum</optio>
      <optio>susceptum</optio>
      <optio>in_opere</optio>
      <optio>perfectum</optio>
      <optio>omissum</optio>
    </attributum>
    <attributum nomen="commissum" genus="referentia"/>
    <liberum nomen="implet"/>
    <liberum nomen="sanat"/>
    <liberum nomen="impeditur-a"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="implet" intra="pensum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="sanat" intra="pensum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="impeditur-a" intra="pensum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="pensum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="incidens">
    <glossa lingua="en">An incident: an interruption or degradation
    of service in a real environment. Not a kind of defect but a
    defect EXPOSED - the same fault is always a defect, and
    becomes an incident when it reaches real people. It has a
    beginning, an end, a severity, a response.</glossa>
    <glossa lingua="fr">Un incident : une interruption ou une
    dégradation du service dans un environnement réel. Non pas
    une espèce de défaut mais un défaut EXPOSÉ - la même faille
    est toujours un défaut, et elle devient un incident lorsqu'elle
    atteint des personnes réelles. Il a un début, une fin, une
    gravité, une réponse.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="gravitas" genus="electio">
      <optio>levis</optio>
      <optio>gravis</optio>
      <optio>totalis</optio>
    </attributum>
    <attributum nomen="duratio" genus="textus"/>
    <attributum nomen="status-cursus" genus="electio">
      <optio>deprehensum</optio>
      <optio>agnitum</optio>
      <optio>mitigatum</optio>
      <optio>solutum</optio>
      <optio>recensitum</optio>
    </attributum>
    <attributum nomen="in-ambitu" genus="referentia"/>
    <attributum nomen="ex-vitio" genus="referentia"/>
    <attributum nomen="deprehensum-per" genus="referentia"/>
    <attributum nomen="violat" genus="referentia"/>
    <liberum nomen="causa-eius"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="causa-eius" intra="incidens">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="incidens">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="processus">
    <glossa lingua="en">A process: a program in execution - an
    instance of a form, carrying its own state, and worth
    addressing for as long as it lives. The same program can run
    a hundred times at once, and those are a hundred processes,
    not one. Here the instance is TEMPORAL: a process begins,
    runs, ceases - its ending lies in its nature.</glossa>
    <glossa lingua="fr">Un processus : un programme en cours
    d'exécution - une instance d'une forme, portant son propre
    état, et digne d'être adressée tant qu'elle vit. Le même
    programme peut s'exécuter cent fois à la fois, et ce sont
    cent processus, non pas un seul. Ici l'instance est
    TEMPORELLE : un processus commence, s'exécute, cesse - sa fin
    est dans sa nature.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="identificator-currens" genus="numerus"/>
    <attributum nomen="valor-exitus" genus="numerus"/>
    <attributum nomen="privilegium" genus="electio">
      <optio>utentis</optio>
      <optio>administratoris</optio>
    </attributum>
    <attributum nomen="status-cursus" genus="electio">
      <optio>nascens</optio>
      <optio>currens</optio>
      <optio>dormiens</optio>
      <optio>suspensus</optio>
      <optio>larva</optio>
      <optio>sublatus</optio>
    </attributum>
    <attributum nomen="instantia-de" genus="referentia"/>
    <attributum nomen="genitus-a" genus="referentia"/>
    <attributum nomen="currit-in" genus="referentia"/>
    <liberum nomen="spatium-memoriae" maximum="1"/>
    <liberum nomen="tabula-descriptorum" maximum="1"/>
    <liberum nomen="ambitus-variabilium" maximum="1"/>
    <liberum nomen="directorium-currens" maximum="1"/>
    <liberum nomen="vector-argumentorum" maximum="1"/>
    <liberum nomen="gerit"/>
    <liberum nomen="tenet-apertam"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="spatium-memoriae" intra="processus">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="tabula-descriptorum" intra="processus">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="ambitus-variabilium" intra="processus">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="directorium-currens" intra="processus">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="vector-argumentorum" intra="processus">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="gerit" intra="processus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="tenet-apertam" intra="processus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="processus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="opus-scriptum">
    <glossa lingua="en">A written work: an intellectual creation made
    of words, distinct from its expressions - Moby-Dick is one work
    whether it is read in English or in Latin, on paper or on a
    screen. It is the thing the author CONCEIVED.</glossa>
    <glossa lingua="fr">Une œuvre écrite : une création
    intellectuelle faite de mots, distincte de ses expressions -
    Moby-Dick est une seule œuvre, qu'on la lise en anglais ou en
    latin, sur papier ou sur écran. C'est la chose que l'auteur a
    CONÇUE.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="titulus-originalis" genus="textus"/>
    <attributum nomen="lingua-originalis" genus="textus"/>
    <attributum nomen="status-compositio" genus="electio">
      <optio>concepta</optio>
      <optio>in_scriptione</optio>
      <optio>perfecta</optio>
      <optio>imperfecta_relicta</optio>
    </attributum>
    <attributum nomen="habet-expressionem" genus="referentia"/>
    <attributum nomen="continuatio-de" genus="referentia"/>
    <attributum nomen="respondet-ad" genus="referentia"/>
    <attributum nomen="pars-de" genus="referentia"/>
    <liberum nomen="materia"/>
    <liberum nomen="auctor"/>
    <liberum nomen="scriba"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="materia" intra="opus-scriptum" textus="verum"/>
  <elementum nomen="auctor" intra="opus-scriptum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="scriba" intra="opus-scriptum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="opus-scriptum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="expressio">
    <glossa lingua="en">An expression: the realization of a work in
    determinate signs - this text and no other. A translation is a
    NEW expression (other words, the same work), and a critical
    recension is one likewise.</glossa>
    <glossa lingua="fr">Une expression : la réalisation d'une œuvre en
    signes déterminés - ce texte-ci et non un autre. Une traduction
    est une expression NOUVELLE (d'autres mots, la même œuvre) ;
    une recension critique de même.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="lingua" genus="textus"/>
    <attributum nomen="auctoritativa" genus="veritas"/>
    <attributum nomen="genus-expressionis" genus="electio">
      <optio>originalis</optio>
      <optio>translata</optio>
      <optio>recensita</optio>
      <optio>abbreviata</optio>
    </attributum>
    <attributum nomen="expressio-de" genus="referentia"/>
    <attributum nomen="translata-ex" genus="referentia"/>
    <liberum nomen="translator"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="translator" intra="expressio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="expressio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="editio">
    <glossa lingua="en">An edition: the published body of an
    expression - what the press actually brought forth: the paper,
    the format, the pages, the ISBN. What you buy in a shop.</glossa>
    <glossa lingua="fr">Une édition : le corps publié d'une expression
    - ce que la presse a réellement produit : le papier, le format,
    les pages, l'ISBN. Ce que vous achetez en librairie.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="index-isbn" genus="textus"/>
    <attributum nomen="paginae" genus="numerus"/>
    <attributum nomen="forma-corporis" genus="electio">
      <optio>codex_duro_tegmine</optio>
      <optio>codex_molli_tegmine</optio>
      <optio>volumen_membranaceum</optio>
      <optio>electronica</optio>
    </attributum>
    <attributum nomen="publicata" genus="dies"/>
    <attributum nomen="edita-a" genus="referentia"/>
    <attributum nomen="impressa-in" genus="referentia"/>
    <liberum nomen="editio-de"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="editio-de" intra="editio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="editio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="codex">
    <glossa lingua="en">A copy: one bodily exemplar of an edition -
    the one you hold in your hand, with its stains, its marginal
    notes and its own history of ownership. Its individuals do not
    live in OUR library but in the owners' own volumes, which cite
    this kind.</glossa>
    <glossa lingua="fr">Un exemplaire : un seul exemplaire corporel
    d'une édition - celui que vous tenez en main, avec ses taches,
    ses notes marginales et son histoire de possession propre. Ses
    individus ne vivent pas dans NOTRE bibliothèque mais dans les
    volumes de leurs possesseurs, qui citent ce genre.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="conditio" genus="electio">
      <optio>integer</optio>
      <optio>usu_tritus</optio>
      <optio>laesus</optio>
    </attributum>
    <attributum nomen="notae-marginales" genus="veritas"/>
    <attributum nomen="status-possessio" genus="electio">
      <optio>apud_dominum</optio>
      <optio>commodatus</optio>
      <optio>amissus</optio>
    </attributum>
    <attributum nomen="exemplar-de" genus="referentia"/>
    <attributum nomen="possessor" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="codex">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="periodicum">
    <glossa lingua="en">A periodical: a written work that does not
    seek COMPLETION - it continues in issues for as long as those
    who direct it wish. The parent's composition machine is nearly
    foreign to it (never "finished", often "abandoned"): what rules
    it is a cadence, not an end.</glossa>
    <glossa lingua="fr">Un périodique : une œuvre écrite qui ne vise
    pas l'ACHÈVEMENT - elle se poursuit en fascicules aussi
    longtemps que ceux qui la dirigent le veulent. La machine à
    états de composition du genre parent lui convient à peine
    (jamais « achevée », souvent « abandonnée ») : ce qui la règle
    est une cadence, non une fin.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="cadentia" genus="electio">
      <optio>cotidiana</optio>
      <optio>hebdomadalis</optio>
      <optio>menstrua</optio>
      <optio>trimestris</optio>
      <optio>annua</optio>
      <optio>irregularis</optio>
    </attributum>
    <attributum nomen="habet-fasciculum" genus="referentia"/>
    <attributum nomen="titulus-originalis" genus="textus"/>
    <attributum nomen="lingua-originalis" genus="textus"/>
    <attributum nomen="status-compositio" genus="electio">
      <optio>concepta</optio>
      <optio>in_scriptione</optio>
      <optio>perfecta</optio>
      <optio>imperfecta_relicta</optio>
    </attributum>
    <attributum nomen="habet-expressionem" genus="referentia"/>
    <attributum nomen="continuatio-de" genus="referentia"/>
    <attributum nomen="respondet-ad" genus="referentia"/>
    <attributum nomen="pars-de" genus="referentia"/>
    <liberum nomen="materia"/>
    <liberum nomen="auctor"/>
    <liberum nomen="scriba"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="materia" intra="periodicum" textus="verum"/>
  <elementum nomen="auctor" intra="periodicum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="scriba" intra="periodicum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="periodicum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="fasciculus">
    <glossa lingua="en">An issue: a part of a periodical marked by its
    time - one number, published on its own day. It resembles a
    version, but it is foreseen by a CADENCE rather than born of an
    event: the next issue is expected, the next version is
    not.</glossa>
    <glossa lingua="fr">Un fascicule : une partie d'un périodique
    marquée par son temps - un numéro, publié à sa date. Il
    ressemble à une version, mais il est prévu par une CADENCE au
    lieu de naître d'un événement : le prochain fascicule est
    attendu, la prochaine version ne l'est pas.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="numerus" genus="textus"/>
    <attributum nomen="publicatus" genus="dies"/>
    <attributum nomen="fasciculus-de" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="fasciculus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="universitas">
    <glossa lingua="en">A corporate body: a gathering ordered to a
    common end that acts AS ONE and ENDURES though its members
    change - this endurance is what marks it off from a mere heap,
    for it is not the sum of its members and all of them may change
    while it stays the same. What makes it one is not its matter
    but its ORDER TOWARD AN END and the continuation of that order;
    so it is dissolved not when its members perish but when the
    order itself ceases.</glossa>
    <glossa lingua="fr">Un corps constitué : un ensemble ordonné à une
    fin commune qui agit COMME UN SEUL et QUI DURE alors que ses
    membres changent - cette durée le distingue d'un simple tas,
    car il n'est pas la somme de ses membres : tous peuvent changer
    et il demeure le même. Ce qui le fait un n'est pas sa matière
    mais son ORDRE À UNE FIN et la continuation de cet ordre ; il
    se dissout donc non quand ses membres périssent mais quand
    l'ordre lui-même cesse.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="condita" genus="dies"/>
    <attributum nomen="dissoluta" genus="dies"/>
    <attributum nomen="sedes" genus="textus"/>
    <attributum nomen="mutatio-membrorum" genus="electio">
      <optio>lenta</optio>
      <optio>velox</optio>
      <optio>nulla</optio>
    </attributum>
    <attributum nomen="unde-ordo" genus="electio">
      <optio>ab_intus</optio>
      <optio>ab_extra</optio>
    </attributum>
    <attributum nomen="pars-de" genus="referentia"/>
    <liberum nomen="membrum"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="membrum" intra="universitas">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="universitas">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="organizatio">
    <glossa lingua="en">An organization: a corporate body OF PERSONS.
    Because its members are rational, everything else follows -
    ends can be chosen and changed, offices established, legal
    capacity recognized, works published. It can be an author; it
    is not a person, but it is of persons.</glossa>
    <glossa lingua="fr">Une organisation : un corps constitué DE
    PERSONNES. Parce que ses membres sont raisonnables, tout le
    reste s'ensuit - les fins peuvent être choisies et changées,
    des offices institués, la capacité juridique reconnue, des
    œuvres publiées. Elle peut être auteur ; elle n'est pas une
    personne, mais elle est de personnes.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="pars-de" genus="referentia"/>
    <attributum nomen="membrum" genus="referentia"/>
    <attributum nomen="condita" genus="dies"/>
    <attributum nomen="dissoluta" genus="dies"/>
    <attributum nomen="sedes" genus="textus"/>
    <attributum nomen="mutatio-membrorum" genus="electio">
      <optio>lenta</optio>
      <optio>velox</optio>
      <optio>nulla</optio>
    </attributum>
    <attributum nomen="unde-ordo" genus="electio">
      <optio>ab_intus</optio>
      <optio>ab_extra</optio>
    </attributum>
    <liberum nomen="nomina"/>
    <liberum nomen="condita-a"/>
    <liberum nomen="administrat"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="nomina" intra="organizatio" textus="verum"/>
  <elementum nomen="condita-a" intra="organizatio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="administrat" intra="organizatio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="organizatio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="colonia">
    <glossa lingua="en">A colony: a corporate body OF LIVING THINGS
    whose members do not choose. Its order toward an end stands by
    nature and not by deliberation, so no offices can be
    established there and no ends changed. Its members are
    fungible and are replaced quickly; and alone among corporate
    bodies it MULTIPLIES BY DIVIDING - what is an accident for an
    organization (a decree, a sale) is the colony's way of
    generating.</glossa>
    <glossa lingua="fr">Une colonie : un corps constitué DE VIVANTS
    dont les membres ne choisissent pas. Son ordre à une fin tient
    de la nature et non de la délibération : aucun office ne peut y
    être institué ni aucune fin changée. Ses membres sont
    interchangeables et remplacés rapidement ; et, seule parmi les
    corps constitués, elle SE MULTIPLIE PAR DIVISION - ce qui est
    un accident pour une organisation (un décret, une vente) est
    pour la colonie sa manière d'engendrer.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="membra-fungibilia" genus="veritas"/>
    <attributum nomen="species-membrorum" genus="referentia"/>
    <attributum nomen="condita" genus="dies"/>
    <attributum nomen="dissoluta" genus="dies"/>
    <attributum nomen="sedes" genus="textus"/>
    <attributum nomen="mutatio-membrorum" genus="electio">
      <optio>lenta</optio>
      <optio>velox</optio>
      <optio>nulla</optio>
    </attributum>
    <attributum nomen="unde-ordo" genus="electio">
      <optio>ab_intus</optio>
      <optio>ab_extra</optio>
    </attributum>
    <attributum nomen="pars-de" genus="referentia"/>
    <liberum nomen="membrum"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="membrum" intra="colonia">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="colonia">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="persona-iuridica">
    <glossa lingua="en">A juridical person: an organization that is a
    subject of rights and obligations in law - it owns, contracts,
    sues and is sued in ITS OWN name, not in the name of its
    members. Its goods are therefore not the goods of the
    associates, nor its debts theirs: a separation on which modern
    business rests entirely.</glossa>
    <glossa lingua="fr">Une personne juridique : une organisation qui
    est sujet de droits et d'obligations en droit - elle possède,
    contracte, agit et est assignée en SON PROPRE nom, non au nom
    de ses membres. Ses biens ne sont donc pas ceux des associés,
    ni ses dettes les leurs : une séparation sur laquelle repose
    entièrement le commerce moderne.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="perpetua" genus="veritas"/>
    <attributum nomen="constituta-per" genus="referentia"/>
    <attributum nomen="pars-de" genus="referentia"/>
    <attributum nomen="membrum" genus="referentia"/>
    <attributum nomen="condita" genus="dies"/>
    <attributum nomen="dissoluta" genus="dies"/>
    <attributum nomen="sedes" genus="textus"/>
    <attributum nomen="mutatio-membrorum" genus="electio">
      <optio>lenta</optio>
      <optio>velox</optio>
      <optio>nulla</optio>
    </attributum>
    <attributum nomen="unde-ordo" genus="electio">
      <optio>ab_intus</optio>
      <optio>ab_extra</optio>
    </attributum>
    <liberum nomen="nomina"/>
    <liberum nomen="condita-a"/>
    <liberum nomen="administrat"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="nomina" intra="persona-iuridica" textus="verum"/>
  <elementum nomen="condita-a" intra="persona-iuridica">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="administrat" intra="persona-iuridica">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="persona-iuridica">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="officium">
    <glossa lingua="en">An office: a charge stably established, with
    burdens, powers and conditions OF ITS OWN, which does NOT
    inhere in the one who holds it - the same office remains while
    one holder succeeds another, and it REMAINS WITH NO HOLDER AT
    ALL. Vacancy is a true state, not a missing datum.</glossa>
    <glossa lingua="fr">Un office : une charge établie de manière
    stable, avec ses propres devoirs, pouvoirs et conditions, et
    qui n'adhère PAS à son titulaire - le même office demeure
    tandis que les titulaires se succèdent, et il DEMEURE MÊME SANS
    TITULAIRE. La vacance est un état véritable, non une donnée
    absente.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="ad-tempus" genus="veritas"/>
    <attributum nomen="collegiale" genus="veritas"/>
    <attributum nomen="status-tenentia" genus="electio">
      <optio>vacans</optio>
      <optio>occupatum</optio>
    </attributum>
    <attributum nomen="intra" genus="referentia"/>
    <attributum nomen="tenetur-a" genus="referentia"/>
    <attributum nomen="exercetur-a" genus="referentia"/>
    <attributum nomen="constituitur-per" genus="referentia"/>
    <attributum nomen="subest" genus="referentia"/>
    <liberum nomen="requisita"/>
    <liberum nomen="postulat"/>
    <liberum nomen="confert-capacitatem"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="requisita" intra="officium" textus="verum"/>
  <elementum nomen="postulat" intra="officium">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="confert-capacitatem" intra="officium">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="officium">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="corpus-normans">
    <glossa lingua="en">A standards body: an organization whose proper
    end is to publish and keep standards - authoritative
    descriptions to which others conform. Its authority comes from
    consent, not from command.</glossa>
    <glossa lingua="fr">Un organisme de normalisation : une
    organisation dont la fin propre est d'éditer et de garder des
    normes - des descriptions faisant autorité auxquelles les
    autres se conforment. Son autorité vient du consentement, non
    du commandement.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="pars-de" genus="referentia"/>
    <attributum nomen="membrum" genus="referentia"/>
    <attributum nomen="condita" genus="dies"/>
    <attributum nomen="dissoluta" genus="dies"/>
    <attributum nomen="sedes" genus="textus"/>
    <attributum nomen="mutatio-membrorum" genus="electio">
      <optio>lenta</optio>
      <optio>velox</optio>
      <optio>nulla</optio>
    </attributum>
    <attributum nomen="unde-ordo" genus="electio">
      <optio>ab_intus</optio>
      <optio>ab_extra</optio>
    </attributum>
    <liberum nomen="edit"/>
    <liberum nomen="nomina"/>
    <liberum nomen="condita-a"/>
    <liberum nomen="administrat"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="edit" intra="corpus-normans">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="nomina" intra="corpus-normans" textus="verum"/>
  <elementum nomen="condita-a" intra="corpus-normans">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="administrat" intra="corpus-normans">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="corpus-normans">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="societas">
    <glossa lingua="en">A company: an organization whose proper end is
    gain through the works it sells, and which has owners to whom
    it answers.</glossa>
    <glossa lingua="fr">Une société : une organisation dont la fin
    propre est le gain par les ouvrages qu'elle vend, et qui a des
    propriétaires devant lesquels elle répond.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="pars-de" genus="referentia"/>
    <attributum nomen="membrum" genus="referentia"/>
    <attributum nomen="condita" genus="dies"/>
    <attributum nomen="dissoluta" genus="dies"/>
    <attributum nomen="sedes" genus="textus"/>
    <attributum nomen="mutatio-membrorum" genus="electio">
      <optio>lenta</optio>
      <optio>velox</optio>
      <optio>nulla</optio>
    </attributum>
    <attributum nomen="unde-ordo" genus="electio">
      <optio>ab_intus</optio>
      <optio>ab_extra</optio>
    </attributum>
    <liberum nomen="nomina"/>
    <liberum nomen="condita-a"/>
    <liberum nomen="administrat"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="nomina" intra="societas" textus="verum"/>
  <elementum nomen="condita-a" intra="societas">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="administrat" intra="societas">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="societas">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="magistratus">
    <glossa lingua="en">A public authority: an organization whose
    authority comes from COMMAND over a place, not from consent (as
    a standards body) nor from gain (as a company). It makes laws
    that bind everyone within its jurisdiction, whether they
    consent or not; coercive force is its difference.</glossa>
    <glossa lingua="fr">Une autorité publique : une organisation dont
    l'autorité vient du COMMANDEMENT sur un territoire, non du
    consentement (comme un organisme de normalisation) ni du gain
    (comme une société). Elle porte des lois qui lient tous ceux
    qui sont dans sa juridiction, qu'ils y consentent ou non ; la
    force coercitive est sa différence.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="pars-de" genus="referentia"/>
    <attributum nomen="membrum" genus="referentia"/>
    <attributum nomen="condita" genus="dies"/>
    <attributum nomen="dissoluta" genus="dies"/>
    <attributum nomen="sedes" genus="textus"/>
    <attributum nomen="mutatio-membrorum" genus="electio">
      <optio>lenta</optio>
      <optio>velox</optio>
      <optio>nulla</optio>
    </attributum>
    <attributum nomen="unde-ordo" genus="electio">
      <optio>ab_intus</optio>
      <optio>ab_extra</optio>
    </attributum>
    <liberum nomen="exercet"/>
    <liberum nomen="concedit"/>
    <liberum nomen="nomina"/>
    <liberum nomen="condita-a"/>
    <liberum nomen="administrat"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="exercet" intra="magistratus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="concedit" intra="magistratus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="nomina" intra="magistratus" textus="verum"/>
  <elementum nomen="condita-a" intra="magistratus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="administrat" intra="magistratus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="magistratus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="persona">
    <glossa lingua="en">A person: an individual substance of a
    rational nature (Boethius). A person is the subject of free
    acts - able to be an author, and not merely a cause.</glossa>
    <glossa lingua="fr">Une personne : une substance individuelle de
    nature raisonnable (Boèce). La personne est le sujet des actes
    libres - elle peut être auteur, et non seulement cause.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="natus" genus="dies"/>
    <attributum nomen="mortuus" genus="dies"/>
    <attributum nomen="status-civilis" genus="electio">
      <optio>caelebs</optio>
      <optio>coniugatus</optio>
      <optio>viduus</optio>
      <optio>divortiatus</optio>
    </attributum>
    <attributum nomen="auctor-de" genus="referentia"/>
    <attributum nomen="domicilium" genus="referentia"/>
    <liberum nomen="nomina"/>
    <liberum nomen="membrum-de"/>
    <liberum nomen="inscriptus-in"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="nomina" intra="persona" textus="verum"/>
  <elementum nomen="membrum-de" intra="persona">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="inscriptus-in" intra="persona">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="persona">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="substantia-chemica">
    <glossa lingua="en">A chemical substance: a kind of matter
    determined by its composition - what all samples of the same
    substance share, wherever and whenever they were made. Not a
    heap but the KIND of heaps: "aspirin" is one thing we speak of,
    although the heaps of it are countless. It can be neither
    weighed nor touched, whereas matter can.</glossa>
    <glossa lingua="fr">Une substance chimique : un genre de matière
    déterminé par sa composition - ce que partagent tous les
    exemplaires d'une même substance, où et quand qu'ils aient été
    faits. Non pas un tas mais le GENRE des tas : « l'aspirine » est
    une seule chose dont nous parlons, quoique les tas en soient
    innombrables. Elle ne peut être ni pesée ni touchée, alors que
    la matière le peut.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="formula" genus="textus"/>
    <attributum nomen="massa-molecularis" genus="textus"/>
    <attributum nomen="solubilitas" genus="electio">
      <optio>aquosa</optio>
      <optio>lipidica</optio>
      <optio>utraque</optio>
    </attributum>
    <attributum nomen="interagit" genus="referentia"/>
    <liberum nomen="exemplatur-in"/>
    <liberum nomen="classificata-ut"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="exemplatur-in" intra="substantia-chemica">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="classificata-ut" intra="substantia-chemica">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="substantia-chemica">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="medicamentum">
    <glossa lingua="en">A drug: one substance (or several) prepared
    with a determinate STRENGTH and FORM for treating illness -
    what a prescription names and what a pharmacist dispenses.
    "Amoxicillin 500 mg capsule" is not the substance alone, and is
    not yet the thing in the hand.</glossa>
    <glossa lingua="fr">Un médicament : une substance (ou plusieurs)
    préparée avec une PUISSANCE et une FORME déterminées pour
    traiter une maladie - ce que l'ordonnance nomme et ce que le
    pharmacien délivre. « Amoxicilline 500 mg gélule » n'est pas la
    substance seule, et n'est pas encore la chose que l'on tient en
    main.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="vis" genus="textus"/>
    <attributum nomen="forma-sumendi" genus="electio">
      <optio>capsula</optio>
      <optio>tabella</optio>
      <optio>suspensio</optio>
      <optio>unguentum</optio>
      <optio>iniectio</optio>
    </attributum>
    <attributum nomen="via-sumendi" genus="electio">
      <optio>oralis</optio>
      <optio>topica</optio>
      <optio>venosa</optio>
      <optio>muscularis</optio>
    </attributum>
    <attributum nomen="sine-praescriptione" genus="veritas"/>
    <attributum nomen="conservatio" genus="textus"/>
    <attributum nomen="asseritur-per" genus="referentia"/>
    <liberum nomen="continet"/>
    <liberum nomen="aequivalens"/>
    <liberum nomen="fabricatum-in"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="continet" intra="medicamentum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="aequivalens" intra="medicamentum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="fabricatum-in" intra="medicamentum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="medicamentum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="coctura">
    <glossa lingua="en">A batch: everything made in one manufacturing
    run, sharing a common provenance and therefore a COMMON FATE -
    what is contaminated in one unit may be contaminated in all of
    them, and so a recall addresses the batch and never the single
    item.</glossa>
    <glossa lingua="fr">Un lot : tout ce qui a été fait au cours d'une
    même production, partageant une provenance commune et donc un
    DESTIN COMMUN - ce qui est contaminé dans une unité peut l'être
    dans toutes, et c'est pourquoi un rappel vise le lot et jamais
    l'objet isolé.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="numerus-cocturae" genus="textus"/>
    <attributum nomen="quantitas-facta" genus="textus"/>
    <attributum nomen="expirat" genus="dies"/>
    <attributum nomen="status" genus="electio">
      <optio>fabricata</optio>
      <optio>probata</optio>
      <optio>dimissa</optio>
      <optio>revocata</optio>
      <optio>exhausta</optio>
      <optio>elapsa</optio>
    </attributum>
    <attributum nomen="coquitur" genus="referentia"/>
    <attributum nomen="fabricata-a" genus="referentia"/>
    <attributum nomen="acta-sua" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="coctura">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="interactio">
    <glossa lingua="en">An interaction: a relation between two things
    (or more) whose simultaneous presence changes the effect each
    would have on its own. It is not a property of either one but of
    a THIRD thing that arises from their conjunction.</glossa>
    <glossa lingua="fr">Une interaction : une relation entre deux
    choses (ou davantage) dont la présence simultanée modifie
    l'effet que chacune aurait seule. Ce n'est pas une propriété de
    l'une ou de l'autre, mais d'une TROISIÈME chose qui naît de leur
    conjonction.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="gravitas" genus="electio">
      <optio>levis</optio>
      <optio>moderata</optio>
      <optio>gravis</optio>
      <optio>contraindicatio</optio>
    </attributum>
    <attributum nomen="mechanismus" genus="textus"/>
    <attributum nomen="testimonium" genus="textus"/>
    <attributum nomen="consilium" genus="textus"/>
    <attributum nomen="asseritur-per" genus="referentia"/>
    <liberum nomen="inter"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="inter" intra="interactio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="interactio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="plagula-computatralis">
    <glossa lingua="en">A computer file: a NAMED sequence of bytes in
    a file system - an identity that endures while its content
    changes, as a corporate body endures through a change of
    members. It is distinguished from its own content: the file is
    the named thing, the content its passing state.</glossa>
    <glossa lingua="fr">Un fichier informatique : une suite d'octets
    NOMMÉE dans un système de fichiers - une identité qui perdure
    tandis que son contenu change, comme une communauté à travers le
    renouvellement de ses membres. Il se distingue de son propre
    contenu : le fichier est la chose nommée, le contenu son état
    passager.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="forma-contenti" genus="electio">
      <optio>textualis</optio>
      <optio>binaria</optio>
    </attributum>
    <attributum nomen="mimen-solitum" genus="textus"/>
    <attributum nomen="status-exsistentia" genus="electio">
      <optio>exsistens</optio>
      <optio>ablata</optio>
    </attributum>
    <attributum nomen="continetur-in" genus="referentia"/>
    <attributum nomen="conformis-ad" genus="referentia"/>
    <liberum nomen="suffixus-solitus"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="suffixus-solitus" intra="plagula-computatralis" textus="verum"/>
  <elementum nomen="historia" intra="plagula-computatralis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="plagula-fontis">
    <glossa lingua="en">A source file: a named file whose content is
    text written by people and read both by people AND by
    translators - the form of an execution still to come, not the
    execution itself.</glossa>
    <glossa lingua="fr">Un fichier source : un fichier nommé dont le
    contenu est un texte écrit par des personnes et lu à la fois par
    des personnes ET par des compilateurs - la forme d'une exécution
    à venir, non l'exécution elle-même.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="scripta-in" genus="referentia"/>
    <attributum nomen="scripta-in-versione" genus="referentia"/>
    <attributum nomen="forma-contenti" genus="electio" ordinarius="textualis">
      <optio>textualis</optio>
      <optio>binaria</optio>
    </attributum>
    <attributum nomen="mimen-solitum" genus="textus"/>
    <attributum nomen="status-exsistentia" genus="electio">
      <optio>exsistens</optio>
      <optio>ablata</optio>
    </attributum>
    <attributum nomen="continetur-in" genus="referentia"/>
    <attributum nomen="conformis-ad" genus="referentia"/>
    <liberum nomen="suffixus-solitus"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="suffixus-solitus" intra="plagula-fontis" textus="verum"/>
  <elementum nomen="historia" intra="plagula-fontis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="scriptum-exsecutabile">
    <glossa lingua="en">An executable script: a named file to be run
    directly, with no prior compilation - its shebang line (#!)
    names its own interpreter, making it a file that knows how to
    run.</glossa>
    <glossa lingua="fr">Un script exécutable : un fichier nommé
    destiné à être exécuté directement, sans compilation préalable -
    sa ligne shebang (#!) nomme elle-même son interprète, ce qui en
    fait un fichier qui sait comment s'exécuter.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="forma-contenti" genus="electio" ordinarius="textualis">
      <optio>textualis</optio>
      <optio>binaria</optio>
    </attributum>
    <attributum nomen="mimen-solitum" genus="textus"/>
    <attributum nomen="status-exsistentia" genus="electio">
      <optio>exsistens</optio>
      <optio>ablata</optio>
    </attributum>
    <attributum nomen="continetur-in" genus="referentia"/>
    <attributum nomen="conformis-ad" genus="referentia"/>
    <liberum nomen="suffixus-solitus"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="suffixus-solitus" intra="scriptum-exsecutabile" textus="verum"/>
  <elementum nomen="historia" intra="scriptum-exsecutabile">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="plagula-notationis">
    <glossa lingua="en">A markup file: a named file whose content is
    prose with structure interleaved - the marks carry the
    structure, the text carries the sense, laid out by machine for a
    human reader.</glossa>
    <glossa lingua="fr">Un fichier de balisage : un fichier nommé dont
    le contenu est de la prose entrelacée de structure - les signes
    portent la structure, le texte porte le sens, mis en forme par
    la machine pour un lecteur humain.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="forma-contenti" genus="electio" ordinarius="textualis">
      <optio>textualis</optio>
      <optio>binaria</optio>
    </attributum>
    <attributum nomen="mimen-solitum" genus="textus"/>
    <attributum nomen="status-exsistentia" genus="electio">
      <optio>exsistens</optio>
      <optio>ablata</optio>
    </attributum>
    <attributum nomen="continetur-in" genus="referentia"/>
    <attributum nomen="conformis-ad" genus="referentia"/>
    <liberum nomen="suffixus-solitus"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="suffixus-solitus" intra="plagula-notationis" textus="verum"/>
  <elementum nomen="historia" intra="plagula-notationis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="plagula-figurationis">
    <glossa lingua="en">A configuration file: a named file read by a
    program at startup so that it may shape its own behaviour -
    declarative, not executable; it says what, never how.</glossa>
    <glossa lingua="fr">Un fichier de configuration : un fichier nommé
    qu'un programme lit à son démarrage afin de former son propre
    comportement - déclaratif, non exécutif ; il dit quoi, jamais
    comment.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="forma-contenti" genus="electio" ordinarius="textualis">
      <optio>textualis</optio>
      <optio>binaria</optio>
    </attributum>
    <attributum nomen="mimen-solitum" genus="textus"/>
    <attributum nomen="status-exsistentia" genus="electio">
      <optio>exsistens</optio>
      <optio>ablata</optio>
    </attributum>
    <attributum nomen="continetur-in" genus="referentia"/>
    <attributum nomen="conformis-ad" genus="referentia"/>
    <liberum nomen="suffixus-solitus"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="suffixus-solitus" intra="plagula-figurationis" textus="verum"/>
  <elementum nomen="historia" intra="plagula-figurationis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="plagula-datorum">
    <glossa lingua="en">A data file: a named file whose content is
    meant for programs first - the structure is strict, and the
    human reader is a guest there rather than the master.</glossa>
    <glossa lingua="fr">Un fichier de données : un fichier nommé dont
    le contenu s'adresse d'abord aux programmes - la structure y est
    stricte, et le lecteur humain y est un hôte plutôt que le
    maître.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="forma-contenti" genus="electio">
      <optio>textualis</optio>
      <optio>binaria</optio>
    </attributum>
    <attributum nomen="mimen-solitum" genus="textus"/>
    <attributum nomen="status-exsistentia" genus="electio">
      <optio>exsistens</optio>
      <optio>ablata</optio>
    </attributum>
    <attributum nomen="continetur-in" genus="referentia"/>
    <attributum nomen="conformis-ad" genus="referentia"/>
    <liberum nomen="suffixus-solitus"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="suffixus-solitus" intra="plagula-datorum" textus="verum"/>
  <elementum nomen="historia" intra="plagula-datorum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="plagula-sqlite">
    <glossa lingua="en">An SQLite file: a data file holding a whole
    database in a single file - tables, indexes and transactions,
    all within one sequence of bytes, with no server.</glossa>
    <glossa lingua="fr">Un fichier SQLite : un fichier de données
    contenant une base de données entière dans un seul fichier -
    tables, index et transactions, le tout dans une seule suite
    d'octets, sans serveur.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="forma-contenti" genus="electio" ordinarius="binaria">
      <optio>textualis</optio>
      <optio>binaria</optio>
    </attributum>
    <attributum nomen="mimen-solitum" genus="textus"/>
    <attributum nomen="status-exsistentia" genus="electio">
      <optio>exsistens</optio>
      <optio>ablata</optio>
    </attributum>
    <attributum nomen="continetur-in" genus="referentia"/>
    <attributum nomen="conformis-ad" genus="referentia"/>
    <liberum nomen="suffixus-solitus"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="suffixus-solitus" intra="plagula-sqlite" textus="verum"/>
  <elementum nomen="historia" intra="plagula-sqlite">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="systema-plagularum">
    <glossa lingua="en">A file system: the arrangement that gives
    sequences of bytes their NAMES, their place in a tree, and the
    metadata around them - what mediates between the medium (disk,
    network, memory) and names. Without it there are bytes, but
    there are no files.</glossa>
    <glossa lingua="fr">Un système de fichiers : l'organisation qui
    donne aux suites d'octets leurs NOMS, leur place dans une
    arborescence et les métadonnées qui les entourent - ce qui fait
    la médiation entre le support (disque, réseau, mémoire) et les
    noms. Sans lui il y a des octets, mais il n'y a pas de
    fichiers.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="capsas-discernit" genus="veritas"/>
    <attributum nomen="capsas-servat" genus="veritas"/>
    <attributum nomen="mensura-nominis-maxima" genus="numerus"/>
    <attributum nomen="nexus-fert" genus="electio">
      <optio>nullos</optio>
      <optio>symbolicos</optio>
      <optio>duros</optio>
      <optio>utrosque</optio>
    </attributum>
    <attributum nomen="transactiones-fert" genus="veritas"/>
    <attributum nomen="iacet-in" genus="referentia"/>
    <liberum nomen="radix" maximum="1"/>
    <liberum nomen="directorium" maximum="1"/>
    <liberum nomen="notae-circumstantes" maximum="1"/>
    <liberum nomen="continet"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="radix" intra="systema-plagularum">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="directorium" intra="systema-plagularum">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="notae-circumstantes" intra="systema-plagularum">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="continet" intra="systema-plagularum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="systema-plagularum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="directorium">
    <glossa lingua="en">A directory: a named container of files and of
    other directories - a node in the tree of names. Its content is
    not bytes but NAMES, which is why "what is in it" is an
    enumeration and not a reading. It is deliberately not placed
    under file: unix-like systems make a directory a special kind of
    file and others do not, and a taxonomy that builds one system's
    decision into its tree stops describing the other, so the
    relation below states what is true without choosing.</glossa>
    <glossa lingua="fr">Un répertoire : un conteneur nommé de fichiers
    et d'autres répertoires - un nœud de l'arbre des noms. Son
    contenu n'est pas fait d'octets mais de NOMS, d'où le fait que
    « ce qu'il contient » relève de l'énumération et non de la
    lecture. Il n'est délibérément pas placé sous le fichier : les
    systèmes de type unix font du répertoire une sorte particulière
    de fichier, d'autres non, et une taxonomie qui inscrit dans son
    arbre le choix d'un seul système cesse de décrire l'autre ; la
    relation ci-dessous dit donc ce qui est vrai sans
    choisir.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="occultum" genus="veritas"/>
    <attributum nomen="continetur-in" genus="referentia"/>
    <attributum nomen="est-plagula" genus="referentia"/>
    <liberum nomen="continet"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="continet" intra="directorium">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="directorium">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="planta">
    <glossa lingua="en">A plant: a living thing rooted in place that
    turns light into food (photosynthesis); it grows by its parts
    and multiplies by seed or cutting. Vegetative soul only -
    nutrition, growth, generation, without sensation.</glossa>
    <glossa lingua="fr">Une plante : un vivant enraciné qui ne se
    déplace pas et transforme la lumière en nourriture
    (photosynthèse) ; il croît par ses parties et se multiplie par
    graine ou bouture. Âme végétative seule - nutrition,
    croissance, génération, sans sensation.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="habitus" genus="electio">
      <optio>herba</optio>
      <optio>frutex</optio>
      <optio>arbor</optio>
      <optio>scandens</optio>
    </attributum>
    <attributum nomen="durata" genus="electio">
      <optio>annua</optio>
      <optio>biennis</optio>
      <optio>perennis</optio>
    </attributum>
    <attributum nomen="folia-permanentia" genus="electio">
      <optio>decidua</optio>
      <optio>sempervirens</optio>
    </attributum>
    <attributum nomen="altitudo-matura" genus="numerus"/>
    <attributum nomen="status-vita" genus="electio">
      <optio>semen</optio>
      <optio>germinans</optio>
      <optio>iuvenis</optio>
      <optio>florens</optio>
      <optio>fructifera</optio>
      <optio>quiescens</optio>
      <optio>mortua</optio>
    </attributum>
    <attributum nomen="auctor-nominis" genus="referentia"/>
    <attributum nomen="nomen-publicatum-in" genus="referentia"/>
    <attributum nomen="pollinatur-a" genus="referentia"/>
    <attributum nomen="anima" genus="electio">
      <optio>vegetativa</optio>
      <optio>sensitiva</optio>
      <optio>rationalis</optio>
    </attributum>
    <attributum nomen="massa" genus="textus"/>
    <attributum nomen="perituram" genus="veritas"/>
    <attributum nomen="status-conditio" genus="electio">
      <optio>recens</optio>
      <optio>vetus</optio>
      <optio>corrupta</optio>
    </attributum>
    <attributum nomen="sita-in" genus="referentia"/>
    <liberum nomen="radix" maximum="1"/>
    <liberum nomen="caulis" maximum="1"/>
    <liberum nomen="folium" maximum="1"/>
    <liberum nomen="flos" maximum="1"/>
    <liberum nomen="fructus" maximum="1"/>
    <liberum nomen="semen" maximum="1"/>
    <liberum nomen="generat"/>
    <liberum nomen="laborat"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="radix" intra="planta">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="caulis" intra="planta">
