  </elementum>

  <elementum nomen="acta-transactionum">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="ordinatio" genus="electio" ordinarius="sequentialis">
      <optio>sequentialis</optio>
      <optio>temporalis</optio>
