    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="fructus" intra="planta">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="semen" intra="planta">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="generat" intra="planta">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="laborat" intra="planta">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="planta">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="rosaceae">
    <glossa lingua="en">The Rosaceae: a plant family whose flowers
    are usually five-petalled, with stipules at the leaves and
    fruits of many kinds (pome, drupe, aggregate) - a broadly
    varied family united by the structure of its flowers, not by
    the form of its fruits.</glossa>
    <glossa lingua="fr">Les Rosacées : une famille de plantes aux
    fleurs le plus souvent à cinq pétales, avec des stipules à la
    base des feuilles et des fruits de types variés (pomme,
    drupe, fruit agrégé) - une famille très diverse qu'unit la
    structure de ses fleurs, non la forme de ses fruits.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="habitus" genus="electio">
      <optio>herba</optio>
      <optio>frutex</optio>
      <optio>arbor</optio>
      <optio>scandens</optio>
    </attributum>
    <attributum nomen="durata" genus="electio">
      <optio>annua</optio>
      <optio>biennis</optio>
      <optio>perennis</optio>
    </attributum>
    <attributum nomen="folia-permanentia" genus="electio">
      <optio>decidua</optio>
      <optio>sempervirens</optio>
    </attributum>
    <attributum nomen="altitudo-matura" genus="numerus"/>
    <attributum nomen="status-vita" genus="electio">
      <optio>semen</optio>
      <optio>germinans</optio>
      <optio>iuvenis</optio>
      <optio>florens</optio>
      <optio>fructifera</optio>
      <optio>quiescens</optio>
      <optio>mortua</optio>
    </attributum>
    <attributum nomen="auctor-nominis" genus="referentia"/>
    <attributum nomen="nomen-publicatum-in" genus="referentia"/>
    <attributum nomen="pollinatur-a" genus="referentia"/>
    <attributum nomen="anima" genus="electio">
      <optio>vegetativa</optio>
      <optio>sensitiva</optio>
      <optio>rationalis</optio>
    </attributum>
    <attributum nomen="massa" genus="textus"/>
    <attributum nomen="perituram" genus="veritas"/>
    <attributum nomen="status-conditio" genus="electio">
      <optio>recens</optio>
      <optio>vetus</optio>
      <optio>corrupta</optio>
    </attributum>
    <attributum nomen="sita-in" genus="referentia"/>
    <liberum nomen="radix" maximum="1"/>
    <liberum nomen="caulis" maximum="1"/>
    <liberum nomen="folium" maximum="1"/>
    <liberum nomen="flos" maximum="1"/>
    <liberum nomen="fructus" maximum="1"/>
    <liberum nomen="semen" maximum="1"/>
    <liberum nomen="generat"/>
