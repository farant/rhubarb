  </elementum>

  <elementum nomen="procedura">
    <glossa lingua="en">A procedure: an order of operations directed
    to an end - declared inputs, ordered steps, an expected
    outcome. It does not say who is to carry them out, and on that
    silence the whole division below it rests.</glossa>
    <glossa lingua="fr">Une procédure : un ordre d'opérations en vue
    d'une fin - entrées déclarées, étapes ordonnées, résultat
    attendu. Elle ne dit pas qui les exécute, et c'est sur ce
    silence que repose toute la division qui suit.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <liberum nomen="gradus-eius"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="gradus-eius" intra="procedura">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="procedura">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="procedura-automata">
    <glossa lingua="en">An automated procedure: one carried out by a
    MACHINE, and therefore with NO tolerance for ambiguity. Where a
    recipe may say "until it turns golden" because a person judges,
    this must settle everything in numbers and conditions; what is
    trust in a recipe would here be a defect. In exchange it can be
    repeated endlessly with exactly the same effect, which no
    person can promise.</glossa>
    <glossa lingua="fr">Une procédure automatisée : exécutée par une
    MACHINE, et donc SANS aucune tolérance à l'ambiguïté. Là où une
    recette peut dire « jusqu'à ce que ce soit doré » parce qu'un
    homme juge, celle-ci doit tout fixer en nombres et en
    conditions ; ce qui est confiance dans la recette serait ici un
    défaut. En revanche elle peut se répéter à l'infini avec
    exactement le même effet, ce qu'aucun homme ne
    garantit.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="idempotens" genus="veritas"/>
    <attributum nomen="reversibilis" genus="veritas"/>
    <attributum nomen="status-cursus" genus="electio">
      <optio>exspectans</optio>
      <optio>currens</optio>
      <optio>perfecta</optio>
      <optio>lapsa</optio>
      <optio>intercepta</optio>
    </attributum>
    <attributum nomen="porta-humana" genus="referentia"/>
    <attributum nomen="agit-in" genus="referentia"/>
    <liberum nomen="efficit"/>
    <liberum nomen="gradus-eius"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="efficit" intra="procedura-automata">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="gradus-eius" intra="procedura-automata">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="procedura-automata">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="praescriptum">
    <glossa lingua="en">A recipe, or prescribed procedure: an order
    of operations directed to an end and to be carried out BY A
    PERSON - declared inputs (materials, tools), ordered steps, an
    expected outcome. It is the human cousin of a function: the
    same shape, a different executor.</glossa>
    <glossa lingua="fr">Une recette, ou procédure prescrite : un ordre
    d'opérations en vue d'une fin, à exécuter PAR UN HOMME -
    entrées déclarées (matières, instruments), étapes ordonnées,
    résultat attendu. C'est le parent humain de la fonction : même
    forme, exécutant différent.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="peritia-postulata" genus="electio">
      <optio>nulla</optio>
      <optio>mediocris</optio>
      <optio>magna</optio>
    </attributum>
    <attributum nomen="proventus" genus="textus"/>
    <attributum nomen="mora" genus="textus"/>
    <attributum nomen="status-observantia" genus="electio">
      <optio>inceptum</optio>
      <optio>in_cursu</optio>
      <optio>perfectum</optio>
      <optio>desertum</optio>
    </attributum>
    <attributum nomen="exsequitur" genus="referentia"/>
    <attributum nomen="efficit" genus="referentia"/>
    <attributum nomen="publicatum-in" genus="referentia"/>
    <attributum nomen="auctor" genus="referentia"/>
    <attributum nomen="ortum-ex" genus="referentia"/>
    <liberum nomen="materiae" maximum="1"/>
    <liberum nomen="gradus" maximum="1"/>
    <liberum nomen="exitus" maximum="1"/>
    <liberum nomen="postulat"/>
    <liberum nomen="gradus-eius"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="materiae" intra="praescriptum">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="gradus" intra="praescriptum">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="exitus" intra="praescriptum">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="postulat" intra="praescriptum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="gradus-eius" intra="praescriptum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="praescriptum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="gradus-praescripti">
    <glossa lingua="en">A step of a recipe: one operation within the
    order - an action, perhaps with a quantity, perhaps with a
    duration, perhaps with a condition for stopping.</glossa>
    <glossa lingua="fr">Une étape de la recette : une seule opération
    dans l'ordre - une action, éventuellement avec une quantité,
    éventuellement avec une durée, éventuellement avec une
    condition d'arrêt.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="ordo" genus="numerus"/>
    <attributum nomen="mora" genus="textus"/>
    <attributum nomen="conditio-finis" genus="textus"/>
    <attributum nomen="simultaneus" genus="veritas"/>
    <attributum nomen="gradus-de" genus="referentia"/>
    <liberum nomen="pendet-ex"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="pendet-ex" intra="gradus-praescripti">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="gradus-praescripti">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="versio-praescripti">
    <glossa lingua="en">A version of a recipe: a named and citable
    issue of it - a recipe passes through revisions while its
    identity remains ("grandmother's recipe, as revised in
    1998").</glossa>
    <glossa lingua="fr">Une version de la recette : une édition
    nommée et citable - une recette traverse des révisions sans
    que son identité change (« la recette de grand-mère, telle que
    révisée en 1998 »).</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="versio-de" genus="referentia"/>
    <attributum nomen="sequitur" genus="referentia"/>
    <attributum nomen="emendata-a" genus="referentia"/>
    <attributum nomen="titulus" genus="textus"/>
    <attributum nomen="edita" genus="dies"/>
    <attributum nomen="schema-numerandi" genus="electio">
      <optio>semanticum</optio>
      <optio>sequentiale</optio>
      <optio>temporale</optio>
      <optio>nominale</optio>
      <optio>mixtum</optio>
    </attributum>
    <attributum nomen="retro-compatibilis" genus="veritas"/>
    <attributum nomen="mutationes-fractoriae" genus="textus"/>
    <attributum nomen="status-sustentatio" genus="electio">
      <optio>praenuntiata</optio>
      <optio>vigens</optio>
      <optio>sustentata</optio>
      <optio>deprecata</optio>
      <optio>derelicta</optio>
    </attributum>
    <attributum nomen="asseritur-per" genus="referentia"/>
    <attributum nomen="edita-a" genus="referentia"/>
    <liberum nomen="compatibilis-cum"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="compatibilis-cum" intra="versio-praescripti">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="versio-praescripti">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="index-verificationis">
    <glossa lingua="en">A checklist: a procedure that CONFIRMS what
    has been done; it does not teach how to do it. The one who runs
    it already holds the art - the list exists because KNOWING IS
    NOT DOING under burden, haste and fatigue. The failure it
    prevents is therefore not ignorance but OMISSION.</glossa>
    <glossa lingua="fr">Une liste de vérification : une procédure qui
    CONFIRME ce qui a été fait ; elle n'enseigne pas comment le
    faire. Celui qui l'exécute possède déjà l'art - la liste existe
    parce que SAVOIR N'EST PAS FAIRE sous la charge, la hâte et la
    fatigue. Le défaut qu'elle empêche n'est donc pas l'ignorance
    mais l'OMISSION.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="modus" genus="electio">
      <optio>facere_confirmare</optio>
      <optio>legere_facere</optio>
    </attributum>
    <attributum nomen="pro-casu" genus="veritas"/>
    <attributum nomen="confirmat" genus="referentia"/>
    <liberum nomen="adhibetur-in"/>
    <liberum nomen="gradus-eius"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="adhibetur-in" intra="index-verificationis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="gradus-eius" intra="index-verificationis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="index-verificationis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="schema">
    <glossa lingua="en">A schema: a declared form for data - the
    shape that things of the same kind must fill out: named
    fields, kinds of value, requirements. It is a promise about
    FUTURE data: the schema is written today, the things arrive
    tomorrow.</glossa>
    <glossa lingua="fr">Un schéma : une forme de données déclarée
    - la figure que doivent remplir les choses d'un même genre :
    champs nommés, genres de valeurs, obligations. C'est une
    promesse portant sur les données À VENIR : le schéma s'écrit
    aujourd'hui, les choses arrivent demain.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="disciplina" genus="electio">
      <optio>constringens</optio>
      <optio>iudicans</optio>
    </attributum>
    <attributum nomen="describit" genus="referentia"/>
    <liberum nomen="continet"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="continet" intra="schema">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="schema">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="campus">
    <glossa lingua="en">A field: a named place in a schema - a
    name, a kind of value, a requirement. It is the atom of the
    form: a schema is made of fields as a sentence is made of
    words.</glossa>
    <glossa lingua="fr">Un champ : un emplacement nommé dans un
    schéma - un nom, un genre de valeur, une obligation. C'est
    l'atome de la forme : un schéma est fait de champs comme une
    phrase est faite de mots.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="necessarius" genus="veritas"/>
    <attributum nomen="multiplex" genus="veritas"/>
    <attributum nomen="ordinarius-valor" genus="textus"/>
    <attributum nomen="campus-de" genus="referentia"/>
    <attributum nomen="genus-eius" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="campus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="genus-valoris">
    <glossa lingua="en">A kind of value: the kind of value a field
    can hold - the INTENT of the value, not its machine
    representation; s32 and char* are realizations (the language
    type supplies the matter, the kind of value the form). A date
    stays a date, whether a string or a number lies under
    it.</glossa>
    <glossa lingua="fr">Un genre de valeur : le genre de valeur
    qu'un champ peut contenir - l'INTENTION de la valeur, non sa
    représentation machine ; s32 et char* en sont des
    réalisations (le type du langage fournit la matière, le genre
    de valeur la forme). Une date reste une date, qu'une chaîne
    ou un nombre se trouve dessous.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="genus-valoris">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="systema-operativum">
    <glossa lingua="en">An operating system: the primary program that
    owns the machine and mediates between the hardware and other
    programs - it hands out memory, guards and schedules processes,
    gives names to files, and offers facilities. The program that
    lets programs run.</glossa>
    <glossa lingua="fr">Un système d'exploitation : le programme
    primordial qui possède la machine et fait la médiation entre le
    matériel et les autres programmes - il distribue la mémoire,
    garde et ordonne les processus, donne des noms aux fichiers,
    offre des facultés. Le programme qui permet aux programmes de
    s'exécuter.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="genus-nuclei" genus="electio">
      <optio>monolithicus</optio>
      <optio>micronucleus</optio>
      <optio>hybridus</optio>
    </attributum>
    <attributum nomen="fons-apertus" genus="veritas"/>
    <attributum nomen="multiplex-processuum" genus="veritas"/>
    <attributum nomen="multiplex-usorum" genus="veritas"/>
    <attributum nomen="status-cursus" genus="electio">
      <optio>exstinctum</optio>
      <optio>initians</optio>
      <optio>currens</optio>
      <optio>dormiens</optio>
    </attributum>
    <attributum nomen="orta-ex" genus="referentia"/>
    <attributum nomen="ad-exemplum-facta" genus="referentia"/>
    <attributum nomen="edita-a" genus="referentia"/>
    <attributum nomen="habet-versionem" genus="referentia"/>
    <attributum nomen="praebet-systema-plagularum" genus="referentia"/>
    <liberum nomen="auctor"/>
    <liberum nomen="exsequitur-in"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="auctor" intra="systema-operativum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="exsequitur-in" intra="systema-operativum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="systema-operativum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="systema-unixiforme">
    <glossa lingua="en">A Unix-like system: an operating system shaped
    on the Unix pattern - one file tree from a single root,
    "everything is a file", small processes composed with pipes, the
    shell as a program among the rest. This is FORM and not descent,
    so both the true offspring (macOS) and the imitations (Linux)
    belong here, and the relations orta_ex and ad_exemplum_facta
    then tell the two apart.</glossa>
    <glossa lingua="fr">Un système de type Unix : un système
    d'exploitation formé sur le modèle Unix - un seul arbre de
    fichiers depuis une racine unique, « tout est fichier », de
    petits processus composés par des tubes, l'interpréteur de
    commandes comme un programme parmi les autres. C'est la FORME et
    non la descendance : la vraie progéniture (macOS) comme les
    imitations (Linux) tiennent ici, et les relations orta_ex et
    ad_exemplum_facta les distinguent ensuite.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="genus-nuclei" genus="electio">
      <optio>monolithicus</optio>
      <optio>micronucleus</optio>
      <optio>hybridus</optio>
    </attributum>
    <attributum nomen="fons-apertus" genus="veritas"/>
    <attributum nomen="multiplex-processuum" genus="veritas"/>
    <attributum nomen="multiplex-usorum" genus="veritas"/>
    <attributum nomen="status-cursus" genus="electio">
      <optio>exstinctum</optio>
      <optio>initians</optio>
      <optio>currens</optio>
      <optio>dormiens</optio>
    </attributum>
    <attributum nomen="orta-ex" genus="referentia"/>
    <attributum nomen="ad-exemplum-facta" genus="referentia"/>
    <attributum nomen="edita-a" genus="referentia"/>
    <attributum nomen="habet-versionem" genus="referentia"/>
    <attributum nomen="praebet-systema-plagularum" genus="referentia"/>
    <liberum nomen="auctor"/>
    <liberum nomen="exsequitur-in"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="auctor" intra="systema-unixiforme">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="exsequitur-in" intra="systema-unixiforme">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="systema-unixiforme">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="distributio-systematis">
    <glossa lingua="en">A system distribution: a curated collection -
    kernel plus tools plus configurations plus a package manager -
    chosen, tested, and released by one curator. The operating
    system is the form; the distribution is the edition of that form
    made fit to live in, and it is what you actually install.</glossa>
    <glossa lingua="fr">Une distribution de système : une collection
    curatée - noyau, outils, configurations et gestionnaire de
    paquets - choisie, éprouvée et publiée par un seul curateur. Le
    système d'exploitation est la forme ; la distribution en est
    l'édition rendue habitable, et c'est elle que l'on installe
    réellement.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="gestor-fasciculorum" genus="textus"/>
    <attributum nomen="cadentia-editionum" genus="electio">
      <optio>statuta</optio>
      <optio>volvens</optio>
    </attributum>
    <attributum nomen="distributio-de" genus="referentia"/>
    <attributum nomen="orta-ex" genus="referentia"/>
    <attributum nomen="edita-a" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="distributio-systematis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="versio-systematis">
    <glossa lingua="en">A system version: a named edition of an
    operating system - the one an installation actually runs.
    "Darwin 23.6" cites a version, not a species.</glossa>
    <glossa lingua="fr">Une version de système : une édition nommée
    d'un système d'exploitation - celle qu'une installation exécute
    réellement. « Darwin 23.6 » cite une version, non une
    espèce.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="titulus" genus="textus"/>
    <attributum nomen="edita" genus="dies"/>
    <attributum nomen="versio-de" genus="referentia"/>
    <attributum nomen="sequitur" genus="referentia"/>
    <attributum nomen="schema-numerandi" genus="electio">
      <optio>semanticum</optio>
      <optio>sequentiale</optio>
      <optio>temporale</optio>
      <optio>nominale</optio>
      <optio>mixtum</optio>
    </attributum>
    <attributum nomen="retro-compatibilis" genus="veritas"/>
    <attributum nomen="mutationes-fractoriae" genus="textus"/>
    <attributum nomen="status-sustentatio" genus="electio">
      <optio>praenuntiata</optio>
      <optio>vigens</optio>
      <optio>sustentata</optio>
      <optio>deprecata</optio>
      <optio>derelicta</optio>
    </attributum>
    <attributum nomen="asseritur-per" genus="referentia"/>
    <attributum nomen="edita-a" genus="referentia"/>
    <liberum nomen="compatibilis-cum"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="compatibilis-cum" intra="versio-systematis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="versio-systematis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="momentum">
    <glossa lingua="en">A moment: a point in time - when something
    happens. It has no duration; what lasts is an interval. Every
    event has its moment, and the histories in every model hang from
    this.</glossa>
    <glossa lingua="fr">Un moment : un point dans le temps - quand
    quelque chose arrive. Il est sans durée ; ce qui dure est un
    intervalle. Tout événement a son moment, et les histoires de
    tous les modèles en dépendent.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="praecisio" genus="electio">
      <optio>annus</optio>
      <optio>mensis</optio>
      <optio>dies</optio>
      <optio>hora</optio>
      <optio>secundum</optio>
      <optio>minutia</optio>
    </attributum>
    <attributum nomen="zona-horaria" genus="textus"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="momentum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="intervallum">
    <glossa lingua="en">An interval: the stretch of time between two
    moments - a beginning, an end, and therefore a duration. What
    has no duration is a moment; what has no end, being still
    running, is an open interval, and that is a true state rather
    than missing data.</glossa>
    <glossa lingua="fr">Un intervalle : l'étendue de temps entre deux
    moments - un début, une fin, et donc une durée. Ce qui est sans
    durée est un moment ; ce qui est sans fin, parce qu'il court
    encore, est un intervalle ouvert, et c'est là un état véritable
    et non une donnée manquante.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="duratio" genus="textus"/>
    <attributum nomen="initium" genus="referentia"/>
    <attributum nomen="finis" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="intervallum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="recurrentia">
    <glossa lingua="en">A recurrence: a rule that generates moments
    (or intervals) - "every day at the fourth hour", "every Monday",
    "the first day of each month". It is a rule and not a
    collection, and the collection it yields is often infinite. Keep
    it as a rule: whoever expands it into records cuts the future
    off at some arbitrary bound.</glossa>
    <glossa lingua="fr">Une récurrence : une règle qui engendre des
    moments (ou des intervalles) - « chaque jour à la quatrième
    heure », « chaque lundi », « le premier jour de chaque mois ».
    C'est une règle et non une collection, et la collection qu'elle
    produit est souvent infinie. Il faut la garder comme règle : qui
    la déplie en enregistrements tronque l'avenir à une borne
    arbitraire.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="periodus" genus="electio">
      <optio>cotidiana</optio>
      <optio>hebdomadaria</optio>
      <optio>menstrua</optio>
      <optio>annua</optio>
    </attributum>
    <attributum nomen="frequentia" genus="numerus"/>
    <liberum nomen="exceptiones"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="exceptiones" intra="recurrentia" textus="dies"/>
  <elementum nomen="historia" intra="recurrentia">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="recurrentia-computata">
    <glossa lingua="en">A computed recurrence: a rule generating
    moments whose moments arise not from a simple period but from an
    algorithm - the rule itself contains a calculation, often
    consulting the heavenly bodies or other recurrences. So "when
    next?" cannot be answered without computing it, which a merely
    periodic rule can always do.</glossa>
    <glossa lingua="fr">Une récurrence calculée : une règle
    engendrant des moments qui ne naissent pas d'une période simple
    mais d'un algorithme - la règle contient elle-même un calcul,
    consultant souvent les corps célestes ou d'autres récurrences.
    Aussi la question « la prochaine, quand ? » ne peut-elle
    recevoir de réponse sans calcul, ce qu'une règle simplement
    périodique permet toujours.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="algorithmus" genus="textus"/>
    <attributum nomen="pendet-ex-alia" genus="veritas"/>
    <attributum nomen="periodus" genus="electio">
      <optio>cotidiana</optio>
      <optio>hebdomadaria</optio>
      <optio>menstrua</optio>
      <optio>annua</optio>
    </attributum>
    <attributum nomen="frequentia" genus="numerus"/>
    <liberum nomen="exceptiones"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="exceptiones" intra="recurrentia-computata" textus="dies"/>
  <elementum nomen="historia" intra="recurrentia-computata">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="recurrentia-per-usum">
    <glossa lingua="en">A usage-based recurrence: a rule generating
    moments that is governed not by time but by accumulated use -
    hours of work, cycles, distance covered. An idle tool therefore
    never comes due while a hard-worked one comes due often, which
    time by itself could never say.</glossa>
    <glossa lingua="fr">Une récurrence à l'usage : une règle
    engendrant des moments qui est réglée non par le temps mais par
    l'usage accumulé - heures de travail, cycles, distance
    parcourue. Un outil au repos n'échoit donc jamais, un outil très
    employé souvent, ce que le temps seul ne saurait dire.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="mensura-usus" genus="textus"/>
    <attributum nomen="periodus" genus="electio">
      <optio>cotidiana</optio>
      <optio>hebdomadaria</optio>
      <optio>menstrua</optio>
      <optio>annua</optio>
    </attributum>
    <attributum nomen="frequentia" genus="numerus"/>
    <liberum nomen="exceptiones"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="exceptiones" intra="recurrentia-per-usum" textus="dies"/>
  <elementum nomen="historia" intra="recurrentia-per-usum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="horarium">
    <glossa lingua="en">A schedule: recurrences composed into an
    order by which work is governed - opening hours, worker shifts,
    the sequence of baking. Not one rule but a system of rules that
    agree with one another, or fail to, which is where shift
    conflicts come from.</glossa>
    <glossa lingua="fr">Un horaire : des récurrences composées en un
    ordre qui régit le travail - heures d'ouverture, tours des
    ouvriers, suite des cuissons. Non pas une règle unique mais un
    système de règles qui s'accordent entre elles, ou ne s'accordent
    pas, d'où les conflits de tours.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="regit" genus="referentia"/>
    <liberum nomen="continet"/>
    <liberum nomen="vinctum-per"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="continet" intra="horarium">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="vinctum-per" intra="horarium">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="horarium">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="calendarium">
    <glossa lingua="en">A calendar: the system by which days are
    named and ordered - months, weeks, years, feast days. It is a
    convention that has a history: calendars change, and a change
    really does delete days.</glossa>
    <glossa lingua="fr">Un calendrier : le système par lequel les
    jours sont nommés et ordonnés - mois, semaines, années, jours de
    fête. C'est une convention pourvue d'une histoire : les
    calendriers changent, et un changement supprime réellement des
    jours.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="conditum-a" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="calendarium">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="reservatio">
    <glossa lingua="en">A reservation: a claim on future capacity -
    an interval together with a thing (a seat, a room, an hour with
    the doctor) held for someone so that it is not given to another.
    It brings two things to birth at once: a right in the one who
    claims and an obligation in the one who holds.</glossa>
    <glossa lingua="fr">Une réservation : la revendication d'une
    capacité future - un intervalle et une chose (un siège, une
    chambre, une heure chez le médecin) gardés pour quelqu'un afin
    de n'être pas donnés à un autre. Elle fait naître deux choses à
    la fois : un droit chez celui qui réserve et une obligation chez
    celui qui garde.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="status-vita" genus="electio">
      <optio>petita</optio>
      <optio>confirmata</optio>
      <optio>adhibita</optio>
      <optio>deserta</optio>
      <optio>cancellata</optio>
    </attributum>
    <attributum nomen="tempus-servatum" genus="referentia"/>
    <attributum nomen="res-servata" genus="referentia"/>
    <attributum nomen="vindicans" genus="referentia"/>
    <attributum nomen="parit" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="historia" intra="reservatio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="iter">
    <glossa lingua="en">A journey: the movement of a thing or a person
    from one place to another, undertaken with a purpose - a
    beginning, an end, a route, a time. Not a place but a CHANGE of
    place: what the model of place could not say, this says.</glossa>
    <glossa lingua="fr">Un trajet : le mouvement d'une chose ou d'une
    personne d'un lieu à un autre, entrepris dans un but - un
    commencement, une fin, une voie, un temps. Non pas un lieu mais
    un CHANGEMENT de lieu : ce que le modèle du lieu ne pouvait pas
    dire, celui-ci le dit.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="distantia" genus="textus"/>
    <attributum nomen="mora-aestimata" genus="textus"/>
    <attributum nomen="status-cursus" genus="electio">
      <optio>paratum</optio>
      <optio>in_cursu</optio>
      <optio>perfectum</optio>
      <optio>interruptum</optio>
    </attributum>
    <attributum nomen="a-loco" genus="referentia"/>
    <attributum nomen="ad-locum" genus="referentia"/>
    <attributum nomen="vehitur" genus="referentia"/>
    <attributum nomen="suscipitur-a" genus="referentia"/>
    <liberum nomen="per-viam"/>
    <liberum nomen="fert"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="per-viam" intra="iter">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="fert" intra="iter">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="iter">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="via">
    <glossa lingua="en">A route: a way along which one can travel,
    usually a public thing, common to countless journeys. It exists
    before any journey and remains after it - the via Appia lies
    there today though no one carries freight along it. Hence not a
    journey but the CONDITION of a journey.</glossa>
    <glossa lingua="fr">Une voie : un chemin par lequel on peut aller,
    le plus souvent une chose publique, commune à d'innombrables
    trajets. Elle est là avant tout trajet et demeure après lui - la
    via Appia subsiste aujourd'hui bien que personne n'y transporte
    de marchandises. Donc non pas un trajet mais la CONDITION du
    trajet.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="longitudo" genus="textus"/>
    <attributum nomen="publica" genus="veritas"/>
    <liberum nomen="iungit"/>
    <liberum nomen="sub-iurisdictione"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="iungit" intra="via">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="sub-iurisdictione" intra="via">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="via">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="vehiculum">
    <glossa lingua="en">A vehicle: a tool whose use is MOTION - it
    moves itself and carries other things. Its capacity and the
    route proper to it determine its essence: a ship does what a
    wagon cannot, a wagon reaches where a ship never arrives.</glossa>
    <glossa lingua="fr">Un véhicule : un instrument dont l'usage est le
    MOUVEMENT - il se déplace lui-même et transporte autre chose. Sa
    capacité et la voie qui lui est propre déterminent son essence :
    le navire fait ce que le chariot ne peut pas, le chariot atteint
    là où le navire ne parvient jamais.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="capacitas-oneris" genus="textus"/>
    <attributum nomen="velocitas-media" genus="textus"/>
    <attributum nomen="regitur-a" genus="referentia"/>
    <attributum nomen="capacitas" genus="textus"/>
    <attributum nomen="status-usus" genus="electio">
      <optio>otiosum</optio>
      <optio>in_usu</optio>
      <optio>in_reparatione</optio>
      <optio>fractum</optio>
    </attributum>
    <attributum nomen="factum-per" genus="referentia"/>
    <attributum nomen="factum-a" genus="referentia"/>
    <attributum nomen="massa" genus="textus"/>
    <attributum nomen="perituram" genus="veritas"/>
    <attributum nomen="status-conditio" genus="electio">
      <optio>recens</optio>
      <optio>vetus</optio>
      <optio>corrupta</optio>
    </attributum>
    <attributum nomen="sita-in" genus="referentia"/>
    <liberum nomen="apta-viae"/>
    <liberum nomen="materiae-constituentes" maximum="1"/>
    <liberum nomen="ex-materia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="apta-viae" intra="vehiculum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="materiae-constituentes" intra="vehiculum">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="ex-materia" intra="vehiculum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="vehiculum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="onus">
    <glossa lingua="en">Freight: bodily things while under way - not a
    kind of thing but a CONDITION of things. The same barrel is
    freight while it is carried, merchandise while it is sold,
    furniture while it is used. A role, and therefore a
    relation.</glossa>
    <glossa lingua="fr">Une cargaison : des choses corporelles en cours
    de trajet - non pas un genre de choses mais une CONDITION des
    choses. Le même tonneau est cargaison tant qu'on le transporte,
    marchandise tant qu'on le vend, mobilier tant qu'on s'en sert.
    Un rôle, donc une relation.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="massa-tota" genus="textus"/>
    <attributum nomen="periturum" genus="veritas"/>
    <attributum nomen="status-custodia" genus="electio">
      <optio>susceptum</optio>
      <optio>in_itinere</optio>
      <optio>traditum</optio>
      <optio>amissum</optio>
    </attributum>
    <attributum nomen="fertur-per" genus="referentia"/>
    <attributum nomen="possessio-eius" genus="referentia"/>
    <liberum nomen="continet"/>
    <liberum nomen="passum"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="continet" intra="onus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="passum" intra="onus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="onus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="versio">
    <glossa lingua="en">A version: a named and citable edition of a
    thing, which marks that thing itself across enduring change -
    there is one thing and many versions, and a version is not
    another thing but the same thing as it stood at that time. What
    makes the second version the same thing as the first is not the
    content, which has changed (that is precisely why there is a new
    version), but the continuity of the naming authority and of the
    purpose. Where either of these fails, what you have is not a new
    version but a different thing - hence forks, which are not
    versions but births.</glossa>
    <glossa lingua="fr">Une version : une édition nommée et citable
    d'une chose, qui marque cette chose même à travers un changement
    qui dure - il y a une seule chose et plusieurs versions, et une
    version n'est pas une autre chose mais la même chose telle
    qu'elle était alors. Ce qui fait que la seconde version est la
    même chose que la première n'est pas le contenu, qui a changé
    (c'est bien pour cela qu'il y a une version nouvelle), mais la
    continuité de l'autorité qui nomme et celle de la fin
    poursuivie. Là où l'une des deux manque, ce n'est plus une
    version nouvelle mais une autre chose - d'où les fourches, qui
    ne sont pas des versions mais des naissances.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="titulus" genus="textus"/>
    <attributum nomen="edita" genus="dies"/>
    <attributum nomen="schema-numerandi" genus="electio">
      <optio>semanticum</optio>
      <optio>sequentiale</optio>
      <optio>temporale</optio>
      <optio>nominale</optio>
      <optio>mixtum</optio>
    </attributum>
    <attributum nomen="retro-compatibilis" genus="veritas"/>
    <attributum nomen="mutationes-fractoriae" genus="textus"/>
    <attributum nomen="status-sustentatio" genus="electio">
      <optio>praenuntiata</optio>
      <optio>vigens</optio>
      <optio>sustentata</optio>
      <optio>deprecata</optio>
      <optio>derelicta</optio>
    </attributum>
    <attributum nomen="versio-de" genus="referentia"/>
    <attributum nomen="sequitur" genus="referentia"/>
    <attributum nomen="asseritur-per" genus="referentia"/>
    <attributum nomen="edita-a" genus="referentia"/>
    <liberum nomen="compatibilis-cum"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="compatibilis-cum" intra="versio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="versio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="acta-publica">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="ordinatio" genus="electio">
      <optio>sequentialis</optio>
      <optio>temporalis</optio>
      <optio>utraque</optio>
    </attributum>
    <attributum nomen="immutabilitas" genus="electio">
