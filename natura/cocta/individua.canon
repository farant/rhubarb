    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="malus">
    <glossa lingua="en">Malus: the apple genus of the Rosaceae,
      whose fruit is a POME (a fleshy hypanthium enclosing the
      seeds), not a drupe nor a hip.</glossa>
    <glossa lingua="fr">Malus : le genre du pommier, dans les
      Rosacées, dont le fruit est une POMME (un hypanthe charnu
      qui enferme les graines), non une drupe ni un
      cynorhodon.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="habitus" genus="electio" ordinarius="arbor">
      <optio>herba</optio>
      <optio>frutex</optio>
      <optio>arbor</optio>
      <optio>scandens</optio>
    </attributum>
    <attributum nomen="durata" genus="electio" ordinarius="perennis">
      <optio>annua</optio>
      <optio>biennis</optio>
      <optio>perennis</optio>
    </attributum>
    <attributum nomen="folia-permanentia" genus="electio" ordinarius="decidua">
      <optio>decidua</optio>
      <optio>sempervirens</optio>
    </attributum>
    <attributum nomen="altitudo-matura" genus="numerus"/>
    <attributum nomen="status-vita" genus="electio">
      <optio>semen</optio>
      <optio>germinans</optio>
      <optio>iuvenis</optio>
      <optio>florens</optio>
      <optio>fructifera</optio>
      <optio>quiescens</optio>
      <optio>mortua</optio>
    </attributum>
    <attributum nomen="auctor-nominis" genus="referentia"/>
    <attributum nomen="nomen-publicatum-in" genus="referentia"/>
    <attributum nomen="pollinatur-a" genus="referentia"/>
    <attributum nomen="anima" genus="electio">
      <optio>vegetativa</optio>
      <optio>sensitiva</optio>
      <optio>rationalis</optio>
    </attributum>
    <attributum nomen="massa" genus="textus"/>
    <attributum nomen="perituram" genus="veritas"/>
    <attributum nomen="status-conditio" genus="electio">
      <optio>recens</optio>
      <optio>vetus</optio>
      <optio>corrupta</optio>
    </attributum>
    <attributum nomen="sita-in" genus="referentia"/>
