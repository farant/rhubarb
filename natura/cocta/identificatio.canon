    <liberum nomen="ndc"/>
    <liberum nomen="rxnorm"/>
    <liberum nomen="numerus-dea"/>
  </elementum>

  <elementum nomen="schema-identificandi">
    <glossa lingua="en">An identification scheme: an established way
    of assigning names to things, such that one name designates one
    thing within its scope - a defined structure, an administering
    authority, rules for assignment. It is not the identifier
    itself but the FORM of identifiers: ISBN is a scheme,
    "978-0-13-110362-7" is an identifier.</glossa>
    <glossa lingua="fr">Un schéma d'identification : une manière
    instituée d'assigner des noms aux choses, de sorte qu'un seul
    nom désigne une seule chose dans son domaine - une structure
    définie, une autorité administrante, des règles d'assignation.
    Ce n'est pas l'identifiant lui-même mais la FORME des
    identifiants : l'ISBN est un schéma, « 978-0-13-110362-7 » est
    un identifiant.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="quid-designat" genus="textus"/>
    <attributum nomen="opacus" genus="veritas"/>
    <attributum nomen="reassignabilis" genus="veritas"/>
    <attributum nomen="probabilis-solus" genus="veritas"/>
    <attributum nomen="longitudo-fixa" genus="veritas"/>
    <attributum nomen="praesentatio" genus="textus"/>
    <attributum nomen="status-vigor" genus="electio">
      <optio>vigens</optio>
      <optio>clausa</optio>
      <optio>obsoleta</optio>
    </attributum>
    <attributum nomen="administrata-a" genus="referentia"/>
    <attributum nomen="normata-per" genus="referentia"/>
    <attributum nomen="gignit" genus="referentia"/>
    <attributum nomen="successit" genus="referentia"/>
    <liberum nomen="praefixum" maximum="1"/>
    <liberum nomen="corpus-identificatoris" maximum="1"/>
    <liberum nomen="nota-custos" maximum="1"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="praefixum" intra="schema-identificandi">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="corpus-identificatoris" intra="schema-identificandi">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="nota-custos" intra="schema-identificandi">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="historia" intra="schema-identificandi">
    <liberum nomen="eventum"/>
  </elementum>

