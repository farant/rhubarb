<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATUM a natura_canones e identificatio - NOLI MANU MUTARE.
     Regenera: ./tools/natura_canones.sh -->
<canon dialectus="identificatio" versio="1">

  <elementum nomen="individua" radix="verum">
    <liberum nomen="schema-identificandi"/>
    <liberum nomen="uuid"/>
    <liberum nomen="ulid"/>
