  <elementum nomen="sacramentale">
    <glossa lingua="en">A sacramental: a rite instituted by the Church
    and not by Christ - it places its effect EX OPERE OPERANTIS,
    from the disposition of the one acting and from the prayers of
    the Church, and not from the work itself. It therefore admits
    degrees of efficacy where a sacrament has a binary
    threshold.</glossa>
    <glossa lingua="fr">Un sacramental : un rite institué par l'Église
    et non par le Christ - il pose son effet EX OPERE OPERANTIS, par
    la disposition de celui qui agit et par les prières de l'Église,
    et non par l'œuvre elle-même. Il connaît donc des degrés
    d'efficacité là où le sacrement n'a qu'un seuil binaire.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="materia-ritus" genus="textus"/>
    <attributum nomen="minister" genus="referentia"/>
    <attributum nomen="recipiens" genus="referentia"/>
    <attributum nomen="adhibet" genus="referentia"/>
    <attributum nomen="forma-praescripta" genus="textus"/>
    <attributum nomen="intentio-necessaria" genus="veritas"/>
    <attributum nomen="testes-postulati" genus="numerus"/>
    <attributum nomen="iterabilis" genus="veritas"/>
    <attributum nomen="revocabilis" genus="veritas"/>
    <attributum nomen="status-vigor" genus="electio">
      <optio>perfectus</optio>
      <optio>irritus</optio>
      <optio>rescissus</optio>
      <optio>solutus</optio>
    </attributum>
    <attributum nomen="agens" genus="referentia"/>
    <attributum nomen="capacitas-per" genus="referentia"/>
    <attributum nomen="constituit" genus="referentia"/>
    <attributum nomen="afficit" genus="referentia"/>
    <attributum nomen="secundum-legem" genus="referentia"/>
    <attributum nomen="forma-eius" genus="referentia"/>
    <liberum nomen="testes"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="testes" intra="sacramentale">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="sacramentale">
    <liberum nomen="eventum"/>
  </elementum>

