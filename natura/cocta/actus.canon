  <elementum nomen="actus-sollemnis">
    <glossa lingua="en">A solemn act: an act whose EFFECT depends on a
    prescribed form and on the capacity of the agent, and which is
    therefore VALID or VOID rather than good or bad - what is done
    rightly places its effect infallibly, what is done defectively
    places nothing at all. INSTITUTIONAL facts arise from here:
    offices, titles, obligations, and possessions do not come about
    of themselves but are constituted by a solemn act.</glossa>
    <glossa lingua="fr">Un acte solennel : un acte dont l'EFFET dépend
    d'une forme prescrite et de la capacité de l'agent, et qui est
    donc VALIDE ou NUL, non pas bon ou mauvais - ce qui est fait
    correctement pose son effet infailliblement, ce qui est fait de
    façon vicieuse ne pose rien. Les faits INSTITUÉS naissent de là :
    offices, titres, obligations et possessions ne se font pas
    d'eux-mêmes mais sont constitués par un acte solennel.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="forma-praescripta" genus="textus"/>
    <attributum nomen="intentio-necessaria" genus="veritas"/>
    <attributum nomen="testes-postulati" genus="numerus"/>
    <attributum nomen="iterabilis" genus="veritas"/>
    <attributum nomen="revocabilis" genus="veritas"/>
    <attributum nomen="status-vigor" genus="electio">
      <optio>perfectus</optio>
      <optio>irritus</optio>
      <optio>rescissus</optio>
      <optio>solutus</optio>
    </attributum>
    <attributum nomen="agens" genus="referentia"/>
    <attributum nomen="capacitas-per" genus="referentia"/>
    <attributum nomen="constituit" genus="referentia"/>
    <attributum nomen="afficit" genus="referentia"/>
    <attributum nomen="secundum-legem" genus="referentia"/>
    <attributum nomen="forma-eius" genus="referentia"/>
    <liberum nomen="testes"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="testes" intra="actus-sollemnis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="actus-sollemnis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="ritus">
    <glossa lingua="en">A rite: a solemn act ordered to divine worship
    - a sensible matter and a form of words, through a minister, for
    a spiritual effect. What civil authority supplies in a juridical
    act, divine or ecclesiastical institution supplies here.</glossa>
    <glossa lingua="fr">Un rite : un acte solennel ordonné au culte
    divin - une matière sensible et une forme de paroles, par un
    ministre, en vue d'un effet spirituel. Ce que l'autorité civile
    fournit dans un acte juridique, l'institution divine ou
    ecclésiastique le fournit ici.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="materia-ritus" genus="textus"/>
    <attributum nomen="minister" genus="referentia"/>
    <attributum nomen="recipiens" genus="referentia"/>
    <attributum nomen="adhibet" genus="referentia"/>
    <attributum nomen="forma-praescripta" genus="textus"/>
    <attributum nomen="intentio-necessaria" genus="veritas"/>
    <attributum nomen="testes-postulati" genus="numerus"/>
    <attributum nomen="iterabilis" genus="veritas"/>
    <attributum nomen="revocabilis" genus="veritas"/>
    <attributum nomen="status-vigor" genus="electio">
      <optio>perfectus</optio>
      <optio>irritus</optio>
      <optio>rescissus</optio>
      <optio>solutus</optio>
    </attributum>
    <attributum nomen="agens" genus="referentia"/>
    <attributum nomen="capacitas-per" genus="referentia"/>
    <attributum nomen="constituit" genus="referentia"/>
    <attributum nomen="afficit" genus="referentia"/>
    <attributum nomen="secundum-legem" genus="referentia"/>
    <attributum nomen="forma-eius" genus="referentia"/>
    <liberum nomen="testes"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="testes" intra="ritus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="ritus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="sacramentum">
    <glossa lingua="en">A sacrament: a rite that is an efficacious sign
    of grace, instituted by Christ - it places its effect EX OPERE
    OPERATO, from the act itself rightly performed, and not from the
    worthiness of the minister or of the recipient. An unworthy
    minister therefore acts validly, which separates the form from
    the man ENTIRELY.</glossa>
    <glossa lingua="fr">Un sacrement : un rite qui est signe efficace
    de la grâce, institué par le Christ - il pose son effet EX OPERE
    OPERATO, par l'acte lui-même correctement posé, et non par la
    dignité du ministre ou de celui qui le reçoit. Un ministre
    indigne agit donc validement, ce qui sépare TOTALEMENT la forme
    de l'homme.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="materia-ritus" genus="textus"/>
    <attributum nomen="minister" genus="referentia"/>
    <attributum nomen="recipiens" genus="referentia"/>
    <attributum nomen="adhibet" genus="referentia"/>
    <attributum nomen="forma-praescripta" genus="textus"/>
    <attributum nomen="intentio-necessaria" genus="veritas" ordinarius="verum"/>
    <attributum nomen="testes-postulati" genus="numerus"/>
    <attributum nomen="iterabilis" genus="veritas"/>
    <attributum nomen="revocabilis" genus="veritas"/>
    <attributum nomen="status-vigor" genus="electio">
      <optio>perfectus</optio>
      <optio>irritus</optio>
      <optio>rescissus</optio>
      <optio>solutus</optio>
    </attributum>
    <attributum nomen="agens" genus="referentia"/>
    <attributum nomen="capacitas-per" genus="referentia"/>
    <attributum nomen="constituit" genus="referentia"/>
    <attributum nomen="afficit" genus="referentia"/>
    <attributum nomen="secundum-legem" genus="referentia"/>
    <attributum nomen="forma-eius" genus="referentia"/>
    <liberum nomen="testes"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
