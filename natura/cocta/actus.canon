  <elementum nomen="actus-iuridicus">
    <glossa lingua="en">A juridical act: a solemn act whose force civil
    authority supplies - the law prescribes the form, and the law
    acknowledges the effect. Its form therefore VARIES across
    jurisdictions where a rite stays the same the world over, and
    that is the difference which breaks international
    schemas.</glossa>
    <glossa lingua="fr">Un acte juridique : un acte solennel dont
    l'autorité civile fournit la force - la loi prescrit la forme,
    et la loi reconnaît l'effet. Sa forme VARIE donc selon les
    juridictions, là où un rite demeure le même par tout le monde,
    et c'est la différence qui brise les schémas
    internationaux.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="in-iurisdictione" genus="referentia"/>
    <attributum nomen="forma-praescripta" genus="textus"/>
    <attributum nomen="intentio-necessaria" genus="veritas"/>
    <attributum nomen="testes-postulati" genus="numerus"/>
    <attributum nomen="iterabilis" genus="veritas"/>
    <attributum nomen="revocabilis" genus="veritas"/>
    <attributum nomen="status-vigor" genus="electio">
      <optio>perfectus</optio>
      <optio>irritus</optio>
      <optio>rescissus</optio>
      <optio>solutus</optio>
    </attributum>
    <attributum nomen="agens" genus="referentia"/>
    <attributum nomen="capacitas-per" genus="referentia"/>
    <attributum nomen="constituit" genus="referentia"/>
    <attributum nomen="afficit" genus="referentia"/>
    <attributum nomen="secundum-legem" genus="referentia"/>
    <attributum nomen="forma-eius" genus="referentia"/>
    <liberum nomen="testes"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
