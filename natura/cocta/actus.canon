  <elementum nomen="quorum">
    <glossa lingua="en">A quorum: the number (or the fraction) of
    members whose presence or consent is required for a body to act
    validly - below it, the acts are not bad but NULL, since it was
    not the body that acted but a few of its members. It is a
    condition of VALIDITY, not of prudence: a council of a few may
    be wise and still void, a quorate one foolish and still
    valid.</glossa>
    <glossa lingua="fr">Un quorum : le nombre (ou la part) de membres
    dont la présence ou le consentement est requis pour qu'une
    assemblée agisse validement - en dessous, les actes ne sont pas
    mauvais mais NULS, car ce n'est pas l'assemblée qui a agi mais
    quelques-uns. C'est une condition de VALIDITÉ et non de
    prudence : un conseil restreint peut être sage et pourtant nul,
    un conseil au quorum insensé et pourtant valide.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="modus-computandi" genus="electio">
      <optio>ex_praesentibus</optio>
      <optio>ex_membris_omnibus</optio>
      <optio>ex_suffragiis_latis</optio>
    </attributum>
    <attributum nomen="pars-requisita" genus="textus"/>
    <attributum nomen="numerus-membrorum" genus="numerus"/>
    <attributum nomen="coetus" genus="referentia"/>
    <attributum nomen="statutum-per" genus="referentia"/>
    <liberum nomen="condicio-actus"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
