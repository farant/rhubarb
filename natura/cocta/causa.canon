<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATUM a natura_canones e causa - NOLI MANU MUTARE.
     Regenera: ./tools/natura_canones.sh -->
<canon dialectus="causa" versio="1">

  <elementum nomen="individua" radix="verum">
    <liberum nomen="causa"/>
    <liberum nomen="causa-materialis"/>
    <liberum nomen="causa-formalis"/>
    <liberum nomen="causa-efficiens"/>
    <liberum nomen="causa-finalis"/>
  </elementum>

  <elementum nomen="causa">
    <glossa lingua="en">A cause: that by whose power something is or
    comes to be - not merely what comes before (that is an
    antecedent) but what BRINGS IT ABOUT. A most ancient
    distinction, neglected today: once the fallacy "post hoc ergo
    propter hoc" is admitted, the whole matter collapses.</glossa>
    <glossa lingua="fr">Une cause : ce par la vertu de quoi une chose
    est ou devient - non pas seulement ce qui précède (cela est un
    antécédent) mais ce qui PRODUIT. Distinction très ancienne et
    aujourd'hui négligée : une fois admis le sophisme « post hoc
    ergo propter hoc », toute la question est à terre.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="necessaria" genus="veritas"/>
    <attributum nomen="sufficiens" genus="veritas"/>
    <attributum nomen="asseritur-per" genus="referentia"/>
    <liberum nomen="causat"/>
    <liberum nomen="pendet-ex"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="causat" intra="causa">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="pendet-ex" intra="causa">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="causa">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="causa-materialis">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="necessaria" genus="veritas"/>
    <attributum nomen="sufficiens" genus="veritas"/>
    <attributum nomen="asseritur-per" genus="referentia"/>
    <liberum nomen="causat"/>
    <liberum nomen="pendet-ex"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="causat" intra="causa-materialis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="pendet-ex" intra="causa-materialis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="causa-materialis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="causa-formalis">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="necessaria" genus="veritas"/>
    <attributum nomen="sufficiens" genus="veritas"/>
    <attributum nomen="asseritur-per" genus="referentia"/>
    <liberum nomen="causat"/>
    <liberum nomen="pendet-ex"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="causat" intra="causa-formalis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="pendet-ex" intra="causa-formalis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="causa-formalis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="causa-efficiens">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="necessaria" genus="veritas"/>
    <attributum nomen="sufficiens" genus="veritas"/>
    <attributum nomen="asseritur-per" genus="referentia"/>
    <liberum nomen="causat"/>
    <liberum nomen="pendet-ex"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="causat" intra="causa-efficiens">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="pendet-ex" intra="causa-efficiens">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="causa-efficiens">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="causa-finalis">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="necessaria" genus="veritas"/>
    <attributum nomen="sufficiens" genus="veritas"/>
    <attributum nomen="asseritur-per" genus="referentia"/>
    <liberum nomen="causat"/>
    <liberum nomen="pendet-ex"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="causat" intra="causa-finalis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="pendet-ex" intra="causa-finalis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="causa-finalis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="nota" textus="verum"
    nota="margo curatorialis individui - stratum
          documenti quod stratum generum iam habebat"/>

  <elementum nomen="eventum" intra="historia" textus="verum">
    <attributum nomen="quando" genus="dies"/>
    <attributum nomen="actio" genus="nomen"/>
    <attributum nomen="certitudo" genus="nomen"/>
    <attributum nomen="fons" genus="nomen"/>
    <attributum nomen="nota" genus="textus"/>
  </elementum>

  <unicitas nomen="identitas" attributum="nomen"
    nota="nomen= identitas est (par. 5.3): spatium nominum UNUM per genera omnia"
    super="causa causa-materialis causa-formalis causa-efficiens causa-finalis"/>

  <!-- CITATIONES: relatio petitum resolutum ferens clavem documenti fit.
       Subsumptio COMPILATA est: petitum cum posteris omnibus in
       indicem ad= enumeratur, quia claves per titulum exactum
       colliguntur et subgenus titulum alium fert. Signa: '#'
       individuum inscriptum (clavis verbatim), '.' genus e
       vocabulario indicis. -->
  <citatio nomen="causa-pendet-ex" attributum="ad" ad="causa causa-materialis causa-formalis causa-efficiens causa-finalis/nomen" super="causa/pendet-ex"/>
  <citatio nomen="causa-materialis-pendet-ex" attributum="ad" ad="causa causa-materialis causa-formalis causa-efficiens causa-finalis/nomen" super="causa-materialis/pendet-ex"/>
  <citatio nomen="causa-formalis-pendet-ex" attributum="ad" ad="causa causa-materialis causa-formalis causa-efficiens causa-finalis/nomen" super="causa-formalis/pendet-ex"/>
  <citatio nomen="causa-efficiens-pendet-ex" attributum="ad" ad="causa causa-materialis causa-formalis causa-efficiens causa-finalis/nomen" super="causa-efficiens/pendet-ex"/>
  <citatio nomen="causa-finalis-pendet-ex" attributum="ad" ad="causa causa-materialis causa-formalis causa-efficiens causa-finalis/nomen" super="causa-finalis/pendet-ex"/>

</canon>
