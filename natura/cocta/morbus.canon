<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATUM a natura_canones e morbus - NOLI MANU MUTARE.
     Regenera: ./tools/natura_canones.sh -->
<canon dialectus="morbus" versio="1">

  <elementum nomen="individua" radix="verum">
    <liberum nomen="morbus"/>
    <liberum nomen="morbus-infectiosus"/>
    <liberum nomen="morbus-geneticus"/>
    <liberum nomen="morbus-degenerativus"/>
    <liberum nomen="vulnus"/>
  </elementum>

  <elementum nomen="morbus">
    <glossa lingua="en">A disease: a disposition of a living thing
    contrary to its nature, by which an operation that is owed to it
    is impeded - a falling short of what is due to the nature of the
    thing. It is not a thing but a privation, what is lacking to
    health as darkness is lacking to light. Hence a disease cannot
    be defined unless a nature is first supposed.</glossa>
    <glossa lingua="fr">Une maladie : une disposition du vivant
    contraire à sa nature, par laquelle une opération qui lui est
    due se trouve empêchée - un manquement à ce qui est dû à la
    nature de la chose. Ce n'est pas une chose mais une privation :
    ce qui fait défaut à la santé, comme les ténèbres à la lumière.
    Aussi la maladie ne peut-elle être définie sans qu'une nature
    soit d'abord supposée.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="contagiosus" genus="veritas"/>
    <attributum nomen="duratio-typica" genus="textus"/>
    <attributum nomen="letalitas" genus="numerus"/>
    <attributum nomen="status-cursus" genus="electio">
      <optio>latens</optio>
      <optio>manifestus</optio>
      <optio>convalescens</optio>
      <optio>sanatus</optio>
      <optio>chronicus</optio>
      <optio>lethalis</optio>
    </attributum>
    <attributum nomen="afficit" genus="referentia"/>
    <attributum nomen="sedes" genus="referentia"/>
    <attributum nomen="dignoscitur-per" genus="referentia"/>
    <attributum nomen="classificatus-in" genus="referentia"/>
    <liberum nomen="curatur-per"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="curatur-per" intra="morbus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="morbus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="morbus-infectiosus">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="contagiosus" genus="veritas" ordinarius="verum"/>
    <attributum nomen="duratio-typica" genus="textus"/>
    <attributum nomen="letalitas" genus="numerus"/>
    <attributum nomen="status-cursus" genus="electio">
      <optio>latens</optio>
      <optio>manifestus</optio>
      <optio>convalescens</optio>
      <optio>sanatus</optio>
      <optio>chronicus</optio>
      <optio>lethalis</optio>
    </attributum>
    <attributum nomen="afficit" genus="referentia"/>
    <attributum nomen="sedes" genus="referentia"/>
    <attributum nomen="dignoscitur-per" genus="referentia"/>
    <attributum nomen="classificatus-in" genus="referentia"/>
    <liberum nomen="curatur-per"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="curatur-per" intra="morbus-infectiosus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="morbus-infectiosus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="morbus-geneticus">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="contagiosus" genus="veritas" ordinarius="falsum"/>
    <attributum nomen="duratio-typica" genus="textus"/>
    <attributum nomen="letalitas" genus="numerus"/>
    <attributum nomen="status-cursus" genus="electio">
      <optio>latens</optio>
      <optio>manifestus</optio>
      <optio>convalescens</optio>
      <optio>sanatus</optio>
      <optio>chronicus</optio>
      <optio>lethalis</optio>
    </attributum>
    <attributum nomen="afficit" genus="referentia"/>
    <attributum nomen="sedes" genus="referentia"/>
    <attributum nomen="dignoscitur-per" genus="referentia"/>
    <attributum nomen="classificatus-in" genus="referentia"/>
    <liberum nomen="curatur-per"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="curatur-per" intra="morbus-geneticus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="morbus-geneticus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="morbus-degenerativus">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="contagiosus" genus="veritas"/>
    <attributum nomen="duratio-typica" genus="textus"/>
    <attributum nomen="letalitas" genus="numerus"/>
    <attributum nomen="status-cursus" genus="electio">
      <optio>latens</optio>
      <optio>manifestus</optio>
      <optio>convalescens</optio>
      <optio>sanatus</optio>
      <optio>chronicus</optio>
      <optio>lethalis</optio>
    </attributum>
    <attributum nomen="afficit" genus="referentia"/>
    <attributum nomen="sedes" genus="referentia"/>
    <attributum nomen="dignoscitur-per" genus="referentia"/>
    <attributum nomen="classificatus-in" genus="referentia"/>
    <liberum nomen="curatur-per"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="curatur-per" intra="morbus-degenerativus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="morbus-degenerativus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="vulnus">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="contagiosus" genus="veritas"/>
    <attributum nomen="duratio-typica" genus="textus"/>
    <attributum nomen="letalitas" genus="numerus"/>
    <attributum nomen="status-cursus" genus="electio">
      <optio>latens</optio>
      <optio>manifestus</optio>
      <optio>convalescens</optio>
      <optio>sanatus</optio>
      <optio>chronicus</optio>
      <optio>lethalis</optio>
    </attributum>
    <attributum nomen="afficit" genus="referentia"/>
    <attributum nomen="sedes" genus="referentia"/>
    <attributum nomen="dignoscitur-per" genus="referentia"/>
    <attributum nomen="classificatus-in" genus="referentia"/>
    <liberum nomen="curatur-per"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="curatur-per" intra="vulnus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="vulnus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="eventum" intra="historia" textus="verum">
    <attributum nomen="quando" genus="dies"/>
    <attributum nomen="actio" genus="nomen"/>
    <attributum nomen="certitudo" genus="nomen"/>
    <attributum nomen="fons" genus="nomen"/>
    <attributum nomen="nota" genus="textus"/>
  </elementum>

  <unicitas nomen="identitas" attributum="nomen"
    nota="nomen= identitas est (par. 5.3): spatium nominum UNUM per genera omnia"
    super="morbus morbus-infectiosus morbus-geneticus morbus-degenerativus
           vulnus"/>

</canon>
