<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATUM a natura_canones e persona - NOLI MANU MUTARE.
     Regenera: ./tools/natura_canones.sh -->
<canon dialectus="persona" versio="1">

  <elementum nomen="individua" radix="verum">
    <attributum nomen="fons" genus="nomen"/>
    <liberum nomen="persona"/>
  </elementum>

  <elementum nomen="persona">
    <glossa lingua="en">A person: an individual substance of a
    rational nature (Boethius). A person is the subject of free
    acts - able to be an author, and not merely a cause.</glossa>
    <glossa lingua="fr">Une personne : une substance individuelle de
    nature raisonnable (Boèce). La personne est le sujet des actes
    libres - elle peut être auteur, et non seulement cause.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="natus" genus="dies"/>
    <attributum nomen="mortuus" genus="dies"/>
    <attributum nomen="status-civilis" genus="electio">
      <optio>caelebs</optio>
      <optio>coniugatus</optio>
      <optio>viduus</optio>
      <optio>divortiatus</optio>
    </attributum>
    <attributum nomen="auctor-de" genus="referentia"/>
    <attributum nomen="domicilium" genus="referentia"/>
    <liberum nomen="nomina"/>
    <liberum nomen="membrum-de"/>
    <liberum nomen="inscriptus-in"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="nomina" intra="persona" textus="verum"/>
  <elementum nomen="membrum-de" intra="persona">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="inscriptus-in" intra="persona">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="persona">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="nota" textus="verum"
    nota="margo curatorialis individui - stratum
          documenti quod stratum generum iam habebat"/>

  <elementum nomen="eventum" intra="historia" textus="verum">
    <attributum nomen="quando" genus="dies"/>
    <attributum nomen="actio" genus="electio">
      <optio>creare</optio>
    </attributum>
    <attributum nomen="certitudo" genus="nomen"/>
    <attributum nomen="fons" genus="nomen"/>
    <attributum nomen="nota" genus="textus"/>
  </elementum>

  <unicitas nomen="identitas" attributum="nomen"
    nota="nomen= identitas est (par. 5.3): spatium nominum UNUM per genera omnia"
    super="persona"/>

</canon>
