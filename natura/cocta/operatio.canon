<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATUM a natura_canones e operatio - NOLI MANU MUTARE.
     Regenera: ./tools/natura_canones.sh -->
<canon dialectus="operatio" versio="1">

  <elementum nomen="individua" radix="verum">
    <liberum nomen="ambitus"/>
    <liberum nomen="pensum"/>
    <liberum nomen="incidens"/>
    <liberum nomen="processus"/>
    <liberum nomen="ambitus-fabricae"/>
    <liberum nomen="ambitus-probationis"/>
    <liberum nomen="ambitus-producens"/>
  </elementum>

  <elementum nomen="ambitus">
    <glossa lingua="en">An environment: an ordered place where
    programs run - machines, configurations, data, names. Not a
    patch of hardware but the whole context a program finds
    around itself.</glossa>
    <glossa lingua="fr">Un environnement : un lieu ordonné où les
    programmes s'exécutent - machines, configurations, données,
    noms. Non pas un morceau de matériel mais le contexte entier
    que le programme trouve autour de lui.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="realitas-consequentiae" genus="electio">
      <optio>ficta</optio>
      <optio>vera</optio>
    </attributum>
    <attributum nomen="data-vera" genus="veritas"/>
    <attributum nomen="situs-in" genus="referentia"/>
    <liberum nomen="fert"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="fert" intra="ambitus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="ambitus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="pensum">
    <glossa lingua="en">A task: a definite piece of work entrusted
    to someone - what is to be done, by whom, in what state. Not
    a requirement (what must be true), nor a capability (what the
    work delivers), nor a defect (a discrepancy), but a
    COMMISSION TO ACT - the fourth term the engineering square
    was missing.</glossa>
    <glossa lingua="fr">Une tâche : un travail déterminé confié à
    quelqu'un - ce qui est à faire, par qui, en quel état. Ni une
    exigence (ce qui doit être vrai), ni une fonctionnalité (ce
    que le travail fournit), ni un défaut (un écart), mais une
    COMMISSION D'AGIR - le quatrième terme qui manquait au carré
    de la fabrication.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="aestimatio-laboris" genus="textus"/>
    <attributum nomen="terminus" genus="dies"/>
    <attributum nomen="status-cursus" genus="electio">
      <optio>propositum</optio>
      <optio>susceptum</optio>
      <optio>in_opere</optio>
      <optio>perfectum</optio>
      <optio>omissum</optio>
    </attributum>
    <attributum nomen="commissum" genus="referentia"/>
    <liberum nomen="implet"/>
    <liberum nomen="sanat"/>
    <liberum nomen="impeditur-a"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="implet" intra="pensum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="sanat" intra="pensum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="impeditur-a" intra="pensum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="pensum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="incidens">
    <glossa lingua="en">An incident: an interruption or degradation
    of service in a real environment. Not a kind of defect but a
    defect EXPOSED - the same fault is always a defect, and
    becomes an incident when it reaches real people. It has a
    beginning, an end, a severity, a response.</glossa>
    <glossa lingua="fr">Un incident : une interruption ou une
    dégradation du service dans un environnement réel. Non pas
    une espèce de défaut mais un défaut EXPOSÉ - la même faille
    est toujours un défaut, et elle devient un incident lorsqu'elle
    atteint des personnes réelles. Il a un début, une fin, une
    gravité, une réponse.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="gravitas" genus="electio">
      <optio>levis</optio>
      <optio>gravis</optio>
      <optio>totalis</optio>
    </attributum>
    <attributum nomen="duratio" genus="textus"/>
    <attributum nomen="status-cursus" genus="electio">
      <optio>deprehensum</optio>
      <optio>agnitum</optio>
      <optio>mitigatum</optio>
      <optio>solutum</optio>
      <optio>recensitum</optio>
    </attributum>
    <attributum nomen="in-ambitu" genus="referentia"/>
    <attributum nomen="ex-vitio" genus="referentia"/>
    <attributum nomen="deprehensum-per" genus="referentia"/>
    <attributum nomen="violat" genus="referentia"/>
    <liberum nomen="causa-eius"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="causa-eius" intra="incidens">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="incidens">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="processus">
    <glossa lingua="en">A process: a program in execution - an
    instance of a form, carrying its own state, and worth
    addressing for as long as it lives. The same program can run
    a hundred times at once, and those are a hundred processes,
    not one. Here the instance is TEMPORAL: a process begins,
    runs, ceases - its ending lies in its nature.</glossa>
    <glossa lingua="fr">Un processus : un programme en cours
    d'exécution - une instance d'une forme, portant son propre
    état, et digne d'être adressée tant qu'elle vit. Le même
    programme peut s'exécuter cent fois à la fois, et ce sont
    cent processus, non pas un seul. Ici l'instance est
    TEMPORELLE : un processus commence, s'exécute, cesse - sa fin
    est dans sa nature.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="identificator-currens" genus="numerus"/>
    <attributum nomen="valor-exitus" genus="numerus"/>
    <attributum nomen="privilegium" genus="electio">
      <optio>utentis</optio>
      <optio>administratoris</optio>
    </attributum>
    <attributum nomen="status-cursus" genus="electio">
      <optio>nascens</optio>
      <optio>currens</optio>
      <optio>dormiens</optio>
      <optio>suspensus</optio>
      <optio>larva</optio>
      <optio>sublatus</optio>
    </attributum>
    <attributum nomen="instantia-de" genus="referentia"/>
    <attributum nomen="genitus-a" genus="referentia"/>
    <attributum nomen="currit-in" genus="referentia"/>
    <liberum nomen="spatium-memoriae" maximum="1"/>
    <liberum nomen="tabula-descriptorum" maximum="1"/>
    <liberum nomen="ambitus-variabilium" maximum="1"/>
    <liberum nomen="directorium-currens" maximum="1"/>
    <liberum nomen="vector-argumentorum" maximum="1"/>
    <liberum nomen="gerit"/>
    <liberum nomen="tenet-apertam"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="spatium-memoriae" intra="processus">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="tabula-descriptorum" intra="processus">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="ambitus-variabilium" intra="processus">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="directorium-currens" intra="processus">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="vector-argumentorum" intra="processus">
    <attributum nomen="nota" genus="textus"/>
  </elementum>
  <elementum nomen="gerit" intra="processus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="tenet-apertam" intra="processus">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="processus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="ambitus-fabricae">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="realitas-consequentiae" genus="electio" ordinarius="ficta">
      <optio>ficta</optio>
      <optio>vera</optio>
    </attributum>
    <attributum nomen="data-vera" genus="veritas"/>
    <attributum nomen="situs-in" genus="referentia"/>
    <liberum nomen="fert"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="fert" intra="ambitus-fabricae">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="ambitus-fabricae">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="ambitus-probationis">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="realitas-consequentiae" genus="electio" ordinarius="ficta">
      <optio>ficta</optio>
      <optio>vera</optio>
    </attributum>
    <attributum nomen="data-vera" genus="veritas"/>
    <attributum nomen="situs-in" genus="referentia"/>
    <liberum nomen="fert"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="fert" intra="ambitus-probationis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="ambitus-probationis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="ambitus-producens">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="realitas-consequentiae" genus="electio" ordinarius="vera">
      <optio>ficta</optio>
      <optio>vera</optio>
    </attributum>
    <attributum nomen="data-vera" genus="veritas" ordinarius="verum"/>
    <attributum nomen="situs-in" genus="referentia"/>
    <liberum nomen="fert"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
  </elementum>
  <elementum nomen="fert" intra="ambitus-producens">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="ambitus-producens">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="nota" textus="verum"
    nota="margo curatorialis individui - stratum
          documenti quod stratum generum iam habebat"/>

  <elementum nomen="eventum" intra="historia" textus="verum">
    <attributum nomen="quando" genus="dies"/>
    <attributum nomen="actio" genus="electio">
      <optio>gigni</optio>
      <optio>terminari</optio>
      <optio>occidi</optio>
      <optio>meti</optio>
    </attributum>
    <attributum nomen="certitudo" genus="nomen"/>
    <attributum nomen="fons" genus="nomen"/>
    <attributum nomen="nota" genus="textus"/>
  </elementum>

  <unicitas nomen="identitas" attributum="nomen"
    nota="nomen= identitas est (par. 5.3): spatium nominum UNUM per genera omnia"
    super="ambitus pensum incidens processus ambitus-fabricae ambitus-probationis
           ambitus-producens"/>

  <!-- CITATIONES: relatio petitum resolutum ferens clavem documenti fit.
       Subsumptio COMPILATA est: petitum cum posteris omnibus in
       indicem ad= enumeratur, quia claves per titulum exactum
       colliguntur et subgenus titulum alium fert. Signa: '#'
       individuum inscriptum (clavis verbatim), '.' genus e
       vocabulario indicis. -->
  <citatio nomen="pensum-impeditur-a" attributum="ad" ad="pensum/nomen" super="pensum/impeditur-a"/>
  <citatio nomen="incidens-in-ambitu" attributum="in-ambitu" ad="ambitus ambitus-fabricae ambitus-probationis ambitus-producens/nomen" super="incidens"/>
  <citatio nomen="processus-genitus-a" attributum="genitus-a" ad="processus/nomen" super="processus"/>
  <citatio nomen="processus-currit-in" attributum="currit-in" ad="ambitus ambitus-fabricae ambitus-probationis ambitus-producens/nomen" super="processus"/>

</canon>
