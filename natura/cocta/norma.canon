<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATUM a natura_canones e norma - NOLI MANU MUTARE.
     Regenera: ./tools/natura_canones.sh -->
<canon dialectus="norma" versio="1">

  <elementum nomen="individua" radix="verum">
    <attributum nomen="fons" genus="nomen"/>
    <liberum nomen="norma"/>
    <liberum nomen="lex"/>
    <liberum nomen="lex-aeterna"/>
    <liberum nomen="lex-naturalis"/>
    <liberum nomen="lex-humana"/>
    <liberum nomen="lex-divina-positiva"/>
    <liberum nomen="consuetudo"/>
    <liberum nomen="classis-normativa"/>
    <liberum nomen="schedula-substantiarum"/>
    <liberum nomen="gradus-eventus-aviatorii"/>
    <liberum nomen="classis-periculi-mercium"/>
    <liberum nomen="fictio-iuris"/>
    <liberum nomen="adoptio"/>
    <liberum nomen="mors-praesumpta"/>
    <liberum nomen="personalitas-iuridica"/>
  </elementum>

  <elementum nomen="norma">
    <glossa lingua="en">A standard: a public document that
    prescribes a form - it defines what conformity means. It is
    distinct from the thing standardized: the standard for the C
    language is not the C language; it is an authoritative
    description.</glossa>
    <glossa lingua="fr">Une norme : un document public qui
    prescrit une forme - elle définit ce que signifie la
    conformité. Elle se distingue de la chose normée : la norme
    du langage C n'EST pas le langage C ; c'est une description
    faisant autorité.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="contentum" genus="textus"/>
    <attributum nomen="index" genus="textus"/>
    <attributum nomen="titulus" genus="textus"/>
    <attributum nomen="publicata" genus="dies"/>
    <attributum nomen="status-vigor" genus="electio">
      <optio>proposita</optio>
      <optio>vigens</optio>
      <optio>substituta</optio>
      <optio>retracta</optio>
    </attributum>
    <attributum nomen="substituit" genus="referentia"/>
    <attributum nomen="normat" genus="referentia"/>
    <attributum nomen="proprium" genus="referentia"/>
    <attributum nomen="ex-fonte" genus="referentia"/>
    <liberum nomen="editor"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
    <liberum nomen="glossa"/>
  </elementum>
  <elementum nomen="editor" intra="norma">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="norma">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="lex">
    <glossa lingua="en">A law: an ordinance of reason for the
    common good, promulgated by the one who has care of the
    community (Aquinas, ST I-II q.90 a.4) - not counsel but
    precept, with binding force and usually with a sanction. It
    differs from a standard by its SOURCE OF AUTHORITY: a
    standard OFFERS conformity, a law DEMANDS obedience.</glossa>
    <glossa lingua="fr">Une loi : une ordonnance de la raison en
    vue du bien commun, promulguée par celui qui a la charge de
    la communauté (Thomas, ST I-II q.90 a.4) - non pas un conseil
    mais un précepte, avec force obligatoire et le plus souvent
    avec une sanction. Elle diffère de la norme par sa SOURCE
    D'AUTORITÉ : la norme OFFRE la conformité, la loi EXIGE
    l'obéissance.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="sanctio" genus="textus"/>
    <attributum nomen="vacatio" genus="textus"/>
    <attributum nomen="status-vigor" genus="electio">
      <optio>lata</optio>
      <optio>promulgata</optio>
      <optio>vigens</optio>
      <optio>abrogata</optio>
      <optio>desueta</optio>
    </attributum>
    <attributum nomen="lata-a" genus="referentia"/>
    <attributum nomen="in-iurisdictione" genus="referentia"/>
    <attributum nomen="promulgata-per" genus="referentia"/>
    <liberum nomen="abrogat"/>
    <liberum nomen="parit"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
    <liberum nomen="glossa"/>
  </elementum>
  <elementum nomen="abrogat" intra="lex">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="parit" intra="lex">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="lex">
    <liberum nomen="eventum"/>
  </elementum>

