    <attributum nomen="constituta-per" genus="referentia"/>
    <attributum nomen="assignatur-per" genus="referentia"/>
    <attributum nomen="gradus-supra" genus="referentia"/>
    <liberum nomen="continet"/>
    <liberum nomen="imponit"/>
    <liberum nomen="historia" maximum="1"/>
