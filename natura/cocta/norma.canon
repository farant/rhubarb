  <unicitas nomen="identitas" attributum="nomen"
    nota="nomen= identitas est (par. 5.3): spatium nominum UNUM per genera omnia"
    super="norma lex classis-normativa fictio-iuris iso-9899-1990 iso-9899-1999
           posix-1 lex-aeterna lex-naturalis lex-humana lex-divina-positiva
           consuetudo schedula-substantiarum gradus-eventus-aviatorii classis-periculi-mercium
           adoptio mors-praesumpta personalitas-iuridica"/>

  <!-- CITATIONES: relatio petitum resolutum ferens clavem documenti fit.
       Subsumptio COMPILATA est: petitum cum posteris omnibus in
       indicem ad= enumeratur, quia claves per titulum exactum
       colliguntur et subgenus titulum alium fert. Signa: '#'
       individuum inscriptum (clavis verbatim), '.' genus e
       vocabulario indicis. -->
  <citatio nomen="norma-substituit" attributum="substituit" ad="norma iso-9899-1990 iso-9899-1999 posix-1/nomen" super="norma"/>
  <citatio nomen="classis-normativa-constituta-per" attributum="constituta-per" ad="norma iso-9899-1990 iso-9899-1999 posix-1/nomen" super="classis-normativa"/>
  <citatio nomen="classis-normativa-gradus-supra" attributum="gradus-supra" ad="classis-normativa schedula-substantiarum gradus-eventus-aviatorii classis-periculi-mercium/nomen" super="classis-normativa"/>
  <citatio nomen="fictio-iuris-instituta-per" attributum="instituta-per" ad="norma iso-9899-1990 iso-9899-1999 posix-1/nomen" super="fictio-iuris"/>
