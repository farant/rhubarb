  <elementum nomen="fictio-iuris">
    <glossa lingua="en">A legal fiction: a precept by which the
    law orders a thing that stands one way to be treated AS IF it
    stood otherwise, knowing that it does not, for the sake of a
    good that cannot be reached any other way. Not an error nor a
    pretence but an as-if deliberately undertaken - it differs
    from a presumption in that a presumption yields once the
    contrary is proven, while a fiction already knows the
    contrary and does not yield.</glossa>
    <glossa lingua="fr">Une fiction juridique : un précepte par
    lequel la loi ordonne de traiter une chose COMME SI elle
    était autre, sachant qu'elle ne l'est pas, en vue d'un bien
    qui ne peut être atteint autrement. Ni une erreur ni une
    simulation, mais un comme-si délibérément assumé - elle
    diffère de la présomption en ce que la présomption cède
    lorsque le contraire est prouvé, tandis que la fiction sait
    déjà le contraire et ne cède pas.</glossa>
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="ratio" genus="textus"/>
    <attributum nomen="refragabilis" genus="veritas"/>
    <attributum nomen="ambitus" genus="electio">
      <optio>universalis</optio>
      <optio>ad_certos_effectus</optio>
    </attributum>
    <attributum nomen="instituta-per" genus="referentia"/>
    <attributum nomen="applicatur-per" genus="referentia"/>
    <attributum nomen="fingit" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
    <liberum nomen="glossa"/>
  </elementum>
  <elementum nomen="historia" intra="fictio-iuris">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="adoptio">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="ratio" genus="textus" ordinarius="bonum pueri, cui parentes debentur       quos natura non dedit"/>
    <attributum nomen="refragabilis" genus="veritas"/>
    <attributum nomen="ambitus" genus="electio" ordinarius="ad_certos_effectus">
      <optio>universalis</optio>
      <optio>ad_certos_effectus</optio>
    </attributum>
    <attributum nomen="instituta-per" genus="referentia"/>
    <attributum nomen="applicatur-per" genus="referentia"/>
    <attributum nomen="fingit" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
    <liberum nomen="glossa"/>
  </elementum>
  <elementum nomen="historia" intra="adoptio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="mors-praesumpta">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="ratio" genus="textus" ordinarius="ne viventium negotia in aeternum       pendeant propter absentiam quae probari non potest"/>
    <attributum nomen="refragabilis" genus="veritas"/>
    <attributum nomen="ambitus" genus="electio">
      <optio>universalis</optio>
      <optio>ad_certos_effectus</optio>
    </attributum>
    <attributum nomen="instituta-per" genus="referentia"/>
    <attributum nomen="applicatur-per" genus="referentia"/>
    <attributum nomen="fingit" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
    <liberum nomen="glossa"/>
  </elementum>
  <elementum nomen="historia" intra="mors-praesumpta">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="personalitas-iuridica">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="ratio" genus="textus" ordinarius="ne perpetuitas coetus a mortalitate       membrorum pendeat"/>
    <attributum nomen="refragabilis" genus="veritas"/>
    <attributum nomen="ambitus" genus="electio">
      <optio>universalis</optio>
      <optio>ad_certos_effectus</optio>
    </attributum>
    <attributum nomen="instituta-per" genus="referentia"/>
    <attributum nomen="applicatur-per" genus="referentia"/>
    <attributum nomen="fingit" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
    <liberum nomen="nota"/>
    <liberum nomen="glossa"/>
  </elementum>
  <elementum nomen="historia" intra="personalitas-iuridica">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="nota" textus="verum"
    nota="margo curatorialis individui - stratum
          documenti quod stratum generum iam habebat"/>

  <elementum nomen="glossa" textus="verum"
    nota="glossa vernacula individui - lingua ISO 639-1
          (en/fr/...); definitio Latine VERITAS manet,
          glossa explicat, numquam renominat">
    <attributum nomen="lingua" genus="nomen" necessarium="verum"/>
  </elementum>

  <elementum nomen="eventum" intra="historia" textus="verum">
    <attributum nomen="quando" genus="dies"/>
    <attributum nomen="actio" genus="electio">
      <optio>publicari</optio>
      <optio>substitui</optio>
    </attributum>
    <attributum nomen="certitudo" genus="nomen"/>
    <attributum nomen="fons" genus="nomen"/>
    <attributum nomen="nota" genus="textus"/>
  </elementum>

  <unicitas nomen="identitas" attributum="nomen"
    nota="nomen= identitas est (par. 5.3): spatium nominum UNUM per genera omnia"
    super="norma lex lex-aeterna lex-naturalis lex-humana lex-divina-positiva
           consuetudo classis-normativa schedula-substantiarum gradus-eventus-aviatorii
