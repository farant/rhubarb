  <elementum nomen="gradus-eventus-aviatorii">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="ordinata" genus="veritas" ordinarius="verum"/>
    <attributum nomen="criterium" genus="textus" ordinarius="damnum personarum et aeronavis, ex       Annexo XIII"/>
