<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATUM a natura_canones e systema_operativum - NOLI MANU MUTARE.
     Regenera: ./tools/natura_canones.sh -->
<canon dialectus="systema_operativum" versio="1">

  <elementum nomen="individua" radix="verum">
    <liberum nomen="systema-operativum"/>
    <liberum nomen="systema-unixiforme"/>
    <liberum nomen="distributio-systematis"/>
    <liberum nomen="versio-systematis"/>
  </elementum>

  <elementum nomen="systema-operativum">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="genus-nuclei" genus="electio">
      <optio>monolithicus</optio>
      <optio>micronucleus</optio>
      <optio>hybridus</optio>
    </attributum>
    <attributum nomen="fons-apertus" genus="veritas"/>
    <attributum nomen="multiplex-processuum" genus="veritas"/>
    <attributum nomen="multiplex-usorum" genus="veritas"/>
    <attributum nomen="status-cursus" genus="electio">
      <optio>exstinctum</optio>
      <optio>initians</optio>
      <optio>currens</optio>
      <optio>dormiens</optio>
    </attributum>
    <attributum nomen="orta-ex" genus="referentia"/>
    <attributum nomen="ad-exemplum-facta" genus="referentia"/>
    <attributum nomen="edita-a" genus="referentia"/>
    <attributum nomen="habet-versionem" genus="referentia"/>
    <attributum nomen="praebet-systema-plagularum" genus="referentia"/>
    <liberum nomen="auctor"/>
    <liberum nomen="exsequitur-in"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="auctor" intra="systema-operativum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="exsequitur-in" intra="systema-operativum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="systema-operativum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="systema-unixiforme">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="genus-nuclei" genus="electio">
      <optio>monolithicus</optio>
      <optio>micronucleus</optio>
      <optio>hybridus</optio>
    </attributum>
    <attributum nomen="fons-apertus" genus="veritas"/>
    <attributum nomen="multiplex-processuum" genus="veritas"/>
    <attributum nomen="multiplex-usorum" genus="veritas"/>
    <attributum nomen="status-cursus" genus="electio">
      <optio>exstinctum</optio>
      <optio>initians</optio>
      <optio>currens</optio>
      <optio>dormiens</optio>
    </attributum>
    <attributum nomen="orta-ex" genus="referentia"/>
    <attributum nomen="ad-exemplum-facta" genus="referentia"/>
    <attributum nomen="edita-a" genus="referentia"/>
    <attributum nomen="habet-versionem" genus="referentia"/>
    <attributum nomen="praebet-systema-plagularum" genus="referentia"/>
    <liberum nomen="auctor"/>
    <liberum nomen="exsequitur-in"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="auctor" intra="systema-unixiforme">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="exsequitur-in" intra="systema-unixiforme">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="systema-unixiforme">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="distributio-systematis">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="gestor-fasciculorum" genus="textus"/>
    <attributum nomen="cadentia-editionum" genus="electio">
      <optio>statuta</optio>
      <optio>volvens</optio>
    </attributum>
    <attributum nomen="distributio-de" genus="referentia"/>
    <attributum nomen="orta-ex" genus="referentia"/>
    <attributum nomen="edita-a" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="historia" intra="distributio-systematis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="versio-systematis">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="titulus" genus="textus"/>
    <attributum nomen="edita" genus="dies"/>
    <attributum nomen="versio-de" genus="referentia"/>
    <attributum nomen="sequitur" genus="referentia"/>
    <attributum nomen="schema-numerandi" genus="electio">
      <optio>semanticum</optio>
      <optio>sequentiale</optio>
      <optio>temporale</optio>
      <optio>nominale</optio>
      <optio>mixtum</optio>
    </attributum>
    <attributum nomen="retro-compatibilis" genus="veritas"/>
    <attributum nomen="mutationes-fractoriae" genus="textus"/>
    <attributum nomen="status-sustentatio" genus="electio">
      <optio>praenuntiata</optio>
      <optio>vigens</optio>
      <optio>sustentata</optio>
      <optio>deprecata</optio>
      <optio>derelicta</optio>
    </attributum>
    <attributum nomen="asseritur-per" genus="referentia"/>
    <attributum nomen="edita-a" genus="referentia"/>
    <liberum nomen="compatibilis-cum"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="compatibilis-cum" intra="versio-systematis">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="versio-systematis">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="eventum" intra="historia" textus="verum">
    <attributum nomen="quando" genus="dies"/>
    <attributum nomen="actio" genus="electio">
      <optio>ortus</optio>
      <optio>edi</optio>
      <optio>instalari</optio>
      <optio>renovari</optio>
      <optio>deprecari</optio>
      <optio>derelinqui</optio>
    </attributum>
    <attributum nomen="certitudo" genus="nomen"/>
    <attributum nomen="fons" genus="nomen"/>
    <attributum nomen="nota" genus="textus"/>
  </elementum>

  <unicitas nomen="identitas" attributum="nomen"
    nota="nomen= identitas est (par. 5.3): spatium nominum UNUM per genera omnia"
    super="systema-operativum systema-unixiforme distributio-systematis versio-systematis"/>

  <!-- CITATIONES: relatio petitum resolutum ferens clavem documenti fit.
       Subsumptio COMPILATA est: petitum cum posteris omnibus in
       indicem ad= enumeratur, quia claves per titulum exactum
       colliguntur et subgenus titulum alium fert. Signa: '#'
       individuum inscriptum (clavis verbatim), '.' genus e
       vocabulario indicis. -->
  <citatio nomen="systema-operativum-orta-ex" attributum="orta-ex" ad="systema-operativum systema-unixiforme/nomen" super="systema-operativum"/>
  <citatio nomen="systema-operativum-ad-exemplum-facta" attributum="ad-exemplum-facta" ad="systema-operativum systema-unixiforme/nomen" super="systema-operativum"/>
  <citatio nomen="systema-operativum-habet-versionem" attributum="habet-versionem" ad="versio-systematis/nomen" super="systema-operativum"/>
  <citatio nomen="systema-unixiforme-orta-ex" attributum="orta-ex" ad="systema-operativum systema-unixiforme/nomen" super="systema-unixiforme"/>
  <citatio nomen="systema-unixiforme-ad-exemplum-facta" attributum="ad-exemplum-facta" ad="systema-operativum systema-unixiforme/nomen" super="systema-unixiforme"/>
  <citatio nomen="systema-unixiforme-habet-versionem" attributum="habet-versionem" ad="versio-systematis/nomen" super="systema-unixiforme"/>
  <citatio nomen="distributio-systematis-distributio-de" attributum="distributio-de" ad="systema-operativum systema-unixiforme/nomen" super="distributio-systematis"/>
  <citatio nomen="distributio-systematis-orta-ex" attributum="orta-ex" ad="distributio-systematis/nomen" super="distributio-systematis"/>
  <citatio nomen="versio-systematis-versio-de" attributum="versio-de" ad="systema-operativum systema-unixiforme/nomen" super="versio-systematis"/>
  <citatio nomen="versio-systematis-sequitur" attributum="sequitur" ad="versio-systematis/nomen" super="versio-systematis"/>

</canon>
