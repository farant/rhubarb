<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATUM a natura_canones e opus_scriptum - NOLI MANU MUTARE.
     Regenera: ./tools/natura_canones.sh -->
<canon dialectus="opus_scriptum" versio="1">

  <elementum nomen="individua" radix="verum">
    <liberum nomen="opus-scriptum"/>
    <liberum nomen="expressio"/>
    <liberum nomen="editio"/>
    <liberum nomen="codex"/>
    <liberum nomen="periodicum"/>
    <liberum nomen="fasciculus"/>
  </elementum>

  <elementum nomen="opus-scriptum">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="titulus-originalis" genus="textus"/>
    <attributum nomen="lingua-originalis" genus="textus"/>
    <attributum nomen="status-compositio" genus="electio">
      <optio>concepta</optio>
      <optio>in_scriptione</optio>
      <optio>perfecta</optio>
      <optio>imperfecta_relicta</optio>
    </attributum>
    <attributum nomen="habet-expressionem" genus="referentia"/>
    <attributum nomen="continuatio-de" genus="referentia"/>
    <attributum nomen="respondet-ad" genus="referentia"/>
    <attributum nomen="pars-de" genus="referentia"/>
    <liberum nomen="materia"/>
    <liberum nomen="auctor"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="materia" intra="opus-scriptum" textus="verum"/>
  <elementum nomen="auctor" intra="opus-scriptum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="opus-scriptum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="expressio">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="lingua" genus="textus"/>
    <attributum nomen="genus-expressionis" genus="electio">
      <optio>originalis</optio>
      <optio>translata</optio>
      <optio>recensita</optio>
      <optio>abbreviata</optio>
    </attributum>
    <attributum nomen="expressio-de" genus="referentia"/>
    <attributum nomen="translata-ex" genus="referentia"/>
    <liberum nomen="translator"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="translator" intra="expressio">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="expressio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="editio">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="index-isbn" genus="textus"/>
    <attributum nomen="paginae" genus="numerus"/>
    <attributum nomen="forma-corporis" genus="electio">
      <optio>codex_duro_tegmine</optio>
      <optio>codex_molli_tegmine</optio>
      <optio>volumen_membranaceum</optio>
      <optio>electronica</optio>
    </attributum>
    <attributum nomen="publicata" genus="dies"/>
    <attributum nomen="editio-de" genus="referentia"/>
    <attributum nomen="edita-a" genus="referentia"/>
    <attributum nomen="impressa-in" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="historia" intra="editio">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="codex">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="conditio" genus="electio">
      <optio>integer</optio>
      <optio>usu_tritus</optio>
      <optio>laesus</optio>
    </attributum>
    <attributum nomen="notae-marginales" genus="veritas"/>
    <attributum nomen="status-possessio" genus="electio">
      <optio>apud_dominum</optio>
      <optio>commodatus</optio>
      <optio>amissus</optio>
    </attributum>
    <attributum nomen="exemplar-de" genus="referentia"/>
    <attributum nomen="possessor" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="historia" intra="codex">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="periodicum">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="cadentia" genus="electio">
      <optio>cotidiana</optio>
      <optio>hebdomadalis</optio>
      <optio>menstrua</optio>
      <optio>trimestris</optio>
      <optio>annua</optio>
      <optio>irregularis</optio>
    </attributum>
    <attributum nomen="habet-fasciculum" genus="referentia"/>
    <attributum nomen="titulus-originalis" genus="textus"/>
    <attributum nomen="lingua-originalis" genus="textus"/>
    <attributum nomen="status-compositio" genus="electio">
      <optio>concepta</optio>
      <optio>in_scriptione</optio>
      <optio>perfecta</optio>
      <optio>imperfecta_relicta</optio>
    </attributum>
    <attributum nomen="habet-expressionem" genus="referentia"/>
    <attributum nomen="continuatio-de" genus="referentia"/>
    <attributum nomen="respondet-ad" genus="referentia"/>
    <attributum nomen="pars-de" genus="referentia"/>
    <liberum nomen="materia"/>
    <liberum nomen="auctor"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="materia" intra="periodicum" textus="verum"/>
  <elementum nomen="auctor" intra="periodicum">
    <attributum nomen="ad" genus="referentia"/>
  </elementum>
  <elementum nomen="historia" intra="periodicum">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="fasciculus">
    <attributum nomen="nomen" genus="identitas"/>
    <attributum nomen="numerus" genus="textus"/>
    <attributum nomen="publicatus" genus="dies"/>
    <attributum nomen="fasciculus-de" genus="referentia"/>
    <liberum nomen="historia" maximum="1"/>
  </elementum>
  <elementum nomen="historia" intra="fasciculus">
    <liberum nomen="eventum"/>
  </elementum>

  <elementum nomen="eventum" intra="historia" textus="verum">
    <attributum nomen="quando" genus="dies"/>
    <attributum nomen="actio" genus="electio">
      <optio>componi</optio>
      <optio>exprimi</optio>
      <optio>edi</optio>
      <optio>deseri</optio>
    </attributum>
    <attributum nomen="certitudo" genus="nomen"/>
    <attributum nomen="fons" genus="nomen"/>
    <attributum nomen="nota" genus="textus"/>
  </elementum>

  <unicitas nomen="identitas" attributum="nomen"
    nota="nomen= identitas est (par. 5.3): spatium nominum UNUM per genera omnia"
    super="opus-scriptum expressio editio codex periodicum fasciculus"/>

  <!-- CITATIONES: relatio petitum resolutum ferens clavem documenti fit.
       Subsumptio COMPILATA est: petitum cum posteris omnibus in
       indicem ad= enumeratur, quia claves per titulum exactum
       colliguntur et subgenus titulum alium fert. Signa: '#'
       individuum inscriptum (clavis verbatim), '.' genus e
       vocabulario indicis. -->
  <citatio nomen="opus-scriptum-habet-expressionem" attributum="habet-expressionem" ad="expressio/nomen" super="opus-scriptum"/>
  <citatio nomen="opus-scriptum-continuatio-de" attributum="continuatio-de" ad="opus-scriptum periodicum/nomen" super="opus-scriptum"/>
  <citatio nomen="opus-scriptum-respondet-ad" attributum="respondet-ad" ad="opus-scriptum periodicum/nomen" super="opus-scriptum"/>
  <citatio nomen="opus-scriptum-pars-de" attributum="pars-de" ad="opus-scriptum periodicum/nomen" super="opus-scriptum"/>
  <citatio nomen="expressio-expressio-de" attributum="expressio-de" ad="opus-scriptum periodicum/nomen" super="expressio"/>
  <citatio nomen="expressio-translata-ex" attributum="translata-ex" ad="expressio/nomen" super="expressio"/>
  <citatio nomen="editio-editio-de" attributum="editio-de" ad="expressio/nomen" super="editio"/>
  <citatio nomen="codex-exemplar-de" attributum="exemplar-de" ad="editio/nomen" super="codex"/>
  <citatio nomen="periodicum-habet-fasciculum" attributum="habet-fasciculum" ad="fasciculus/nomen" super="periodicum"/>
  <citatio nomen="periodicum-habet-expressionem" attributum="habet-expressionem" ad="expressio/nomen" super="periodicum"/>
  <citatio nomen="periodicum-continuatio-de" attributum="continuatio-de" ad="opus-scriptum periodicum/nomen" super="periodicum"/>
  <citatio nomen="periodicum-respondet-ad" attributum="respondet-ad" ad="opus-scriptum periodicum/nomen" super="periodicum"/>
  <citatio nomen="periodicum-pars-de" attributum="pars-de" ad="opus-scriptum periodicum/nomen" super="periodicum"/>
  <citatio nomen="fasciculus-fasciculus-de" attributum="fasciculus-de" ad="periodicum/nomen" super="fasciculus"/>

</canon>
