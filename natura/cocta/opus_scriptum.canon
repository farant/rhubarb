<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATUM a natura_canones e opus_scriptum - NOLI MANU MUTARE.
     Regenera: ./tools/natura_canones.sh -->
<canon dialectus="opus_scriptum" versio="1">

  <elementum nomen="individua" radix="verum">
    <liberum nomen="opus-scriptum"/>
    <liberum nomen="expressio"/>
    <liberum nomen="editio"/>
    <liberum nomen="codex"/>
    <liberum nomen="periodicum"/>
    <liberum nomen="fasciculus"/>
    <liberum nomen="moby-dick"/>
    <liberum nomen="summa-theologiae"/>
    <liberum nomen="abusus-linguae"/>
    <liberum nomen="systema-naturae"/>
    <liberum nomen="species-plantarum"/>
    <liberum nomen="abusus-linguae-germanice"/>
    <liberum nomen="abusus-linguae-anglice"/>
    <liberum nomen="moby-dick-londinensis-1851"/>
    <liberum nomen="moby-dick-novi-eboraci-1851"/>
    <liberum nomen="systema-naturae-editio-decima"/>
  </elementum>

  <elementum nomen="opus-scriptum">
