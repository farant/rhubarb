<?xml version="1.0" encoding="UTF-8"?>
<!--
  natura/operatio.genera
  Exemplar semanticum: OPERATIO (versio 1, PLASTICUM)
  Genera: ambitus, pensum, incidens.

  Natum ex cursu quinto circuli (praefectus operis / devops).
  Quod paroecia programmatica numquam tetigerat: non elementa
  programmatis nec artefacta, sed OPUS et ADMINISTRATIO - quid
  agendum sit, ubi currat, quid ruperit.

  CRITERIUM ADDRESSABILITATIS (Fran, rota XXXIII) hic primum
  adhibitum: genus meretur quidquid individua habere potest
  quae ID proprio designare velis. Incidens transit (INC-1234,
  "ruina tertii Martii"); ordo prioritatis non transit -
  ordinatio est, non res.
-->
<natura modulus="operatio" versio="1" lingua="latina">

<!-- ==================================================
     AMBITUS - ubi programma currit
     ================================================== -->

<genus nomen="ambitus">

  <definitio>
    Locus ordinatus ubi programmata currunt: machinae,
    figurationes, data, nomina. Non plaga ferri sed CONTEXTUS
    integer quem programma circa se invenit.
  </definitio>

  <glossa lingua="en">An environment: an ordered place where
    programs run - machines, configurations, data, names. Not a
    patch of hardware but the whole context a program finds
    around itself.</glossa>
  <glossa lingua="fr">Un environnement : un lieu ordonné où les
    programmes s'exécutent - machines, configurations, données,
    noms. Non pas un morceau de matériel mais le contexte entier
    que le programme trouve autour de lui.</glossa>

  <proprietates>
    <proprietas nomen="realitas_consequentiae" genus="electio"
      nota="DIFFERENTIA VERA HUIUS GENERIS, et ontologica non
            technica: ambitus non ferro nec figuratione
            distinguuntur sed eo quod error in producente VERUS
            est. Ideo 'in probatione operabatur' sententia vera
            est nec tamen excusatio">
      <optio>ficta</optio>
      <optio>vera</optio>
    </proprietas>
    <proprietas nomen="data_vera" genus="veritas"
      ordinarius="falsum"
      nota="an data hominum verorum contineat - unde obligationes
            custodiae quae ambitum fictum non tangunt"/>
  </proprietates>

  <relationes>
    <relatio nomen="fert" ad="programma" modulus="elementa_programmatis"
      multiplex="verum"/>
    <relatio nomen="situs_in" ad="locus" modulus="locus"
      nota="ambitus alicubi est - unde iurisdictio, unde leges
            de datis trans fines"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <species nomen="ambitus_fabricae">
    <definitio>
      Ubi faber ipse operatur: fractura nihil nocet, ideo
      libertas maxima.
    </definitio>
    <valor nomen="realitas_consequentiae">ficta</valor>
  </species>

  <species nomen="ambitus_probationis">
    <definitio>
      Producentem imitatur ut errores ante producentem
      appareant: pretium eius in FIDELITATE stat - quo minus
      similis, eo minus probat.
    </definitio>
    <valor nomen="realitas_consequentiae">ficta</valor>
  </species>

  <species nomen="ambitus_producens">
    <definitio>
      Ubi homines veri re vera utuntur: error hic damnum verum
      est, non nuntius. Unicus ambitus cuius vitia in mundum
      exeunt.
    </definitio>
    <valor nomen="realitas_consequentiae">vera</valor>
    <valor nomen="data_vera">verum</valor>
  </species>

</genus>

<!-- ==================================================
     PENSUM - commissio agendi
     ================================================== -->

<genus nomen="pensum">

  <definitio>
    Opus certum alicui commissum: quid agendum, a quo, quo
    statu. Non postulatum (quod verum esse debet) nec facultas
    (quod opus praestat) nec vitium (discrepantia) sed
    COMMISSIO AGENDI - quartum quod quadrato fabricationis
    deerat.
  </definitio>

  <glossa lingua="en">A task: a definite piece of work entrusted
    to someone - what is to be done, by whom, in what state. Not
    a requirement (what must be true), nor a capability (what the
    work delivers), nor a defect (a discrepancy), but a
    COMMISSION TO ACT - the fourth term the engineering square
    was missing.</glossa>
  <glossa lingua="fr">Une tâche : un travail déterminé confié à
    quelqu'un - ce qui est à faire, par qui, en quel état. Ni une
    exigence (ce qui doit être vrai), ni une fonctionnalité (ce
    que le travail fournit), ni un défaut (un écart), mais une
    COMMISSION D'AGIR - le quatrième terme qui manquait au carré
    de la fabrication.</glossa>

  <proprietates>
    <proprietas nomen="aestimatio_laboris" genus="quantitas"
      modulus="mensura"
      nota="IUDICIUM est, non mensura (vide
            iudicium.aestimatio: tres aestimatores tria pretia,
            quod non error sed natura iudicii). Ideo
            aestimationem cum facto conferre officium
            praefecti EST, non eius defectus"/>
    <proprietas nomen="terminus" genus="dies"/>
  </proprietates>

  <machina_statuum nomen="cursus" gerens="individuum">
    <status nomen="propositum"/>
    <status nomen="susceptum"/>
    <status nomen="in_opere"/>
    <status nomen="perfectum"/>
    <status nomen="omissum"
      nota="consulto relictum - exitus HONESTUS quem tabulae
            saepe celant, quasi omne pensum perficiendum esset"/>
    <transitus a="propositum" ad="susceptum" per="susceptio"/>
    <transitus a="susceptum" ad="in_opere" per="inceptio"/>
    <transitus a="in_opere" ad="perfectum" per="perfectio"/>
    <transitus a="propositum" ad="omissum" per="omissio"/>
    <transitus a="in_opere" ad="propositum" per="remissio"
      nota="quod susceptum est reddi potest - status ad
            propositum redit, non ad nihilum"/>
  </machina_statuum>

  <relationes>
    <relatio nomen="commissum" ad="persona" modulus="persona"
      nota="cui - et 'nemini' status verus est, non hiatus"/>
    <relatio nomen="implet" ad="postulatum" modulus="fabricatio"
      multiplex="verum"/>
    <relatio nomen="sanat" ad="vitium" modulus="fabricatio"
      multiplex="verum"/>
    <relatio nomen="impeditur_a" ad="pensum" multiplex="verum"
      nota="ordo dependentiae: GRAPHUS, non linea - unde
            'via critica'"/>
  </relationes>

</genus>

<!-- ==================================================
     INCIDENS - vitium in ambitu vero manifestum
     ================================================== -->

<genus nomen="incidens">

  <definitio>
    Interruptio aut deminutio ministerii in ambitu vero: non
    genus vitii sed vitium EXPOSITUM - idem defectus vitium
    semper est, incidens fit cum homines veros attingit.
    Habet initium, finem, gravitatem, responsum.
  </definitio>

  <glossa lingua="en">An incident: an interruption or degradation
    of service in a real environment. Not a kind of defect but a
    defect EXPOSED - the same fault is always a defect, and
    becomes an incident when it reaches real people. It has a
    beginning, an end, a severity, a response.</glossa>
  <glossa lingua="fr">Un incident : une interruption ou une
    dégradation du service dans un environnement réel. Non pas
    une espèce de défaut mais un défaut EXPOSÉ - la même faille
    est toujours un défaut, et elle devient un incident lorsqu'elle
    atteint des personnes réelles. Il a un début, une fin, une
    gravité, une réponse.</glossa>

  <nota>
    QUAESTIO GENERIS (rota XXXIII) Fran solvente: incidens genus
    est, non relatio, quia CRITERIO ADDRESSABILITATIS transit -
    incidentia individua habent quae ID proprio designamus
    ("INC-1234", "ruina tertii Martii"), de quibus loquimur,
    quorum historiam servamus. Quod merx, triage et ordo
    prioritatis non habent. Vitium exponi RELATIO est; incidens
    ipsum RES.
  </nota>

  <proprietates>
    <proprietas nomen="gravitas" genus="electio">
      <optio>levis</optio>
      <optio>gravis</optio>
      <optio>totalis</optio>
    </proprietas>
    <proprietas nomen="duratio" genus="quantitas"
      modulus="mensura"
      nota="quod SLA metitur - unde obligatio et mensura hic
            conveniunt"/>
  </proprietates>

  <machina_statuum nomen="cursus" gerens="individuum">
    <status nomen="deprehensum"/>
    <status nomen="agnitum" nota="ab homine susceptum"/>
    <status nomen="mitigatum"
      nota="ministerium redditum, causa manente - status quem
            schemata binaria (apertum/clausum) perdunt, et in
            quo administratio vera plerumque vivit"/>
    <status nomen="solutum"/>
    <status nomen="recensitum" nota="post-mortem factum"/>
    <transitus a="deprehensum" ad="agnitum" per="agnitio"/>
    <transitus a="agnitum" ad="mitigatum" per="mitigatio"/>
    <transitus a="mitigatum" ad="solutum" per="solutio"/>
    <transitus a="solutum" ad="recensitum" per="recensio"/>
    <transitus a="mitigatum" ad="deprehensum" per="recidivum"
      nota="CYCLUS: mitigatum non sanatum redire potest -
            eadem forma qua morbus recidit et vitium regreditur.
            Tertium dominium eiusdem legis"/>
  </machina_statuum>

  <relationes>
    <relatio nomen="in_ambitu" ad="ambitus"/>
    <relatio nomen="ex_vitio" ad="vitium" modulus="fabricatio"
      nota="non semper: incidens ex mutatione figurationis,
            ex onere, ex defectu ferri oriri potest sine ullo
            vitio codicis"/>
    <relatio nomen="causa_eius" ad="causa" modulus="causa"
      multiplex="verum"
      nota="MULTIPLEX consulto: 'causa radicalis' singularis
            fere semper simplificatio est (vide causa: necessaria
            et sufficiens raro conveniunt)"/>
    <relatio nomen="deprehensum_per" ad="observatio"
      modulus="iudicium"
      nota="monitum SIGNUM est (instrumento mensum, ab omnibus
            verificabile) limen transiens - divisio
            valetudinarii in cella machinarum operans"/>
    <relatio nomen="violat" ad="obligatio" modulus="obligatio"
      nota="SLA obligatio est; incidens eam violare potest"/>
  </relationes>

</genus>

<!-- ==================================================
     PROCESSUS - programma currens

     Umbra a quattuor locis citata et bis diversimode postulata,
     quod definitionem PRAESCRIPSIT: programma.currit_ut eam ut
     INSTANTIAM poscebat ("programma FORMA est, processus
     instantia currens"), dum tres status individui (:errno,
     :semen_rand, :index_strtok) geritur_a ad eam mittebant -
     id est ut GESTOREM STATUS. Genus utrumque esse debet, et
     coniunctio non fortuita est: quod formam instantiat statum
     proprium habet, unde 'errno' sine possessore nihil valet.
     ================================================== -->

<genus nomen="processus">

  <definitio>
    Programma in exsecutione: instantia formae, statum proprium
    gerens, dum vivit allocutione digna. Idem programma centies
    simul currere potest, et centum processus sunt, non unus.
  </definitio>

  <differentia>
    Tertia vice bibliotheca formam ab instantia dividit (post
    linguam/implementationem et opus/expressionem), sed HIC
    instantia TEMPORALIS est, non alia in signis realizatio:
    processus incipit, currit, desinit. Editio operis manet;
    processus manere non potest - finis in natura eius est.
  </differentia>

  <glossa lingua="en">A process: a program in execution - an
    instance of a form, carrying its own state, and worth
    addressing for as long as it lives. The same program can run
    a hundred times at once, and those are a hundred processes,
    not one. Here the instance is TEMPORAL: a process begins,
    runs, ceases - its ending lies in its nature.</glossa>
  <glossa lingua="fr">Un processus : un programme en cours
    d'exécution - une instance d'une forme, portant son propre
    état, et digne d'être adressée tant qu'elle vit. Le même
    programme peut s'exécuter cent fois à la fois, et ce sont
    cent processus, non pas un seul. Ici l'instance est
    TEMPORELLE : un processus commence, s'exécute, cesse - sa fin
    est dans sa nature.</glossa>

  <proprietates>
    <proprietas nomen="identificator_currens" genus="numerus"
      nota="pid. IDENTIFICATOR QUI LOCATUR, NON DATUR: post
            mortem processus numerus alii redditur, unde
            identificator hic CONDUCTIO est, non nomen. Omnis
            alius identificator bibliothecae stabilis est
            (isbn manet, sigillum manet); hic non. Qui pid in
            actis servat rem aliam post horam nominat - vitium
            quod mense octavo mordet, non primo"/>
    <proprietas nomen="valor_exitus" genus="numerus"
      nota="quo modo desierit. Vacuus dum currit"/>
    <proprietas nomen="privilegium" genus="electio">
      <optio>utentis</optio>
      <optio>administratoris</optio>
    </proprietas>
  </proprietates>

  <!-- partes: quibus carens processus non est -->
  <partes>
    <pars nomen="spatium_memoriae" necessaria="verum"/>
    <pars nomen="tabula_descriptorum" necessaria="verum"
      nota="quas plagulas apertas teneat - unde 'omnia plagulae
            sunt' apud systemata unixiformia vim habet"/>
    <pars nomen="ambitus_variabilium" necessaria="verum"/>
    <pars nomen="directorium_currens" necessaria="verum"
      nota="unde viae relativae solvuntur. Pars quam nemo
            declarat donec fallat"/>
    <pars nomen="vector_argumentorum" necessaria="verum"
      nota="argumenta ipsa vacua esse possunt; vector non"/>
  </partes>

  <machina_statuum nomen="cursus" gerens="individuum">
    <status nomen="nascens"/>
    <status nomen="currens"/>
    <status nomen="dormiens"
      nota="exspectans (introitum, tempus, claustrum)"/>
    <status nomen="suspensus" nota="signo retentus"/>
    <status nomen="larva"
      nota="MORTUUS SED NONDUM METATUS: exsecutio finita est,
            valor exitus superest quia parenti DEBETUR. Status
            in quo res ipsa periit et RATIO eius manet - quod
            forma actorum ubique agnoscit (clausura rationis
            post mortem societatis) et intuitio numquam
            praevidet. Qui parentem metere neglegit larvas
            accumulat: non memoria sed NOMINA exhauriuntur"/>
    <status nomen="sublatus"/>
    <transitus a="nascens" ad="currens" per="initium"/>
    <transitus a="currens" ad="dormiens" per="exspectatio"/>
    <transitus a="dormiens" ad="currens" per="excitatio"/>
    <transitus a="currens" ad="suspensus" per="suspensio"/>
    <transitus a="suspensus" ad="currens" per="continuatio"/>
    <transitus a="currens" ad="larva" per="terminatio"/>
    <transitus a="larva" ad="sublatus" per="messis"
      nota="parens valorem exitus legit, et TUNC demum nomen
            liberatur"/>
  </machina_statuum>

  <actiones>
    <actio nomen="gigni"/>
    <actio nomen="terminari" nota="sponte, valorem reddens"/>
    <actio nomen="occidi" nota="ab alio, signo"/>
    <actio nomen="meti" nota="a parente, valorem legente"/>
  </actiones>

  <relationes>
    <relatio nomen="instantia_de" ad="programma"
      modulus="elementa_programmatis"/>
    <relatio nomen="genitus_a" ad="processus"
      nota="arbor processuum. Relatio in se ipsam, ut
            causa.pendet_ex - et hic quoque catena non sponte
            desinit sed in radice sistitur"/>
    <relatio nomen="currit_in" ad="ambitus"/>
    <relatio nomen="gerit" ad="status"
      modulus="elementa_programmatis" multiplex="verum"
      nota="INVERSA eius quod tres status individui iam
            declarabant (geritur_a). Vita status a vita
            processus terminatur: quod 'ephemerum' in
            durabilitate status significat HIC mensuram suam
            invenit"/>
    <relatio nomen="tenet_apertam" ad="plagula_computatralis"
      modulus="plagula_computatralis" multiplex="verum"/>
  </relationes>

  <dubium>
    DAEMON BIS SEDET. Bibliotheca daemonem speciem PROGRAMMATIS
    facit (elementa_programmatis, divisa per modum finiendi:
    terminans/perpetuum). At quod daemonem daemonem facit -
    a terminali solutus, sessionis princeps, parente in radicem
    relicto - de PROCESSU dicitur, non de codice: idem
    exsecutabile daemon esse potest aut non, prout initur. Si
    ita est, daemon huc migrare debet et speciei programmatis
    'perpetuum' solum manere. NON DECISUM: casus cogens unus
    est, et lex domus duos poscit.
  </dubium>

</genus>

</natura>
