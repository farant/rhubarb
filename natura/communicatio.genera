<?xml version="1.0" encoding="UTF-8"?>
<!--
  natura/communicatio.genera
  Exemplar semanticum: COMMUNICATIO (versio 4, PLASTICUM)
  Genera: actor, nuntius, eventum.

  Natum ex confrontatione cum lib/actor.c - prima collisio
  consulta exemplaris cum plagula fontis vera. Genera LOGICA
  sunt (vocabulum Fran): structurae Nuntius/Capsa in actor.c
  realizationes sunt, non genera ipsa - doctrina intentionis
  in communicatione.

  INVENTUM STRATI: criterium canalis declarati per gradus
  invariabile est. Puritas functionis = canalis unus
  (parametra intro, reditus foras); exemplar actorum = idem
  criterium in gradu ENTIS - actor statum proprium solus
  mutat, et via unica qua alii eum movent capsa eius est.
  Capsa actori quod parametra functioni.

  DISTINCTIO FUNDAMENTALIS: nuntius INSCRIPTUS est
  (destinatarius ei debetur), eventum NON (accidit coram
  omnibus, quivis observans videt). Directum contra sparsum.
-->
<natura modulus="communicatio" versio="4" lingua="latina">

<!-- ==================================================
     ACTOR - ens quod solum per nuntios communicat
     ================================================== -->

<.genus nomen="actor">

  <definitio>
    Ens logicum cum identitate, statu privato, moribus: cum
    aliis SOLUM per nuntios communicat. Statum suum solus
    mutat; statum alienum numquam tangit - petit, nuntio
    misso. Forma ab Hewitt (1973) nominata, ab Erlang probata,
    a domo nostra in actor.c realizata.
  </definitio>

  <glossa lingua="en">An actor: a logical entity with an
    identity, private state, and behaviour, which communicates
    with others ONLY by messages. It alone changes its own state
    and never touches anyone else's - it asks, by sending a
    message. The form was named by Hewitt (1973), proven by
    Erlang, and realized in this house in actor.c.</glossa>
  <glossa lingua="fr">Un acteur : une entité logique dotée d'une
    identité, d'un état privé et de comportements, qui ne
    communique avec les autres QUE par messages. Lui seul modifie
    son propre état et ne touche jamais celui d'autrui - il le
    demande, en envoyant un message. La forme fut nommée par
    Hewitt (1973), éprouvée par Erlang, et réalisée dans cette
    maison dans actor.c.</glossa>

  <relationes>
    <relatio nomen="mittit" ad="nuntius" multiplex="verum"/>
    <relatio nomen="accipit" ad="nuntius" multiplex="verum"/>
    <relatio nomen="custodit" ad="status"
      modulus="elementa_programmatis" multiplex="verum"
      nota="status PRIVATUS: nemo alius eum legit nec mutat -
            hoc ipsum exemplar actorum definit"/>
    <relatio nomen="capsa_eius" ad="cauda"
      necessitudo="tenet"
      modulus="formae_datorum"
      nota="canalis declaratus unicus quo alii statum eius
            movent - capsa actori quod parametra functioni"/>
  </relationes>

</.genus>

<!-- ==================================================
     NUNTIUS - communicatio reificata et inscripta
     ================================================== -->

<.genus nomen="nuntius">

  <definitio>
    Communicatio reificata: data in itinere INSCRIPTA -
    destinatarius ei debetur. Actus communicandi in rem
    conversus: poni in caudam, recordari, iterum agi potest.
    Mittere nuntium = petere ut alter se mutet; petitio ipsa
    res facta.
  </definitio>

  <glossa lingua="en">A message: communication made into a thing
    - data in transit, ADDRESSED, since a recipient is owed to
    it. The act of communicating turned into an object: it can be
    put in a queue, recorded, replayed. To send a message is to
    ask another to change itself; the request itself has been
    made a thing.</glossa>
  <glossa lingua="fr">Un message : la communication réifiée -
    des données en transit, ADRESSÉES, car un destinataire lui
    est dû. L'acte de communiquer converti en chose : on peut le
    mettre en file, l'enregistrer, le rejouer. Envoyer un
    message, c'est demander à un autre de se modifier ; la
    demande elle-même devenue chose.</glossa>

  <proprietates>
    <proprietas nomen="genus_nuntii" genus="textus"
      nota="species nuntiorum in applicationibus tempore
            currendi nominantur ('tick', 'click') - hic natura
            mordere potest: genera nuntiorum a bibliotheca
            definita"/>
    <proprietas nomen="disciplina_schematis" genus="electio"
      nota="sine schemate = sacculus clavium, typi in lectione
            negotiati (actor.c); cum schemate = claves et typi
            ante declarati (nuntium.h domus). Realizationes
            ambae in domo vivunt - forma una, disciplinae
            oppositae">
      <optio>sine_schemate</optio>
      <optio>cum_schemate</optio>
    </proprietas>
    <proprietas nomen="garantia_traditionis" genus="electio"
      nota="quid de traditione promittatur. LEX QUAM NEMO CREDIT
            DONEC MORDEAT: traditio SEMEL-EXACTE impossibilis
            est - mittens qui confirmationem non accepit nescit
            an nuntius an confirmatio perierit, et utrumque
            eligere (iterare aut tacere) alterutrum vitium
            admittit. Quod praestari POTEST est tractatio
            semel-exacte, per idempotentiam apud recipientem.
            Ideo systemata quae 'exactly once' pollicentur aut
            idempotentiam supponunt aut mentiuntur - et hoc
            discrimen consumptor scire debet">
      <optio>ad_summum_semel</optio>
      <optio>ad_minimum_semel</optio>
      <optio>semel_exacte_tractatum</optio>
    </proprietas>
  </proprietates>

  <machina_statuum nomen="cursus" gerens="individuum">
    <status nomen="creatus"/>
    <status nomen="missus"/>
    <status nomen="traditus"
      nota="in capsa destinatarii, nondum lectus"/>
    <status nomen="consumptus"/>
    <transitus a="creatus" ad="missus" per="missio"/>
    <transitus a="missus" ad="traditus" per="traditio"/>
    <transitus a="traditus" ad="consumptus" per="consumptio"
      nota="lectio destructiva caudae - compositum lectionis
            et mutationis (vide elementa_programmatis.lectio)"/>
  </machina_statuum>

  <relationes>
    <relatio nomen="portat" ad="petitio" necessitudo="fert" modulus="obligatio"
      nota="nuntius petitionem FERRE potest sed ea non est:
            petitio perdurat, nuntius transit, et petitio una
            nuntiis pluribus portari potest (repetitionibus) -
            quod totam idempotentiae rationem facit"/>
    <relatio nomen="missus_a" ad="actor"/>
    <relatio nomen="destinatus_ad" ad="actor"
      necessitudo="translatio_nuntii"/>
  </relationes>

</.genus>

<!-- ==================================================
     EVENTUM - res gesta non inscripta
     ================================================== -->

<.genus nomen="eventum">

  <definitio>
    Res gesta NON inscripta: accidit, et quivis observans
    videre potest - nulli debetur. A nuntio inscriptione
    differt: nuntius AD aliquem, eventum CORAM omnibus.
  </definitio>

  <glossa lingua="en">An event: something done that is NOT
    addressed - it happens, and any observer can see it; it is
    owed to no one. It differs from a message by address: a
    message goes TO someone, an event happens BEFORE
    everyone.</glossa>
  <glossa lingua="fr">Un événement : un fait qui n'est PAS
    adressé - il survient, et quiconque observe peut le voir ; il
    n'est dû à personne. Il diffère du message par l'adresse : le
    message va À quelqu'un, l'événement se produit DEVANT
    tous.</glossa>

  <nota>
    Elementum "eventum" in historiis exemplarium horum hoc
    ipsum genus est: historia rei = cauda eventuum eius, status
    praesens = plicatura. Cognatio vera, non homonymia -
    metamodulus noster genus suum iam adhibebat.
  </nota>

  <relationes>
    <relatio nomen="observatur_ab" ad="actor"
      necessitudo="legitur_a" multiplex="verum"
      nota="observantes se subscribunt; res gesta eos non
            novit - hoc eam a nuntio distinguit"/>
  </relationes>

</.genus>


<!-- ==================================================
     STIGMERGIA - coordinatio per vestigium in medio relictum

     MODUS TERTIUS, cursu duodecimo (apicultura) inventus.
     Exemplar hoc duos habebat et tertium non videbat:
       nuntius   INSCRIPTUS - destinatarius ei debetur
       eventum   non inscriptus, sed MOMENTANEUM - accidit coram
                 praesentibus et abit
       stigmergia non inscripta ET MANENS - vestigium in medio
                 relinquitur, a quolibet transeunte legitur,
                 et TABESCIT
     Nulla apis alteri quicquam dicit. Regina feromonum emittit;
     illud per cuneum diffunditur; operaria concentrationem
     LOCALEM legit. Infra limen: reginam mortuam esse constat, et
     educatio incipit. Nemo nuntiavit.

     ET TABESCENTIA MECHANISMUS EST, NON DEFECTUS: semita quae
     non evanesceret formicas ad florem exhaustum in aeternum
     duceret. Oblivio hic gratuita est et necessaria - quod ars
     computatralis "invalidationem promptuarii" vocat et
     difficillimam habet, natura tempori committit.
     ================================================== -->

<.genus nomen="stigmergia">

  <definitio>
    Coordinatio per vestigium quod agens in medio communi
    relinquit: signum nulli inscriptum, quod manet, a quolibet
    transeunte legi potest, et per se tabescit. Non mittitur nec
    accidit sed IACET.
  </definitio>

  <differentia>
    Sine mittente et sine destinatario SIMUL. Nuntius
    destinatarium habet, eventum spectatores praesentes; hic
    neutrum - qui vestigium relinquit nescit an quisquam
    veniat, et qui legit nescit quis reliquerit. Ideo agentes
    NEC SE INVICEM NOSSE NEC SIMUL ADESSE debent, quod
    coordinationem inter multa et ignota et per tempus dispersa
    solum possibilem facit.
  </differentia>

  <glossa lingua="en">Stigmergy: coordination by a trace that an
    agent leaves in a shared medium - a sign addressed to no one,
    which remains, which any passer-by can read, and which decays
    of itself. It is neither sent nor does it merely happen: it
    LIES there. Having neither sender nor recipient, it makes
    coordination possible among agents who need neither know one
    another nor be present at the same time.</glossa>
  <glossa lingua="fr">La stigmergie : la coordination par une
    trace qu'un agent laisse dans un milieu commun - un signe
    adressé à personne, qui demeure, que tout passant peut lire,
    et qui s'efface de lui-même. Elle n'est ni envoyée ni un
    simple fait : elle GÎT là. N'ayant ni expéditeur ni
    destinataire, elle rend possible la coordination d'agents qui
    n'ont besoin ni de se connaître ni d'être présents en même
    temps.</glossa>

  <proprietates>
    <proprietas nomen="tabescentia" genus="quantitas"
      modulus="mensura"
      nota="quam cito vestigium evanescat. PROPRIETAS
            CARDINALIS, et fere semper neglecta: sine
            tabescentia coordinatio in praeteritum ligatur -
            semita ad florem exhaustum manet, promptuarium
            rancidum servit, directorium aedificationis
            artefacta mortua tenet. Tabescentia oblivio
            GRATUITA est, quam nemo agere debet"/>
    <proprietas nomen="cumulativa" genus="veritas"
      ordinarius="verum"
      nota="an vestigia plura idem signum FIRMENT. Ubi verum,
            suffragium sponte fit sine ullo suffragio:
            semita quam plures calcaverunt fortior est, et
            fortior plures trahit - unde electio optimi sine
            electore. Ubi falsum, vestigium ultimum solum valet
            (status operis in arbore)"/>
    <proprietas nomen="medium" genus="textus"
      nota="quid vestigium ferat - aer, terra, cera, plagula,
            tabula. MEDIUM PARS RATIONIS EST: quod medium
            servare non potest, stigmergia dicere non potest"/>
  </proprietates>

  <relationes>
    <relatio nomen="relinquitur_a" ad="*" necessitudo="origo" multiplex="verum"/>
    <relatio nomen="legitur_a" ad="*" multiplex="verum"/>
    <relatio nomen="movet" ad="*" necessitudo="afficit"
      nota="quid agatur cum vestigium legitur"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <.species nomen="vestigium_chemicum">
    <definitio>
      Substantia ab agente relicta quae per diffusionem legitur:
      semita formicarum, feromonum reginae, signum territorii.
    </definitio>
    <nota>
      Species in qua ABSENTIA signum est: apes reginam vivere ex
      feromonis PRAESENTIA sciunt, mortuam ex DEFECTU. Nemo
      mortem nuntiat; silentium eam dicit. Idem quod pulsus
      (heartbeat) in machinis, quattuor decies milies annis
      prius.
    </nota>
  </.species>

  <.species nomen="semita_trita">
    <definitio>
      Via quam transeuntes calcando faciunt et calcando servant:
      quod aedificatores "semitas desiderii" vocant.
    </definitio>
    <valor nomen="cumulativa">verum</valor>
    <nota>
      Specimen purissimum electionis sine electore: nemo semitam
      designavit, nemo de ea consensit, et tamen optima exit -
      quia cumulatio suffragium est et tabescentia errorem
      corrigit. Architecti sapientes eas EXSPECTANT antequam
      pavimentum ponant.
    </nota>
  </.species>

  <.species nomen="tabula_communis">
    <definitio>
      Superficies quam multi mutant et legunt sine ordine
      praestituto: tabula parietis, commentarius communis,
      vicipaedia.
    </definitio>
    <valor nomen="cumulativa">falsum</valor>
    <nota>
      Species ubi tabescentia DEEST et defectus inde sequitur:
      quod scriptum est manet donec quis deleat, unde tabulae
      communes rancescunt et nemo scit quid adhuc valeat. Quod
      natura tempori committit, hic homini committitur - et homo
      neglegit.
    </nota>
  </.species>

  <.species nomen="vestigia_operis">
    <definitio>
      Arbor plagularum quam instrumenta legunt ut quid agendum
      sit statuant: directorium aedificationis, arbor laborans.
    </definitio>
    <nota>
      Stigmergia inter instrumenta quae se invicem non norunt:
      compilator artefacta relinquit, ligator ea invenit, nemo
      alteri nuntiat. Silex ipse hoc agit - proiectio arborem
      scribit, clang eam legit, et 'proiectio CONTRACTUS est'
      (visio silicis) stigmergiam ipsam nominat sine nomine.
    </nota>
  </.species>

</.genus>

</natura>
