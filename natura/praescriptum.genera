<?xml version="1.0" encoding="UTF-8"?>
<!--
  natura/praescriptum.genera
  Exemplar semanticum: PRAESCRIPTUM (versio 3, PLASTICUM)
  Genera: praescriptum, gradus_praescripti, versio_praescripti.

  Natum ex experimento pistrinae: recepta panis. Cognatum
  FUNCTIONIS humanum - ordo operationum cum introitibus
  declaratis et exitu exspectato, sed ab HOMINE exsecutum.

  DISCRIMEN QUOD OMNIA MUTAT: exsecutor functionis machina est
  (eadem semper); exsecutor praescripti persona est (peritia
  varia, iudicium proprium, errare potens). Ideo praescriptum
  ambiguitatem ferre POTEST ubi functio non potest ("coque
  donec aureum fiat") - et haec ambiguitas non defectus sed
  fiducia in iudicio exsecutoris est.

  DOMUS NOSTRA PRAESCRIPTIS PLENA EST, innominatis: contractus
  correspondentis fori, indices verificationis, ipsae normae
  huius bibliothecae in CLAUDE.md scriptae.
-->
<natura modulus="praescriptum" versio="3" lingua="latina">

<!-- ==================================================
     PROCEDURA - ordo operationum ad finem
     (parens rota XXXII inventus: fistula CI eandem formam
     habet quam praescriptum, exsecutore contrario. Divisio
     ritus/praescripti SPECULATA - ille plus quam peritiam
     poscit, haec minus.)
     ================================================== -->

<.genus nomen="procedura">

  <definitio>
    Ordo operationum ad finem: introitus declarati, gradus
    ordinati, exitus exspectatus. Quis eos exsequatur haec non
    dicit - et in eo tota divisio subsequens stat.
  </definitio>

  <glossa lingua="en">A procedure: an order of operations directed
    to an end - declared inputs, ordered steps, an expected
    outcome. It does not say who is to carry them out, and on that
    silence the whole division below it rests.</glossa>
  <glossa lingua="fr">Une procédure : un ordre d'opérations en vue
    d'une fin - entrées déclarées, étapes ordonnées, résultat
    attendu. Elle ne dit pas qui les exécute, et c'est sur ce
    silence que repose toute la division qui suit.</glossa>

  <relationes>
    <relatio nomen="gradus_eius" ad="gradus_praescripti"
      multiplex="verum"/>
  </relationes>

</.genus>

<!-- ==================================================
     PROCEDURA AUTOMATA - a machina exsecuta
     ================================================== -->

<.genus nomen="procedura_automata" sub="procedura">

  <differentia>
    A MACHINA exsecuta, ideo AMBIGUITATIS TOLERANTIA NULLA:
    ubi praescriptum "donec aureum fiat" dicere potest quia homo
    iudicat, haec omnia numeris et condicionibus determinare
    debet. Quod praescripto fiducia est, huic defectus esset.
    Contra: iterari potest infinities eodem prorsus effectu,
    quod homo non praestat.
  </differentia>

  <glossa lingua="en">An automated procedure: one carried out by a
    MACHINE, and therefore with NO tolerance for ambiguity. Where a
    recipe may say "until it turns golden" because a person judges,
    this must settle everything in numbers and conditions; what is
    trust in a recipe would here be a defect. In exchange it can be
    repeated endlessly with exactly the same effect, which no
    person can promise.</glossa>
  <glossa lingua="fr">Une procédure automatisée : exécutée par une
    MACHINE, et donc SANS aucune tolérance à l'ambiguïté. Là où une
    recette peut dire « jusqu'à ce que ce soit doré » parce qu'un
    homme juge, celle-ci doit tout fixer en nombres et en
    conditions ; ce qui est confiance dans la recette serait ici un
    défaut. En revanche elle peut se répéter à l'infini avec
    exactement le même effet, ce qu'aucun homme ne
    garantit.</glossa>

  <proprietates>
    <proprietas nomen="idempotens" genus="veritas"
      ordinarius="falsum"
      nota="an bis exsecuta idem efficiat - proprietas quae
            administrationem totam regit (vide
            elementa_programmatis.mutatio: eadem lex)"/>
    <proprietas nomen="reversibilis" genus="veritas"
      ordinarius="falsum"
      nota="an effectus revocari possit - unde 'revolutio'
            (rollback), quae plerumque procedura ALIA est, non
            haec inversa"/>
  </proprietates>

  <machina_statuum nomen="cursus" gerens="individuum">
    <status nomen="exspectans"/>
    <status nomen="currens"/>
    <status nomen="perfecta"/>
    <status nomen="lapsa" nota="gradu aliquo deficiente"/>
    <status nomen="intercepta" nota="ab homine sistita"/>
    <transitus a="exspectans" ad="currens" per="inceptio"/>
    <transitus a="currens" ad="perfecta" per="perfectio"/>
    <transitus a="currens" ad="lapsa" per="defectio"/>
    <transitus a="currens" ad="intercepta" per="interceptio"/>
    <transitus a="lapsa" ad="exspectans" per="retentatio"
      nota="CYCLUS: retentare licet, et saepe SUFFICIT - unde
            defectus 'intermittentes', qui procedurae non
            proprietas sed vitium celatum sunt"/>
  </machina_statuum>

  <relationes>
    <relatio nomen="porta_humana" ad="persona" modulus="persona"
      nota="gradus qui approbationem hominis exspectat: locus
            ubi procedura automata in actum sollemnem transit -
            approbatio enim capacitatem poscit, non peritiam"/>
    <relatio nomen="efficit" ad="artefactum_aedificationis"
      modulus="elementa_programmatis" multiplex="verum"/>
    <relatio nomen="agit_in" ad="ambitus" modulus="operatio"
      nota="ubi currat - et differentia ambitus (realitas
            consequentiae) huic proprietatem gravissimam dat"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <.species nomen="fistula_integrationis">
    <definitio>
      Procedura quae fontes mutatos aedificat et probat: porta
      quae opus ante coniunctionem iudicat.
    </definitio>
  </.species>

  <.species nomen="depositio">
    <definitio>
      Procedura quae artefactum in ambitum ponit: actus qui
      mutat quid re vera currat - unde in ambitu producente
      gravissima omnium.
    </definitio>
    <valor nomen="reversibilis">verum</valor>
  </.species>

</.genus>

<.genus nomen="praescriptum" sub="procedura">

  <definitio>
    Ordo operationum ad finem, ab homine exsequendus: introitus
    declarati (materiae, instrumenta), gradus ordinati, exitus
    exspectatus. Functionis cognatum humanum - eadem forma,
    exsecutor alius.
  </definitio>

  <glossa lingua="en">A recipe, or prescribed procedure: an order
    of operations directed to an end and to be carried out BY A
    PERSON - declared inputs (materials, tools), ordered steps, an
    expected outcome. It is the human cousin of a function: the
    same shape, a different executor.</glossa>
  <glossa lingua="fr">Une recette, ou procédure prescrite : un ordre
    d'opérations en vue d'une fin, à exécuter PAR UN HOMME -
    entrées déclarées (matières, instruments), étapes ordonnées,
    résultat attendu. C'est le parent humain de la fonction : même
    forme, exécutant différent.</glossa>

  <proprietates>
    <proprietas nomen="peritia_postulata" genus="electio"
      nota="quantum iudicii exsecutor ferre debet - praescriptum
            peritis scriptum multa TACET consulto">
      <optio>nulla</optio>
      <optio>mediocris</optio>
      <optio>magna</optio>
    </proprietas>
    <proprietas nomen="proventus" genus="quantitas"
      modulus="mensura"
      nota="quantum efficit - 'panes duodecim'; SCALARI potest,
            sed non semper linealiter (fermentum et tempus
            coctionis obstant): scalatio nota praescripti
            propria"/>
    <proprietas nomen="mora" genus="quantitas" modulus="mensura"
      nota="tempus totum - saepe maius quam summa graduum
            (exspectatio non est labor: massa sola fermentat)"/>
  </proprietates>

  <machina_statuum nomen="observantia" gerens="individuum"
    nota="cursus EXSECUTIONIS unius, non praescripti ipsius">
    <status nomen="inceptum"/>
    <status nomen="in_cursu"/>
    <status nomen="perfectum"/>
    <status nomen="desertum"/>
    <transitus a="inceptum" ad="in_cursu" per="inceptio"/>
    <transitus a="in_cursu" ad="perfectum" per="perfectio"/>
    <transitus a="in_cursu" ad="desertum" per="desertio"/>
  </machina_statuum>

  <partes>
    <pars nomen="materiae" necessaria="falsum"
      nota="introitus - honeste optionales: praescriptum pure
            operativum (index verificationis) materiis caret"/>
    <pars nomen="gradus" necessaria="verum"/>
    <pars nomen="exitus" necessaria="verum"/>
  </partes>

  <relationes>
    <relatio nomen="exsequitur" a="persona" modulus="persona"
      inversa="verum"/>
    <relatio nomen="postulat" ad="materia" modulus="corporalia"
      multiplex="verum"/>
    <relatio nomen="efficit" ad="artefactum" modulus="corporalia"/>
    <relatio nomen="publicatum_in" ad="opus_scriptum"
      modulus="opus_scriptum"
      nota="liber coquinarius praescripta CONTINET - opus quod
            genus aliud continet, nexus trans exemplaria
            gratuitus"/>
    <relatio nomen="auctor" ad="persona" modulus="persona"/>
    <relatio nomen="ortum_ex" ad="praescriptum"
      nota="genealogia receptorum: praescriptum ex alio aptatum -
            eadem forma qua linguae ex linguis oriuntur"/>
  </relationes>

</.genus>

<!-- ==================================================
     GRADUS PRAESCRIPTI - operatio una ordinata
     ================================================== -->

<.genus nomen="gradus_praescripti">

  <definitio>
    Operatio una in ordine: actio, fortasse cum quantitate,
    fortasse cum mora, fortasse cum conditione finiendi.
  </definitio>

  <glossa lingua="en">A step of a recipe: one operation within the
    order - an action, perhaps with a quantity, perhaps with a
    duration, perhaps with a condition for stopping.</glossa>
  <glossa lingua="fr">Une étape de la recette : une seule opération
    dans l'ordre - une action, éventuellement avec une quantité,
    éventuellement avec une durée, éventuellement avec une
    condition d'arrêt.</glossa>

  <proprietates>
    <proprietas nomen="ordo" genus="numerus"/>
    <proprietas nomen="mora" genus="quantitas" modulus="mensura"/>
    <proprietas nomen="conditio_finis" genus="textus"
      nota="'donec aureum fiat' - finis per IUDICIUM, non per
            horologium: ambiguitas consulta quae exsecutori
            humano fidit. Machina hoc ferre non potest;
            praescriptum potest"/>
    <proprietas nomen="simultaneus" genus="veritas"
      ordinarius="falsum"
      nota="dum aliud fit - gradus non semper series pura est
            (fornax calescit dum massa formatur)"/>
  </proprietates>

  <relationes>
    <relatio nomen="gradus_de" a="praescriptum" inversa="verum"/>
    <relatio nomen="pendet_ex" ad="gradus_praescripti"
      multiplex="verum"
      nota="ordo verus GRAPHUS est, non linea: quod praescriptum
            ut seriem scribitur, conveniendi causa est"/>
  </relationes>

</.genus>

<!-- ==================================================
     VERSIO PRAESCRIPTI - editio nominata
     (quintus pulsus formae versionis: lingua, architectura,
     systema, opus, nunc praescriptum. Regula Fran manet:
     manu cusa, sine mechanismo)
     ================================================== -->

<.genus nomen="versio_praescripti" sub="versio" modulus="versio">

  <definitio>
    Editio praescripti nominata et citabilis: quod praescriptum
    per emendationes transit, identitate manente ("receptum
    aviae, ut anno 1998 emendatum").
  </definitio>

  <glossa lingua="en">A version of a recipe: a named and citable
    issue of it - a recipe passes through revisions while its
    identity remains ("grandmother's recipe, as revised in
    1998").</glossa>
  <glossa lingua="fr">Une version de la recette : une édition
    nommée et citable - une recette traverse des révisions sans
    que son identité change (« la recette de grand-mère, telle que
    révisée en 1998 »).</glossa>

  <relationes>
    <relatio nomen="versio_de" ad="praescriptum"/>
    <relatio nomen="sequitur" ad="versio_praescripti"/>
    <relatio nomen="emendata_a" ad="persona" modulus="persona"/>
  </relationes>

</.genus>

<!-- ==================================================
     INDEX VERIFICATIONIS - qui CONFIRMAT, non docet
     (aviatio rota XXXIX poposcit: index aviatorius
     praecepta NON est - gubernator volare scit)
     ================================================== -->

<.genus nomen="index_verificationis" sub="procedura">

  <differentia>
    CONFIRMAT quod factum sit; non docet quomodo fiat. Exsecutor
    artem iam tenet - index exsistit quia SCIRE NON EST FACERE
    sub onere, festinatione, fatigatione. Ideo defectum quem
    prohibet non ignorantia est sed OMISSIO.
  </differentia>

  <glossa lingua="en">A checklist: a procedure that CONFIRMS what
    has been done; it does not teach how to do it. The one who runs
    it already holds the art - the list exists because KNOWING IS
    NOT DOING under burden, haste and fatigue. The failure it
    prevents is therefore not ignorance but OMISSION.</glossa>
  <glossa lingua="fr">Une liste de vérification : une procédure qui
    CONFIRME ce qui a été fait ; elle n'enseigne pas comment le
    faire. Celui qui l'exécute possède déjà l'art - la liste existe
    parce que SAVOIR N'EST PAS FAIRE sous la charge, la hâte et la
    fatigue. Le défaut qu'elle empêche n'est donc pas l'ignorance
    mais l'OMISSION.</glossa>

  <proprietates>
    <proprietas nomen="modus" genus="electio"
      nota="distinctio aviatoria formalis: FACERE-CONFIRMARE
            (memoriter agis, deinde index confirmat - apte ubi
            tempus urget) contra LEGERE-FACERE (index dictat,
            tu sequeris - apte ubi error letalis et tempus
            adest)">
      <optio>facere_confirmare</optio>
      <optio>legere_facere</optio>
    </proprietas>
    <proprietas nomen="pro_casu" genus="veritas"
      ordinarius="falsum"
      nota="an ad casum extraordinarium pertineat (incendium,
            defectio machinae) - indices normales oblivionem
            prohibent, indices casuum PANICUM"/>
  </proprietates>

  <nota>
    CONSEQUENTIA PRACTICA QUAE GENUS MERETUR: quia CONFIRMAT et
    non docet, exercitatio eum SUBSTITUERE NON POTEST - peritior
    fis, oblivisci tamen potes, immo peritior facilius omittit
    quia manus sine mente currunt. "Diligentiores estote" nihil
    valet contra omissionem; index valet.
    Et contra: index ei qui artem non tenet INUTILIS est -
    instrumentum PERITI est, non tironis. Qui indicem pro
    doctrina adhibet utrumque perdit.
  </nota>

  <relationes>
    <relatio nomen="confirmat" ad="*"
      nota="UMBRA 'actio' SOLUTA RETRO (rota XLV), non genere
            novo: quod index confirmat non actio est sed RES UT
            ESSE DEBET - 'flaps SET' statum confirmat, non
            motum manus. Actio, status, absentia ('area
            libera') - quidlibet confirmabile. Genus 'actio'
            coinatum fuisset mendacium apertum: dimidium
            indicum aviatoriorum status confirmat"/>
    <relatio nomen="adhibetur_in" ad="ambitus" modulus="operatio"
      multiplex="verum"/>
  </relationes>

</.genus>

</natura>
