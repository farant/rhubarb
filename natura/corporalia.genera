<?xml version="1.0" encoding="UTF-8"?>
<!--
  natura/corporalia.genera
  Exemplar semanticum: CORPORALIA (versio 4, PLASTICUM)
  Genera: res_corporea, artefactum, materia, instrumentum,
  vivens.

  v0->v1 (cursu secundo circuli coactum): VIVENS natum - ramus
  TERTIUS rei corporeae. Divisio v0 (factum / materia) rem
  VIVAM omisit, quod exemplar valetudinarii statim ostendit:
  corpus aegrotae nec artefactum est (nemo id fecit) nec
  materia (numerabile est, haecceitatem habet).

  MECHANISMUS NOVUS HINC COACTUS - SUBORDINATIO TRANS
  EXEMPLARIA: planta sub vivente est, sed in exemplari alio
  habitat. Attributum modulus= in genere iuxta sub= (eadem
  significatio qua in relationibus: modulus rei ad quam
  monstratur). Ratio: ARBOR UNA EST; exemplaria plagulae sunt,
  non regna. Divisio in plagulas commoditas nostra est, non
  factum de rebus - et arbor Porphyriana lineas plagularum
  nescit.

  Natum ex experimento pistrinae: panis, farina, fornax. Res
  CORPOREAE factae - bibliotheca hactenus artefacta digitalia
  (plagulae) et viventia (plantas) habebat, facta corporea
  nulla.

  DIVISIO FUNDAMENTALIS (ontologia vera, non commoditas):
  NUMERABILIA contra MENSURABILIA. Panes numerantur, farina
  mensuratur; "tres farinae" nihil significat. Grammatica hoc
  iam novit (nomina numerabilia et continua), et divisio ipsa
  praedicamento quantitatis subest: discretum contra continuum.

  IDENTITAS: artefactum individuum haecceitatem habet (HIC
  panis); materia eam NON habet - massa farinae divisa duae
  massae fiunt, coniunctae una: identitas per divisionem non
  servatur. Vide elementa_programmatis.identificator: materia
  ad sigillum contenti accedit (forma sola), artefactum ad
  baptismum.
-->
<natura modulus="corporalia" versio="4" lingua="latina">

<!-- ========== NECESSITUDINES DOMESTICAE ========== -->

<necessitudo nomen="ingreditur" conversum="ex_materia"
    sub="pars_totum" modulus="necessitudines" a="*" ad="*">
  <definitio>Materia quae in artefactum intrat; conversa via,
    artefactum ex materia factum. Causa materialis - familia
    partis-toti 'sive materialiter' ipsa dicit.</definitio>
  <glossa lingua="en">Enters-into / made-from: the material-cause
    pair.</glossa>
</necessitudo>

<!-- ==================================================
     RES CORPOREA - quod materiam et locum habet
     ================================================== -->

<.genus nomen="res_corporea">

  <definitio>
    Quod materiam habet, locum occupat, tempore corrumpitur:
    res quae manibus tangi potest. A rebus digitalibus eo
    differt quod exemplari NON potest - copia panis panem
    alterum poscit, copia plagulae nihil.
  </definitio>

  <glossa lingua="en">A bodily thing: what has matter, occupies a
    place and is corrupted by time - a thing that can be touched
    with the hands. It differs from digital things in that it
    CANNOT be copied: a copy of a loaf demands another loaf, a copy
    of a file demands nothing.</glossa>
  <glossa lingua="fr">Une chose corporelle : ce qui a de la matière,
    occupe un lieu et se corrompt avec le temps - une chose que
    l'on peut toucher de la main. Elle diffère des choses
    numériques en ce qu'elle ne peut PAS être copiée : copier un
    pain exige un second pain, copier un fichier n'exige rien.</glossa>

  <proprietates>
    <proprietas nomen="massa" genus="quantitas"
      modulus="mensura"/>
    <proprietas nomen="perituram" genus="veritas"
      ordinarius="falsum"
      nota="an tempore corrumpatur - panis perit, ferrum
            tardius, aurum vix"/>
  </proprietates>

  <machina_statuum nomen="conditio" gerens="individuum">
    <status nomen="recens"/>
    <status nomen="vetus" nota="adhuc utilis, non optima"/>
    <status nomen="corrupta"/>
    <transitus a="recens" ad="vetus" per="mora"
      nota="transitus a TEMPORE actus, non ab actore: nemo
            panem vetus facit, mora facit. Machinae
            elementorum omnes actionem poscebant; res corporea
            per solam moram transit"/>
    <transitus a="vetus" ad="corrupta" per="mora"/>
  </machina_statuum>

  <relationes>
    <relatio nomen="sita_in" ad="locus" modulus="locus"
      nota="res corporea SEMPER alicubi est - proprietas quam
            res digitalis non habet"/>
  </relationes>

</.genus>

<!-- ==================================================
     ARTEFACTUM - res corporea ab homine facta
     ================================================== -->

<.genus nomen="artefactum" sub="res_corporea">

  <differentia>
    Ab homine facta ad finem: NUMERABILIS, singularis,
    haecceitatem habens - hic panis, non alius, etiamsi
    gemellus adsit. Forma ei ab artifice imposita, non a natura
    orta.
  </differentia>

  <glossa lingua="en">An artefact: a bodily thing made by man for an
    end. It is COUNTABLE and singular and has thisness - this loaf,
    not another, even when its twin sits beside it. Its form is
    imposed on it by the maker, it does not arise from
    nature.</glossa>
  <glossa lingua="fr">Un artefact : une chose corporelle faite par
    l'homme en vue d'une fin. Il est DÉNOMBRABLE et singulier et
    possède une eccéité - ce pain-ci, non un autre, même si son
    jumeau est à côté. Sa forme lui est imposée par l'artisan, elle
    ne naît pas de la nature.</glossa>

  <partes>
    <pars nomen="materiae_constituentes" necessaria="verum"
      nota="ex quibus fit - in artefacto materiae formam
            accipiunt et res novae fiunt: farina in pane
            farina esse desinit"/>
  </partes>

  <relationes>
    <relatio nomen="factum_per" ad="praescriptum"
      necessitudo="exsecutio"
      modulus="praescriptum"/>
    <relatio nomen="factum_a" ad="persona" modulus="persona"
      necessitudo="origo"
      nota="factio sine responsione - mos scribae, non auctoris"/>
    <relatio nomen="ex_materia" ad="materia" multiplex="verum"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <.species nomen="cibus">
    <definitio>
      Artefactum consumendo destinatum: usus eum DESTRUIT -
      nota quae cibum ab omnibus fere artefactis distinguit
      (instrumentum usu servatur, cibus usu perit).
    </definitio>
  </.species>

</.genus>

<!-- ==================================================
     MATERIA - quod mensuratur, non numeratur
     ================================================== -->

<.genus nomen="materia" sub="res_corporea">

  <differentia>
    MENSURABILIS non numerabilis: farina, aqua, oleum - "tres
    farinae" nihil significat. Divisa manet quod erat (media
    massa farinae farina est); artefactum divisum perit
    (dimidius panis panis non est, sed pars panis). Identitas
    individua ei DEEST - forma sola eam constituit.
  </differentia>

  <glossa lingua="en">Matter, or stuff: a bodily thing that is
    MEASURED and not counted - flour, water, oil; "three flours"
    means nothing. Divided, it stays what it was (half a mass of
    flour is flour), whereas a divided artefact perishes (half a
    loaf is not a loaf but a part of one). Individual identity is
    LACKING to it: its form alone constitutes it.</glossa>
  <glossa lingua="fr">La matière : une chose corporelle que l'on
    MESURE au lieu de la compter - farine, eau, huile ; « trois
    farines » ne signifie rien. Divisée, elle reste ce qu'elle
    était (la moitié d'une masse de farine est de la farine),
    tandis qu'un artefact divisé périt (une moitié de pain n'est
    pas un pain mais une partie de pain). L'identité individuelle
    lui MANQUE : sa forme seule la constitue.</glossa>

  <proprietates>
    <proprietas nomen="quantitas_praesens" genus="quantitas"
      modulus="mensura"
      nota="quantum adest - materia numquam 'unum' est, semper
            'tantum'"/>
  </proprietates>

  <relationes>
    <relatio nomen="ingreditur" ad="artefactum" multiplex="verum"
      nota="materia in artefactum ingressa saepe DESINIT esse
            quod erat - transformatio, non compositio sola"/>
  </relationes>

</.genus>

<!-- ==================================================
     INSTRUMENTUM - artefactum ad faciendum
     ================================================== -->

<.genus nomen="instrumentum" sub="artefactum">

  <differentia>
    Ad faciendum factum, non ad consumendum: usu SERVATUR (immo
    usus eius finis est), non destruitur. Fornax panem facit et
    fornax manet - hoc instrumentum a cibo et materia
    distinguit.
  </differentia>

  <glossa lingua="en">A tool: an artefact made for making and not
    for consuming. Use PRESERVES it (indeed use is its very end)
    rather than destroying it: the oven bakes the bread and the
    oven remains, which is what sets a tool apart from food and
    from matter.</glossa>
  <glossa lingua="fr">Un instrument : un artefact fait pour
    produire, non pour être consommé. L'usage le CONSERVE (l'usage
    est même sa fin) au lieu de le détruire : le four cuit le pain
    et le four demeure, ce qui distingue l'instrument de l'aliment
    et de la matière.</glossa>

  <proprietates>
    <proprietas nomen="capacitas" genus="quantitas"
      modulus="mensura"
      nota="quantum simul ferre potest - vinculum quod opus
            totum ordinat (fornax duodecim panes: numerus qui
            horarium pistrinae determinat)"/>
  </proprietates>

  <machina_statuum nomen="usus" gerens="individuum">
    <status nomen="otiosum"/>
    <status nomen="in_usu"/>
    <status nomen="in_reparatione"/>
    <status nomen="fractum"/>
    <transitus a="otiosum" ad="in_usu" per="susceptio"/>
    <transitus a="in_usu" ad="otiosum" per="dimissio"/>
    <transitus a="in_usu" ad="fractum" per="fractio"/>
    <transitus a="fractum" ad="in_reparatione" per="susceptio"/>
    <transitus a="in_reparatione" ad="otiosum" per="refectio"
      nota="REFECTIO, non sanatio: res corporea fracta non
            emendatur ut fons emendatur - vide dubium in
            fabricatione"/>
  </machina_statuum>

</.genus>

<!-- ==================================================
     RES SACRA - res actu segregata a profano usu
     ================================================== -->

<.genus nomen="res_sacra" sub="res_corporea">

  <differentia>
    Divino cultui per ACTUM dedicata, non per naturam nec per
    materiam: idem lignum mensa aut altare esse potest, et
    differentia tota in consecratione stat. Genus ideo
    probatio pura est doctrinae actus sollemnis - status rei
    ab actu, non a materia.
  </differentia>

  <glossa lingua="en">A sacred thing: a bodily thing set apart for
    divine worship by an ACT, not by its nature nor by its matter.
    The same wood can be a table or an altar, and the whole
    difference rests on the consecration. The kind is therefore a
    pure test of the doctrine of the solemn act: the status of the
    thing comes from the act, not from the material.</glossa>
  <glossa lingua="fr">Une chose sacrée : une chose corporelle dédiée
    au culte divin par un ACTE, non par sa nature ni par sa
    matière. Le même bois peut être une table ou un autel, et toute
    la différence tient à la consécration. Ce genre est donc une
    épreuve pure de la doctrine de l'acte solennel : le statut de
    la chose vient de l'acte, non du matériau.</glossa>

  <proprietates>
    <proprietas nomen="alienabilis" genus="veritas"
      ordinarius="falsum"
      nota="res sacrae vendi non possunt more communi:
            alienatio licentiam auctoritatis poscit, et
            quaedam omnino prohibentur. Proprietas quae
            possessionem ipsam RESTRINGIT - possidetur, non
            libere disponitur"/>
  </proprietates>

  <machina_statuum nomen="dedicatio" gerens="individuum">
    <status nomen="profana" nota="ante consecrationem"/>
    <status nomen="sacra"/>
    <status nomen="violata"
      nota="actu gravi profanata, usum suspendens donec
            reparetur - status quem res corporea communis
            habere non potest: LAESIO SINE DAMNO PHYSICO.
            Ecclesia violata integra stat et tamen uti non
            licet"/>
    <status nomen="reducta"
      nota="ad usus profanos actu formali reducta - egressus
            ordinatus, non neglectus"/>
    <transitus a="profana" ad="sacra" per="consecratio"/>
    <transitus a="sacra" ad="violata" per="violatio"/>
    <transitus a="violata" ad="sacra" per="reparatio"/>
    <transitus a="sacra" ad="reducta" per="reductio"/>
  </machina_statuum>

  <relationes>
    <relatio nomen="consecrata_per" ad="actus_sollemnis"
      necessitudo="constituta_per"
      modulus="actus"/>
    <relatio nomen="custoditur_ab" ad="officium"
      modulus="organizatio"
      nota="custodia OFFICII est, non hominis - unde series
            custodum per saecula continua"/>
  </relationes>

  <nota>
    VIOLATIO ET DAMNUM DISTINGUENDA: damnum integritatem
    PHYSICAM laedit (vide infra), violatio STATUM laedit re
    intacta. Idem altare fractum damnum patitur, pollutum
    violationem - et remedia diversa sunt: illud refectionem,
    hoc reparationem ritualem. Trias defectuum (vitium/morbus/
    damnum) ideo quartum membrum non accipit sed CONFINIUM
    ostendit: res quaedam normas plures simul habent.
  </nota>

  <!-- ================= DICTIONARIUM ================= -->

  <.species nomen="res_sacra_immobilis">
    <definitio>
      Ecclesia, altare, coemeterium: loco fixa et ideo
      iurisdictioni loci obnoxia simul ac dedicationi.
    </definitio>
  </.species>

  <.species nomen="res_sacra_mobilis">
    <definitio>
      Vasa sacra, vestes, libri liturgici: quae moveri possunt
      et ideo alienari, unde regulae strictiores.
    </definitio>
  </.species>

  <.species nomen="reliquiae">
    <definitio>
      Corporis sancti partes aut res ei contactae: species
      cuius venditio omnino prohibita est (simonia), non
      restricta - unicum in bibliotheca exemplum rei quae
      possideri potest et VENDI NUMQUAM.
    </definitio>
    <valor nomen="alienabilis">falsum</valor>
  </.species>

</.genus>

<!-- ==================================================
     DAMNUM - laesio integritatis rei corporeae

     TRIAS DEFECTUUM PERFECTA (cursu tertio circuli inventa):
     tria genera "mali" per NORMAM ad quam mensurantur
     distinguuntur, non per rem laesam -
       vitium (fabricatio): discrepantia ab INTENTIONE -
         quod voluimus non fecit;
       morbus (morbus):     defectus a NATURA - quod rei
         debetur non habet;
       damnum (hic):        laesio INTEGRITATIS - quod erat
         integrum fractum est.
     Ideo saxum nec vitiosum nec aegrotum esse potest, damnum
     tamen patitur: integritatem habet etsi nec intentionem nec
     naturam propriam. Trias ordinem servat - quo plus rei
     debetur, eo plura mala pati potest.
     ================================================== -->

<.genus nomen="damnum">

  <definitio>
    Laesio integritatis rei corporeae ab externa vi illata: quod
    unum erat divisum, quod integrum fractum, quod purum
    mixtum. Non defectus intentionis nec naturae sed
    INTEGRITATIS - ideo omnibus corporibus accidere potest,
    etiam iis quae nec finem nec naturam propriam habent.
  </definitio>

  <glossa lingua="en">Damage: an injury to the integrity of a bodily
    thing inflicted by an outside force - what was one is divided,
    what was whole is broken, what was pure is mixed. It is a
    failing not of intention nor of nature but of INTEGRITY, and so
    it can befall any body whatever, even one that has neither an
    end nor a nature of its own.</glossa>
  <glossa lingua="fr">Le dommage : une atteinte à l'intégrité d'une
    chose corporelle infligée par une force extérieure - ce qui
    était un est divisé, ce qui était entier est brisé, ce qui
    était pur est mêlé. Ce n'est un défaut ni de l'intention ni de
    la nature mais de l'INTÉGRITÉ ; aussi peut-il atteindre tout
    corps, même celui qui n'a ni fin ni nature propre.</glossa>

  <proprietates>
    <proprietas nomen="gravitas" genus="electio">
      <optio>levis</optio>
      <optio>gravis</optio>
      <optio>totalis</optio>
    </proprietas>
    <proprietas nomen="reparabile" genus="veritas"
      nota="an refici possit - et REFECTIO, non sanatio: res
            corporea fracta nova fit ex parte, non emendatur
            ut fons emendatur (dubium fabricationis huc
            respicit)"/>
  </proprietates>

  <machina_statuum nomen="integritas" gerens="individuum">
    <status nomen="integrum"/>
    <status nomen="damnatum"/>
    <status nomen="refectum"
      nota="restitutum, non idem: refectio historiam ADDIT,
            non tollit - res refecta rem damnatam fuisse
            semper fuit"/>
    <status nomen="perditum" nota="ultra refectionem"/>
    <transitus a="integrum" ad="damnatum" per="laesio"/>
    <transitus a="damnatum" ad="refectum" per="refectio"/>
    <transitus a="damnatum" ad="perditum" per="perditio"/>
  </machina_statuum>

  <relationes>
    <relatio nomen="affligit" ad="res_corporea"
      necessitudo="afficit"/>
    <relatio nomen="illatum_per" ad="*" necessitudo="causat"
      nota="causa: vis, casus, neglegentia, alius homo - et
            si per hominem, OBLIGATIO oritur ex delicto
            (obligatio.obligatio_ex_delicto): unde damnum et
            ius se tangunt"/>
    <relatio nomen="praevisum_ut" ad="periculum" modulus="iudicium"
      necessitudo="fundatio"
      nota="damnum factum est quod periculum praedixit -
            periculum ante, damnum post; assecuratio inter
            utrumque stat"/>
  </relationes>

  <!-- ================= DICTIONARIUM ================= -->

  <.species nomen="fractura">
    <definitio>Divisio quod unum esse debet.</definitio>
  </.species>

  <.species nomen="corruptio">
    <definitio>
      Mutatio substantiae ipsius: putredo, rubigo, umor. Species
      quam MORA sola efficere potest, sine ulla vi externa -
      confinium cum transitu 'per moram' rei corporeae.
    </definitio>
  </.species>

  <.species nomen="contaminatio">
    <definitio>
      Admixtio alieni: quod purum esse debet mixtum est. Species
      quae MATERIAM praecipue afflicit (numerabilia frangi,
      mensurabilia contaminari solent) - divisio v0
      hic fructum fert.
    </definitio>
  </.species>

</.genus>

<!-- ==================================================
     VIVENS - ramus tertius rei corporeae
     (nec factum nec materia: quod se movet)
     ================================================== -->

<.genus nomen="vivens" sub="res_corporea">

  <differentia>
    Se ipsum movet, nutrit, generat: principium motus INTRA se
    habet, ubi artefactum motum ab alio accipit et materia
    nullum. Non ab homine factum (etiamsi ab homine cultum);
    numerabile et haecceitatem habens, ideo non materia.
  </differentia>

  <glossa lingua="en">A living thing: a bodily thing that moves,
    feeds and generates itself, holding the principle of its motion
    WITHIN, where an artefact receives its motion from another and
    matter has none. It is not made by man (though it may be tended
    by him); being countable and having thisness, it is not
    matter.</glossa>
  <glossa lingua="fr">Un vivant : une chose corporelle qui se meut,
    se nourrit et s'engendre elle-même, tenant EN elle-même le
    principe de son mouvement, là où l'artefact reçoit son
    mouvement d'autrui et où la matière n'en a aucun. Il n'est pas
    fait par l'homme (même s'il est cultivé par lui) ; étant
    dénombrable et doté d'une eccéité, il n'est pas de la
    matière.</glossa>

  <proprietates>
    <proprietas nomen="anima" genus="electio"
      nota="gradus vitae (Aristoteles, De Anima; Thomas
            sequitur): superior inferiores CONTINET - animal
            et vegetatur et sentit, homo et vegetatur et sentit
            et intellegit. Non tres res sed una forma gradu
            perfectior">
      <optio>vegetativa</optio>
      <optio>sensitiva</optio>
      <optio>rationalis</optio>
    </proprietas>
  </proprietates>

  <machina_statuum nomen="vita" gerens="individuum">
    <status nomen="vivum"/>
    <status nomen="mortuum"/>
    <transitus a="vivum" ad="mortuum" per="mors"
      nota="TRANSITUS UNICUS IN BIBLIOTHECA QUI REM ALIAM
            RELINQUIT: mors non statum mutat sed rem ipsam -
            cadaver res corporea manet, vivens esse DESINIT.
            Mutatio substantialis, non accidentalis; ideo
            reditus nullus, et machinae nostrae ceterae huic
            non similes"/>
  </machina_statuum>

  <relationes>
    <relatio nomen="generat" ad="vivens" multiplex="verum"
      necessitudo="parit"
      nota="viventia sola sui similia gignunt - artefacta
            fabricantur, viventia generantur"/>
    <relatio nomen="laborat" ad="morbus" modulus="morbus"
      necessitudo="afficit"
      multiplex="verum"
      nota="MORBUS SOLIS VIVENTIBUS ACCIDIT: aegrotare potest
            quod naturam habet ad quam mensuratur; saxum
            aegrotare non potest quia nihil ei debetur"/>
  </relationes>

  <nota>
    ARBOR PORPHYRIANA IPSA HIC APPARET: substantia -> corpus
    (res_corporea) -> vivens -> animal -> animal rationale
    (homo). Forma nostra ab hac arbore nomen traxit et nunc
    eam, ramum post ramum, RECONSTRUXIT sine consilio - non
    imitatione sed quia res ita se habent. Testimonium quod
    taxinomia inventa est, non ficta.
  </nota>

</.genus>

</natura>
