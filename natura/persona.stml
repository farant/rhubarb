<?xml version="1.0" encoding="UTF-8"?>
<!--
  natura/persona.stml
  Exemplar semanticum: PERSONA (versio 4, PLASTICUM)
  v3->v4: Meyer (bis postulatus: CQS et pactum), Dijkstra
  (superfectus a verbo goto), Scotus (haecceitas ad
  identificatorem) - dictionarium a stratis elementorum et
  communicationis poscentibus crevit.

  Genus trans-dominiale primum: relationes aliorum exemplarium
  (auctor linguae, scriptor normae) hoc genus POPOSCERUNT -
  auctores ut textus mendacium commoditatis erat; Dennis Ritchie
  persona est, non chorda.

  Individua notabilia recordi publici hic vivunt (prosopographia,
  more dictionarii biographici); personae TUAE (contactus, socii)
  in voluminibus applicationum, genus hoc citantes.
-->
<natura modulus="persona" versio="4" lingua="latina">

<genus nomen="persona">

  <definitio>
    Naturae rationabilis individua substantia (Boethius).
    Subiectum actionum liberarum: auctor esse potest, non solum
    causa.
  </definitio>

  <proprietates>
    <proprietas nomen="nomina" genus="textus" multiplex="verum"
      nota="personae nomina plura habent - natale, publicum,
            religiosum; primum = usitatissimum"/>
    <proprietas nomen="natus" genus="dies"/>
    <proprietas nomen="mortuus" genus="dies"
      nota="vacuum = vivens aut ignotum"/>
  </proprietates>

  <actiones>
    <actio nomen="creare" nota="opus novum gignere - fons
      relationum auctoris trans exemplaria"/>
  </actiones>

  <relationes>
    <relatio nomen="auctor_de" ad="*"
      nota="ad opus cuiusvis generis - relatio aperta consulto:
            opera personarum genera omnia transeunt"/>
    <relatio nomen="membrum_de" ad="organizatio"
      modulus="organizatio" multiplex="verum"/>
  </relationes>
  <!-- dubium organizationis SOLUTUM (v0->v1): exemplar
       organizatio natum - universitas personarum, non persona -->


  <!-- ================= DICTIONARIUM ================= -->

  <individuum nomen="dennis_ritchie">
    <valor nomen="nomina">Dennis MacAlistair Ritchie</valor>
    <valor nomen="natus">1941-09-09</valor>
    <valor nomen="mortuus">2011-10-12</valor>
    <historia>
      <eventum quando="1972" actio="creare">lingua C</eventum>
      <eventum quando="1978" actio="creare">liber "The C
        Programming Language" (cum Kernighan)</eventum>
    </historia>
  </individuum>

  <individuum nomen="thomas_aquinas">
    <valor nomen="nomina">Thomas de Aquino</valor>
    <valor nomen="natus">1225</valor>
    <valor nomen="mortuus">1274-03-07</valor>
    <historia>
      <eventum quando="1265" actio="creare">Summa Theologiae
        (inceptum; imperfecta relicta)</eventum>
    </historia>
  </individuum>

  <individuum nomen="carl_linnaeus">
    <valor nomen="nomina">Carl Linnaeus</valor>
    <valor nomen="nomina">Carolus Linnaeus</valor>
    <valor nomen="natus">1707-05-23</valor>
    <valor nomen="mortuus">1778-01-10</valor>
    <historia>
      <eventum quando="1735" actio="creare">Systema Naturae</eventum>
      <eventum quando="1753" actio="creare">Species
        Plantarum</eventum>
    </historia>
    <nota>
      Pater formae huius bibliothecae: taxinomia + dictionarium in
      uno artefacto, lingua latina, manu curata.
    </nota>
  </individuum>

  <individuum nomen="josef_pieper">
    <valor nomen="nomina">Josef Pieper</valor>
    <valor nomen="natus">1904-05-04</valor>
    <valor nomen="mortuus">1997-11-06</valor>
    <historia>
      <eventum quando="1974" actio="creare">Missbrauch der
        Sprache, Missbrauch der Macht</eventum>
    </historia>
    <nota>Auctor disciplinae huius bibliothecae (lingua ad
      realitatem, non ad usum)</nota>
  </individuum>

  <individuum nomen="herman_melville">
    <valor nomen="nomina">Herman Melville</valor>
    <valor nomen="natus">1819-08-01</valor>
    <valor nomen="mortuus">1891-09-28</valor>
    <historia>
      <eventum quando="1851" actio="creare">Moby-Dick</eventum>
    </historia>
  </individuum>

  <individuum nomen="ken_thompson">
    <valor nomen="nomina">Kenneth Lane Thompson</valor>
    <valor nomen="natus">1943-02-04</valor>
    <historia>
      <eventum quando="1969" actio="creare">Unix (cum
        Ritchie)</eventum>
      <eventum quando="1969" actio="creare">lingua B</eventum>
    </historia>
  </individuum>

  <individuum nomen="linus_torvalds">
    <valor nomen="nomina">Linus Benedict Torvalds</valor>
    <valor nomen="natus">1969-12-28</valor>
    <historia>
      <eventum quando="1991" actio="creare">nucleus Linux</eventum>
      <eventum quando="2005" actio="creare">git</eventum>
    </historia>
  </individuum>

  <individuum nomen="guido_van_rossum">
    <valor nomen="nomina">Guido van Rossum</valor>
    <valor nomen="natus">1956-01-31</valor>
    <historia>
      <eventum quando="1991" actio="creare">lingua Python</eventum>
    </historia>
  </individuum>

  <individuum nomen="graydon_hoare">
    <valor nomen="nomina">Graydon Hoare</valor>
    <historia>
      <eventum quando="2006" actio="creare">lingua Rust
        (inceptum privatum; publicum 2010)</eventum>
    </historia>
  </individuum>

  <individuum nomen="brian_fox">
    <valor nomen="nomina">Brian Jhan Fox</valor>
    <valor nomen="natus">1959</valor>
    <historia>
      <eventum quando="1989" actio="creare">bash</eventum>
    </historia>
  </individuum>

  <individuum nomen="edsger_dijkstra">
    <valor nomen="nomina">Edsger Wybe Dijkstra</valor>
    <valor nomen="natus">1930-05-11</valor>
    <valor nomen="mortuus">2002-08-06</valor>
    <historia>
      <eventum quando="1968" actio="creare">epistula "Go To
        Statement Considered Harmful"</eventum>
      <eventum quando="1965" actio="creare">semaphora</eventum>
    </historia>
    <nota>Programmatio structa; clavis una (goto) eum in hoc
      dictionarium vocavit.</nota>
  </individuum>

  <individuum nomen="bertrand_meyer">
    <valor nomen="nomina">Bertrand Meyer</valor>
    <valor nomen="natus">1950-11-21</valor>
    <historia>
      <eventum quando="1985" actio="creare">lingua
        Eiffel</eventum>
      <eventum quando="1988" actio="creare">liber
        "Object-Oriented Software Construction" (pactum ut
        disciplina)</eventum>
    </historia>
    <nota>
      Bis a stratis nostris postulatus uno die: separatio
      quaestionis et imperii (gemini status), deinde
      programmatio per pactum (assertio). Doctor canalium
      declaratorum ante nos.
    </nota>
  </individuum>

  <individuum nomen="luca_pacioli">
    <valor nomen="nomina">Luca Bartolomeo de Pacioli</valor>
    <valor nomen="natus">1447</valor>
    <valor nomen="mortuus">1517-06-19</valor>
    <historia>
      <eventum quando="1494" actio="creare">Summa de arithmetica,
        geometria, proportioni et proportionalita - ratio duplex
        descripta</eventum>
    </historia>
    <nota>
      Frater Franciscanus. Rationem duplicem NON invenit sed
      descripsit (mercatores Venetiarum iam utebantur) - forma
      quam nos "fontem eventuum" vocamus, quinque saeculis ante
      computatra: acta immutabilia, status per plicaturam,
      correctio per actum novum. Pater doctrinae voluminis
      nostri quem numquam novimus.
    </nota>
  </individuum>

  <individuum nomen="duns_scotus">
    <valor nomen="nomina">Ioannes Duns Scotus</valor>
    <valor nomen="natus">1266</valor>
    <valor nomen="mortuus">1308-11-08</valor>
    <historia>
      <eventum quando="1300" actio="creare">Ordinatio
        (inceptum; imperfecta relicta)</eventum>
    </historia>
    <nota>
      Doctor Subtilis. Haecceitas eius genus identificatorem
      divisit: nomen baptismale huius-itatem prensat, sigillum
      contenti eam consulto abicit.
    </nota>
  </individuum>

</genus>

</natura>
