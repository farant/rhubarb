<res titulus="signpost">
  <!-- index viae: palus et tabula cum sagitta. Tabula I lata est et
       coordinatae a medio eius numerantur: ordines texturae dimidio
       (VIII texella) rotati scribuntur ut sagitta integra appareat -->
  <textura titulus="sagitta" latitudo="16"
           colores="#b08a52 #4a321c">
    aaaaaaaaaaaaaaaa
    aabaaaaaaaaaaaaa
    aabbaaaaaaaaaaaa
    bbbbbaaaaabbbbbb
    bbbbbaaaaabbbbbb
    aabbaaaaaaaaaaaa
    aabaaaaaaaaaaaaa
    aaaaaaaaaaaaaaaa
  </textura>
  <capsa titulus="palus" magnitudo="0.14 1.7 0.14" color="#6b4a2b"
         textura="tabulae"/>
  <capsa titulus="tabula" magnitudo="1.0 0.5 0.07" locus="0.2 1.1 0.11"
         textura="sagitta"/>
  <capsa titulus="obex" magnitudo="0.5 1.7 0.5" invisibilis="verum"
         signum="solidum"/>
</res>
