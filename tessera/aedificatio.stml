<!-- tessera/aedificatio.stml - declarationes aedificationis tessera (dialectus
     aedificatio, aedificatio.canon; bin/fabrica per fabrica.stml).
     Plan 1a T4: catena amalgamatis - manifesta amalgamatoris
     (aedilis) -> amalgama tessera.c commissa, provenientia regeneratione.
     CATENA MEMORABILIS (parcum fabricae …AR15, 2026-10-01): ingressus
     probabiliter pleni per clausuras (genus 'manifesta', modus fragmentorum
     plan 1a T6). fontes_tessera manifestum unum per radicem scribit
     (build/fabrica/clausurae/tessera__amalgama); excludenda_tessera clausuram amalgamatoris ipsius
     (amalgamator.c + mechanismus communis, build/fabrica/clausurae/tessera__mechanismus).
     Scriptor cuiusque directorii est actio quae id ipsa legit (inclusio
     nova = plagula clausurae mutata = clavis mutata = rescriptio);
     amalgama_tessera infra in catena solum legit. aedilis per BINARIUM
     (instrumentum, sine arcu: aedilis ex amalgamate struitur - manifestum
     eius cyclum faceret). Clang ambiens manet. -->
<aedificatio>
  <!-- praelatio ordinis ex exitu COMMISSO legitur (generator
       idempotens per constructionem) - ergo exitus et ingressus -->
  <actio titulus="fontes_tessera" genus="generator" memorabilis="verum">
    <mandatum>
      <verbum! (>./tools/amalgama_fontes_generare.sh
      <verbum! (>tessera
    </mandatum>
    <vestigium via="build/aedilis/amalgama_fontes" communis="verum"/>
    <vestigium via="build/aedilis/caput" communis="verum"/>
    <vestigium via="build/fabrica/clausurae/tessera__amalgama"/>
    <ingressus genus="manifesta" via="build/fabrica/clausurae/tessera__amalgama"/>
    <ingressus genus="fasciculus" via="tessera/instrumenta/principalia/fontes_politica.sh"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="radices" via="aedilis.stml"/>
    <ingressus genus="instrumentum" via="bin/aedilis"/>
    <ingressus genus="fasciculus" via="tools/amalgama_fontes_generare.sh"/>
    <ingressus genus="directorium" via="tessera/fontes"/>
    <ingressus genus="fasciculus" via="tessera/instrumenta/principalia/fontes_generata.h"/>
    <exitus via="tessera/instrumenta/principalia/fontes_generata.h" provenientia="regeneratio"/>
  </actio>
  <!-- OBIECTA MECHANISMI (1b T5): tessera/build/*.o per mtime structa,
       a generatore excludendorum CAECE nexa - strategia ignota,
       praecondicio sola (numquam iudicatur) -->
  <actio titulus="obiecta_mechanismi_tessera" genus="generator">
    <mandatum>
      <verbum! (>./tessera/amalgamare.sh
      <verbum! (>-obiecta
    </mandatum>
    <vestigium via="tessera/build" forma="plagulae" suffixa=".o"/>
    <ingressus genus="fasciculus" via="tessera/amalgamare.sh"/>
    <exitus via="tessera/build" provenientia="ignota"/>
  </actio>
  <actio titulus="excludenda_tessera" genus="generator" memorabilis="verum">
    <mandatum>
      <verbum! (>./tools/amalgama_excludenda_generare.sh
      <verbum! (>tessera
    </mandatum>
    <praecondicio actio="obiecta_mechanismi_tessera"/>
    <vestigium via="build/aedilis/excludenda" communis="verum"/>
    <vestigium via="build/fabrica/clausurae/tessera__mechanismus"/>
    <ingressus genus="manifesta" via="build/fabrica/clausurae/tessera__amalgama"/>
    <ingressus genus="manifesta" via="build/fabrica/clausurae/tessera__mechanismus"/>
    <ingressus genus="radices" via="aedilis.stml"/>
    <ingressus genus="instrumentum" via="bin/aedilis"/>
    <ingressus genus="fasciculus" via="tools/amalgama_excludenda_generare.sh"/>
    <ingressus genus="fasciculus" via="tessera/instrumenta/principalia/fontes_generata.h"/>
    <ingressus genus="fasciculus" via="tessera/instrumenta/principalia/fontes_politica.sh"/>
    <ingressus genus="fasciculus" via="tools/mechanismus_fontes.sh"/>
    <!-- tessera/build/mech_*.o per globum nexa: praecondicio
         obiecta_mechanismi_tessera (1b T5; olim ingressus directorii,
         nomina solum tegens) -->
    <exitus via="tessera/instrumenta/principalia/excludenda_generata.h" provenientia="regeneratio"/>
  </actio>
  <actio titulus="amalgama_tessera" genus="generator" memorabilis="verum">
    <mandatum>
      <verbum! (>./tessera/amalgamare.sh
    </mandatum>
    <praecondicio actio="obiecta_mechanismi_tessera"/>
    <vestigium via="tessera/build"/>
    <vestigium via="silva/build" communis="verum"/>
    <vestigium via="build/aedilis/amalgama_fontes" communis="verum"/>
    <vestigium via="build/aedilis/excludenda" communis="verum"/>
    <vestigium via="build/aedilis/caput" communis="verum"/>
    <ingressus genus="fasciculus" via="tessera/instrumenta/principalia/fontes_generata.h"/>
    <ingressus genus="fasciculus" via="tessera/instrumenta/principalia/excludenda_generata.h"/>
    <ingressus genus="manifesta" via="build/fabrica/clausurae/tessera__amalgama"/>
    <ingressus genus="manifesta" via="build/fabrica/clausurae/tessera__mechanismus"/>
    <ingressus genus="radices" via="aedilis.stml"/>
    <ingressus genus="fasciculus" via="tessera/amalgamare.sh"/>
    <ingressus genus="fasciculus" via="tessera/instrumenta/principalia/fontes_politica.sh"/>
    <ingressus genus="fasciculus" via="tools/mechanismus_fontes.sh"/>
    <exitus via="tessera/amalgama/tessera.c" provenientia="regeneratio"/>
  </actio>
  <!-- FRAGMENTA RADIX_FONTES (plan 1a T6): MEMORABILIA - ingressus
       probabiliter pleni: generator manifestum unum per radicem in
       build/fabrica/clausurae/ scribit (aedilis --manifestum), iudex
       eas explicat (genus 'manifesta'); radices = nomina directoriorum
       inclusorum aedilis.stml. Verificatio (build/fabrica.db) cum
       clave ingressuum ET mandati regenerationem supplet. aedilis per
       FONTES suos (manifestum), non per binarium: relinkatum octetis
       differt (LC_UUID), clavis per cursum mutaretur. -->
  <actio titulus="fragmentum_tessera_folium" genus="generator" memorabilis="verum">
    <mandatum>
      <verbum! (>./tools/fontes_generare.sh
      <verbum! (>tessera/folium_fontes_generata.sh
      <verbum! (>tessera/instrumenta/principalia/folium.c
      <verbum! (>tessera/instrumenta/folium/folium_pagina.c
      <verbum! (>tessera/fontes/tessera_cellula.c
      <verbum! (>tessera/fontes/tessera_eventum.c
      <verbum! (>tessera/fontes/tessera_opus.c
      <verbum! (>tessera/fontes/tessera_pons_memoriae.c
      <verbum! (>tessera/fontes/tessera_pons_posix.c
    </mandatum>
    <vestigium via="build/fabrica/clausurae/tessera__folium_fontes_generata"/>
    <ingressus genus="manifesta" via="build/fabrica/clausurae/tessera__folium_fontes_generata"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="radices" via="aedilis.stml"/>
    <ingressus genus="manifestum" via="build/aedilis/aedilis/manifestum.stml"/>
    <ingressus genus="fasciculus" via="tools/fontes_generare.sh"/>
    <exitus via="tessera/folium_fontes_generata.sh" provenientia="regeneratio"/>
  </actio>
  <actio titulus="fragmentum_tessera_spectaculum" genus="generator" memorabilis="verum">
    <mandatum>
      <verbum! (>./tools/fontes_generare.sh
      <verbum! (>tessera/spectaculum_fontes_generata.sh
      <verbum! (>tessera/instrumenta/principalia/spectaculum.c
      <verbum! (>tessera/fontes/tessera_cellula.c
      <verbum! (>tessera/fontes/tessera_eventum.c
      <verbum! (>tessera/fontes/tessera_opus.c
      <verbum! (>tessera/fontes/tessera_pons_memoriae.c
      <verbum! (>tessera/fontes/tessera_pons_posix.c
    </mandatum>
    <vestigium via="build/fabrica/clausurae/tessera__spectaculum_fontes_generata"/>
    <ingressus genus="manifesta" via="build/fabrica/clausurae/tessera__spectaculum_fontes_generata"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="radices" via="aedilis.stml"/>
    <ingressus genus="manifestum" via="build/aedilis/aedilis/manifestum.stml"/>
    <ingressus genus="fasciculus" via="tools/fontes_generare.sh"/>
    <exitus via="tessera/spectaculum_fontes_generata.sh" provenientia="regeneratio"/>
  </actio>
  <actio titulus="fragmentum_tessera_effigies" genus="generator" memorabilis="verum">
    <mandatum>
      <verbum! (>./tools/fontes_generare.sh
      <verbum! (>tessera/effigies_fontes_generata.sh
      <verbum! (>tessera/instrumenta/principalia/effigies.c
      <verbum! (>tessera/instrumenta/effigies/effigies_pictura.c
      <verbum! (>tessera/fontes/tessera_cellula.c
      <verbum! (>tessera/fontes/tessera_eventum.c
      <verbum! (>tessera/fontes/tessera_opus.c
      <verbum! (>tessera/fontes/tessera_pons_memoriae.c
      <verbum! (>tessera/fontes/tessera_pons_posix.c
    </mandatum>
    <vestigium via="build/fabrica/clausurae/tessera__effigies_fontes_generata"/>
    <ingressus genus="manifesta" via="build/fabrica/clausurae/tessera__effigies_fontes_generata"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="radices" via="aedilis.stml"/>
    <ingressus genus="manifestum" via="build/aedilis/aedilis/manifestum.stml"/>
    <ingressus genus="fasciculus" via="tools/fontes_generare.sh"/>
    <exitus via="tessera/effigies_fontes_generata.sh" provenientia="regeneratio"/>
  </actio>
  <actio titulus="fragmentum_tessera_musivum" genus="generator" memorabilis="verum">
    <mandatum>
      <verbum! (>./tools/fontes_generare.sh
      <verbum! (>tessera/musivum_fontes_generata.sh
      <verbum! (>tessera/instrumenta/principalia/musivum.c
      <verbum! (>tessera/instrumenta/musivum/musivum_pictura.c
      <verbum! (>tessera/fontes/tessera_cellula.c
      <verbum! (>tessera/fontes/tessera_eventum.c
      <verbum! (>tessera/fontes/tessera_opus.c
      <verbum! (>tessera/fontes/tessera_pons_memoriae.c
      <verbum! (>tessera/fontes/tessera_pons_posix.c
    </mandatum>
    <vestigium via="build/fabrica/clausurae/tessera__musivum_fontes_generata"/>
    <ingressus genus="manifesta" via="build/fabrica/clausurae/tessera__musivum_fontes_generata"/>
    <ingressus genus="configuratio" via="aedilis.stml"/>
    <ingressus genus="radices" via="aedilis.stml"/>
    <ingressus genus="manifestum" via="build/aedilis/aedilis/manifestum.stml"/>
    <ingressus genus="fasciculus" via="tools/fontes_generare.sh"/>
    <exitus via="tessera/musivum_fontes_generata.sh" provenientia="regeneratio"/>
  </actio>
</aedificatio>
