<!-- md-html.stml - programma md -> html per COMPOSITIONEM (B2, 2026-09-03)

     FORMA DENSA (quid STML voluit XIV): spatium album inter tags TRIVIUM
     est quod vertere lege spatii albi (par. 5.9) REDDIT - ordinatio
     pulchra bracchii intra elementum contenti in html ut spatia manat
     (paragraphus cum spatiis ante nexum). Ergo bracchium quodque in
     linea UNA, nihil inter '</EST>' et contentum, nihil intra elementa
     contenti. Inter bracchia (nodi consumpti) spatium innocuum est.

     Introitus: '#@md-nodus' - dispensator UNUS sui vocans (B1), bracchium
     unum per genus proiectionis md_arbor (involucra = loci registri:
     '&@n.slot;' contentum, '!' octeti foliorum crudorum, PER super silvam
     argumenti cum delegatione ad se, bracchia exemplaria pro praesentia
     locorum derivatorum). Nihil computat: quod html vult et proiectio non
     habet, parsator ut lexema derivatum fert (valor, lingua, alt, novae
     lineae fracturarum - B2.1). Compositio: md_html_reddere (md_html.c)
     hoc programma + proiectionem + caudam in documentum unum ponit.
     Quid STML voluit: md/fontes/md_arbor.worklog.md. -->

<#@md-nodus n="@n">
  <COMMUTATIO de="&@n;">
    <CASUS tag="documentum"><PER de="@n.bloci" voca="#@md-nodus"/></CASUS>

    <!-- capitula: elementum titulo valoris nominari nequit (spica IV) -
         gradus per bracchia exemplaria, sex lineae -->
    <CASUS><EST><EXEMPLAR><capitulum><gradus>1</gradus></capitulum></EXEMPLAR></EST><h1><PER de="@n.inlinea" voca="#@md-nodus"/></h1></CASUS>
    <CASUS><EST><EXEMPLAR><capitulum><gradus>2</gradus></capitulum></EXEMPLAR></EST><h2><PER de="@n.inlinea" voca="#@md-nodus"/></h2></CASUS>
    <CASUS><EST><EXEMPLAR><capitulum><gradus>3</gradus></capitulum></EXEMPLAR></EST><h3><PER de="@n.inlinea" voca="#@md-nodus"/></h3></CASUS>
    <CASUS><EST><EXEMPLAR><capitulum><gradus>4</gradus></capitulum></EXEMPLAR></EST><h4><PER de="@n.inlinea" voca="#@md-nodus"/></h4></CASUS>
    <CASUS><EST><EXEMPLAR><capitulum><gradus>5</gradus></capitulum></EXEMPLAR></EST><h5><PER de="@n.inlinea" voca="#@md-nodus"/></h5></CASUS>
    <CASUS tag="capitulum"><h6><PER de="@n.inlinea" voca="#@md-nodus"/></h6></CASUS>

    <!-- paragraphi: nudus (lista arta, lex demissionis) = inlinea sola -->
    <CASUS><EST><EXEMPLAR><paragraphus><nudus>1</nudus></paragraphus></EXEMPLAR></EST><PER de="@n.inlinea" voca="#@md-nodus"/></CASUS>
    <CASUS tag="paragraphus"><p><PER de="@n.inlinea" voca="#@md-nodus"/></p></CASUS>
    <CASUS tag="citatio"><blockquote><PER de="@n.bloci" voca="#@md-nodus"/></blockquote></CASUS>

    <!-- listae: numerata ab I sine start, aliter start=; punctata -->
    <CASUS><EST><EXEMPLAR><lista><genus>1</genus><initium>1</initium></lista></EXEMPLAR></EST><ol><PER de="@n.elementa" voca="#@md-nodus"/></ol></CASUS>
    <CASUS><EST><EXEMPLAR><lista><genus>1</genus></lista></EXEMPLAR></EST><ol start="&@n.initium;"><PER de="@n.elementa" voca="#@md-nodus"/></ol></CASUS>
    <CASUS tag="lista"><ul><PER de="@n.elementa" voca="#@md-nodus"/></ul></CASUS>

    <!-- elementa: officium (GFM) - input ante bloca -->
    <CASUS><EST><EXEMPLAR><elementum><officium>1</officium></elementum></EXEMPLAR></EST><li><input type="checkbox" disabled/><PER de="@n.bloci" voca="#@md-nodus"/></li></CASUS>
    <CASUS><EST><EXEMPLAR><elementum><officium>2</officium></elementum></EXEMPLAR></EST><li><input type="checkbox" checked disabled/><PER de="@n.bloci" voca="#@md-nodus"/></li></CASUS>
    <CASUS tag="elementum"><li><PER de="@n.bloci" voca="#@md-nodus"/></li></CASUS>

    <!-- saepta: valor derivatus (contentum + novae lineae), lingua si adest -->
    <CASUS><EST><EXEMPLAR><saeptum><lingua/></saeptum></EXEMPLAR></EST><pre><code class="language-&@n.lingua!;">&@n.valor!;</code></pre></CASUS>
    <CASUS tag="saeptum"><pre><code>&@n.valor!;</code></pre></CASUS>
    <CASUS tag="divisio"><hr/></CASUS>

    <!-- tabulae: caput per formam corporis (th) - contextus 'in capite'
         demissus non est; ut= eum in loco fert (quid STML voluit XIV) -->
    <CASUS tag="tabula"><table><thead><PER de="@n.caput" ut="o"><tr><PER de="@o.cellae" ut="c"><COMMUTATIO de="&@c;"><CASUS><EST><EXEMPLAR><cella><ordinatio>1</ordinatio></cella></EXEMPLAR></EST><th align="left"><PER de="@c.inlinea" voca="#@md-nodus"/></th></CASUS><CASUS><EST><EXEMPLAR><cella><ordinatio>2</ordinatio></cella></EXEMPLAR></EST><th align="center"><PER de="@c.inlinea" voca="#@md-nodus"/></th></CASUS><CASUS><EST><EXEMPLAR><cella><ordinatio>3</ordinatio></cella></EXEMPLAR></EST><th align="right"><PER de="@c.inlinea" voca="#@md-nodus"/></th></CASUS><ORDINARIUS><th><PER de="@c.inlinea" voca="#@md-nodus"/></th></ORDINARIUS></COMMUTATIO></PER></tr></PER></thead><tbody><PER de="@n.ordines" voca="#@md-nodus"/></tbody></table></CASUS>
    <CASUS tag="ordo"><tr><PER de="@n.cellae" voca="#@md-nodus"/></tr></CASUS>
    <CASUS><EST><EXEMPLAR><cella><ordinatio>1</ordinatio></cella></EXEMPLAR></EST><td align="left"><PER de="@n.inlinea" voca="#@md-nodus"/></td></CASUS>
    <CASUS><EST><EXEMPLAR><cella><ordinatio>2</ordinatio></cella></EXEMPLAR></EST><td align="center"><PER de="@n.inlinea" voca="#@md-nodus"/></td></CASUS>
    <CASUS><EST><EXEMPLAR><cella><ordinatio>3</ordinatio></cella></EXEMPLAR></EST><td align="right"><PER de="@n.inlinea" voca="#@md-nodus"/></td></CASUS>
    <CASUS tag="cella"><td><PER de="@n.inlinea" voca="#@md-nodus"/></td></CASUS>

    <!-- inlinea -->
    <CASUS tag="inlinea"><PER de="@n.liberi" voca="#@md-nodus"/></CASUS>
    <CASUS><EST><EXEMPLAR><textus><valor/></textus></EXEMPLAR></EST>&@n.valor!;</CASUS>
    <CASUS tag="textus">&@n.crudum!;</CASUS>
    <CASUS tag="emphasis"><em><PER de="@n.liberi" voca="#@md-nodus"/></em></CASUS>
    <CASUS tag="fortis"><strong><PER de="@n.liberi" voca="#@md-nodus"/></strong></CASUS>
    <CASUS tag="deletio"><del><PER de="@n.liberi" voca="#@md-nodus"/></del></CASUS>
    <CASUS><EST><EXEMPLAR><verbatim><valor/></verbatim></EXEMPLAR></EST><code>&@n.valor!;</code></CASUS>
    <CASUS tag="verbatim"><code>&@n.crudum!;</code></CASUS>
    <CASUS><EST><EXEMPLAR><nexus><descriptio/></nexus></EXEMPLAR></EST><a href="&@n.url!;" title="&@n.descriptio!;"><PER de="@n.liberi" voca="#@md-nodus"/></a></CASUS>
    <CASUS tag="nexus"><a href="&@n.url!;"><PER de="@n.liberi" voca="#@md-nodus"/></a></CASUS>
    <CASUS><EST><EXEMPLAR><imago><descriptio/></imago></EXEMPLAR></EST><img src="&@n.url!;" alt="&@n.alt!;" title="&@n.descriptio!;"/></CASUS>
    <CASUS tag="imago"><img src="&@n.url!;" alt="&@n.alt!;"/></CASUS>
    <CASUS tag="fractura-mollis">&@n.valor!;</CASUS>
    <CASUS tag="fractura-dura"><br/>&@n.valor!;</CASUS>

    <!-- html crudum transit ut est (decretum B3.1: '<crudum!>' = splex sine tags) -->
    <CASUS tag="html"><crudum!>&@n.valor!;</crudum></CASUS>
    <CASUS tag="html-inlineum"><crudum!>&@n.crudum!;</crudum></CASUS>

    <!-- praefatio, linea-vacua, definitio-nexus: nihil -->
    <ORDINARIUS/>
  </COMMUTATIO>
</#>
