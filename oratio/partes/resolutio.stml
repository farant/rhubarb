  </consilium>
</regula>

<regula titulus="umbra-obiectum-ablativi">
  <!-- umbra obiecti casu ablativo (4): cum puella, in urbe, ab urbe, de
       silva - substituit 'adpositio-ablativum-regit' (T17) -->
  <EXEMPLAR cursus="fratrum" output="$impletio_4">
    <elementa>
      <vocabulum n="$v"><analyses>
        <* n="$a"><umbrae><umbra n="$u"><relatio>0</relatio><casus>4</casus></umbra></umbrae></>
