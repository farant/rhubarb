    </analyses></vocabulum>
  </EXEMPLAR>
  <consilium>
    <PER congruentia="$lect_interiectio_prima_anglica">
      <praelatio vocabulum="&@v;" analysis="&@a;" regula="interiectio-prima-anglica"/>
    </PER>
  </consilium>
</regula>

<regula titulus="numerale-primum-anglicum">
  <!-- one two three four ten million: determinans/substantivum prima (EWT LXXV); one substantivum (the one) pretium mensuratum -->
  <EXEMPLAR output="$sent_numerale_primum_anglicum">
    <sententia lingua="anglica"/>
  </EXEMPLAR>
  <EXEMPLAR de="$sent_numerale_primum_anglicum" output="$lect_numerale_primum_anglicum">
    <vocabulum n="$v"><analyses>
      <analysis-numeralis n="$a"><lingua>1</lingua></analysis-numeralis>
    </analyses></vocabulum>
  </EXEMPLAR>
  <consilium>
    <PER congruentia="$lect_numerale_primum_anglicum">
      <praelatio vocabulum="&@v;" analysis="&@a;" regula="numerale-primum-anglicum"/>
    </PER>
  </consilium>
</regula>

<regula titulus="lingua-documenti-anglica">
  <!-- T18 (2026-09-07): documentum Anglicum (census sententiae stampat
       lingua="anglica") - lectio Anglica PRIMA cuiusque vocabuli quod
       eam fert. Annotator Latinas ante Anglicas ponit ('in' adpositio
       ablativa ante praepositionem Anglicam), ergo primaria Anglica
       57 % erat (T16). Gradus DUO: sententia Anglica (flotans - una),
       deinde vocabula EIUS omnia (flotans intra ordinem: sententia ut
       radix par unum avidum daret, inventum T17); elementum analysis
       quodlibet (tag *) cum lingua 1 = anglica, prima quae congruit.
       Regula PRIMA ordine (prioritas): lingua documenti ante casus. -->
  <EXEMPLAR output="$anglica">
    <sententia lingua="anglica"/>
  </EXEMPLAR>
  <EXEMPLAR de="$anglica" output="$lectio">
    <vocabulum n="$v"><analyses>
      <* n="$a"><lingua>1</lingua></>
    </analyses></vocabulum>
  </EXEMPLAR>
  <consilium>
    <PER congruentia="$lectio">
      <praelatio vocabulum="&@v;" analysis="&@a;" regula="lingua-documenti-anglica"/>
    </PER>
  </consilium>
</regula>

<regula titulus="umbra-obiectum-accusativi">
  <!-- T19d (2026-09-07, umbra prima - sceletum): UMBRA obiecti (relatio 0)
       casu accusativo (3) in lectione QUALIBET (adpositio nunc: in ad
       per ...; verbum transitivum gradu proximo) a substantivo
       accusativo sequente impletur - exsecutor umbram ligat (impletio-
       vocabulum/-analysis) et utramque lectionem praefert. Condicio
       in ARBORE (umbra), regula per relationem et casum generica;
       casus LITTERIS (captura in umbra ad lectionem primam ligaretur
       nec retro tentaretur - T17). Substituit 'adpositio-accusativum-
       regit' (T17) eadem mensura - comparatio. -->
  <EXEMPLAR cursus="fratrum" output="$impletio_3">
    <elementa>
      <vocabulum n="$v"><analyses>
        <* n="$a"><umbrae><umbra n="$u"><relatio>0</relatio><casus>3</casus></umbra></umbrae></>
      </analyses></vocabulum>
      <vocabulum n="$w"><analyses>
        <analysis-substantivi n="$b"><casus>3</casus></analysis-substantivi>
      </analyses></vocabulum>
    </elementa>
  </EXEMPLAR>
  <consilium>
    <PER congruentia="$impletio_3">
      <impletio vocabulum="&@v;" analysis="&@a;" umbra="&@u;" ad-vocabulum="&@w;" ad-analysis="&@b;" regula="umbra-obiectum-accusativi"/>
    </PER>
  </consilium>
</regula>

<regula titulus="umbra-obiectum-ablativi">
  <!-- umbra obiecti casu ablativo (4): cum puella, in urbe, ab urbe, de
       silva - substituit 'adpositio-ablativum-regit' (T17) -->
  <EXEMPLAR cursus="fratrum" output="$impletio_4">
    <elementa>
      <vocabulum n="$v"><analyses>
        <* n="$a"><umbrae><umbra n="$u"><relatio>0</relatio><casus>4</casus></umbra></umbrae></>
      </analyses></vocabulum>
      <vocabulum n="$w"><analyses>
        <analysis-substantivi n="$b"><casus>4</casus></analysis-substantivi>
      </analyses></vocabulum>
    </elementa>
  </EXEMPLAR>
  <consilium>
    <PER congruentia="$impletio_4">
      <impletio vocabulum="&@v;" analysis="&@a;" umbra="&@u;" ad-vocabulum="&@w;" ad-analysis="&@b;" regula="umbra-obiectum-ablativi"/>
    </PER>
  </consilium>
</regula>

<!-- UMBRAE CAPITIS (T19d beta, 2026-09-07): adiectivum/determinans (lectio
     quaelibet cum umbra relatio 1) caput substantivum exspectat casu
     numero genere concordans - ANTE (praecedente) aut POST (sequente)
     lectionem, saltibus (decisio XXXI). Casus LITTERIS in utroque (ut
     percursus lectiones adiectivi per casus retentet: bona = NOM/ABL/VOC
     S F, NOM/ACC/VOC P N); numerus et genus CAPTI a lectione priore in
     ordine (lex capturae: prima lectio congruens ligat). Regulae XIV
     generatae uno modulo (casus VII x ordo II) - data, non consilium.
     Determinans (hic ille ipse meus ...) eadem regula: LLCT determinantia
     MMXCVI 0 % primaria ante. Post umbras obiecti (praepositio substantivum
     suum prior vindicat: cum puella bona -> puella ablativus, bona
     ablativus per caput). GRADUS II: regulae gradus II proiectionem
     NOVAM post permutationes gradus I vident (substantivum iam
     resolutum: lectio prima n="0" = caput verum), vocabula gradu I
     vindicata clausa - sine gradibus regula nominativi ante ablativam
     'bona' post 'cum puella' nominativam faciebat (lectio NOM
     substantivi in proiectione cruda visibilis). Implens = lectio
     QUAELIBET (<* n="$b">) classis cuiusvis cum casu numero genere -
     exsecutor ordinem recusat cuius implens vocabulum gradu priore
     vindicatum est et lectio non prima (veritas vocabuli vindicati =
     lectio prima); vocabulum non vindicatum lectione quavis implet
     (templum: GEN P crudum primum, NOM per caput 'hoc' invenitur). -->

<regula titulus="umbra-caput-nominativus-sequente" gradus="2">
  <EXEMPLAR cursus="fratrum" output="$caput_nominativus_sequente">
    <elementa>
      <vocabulum n="$v"><analyses>
        <* n="$a"><umbrae><umbra n="$u"><relatio>1</relatio><casus>0</casus><numerus>$num</numerus><genus>$gen</genus></umbra></umbrae></>
      </analyses></vocabulum>
      <vocabulum n="$w"><analyses>
        <* n="$b"><casus>0</casus><numerus>$num</numerus><genus>$gen</genus></>
      </analyses></vocabulum>
    </elementa>
  </EXEMPLAR>
  <consilium>
    <PER congruentia="$caput_nominativus_sequente">
      <impletio vocabulum="&@v;" analysis="&@a;" umbra="&@u;" ad-vocabulum="&@w;" ad-analysis="&@b;" regula="umbra-caput-nominativus-sequente"/>
    </PER>
  </consilium>
</regula>

<regula titulus="umbra-caput-nominativus-praecedente" gradus="2">
  <EXEMPLAR cursus="fratrum" output="$caput_nominativus_praecedente">
    <elementa>
      <vocabulum n="$w"><analyses>
        <* n="$b"><casus>0</casus><numerus>$num</numerus><genus>$gen</genus></>
      </analyses></vocabulum>
      <vocabulum n="$v"><analyses>
        <* n="$a"><umbrae><umbra n="$u"><relatio>1</relatio><casus>0</casus><numerus>$num</numerus><genus>$gen</genus></umbra></umbrae></>
      </analyses></vocabulum>
    </elementa>
  </EXEMPLAR>
  <consilium>
    <PER congruentia="$caput_nominativus_praecedente">
      <impletio vocabulum="&@v;" analysis="&@a;" umbra="&@u;" ad-vocabulum="&@w;" ad-analysis="&@b;" regula="umbra-caput-nominativus-praecedente"/>
    </PER>
  </consilium>
</regula>

