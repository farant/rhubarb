    </PER>
  </consilium>
</regula>

<regula titulus="lingua-documenti-anglica">
  <!-- T18 (2026-09-07): documentum Anglicum (census sententiae stampat
       lingua="anglica") - lectio Anglica PRIMA cuiusque vocabuli quod
       eam fert. Annotator Latinas ante Anglicas ponit ('in' adpositio
       ablativa ante praepositionem Anglicam), ergo primaria Anglica
       57 % erat (T16). Gradus DUO: sententia Anglica (flotans - una),
       deinde vocabula EIUS omnia (flotans intra ordinem: sententia ut
       radix par unum avidum daret, inventum T17); elementum analysis
       quodlibet (tag *) cum lingua 1 = anglica, prima quae congruit.
       Regula PRIMA ordine (prioritas): lingua documenti ante casus. -->
  <EXEMPLAR output="$anglica">
    <sententia lingua="anglica"/>
  </EXEMPLAR>
  <EXEMPLAR de="$anglica" output="$lectio">
    <vocabulum n="$v"><analyses>
      <* n="$a"><lingua>1</lingua></>
    </analyses></vocabulum>
  </EXEMPLAR>
  <consilium>
    <PER congruentia="$lectio">
      <praelatio vocabulum="&@v;" analysis="&@a;" regula="lingua-documenti-anglica"/>
    </PER>
  </consilium>
</regula>

<regula titulus="determinans-primum-latinum">
  <!-- T19i (2026-09-08, ex indice erratorum T19g bis): lemmata quae UD
       DET sine exceptione notat (CERTA solae, nativum 'determinantia':
       ipse omnis meus noster vester ille suus alius iste suprascriptus ...
       DET 100 % thesauris tribus; is/qui/quis/aliquis PRON, unus NUM
       Senecae) - lectio determinantis prima. Ante umbras: caput
       lectionis determinantis ligatur, non adiectivae (paritas
       lectionum duarum impletarum ordine listae: adiectivum vincebat,
       chartae nominativus capitis 61 % vicina, dativus 27 %). -->
  <EXEMPLAR output="$sent_determinans_primum_latinum">
    <sententia lingua="latina"/>
  </EXEMPLAR>
  <EXEMPLAR de="$sent_determinans_primum_latinum" output="$lect_determinans_primum_latinum">
    <vocabulum n="$v"><analyses>
      <analysis-determinantis n="$a"><lingua>0</lingua><nativum><or-derivatum>determinantia</or-derivatum></nativum></analysis-determinantis>
    </analyses></vocabulum>
  </EXEMPLAR>
  <consilium>
    <PER congruentia="$lect_determinans_primum_latinum">
      <praelatio vocabulum="&@v;" analysis="&@a;" regula="determinans-primum-latinum"/>
    </PER>
  </consilium>
</regula>

<regula titulus="umbra-obiectum-accusativi">
  <!-- T19d (2026-09-07, umbra prima - sceletum): UMBRA obiecti (relatio 0)
       casu accusativo (3) in lectione QUALIBET (adpositio nunc: in ad
       per ...; verbum transitivum gradu proximo) a substantivo
       accusativo sequente impletur - exsecutor umbram ligat (impletio-
       vocabulum/-analysis) et utramque lectionem praefert. Condicio
       in ARBORE (umbra), regula per relationem et casum generica;
       casus LITTERIS (captura in umbra ad lectionem primam ligaretur
       nec retro tentaretur - T17). Substituit 'adpositio-accusativum-
       regit' (T17) eadem mensura - comparatio. -->
  <EXEMPLAR cursus="fratrum" output="$impletio_3">
    <elementa>
      <vocabulum n="$v"><analyses>
        <* n="$a"><umbrae><umbra n="$u"><relatio>0</relatio><casus>3</casus></umbra></umbrae></>
      </analyses></vocabulum>
