        <* n="$a"><umbrae><umbra n="$u"><relatio>1</relatio><casus>6</casus><numerus>$num</numerus><genus>$gen</genus></umbra></umbrae></>
      </analyses></vocabulum>
      <vocabulum n="$w"><analyses>
        <* n="$b"><casus>6</casus><numerus>$num</numerus><genus>$gen</genus></>
      </analyses></vocabulum>
    </elementa>
  </EXEMPLAR>
  <consilium>
    <PER congruentia="$caput_vocativus_sequente">
      <impletio vocabulum="&@v;" analysis="&@a;" umbra="&@u;" ad-vocabulum="&@w;" ad-analysis="&@b;" regula="umbra-caput-vocativus-sequente"/>
    </PER>
  </consilium>
</regula>

