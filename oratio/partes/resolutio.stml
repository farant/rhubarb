</regula>

<regula titulus="auxiliare-contractum-anglicum">
  <!-- T19e: lectiones auxiliares CONTRACTIONUM ('s 'm 'll 're 've 'd: regulae Moby, fons vocabularium-en, nativum 'r contractio-...') - titulo 'auxiliaria' carent (lista), have/do ambigua fonte 'regula' sunt: fons I = vocabularium-en eas solas seligit -->
  <EXEMPLAR output="$sent_auxiliare_contractum">
