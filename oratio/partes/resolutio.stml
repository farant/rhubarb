    </PER>
  </consilium>
</regula>

<!-- UMBRAE CAPITIS (T19d beta, 2026-09-07): adiectivum/determinans (lectio
     quaelibet cum umbra relatio 1) caput substantivum exspectat casu
     numero genere concordans - ANTE (praecedente) aut POST (sequente)
     lectionem, saltibus (decisio XXXI). Casus LITTERIS in utroque (ut
     percursus lectiones adiectivi per casus retentet: bona = NOM/ABL/VOC
     S F, NOM/ACC/VOC P N); numerus et genus CAPTI a lectione priore in
     ordine (lex capturae: prima lectio congruens ligat). Regulae XIV
     generatae uno modulo (casus VII x ordo II) - data, non consilium.
     Determinans (hic ille ipse meus ...) eadem regula: LLCT determinantia
     MMXCVI 0 % primaria ante. Post umbras obiecti (praepositio substantivum
     suum prior vindicat: cum puella bona -> puella ablativus, bona
     ablativus per caput). GRADUS II: regulae gradus II proiectionem
     NOVAM post permutationes gradus I vident (substantivum iam
     resolutum: lectio prima n="0" = caput verum), vocabula gradu I
     vindicata clausa - sine gradibus regula nominativi ante ablativam
     'bona' post 'cum puella' nominativam faciebat (lectio NOM
     substantivi in proiectione cruda visibilis). Implens = lectio
     QUAELIBET (<* n="$b">) classis cuiusvis cum casu numero genere -
     exsecutor ordinem recusat cuius implens vocabulum gradu priore
     vindicatum est et lectio non prima (veritas vocabuli vindicati =
     lectio prima); vocabulum non vindicatum lectione quavis implet
     (templum: GEN P crudum primum, NOM per caput 'hoc' invenitur). -->

<regula titulus="umbra-obiectum-incerti-proprii">
  <!-- T19f (2026-09-07): implens casus IGNOTI - nomen proprium regulae capitalis (sine casu) umbram obiecti cuiusvis casus implet (in Lucca); POST regulas exactas (prima vincit ubi lectio casu nota adest); lectio Latina sola (umbrae classis Anglicae relatio 0 quoque) -->
  <EXEMPLAR cursus="fratrum" output="$impl_umbra_obiectum_incerti_proprii">
    <elementa>
      <vocabulum n="$v"><analyses>
        <* n="$a"><lingua>0</lingua><umbrae><umbra n="$u"><relatio>0</relatio></umbra></umbrae></>
      </analyses></vocabulum>
      <vocabulum n="$w"><analyses>
        <analysis-nominis-proprii n="$b"><nativum><or-derivatum>capitalis</or-derivatum></nativum></analysis-nominis-proprii>
      </analyses></vocabulum>
    </elementa>
  </EXEMPLAR>
  <consilium>
    <PER congruentia="$impl_umbra_obiectum_incerti_proprii">
      <impletio vocabulum="&@v;" analysis="&@a;" umbra="&@u;" ad-vocabulum="&@w;" ad-analysis="&@b;" regula="umbra-obiectum-incerti-proprii"/>
    </PER>
  </consilium>
</regula>

<regula titulus="umbra-obiectum-ignoti">
  <!-- T19k (2026-09-08): implens IGNOTUS - vocabulum quod nullus fons novit
       (lectio ignoti sine casu) umbram obiecti cuiusvis casus implet (in
       Wlfrado); post regulas exactas et nomen proprium capitale. Capita
       ignota (adiectivum + vocabulum ignotum vicinum) MENSURATA ET ABLATA:
       53-57 % chartis, 33-56 % Senecae, primarium -0.1 ubique -->
  <EXEMPLAR cursus="fratrum" output="$impl_umbra_obiectum_ignoti">
    <elementa>
      <vocabulum n="$v"><analyses>
        <* n="$a"><lingua>0</lingua><umbrae><umbra n="$u"><relatio>0</relatio></umbra></umbrae></>
      </analyses></vocabulum>
      <vocabulum n="$w"><analyses>
        <analysis-ignoti n="$b"><nativum><or-derivatum>ignotum</or-derivatum></nativum></analysis-ignoti>
      </analyses></vocabulum>
    </elementa>
  </EXEMPLAR>
  <consilium>
    <PER congruentia="$impl_umbra_obiectum_ignoti">
      <impletio vocabulum="&@v;" analysis="&@a;" umbra="&@u;" ad-vocabulum="&@w;" ad-analysis="&@b;" regula="umbra-obiectum-ignoti"/>
    </PER>
  </consilium>
</regula>

<!-- IANUA STRICTA capitum (T19h 2026-09-08): regulae capitis XVI cursu STRICTO
     (caput VICINUM solum) gradu II, deinde eaedem cursu fratrum (saltus) gradu III:
     congruentia vicina cuiusvis casus congruentiam remotam casus prioris vincit
     (mensura T19g bis: capita vicina 82-99 %, remota 33-70 %; strictae solae
     primarium deprimunt - remotae 70 % melius quam nihil pro vocabulis suis). -->

<!-- T27 (2026-09-08): GRADUS STRICTUS UNITUS - regulae XIV litterales
     (casus VII x ordo II, -proximo) in DUAS coactae: casus CAPTUS utrimque
     ($cas, regula V - ut numerus et genus iam erant), EXEMPLAR
     quaesitio="omnes" (exemplaria incrementum XXI b): completio QUAEQUE
     per initium ordo suus - lectio quaeque carrier cum socio quoque
     concordante - et politica parium (T25, grex per carrier: umbra
     capitis index 0 semper) socium PROXIMUM primum eligit. Mensura
     thesauris IX (worklog T27): casus 645/622/637 -> 662/644/665 (Seneca,
     chartae), Perseus +21, Aquinas +3, PROIEL +9, Dante +10; ligatio
     431/364/377 -> 437/368/378 et +5..+8 in scrinio; primaria eadem;
     coactae Senecae +1, chartarum -1 (gradus legis umbrarum crescit:
     ordo lectionis victae socium suum decernit - recusatio eius
     mensurata et peior). GRADUS LAXUS (fratrum) LITTERALIS MANET: unitus
     quaesitione omni ligationem chartarum -17 et casum Aquinatis -19
     deprimebat - concordantia ubivis in sententia socium proximum non
     eligit; ibi lex melior aut templum (§8.5) exspectatur. Quaesitio
     'completa' (completio prima) gradui stricto peior quam 'omnes'
     (chartae ligatio -9/-4). Ordo lectionum = ordo vocabularii: regula
     nominativi prima cum retentatione (T27 a) casum deprimebat, non
     lectio prima per casum. -->
