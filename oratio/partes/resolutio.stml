<regula titulus="subordinans-prima-latina">
  <!-- sicut qualiter quam nisi licet (CERTAE solae, nativum 'subordinantes'):
       adverbium/pronomen prima (LLCT CLII, CIRCSE C). Mensuratum prius
       sine titulo: ubi/unde adverbia relativa (LLCT ADV LXVIII/XXV) et
       quod pronomen (XL/XXX) perdita - lista certarum in partes_la -->
  <EXEMPLAR output="$sent_subordinans_prima_latina">
    <sententia lingua="latina"/>
  </EXEMPLAR>
  <EXEMPLAR de="$sent_subordinans_prima_latina" output="$lect_subordinans_prima_latina">
    <vocabulum n="$v"><analyses>
      <analysis-coniunctionis-subordinantis n="$a"><lingua>0</lingua><nativum><or-derivatum>subordinantes</or-derivatum></nativum></analysis-coniunctionis-subordinantis>
    </analyses></vocabulum>
  </EXEMPLAR>
  <consilium>
    <PER congruentia="$lect_subordinans_prima_latina">
      <praelatio vocabulum="&@v;" analysis="&@a;" regula="subordinans-prima-latina"/>
    </PER>
  </consilium>
</regula>

<regula titulus="subordinans-prima-anglica">
  <!-- if because while whether that (lista subordinantium, nativum
       'subordinantes' sola): coordinans/determinans prima (EWT CCXCIII).
       so/when/where adverbia (lista ambigua) intacta; as/than/like/since
       adpositionem ferunt - regula adpositionis prior vincit -->
  <EXEMPLAR output="$sent_subordinans_prima_anglica">
    <sententia lingua="anglica"/>
