<!-- resolutio.stml - Programma resolutionis ambiguitatis per contextum
     (oratio gradus V, T17, 2026-09-05; spec par. VII, decisiones XXVIII-XXXV)

     Regulae ordine PRIORITATIS: prima quae in vocabulo valet vincit;
     regula appenditur, numquam permutatur sine causa nominata. Regula
     quaeque = bracchium EXEMPLAR super proiectionem sententiae annotatae
     (ordinales n in elementis et analysibus) et consilium: praelatio
     una per vocabulum = analysis quae PRIMA fiat (ordo ceterarum manet;
     nihil deletur). Machina laxa: liberi = subsequentia ordinata cum
     LACUNIS (decisio XXXI: accepta et mensurata), congruentia UNA
     avida per radicem - ergo par unum per sententiam per regulam
     OLIM; T19c (2026-09-07): ianua CURSUS FRATRUM tracta (incrementum
     XX exemplarium) - EXEMPLAR cursus="fratrum" radice <elementa>:
     initium quodque liberorum ordo suus, ergo par QUODQUE per
     sententiam (praepositio quaeque suum substantivum). Captura casus
     in praepositione ad analysin primam ligatur nec retro tentatur (in
     urbem: 'in' ablativum primum fert), ergo regulae casus LITTERIS
     scribuntur, una per casum rectum - GRADU LAXO; gradus STRICTUS
     (T27 b, 2026-09-08) regulis duabus unitis ($cas utrimque, EXEMPLAR
     quaesitio="omnes": completio quaeque ordo, politica parium socium
     proximum eligit) scribitur - vide commentum ante regulam
     umbra-caput-sequente-proximo. Retentatio sub regulis litteralibus
     (quaesitio="completa" defalta, T27 a) casum deprimebat quia ordo
     regularum nominativo primo cum retentatione nocet, non quia lectio
     prima per casum prior esset (sententia retractata).

     Oraculum regulas CUMULATIM applicat (./oratio/oraculum.sh -regulae);
     primarium per thesaurum pinnatum solum crescens.

     UMBRAE (T19d, 2026-09-07; desideratum Frani 01M1YYN00E): lectio
     dependentem exspectatum ut NODUM UMBRAE fert (relatio, condiciones
     e codicibus fontis, impletio vacua); regula generica per relationem
     et casum umbram a fratre implet - ordo <impletio vocabulum= analysis=
     umbra= ad-vocabulum= ad-analysis=/>: exsecutor ligat (post
     permutationes, indicibus remissis) et utramque lectionem praefert.
     Umbra ligata = margo dependentiae; non ligata = inventum.
     LEX UMBRARUM (T19d gamma): post gradus omnes exsecutor lectiones
     vocabuli cuiusque ordinat - umbris impletis primae, sine umbris
     deinde, umbris vacuis ultimae (cum venit: coniunctio ante
     adpositionem vacuam; ante venit: adverbium) - lex in C, numquam
     arithmetica hic. -->

<!-- REGULAE PRIORUM CLASSIUM (T19b, 2026-09-07; data: ./oratio/oraculum.sh
     -discrepantiae, T19a). Lectio classis nominatae PRIMA fiat ubi
     adest, sine contextu - classis cuius lectiones cursus II
     APPENDIT (auxiliare, particula, subordinans, interiectio,
     numerale) aut quam fons post aliam ponit (adpositio Latina: ad/a/
     cum adverbium aut abbreviatio prima, LLCT ad CCCLXXIV). ORDO:
     ANTE regulam linguae, quia prima quae in vocabulo valet vincit et
     regula linguae lectionem Anglicam primam quamque praefert; quaeque
     lingua documenti CUSTODITA (sententia lingua= gradu primo, lingua
     lectionis gradu secundo) ne documentum Latinum lectionem Anglicam
     'is' auxiliaris ferat. Mensura cumulativa per regulam in
     oraculum.sh -regulae; regula quae thesaurum ullum deprimit
     removetur, non retinetur. LEX ORDINIS LIBERORUM: liberi formae
     subsequentia ORDINATA liberorum analysis sunt (lemma, lingua, fons,
     nativum, sensus, accidentia) - lemma ante linguam scribatur, aliter
     forma tacite numquam congruit (supra/a primo mensurata 0). -->

<!-- T19e (2026-09-07): regulae ANGLICAE TESTIMONII ante regulas priorum
     classium omnes (prima vincit: prior adpositionis 'to' adpositionem
     decidebat antequam umbra particulae verbo proximo impleretur -
     particulae LXX -> XV % mensuratum; testimonium ante defaltum). Lectio
     Anglica casu caret: umbrae per CLASSEM (annotator: determinans caput
     substantivum; 'to' particula et have/do auxiliaria - listae ambiguae,
     titulis suis, regulae priorum caecae - obiectum verbum), cursus
     STRICTUS (vicinus solus: 'to the store to buy' - to adpositio, to
     particula). Nomen proprium capitale: vocabulum NON primum sententiae
     cum lectione 'capitalis' (regula T16). -->
<regula titulus="a-determinans-anglicum">
  <!-- EXCEPTIO ante regulas umbrarum et adpositionem: articulus 'a' apud Moby
       etiam praepositio et VERBUM (a DNVP: twice a day; have a car - umbra
       verbi 'have' per lectionem verbi 'a' impleretur, T19e) - EWT DET CDXCII;
       lectio determinantis lemmatis a prima; lex implentis intra gradum
       (vocabulum iam decisum lectione alia non implet) umbram 'have' vacuam
       relinquit -->
  <EXEMPLAR output="$sent_a">
    <sententia lingua="anglica"/>
  </EXEMPLAR>
  <EXEMPLAR de="$sent_a" output="$lect_a">
    <vocabulum n="$v"><analyses>
      <analysis-determinantis n="$a"><lemma><or-derivatum>a</or-derivatum></lemma><lingua>1</lingua></analysis-determinantis>
    </analyses></vocabulum>
  </EXEMPLAR>
  <consilium>
    <PER congruentia="$lect_a">
      <praelatio vocabulum="&@v;" analysis="&@a;" regula="a-determinans-anglicum"/>
    </PER>
  </consilium>
</regula>

<regula titulus="nomen-proprium-capitale-anglicum">
  <!-- EWT dev PROPN MDCCCLXVII aurea, XIX % primae ante (Moby Bush/Debra/Israel substantiva novit); initiale sententiae exclusum (Thanks, Store): elementum quodlibet ANTE -->
  <EXEMPLAR output="$sent_proprium_anglicum">
    <sententia lingua="anglica"/>
  </EXEMPLAR>
  <EXEMPLAR de="$sent_proprium_anglicum" cursus="strictus" output="$lect_proprium_anglicum">
    <elementa>
      <* n="$ante"/>
      <vocabulum n="$v"><analyses>
        <analysis-nominis-proprii n="$a"><nativum><or-derivatum>capitalis</or-derivatum></nativum></analysis-nominis-proprii>
      </analyses></vocabulum>
    </elementa>
  </EXEMPLAR>
  <consilium>
    <PER congruentia="$lect_proprium_anglicum">
      <praelatio vocabulum="&@v;" analysis="&@a;" regula="nomen-proprium-capitale-anglicum"/>
    </PER>
  </consilium>
</regula>

<regula titulus="umbra-obiectum-auxiliaris-anglicum">
  <!-- have been / had been: implens auxiliare verum (titulus 'auxiliaria') ANTE regulam implentis verbi, ne lectio verbi 'been' praeferatur (EWT dev been AUX XXXII) -->
  <EXEMPLAR output="$sent_obiectum_auxiliaris">
    <sententia lingua="anglica"/>
  </EXEMPLAR>
  <EXEMPLAR de="$sent_obiectum_auxiliaris" cursus="strictus" output="$impl_obiectum_auxiliaris">
    <elementa>
      <vocabulum n="$v"><analyses>
        <* n="$a"><lingua>1</lingua><umbrae><umbra n="$u"><relatio>0</relatio><classis>2</classis></umbra></umbrae></>
      </analyses></vocabulum>
      <vocabulum n="$w"><analyses>
        <analysis-auxiliaris n="$b"><lingua>1</lingua><nativum><or-derivatum>auxiliaria</or-derivatum></nativum></analysis-auxiliaris>
      </analyses></vocabulum>
    </elementa>
  </EXEMPLAR>
  <consilium>
    <PER congruentia="$impl_obiectum_auxiliaris">
      <impletio vocabulum="&@v;" analysis="&@a;" umbra="&@u;" ad-vocabulum="&@w;" ad-analysis="&@b;" regula="umbra-obiectum-auxiliaris-anglicum"/>
    </PER>
  </consilium>
</regula>

<regula titulus="umbra-obiectum-verbi-anglicum">
  <!-- carrier: lectio Anglica cum umbra obiecti classis verbum (to particula CXCVI adpositio aurea ante; have/do verbum CLXXXVIII aurea ante); implens: lectio verbi Anglica vocabuli PROXIMI -->
  <EXEMPLAR output="$sent_obiectum_verbi">
    <sententia lingua="anglica"/>
  </EXEMPLAR>
  <EXEMPLAR de="$sent_obiectum_verbi" cursus="strictus" output="$impl_obiectum_verbi">
    <elementa>
      <vocabulum n="$v"><analyses>
        <* n="$a"><lingua>1</lingua><umbrae><umbra n="$u"><relatio>0</relatio><classis>2</classis></umbra></umbrae></>
      </analyses></vocabulum>
      <vocabulum n="$w"><analyses>
        <analysis-verbi n="$b"><lingua>1</lingua></analysis-verbi>
      </analyses></vocabulum>
    </elementa>
  </EXEMPLAR>
  <consilium>
    <PER congruentia="$impl_obiectum_verbi">
      <impletio vocabulum="&@v;" analysis="&@a;" umbra="&@u;" ad-vocabulum="&@w;" ad-analysis="&@b;" regula="umbra-obiectum-verbi-anglicum"/>
    </PER>
  </consilium>
</regula>

<regula titulus="auxiliare-primum-latinum">
  <!-- sum: UD AUX (copula, passivum periphrasticum); CIRCSE CLXVIII / LLCT DX / CDXLII aurea, 0 prima ante -->
