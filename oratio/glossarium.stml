  <vocabulum lemma="coniunctor" lingua="latina" classis="substantivum" nota="coniunctor, -oris m. (qui coniungit): classis rupturae runae pro InCB Linker (virama quae consonantes Indicas coniungit, UAX #29 GB9c); sedes include/runae_tabulae.h">
    <forma textus="coniunctor" casus="nominativus" numerus="singularis" genus="masculinum"/>
    <forma textus="coniunctoris" casus="genitivus" numerus="singularis" genus="masculinum"/>
  </vocabulum>
