  <vocabulum lemma="rancor" lingua="latina" classis="substantivum" nota="rancor, -oris: status plagulae generatae quae a redditione recenti differt (materia_coctor: MateriaRancor, porta rancoris; 2026-09-15)">
    <forma textus="rancor" casus="nominativus" numerus="singularis" genus="masculinum"/>
