  <vocabulum lemma="Vergilius" lingua="latina" classis="nomen-proprium"
    nota="nomen proprium: WORDS nomina propria pauca fert (Troia deest, T8); forma cum V et capitali plicationem utrimque probat">
    <sensus>Publius Vergilius Maro, poeta</sensus>
    <forma textus="Vergilius" casus="nominativus" numerus="singularis" genus="masculinum"/>
    <forma textus="Vergilii" casus="genitivus" numerus="singularis" genus="masculinum"/>
    <forma textus="Vergilio" casus="dativus" numerus="singularis" genus="masculinum"/>
