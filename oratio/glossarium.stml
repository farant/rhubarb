  <vocabulum lemma="quibuscum" lingua="latina" classis="pronomen" nota="pronomen qui cum adhaerente (lemma aureum qui)"><forma textus="quibuscum" casus="ablativus"/></vocabulum>
  <!-- T26 (2026-09-08): ligatio - umbra impleta socio (mensura oraculi) -->
  <vocabulum lemma="ligatio" lingua="latina" classis="substantivum" nota="Latina sera: ligatio, -onis f. - umbra socio impleta (arcus resolutionis, contra capita aurea mensurata)"><forma textus="ligatio" casus="nominativus" numerus="singularis" genus="femininum"/><forma textus="ligationis" casus="genitivus" numerus="singularis" genus="femininum"/><forma textus="ligationem" casus="accusativus" numerus="singularis" genus="femininum"/><forma textus="ligationes" casus="nominativus" numerus="pluralis" genus="femininum"/><forma textus="ligationum" casus="genitivus" numerus="pluralis" genus="femininum"/></vocabulum>
  <!-- crusta P1 (2026-09-16): redirectio - genus arboris crustae (2>file, <<A) -->
  <vocabulum lemma="redirectio" lingua="latina" classis="substantivum" nota="Latina nova: redirectio, -onis f. (re + directio) - conversio fluxus in plagulam aut descriptorem, crustae redirect; genus arboris crustae et locus redirectiones"><forma textus="redirectio" casus="nominativus" numerus="singularis" genus="femininum"/><forma textus="redirectionis" casus="genitivus" numerus="singularis" genus="femininum"/><forma textus="redirectionem" casus="accusativus" numerus="singularis" genus="femininum"/><forma textus="redirectione" casus="ablativus" numerus="singularis" genus="femininum"/><forma textus="redirectiones" casus="nominativus" numerus="pluralis" genus="femininum"/><forma textus="redirectionum" casus="genitivus" numerus="pluralis" genus="femininum"/></vocabulum>
  <!-- T30 d (2026-09-09): tabula raritatum flexionum annotatoris -->
  <vocabulum lemma="raritas" lingua="latina" classis="substantivum" nota="raritas, -atis f. (Cicero, Plinius) - res rara; in annotatore flexio rara cuius lectio post ceteras stirpis ordinatur (tabula RARITATES)"><forma textus="raritas" casus="nominativus" numerus="singularis" genus="femininum"/><forma textus="raritatis" casus="genitivus" numerus="singularis" genus="femininum"/><forma textus="raritatem" casus="accusativus" numerus="singularis" genus="femininum"/><forma textus="raritate" casus="ablativus" numerus="singularis" genus="femininum"/><forma textus="raritates" casus="nominativus" numerus="pluralis" genus="femininum"/><forma textus="raritatum" casus="genitivus" numerus="pluralis" genus="femininum"/></vocabulum>
  <!-- T30 a (2026-09-09): errata notarum oraculi - valor aureus attingibilis (lectio classis eum fert) | absens -->
  <vocabulum lemma="attingibilis" lingua="latina" classis="adiectivum" nota="scholasticorum: attingibilis, -e - qui attingi potest; in oraculo valor aureus quem lectio aliqua classis fert (contra absens: vocabularium aut conventio)"><forma textus="attingibilis" casus="nominativus" numerus="singularis" genus="masculinum"/><forma textus="attingibile" casus="nominativus" numerus="singularis" genus="neutrum"/><forma textus="attingibiles" casus="nominativus" numerus="pluralis" genus="masculinum"/><forma textus="attingibilia" casus="nominativus" numerus="pluralis" genus="neutrum"/></vocabulum>
  <!-- T21 (2026-09-08): enclitica scissa (-que -ne -ve) -->
  <vocabulum lemma="lucanus" lingua="latina" classis="adiectivum" nota="Latina media (chartae LLCT): lucanus, -a, -um - Lucensis, ad Lucam pertinens; formae ae > e (Lucane = Lucanae, Lucanem = Lucanam) - sine his 'Lucane' in Luca + ne scinditur (T21)"><forma textus="lucanus" casus="nominativus" numerus="singularis" genus="masculinum"/><forma textus="lucana" casus="nominativus" numerus="singularis" genus="femininum"/><forma textus="lucanum" casus="accusativus" numerus="singularis" genus="masculinum"/><forma textus="lucani" casus="genitivus" numerus="singularis" genus="masculinum"/><forma textus="lucanae" casus="genitivus" numerus="singularis" genus="femininum"/><forma textus="lucane" casus="genitivus" numerus="singularis" genus="femininum"/><forma textus="lucanam" casus="accusativus" numerus="singularis" genus="femininum"/><forma textus="lucanem" casus="accusativus" numerus="singularis" genus="femininum"/><forma textus="lucano" casus="ablativus" numerus="singularis" genus="masculinum"/><forma textus="lucanis" casus="ablativus" numerus="pluralis" genus="masculinum"/></vocabulum>
  <vocabulum lemma="encliticus" lingua="latina" classis="adiectivum" nota="grammaticorum (Prisciani): encliticus, -a, -um - vocabulum praecedenti adhaerens (-que -ne -ve); encliticum n. = vocabulum ipsum scissum"><forma textus="encliticus" casus="nominativus" numerus="singularis" genus="masculinum"/><forma textus="encliticum" casus="nominativus" numerus="singularis" genus="neutrum"/><forma textus="enclitica" casus="nominativus" numerus="pluralis" genus="neutrum"/><forma textus="enclitici" casus="genitivus" numerus="singularis" genus="neutrum"/></vocabulum>
  <vocabulum lemma="puritas" lingua="latina" classis="substantivum" nota="Latina sera: puritas, -atis f. (mensura oraculi clausularum: verba recte posita)"><forma textus="puritas" casus="nominativus" numerus="singularis" genus="femininum"/><forma textus="puritatis" casus="genitivus" numerus="singularis" genus="femininum"/><forma textus="puritatem" casus="accusativus" numerus="singularis" genus="femininum"/></vocabulum>
  <vocabulum lemma="superlativus" lingua="latina" classis="adiectivum" nota="grammaticorum: gradus superlativus"><forma textus="superlativus"/></vocabulum>
  <vocabulum lemma="infinitivus" lingua="latina" classis="adiectivum" nota="grammaticorum: modus infinitivus"><forma textus="infinitivus"/><forma textus="infinitivum"/></vocabulum>
  <vocabulum lemma="imperativus" lingua="latina" classis="adiectivum" nota="grammaticorum: modus imperativus"><forma textus="imperativus"/></vocabulum>
  <vocabulum lemma="plusquamperfectum" lingua="latina" classis="adiectivum" nota="grammaticorum: tempus plusquamperfectum"><forma textus="plusquamperfectum"/></vocabulum>
  <vocabulum lemma="dualis" lingua="latina" classis="adiectivum" nota="grammaticorum: numerus dualis"><forma textus="dualis"/></vocabulum>
  <vocabulum lemma="numerale" lingua="latina" classis="adiectivum" nota="grammaticorum: nomen numerale (classis UD NUM)"><forma textus="numerale"/></vocabulum>
  <vocabulum lemma="pronomen" lingua="latina" classis="substantivum" nota="grammaticorum: pars orationis (classis UD PRON)"><forma textus="pronomen"/><forma textus="pronominis"/></vocabulum>
  <vocabulum lemma="ordinalis" lingua="latina" classis="adiectivum" nota="grammaticorum (Prisciani): ordinalis, -e - numerus ordinalis; formae plurales pro ordinalibus referentiarum (T33 2026-09-10: oratio_referentiae_ordinales, oratio_analysis_ordinalibus)"><forma textus="ordinalis" casus="nominativus" numerus="singularis" genus="masculinum"/><forma textus="ordinales" casus="nominativus" numerus="pluralis" genus="masculinum"/><forma textus="ordinalibus" casus="ablativus" numerus="pluralis" genus="masculinum"/></vocabulum>
  <!-- fasciculum (2026-09-11): bibliotheca fasciculorum .app - Info.plist ut valor, et bit +x quem filum_copiare non servat -->
  <vocabulum lemma="plista" lingua="latina" classis="substantivum" nota="vox domus: plista, -ae f. - tabula proprietatum (forma Apple 'plist', entrium proprium supra) ut VALOR, nomen formae in primam declinationem tracta ut ranga ex Anglico range; sedes plista_extra, FASCICULUM_ERROR_PLISTA"><forma textus="plista" casus="nominativus" numerus="singularis" genus="femininum"/><forma textus="plistae" casus="genitivus" numerus="singularis" genus="femininum"/><forma textus="plistam" casus="accusativus" numerus="singularis" genus="femininum"/><forma textus="plistas" casus="accusativus" numerus="pluralis" genus="femininum"/><forma textus="plistarum" casus="genitivus" numerus="pluralis" genus="femininum"/><forma textus="plistis" casus="ablativus" numerus="pluralis" genus="femininum"/></vocabulum>
  <vocabulum lemma="exsecutabilis" lingua="latina" classis="adiectivum" nota="Latina sera (ex exsequi, exsecutus, + -bilis ut attingibilis): exsecutabilis, -e - qui exsequi potest; de plagula cui bit +x inest (exsecutabile_fiat, FASCICULUM_ERROR_EXSECUTABILE, titulus_exsecutabilis). NOTA: filum eandem notionem in commentariis 'exsequibile' vocat (potest_exsequi) - duae voces unius rei, consulto notatae"><forma textus="exsecutabilis" casus="nominativus" numerus="singularis" genus="masculinum"/><forma textus="exsecutabile" casus="nominativus" numerus="singularis" genus="neutrum"/><forma textus="exsecutabilem" casus="accusativus" numerus="singularis" genus="masculinum"/><forma textus="exsecutabiles" casus="nominativus" numerus="pluralis" genus="masculinum"/><forma textus="exsecutabilia" casus="nominativus" numerus="pluralis" genus="neutrum"/></vocabulum>
  <vocabulum lemma="contents" lingua="anglica" classis="ignotum-permissum" contextus="latinus" nota="nomen directorii in forma fasciculi Apple (Foo.app/Contents/) - nomen alienum FIXUM quod Latine reddi non debet, ut plist; sedes via_contents in probatione fasciculi"/>
  <vocabulum lemma="macos" lingua="anglica" classis="ignotum-permissum" contextus="latinus" nota="nomen directorii exsecutabilium in forma fasciculi Apple (Contents/MacOS/) - nomen systematis, ergo intactum; sedes via_macos"/>
  <!-- icones (2026-09-12): numerale quod latina.h carebat -->
  <vocabulum lemma="mxxiv" lingua="latina" classis="numerale" nota="numerale Romanum MXXIV = 1024, macrum in latina.h additum pro latere maximo iconum (icon_512x512@2x); tabula numeralium DXII et MMMMXCVI ferebat, MXXIV non. Fratres eius (cclvi dxii lxiv cxxviii mmmmxcvi mmxxiv) in copia tolerata vivunt, quae SOLUM minui debet - ergo hic entrium ponitur ne pinna manu augeatur"><forma textus="mxxiv"/></vocabulum>
  <!-- icones (2026-09-12): nomina formarum et societatis Apple, non voces Latinae -->
  <vocabulum lemma="icns" lingua="anglica" classis="ignotum-permissum" contextus="latinus" nota="nomen formae Apple (continens iconum, magicum 'icns'), ut plist et json: nomen alienum FIXUM quod Latine reddi non debet; sedes icones_icns_codificare, icones_icns_scribere"/>
  <vocabulum lemma="iconset" lingua="anglica" classis="ignotum-permissum" contextus="latinus" nota="nomen directorii Apple (.iconset, plagulae PNG quas iconutil in .icns vertit); sedes icones_iconset_scribere"/>
  <vocabulum lemma="apple" lingua="anglica" classis="ignotum-permissum" contextus="latinus" nota="nomen societatis; in ICONES_SETUM_APPLE setum magnitudinum quod Apple ipsa definit (spec icones par. IV, per iconutil mensuratum)"/>
  <vocabulum lemma="sips" lingua="anglica" classis="ignotum-permissum" contextus="latinus" nota="nomen instrumenti Apple (/usr/bin/sips, imagines scalat et convertit); in probatio_icones.c imago XVI px quam sips ex fonte fixo reddidit - oraculum CONGELATUM portae I7 (probationes/fixa/icones/generare.py)"/>
  <!-- icones (2026-09-12): onus ARGB pro ic04/ic05 -->
  <vocabulum lemma="argb" lingua="anglica" classis="ignotum-permissum" contextus="latinus" nota="nomen formae oneris Apple in ic04/ic05 (signum 'ARGB', plana A R G B per RLE, colore praemultiplicato), ut png et icns: nomen alienum FIXUM; sedes CODICES_ARGB, _argb_codificare, _argb_decodificare"/>
  <vocabulum lemma="rle" lingua="anglica" classis="ignotum-permissum" contextus="latinus" nota="abbreviatio 'run-length encoding' (compressio per cursus eiusdem valoris), ut png: sedes _rle_planum in lib/icones.c"/>
  <vocabulum lemma="esc" lingua="anglica" classis="ignotum-permissum" contextus="latinus" nota="ECMA-48: ESC (0x1B, escape) - nomen protocolli; sedes SERIES_ESC in include/series_terminalis.h"/>
  <vocabulum lemma="osc" lingua="anglica" classis="ignotum-permissum" contextus="latinus" nota="ECMA-48: OSC (Operating System Command, ESC ]) - nomen protocolli; sedes SERIES_OSC in include/series_terminalis.h"/>
  <vocabulum lemma="dcs" lingua="anglica" classis="ignotum-permissum" contextus="latinus" nota="ECMA-48: DCS (Device Control String, ESC P) - nomen protocolli; sedes SERIES_DCS in include/series_terminalis.h"/>
  <vocabulum lemma="apc" lingua="anglica" classis="ignotum-permissum" contextus="latinus" nota="ECMA-48: APC (Application Program Command, ESC _) - nomen protocolli (kitty graphics); sedes SERIES_APC in include/series_terminalis.h"/>
  <vocabulum lemma="sgr" lingua="anglica" classis="ignotum-permissum" contextus="latinus" nota="ECMA-48: SGR (Select Graphic Rendition, CSI ... m) - nomen protocolli; mus SGR (?1006, CSI &lt; ... M/m); sedes RELIQUIAE_SGR in tessera/fontes/tessera_eventum.c"/>
  <vocabulum lemma="kitty" lingua="anglica" classis="ignotum-permissum" contextus="latinus" nota="nomen terminalis et protocolli eius claviaturae (CSI ... u: claves sine iactura, solutiones, clavis basis); sedes claves_codex_ex_kitty (include/claves_physicae.h), INTERPRES_KITTY_* (include/interpres_terminalis.h)"/>
  <vocabulum lemma="urxvt" lingua="anglica" classis="ignotum-permissum" contextus="latinus" nota="nomen terminalis (rxvt-unicode) et formae relationis muris eius (?1015, CSI b ; x ; y M) - nomen protocolli; sedes AEMULATOR_MUS_FORMA_URXVT (include/aemulator.h), MODUS_FORMA_URXVT (lib/aemulator.c)"/>
  <vocabulum lemma="praemultiplicatus" lingua="latina" classis="adiectivum" nota="color per alpha iam multiplicatus (R x A / 255): forma quam iconutil in planis ARGB exspectat et per alpha dividit (mensuratum 2026-09-12); vox technica ex prae + multiplicare"><forma textus="praemultiplicata"/></vocabulum>

