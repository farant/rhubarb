  <vocabulum lemma="sublinea" lingua="latina" classis="substantivum" nota="vox domus (sub + linea): linea sub textu (underline, SGR 4); genera simplex, duplex, undulata, punctata, lineolata; sedes include/stilus_terminalis.h (StilusSublinea), modulus 004">
    <forma textus="sublinea" casus="nominativus" numerus="singularis" genus="femininum"/>
