  <vocabulum lemma="microsecunda" lingua="latina" classis="substantivum" nota="vox technica (micro + secunda, pars 10^-6 secundi), soror nanosecundae: mora dormiendi; sedes fenestra_dormire(i32 microsecundae) in include/fenestra_tempus.h">
    <forma textus="microsecunda" casus="nominativus" numerus="singularis" genus="femininum"/>
