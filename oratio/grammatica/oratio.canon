<!--
  oratio.canon
  MANU SCRIPTUM (ut md.canon, decretum Frani 2026-09-01).

  Registrum oratio_registrum.c et lexicon oratio_lexicon.c manu scripta
  sunt, ergo canon quoque. Custos derivae (probatio_oratio_canon)
  regulas huius plagulae contra registrum generum, loci, lexicon et
  involucrum UTRIMQUE retiret; sigillum registri infra PINNATUM contra
  vivum conferitur.

  MODELLUM (oratio-spec par. III as-built): trivia NULLA - spatia et
  lineae novae CONTENTUM in caudis/praefixis; involucra <ante>/<post>
  hic NON declarantur. Locus TOKEN derivatus (classes, linguae) f="1"
  + linea/columna fert, b numquam. 'crlf' in or-linea, 'cr' in generibus
  VERBATIM. Locus analyses (gradus III) genera analysis-* XVII fert
  (T11, 2026-09-04): unum per classem universalem, loci communes V et
  accidentia INDEX - vide sectionem GRADUS III infra.

  INVOLUCRUM: <arbor> (documentum subarboris). Iudicium:
    bin/canon_examen -canon oratio/grammatica/oratio.canon <doc.stml>
-->
<canon dialectus="oratio" versio="1">

  <!-- =============== FRAGMENTA =============== -->

  <!-- spatia: caudae et praefixa (LISTA_TOKEN) -->
  <#spatia>
    <liberum nomen="or-spatium"/>
    <liberum nomen="or-linea"/>
    <liberum nomen="or-linea-cr"/>
    <liberum nomen="or-signum"/>
  </#>

  <!-- partes vocabuli -->
  <#partes>
    <liberum nomen="or-litterae"/>
    <liberum nomen="or-digiti"/>
    <liberum nomen="or-hyphen"/>
    <liberum nomen="or-apostrophus"/>
    <liberum nomen="or-punctum"/>
  </#>

  <!-- elementa sententiae -->
  <#elementa>
    <liberum nomen="vocabulum"/>
    <liberum nomen="interpunctio"/>
    <liberum nomen="numerus"/>
  </#>

  <!-- =============== INVOLUCRUM =============== -->

  <elementum nomen="arbor" radix="verum"
    nota="documentum subarboris: liberum unum, genus quodlibet">
    <attributum nomen="grammatica" genus="electio"
      necessarium="verum">
      <optio>oratio</optio>
    </attributum>
    <attributum nomen="registrum-sigillum" genus="electio"
      necessarium="verum"
      nota="PINNA: sigillum tabularum oratio_registrum.c (T11: XXIII genera,
            CXLVI loci - genera analysis-* XVII appensa; T6b erat 93c1c9cf,
            VI genera XVII loci; T1 b27fe13a, XVI loci). Tabula mutata sine
            hac optione mutata rubet in iudicio ET in custode derivae.">
      <optio>87b35173</optio>
    </attributum>
    <attributum nomen="fons"    genus="numerus"/>
    <attributum nomen="b"       genus="numerus"/>
    <attributum nomen="linea"   genus="numerus"/>
    <attributum nomen="columna" genus="numerus"/>
    <liberum nomen="documentum"   maximum="1"/>
    <liberum nomen="paragraphus"  maximum="1"/>
    <liberum nomen="sententia"    maximum="1"/>
    <liberum nomen="vocabulum"    maximum="1"/>
    <liberum nomen="interpunctio" maximum="1"/>
    <liberum nomen="numerus"      maximum="1"/>
    <liberum nomen="analysis-substantivi" maximum="1"/>
    <liberum nomen="analysis-nominis-proprii" maximum="1"/>
    <liberum nomen="analysis-verbi" maximum="1"/>
    <liberum nomen="analysis-auxiliaris" maximum="1"/>
    <liberum nomen="analysis-adiectivi" maximum="1"/>
    <liberum nomen="analysis-adverbii" maximum="1"/>
    <liberum nomen="analysis-pronominis" maximum="1"/>
    <liberum nomen="analysis-determinantis" maximum="1"/>
    <liberum nomen="analysis-adpositionis" maximum="1"/>
    <liberum nomen="analysis-numeralis" maximum="1"/>
    <liberum nomen="analysis-coniunctionis-coordinantis" maximum="1"/>
    <liberum nomen="analysis-coniunctionis-subordinantis" maximum="1"/>
    <liberum nomen="analysis-particulae" maximum="1"/>
    <liberum nomen="analysis-interiectionis" maximum="1"/>
    <liberum nomen="analysis-symboli" maximum="1"/>
    <liberum nomen="analysis-interpunctionis" maximum="1"/>
    <liberum nomen="analysis-ignoti" maximum="1"/>
  </elementum>

  <!-- =============== PLANUM RESOLUTIONIS (gradus V, T17) ===============
       Programma oratio/partes/resolutio.stml = regulae: bracchia
       exemplarium (CAPS machinae, canoni invisibilia) quae in documento
       expanso (proiectio sententiae + programma) consilium pariunt -
       praelatio una per vocabulum praeferendum (ordinales n). Planum
       ANTE executionem iudicatur (lex plani controlantis, stml-visio 9.2);
       exsecutor C ordines ambulat, prima regula vincit. -->

  <elementum nomen="regula"
    nota="regula resolutionis (radix ALTERA documenti expansi post arbor - canon radicem unam solam declarat): titulus = nomen regulae (causa in plano et in censu); liberi = bracchia CAPS machinae + consilium">
    <attributum nomen="titulus" genus="textus" necessarium="verum"/>
    <liberum nomen="consilium" maximum="1"/>
  </elementum>
  <elementum nomen="consilium" intra="regula"
    nota="planum regulae: praelationes ex PER instantiatae">
    <liberum nomen="praelatio"/>
  </elementum>
  <elementum nomen="praelatio" intra="consilium"
    nota="ordo plani: vocabulum (n intra elementa sententiae) cuius analysis (n intra analyses) prima fiat; sententia optionalis; regula = titulus">
    <attributum nomen="vocabulum" genus="numerus" necessarium="verum"/>
    <attributum nomen="analysis"  genus="numerus" necessarium="verum"/>
    <attributum nomen="sententia" genus="numerus"/>
    <attributum nomen="regula"    genus="textus"/>
  </elementum>

  <!-- =============== GENERA ET LOCI ===============
       Ordo registri (oratio_registrum.c). Locus quisque SEMEL aut
       nusquam: lista absens = vacua (non scribitur).
       -->

  <elementum nomen="documentum">
    <attributum nomen="lingua" genus="electio">
      <optio>latina</optio>
      <optio>anglica</optio>
    </attributum>
    <liberum nomen="praefixa"   maximum="1"/>
    <liberum nomen="paragraphi" maximum="1"/>
    <liberum nomen="finis"      maximum="1"/>
  </elementum>
  <elementum nomen="praefixa" intra="documentum"
    nota="spatium ante paragraphum primum (totum)">
    <<#spatia>>
  </elementum>
  <elementum nomen="paragraphi" intra="documentum">
    <liberum nomen="paragraphus"/>
  </elementum>
  <elementum nomen="finis" intra="documentum">
    <liberum nomen="or-finis" maximum="1"/>
  </elementum>

  <elementum nomen="paragraphus">
    <liberum nomen="praefixa"   maximum="1"/>
    <liberum nomen="sententiae" maximum="1"/>
    <liberum nomen="cauda"      maximum="1"/>
    <liberum nomen="forma"      maximum="1"/>
  </elementum>
  <elementum nomen="praefixa" intra="paragraphus"
    nota="indentatio (spatia post lineam ultimam caudae praecedentis)">
    <<#spatia>>
  </elementum>
  <elementum nomen="sententiae" intra="paragraphus">
    <liberum nomen="sententia"/>
  </elementum>
  <elementum nomen="cauda" intra="paragraphus"
    nota="lineae vacuae post elementum ultimum, usque ad lineam ultimam">
    <<#spatia>>
  </elementum>
  <elementum nomen="forma" intra="paragraphus" textus="verum"
    nota="T6b: OratioForma ut numerus (0 prosa, 1 versus, 2 titulus, 3 tabula, 4 index) - classificator ante lectorem, lex deprimendi"/>

  <elementum nomen="sententia"
    nota="attributa n (ordinalis intra paragraphum) et lingua (census documenti) = ornatus T17, lector ea ignorat">
    <attributum nomen="n" genus="numerus"/>
    <attributum nomen="lingua" genus="electio">
      <optio>latina</optio>
      <optio>anglica</optio>
    </attributum>
    <liberum nomen="elementa" maximum="1"/>
  </elementum>
  <elementum nomen="elementa" intra="sententia">
    <<#elementa>>
  </elementum>

  <elementum nomen="vocabulum"
    nota="verbum superficiei cum partibus; analyses/classes/linguae gradus III; attributa classes/linguae = compendia DERIVATA per uncum nodi (T12) ut selectio '[classes~=verbum]' congruat - lector ea ignorat, loci veritas sunt">
    <attributum nomen="classes" genus="textus"/>
    <attributum nomen="linguae" genus="textus"/>
    <attributum nomen="n"       genus="numerus"/>
    <liberum nomen="partes"   maximum="1"/>
    <liberum nomen="cauda"    maximum="1"/>
    <liberum nomen="analyses" maximum="1"/>
    <liberum nomen="classes"  maximum="1"/>
    <liberum nomen="linguae"  maximum="1"/>
  </elementum>
  <elementum nomen="partes" intra="vocabulum">
    <<#partes>>
  </elementum>
  <elementum nomen="cauda" intra="vocabulum">
    <<#spatia>>
  </elementum>
  <elementum nomen="analyses" intra="vocabulum"
    nota="gradus III (T11): analyses ordine fontis, prima = primaria; genus = classis">
    <liberum nomen="analysis-substantivi"/>
    <liberum nomen="analysis-nominis-proprii"/>
    <liberum nomen="analysis-verbi"/>
    <liberum nomen="analysis-auxiliaris"/>
    <liberum nomen="analysis-adiectivi"/>
    <liberum nomen="analysis-adverbii"/>
    <liberum nomen="analysis-pronominis"/>
    <liberum nomen="analysis-determinantis"/>
    <liberum nomen="analysis-adpositionis"/>
    <liberum nomen="analysis-numeralis"/>
    <liberum nomen="analysis-coniunctionis-coordinantis"/>
    <liberum nomen="analysis-coniunctionis-subordinantis"/>
    <liberum nomen="analysis-particulae"/>
    <liberum nomen="analysis-interiectionis"/>
    <liberum nomen="analysis-symboli"/>
    <liberum nomen="analysis-interpunctionis"/>
    <liberum nomen="analysis-ignoti"/>
  </elementum>
  <elementum nomen="classes" intra="vocabulum"
    nota="derivatum: classes universales ordine">
    <liberum nomen="or-derivatum" maximum="1"/>
  </elementum>
  <elementum nomen="linguae" intra="vocabulum"
    nota="derivatum: linguae ordine">
    <liberum nomen="or-derivatum" maximum="1"/>
  </elementum>

  <elementum nomen="interpunctio">
    <attributum nomen="n" genus="numerus"/>
    <liberum nomen="signum" maximum="1"/>
    <liberum nomen="cauda"  maximum="1"/>
  </elementum>
  <elementum nomen="signum" intra="interpunctio"
    nota="hyphen/apostrophus solivagi: post suffixum litterarum numeri
          (1980s-era) iunctura vocabulum non invenit et interpunctio fit">
    <liberum nomen="or-punctum"      maximum="1"/>
    <liberum nomen="or-interpunctio" maximum="1"/>
    <liberum nomen="or-hyphen"       maximum="1"/>
    <liberum nomen="or-apostrophus"  maximum="1"/>
  </elementum>
  <elementum nomen="cauda" intra="interpunctio">
    <<#spatia>>
  </elementum>

  <elementum nomen="numerus">
    <attributum nomen="n" genus="numerus"/>
    <liberum nomen="crudum" maximum="1"/>
    <liberum nomen="cauda"  maximum="1"/>
  </elementum>
  <elementum nomen="crudum" intra="numerus"
    nota="digiti, separatores (punctum, comma), suffixum litterarum">
    <liberum nomen="or-digiti"/>
    <liberum nomen="or-punctum"/>
    <liberum nomen="or-interpunctio"/>
    <liberum nomen="or-litterae"/>
  </elementum>
  <elementum nomen="cauda" intra="numerus">
    <<#spatia>>
  </elementum>


  <!-- =============== GRADUS III (T11): ANALYSES ===============
       Unum genus per classem universalem (UD XVII, ordine registri).
       Loci COMMUNES V (lemma, lingua, fons, nativum, sensus) deinde
       accidentia classis ut INDEX (numerus in proiectione; ordo
       enumerationum oratio_registrum.h, appendendarum numquam
       permutandarum). Regulae locorum intra= genus suum (custos
       derivae unam quamque poscit); textus generatus 2026-09-04 ex
       tabula, manu servatus.
       -->

  <elementum nomen="analysis-substantivi"
    nota="classis substantivum">
    <attributum nomen="n" genus="numerus"/>
    <liberum nomen="lemma" maximum="1"/>
    <liberum nomen="lingua" maximum="1"/>
    <liberum nomen="fons" maximum="1"/>
    <liberum nomen="nativum" maximum="1"/>
    <liberum nomen="sensus" maximum="1"/>
    <liberum nomen="casus" maximum="1"/>
    <liberum nomen="numerus" maximum="1"/>
    <liberum nomen="genus" maximum="1"/>
    <liberum nomen="declinatio" maximum="1"/>
  </elementum>
  <elementum nomen="lemma" intra="analysis-substantivi" nota="derivatum: lemma fontis">
    <liberum nomen="or-derivatum" maximum="1"/>
  </elementum>
  <elementum nomen="lingua" intra="analysis-substantivi" textus="verum"
    nota="OratioLingua: 0 latina 1 anglica"/>
  <elementum nomen="fons" intra="analysis-substantivi" textus="verum"
    nota="OratioFonsAnalysis: 0 vocabularium-la 1 vocabularium-en 2 glossarium 3 regula"/>
  <elementum nomen="nativum" intra="analysis-substantivi" nota="derivatum: codex fontis verbatim (lexema unum)">
    <liberum nomen="or-derivatum" maximum="1"/>
  </elementum>
  <elementum nomen="sensus" intra="analysis-substantivi" nota="derivatum: sensus fontis (optionale)">
    <liberum nomen="or-derivatum" maximum="1"/>
  </elementum>
  <elementum nomen="casus" intra="analysis-substantivi" textus="verum"
    nota="OratioCasus: 0 nominativus 1 genitivus 2 dativus 3 accusativus 4 ablativus 5 locativus 6 vocativus"/>
  <elementum nomen="numerus" intra="analysis-substantivi" textus="verum"
    nota="OratioNumerusGrammaticus: 0 singularis 1 pluralis 2 dualis"/>
  <elementum nomen="genus" intra="analysis-substantivi" textus="verum"
    nota="OratioGenusGrammaticum: 0 masculinum 1 femininum 2 neutrum 3 commune"/>
  <elementum nomen="declinatio" intra="analysis-substantivi" textus="verum"
    nota="declinatio I-V (WORDS), 0 = nulla"/>

  <elementum nomen="analysis-nominis-proprii"
    nota="classis nomen-proprium">
    <attributum nomen="n" genus="numerus"/>
    <liberum nomen="lemma" maximum="1"/>
    <liberum nomen="lingua" maximum="1"/>
    <liberum nomen="fons" maximum="1"/>
    <liberum nomen="nativum" maximum="1"/>
    <liberum nomen="sensus" maximum="1"/>
    <liberum nomen="casus" maximum="1"/>
    <liberum nomen="numerus" maximum="1"/>
    <liberum nomen="genus" maximum="1"/>
    <liberum nomen="declinatio" maximum="1"/>
  </elementum>
  <elementum nomen="lemma" intra="analysis-nominis-proprii" nota="derivatum: lemma fontis">
    <liberum nomen="or-derivatum" maximum="1"/>
  </elementum>
  <elementum nomen="lingua" intra="analysis-nominis-proprii" textus="verum"
    nota="OratioLingua: 0 latina 1 anglica"/>
  <elementum nomen="fons" intra="analysis-nominis-proprii" textus="verum"
    nota="OratioFonsAnalysis: 0 vocabularium-la 1 vocabularium-en 2 glossarium 3 regula"/>
  <elementum nomen="nativum" intra="analysis-nominis-proprii" nota="derivatum: codex fontis verbatim (lexema unum)">
    <liberum nomen="or-derivatum" maximum="1"/>
  </elementum>
  <elementum nomen="sensus" intra="analysis-nominis-proprii" nota="derivatum: sensus fontis (optionale)">
    <liberum nomen="or-derivatum" maximum="1"/>
  </elementum>
  <elementum nomen="casus" intra="analysis-nominis-proprii" textus="verum"
    nota="OratioCasus: 0 nominativus 1 genitivus 2 dativus 3 accusativus 4 ablativus 5 locativus 6 vocativus"/>
  <elementum nomen="numerus" intra="analysis-nominis-proprii" textus="verum"
    nota="OratioNumerusGrammaticus: 0 singularis 1 pluralis 2 dualis"/>
  <elementum nomen="genus" intra="analysis-nominis-proprii" textus="verum"
    nota="OratioGenusGrammaticum: 0 masculinum 1 femininum 2 neutrum 3 commune"/>
  <elementum nomen="declinatio" intra="analysis-nominis-proprii" textus="verum"
    nota="declinatio I-V (WORDS), 0 = nulla"/>

  <elementum nomen="analysis-verbi"
    nota="classis verbum">
    <attributum nomen="n" genus="numerus"/>
    <liberum nomen="lemma" maximum="1"/>
    <liberum nomen="lingua" maximum="1"/>
    <liberum nomen="fons" maximum="1"/>
    <liberum nomen="nativum" maximum="1"/>
    <liberum nomen="sensus" maximum="1"/>
    <liberum nomen="persona" maximum="1"/>
    <liberum nomen="numerus" maximum="1"/>
    <liberum nomen="tempus" maximum="1"/>
    <liberum nomen="modus" maximum="1"/>
    <liberum nomen="vox" maximum="1"/>
    <liberum nomen="forma-verbi" maximum="1"/>
    <liberum nomen="coniugatio" maximum="1"/>
    <liberum nomen="casus" maximum="1"/>
    <liberum nomen="genus" maximum="1"/>
  </elementum>
  <elementum nomen="lemma" intra="analysis-verbi" nota="derivatum: lemma fontis">
    <liberum nomen="or-derivatum" maximum="1"/>
  </elementum>
  <elementum nomen="lingua" intra="analysis-verbi" textus="verum"
    nota="OratioLingua: 0 latina 1 anglica"/>
  <elementum nomen="fons" intra="analysis-verbi" textus="verum"
    nota="OratioFonsAnalysis: 0 vocabularium-la 1 vocabularium-en 2 glossarium 3 regula"/>
  <elementum nomen="nativum" intra="analysis-verbi" nota="derivatum: codex fontis verbatim (lexema unum)">
    <liberum nomen="or-derivatum" maximum="1"/>
  </elementum>
  <elementum nomen="sensus" intra="analysis-verbi" nota="derivatum: sensus fontis (optionale)">
    <liberum nomen="or-derivatum" maximum="1"/>
  </elementum>
  <elementum nomen="persona" intra="analysis-verbi" textus="verum"
    nota="OratioPersona: 0 I 1 II 2 III"/>
  <elementum nomen="numerus" intra="analysis-verbi" textus="verum"
    nota="OratioNumerusGrammaticus: 0 singularis 1 pluralis 2 dualis"/>
  <elementum nomen="tempus" intra="analysis-verbi" textus="verum"
    nota="OratioTempus: 0 praesens 1 imperfectum 2 futurum 3 perfectum 4 plusquamperfectum 5 futurum-exactum 6 praeteritum"/>
  <elementum nomen="modus" intra="analysis-verbi" textus="verum"
    nota="OratioModus: 0 indicativus 1 subiunctivus 2 imperativus 3 infinitivus"/>
  <elementum nomen="vox" intra="analysis-verbi" textus="verum"
    nota="OratioVox: 0 activa 1 passiva 2 deponens"/>
  <elementum nomen="forma-verbi" intra="analysis-verbi" textus="verum"
    nota="OratioFormaVerbi: 0 finitum 1 infinitivum 2 participium 3 gerundium 4 gerundivum 5 supinum"/>
  <elementum nomen="coniugatio" intra="analysis-verbi" textus="verum"
    nota="coniugatio I-IV (WORDS), 0 = nulla"/>
  <elementum nomen="casus" intra="analysis-verbi" textus="verum"
    nota="OratioCasus: 0 nominativus 1 genitivus 2 dativus 3 accusativus 4 ablativus 5 locativus 6 vocativus"/>
  <elementum nomen="genus" intra="analysis-verbi" textus="verum"
    nota="OratioGenusGrammaticum: 0 masculinum 1 femininum 2 neutrum 3 commune"/>

  <elementum nomen="analysis-auxiliaris"
    nota="classis auxiliare">
    <attributum nomen="n" genus="numerus"/>
    <liberum nomen="lemma" maximum="1"/>
    <liberum nomen="lingua" maximum="1"/>
    <liberum nomen="fons" maximum="1"/>
    <liberum nomen="nativum" maximum="1"/>
    <liberum nomen="sensus" maximum="1"/>
    <liberum nomen="persona" maximum="1"/>
    <liberum nomen="numerus" maximum="1"/>
    <liberum nomen="tempus" maximum="1"/>
    <liberum nomen="modus" maximum="1"/>
    <liberum nomen="vox" maximum="1"/>
    <liberum nomen="forma-verbi" maximum="1"/>
    <liberum nomen="coniugatio" maximum="1"/>
    <liberum nomen="casus" maximum="1"/>
    <liberum nomen="genus" maximum="1"/>
  </elementum>
  <elementum nomen="lemma" intra="analysis-auxiliaris" nota="derivatum: lemma fontis">
    <liberum nomen="or-derivatum" maximum="1"/>
  </elementum>
  <elementum nomen="lingua" intra="analysis-auxiliaris" textus="verum"
    nota="OratioLingua: 0 latina 1 anglica"/>
  <elementum nomen="fons" intra="analysis-auxiliaris" textus="verum"
    nota="OratioFonsAnalysis: 0 vocabularium-la 1 vocabularium-en 2 glossarium 3 regula"/>
  <elementum nomen="nativum" intra="analysis-auxiliaris" nota="derivatum: codex fontis verbatim (lexema unum)">
    <liberum nomen="or-derivatum" maximum="1"/>
  </elementum>
  <elementum nomen="sensus" intra="analysis-auxiliaris" nota="derivatum: sensus fontis (optionale)">
    <liberum nomen="or-derivatum" maximum="1"/>
  </elementum>
  <elementum nomen="persona" intra="analysis-auxiliaris" textus="verum"
    nota="OratioPersona: 0 I 1 II 2 III"/>
  <elementum nomen="numerus" intra="analysis-auxiliaris" textus="verum"
    nota="OratioNumerusGrammaticus: 0 singularis 1 pluralis 2 dualis"/>
  <elementum nomen="tempus" intra="analysis-auxiliaris" textus="verum"
    nota="OratioTempus: 0 praesens 1 imperfectum 2 futurum 3 perfectum 4 plusquamperfectum 5 futurum-exactum 6 praeteritum"/>
  <elementum nomen="modus" intra="analysis-auxiliaris" textus="verum"
    nota="OratioModus: 0 indicativus 1 subiunctivus 2 imperativus 3 infinitivus"/>
  <elementum nomen="vox" intra="analysis-auxiliaris" textus="verum"
    nota="OratioVox: 0 activa 1 passiva 2 deponens"/>
  <elementum nomen="forma-verbi" intra="analysis-auxiliaris" textus="verum"
    nota="OratioFormaVerbi: 0 finitum 1 infinitivum 2 participium 3 gerundium 4 gerundivum 5 supinum"/>
  <elementum nomen="coniugatio" intra="analysis-auxiliaris" textus="verum"
    nota="coniugatio I-IV (WORDS), 0 = nulla"/>
  <elementum nomen="casus" intra="analysis-auxiliaris" textus="verum"
    nota="OratioCasus: 0 nominativus 1 genitivus 2 dativus 3 accusativus 4 ablativus 5 locativus 6 vocativus"/>
  <elementum nomen="genus" intra="analysis-auxiliaris" textus="verum"
    nota="OratioGenusGrammaticum: 0 masculinum 1 femininum 2 neutrum 3 commune"/>

  <elementum nomen="analysis-adiectivi"
    nota="classis adiectivum">
    <attributum nomen="n" genus="numerus"/>
    <liberum nomen="lemma" maximum="1"/>
    <liberum nomen="lingua" maximum="1"/>
    <liberum nomen="fons" maximum="1"/>
    <liberum nomen="nativum" maximum="1"/>
    <liberum nomen="sensus" maximum="1"/>
    <liberum nomen="casus" maximum="1"/>
    <liberum nomen="numerus" maximum="1"/>
    <liberum nomen="genus" maximum="1"/>
    <liberum nomen="gradus" maximum="1"/>
    <liberum nomen="declinatio" maximum="1"/>
  </elementum>
  <elementum nomen="lemma" intra="analysis-adiectivi" nota="derivatum: lemma fontis">
    <liberum nomen="or-derivatum" maximum="1"/>
