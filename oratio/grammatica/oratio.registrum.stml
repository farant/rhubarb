    <locus titulus="classes" species="token"
      nota="DERIVATUM"/>
    <locus titulus="linguae" species="token"
      nota="DERIVATUM"/>
    <locus titulus="decisio" species="index"
      nota="OratioDecisio (T19g)"/>
    <locus titulus="auctor" species="token"
      nota="DERIVATUM (T19g)"/>
    <locus titulus="clausula" species="index"
      nota="T20a: clausula intra sententiam"/>
    <locus titulus="clausula-causa" species="index"
      nota="OratioClausulaCausa (T20a)"/>
    <locus titulus="habitus" species="index"
      nota="OratioHabitus (T38 c)"/>
  </genus>

  <genus titulus="interpunctio">
    <locus titulus="signum" species="token"/>
    <locus titulus="cauda" species="lista-token"/>
    <locus titulus="clausula" species="index"
      nota="T20a"/>
    <locus titulus="clausula-causa" species="index"
      nota="OratioClausulaCausa (T20a)"/>
  </genus>

  <genus titulus="numerus">
