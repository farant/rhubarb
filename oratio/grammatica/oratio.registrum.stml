<!--
  oratio.registrum.stml - DECLARATIO registri generum orationis

  FONS UNUS tabularum coctarum oratio_registrum_coctum.{h,c}
  (materia/coquere.sh; canon materia/grammatica/registrum.canon).
  Genera APPENDUNTUR, numquam interponuntur: ordo = enumeratio =
  offsets; permutatio sigillum canonis movet (pinna, manu mota cum
  causa). Notae in commentaria generata transeunt.
-->
<registrum grammatica="oratio" praefixum="ORATIO" typus="OratioGenus"
  sedes="oratio/fontes">

  <genus titulus="documentum">
    <locus titulus="praefixa" species="lista-token"/>
    <locus titulus="paragraphi" species="lista-nodus"/>
    <locus titulus="finis" species="token"/>
  </genus>

  <genus titulus="paragraphus">
    <locus titulus="praefixa" species="lista-token"/>
    <locus titulus="sententiae" species="lista-nodus"/>
    <locus titulus="cauda" species="lista-token"/>
    <locus titulus="forma" species="index"
      nota="OratioForma (T6b)"/>
  </genus>

  <genus titulus="sententia">
    <locus titulus="elementa" species="lista-nodus"/>
    <locus titulus="clausulae" species="lista-nodus"
      nota="T20a: clausulae sententiae"/>
  </genus>

  <genus titulus="vocabulum">
    <locus titulus="partes" species="lista-token"/>
